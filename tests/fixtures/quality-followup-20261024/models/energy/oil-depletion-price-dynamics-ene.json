{
  "id": "oil-depletion-price-dynamics-ene",
  "name": "Oil Resource Depletion and Price Dynamics",
  "description": "Models oil extraction, resource depletion, and price dynamics following Hotelling's rule. Based on Hotelling (1931) and Hamilton (2009) oil price dynamics. Reference: NSIDC Arctic Sea Ice News. Source: https://nsidc.org/arcticseaicenews/",
  "category": "energy",
  "stocks": [
    {
      "id": "stock-reserves",
      "name": "Proven_Reserves_Gb",
      "initial_value": 1500,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-production",
      "name": "Production_Capacity_Gbd",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-price",
      "name": "Oil_Price_Dollar",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-discovery",
      "name": "New_Discoveries",
      "equation": "Discovery_Rate * (1 - Proven_Reserves_Gb/Ultimate_Recoverable)",
      "from_stock": null,
      "to_stock": "stock-reserves",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-extract",
      "name": "Extraction",
      "equation": "Production_Capacity_Gbd * 365 / 1000",
      "from_stock": "stock-reserves",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-invest",
      "name": "Capacity_Investment",
      "equation": "IF(Oil_Price_Dollar > Investment_Threshold, Investment_Rate * Production_Capacity_Gbd, 0)",
      "from_stock": null,
      "to_stock": "stock-production",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "flow-decline",
      "name": "Capacity_Decline",
      "equation": "Production_Capacity_Gbd * Decline_Rate",
      "from_stock": "stock-production",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "flow-price-adj",
      "name": "Price_Adjustment",
      "equation": "(Equilibrium_Price - Oil_Price_Dollar) / Price_Adjust_Time",
      "from_stock": null,
      "to_stock": "stock-price",
      "position": {
        "x": 300,
        "y": 280
      }
    }
  ],
  "variables": [
    {
      "id": "var-disc",
      "name": "Discovery_Rate",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-ultimate",
      "name": "Ultimate_Recoverable",
      "equation": "3000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-threshold",
      "name": "Investment_Threshold",
      "equation": "50",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-invest-rate",
      "name": "Investment_Rate",
      "equation": "0.03",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-decline",
      "name": "Decline_Rate",
      "equation": "0.05",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-demand",
      "name": "Global_Demand_Gbd",
      "equation": "100 * (1 + 0.01)^TIME",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "var-equil",
      "name": "Equilibrium_Price",
      "equation": "40 * (Global_Demand_Gbd / Production_Capacity_Gbd)^2",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "var-adj-time",
      "name": "Price_Adjust_Time",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 400
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1257/jep.23.1.93",
  "reference": "Hamilton JD (2009) Understanding Crude Oil Prices. The Energy Journal 30(2):93-118.",
  "connectors": [],
  "created_at": "2026-01-12T06:28:32.560951+00:00",
  "updated_at": "2026-01-12T06:28:32.560951+00:00"
}