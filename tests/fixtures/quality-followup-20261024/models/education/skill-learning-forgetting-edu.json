{
  "id": "skill-learning-forgetting-edu",
  "name": "Skill Learning and Forgetting Curve Model",
  "description": "Model of skill acquisition and decay based on Ebbinghaus forgetting curve (1885) and power law of practice. Shows optimal spacing for learning retention. Reference: NSIDC Arctic Sea Ice News. Source: https://nsidc.org/arcticseaicenews/",
  "stocks": [
    {
      "id": "stock-skill-level",
      "name": "Skill Level",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-memory-strength",
      "name": "Memory Strength",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-learning",
      "name": "Learning",
      "equation": "Practice_Intensity * Learning_Rate * (Max_Skill - Skill_Level) * Memory_Boost",
      "from_stock": null,
      "to_stock": "stock-skill-level",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-forgetting",
      "name": "Forgetting",
      "equation": "Skill_Level * Forgetting_Rate * (1 - Memory_Strength)",
      "from_stock": "stock-skill-level",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-memory-consolidation",
      "name": "Memory Consolidation",
      "equation": "Practice_Intensity * Consolidation_Rate * (1 - Memory_Strength)",
      "from_stock": null,
      "to_stock": "stock-memory-strength",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-memory-decay",
      "name": "Memory Decay",
      "equation": "Memory_Strength * Memory_Decay_Rate * (1 - Practice_Intensity)",
      "from_stock": "stock-memory-strength",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-practice-intensity",
      "name": "Practice Intensity",
      "equation": "IF MOD(Time, Practice_Interval) < Practice_Duration THEN 1 ELSE 0",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-practice-interval",
      "name": "Practice Interval",
      "equation": "7",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-practice-duration",
      "name": "Practice Duration",
      "equation": "1",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-learning-rate",
      "name": "Learning Rate",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-max-skill",
      "name": "Max Skill",
      "equation": "100",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-forgetting-rate",
      "name": "Forgetting Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-consolidation-rate",
      "name": "Consolidation Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "var-memory-decay-rate",
      "name": "Memory Decay Rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-memory-boost",
      "name": "Memory Boost",
      "equation": "1 + 0.5 * Memory_Strength",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "var-retention",
      "name": "Retention Rate",
      "equation": "Skill_Level / (Max_Skill + 0.001)",
      "position": {
        "x": 700,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-11T21:16:29.727616+00:00",
  "updated_at": "2026-01-11T21:16:29.727616+00:00",
  "source": "https://github.com/SDXorg/PySD-Cookbook",
  "reference": "System Dynamics Educational Models - PySD Cookbook"
}