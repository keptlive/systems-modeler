  {
    "file": "models/transportation/lighthill-whitham-richards-traffic-tra.json",
    "sha256": "24975d40098ed435ac9c5e5e17fd7639f23b92aefb184185bdea636fcb035568",
    "definition": {
      "id": "lighthill-whitham-richards-traffic-tra",
      "name": "Traffic Fundamental Diagram - Static Calculator",
      "description": "Static calculator for a linear speed-density relationship: Speed and Flow are calculated outputs at fixed Traffic_Density. Traffic_Flow is an inert placeholder. This is a fundamental-diagram illustration, not a simulation of the Lighthill-Whitham-Richards conservation PDE.",
      "stocks": [
        {
          "id": "s1",
          "name": "Traffic_Density",
          "initial_value": 20.0,
          "equation": "",
          "position": {
            "x": 150,
            "y": 200
          }
        },
        {
          "id": "s2",
          "name": "Traffic_Flow",
          "initial_value": 0.0,
          "equation": "",
          "position": {
            "x": 350,
            "y": 200
          }
        }
      ],
      "flows": [],
      "variables": [
        {
          "id": "v1",
          "name": "Free_Flow_Speed",
          "equation": "100.0",
          "position": {
            "x": 100,
            "y": 50
          }
        },
        {
          "id": "v2",
          "name": "Jam_Density",
          "equation": "150.0",
          "position": {
            "x": 230,
            "y": 50
          }
        },
        {
          "id": "v3",
          "name": "Speed",
          "equation": "Free_Flow_Speed*(1-Traffic_Density/Jam_Density)",
          "position": {
            "x": 360,
            "y": 50
          }
        },
        {
          "id": "v4",
          "name": "Flow",
          "equation": "Traffic_Density*Speed",
          "position": {
            "x": 490,
            "y": 50
          }
        }
      ],
      "connectors": [
        {
          "id": "c1",
          "from_element": "Traffic_Density",
          "to_element": "Speed"
        },
        {
          "id": "c2",
          "from_element": "Jam_Density",
          "to_element": "Speed"
        },
        {
          "id": "c3",
          "from_element": "Traffic_Density",
          "to_element": "Flow"
        },
        {
          "id": "c4",
          "from_element": "Speed",
          "to_element": "Flow"
        }
      ],
      "time_settings": {
        "start": 0.0,
        "end": 1.0,
        "dt": 0.01
      },
      "created_at": "2026-01-15T20:53:08.350407+00:00",
      "updated_at": "2026-01-15T20:53:08.350407+00:00",
      "source": "https://doi.org/10.1098/rspa.1955.0088",
      "reference": "Lighthill, M.J. & Whitham, G.B. (1955) On kinematic waves II: A theory of traffic flow. Proc. R. Soc. A 229:317-345"
    }
  }
