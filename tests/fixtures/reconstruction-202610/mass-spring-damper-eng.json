      }
    },
    {
      "id": "s2",
      "name": "Velocity",
      "initial_value": 0.0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [],
  "variables": [
    {
      "id": "v1",
      "name": "Mass",
      "equation": "1.0",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Spring_Constant",
      "equation": "10.0",
      "position": {
        "x": 230,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Damping",
      "equation": "0.5",
      "position": {
        "x": 360,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "External_Force",
      "equation": "0.0",
      "position": {
        "x": 490,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Spring_Force",
      "equation": "-Spring_Constant*Displacement",
      "position": {
        "x": 620,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Damping_Force",
      "equation": "-Damping*Velocity",
