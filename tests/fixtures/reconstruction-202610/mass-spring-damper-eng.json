        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Acceleration",
      "equation": "(Spring_Force+Damping_Force+External_Force)/Mass",
      "position": {
        "x": 300,
        "y": 130
      }
    }
  ],
  "connectors": [
