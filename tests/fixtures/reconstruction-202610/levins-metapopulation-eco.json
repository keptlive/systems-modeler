{
  "id": "levins-metapopulation-eco",
  "name": "Levins Metapopulation Model",
  "description": "Classic model of population persistence in fragmented habitats through colonization-extinction dynamics",
  "stocks": [
    {
      "id": "s1",
      "name": "Occupied_Patches",
      "initial_value": 0.3,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    }
  ],
  "flows": [],
  "variables": [
    {
      "id": "v1",
      "name": "Colonization_Rate",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Extinction_Rate",
      "equation": "0.2",
      "position": {
        "x": 230,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Empty_Patches",
      "equation": "1-Occupied_Patches",
      "position": {
        "x": 360,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Colonization",
      "equation": "Colonization_Rate*Occupied_Patches*Empty_Patches",
      "position": {
        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v5",
      "name": "Extinction",
      "equation": "Extinction_Rate*Occupied_Patches",
      "position": {
        "x": 300,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "Net_Change",
      "equation": "Colonization-Extinction",
      "position": {
        "x": 500,
        "y": 130
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Occupied_Patches",
      "to_element": "Colonization"
    },
    {
      "id": "c2",
      "from_element": "Empty_Patches",
      "to_element": "Colonization"
    },
    {
      "id": "c3",
      "from_element": "Colonization_Rate",
      "to_element": "Colonization"
    },
    {
      "id": "c4",
      "from_element": "Occupied_Patches",
      "to_element": "Extinction"
    },
    {
      "id": "c5",
      "from_element": "Extinction_Rate",
      "to_element": "Extinction"
    }
  ],
