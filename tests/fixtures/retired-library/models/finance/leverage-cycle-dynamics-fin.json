{
  "id": "leverage-cycle-dynamics-fin",
  "name": "Leverage Cycle and Asset Prices",
  "description": "Models how leverage amplifies asset price cycles and leads to boom-bust dynamics. Based on Geanakoplos (2010) The Leverage Cycle, NBER Macroeconomics Annual. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "category": "finance",
  "stocks": [
    {
      "id": "stock-price",
      "name": "Asset_Price",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-leverage",
      "name": "Leverage_Ratio",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-margin",
      "name": "Margin_Requirement",
      "initial_value": 0.2,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-price-up",
      "name": "Price_Appreciation",
      "equation": "Asset_Price * Price_Growth * (1 + Leverage_Effect * (Leverage_Ratio - Base_Leverage))",
      "from_stock": null,
      "to_stock": "stock-price",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-price-down",
      "name": "Price_Depreciation",
      "equation": "Asset_Price * Price_Decay * MAX(0, Margin_Requirement - Base_Margin)",
      "from_stock": "stock-price",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-lever-up",
      "name": "Leverage_Increase",
      "equation": "IF(Asset_Price > 100, Leverage_Ratio * Lever_Adjust_Rate * (Asset_Price/100 - 1), 0)",
      "from_stock": null,
      "to_stock": "stock-leverage",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "flow-lever-down",
      "name": "Deleveraging",
      "equation": "IF(Margin_Requirement > Base_Margin, Leverage_Ratio * Delever_Rate, 0)",
      "from_stock": "stock-leverage",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "flow-margin-adj",
      "name": "Margin_Adjustment",
      "equation": "(Target_Margin - Margin_Requirement) / Margin_Adjust_Time",
      "from_stock": null,
      "to_stock": "stock-margin",
      "position": {
        "x": 300,
        "y": 280
      }
    }
  ],
  "variables": [
    {
      "id": "var-growth",
      "name": "Price_Growth",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-lever-eff",
      "name": "Leverage_Effect",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-base-lever",
      "name": "Base_Leverage",
      "equation": "5",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-decay",
      "name": "Price_Decay",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-base-margin",
      "name": "Base_Margin",
      "equation": "0.2",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-lever-adj",
      "name": "Lever_Adjust_Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "var-delever",
      "name": "Delever_Rate",
      "equation": "0.15",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-target-margin",
      "name": "Target_Margin",
      "equation": "IF(Asset_Price < 90, 0.4, IF(Asset_Price > 110, 0.15, 0.2))",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "var-margin-time",
      "name": "Margin_Adjust_Time",
      "equation": "2",
      "position": {
        "x": 500,
        "y": 400
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1086/648285",
  "reference": "Geanakoplos J (2010) The Leverage Cycle. NBER Macroeconomics Annual 24(1):1-65.",
  "connectors": [],
  "created_at": "2026-01-12T06:27:18.295470+00:00",
  "updated_at": "2026-01-12T06:27:18.295470+00:00"
}