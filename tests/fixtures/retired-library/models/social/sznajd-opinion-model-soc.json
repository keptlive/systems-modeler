{
  "id": "sznajd-opinion-model-soc",
  "name": "Sznajd Opinion Model",
  "description": "United we stand, divided we fall - social validation in opinion dynamics",
  "stocks": [
    {
      "id": "s1",
      "name": "Positive_Opinion_Fraction",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    }
  ],
  "flows": [],
  "variables": [
    {
      "id": "v1",
      "name": "Pair_Agreement_Rate",
      "equation": "Positive_Opinion_Fraction*Positive_Opinion_Fraction",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Pair_Disagreement_Rate",
      "equation": "Positive_Opinion_Fraction*(1-Positive_Opinion_Fraction)",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Opinion_Change",
      "equation": "Pair_Agreement_Rate-Pair_Disagreement_Rate",
      "position": {
        "x": 500,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Positive_Opinion_Fraction",
      "to_element": "Pair_Agreement_Rate"
    },
    {
      "id": "c2",
      "from_element": "Positive_Opinion_Fraction",
      "to_element": "Pair_Disagreement_Rate"
    }
  ],
  "time_settings": {
    "start": 0.0,
    "end": 100.0,
    "dt": 1.0
  },
  "created_at": "2026-01-15T20:43:11.092579+00:00",
