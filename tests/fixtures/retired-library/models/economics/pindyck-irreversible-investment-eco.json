        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "NPV",
      "equation": "Project_Value-Investment_Cost",
      "position": {
        "x": 490,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Option_Premium",
