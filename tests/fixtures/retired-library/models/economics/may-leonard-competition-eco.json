{
  "id": "may-leonard-competition-eco",
  "name": "May-Leonard Competition Model",
  "description": "Cyclic competition model showing rock-paper-scissors dynamics in ecology",
  "stocks": [
    {
      "id": "s1",
      "name": "Species_A",
      "initial_value": 0.33,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Species_B",
      "initial_value": 0.33,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Species_C",
      "initial_value": 0.34,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [],
  "variables": [
    {
      "id": "v1",
      "name": "r",
      "equation": "1.0",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "alpha",
      "equation": "0.8",
      "position": {
        "x": 230,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "beta",
      "equation": "1.2",
      "position": {
        "x": 360,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "A_growth",
      "equation": "r*Species_A*(1-Species_A-alpha*Species_B-beta*Species_C)",
      "position": {
        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v5",
      "name": "B_growth",
      "equation": "r*Species_B*(1-beta*Species_A-Species_B-alpha*Species_C)",
      "position": {
        "x": 300,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "C_growth",
      "equation": "r*Species_C*(1-alpha*Species_A-beta*Species_B-Species_C)",
      "position": {
        "x": 500,
        "y": 130
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Species_A",
      "to_element": "A_growth"
    },
    {
      "id": "c2",
      "from_element": "Species_B",
      "to_element": "A_growth"
    },
    {
      "id": "c3",
      "from_element": "Species_C",
      "to_element": "A_growth"
    }
  ],
