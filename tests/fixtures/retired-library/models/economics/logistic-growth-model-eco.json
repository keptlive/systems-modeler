{
  "id": "logistic-growth-model-eco",
  "name": "Logistic Growth Model",
  "description": "Population growth model with carrying capacity. Growth rate depends on both population size and how far it is from carrying capacity. As population approaches carrying capacity, growth slows and eventually stops. Produces the characteristic S-shaped (sigmoid) growth curve. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "stock-population",
      "name": "Population",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-net-growth",
      "name": "Net Growth",
      "equation": "Intrinsic_Growth_Rate * Population * (1 - Population / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-population",
      "position": {
        "x": 250,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-initial-population",
      "name": "Initial Population",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-intrinsic-growth-rate",
      "name": "Intrinsic Growth Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-carrying-capacity",
      "name": "Carrying Capacity",
      "equation": "10000",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-fractional-capacity",
      "name": "Fractional Capacity",
      "equation": "Population / Carrying_Capacity",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-per-capita-growth-rate",
      "name": "Per Capita Growth Rate",
      "equation": "Intrinsic_Growth_Rate * (1 - Fractional_Capacity)",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-doubling-time-initial",
      "name": "Doubling Time (initial)",
      "equation": "LN(2) / Intrinsic_Growth_Rate",
      "position": {
        "x": 100,
        "y": 160
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Population",
      "to_element": "Net Growth"
    },
    {
      "id": "conn-2",
      "from_element": "Intrinsic Growth Rate",
      "to_element": "Net Growth"
    },
    {
      "id": "conn-3",
      "from_element": "Carrying Capacity",
      "to_element": "Net Growth"
    },
    {
      "id": "conn-4",
      "from_element": "Population",
      "to_element": "Fractional Capacity"
    },
    {
      "id": "conn-5",
      "from_element": "Carrying Capacity",
      "to_element": "Fractional Capacity"
    },
    {
      "id": "conn-6",
      "from_element": "Intrinsic Growth Rate",
      "to_element": "Per Capita Growth Rate"
    },
    {
      "id": "conn-7",
      "from_element": "Fractional Capacity",
      "to_element": "Per Capita Growth Rate"
    },
    {
      "id": "conn-8",
      "from_element": "Intrinsic Growth Rate",
      "to_element": "Doubling Time (initial)"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
