        "y": 200
      }
    }
  ],
  "flows": [],
  "variables": [
    {
      "id": "v1",
      "name": "Fixed_Export_Cost",
      "equation": "5.0",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Variable_Trade_Cost",
      "equation": "1.2",
      "position": {
        "x": 230,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Productivity_Cutoff_Export",
