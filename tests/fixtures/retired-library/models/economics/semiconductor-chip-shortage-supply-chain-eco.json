{
  "id": "semiconductor-chip-shortage-supply-chain-eco",
  "name": "Semiconductor Chip Shortage Supply Chain Model",
  "description": "Illustrative semiconductor supply-chain stock-flow model. Attinasi et al. (2021) is empirical background on shortages, trade and production; the capacity, inventory, backlog and adjustment equations here are local assumptions, not an ECB forecasting model or a verified replication.",
  "source": "https://www.ecb.europa.eu/press/economic-bulletin/focus/2021/html/ecb.ebbox202104_06~780de2a8fb.en.html",
  "reference": "Attinasi, M.G., De Stefani, R., Frohm, E., Gunnella, V., Koester, G., Melemenidis, A. and Toth, M. (2021). The semiconductor shortage and its implication for euro area trade, production and prices. ECB Economic Bulletin, Issue 4/2021, Box 6.",
  "stocks": [
    {
      "id": "stock-fab-capacity",
      "name": "Fab Capacity",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "stock-capacity-under-construction",
      "name": "Capacity Under Construction",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "stock-chip-inventory",
      "name": "Chip Inventory",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-backlog",
      "name": "Order Backlog",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "stock-auto-production",
      "name": "Auto Production",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-capacity-investment",
      "name": "Capacity Investment",
      "equation": "Investment_Rate * (Desired_Capacity - Fab_Capacity) / Capacity_Adjustment_Time",
      "from_stock": null,
      "to_stock": "stock-capacity-under-construction",
      "position": {
        "x": 175,
        "y": 50
      }
    },
    {
      "id": "flow-capacity-completion",
      "name": "Capacity Completion",
      "equation": "Capacity_Under_Construction / Construction_Time",
      "from_stock": "stock-capacity-under-construction",
      "to_stock": "stock-fab-capacity",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "flow-chip-production",
      "name": "Chip Production",
      "equation": "Fab_Capacity * Utilization_Rate",
      "from_stock": null,
      "to_stock": "stock-chip-inventory",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-chip-shipment",
      "name": "Chip Shipment",
      "equation": "MIN(Chip_Inventory / Shipment_Delay, Order_Backlog / Backlog_Processing_Time)",
      "from_stock": "stock-chip-inventory",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "flow-new-orders",
      "name": "New Orders",
      "equation": "Base_Demand * (1 + Demand_Surge) * Panic_Ordering_Factor",
      "from_stock": null,
      "to_stock": "stock-backlog",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "flow-order-fulfillment",
      "name": "Order Fulfillment",
      "equation": "MIN(Chip_Inventory / Shipment_Delay, Order_Backlog / Backlog_Processing_Time)",
      "from_stock": "stock-backlog",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-investment-rate",
      "name": "Investment_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-desired-capacity",
      "name": "Desired_Capacity",
      "equation": "Fab_Capacity * (1 + Order_Backlog / 1000)",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "var-adjustment-time",
      "name": "Capacity_Adjustment_Time",
      "equation": "12",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "var-construction-time",
      "name": "Construction_Time",
      "equation": "24",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-utilization",
      "name": "Utilization_Rate",
      "equation": "0.9",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "var-shipment-delay",
      "name": "Shipment_Delay",
      "equation": "1",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "var-base-demand",
      "name": "Base_Demand",
      "equation": "800",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-demand-surge",
      "name": "Demand_Surge",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "var-panic-ordering",
      "name": "Panic_Ordering_Factor",
      "equation": "1 + 0.5 * Order_Backlog / 500",
      "position": {
        "x": 300,
        "y": 450
      }
    },
    {
      "id": "var-backlog-processing",
      "name": "Backlog_Processing_Time",
      "equation": "4",
      "position": {
        "x": 500,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 104,
    "dt": 0.25
  },
