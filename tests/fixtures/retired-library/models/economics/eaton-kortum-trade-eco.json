  "updated_at": "2026-01-15T20:49:05.311910+00:00",
  "source": "https://doi.org/10.1111/1468-0262.00352",
  "reference": "Eaton, J. & Kortum, S. (2002) Technology, geography, and trade. Econometrica 70:1741-1779"
}