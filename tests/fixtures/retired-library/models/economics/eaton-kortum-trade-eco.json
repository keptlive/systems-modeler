{
  "id": "eaton-kortum-trade-eco",
  "name": "Eaton-Kortum Trade Model",
  "description": "Ricardian trade model with technology differences",
  "stocks": [
    {
      "id": "s1",
      "name": "Country_1_Technology",
      "initial_value": 1.0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Country_2_Technology",
      "initial_value": 0.8,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [],
  "variables": [
    {
      "id": "v1",
      "name": "Trade_Cost",
      "equation": "1.5",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Theta",
      "equation": "4.0",
      "position": {
        "x": 230,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Comparative_Advantage_1",
      "equation": "Country_1_Technology/Country_2_Technology",
      "position": {
        "x": 360,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Trade_Share",
      "equation": "1/(1+Trade_Cost*Trade_Cost*Trade_Cost*Trade_Cost*Comparative_Advantage_1)",
      "position": {
        "x": 490,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Welfare_Gain",
      "equation": "Trade_Share*0.1",
      "position": {
        "x": 620,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Country_1_Technology",
      "to_element": "Comparative_Advantage_1"
    },
    {
      "id": "c2",
      "from_element": "Country_2_Technology",
      "to_element": "Comparative_Advantage_1"
    },
    {
      "id": "c3",
      "from_element": "Trade_Cost",
      "to_element": "Trade_Share"
    },
    {
      "id": "c4",
      "from_element": "Comparative_Advantage_1",
      "to_element": "Trade_Share"
    }
  ],
  "time_settings": {
    "start": 0.0,
    "end": 50.0,
    "dt": 1.0
  },
