{
  "id": "amazon-rainforest-dieback-model-cli",
  "name": "Amazon Rainforest Dieback Model",
  "description": "Model of potential Amazon forest dieback due to climate change and deforestation feedback loops. Explores tipping point dynamics. Reference: IPCC Climate Assessment Reports. Source: https://www.ipcc.ch/",
