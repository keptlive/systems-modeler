        "y": 200
      }
    },
    {
      "id": "stock-rainfall",
      "name": "Rainfall",
      "initial_value": 2200,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-soil-moisture",
      "name": "Soil_Moisture",
      "initial_value": 0.4,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
