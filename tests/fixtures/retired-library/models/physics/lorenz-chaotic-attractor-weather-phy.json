{
  "id": "lorenz-chaotic-attractor-weather-phy",
  "name": "Lorenz Chaotic Attractor Model",
  "description": "The famous Lorenz system demonstrating deterministic chaos, fundamental to weather prediction limits. Lorenz 1963. Reference: Lorenz, E. N. (1963). Deterministic nonperiodic flow. Journal of the Atmospheric Sciences, 20(2), 130-141. DOI: https://doi.org/10.1175/1520-0469(1963)020<0130:DNF>2.0.CO;2",
  "stocks": [
    {
      "id": "s1",
      "name": "X Convection",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "s2",
      "name": "Y Temperature Diff",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Z Vertical Temp",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "dX dt",
      "equation": "Sigma * (Y_Temperature_Diff - X_Convection)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "f2",
      "name": "dY dt",
      "equation": "X_Convection * (Rho - Z_Vertical_Temp) - Y_Temperature_Diff",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "dZ dt",
      "equation": "X_Convection * Y_Temperature_Diff - Beta * Z_Vertical_Temp",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 100,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Sigma",
      "equation": "10",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Rho",
      "equation": "28",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "v3",
      "name": "Beta",
      "equation": "2.667",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v4",
      "name": "Attractor Distance",
      "equation": "SQRT(X_Convection^2 + Y_Temperature_Diff^2 + Z_Vertical_Temp^2)",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "X Convection",
      "to_element": "dY dt"
    },
    {
      "id": "c2",
      "from_element": "Y Temperature Diff",
      "to_element": "dX dt"
    },
    {
      "id": "c3",
      "from_element": "Z Vertical Temp",
      "to_element": "dY dt"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.01
  },
  "created_at": "2026-01-15T14:20:13.050447",
  "updated_at": "2026-01-15T14:20:13.050453",
  "source": "https://doi.org/10.1175/1520-0469(1963)020<0130:DNF>2.0.CO;2",
  "reference": "Lorenz EN. Deterministic Nonperiodic Flow. Journal of the Atmospheric Sciences. 1963;20(2):130-141."
}