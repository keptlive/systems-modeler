        "x": 920,
        "y": 240
      }
    }
  ],
  "flows": [
    {
      "id": "ekman-three-layer-momentum-environment:rate:U_Surface",
      "name": "U_Surface_net_rate",
      "equation": "coriolis*V_Surface+mixing*(U_Middle-U_Surface)+wind_acceleration",
      "to_stock": "ekman-three-layer-momentum-environment:U_Surface",
      "units": "(meter/second)/hour",
      "position": {
        "x": 120,
        "y": 340
      }
    },
    {
      "id": "ekman-three-layer-momentum-environment:rate:V_Surface",
      "name": "V_Surface_net_rate",
      "equation": "-coriolis*U_Surface+mixing*(V_Middle-V_Surface)",
      "to_stock": "ekman-three-layer-momentum-environment:V_Surface",
      "units": "(meter/second)/hour",
      "position": {
        "x": 280,
        "y": 340
      }
    },
    {
      "id": "ekman-three-layer-momentum-environment:rate:U_Middle",
      "name": "U_Middle_net_rate",
      "equation": "coriolis*V_Middle+mixing*(U_Surface-2*U_Middle+U_Bottom)",
      "to_stock": "ekman-three-layer-momentum-environment:U_Middle",
      "units": "(meter/second)/hour",
      "position": {
        "x": 440,
        "y": 340
      }
    },
    {
      "id": "ekman-three-layer-momentum-environment:rate:V_Middle",
      "name": "V_Middle_net_rate",
      "equation": "-coriolis*U_Middle+mixing*(V_Surface-2*V_Middle+V_Bottom)",
      "to_stock": "ekman-three-layer-momentum-environment:V_Middle",
      "units": "(meter/second)/hour",
      "position": {
        "x": 600,
        "y": 340
      }
    },
    {
      "id": "ekman-three-layer-momentum-environment:rate:U_Bottom",
      "name": "U_Bottom_net_rate",
      "equation": "coriolis*V_Bottom+mixing*(U_Middle-U_Bottom)-bottom_drag*U_Bottom",
      "to_stock": "ekman-three-layer-momentum-environment:U_Bottom",
      "units": "(meter/second)/hour",
      "position": {
        "x": 760,
        "y": 340
      }
    },
    {
      "id": "ekman-three-layer-momentum-environment:rate:V_Bottom",
      "name": "V_Bottom_net_rate",
      "equation": "-coriolis*U_Bottom+mixing*(V_Middle-V_Bottom)-bottom_drag*V_Bottom",
      "to_stock": "ekman-three-layer-momentum-environment:V_Bottom",
