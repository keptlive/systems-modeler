{
  "id": "ekman-three-layer-momentum-environment",
  "name": "Three-layer Ekman momentum mixing under steady wind",
  "category": "environment",
  "description": "Equal-thickness finite-volume layers exchange both momentum components; surface wind forcing, Coriolis rotation and bottom drag close the column budget. Internal mixing conserves vertically summed momentum and dissipates shear energy. This is a deliberately coarse six-state discretization, not the exact infinite-depth steady Ekman spiral or a weather forecast. All numerical parameters, initial values, horizon and solver settings are illustrative teaching choices; not fitted to a field site. Signed net-rate flows encode state equations, not material transport claims. No numerical clipping or arbitrary domain clamps.",
  "source": "https://hdl.handle.net/1969.1/160216",
  "reference": "Stewart, Introduction to Physical Oceanography, author textbook momentum and Ekman-layer equations8.15,9.7-9.8; Ekman(1905), On the influence of the Earth rotation on ocean-currents. Own three-layer finite-volume transient discretization.",
  "stocks": [
    {
      "id": "ekman-three-layer-momentum-environment:U_Surface",
      "name": "U_Surface",
      "initial_value": 0,
      "units": "meter/second",
      "equation": "",
      "position": {
        "x": 120,
        "y": 240
      }
    },
    {
      "id": "ekman-three-layer-momentum-environment:V_Surface",
      "name": "V_Surface",
      "initial_value": 0,
      "units": "meter/second",
      "equation": "",
      "position": {
        "x": 280,
        "y": 240
      }
    },
    {
      "id": "ekman-three-layer-momentum-environment:U_Middle",
      "name": "U_Middle",
      "initial_value": 0,
      "units": "meter/second",
      "equation": "",
      "position": {
        "x": 440,
        "y": 240
      }
    },
    {
      "id": "ekman-three-layer-momentum-environment:V_Middle",
      "name": "V_Middle",
      "initial_value": 0,
      "units": "meter/second",
      "equation": "",
      "position": {
        "x": 600,
        "y": 240
      }
    },
    {
      "id": "ekman-three-layer-momentum-environment:U_Bottom",
      "name": "U_Bottom",
      "initial_value": 0,
      "units": "meter/second",
      "equation": "",
      "position": {
        "x": 760,
        "y": 240
      }
    },
    {
      "id": "ekman-three-layer-momentum-environment:V_Bottom",
