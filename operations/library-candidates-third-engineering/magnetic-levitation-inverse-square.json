        "y": 150
      },
      "units": "(meter)/second"
    },
    {
      "id": "f1",
      "name": "Change_Velocity",
      "equation": "Gravity-ForceConstant/Mass*(Conductance*Voltage)^2/Gap^2-Damping*Velocity",
