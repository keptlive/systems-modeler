      "position": {
        "x": 310,
        "y": 150
      },
      "units": "(meter/second)/second"
    }
  ],
  "variables": [
    {
      "id": "p0",
      "name": "Gravity",
      "equation": "9.81",
      "position": {
        "x": 100,
        "y": 750
      },
      "units": "meter/second^2"
    },
    {
      "id": "p1",
      "name": "ForceConstant",
      "equation": "0.000313",
      "position": {
        "x": 270,
        "y": 750
      },
      "units": "kg*meter^3/(second^2*ampere^2)"
    },
    {
      "id": "p2",
