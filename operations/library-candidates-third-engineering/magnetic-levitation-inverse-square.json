      "name": "Conductance",
      "equation": "1",
      "position": {
        "x": 610,
        "y": 750
      },
      "units": "ampere/volt"
    },
    {
      "id": "p4",
      "name": "Damping",
      "equation": "1",
      "position": {
        "x": 780,
        "y": 750
      },
      "units": "1/second"
