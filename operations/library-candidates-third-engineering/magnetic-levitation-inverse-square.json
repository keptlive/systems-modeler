  "name": "Magnetic Levitation with Inverse-Square Attraction",
  "category": "engineering",
  "description": "Exact source inverse-square plant/parameters. Authored local voltage feedback around2cm equilibrium and2mm initial gap error; no actuator clipping, impact/contact dynamics or global stabilization claim. Source sensor voltage conversion omitted. Teaching reconstruction; not calibrated equipment or a certified controller. Missing dimensional annotations remain unknown.",
  "source": "https://github.com/python-control/python-control/blob/b4cf7360138985f84afe299337ef9ee6c25e9c38/examples/cds110-L8a_maglev-limits.ipynb",
  "reference": "Murray, CDS110 magnetic levitation notebook, python-control BSD3",
  "stocks": [
    {
      "id": "s0",
      "name": "Gap",
      "initial_value": 0.022,
      "position": {
        "x": 220,
        "y": 150
      },
      "units": "meter"
    },
    {
      "id": "s1",
      "name": "Velocity",
      "initial_value": 0.0,
      "position": {
        "x": 400,
        "y": 150
      },
      "units": "meter/second"
    }
  ],
  "flows": [
    {
      "id": "f0",
      "name": "Change_Gap",
