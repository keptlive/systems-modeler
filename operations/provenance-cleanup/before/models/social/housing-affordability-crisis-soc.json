{
  "id": "housing-affordability-crisis-soc",
  "name": "Housing Affordability Crisis Model",
  "description": "System dynamics model of housing market dynamics and affordability. Captures supply constraints, demand pressures, price dynamics, and policy interventions. Reference: NSIDC Arctic Sea Ice News. Source: https://nsidc.org/arcticseaicenews/",
  "source": "https://doi.org/10.1257/jep.32.1.3",
  "reference": "Glaeser EL, Gyourko J. (2018). The Economic Implications of Housing Supply. Journal of Economic Perspectives, 32(1), 3-30.",
  "stocks": [
    {
      "id": "stock-housing-stock",
      "name": "Housing Stock",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-households",
      "name": "Households",
      "initial_value": 900000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-prices",
      "name": "Housing Prices",
      "initial_value": 300000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-construction",
      "name": "Under Construction",
      "initial_value": 20000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "stock-affordability-gap",
      "name": "Affordability Gap",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-construction-start",
      "name": "Construction Starts",
      "equation": "Desired_Construction * Permit_Approval_Rate * Developer_Profitability",
      "from_stock": null,
      "to_stock": "stock-construction",
      "position": {
        "x": 50,
        "y": 350
      }
    },
    {
      "id": "flow-completion",
      "name": "Completions",
      "equation": "Under_Construction / Construction_Time",
      "from_stock": "stock-construction",
      "to_stock": "stock-housing-stock",
      "position": {
        "x": 100,
        "y": 275
      }
    },
    {
      "id": "flow-demolition",
      "name": "Demolitions",
      "equation": "Housing_Stock * Demolition_Rate",
      "from_stock": "stock-housing-stock",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-household-formation",
      "name": "Household Formation",
      "equation": "Population_Growth + Immigration_Rate",
      "from_stock": null,
      "to_stock": "stock-households",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-outmigration",
      "name": "Outmigration",
      "equation": "Households * Outmigration_Rate * (Housing_Prices / Median_Income - 5) / 5",
      "from_stock": "stock-households",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-price-increase",
      "name": "Price Increase",
      "equation": "Housing_Prices * Price_Adjustment_Rate * (Households / Housing_Stock - 0.95) / 0.05",
      "from_stock": null,
      "to_stock": "stock-prices",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-price-decrease",
      "name": "Price Decrease",
      "equation": "Housing_Prices * Price_Adjustment_Rate * MAX(0, (0.95 - Households / Housing_Stock) / 0.05)",
      "from_stock": "stock-prices",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "flow-gap-change",
      "name": "Gap Change",
      "equation": "(Actual_Price_to_Income - Target_Price_to_Income) / Gap_Adjustment_Time",
      "from_stock": null,
      "to_stock": "stock-affordability-gap",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-desired-const",
      "name": "Desired Construction",
      "equation": "MAX(0, (Households - Housing_Stock * 0.95) / 5)",
      "position": {
        "x": 50,
        "y": 400
      }
    },
    {
      "id": "var-permit-rate",
      "name": "Permit Approval Rate",
      "equation": "1 - Regulatory_Burden",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-regulatory",
      "name": "Regulatory Burden",
      "equation": "0.3",
      "position": {
        "x": 150,
        "y": 450
      }
    },
    {
      "id": "var-profitability",
      "name": "Developer Profitability",
      "equation": "Housing_Prices / (Construction_Cost * 1.2)",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "var-const-cost",
      "name": "Construction Cost",
      "equation": "250000",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "var-const-time",
      "name": "Construction Time",
      "equation": "2",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "var-demo-rate",
      "name": "Demolition Rate",
      "equation": "0.005",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "var-pop-growth",
      "name": "Population Growth",
      "equation": "5000",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-immigration",
      "name": "Immigration Rate",
      "equation": "3000",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-outmig-rate",
      "name": "Outmigration Rate",
      "equation": "0.01",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-median-income",
      "name": "Median Income",
      "equation": "60000",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-price-adj",
      "name": "Price Adjustment Rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-actual-ratio",
      "name": "Actual Price to Income",
      "equation": "Housing_Prices / Median_Income",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-target-ratio",
      "name": "Target Price to Income",
      "equation": "4",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-gap-adj",
      "name": "Gap Adjustment Time",
      "equation": "1",
      "position": {
        "x": 550,
        "y": 400
      }
    },
    {
      "id": "var-vacancy-rate",
      "name": "Vacancy Rate",
      "equation": "(Housing_Stock - Households) / Housing_Stock * 100",
      "position": {
        "x": 200,
        "y": 250
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T03:15:51.643422+00:00",
  "updated_at": "2026-01-12T03:15:51.643422+00:00"
}