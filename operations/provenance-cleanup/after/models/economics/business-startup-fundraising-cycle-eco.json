{
  "id": "business-startup-fundraising-cycle-eco",
  "name": "Startup Fundraising and Burn Rate",
  "description": "Models startup cash dynamics including runway calculation, burn rate management, and fundraising cycles. Based on startup finance literature and VC best practices.",
  "category": "economics",
  "stocks": [
    {
      "id": "stock-cash",
      "name": "Cash_Balance",
      "initial_value": 2000000.0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-employees",
      "name": "Employee_Count",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-customers",
      "name": "Customers",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "stock-arr",
      "name": "ARR",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 600,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-revenue",
      "name": "Monthly_Revenue",
      "equation": "ARR / 12",
      "from_stock": null,
      "to_stock": "stock-cash",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-expenses",
      "name": "Monthly_Expenses",
      "equation": "Employee_Count * Salary_Cost + Fixed_Costs + Marketing_Spend",
      "from_stock": "stock-cash",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-hiring",
      "name": "Hiring",
      "equation": "IF Cash_Balance > Hiring_Threshold THEN Target_Hire_Rate ELSE 0",
      "from_stock": null,
      "to_stock": "stock-employees",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-attrition",
      "name": "Attrition",
      "equation": "Employee_Count * Attrition_Rate",
      "from_stock": "stock-employees",
      "to_stock": null,
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-cust-acq",
      "name": "Customer_Acquisition",
      "equation": "Marketing_Spend / CAC * Sales_Efficiency",
      "from_stock": null,
      "to_stock": "stock-customers",
      "position": {
        "x": 525,
        "y": 200
      }
    },
    {
      "id": "flow-churn",
      "name": "Customer_Churn",
      "equation": "Customers * Churn_Rate",
      "from_stock": "stock-customers",
      "to_stock": null,
      "position": {
        "x": 675,
        "y": 200
      }
    },
    {
      "id": "flow-arr-growth",
      "name": "ARR_Growth",
      "equation": "(Customer_Acquisition - Customer_Churn) * ARPC * 12",
      "from_stock": null,
      "to_stock": "stock-arr",
      "position": {
        "x": 600,
        "y": 275
      }
    }
  ],
  "variables": [
