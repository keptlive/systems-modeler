{
  "id": "saas-subscription-dynamics-eco",
  "name": "SaaS Subscription Business Dynamics",
  "description": "System dynamics model of Software-as-a-Service subscription business growth. Captures customer acquisition, churn, MRR dynamics, and the impact of customer success on retention.",
  "source": "https://link.springer.com/article/10.1007/s12525-019-00329-y",
  "reference": "Groesser & Jovy (2019). System dynamics for corporate business model innovation. Electronic Markets, 30, 385-402.",
  "stocks": [
    {
      "id": "stock-prospects",
      "name": "Prospects",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "stock-trials",
      "name": "Trial Users",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "stock-customers",
      "name": "Active Customers",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "stock-churned",
      "name": "Churned Customers",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 700,
        "y": 150
      }
    },
    {
      "id": "stock-mrr",
      "name": "Monthly Recurring Revenue",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "stock-product-quality",
      "name": "Product Quality",
      "initial_value": 0.7,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-lead-gen",
      "name": "Lead Generation",
      "equation": "Marketing_Spend * Lead_Gen_Efficiency * Market_Awareness",
      "from_stock": null,
      "to_stock": "stock-prospects",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "flow-trial-start",
      "name": "Trial Signups",
      "equation": "Prospects * Conversion_to_Trial * (1 - Competitive_Pressure)",
      "from_stock": "stock-prospects",
      "to_stock": "stock-trials",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-conversion",
      "name": "Trial Conversion",
      "equation": "Trial_Users * Trial_Conversion_Rate * Product_Quality / Trial_Period",
      "from_stock": "stock-trials",
      "to_stock": "stock-customers",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-churn",
      "name": "Customer Churn",
      "equation": "Active_Customers * Base_Churn_Rate * (2 - Product_Quality - Customer_Success_Effect)",
      "from_stock": "stock-customers",
      "to_stock": "stock-churned",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "flow-mrr-increase",
      "name": "MRR Growth",
      "equation": "New_Customer_Revenue + Expansion_Revenue",
      "from_stock": null,
      "to_stock": "stock-mrr",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "flow-mrr-decrease",
      "name": "MRR Loss",
      "equation": "Churned_Revenue + Contraction_Revenue",
      "from_stock": "stock-mrr",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "flow-quality-improvement",
      "name": "Quality Improvement",
      "equation": "R_D_Investment / 100000 * (1 - Product_Quality)",
      "from_stock": null,
      "to_stock": "stock-product-quality",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-quality-decay",
      "name": "Quality Decay",
      "equation": "Product_Quality * Tech_Debt_Rate",
      "from_stock": "stock-product-quality",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-marketing",
      "name": "Marketing Spend",
      "equation": "Monthly_Recurring_Revenue * 0.3",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-lead-eff",
      "name": "Lead Gen Efficiency",
      "equation": "0.01",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-awareness",
      "name": "Market Awareness",
      "equation": "MIN(1, Active_Customers / 1000)",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "var-conv-trial",
      "name": "Conversion to Trial",
      "equation": "0.1",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-competitive",
      "name": "Competitive Pressure",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-trial-conv",
      "name": "Trial Conversion Rate",
      "equation": "0.25",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-trial-period",
      "name": "Trial Period",
      "equation": "14",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-base-churn",
      "name": "Base Churn Rate",
      "equation": "0.05",
      "position": {
        "x": 600,
        "y": 50
      }
    },
    {
      "id": "var-cs-effect",
      "name": "Customer Success Effect",
      "equation": "CS_Investment / (Active_Customers * 100 + 1)",
      "position": {
        "x": 700,
        "y": 50
      }
    },
    {
      "id": "var-cs-invest",
      "name": "CS Investment",
      "equation": "Monthly_Recurring_Revenue * 0.1",
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "id": "var-arpu",
      "name": "ARPU",
      "equation": "100",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "var-new-rev",
      "name": "New Customer Revenue",
      "equation": "(Trial_Users * Trial_Conversion_Rate * Product_Quality / Trial_Period) * ARPU",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-expansion",
      "name": "Expansion Revenue",
      "equation": "Active_Customers * 0.02 * ARPU * Product_Quality",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-churned-rev",
      "name": "Churned Revenue",
      "equation": "Active_Customers * Base_Churn_Rate * (2 - Product_Quality - Customer_Success_Effect) * ARPU",
      "position": {
        "x": 550,
        "y": 250
      }
    },
    {
      "id": "var-contraction",
      "name": "Contraction Revenue",
      "equation": "Active_Customers * 0.01 * ARPU",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "var-rd",
      "name": "R D Investment",
      "equation": "Monthly_Recurring_Revenue * 0.25",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "var-tech-debt",
      "name": "Tech Debt Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 60,
    "dt": 0.25
  },
  "created_at": "2026-01-12T03:11:09.889287+00:00",
  "updated_at": "2026-01-12T03:11:09.889287+00:00"
}