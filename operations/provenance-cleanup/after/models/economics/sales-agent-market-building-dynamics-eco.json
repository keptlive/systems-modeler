      "name": "Months of Expenses per Tier 2 Sale",
      "equation": "0.4",
      "position": {
        "x": 400,
        "y": 320
      }
    },
    {
      "id": "var-still-employed",
      "name": "Still Employed",
      "equation": "IF_THEN_ELSE(Months_of_Buffer < 0, 0, 1)",
      "position": {
        "x": 550,
        "y": 320
      }
    },
    {
      "id": "var-sales-effort-available",
      "name": "Sales Effort Available",
      "equation": "Fraction_of_Effort_for_Sales * Total_Effort_Available * Still_Employed",
      "position": {
        "x": 700,
        "y": 320
      }
    },
    {
      "id": "var-referrals-from-tier-1-clients",
      "name": "Referrals from Tier 1 Clients",
      "equation": "Tier_1_Clients * Frequency_of_Meetings * Referrals_per_Meeting",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-referrals-from-tier-2-clients",
      "name": "Referrals from Tier 2 Clients",
      "equation": "Tier_2_Clients * Frequency_of_Meetings * Referrals_per_Meeting",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "var-tier-1-referrals",
      "name": "Tier 1 Referrals",
      "equation": "Referrals_from_Tier_1_Clients * (1 - Up_Referral_Fraction)",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "var-tier-2-referrals",
      "name": "Tier 2 Referrals",
      "equation": "Referrals_from_Tier_2_Clients * (1 - Down_Referral_Fraction)",
      "position": {
        "x": 550,
        "y": 400
      }
    },
    {
      "id": "var-tier-1-referrals-from-tier-2",
      "name": "Tier 1 Referrals from Tier 2",
      "equation": "Referrals_from_Tier_2_Clients * Down_Referral_Fraction",
      "position": {
        "x": 700,
        "y": 400
      }
    },
    {
      "id": "var-tier-2-referrals-from-tier-1",
      "name": "Tier 2 Referrals from Tier 1",
      "equation": "Referrals_from_Tier_1_Clients * Up_Referral_Fraction",
      "position": {
        "x": 100,
        "y": 480
      }
    },
    {
      "id": "var-effort-devoted-to-tier-1-clients",
      "name": "Effort Devoted to Tier 1 Clients",
      "equation": "Tier_1_Clients * Time_per_Client_Meeting * Frequency_of_Meetings",
      "position": {
        "x": 250,
        "y": 480
      }
    },
    {
      "id": "var-effort-devoted-to-tier-2-clients",
      "name": "Effort Devoted to Tier 2 Clients",
      "equation": "Tier_2_Clients * Time_per_Client_Meeting * Frequency_of_Meetings",
      "position": {
        "x": 400,
        "y": 480
      }
    },
    {
      "id": "var-effort-remaining-after-servicing-existing-clients",
      "name": "Effort Remaining After Servicing Existing Clients",
      "equation": "MAX(Sales_Effort_Available - (Effort_Devoted_to_Tier_1_Clients + Effort_Devoted_to_Tier_2_Clients), 0)",
      "position": {
        "x": 550,
        "y": 480
      }
    },
    {
      "id": "var-effort-devoted-to-tier-2-leads",
      "name": "Effort Devoted to Tier 2 Leads",
      "equation": "MIN(Effort_Remaining_After_Servicing_Existing_Clients, Effort_Required_to_Make_a_Sale * Tier_2_Leads / Minimum_Time_to_Make_a_Sale)",
      "position": {
        "x": 700,
        "y": 480
      }
    },
    {
      "id": "var-effort-remaining-after-servicing-tier-2-leads",
      "name": "Effort Remaining After Servicing Tier 2 Leads",
      "equation": "MAX(Effort_Remaining_After_Servicing_Existing_Clients - Effort_Devoted_to_Tier_2_Leads, 0)",
      "position": {
        "x": 100,
        "y": 560
      }
    },
    {
      "id": "var-effort-devoted-to-tier-1-leads",
      "name": "Effort Devoted to Tier 1 Leads",
      "equation": "Effort_Remaining_After_Servicing_Tier_2_Leads",
      "position": {
        "x": 250,
        "y": 560
      }
    },
    {
      "id": "var-tier-1-income",
      "name": "Tier 1 Income",
      "equation": "Tier_1_Sales * Months_of_Expenses_per_Tier_1_Sale",
      "position": {
        "x": 400,
        "y": 560
      }
    },
    {
      "id": "var-tier-2-income",
      "name": "Tier 2 Income",
      "equation": "Tier_2_Sales * Months_of_Expenses_per_Tier_2_Sale",
      "position": {
        "x": 550,
        "y": 560
      }
    }
  ],
