      "equation": "Qualification_Rate * (Tier_2_Referrals + Tier_2_Referrals_from_Tier_1)",
      "from_stock": null,
      "to_stock": "stock-tier-2-leads",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "flow-tier-2-sales",
      "name": "Tier 2 Sales",
      "equation": "Success_Rate * MIN(Effort_Devoted_to_Tier_2_Leads / Effort_Required_to_Make_a_Sale, Tier_2_Leads / Minimum_Time_to_Make_a_Sale)",
      "from_stock": "stock-tier-2-leads",
      "to_stock": "stock-tier-2-clients",
      "position": {
        "x": 650,
        "y": 350
      }
    },
    {
      "id": "flow-tier-2-leads-going-stale",
      "name": "Tier 2 Leads Going Stale",
      "equation": "Tier_2_Leads / Lead_Shelf_Life",
      "from_stock": "stock-tier-2-leads",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 500
      }
    },
    {
      "id": "flow-tier-2-client-turnover",
      "name": "Tier 2 Client Turnover",
      "equation": "Tier_2_Clients / Client_Lifetime",
      "from_stock": "stock-tier-2-clients",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 500
      }
    },
    {
      "id": "flow-income",
      "name": "Income",
      "equation": "Tier_1_Income + Tier_2_Income + IF_THEN_ELSE(Time < Startup_Subsidy_Length, Startup_Subsidy, 0)",
      "from_stock": null,
      "to_stock": "stock-months-of-buffer",
      "position": {
        "x": 650,
        "y": 500
      }
    },
    {
      "id": "flow-expenses",
      "name": "Expenses",
      "equation": "1",
      "from_stock": "stock-months-of-buffer",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 650
      }
    },
    {
      "id": "flow-accumulating-tenure",
      "name": "Accumulating Tenure",
      "equation": "Still_Employed",
      "from_stock": null,
      "to_stock": "stock-tenure",
      "position": {
        "x": 450,
        "y": 650
      }
    },
    {
      "id": "flow-accumulating-sales",
      "name": "Accumulating Sales",
      "equation": "Tier_1_Sales + Tier_2_Sales",
      "from_stock": null,
      "to_stock": "stock-total-cumulative-sales",
      "position": {
        "x": 650,
        "y": 650
      }
    },
    {
