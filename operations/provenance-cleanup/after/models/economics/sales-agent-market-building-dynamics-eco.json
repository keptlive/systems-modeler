  "flows": [
    {
      "id": "flow-tier-1-lead-acquisition",
      "name": "Tier 1 Lead Acquisition",
      "equation": "Qualification_Rate * (Tier_1_Referrals + Tier_1_Referrals_from_Tier_2)",
      "from_stock": null,
      "to_stock": "stock-tier-1-leads",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-tier-1-sales",
      "name": "Tier 1 Sales",
      "equation": "Success_Rate * MIN(Effort_Devoted_to_Tier_1_Leads / Effort_Required_to_Make_a_Sale, Tier_1_Leads / Minimum_Time_to_Make_a_Sale)",
      "from_stock": "stock-tier-1-leads",
      "to_stock": "stock-tier-1-clients",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-tier-1-leads-going-stale",
      "name": "Tier 1 Leads Going Stale",
      "equation": "Tier_1_Leads / Lead_Shelf_Life",
      "from_stock": "stock-tier-1-leads",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-tier-1-client-turnover",
      "name": "Tier 1 Client Turnover",
      "equation": "Tier_1_Clients / Client_Lifetime",
      "from_stock": "stock-tier-1-clients",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
