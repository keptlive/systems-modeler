{
  "id": "hotelling-exhaustible-resource-model-eco",
  "name": "Hotelling Exhaustible Resource Model",
  "description": "Model of optimal extraction of non-renewable resources. Shows how resource prices rise at the rate of interest (Hotelling rule).",
  "stocks": [
    {
      "id": "stock-resource-stock",
      "name": "Resource_Stock",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-resource-price",
      "name": "Resource_Price",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-cumulative-extraction",
      "name": "Cumulative_Extraction",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-extraction",
      "name": "extraction",
      "equation": "demand_intercept * (Resource_Price / backstop_price)^demand_elasticity",
      "from_stock": "stock-resource-stock",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-price-change",
      "name": "price_change",
      "equation": "r * (Resource_Price - extraction_cost)",
      "from_stock": null,
      "to_stock": "stock-resource-price",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-r",
      "name": "r",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-extraction-cost",
      "name": "extraction_cost",
      "equation": "10",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-demand-elasticity",
      "name": "demand_elasticity",
      "equation": "-0.5",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-demand-intercept",
      "name": "demand_intercept",
      "equation": "100",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-backstop-price",
      "name": "backstop_price",
      "equation": "150",
      "position": {
        "x": 700,
        "y": 80
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Resource_Price",
      "to_element": "extraction"
    },
    {
      "id": "conn-2",
      "from_element": "r",
      "to_element": "extraction"
    },
    {
      "id": "conn-3",
      "from_element": "demand_elasticity",
      "to_element": "extraction"
    },
    {
      "id": "conn-4",
      "from_element": "demand_intercept",
      "to_element": "extraction"
    },
    {
      "id": "conn-5",
      "from_element": "backstop_price",
      "to_element": "extraction"
    },
    {
      "id": "conn-6",
      "from_element": "Resource_Price",
      "to_element": "price_change"
    },
    {
      "id": "conn-7",
      "from_element": "r",
      "to_element": "price_change"
    },
    {
      "id": "conn-8",
      "from_element": "extraction_cost",
      "to_element": "price_change"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
