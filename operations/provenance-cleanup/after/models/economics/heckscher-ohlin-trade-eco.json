{
  "id": "heckscher-ohlin-trade-eco",
  "name": "Heckscher-Ohlin Trade Model",
  "description": "Countries export goods intensive in their abundant factor. Factor price equalization theorem. Shows how trade affects income distribution. Nobel Prize 1977 (Ohlin).",
  "stocks": [
    {
      "id": "stock-capital-good",
      "name": "Capital Good Output",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-labor-good",
      "name": "Labor Good Output",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-capital-change",
      "name": "Capital Good Change",
      "equation": "Adjustment_Speed * (Optimal_Capital_Good - Capital_Good_Output)",
      "from_stock": null,
      "to_stock": "stock-capital-good",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "flow-labor-change",
      "name": "Labor Good Change",
      "equation": "Adjustment_Speed * (Optimal_Labor_Good - Labor_Good_Output)",
      "from_stock": null,
      "to_stock": "stock-labor-good",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-capital-endow",
      "name": "Capital Endowment",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-labor-endow",
      "name": "Labor Endowment",
      "equation": "100",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-kl-ratio",
      "name": "Capital Labor Ratio",
      "equation": "Capital_Endowment / Labor_Endowment",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-world-kl",
      "name": "World KL Ratio",
      "equation": "1.2",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-comparative-adv",
      "name": "Comparative Advantage",
      "equation": "IF(Capital_Labor_Ratio > World_KL_Ratio, 1, -1)",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-optimal-cap",
      "name": "Optimal Capital Good",
      "equation": "50 + 20 * Comparative_Advantage * Terms_of_Trade_Effect",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-optimal-lab",
      "name": "Optimal Labor Good",
      "equation": "50 - 20 * Comparative_Advantage * Terms_of_Trade_Effect",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "var-terms",
      "name": "Terms of Trade Effect",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 420
      }
    },
    {
      "id": "var-exports",
      "name": "Exports",
      "equation": "IF(Comparative_Advantage > 0, Capital_Good_Output - Domestic_Demand_Cap, Labor_Good_Output - Domestic_Demand_Lab)",
      "position": {
        "x": 350,
        "y": 420
      }
    },
    {
      "id": "var-domestic-cap",
      "name": "Domestic Demand Cap",
      "equation": "40",
      "position": {
        "x": 550,
        "y": 420
      }
    },
    {
      "id": "var-domestic-lab",
      "name": "Domestic Demand Lab",
      "equation": "40",
      "position": {
        "x": 250,
        "y": 490
      }
    },
    {
      "id": "var-adjust",
      "name": "Adjustment Speed",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 490
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Capital Labor Ratio",
      "to_element": "Comparative Advantage"
    },
    {
      "id": "conn-2",
      "from_element": "Comparative Advantage",
      "to_element": "Optimal Capital Good"
    },
    {
      "id": "conn-3",
      "from_element": "Comparative Advantage",
      "to_element": "Optimal Labor Good"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T07:45:54.017228+00:00",
  "updated_at": "2026-01-12T07:45:54.017235+00:00",
  "source": "https://doi.org/10.2307/1882517",
  "reference": "Ohlin B. Interregional and International Trade. Harvard University Press. 1933. Nobel Prize 1977."
}