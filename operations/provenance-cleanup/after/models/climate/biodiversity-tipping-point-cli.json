{
  "id": "biodiversity-tipping-point-cli",
  "name": "Biodiversity Tipping Point Model",
  "description": "Model of biodiversity loss showing species extinction, ecosystem services decline, and potential tipping points. Based on IPBES Global Assessment (2019).",
  "stocks": [
    {
      "id": "s1",
      "name": "Species Abundance",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Habitat Area",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Ecosystem Services",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Species Loss",
      "equation": "Species_Abundance * Extinction_Rate * (1 + Habitat_Loss_Effect)",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Species Recovery",
      "equation": "MAX(0, (Carrying_Capacity - Species_Abundance) * Recovery_Rate * Habitat_Area / 100)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "f3",
      "name": "Habitat Loss",
      "equation": "Habitat_Area * Conversion_Rate * Development_Pressure",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Habitat Restoration",
      "equation": "Conservation_Investment * Restoration_Efficiency",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "f5",
      "name": "Services Decline",
      "equation": "(100 - Species_Biodiversity_Index) * Service_Sensitivity",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Services Recovery",
      "equation": "Species_Abundance * Service_Generation_Rate",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 600,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Extinction Rate",
      "equation": "0.001",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Habitat Loss Effect",
      "equation": "MAX(0, (100 - Habitat_Area) / 50)",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v3",
      "name": "Carrying Capacity",
      "equation": "100",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Recovery Rate",
      "equation": "0.01",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Conversion Rate",
      "equation": "0.005",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Development Pressure",
      "equation": "1.5",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Conservation Investment",
      "equation": "1",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v8",
      "name": "Restoration Efficiency",
      "equation": "0.5",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v9",
      "name": "Species Biodiversity Index",
      "equation": "Species_Abundance * Habitat_Area / 100",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v10",
      "name": "Service Sensitivity",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v11",
      "name": "Service Generation Rate",
      "equation": "0.005",
      "position": {
        "x": 600,
        "y": 50
      }
    },
    {
      "id": "v12",
      "name": "Tipping Point Indicator",
      "equation": "IF(Species_Biodiversity_Index < 30, 1, 0)",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Species Abundance",
      "to_element": "Species Loss"
    },
    {
      "id": "c2",
      "from_element": "Habitat Area",
      "to_element": "Habitat Loss"
    },
    {
      "id": "c3",
      "from_element": "Ecosystem Services",
      "to_element": "Services Decline"
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "created_at": "2026-01-12T01:45:26.877667+00:00",
  "updated_at": "2026-01-12T01:45:26.877670+00:00",
  "source": "https://doi.org/10.5281/zenodo.3553579",
  "reference": "IPBES. Global assessment report on biodiversity and ecosystem services. IPBES Secretariat, Bonn, Germany. 2019."
}