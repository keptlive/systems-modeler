  "flows": [
    {
      "id": "f1",
      "name": "Price_Change",
      "equation": "(Net_Demand / Market_Depth) * Price_Sensitivity",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Capital_Inflow",
      "equation": "New_Money * FOMO_Effect * Market_Sentiment",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Capital_Outflow",
      "equation": "Speculative_Capital * Panic_Selling * (1 - Market_Sentiment)",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 280
      }
    },
    {
      "id": "f4",
      "name": "Sentiment_Change",
      "equation": "(Price_Momentum + News_Effect - Market_Sentiment) / Sentiment_Adjustment",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 280
      }
    },
    {
      "id": "f5",
      "name": "HODLer_Accumulation",
      "equation": "Speculative_Capital * 0.01 * Market_Sentiment",
