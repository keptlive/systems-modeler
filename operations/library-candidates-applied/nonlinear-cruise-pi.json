      "units": "kg*meter/second^2"
    },
    {
      "id": "a3",
      "name": "Slope",
      "equation": "IF(TIME<=HillStart,0,IF(TIME<=HillStart+HillRamp,HillAngle*(TIME-HillStart)/HillRamp,HillAngle))",
