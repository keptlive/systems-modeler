  "flows": [
    {
      "id": "kirschner-panetta-immune-second-biology:rate:Effectors",
      "name": "Effectors_net_rate",
      "equation": "antigenicity*Tumor-effector_loss*Effectors+stimulation*Effectors*IL2/(IL2_half+IL2)",
      "to_stock": "kirschner-panetta-immune-second-biology:Effectors",
      "units": "(cell)/time",
      "position": {
        "x": 120,
        "y": 300
      }
    },
    {
      "id": "kirschner-panetta-immune-second-biology:rate:Tumor",
      "name": "Tumor_net_rate",
      "equation": "tumor_growth*(1-inverse_capacity*Tumor)*Tumor-killing*Effectors*Tumor/(killing_half+Tumor)",
      "to_stock": "kirschner-panetta-immune-second-biology:Tumor",
      "units": "(cell)/time",
      "position": {
        "x": 280,
        "y": 300
      }
    },
    {
      "id": "kirschner-panetta-immune-second-biology:rate:IL2",
      "name": "IL2_net_rate",
      "equation": "IL2_production*Effectors*Tumor/(production_half+Tumor)-IL2_loss*IL2",
      "to_stock": "kirschner-panetta-immune-second-biology:IL2",
      "units": "(cytokine)/time",
      "position": {
        "x": 440,
        "y": 300
      }
    }
