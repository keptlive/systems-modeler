      "position": {
        "x": 460,
        "y": 230
      }
    }
  ],
  "flows": [
    {
      "id": "gilbert-single-spin-third-science:rate:Magnetization_X",
      "name": "Magnetization_X_net_rate",
      "equation": "-Precession*(Magnetization_Y+Damping*Magnetization_X*Magnetization_Z)",
      "to_stock": "gilbert-single-spin-third-science:Magnetization_X",
      "units": "(1)/(time)",
      "position": {
        "x": 140,
        "y": 330
      }
    },
    {
      "id": "gilbert-single-spin-third-science:rate:Magnetization_Y",
      "name": "Magnetization_Y_net_rate",
      "equation": "Precession*(Magnetization_X-Damping*Magnetization_Y*Magnetization_Z)",
      "to_stock": "gilbert-single-spin-third-science:Magnetization_Y",
      "units": "(1)/(time)",
      "position": {
        "x": 300,
        "y": 330
      }
    },
    {
      "id": "gilbert-single-spin-third-science:rate:Magnetization_Z",
      "name": "Magnetization_Z_net_rate",
      "equation": "Precession*Damping*(Magnetization_X^2+Magnetization_Y^2)",
      "to_stock": "gilbert-single-spin-third-science:Magnetization_Z",
      "units": "(1)/(time)",
      "position": {
        "x": 460,
        "y": 330
      }
    }
  ],
  "variables": [
