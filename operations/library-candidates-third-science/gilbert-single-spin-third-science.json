{
  "id": "gilbert-single-spin-third-science",
  "name": "Landau-Lifshitz-Gilbert single-spin precession and relaxation",
  "description": "One uniform magnetic moment precesses and aligns while preserving its length. No exchange/demagnetizing/anisotropy fields, thermal noise, spatial domains or domain-wall predictions. Illustrative unit magnetization(0.6,0,0.8),constant z-directed field absorbed into frequency1,damping0.1; horizon50,RK4step0.02. Normalized magnetization/time, no material-specific calibration. Original mathematical transcription/adaptation; not a calibrated forecast. Signed net-rate flows implement the stated equations. No numerical clamps or hidden resets.",
  "category": "physics",
  "source": "https://math.nist.gov/oommf/doc/userguide12b4/userguide.pdf",
  "reference": "NIST OOMMF User Guide, Landau-Lifshitz/Gilbert equations2-3 and gamma=(1+alpha^2)*gamma_LL; Gilbert (2004), doi:10.1109/TMAG.2004.836740.",
  "stocks": [
    {
      "id": "gilbert-single-spin-third-science:Magnetization_X",
      "name": "Magnetization_X",
      "initial_value": 0.6,
      "equation": "",
