      "units": "(person)/year",
      "position": {
        "x": 320,
        "y": 350
      }
    },
    {
      "id": "leslie-three-age-classes-biology:rate:Old",
      "name": "Old_net_rate",
      "equation": "(adult_survival*Adult-Old)/census_interval",
      "to_stock": "leslie-three-age-classes-biology:Old",
