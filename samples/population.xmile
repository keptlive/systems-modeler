<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0">
    <header>
        <name>Population Model</name>
    </header>
    <sim_specs>
        <start>0</start>
        <stop>100</stop>
        <dt>0.25</dt>
    </sim_specs>
    <model>
        <variables>
            <stock name="Population">
                <eqn>1000</eqn>
            </stock>
            <flow name="births">
                <eqn>Population * birth_rate</eqn>
            </flow>
            <flow name="deaths">
                <eqn>Population * death_rate</eqn>
            </flow>
            <aux name="birth_rate">
                <eqn>0.03</eqn>
            </aux>
            <aux name="death_rate">
                <eqn>0.02</eqn>
            </aux>
        </variables>
        <views>
            <view>
                <stock name="Population" x="200" y="150"/>
                <flow name="births" x="100" y="150"/>
                <flow name="deaths" x="300" y="150"/>
                <aux name="birth_rate" x="100" y="250"/>
                <aux name="death_rate" x="300" y="250"/>
            </view>
        </views>
    </model>
</xmile>
