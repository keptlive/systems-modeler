{
  "id": "invasive-species-ecosystem-env",
  "name": "Invasive Species and Native Ecosystem Dynamics",
  "description": "Model of invasive species spread and impact on native ecosystems, showing competition for resources and ecosystem degradation. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1038/nature06536",
  "reference": "Pimentel D, Zuniga R, Morrison D. Update on the environmental and economic costs associated with alien-invasive species. Ecological Economics. 2005;52(3):273-288.",
  "stocks": [
    {
      "id": "stock-native",
      "name": "Native_Species_Population",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-invasive",
      "name": "Invasive_Species_Population",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-resources",
      "name": "Available_Resources",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-native-grow",
      "name": "Native_Growth",
      "equation": "Native_Species_Population * native_growth_rate * Resource_Availability",
      "from_stock": null,
      "to_stock": "stock-native",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-native-death",
      "name": "Native_Mortality",
      "equation": "Native_Species_Population * (native_death_rate + competition_effect * Invasive_Species_Population / 1000)",
      "from_stock": "stock-native",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "flow-invasive-grow",
      "name": "Invasive_Growth",
      "equation": "Invasive_Species_Population * invasive_growth_rate * Resource_Availability",
      "from_stock": null,
      "to_stock": "stock-invasive",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "flow-invasive-death",
      "name": "Invasive_Mortality",
      "equation": "Invasive_Species_Population * invasive_death_rate",
      "from_stock": "stock-invasive",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "flow-resource-regen",
      "name": "Resource_Regeneration",
      "equation": "regeneration_rate * (carrying_capacity - Available_Resources)",
      "from_stock": null,
      "to_stock": "stock-resources",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-resource-consume",
      "name": "Resource_Consumption",
      "equation": "(Native_Species_Population + Invasive_Species_Population * invasive_consumption_factor) * consumption_rate",
      "from_stock": "stock-resources",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-ngr",
      "name": "native_growth_rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-ndr",
      "name": "native_death_rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-igr",
      "name": "invasive_growth_rate",
      "equation": "0.2",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-idr",
      "name": "invasive_death_rate",
      "equation": "0.03",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-comp",
      "name": "competition_effect",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-regen",
      "name": "regeneration_rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-cap",
      "name": "carrying_capacity",
      "equation": "1000",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-cons",
      "name": "consumption_rate",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-icf",
      "name": "invasive_consumption_factor",
      "equation": "1.5",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-avail",
      "name": "Resource_Availability",
      "equation": "Available_Resources / carrying_capacity",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T12:00:00.000000+00:00",
  "updated_at": "2026-01-12T12:00:00.000000+00:00"
}