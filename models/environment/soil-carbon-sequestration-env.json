{
  "id": "soil-carbon-sequestration-env",
  "name": "Soil Carbon Sequestration in Agriculture Model",
  "description": "Model of soil organic carbon dynamics under different agricultural practices. Reference: IPCC (2021). Climate Change 2021: The Physical Science Basis. Source: https://www.ipcc.ch/report/ar6/wg1/",
  "stocks": [
    {
      "id": "s1",
      "name": "Soil_Organic_Carbon",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Crop_Residue",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Microbial_Biomass",
      "initial_value": 2,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Residue_Input",
      "equation": "Crop_Yield * Residue_Fraction * Residue_Return",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "f2",
      "name": "Humification",
      "equation": "Crop_Residue * Humification_Rate * Microbial_Activity",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "SOC_Decomposition",
      "equation": "Soil_Organic_Carbon * Decomposition_Rate * Temperature_Factor",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "f4",
      "name": "Microbial_Growth",
      "equation": "Substrate_Availability * Growth_Efficiency",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "f5",
      "name": "Microbial_Death",
      "equation": "Microbial_Biomass * Turnover_Rate",
      "from_stock": "s3",
      "to_stock": "s1",
      "position": {
        "x": 325,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Crop_Yield",
      "equation": "8",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Residue_Fraction",
      "equation": "0.4",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Residue_Return",
      "equation": "0.8",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "v4",
      "name": "Humification_Rate",
      "equation": "0.2",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "v5",
      "name": "Microbial_Activity",
      "equation": "Microbial_Biomass / 2",
      "position": {
        "x": 175,
        "y": 250
      }
    },
    {
      "id": "v6",
      "name": "Decomposition_Rate",
      "equation": "0.02",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Temperature_Factor",
      "equation": "1",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v8",
      "name": "Substrate_Availability",
      "equation": "Crop_Residue * 0.5",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Growth_Efficiency",
      "equation": "0.4",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v10",
      "name": "Turnover_Rate",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "v11",
      "name": "Carbon_Stock_Change",
      "equation": "Humification + Microbial_Death - SOC_Decomposition",
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:32:16.976838+00:00",
  "updated_at": "2026-01-12T11:32:16.976838+00:00",
  "source": "https://doi.org/10.1038/s41586-019-1799-9",
  "reference": "Minasny B, et al. Soil carbon 4 per mille. Geoderma. 2017;292:59-86."
}