{
  "id": "marine-protected-area-env",
  "name": "Marine Protected Area Effectiveness Model",
  "description": "Model of fish stock recovery within marine protected areas showing spillover effects. Source: Roberts et al. (2001), Science. DOI: 10.1126/science.1057872",
  "stocks": [
    {
      "id": "stock-mpa",
      "name": "Fish_In_MPA",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-out",
      "name": "Fish_Outside_MPA",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-mpagrow",
      "name": "MPA_Growth",
      "equation": "Fish_In_MPA * Growth_Rate * (1 - Fish_In_MPA / MPA_Carrying)",
      "from_stock": null,
      "to_stock": "stock-mpa",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-spillover",
      "name": "Spillover",
      "equation": "Fish_In_MPA * Spillover_Rate * (Fish_In_MPA - Spillover_Threshold) / Fish_In_MPA",
      "from_stock": "stock-mpa",
      "to_stock": "stock-out",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-outgrow",
      "name": "Outside_Growth",
      "equation": "Fish_Outside_MPA * Growth_Rate * (1 - Fish_Outside_MPA / Outside_Carrying)",
      "from_stock": null,
      "to_stock": "stock-out",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-catch",
      "name": "Fishing_Catch",
      "equation": "Fish_Outside_MPA * Fishing_Effort * Catchability",
      "from_stock": "stock-out",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-growth",
      "name": "Growth_Rate",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-mpacarry",
      "name": "MPA_Carrying",
      "equation": "1000",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "var-spill",
      "name": "Spillover_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-spillthresh",
      "name": "Spillover_Threshold",
      "equation": "400",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "var-outcarry",
      "name": "Outside_Carrying",
      "equation": "800",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-effort",
      "name": "Fishing_Effort",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-catch",
      "name": "Catchability",
      "equation": "0.5",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "var-mparatio",
      "name": "MPA_Size_Ratio",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-total",
      "name": "Total_Stock",
      "equation": "Fish_In_MPA + Fish_Outside_MPA",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T12:45:39.561831+00:00",
  "updated_at": "2026-01-12T12:45:39.561831+00:00",
  "source": "https://systemdynamics.org/resources/",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}