{
  "id": "circular-economy-rebound-effect-env",
  "name": "Circular Economy Rebound Effect Model",
  "description": "System dynamics model investigating drivers and dynamics of rebound effect within circular economy systems. Shows only 32.82% of potential environmental savings are realized due to rebound effects. Reference: Rocco, M.V., et al. (2024). A System Dynamics Model for Analyzing the Circular Economy Rebound. Chemical Engineering Transactions, 114, 337-342. Source: https://doi.org/10.3303/CET24114057",
  "stocks": [
    {
      "id": "s1",
      "name": "Virgin Material Use",
      "initial_value": 100,
      "equation": "",
      "position": {"x": 100, "y": 150}
    },
    {
      "id": "s2",
      "name": "Recycled Material Use",
      "initial_value": 20,
      "equation": "",
      "position": {"x": 300, "y": 150}
    },
    {
      "id": "s3",
      "name": "Total Production",
      "initial_value": 100,
      "equation": "",
      "position": {"x": 500, "y": 150}
    },
    {
      "id": "s4",
      "name": "Environmental Savings Potential",
      "initial_value": 0,
      "equation": "",
      "position": {"x": 200, "y": 300}
    },
    {
      "id": "s5",
      "name": "Rebound Effect Accumulation",
      "initial_value": 0,
      "equation": "",
      "position": {"x": 400, "y": 300}
    },
    {
      "id": "s6",
      "name": "Net Environmental Benefit",
      "initial_value": 0,
      "equation": "",
      "position": {"x": 300, "y": 450}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Material Substitution",
      "equation": "Virgin_Material_Use * Circularity_Rate * Substitution_Efficiency",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {"x": 200, "y": 150}
    },
    {
      "id": "f2",
      "name": "Virgin Material Extraction",
      "equation": "Base_Demand + Induced_Demand - Virgin_Material_Use * Depreciation_Rate",
      "from_stock": null,
      "to_stock": "s1",
      "position": {"x": 50, "y": 150}
    },
    {
      "id": "f3",
      "name": "Production Increase",
      "equation": "(Recycled_Material_Use + Virgin_Material_Use) * Production_Rate - Total_Production * Consumption_Rate",
      "from_stock": null,
      "to_stock": "s3",
      "position": {"x": 450, "y": 100}
    },
    {
      "id": "f4",
      "name": "Savings Accumulation",
      "equation": "Material_Substitution * Unit_Savings_Potential",
      "from_stock": null,
      "to_stock": "s4",
      "position": {"x": 150, "y": 300}
    },
    {
      "id": "f5",
      "name": "Rebound Generation",
      "equation": "Cost_Savings_Effect * Demand_Elasticity * Total_Production * Emission_Intensity",
      "from_stock": null,
      "to_stock": "s5",
      "position": {"x": 450, "y": 300}
    },
    {
      "id": "f6",
      "name": "Net Benefit Calculation",
      "equation": "Savings_Accumulation - Rebound_Generation",
      "from_stock": null,
      "to_stock": "s6",
      "position": {"x": 300, "y": 400}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Circularity Rate",
      "equation": "0.08",
      "position": {"x": 200, "y": 100}
    },
    {
      "id": "v2",
      "name": "Substitution Efficiency",
      "equation": "0.85",
      "position": {"x": 250, "y": 200}
    },
    {
      "id": "v3",
      "name": "Base Demand",
      "equation": "5",
      "position": {"x": 50, "y": 100}
    },
    {
      "id": "v4",
      "name": "Induced Demand",
      "equation": "Cost_Savings_Effect * Demand_Elasticity * 2",
      "position": {"x": 100, "y": 200}
    },
    {
      "id": "v5",
      "name": "Depreciation Rate",
      "equation": "0.02",
      "position": {"x": 150, "y": 200}
    },
    {
      "id": "v6",
      "name": "Production Rate",
      "equation": "0.01",
      "position": {"x": 400, "y": 50}
    },
    {
      "id": "v7",
      "name": "Consumption Rate",
      "equation": "0.008",
      "position": {"x": 500, "y": 50}
    },
    {
      "id": "v8",
      "name": "Unit Savings Potential",
      "equation": "2.5",
      "position": {"x": 100, "y": 350}
    },
    {
      "id": "v9",
      "name": "Cost Savings Effect",
      "equation": "Recycled_Material_Use / (Virgin_Material_Use + 1) * 0.3",
      "position": {"x": 350, "y": 250}
    },
    {
      "id": "v10",
      "name": "Demand Elasticity",
      "equation": "0.7",
      "position": {"x": 450, "y": 250}
    },
    {
      "id": "v11",
      "name": "Emission Intensity",
      "equation": "0.5",
      "position": {"x": 500, "y": 350}
    },
    {
      "id": "v12",
      "name": "Realized Savings Fraction",
      "equation": "Net_Environmental_Benefit / MAX(1, Environmental_Savings_Potential)",
      "position": {"x": 300, "y": 500}
    },
    {
      "id": "v13",
      "name": "Rebound Percentage",
      "equation": "100 * (1 - Realized_Savings_Fraction)",
      "position": {"x": 400, "y": 500}
    }
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 100, "dt": 1},
  "created_at": "2026-01-15T16:00:00.000000",
  "updated_at": "2026-01-15T16:00:00.000000",
  "source": "https://doi.org/10.3303/CET24114057",
  "reference": "Rocco, M.V., et al. (2024). A System Dynamics Model for Analyzing the Circular Economy Rebound. Chemical Engineering Transactions, 114, 337-342."
}
