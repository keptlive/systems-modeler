{
  "id": "forest-fire-risk-assessment-env",
  "name": "Forest Fire Risk Model",
  "description": "Model of fire weather index and fire spread risk. Source: Van Wagner (1987), Canadian Forest Fire Weather Index System.",
  "stocks": [
    {
      "id": "s1",
      "name": "Fine_Fuel_Moisture",
      "initial_value": 85,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Duff_Moisture",
      "initial_value": 15,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Drought_Code",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "FFMC_Change",
      "equation": "(Equilibrium_FFMC - Fine_Fuel_Moisture) / Time_Lag_FFMC",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "DMC_Change",
      "equation": "(Rain_Effect + Drying_Rate_DMC) / 10",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "DC_Change",
      "equation": "0.5 * Potential_Evap - Rain_Effect_DC",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Temperature",
      "equation": "25",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Relative_Humidity",
      "equation": "40",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Wind_Speed",
      "equation": "15",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Precipitation",
      "equation": "0",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Equilibrium_FFMC",
      "equation": "0.942 * Relative_Humidity^0.679 + 11 * EXP((Relative_Humidity - 100) / 10) + 0.18 * (21.1 - Temperature)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Time_Lag_FFMC",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Drying_Rate_DMC",
      "equation": "(Temperature + 1.1) * (100 - Relative_Humidity) * 0.01",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Rain_Effect",
      "equation": "IF(Precipitation > 1.5, -Precipitation * 0.5, 0)",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Potential_Evap",
      "equation": "0.36 * (Temperature + 2.8)",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "v10",
      "name": "Rain_Effect_DC",
      "equation": "IF(Precipitation > 2.8, Precipitation * 0.8, 0)",
      "position": {
        "x": 300,
        "y": 480
      }
    },
    {
      "id": "v11",
      "name": "Fire_Weather_Index",
      "equation": "0.1 * (100 - Fine_Fuel_Moisture) * (Duff_Moisture / 10) * Wind_Speed / 10",
      "position": {
        "x": 500,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Relative_Humidity",
      "to_element": "Equilibrium_FFMC"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 1
  },
  "created_at": "2026-01-15T14:47:15.681952+00:00",
  "updated_at": "2026-01-15T14:47:15.681955+00:00",
  "source": "https://cfs.nrcan.gc.ca/publications?id=19927",
  "reference": "Van Wagner, C.E. (1987). Development and Structure of the Canadian Forest Fire Weather Index System. Canadian Forestry Service."
}