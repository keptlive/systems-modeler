{
  "id": "wildfire-risk-management-env",
  "name": "Wildfire Risk Management Model",
  "description": "Model of wildfire dynamics showing fuel accumulation, suppression, and climate effects. Reference: IPCC Climate Assessment Reports. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "s1",
      "name": "Fuel_Load",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Burned_Area",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Suppression_Capacity",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Fuel_Accumulation",
      "equation": "Vegetation_Growth * Growing_Season",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Fire_Consumption",
      "equation": "Fire_Spread_Rate * Fuel_Load * Ignition_Probability",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Prescribed_Burns",
      "equation": "Prescribed_Burn_Rate * Fuel_Load",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "f4",
      "name": "Vegetation_Recovery",
      "equation": "Burned_Area * Recovery_Rate",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "f5",
      "name": "Capacity_Investment",
      "equation": "Budget_Allocation - Maintenance",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 150,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Vegetation_Growth",
      "equation": "3",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Growing_Season",
      "equation": "1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "v3",
      "name": "Fire_Spread_Rate",
      "equation": "0.05 * Climate_Factor",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Ignition_Probability",
      "equation": "0.1 * (1 - Suppression_Effectiveness)",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "v5",
      "name": "Suppression_Effectiveness",
      "equation": "MIN(1, Suppression_Capacity / (Burned_Area + 10))",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "v6",
      "name": "Prescribed_Burn_Rate",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v7",
      "name": "Recovery_Rate",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Climate_Factor",
      "equation": "1.2",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Budget_Allocation",
      "equation": "2",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Maintenance",
      "equation": "Suppression_Capacity * 0.05",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:34:23.558448+00:00",
  "updated_at": "2026-01-12T11:34:23.558448+00:00",
  "source": "https://doi.org/10.1038/s41558-019-0613-1",
  "reference": "Abatzoglou JT, Williams AP. Impact of anthropogenic climate change on wildfire across western US forests. PNAS. 2016;113(42):11770-11775."
}