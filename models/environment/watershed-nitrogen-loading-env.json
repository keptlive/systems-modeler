{
  "id": "watershed-nitrogen-loading-env",
  "name": "Watershed Nitrogen Loading and Eutrophication",
  "description": "Model of nitrogen loading in watersheds leading to eutrophication in receiving waters. Tracks agricultural and urban sources of nitrogen and their transport through groundwater and surface runoff. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1038/35083562",
  "reference": "Galloway JN, Aber JD, Erisman JW, et al. The Nitrogen Cascade. BioScience. 2003;53(4):341-356.",
  "stocks": [
    {
      "id": "stock-soil-n",
      "name": "Soil_Nitrogen",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-gw-n",
      "name": "Groundwater_Nitrogen",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "stock-water-n",
      "name": "Surface_Water_Nitrogen",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "stock-algae",
      "name": "Algae_Biomass",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-fertilizer",
      "name": "Fertilizer_Application",
      "equation": "fertilizer_rate * cropland_area",
      "from_stock": null,
      "to_stock": "stock-soil-n",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-leach",
      "name": "Leaching",
      "equation": "Soil_Nitrogen * leaching_rate",
      "from_stock": "stock-soil-n",
      "to_stock": "stock-gw-n",
      "position": {
        "x": 275,
        "y": 150
      }
    },
    {
      "id": "flow-runoff",
      "name": "Surface_Runoff",
      "equation": "Soil_Nitrogen * runoff_rate",
      "from_stock": "stock-soil-n",
      "to_stock": "stock-water-n",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "flow-gw-discharge",
      "name": "Groundwater_Discharge",
      "equation": "Groundwater_Nitrogen * discharge_rate",
      "from_stock": "stock-gw-n",
      "to_stock": "stock-water-n",
      "position": {
        "x": 425,
        "y": 150
      }
    },
    {
      "id": "flow-uptake",
      "name": "Algae_Uptake",
      "equation": "Surface_Water_Nitrogen * uptake_rate * Algae_Biomass / (Algae_Biomass + 10)",
      "from_stock": "stock-water-n",
      "to_stock": "stock-algae",
      "position": {
        "x": 500,
        "y": 225
      }
    },
    {
      "id": "flow-decay",
      "name": "Algae_Decay",
      "equation": "Algae_Biomass * decay_rate",
      "from_stock": "stock-algae",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-fert",
      "name": "fertilizer_rate",
      "equation": "0.15",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-crop",
      "name": "cropland_area",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "var-leach",
      "name": "leaching_rate",
      "equation": "0.1",
      "position": {
        "x": 275,
        "y": 100
      }
    },
    {
      "id": "var-runoff",
      "name": "runoff_rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "var-discharge",
      "name": "discharge_rate",
      "equation": "0.02",
      "position": {
        "x": 425,
        "y": 100
      }
    },
    {
      "id": "var-uptake",
      "name": "uptake_rate",
      "equation": "0.3",
      "position": {
        "x": 600,
        "y": 225
      }
    },
    {
      "id": "var-decay",
      "name": "decay_rate",
      "equation": "0.1",
      "position": {
        "x": 600,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T12:00:00.000000+00:00",
  "updated_at": "2026-01-12T12:00:00.000000+00:00"
}