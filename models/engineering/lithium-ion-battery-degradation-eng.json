{
  "id": "lithium-ion-battery-degradation-eng",
  "name": "Lithium-Ion Battery Degradation Model",
  "description": "Model of battery capacity fade from cycling and calendar aging. Source: Barr\u00e9 et al. (2013), J Power Sources.",
  "stocks": [
    {
      "id": "s1",
      "name": "Capacity",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "SEI_Layer",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Capacity_Loss",
      "equation": "-(Cycle_Degradation + Calendar_Degradation)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "SEI_Growth",
      "equation": "SEI_Rate * (1 - SEI_Layer / SEI_Max) + Temperature_Factor * 0.001",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Cycles_Per_Day",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "DOD",
      "equation": "0.8",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Temperature",
      "equation": "25",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "SOC_Average",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Cycle_Degradation",
      "equation": "0.02 * Cycles_Per_Day * DOD^0.5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Temperature_Factor",
      "equation": "EXP((Temperature - 25) * 0.06)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Calendar_Degradation",
      "equation": "0.005 * Temperature_Factor * SOC_Average",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "SEI_Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "SEI_Max",
      "equation": "10",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "State_of_Health",
      "equation": "Capacity / 100",
      "position": {
        "x": 300,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Temperature",
      "to_element": "Temperature_Factor"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 3650,
    "dt": 1
  },
  "created_at": "2026-01-15T14:44:54.460963+00:00",
  "updated_at": "2026-01-15T14:44:54.460973+00:00",
  "source": "https://doi.org/10.1016/j.jpowsour.2013.01.116",
  "reference": "Barr\u00e9, A. et al. (2013). A review on lithium-ion battery ageing mechanisms and estimations. J Power Sources 241:680-689."
}