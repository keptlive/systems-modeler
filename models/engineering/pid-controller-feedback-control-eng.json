{
  "id": "pid-controller-feedback-control-eng",
  "name": "PID Controller Feedback System",
  "description": "Proportional-Integral-Derivative controller for process control. Source: \u00c5str\u00f6m & Murray (2008), Feedback Systems.",
  "stocks": [
    {
      "id": "s1",
      "name": "Process_Variable",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Integral_Term",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Process_Response",
      "equation": "(Control_Output - Process_Variable) / Process_Time_Constant",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Integral_Accumulation",
      "equation": "Error",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Setpoint",
      "equation": "100",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Kp",
      "equation": "2.0",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Ki",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Kd",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Process_Time_Constant",
      "equation": "5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Error",
      "equation": "Setpoint - Process_Variable",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Derivative_Term",
      "equation": "-Kd * (Control_Output - Process_Variable) / Process_Time_Constant",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Control_Output",
      "equation": "Kp * Error + Ki * Integral_Term + Derivative_Term",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Error",
      "to_element": "Control_Output"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.1
  },
