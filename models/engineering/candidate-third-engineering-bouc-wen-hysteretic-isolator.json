{
  "id": "candidate-third-engineering-bouc-wen-hysteretic-isolator",
  "name": "Bouc-Wen Hysteretic Structural Isolator",
  "category": "engineering",
  "description": "Source constitutive law specialized to n1 limit with an explicitly authored normalized mass/spring/damper and sinusoidal force. Internal hysteresis memory creates dissipative loops beyond a Duffing/purely elastic oscillator. No degradation, pinching, seismic calibration or hardware certification. Teaching reconstruction; not calibrated equipment or a certified controller. Missing dimensional annotations remain unknown.",
  "source": "https://skoge.folk.ntnu.no/prost/proceedings/acc04/Papers/0636_ThP09.1.pdf",
  "reference": "Ikhouane, Manosa and Rodellar, ACC2004, Bounded and dissipative solutions of the Bouc-Wen model",
  "stocks": [
    {
      "id": "s0",
      "name": "Displacement",
      "initial_value": 0.0,
      "position": {
        "x": 220,
        "y": 150
      },
      "units": "meter"
    },
    {
      "id": "s1",
      "name": "Velocity",
      "initial_value": 0.0,
      "position": {
        "x": 400,
        "y": 150
      },
      "units": "meter/second"
    },
    {
      "id": "s2",
      "name": "Hysteresis",
      "initial_value": 0.0,
      "position": {
        "x": 580,
        "y": 150
      },
      "units": "1"
    }
  ],
  "flows": [
    {
