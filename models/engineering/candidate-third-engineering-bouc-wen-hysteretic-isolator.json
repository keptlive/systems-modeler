        "x": 130,
        "y": 150
      },
      "units": "(meter)/second"
    },
    {
      "id": "f1",
      "name": "Change_Velocity",
      "equation": "(Force-Damping*Velocity-ElasticFraction*Stiffness*Displacement-(1-ElasticFraction)*YieldLength*Stiffness*Hysteresis)/Mass",
      "to_stock": "s1",
      "position": {
        "x": 310,
        "y": 150
      },
      "units": "(meter/second)/second"
    },
    {
      "id": "f2",
      "name": "Change_Hysteresis",
      "equation": "(Scale*Velocity-Beta*abs(Velocity)*Hysteresis-Gamma*Velocity*abs(Hysteresis))/YieldLength",
      "to_stock": "s2",
      "position": {
        "x": 490,
        "y": 150
      },
      "units": "(1)/second"
    }
  ],
