{
  "id": "heat-transfer-convection-eng",
  "name": "Heat Transfer Convection Model",
  "description": "Newton's law of cooling with convective heat transfer",
  "stocks": [
    {
      "id": "s1",
      "name": "Body_Temperature",
      "initial_value": 100.0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Heat_Energy",
      "initial_value": 1000.0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [],
  "variables": [
    {
      "id": "v1",
      "name": "Ambient_Temperature",
      "equation": "20.0",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Heat_Transfer_Coefficient",
      "equation": "10.0",
      "position": {
        "x": 230,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Surface_Area",
      "equation": "1.0",
      "position": {
        "x": 360,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Heat_Capacity",
      "equation": "100.0",
      "position": {
        "x": 490,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Heat_Loss",
      "equation": "Heat_Transfer_Coefficient*Surface_Area*(Body_Temperature-Ambient_Temperature)",
      "position": {
        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "Cooling_Rate",
      "equation": "Heat_Loss/Heat_Capacity",
      "position": {
        "x": 300,
        "y": 130
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Body_Temperature",
      "to_element": "Heat_Loss"
    },
    {
      "id": "c2",
      "from_element": "Ambient_Temperature",
      "to_element": "Heat_Loss"
    },
    {
      "id": "c3",
      "from_element": "Heat_Loss",
      "to_element": "Cooling_Rate"
    }
  ],
  "time_settings": {
    "start": 0.0,
    "end": 100.0,
    "dt": 0.1
  },
  "created_at": "2026-01-15T20:50:11.589913+00:00",
  "updated_at": "2026-01-15T20:50:11.589913+00:00",
  "source": "https://doi.org/10.1002/9780470172605",
  "reference": "Incropera, F.P. & DeWitt, D.P. (2007) Fundamentals of Heat and Mass Transfer. Wiley"
}