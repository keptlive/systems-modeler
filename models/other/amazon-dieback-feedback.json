{
  "id": "amazon-dieback-feedback",
  "name": "Amazon Forest Dieback Model",
  "description": "Model of Amazon rainforest tipping point with precipitation-vegetation feedback and fire dynamics.",
  "stocks": [
    {
      "id": "s1",
      "name": "Forest_Area",
      "initial_value": 5.5,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Savanna_Area",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Deforestation",
      "equation": "Forest_Area * Deforestation_Rate",
      "from_stock": "Forest_Area",
      "to_stock": "Savanna_Area",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Fire_Conversion",
      "equation": "Forest_Area * Fire_Rate * (1 - Precipitation / Reference_Precip)",
      "from_stock": "Forest_Area",
      "to_stock": "Savanna_Area",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "f3",
      "name": "Regrowth",
      "equation": "Savanna_Area * Regrowth_Rate * Precipitation / Reference_Precip",
      "from_stock": "Savanna_Area",
      "to_stock": "Forest_Area",
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Deforestation_Rate",
      "equation": "0.005",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Fire_Rate",
      "equation": "0.02",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Regrowth_Rate",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Reference_Precip",
      "equation": "2000",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Precipitation",
      "equation": "Reference_Precip * (0.5 + 0.5 * Forest_Area / 6)",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v6",
      "name": "Forest_Fraction",
      "equation": "Forest_Area / (Forest_Area + Savanna_Area)",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Tipping_Risk",
      "equation": "1 / (1 + EXP(5 * (Forest_Fraction - 0.4)))",
      "position": {
        "x": 350,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/s41467-020-15029-x",
  "reference": "Lovejoy, T.E. & Nobre, C. (2018). Amazon Tipping Point. Science Advances, 4(2). DOI: 10.1038/s41467-020-15029-x",
  "created_at": "2026-01-15T19:23:00.599757+00:00",
  "updated_at": "2026-01-15T19:23:00.599757+00:00"
}