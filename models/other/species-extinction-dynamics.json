{
  "id": "species-extinction-dynamics",
  "name": "Species Extinction Dynamics Model",
  "description": "Model of biodiversity loss due to habitat destruction and climate change pressures.",
  "stocks": [
    {
      "id": "s1",
      "name": "Species_Richness",
      "initial_value": 8700000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Habitat_Area",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Natural_Speciation",
      "equation": "Species_Richness * Speciation_Rate * Habitat_Area / 100",
      "from_stock": null,
      "to_stock": "Species_Richness",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Extinction",
      "equation": "Species_Richness * (Background_Rate + Habitat_Loss_Effect + Climate_Effect)",
      "from_stock": "Species_Richness",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Habitat_Loss",
      "equation": "Habitat_Area * Deforestation_Rate",
      "from_stock": "Habitat_Area",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Habitat_Restoration",
      "equation": "Conservation_Effort * Restoration_Rate",
      "from_stock": null,
      "to_stock": "Habitat_Area",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Speciation_Rate",
      "equation": "0.00001",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Background_Rate",
      "equation": "0.0001",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Deforestation_Rate",
      "equation": "0.005",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Conservation_Effort",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Restoration_Rate",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Habitat_Loss_Effect",
      "equation": "0.001 * (100 - Habitat_Area) / 100",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Temperature_Increase",
      "equation": "1.5",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Climate_Effect",
      "equation": "0.0005 * Temperature_Increase",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "v9",
      "name": "Extinction_Rate_Multiplier",
      "equation": "(Background_Rate + Habitat_Loss_Effect + Climate_Effect) / Background_Rate",
      "position": {
        "x": 350,
        "y": 450
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "source": "https://doi.org/10.1126/science.aax3100",
  "reference": "IPBES (2019). Global assessment report on biodiversity and ecosystem services. Science, 366(6469). DOI: 10.1126/science.aax3100",
  "created_at": "2026-01-15T19:26:14.001716+00:00",
  "updated_at": "2026-01-15T19:26:14.001716+00:00"
}