{
  "id": "covid19-seir-vaccination",
  "name": "COVID-19 SEIR with Vaccination",
  "description": "Extended SEIR model for COVID-19 including vaccination dynamics, waning immunity, and non-pharmaceutical interventions.",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 330000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Exposed",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Infected",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s5",
      "name": "Vaccinated",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "s6",
      "name": "Deaths",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Exposure_Rate",
      "equation": "Beta * Susceptible * Infected / Total_Population * (1 - NPI_Effect)",
      "from_stock": "Susceptible",
      "to_stock": "Exposed",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Infection_Rate",
      "equation": "Exposed / Latent_Period",
      "from_stock": "Exposed",
      "to_stock": "Infected",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Recovery_Rate",
      "equation": "Infected * (1 - IFR) / Infectious_Period",
      "from_stock": "Infected",
      "to_stock": "Recovered",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Death_Rate",
      "equation": "Infected * IFR / Infectious_Period",
      "from_stock": "Infected",
      "to_stock": "Deaths",
      "position": {
        "x": 475,
        "y": 275
      }
    },
    {
      "id": "f5",
      "name": "Vaccination_Rate",
      "equation": "MIN(Susceptible, Daily_Vaccines)",
      "from_stock": "Susceptible",
      "to_stock": "Vaccinated",
      "position": {
        "x": 100,
        "y": 275
      }
    },
    {
      "id": "f6",
      "name": "Immunity_Waning",
      "equation": "(Recovered + Vaccinated) / Immunity_Duration",
      "from_stock": "Recovered",
      "to_stock": "Susceptible",
      "position": {
        "x": 325,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Beta",
      "equation": "0.3",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Latent_Period",
      "equation": "5",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Infectious_Period",
      "equation": "10",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "IFR",
      "equation": "0.01",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "NPI_Effect",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Daily_Vaccines",
      "equation": "1000000",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Immunity_Duration",
      "equation": "180",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Total_Population",
      "equation": "Susceptible + Exposed + Infected + Recovered + Vaccinated",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "v9",
      "name": "R_Effective",
      "equation": "Beta * (Susceptible / Total_Population) * Infectious_Period * (1 - NPI_Effect)",
      "position": {
        "x": 450,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/s41591-020-0883-7",
  "reference": "Flaxman, S., et al. (2020). Estimating the effects of non-pharmaceutical interventions on COVID-19 in Europe. Nature, 584, 257-261. DOI: 10.1038/s41591-020-0883-7",
