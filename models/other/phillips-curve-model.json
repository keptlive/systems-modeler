{
  "id": "phillips-curve-model",
  "name": "Phillips Curve Model",
  "description": "The original Phillips curve relationship between unemployment and wage inflation. Foundation of macroeconomic policy analysis.",
  "stocks": [
    {
      "id": "s1",
      "name": "Employment",
      "initial_value": 95000000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Wage_Level",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Hiring",
      "equation": "MAX(0, Labor_Force - Employment) * Hiring_Rate",
      "from_stock": null,
      "to_stock": "Employment",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Separations",
      "equation": "Employment * Separation_Rate",
      "from_stock": "Employment",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Wage_Change",
      "equation": "Wage_Level * Wage_Inflation_Rate",
      "from_stock": null,
      "to_stock": "Wage_Level",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Labor_Force",
      "equation": "100000000",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Unemployment_Rate",
      "equation": "(Labor_Force - Employment) / Labor_Force",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v3",
      "name": "Natural_Unemployment_Rate",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Wage_Inflation_Rate",
      "equation": "-0.5 * (Unemployment_Rate - Natural_Unemployment_Rate)",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Hiring_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Separation_Rate",
      "equation": "0.02",
      "position": {
        "x": 300,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "source": "https://doi.org/10.2307/2550759",
