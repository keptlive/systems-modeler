{
  "id": "healthcare-worker-burnout",
  "name": "Healthcare Worker Burnout Model",
  "description": "Model of healthcare workforce attrition due to burnout and stress.",
  "stocks": [
    {
      "id": "s1",
      "name": "Active_Workers",
      "initial_value": 15000000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Burned_Out",
      "initial_value": 2000000,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Left_Profession",
      "initial_value": 500000,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Trainees",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 50,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Training_Completion",
      "equation": "Trainees / Training_Time",
      "from_stock": "Trainees",
      "to_stock": "Active_Workers",
      "position": {
        "x": 125,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Burnout_Onset",
      "equation": "Active_Workers * Burnout_Rate * Workload_Intensity",
      "from_stock": "Active_Workers",
      "to_stock": "Burned_Out",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Recovery",
      "equation": "Burned_Out * Recovery_Rate * Support_Programs",
      "from_stock": "Burned_Out",
      "to_stock": "Active_Workers",
      "position": {
        "x": 325,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Attrition",
      "equation": "Burned_Out * Attrition_Rate",
      "from_stock": "Burned_Out",
      "to_stock": "Left_Profession",
      "position": {
        "x": 575,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "New_Enrollment",
      "equation": "Enrollment_Rate * Career_Attractiveness",
      "from_stock": null,
      "to_stock": "Trainees",
      "position": {
        "x": 50,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Training_Time",
      "equation": "4",
      "position": {
        "x": 125,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Burnout_Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Workload_Intensity",
      "equation": "1.3",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Recovery_Rate",
      "equation": "0.15",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Support_Programs",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Attrition_Rate",
      "equation": "0.2",
      "position": {
        "x": 575,
        "y": 50
      }
    },
    {
      "id": "v7",
      "name": "Enrollment_Rate",
      "equation": "300000",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "v8",
      "name": "Career_Attractiveness",
      "equation": "0.8",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Workforce_Deficit",
      "equation": "MAX(0, 18000000 - Active_Workers)",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "connectors": [],
