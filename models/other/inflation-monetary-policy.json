{
  "id": "inflation-monetary-policy",
  "name": "Inflation and Monetary Policy Model",
  "description": "Model of inflation dynamics with central bank interest rate policy and expectations formation.",
  "stocks": [
    {
      "id": "s1",
      "name": "Inflation_Rate",
      "initial_value": 0.02,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Expected_Inflation",
      "initial_value": 0.02,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Output_Gap",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Inflation_Change",
      "equation": "(Phillips_Curve_Inflation - Inflation_Rate) / Inflation_Adjustment",
      "from_stock": null,
      "to_stock": "Inflation_Rate",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Expectations_Update",
      "equation": "(Inflation_Rate - Expected_Inflation) * Expectations_Weight",
      "from_stock": null,
      "to_stock": "Expected_Inflation",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Output_Change",
      "equation": "-Real_Interest_Rate * IS_Sensitivity - Output_Gap / Output_Persistence",
      "from_stock": null,
      "to_stock": "Output_Gap",
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Target_Inflation",
      "equation": "0.02",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Natural_Rate",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Taylor_Rule_Rate",
      "equation": "Natural_Rate + Target_Inflation + 1.5 * (Inflation_Rate - Target_Inflation) + 0.5 * Output_Gap",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Policy_Rate",
      "equation": "MAX(0, Taylor_Rule_Rate)",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Real_Interest_Rate",
      "equation": "Policy_Rate - Expected_Inflation",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v6",
      "name": "Phillips_Curve_Inflation",
      "equation": "Expected_Inflation + Phillips_Slope * Output_Gap + Supply_Shock",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Phillips_Slope",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v8",
      "name": "Supply_Shock",
      "equation": "0",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "IS_Sensitivity",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Inflation_Adjustment",
      "equation": "4",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v11",
      "name": "Expectations_Weight",
      "equation": "0.3",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "v12",
      "name": "Output_Persistence",
      "equation": "4",
      "position": {
        "x": 200,
        "y": 400
      }
    }
  ],
