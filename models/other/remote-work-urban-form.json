{
  "id": "remote-work-urban-form",
  "name": "Remote Work and Urban Form Model",
  "description": "Model of how remote work reshapes urban development patterns.",
  "stocks": [
    {
      "id": "s1",
      "name": "Office_Workers_CBD",
      "initial_value": 30000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Remote_Workers",
      "initial_value": 10000000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Hybrid_Workers",
      "initial_value": 15000000,
      "equation": "",
      "position": {
        "x": 225,
        "y": 350
      }
    },
    {
      "id": "s4",
      "name": "Suburban_Population",
      "initial_value": 100000000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Go_Remote",
      "equation": "Office_Workers_CBD * Remote_Rate * Tech_Enablement",
      "from_stock": "Office_Workers_CBD",
      "to_stock": "Remote_Workers",
      "position": {
        "x": 225,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Go_Hybrid",
      "equation": "Office_Workers_CBD * Hybrid_Rate",
      "from_stock": "Office_Workers_CBD",
      "to_stock": "Hybrid_Workers",
      "position": {
        "x": 150,
        "y": 275
      }
    },
    {
      "id": "f3",
      "name": "Return_Office",
      "equation": "Remote_Workers * Return_Rate * Management_Preference",
      "from_stock": "Remote_Workers",
      "to_stock": "Office_Workers_CBD",
      "position": {
        "x": 225,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Suburbanize",
      "equation": "Remote_Workers * Relocation_Rate * Housing_Affordability",
      "from_stock": null,
      "to_stock": "Suburban_Population",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Remote_Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Tech_Enablement",
      "equation": "0.9",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Hybrid_Rate",
      "equation": "0.15",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v4",
      "name": "Return_Rate",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Management_Preference",
      "equation": "0.6",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Relocation_Rate",
      "equation": "0.08",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "v7",
      "name": "Housing_Affordability",
      "equation": "0.7",
      "position": {
        "x": 500,
        "y": 400
      }
    },
    {
      "id": "v8",
      "name": "Remote_Share",
      "equation": "(Remote_Workers + Hybrid_Workers) / (Office_Workers_CBD + Remote_Workers + Hybrid_Workers)",
      "position": {
        "x": 400,
        "y": 100
      }
    }
  ],
