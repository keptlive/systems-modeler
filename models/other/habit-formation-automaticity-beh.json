{
  "id": "habit-formation-automaticity-beh",
  "name": "Habit Formation and Automaticity Model",
  "description": "Development of automatic behavioral patterns. Source: Lally et al. (2010), European Journal of Social Psychology.",
  "stocks": [
    {
      "id": "s1",
      "name": "Habit_Strength",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Automaticity",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Behavior_Frequency",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Habit_Growth",
      "equation": "Learning_Rate * (Asymptote - Habit_Strength) * Behavior_Performed",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Automaticity_Change",
      "equation": "(Habit_Strength - Automaticity) / Lag_Time",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Behavior_Count",
      "equation": "Behavior_Performed",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Asymptote",
      "equation": "100",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Learning_Rate",
      "equation": "0.03",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Lag_Time",
      "equation": "7",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Intention",
      "equation": "0.8",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Context_Cue",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Behavior_Probability",
      "equation": "Intention * (1 - Automaticity / 100) + Automaticity / 100 * Context_Cue",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Behavior_Performed",
      "equation": "IF(Behavior_Probability > 0.5, 1, 0)",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v8",
      "name": "Days_To_Habit",
      "equation": "IF(Automaticity > 95, TIME, 0)",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Consistency",
      "equation": "Behavior_Frequency / (TIME + 1)",
      "position": {
        "x": 300,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Habit_Strength",
      "to_element": "Automaticity_Change"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-15T14:54:39.083638+00:00",
  "updated_at": "2026-01-15T14:54:39.083641+00:00",
  "source": "https://doi.org/10.1002/ejsp.674",
  "reference": "Lally, P. et al. (2010). How are habits formed: Modelling habit formation in the real world. European Journal of Social Psychology 40:998-1009."
}