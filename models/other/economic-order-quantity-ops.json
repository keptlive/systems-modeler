      "position": {
        "x": 360,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "EOQ",
      "equation": "2.449*(Demand_Rate*Order_Cost/Holding_Cost)",
      "position": {
        "x": 490,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Reorder_Point",
      "equation": "Demand_Rate*0.1",
      "position": {
        "x": 620,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Annual_Cost",
      "equation": "(Demand_Rate/EOQ)*Order_Cost+(EOQ/2)*Holding_Cost",
