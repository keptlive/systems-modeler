      "position": {
        "x": 360,
        "y": 130
      }
    },
    {
      "id": "v9",
      "name": "Effect_of_System_Pressure_on_Productivity",
      "equation": "WITH LOOKUP ( System_Pressure, ([(0,0)-(2,2)],(0,0.62),(0.2,0.65),(0.4,0.7),(0.6,0.79),(0.8,0.89),(1,1),(1.2,1.14)\\ ,(1.4,1.24),(1.6,1.32),(1.8,1.37),(2,1.4) ))",
      "position": {
        "x": 490,
        "y": 130
      }
    },
    {
      "id": "v10",
      "name": "Effect_of_System_Pressure_on_Work_Year",
      "equation": "WITH LOOKUP ( System_Pressure, ([(0,0)-(2.5,1.5)],(0,0.75),(0.25,0.79),(0.5,0.84),(0.75,0.9),(1,1),(1.25,1.09),(1.5\\ ,1.17),(1.75,1.23),(2,1.25),(2.25,1.25),(2.5,1.25) ))",
      "position": {
        "x": 620,
        "y": 130
      }
    },
    {
