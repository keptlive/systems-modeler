{
  "id": "attentional-blink-temporal-attention-cog",
  "name": "Attentional Blink Model",
  "description": "Temporal attention and target detection. Source: Chun & Potter (1995), JEP: HPP.",
  "stocks": [
    {
      "id": "s1",
      "name": "Attention_Resources",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "T1_Processing",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "T2_Detection",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Resource_Recovery",
      "equation": "(1 - Attention_Resources) / Recovery_Time - Resource_Depletion",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "T1_Consolidation",
      "equation": "(T1_Target - T1_Processing) / Consolidation_Time",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "T2_Update",
      "equation": "T2_Detection_Attempt * Attention_Resources",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Recovery_Time",
      "equation": "500",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Consolidation_Time",
      "equation": "200",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Lag",
      "equation": "TIME",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "T1_Target",
      "equation": "IF(TIME > 100, 1, 0)",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "T2_Target",
      "equation": "IF(TIME > 100 + Lag, 1, 0)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Resource_Depletion",
      "equation": "T1_Target * 0.8 * Attention_Resources",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v7",
      "name": "T2_Detection_Attempt",
      "equation": "T2_Target",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "v8",
      "name": "Blink_Magnitude",
      "equation": "1 - T2_Detection / (T2_Target + 0.01)",
      "position": {
        "x": 300,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Attention_Resources",
      "to_element": "T2_Detection"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 1000,
    "dt": 10
  },
  "created_at": "2026-01-15T14:54:39.082485+00:00",
  "updated_at": "2026-01-15T14:54:39.083540+00:00",
  "source": "https://doi.org/10.1037/0096-1523.21.1.109",
  "reference": "Chun, M.M. & Potter, M.C. (1995). A two-stage model for multiple target detection in rapid serial visual presentation. JEP: Human Perception and Performance 21:109-127."
}