{
  "id": "bass-diffusion-innovation",
  "name": "Bass Diffusion Model",
  "description": "Frank Bass's model of new product adoption through innovation and imitation effects. Foundational model for technology adoption forecasting.",
  "stocks": [
    {
      "id": "s1",
      "name": "Potential_Adopters",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Adopters",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Adoption_Rate",
      "equation": "Potential_Adopters * (Innovation_Coefficient + Imitation_Coefficient * Adopters / Market_Size)",
      "from_stock": "Potential_Adopters",
      "to_stock": "Adopters",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Innovation_Coefficient",
      "equation": "0.03",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Imitation_Coefficient",
      "equation": "0.38",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Market_Size",
      "equation": "1000000",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Market_Penetration",
      "equation": "Adopters / Market_Size",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.1
  },
  "source": "https://doi.org/10.1287/mnsc.15.5.215",
  "reference": "Bass, F.M. (1969). A New Product Growth Model for Consumer Durables. Management Science, 15(5), 215-227. DOI: 10.1287/mnsc.15.5.215",
