        "x": 450,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Ocean_Uptake",
      "equation": "Atmospheric_Carbon * Ocean_Exchange_Rate - Ocean_Carbon * Ocean_Outgassing_Rate",
