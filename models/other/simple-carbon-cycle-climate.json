      "to_stock": "Ocean_Carbon",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Terrestrial_Uptake",
      "equation": "Atmospheric_Carbon * Photosynthesis_Rate",
