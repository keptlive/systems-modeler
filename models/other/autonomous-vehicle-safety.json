      "initial_value": 38000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "ADAS_Adoption",
      "equation": "Human_Driven * Adoption_Rate * Tech_Availability",
      "from_stock": "Human_Driven",
      "to_stock": "Level_2_ADAS",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "AV_Adoption",
      "equation": "Level_2_ADAS * AV_Rate * Regulatory_Approval",
      "from_stock": "Level_2_ADAS",
      "to_stock": "Level_4_AV",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Fatality_Change",
      "equation": "(Human_Driven * Human_Crash_Rate + Level_2_ADAS * ADAS_Crash_Rate + Level_4_AV * AV_Crash_Rate) * 0.00001 - Annual_Fatalities * 0.1",
      "from_stock": null,
      "to_stock": "Annual_Fatalities",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "f4",
      "name": "Scrapping",
      "equation": "(Human_Driven + Level_2_ADAS + Level_4_AV) * Scrap_Rate",
      "from_stock": null,
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
