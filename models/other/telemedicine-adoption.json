{
  "id": "telemedicine-adoption",
  "name": "Telemedicine Adoption and Healthcare Access Model",
  "description": "Model of virtual healthcare adoption post-pandemic.",
  "stocks": [
    {
      "id": "s1",
      "name": "In_Person_Only",
      "initial_value": 250000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Telemedicine_Users",
      "initial_value": 50000000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Hybrid_Users",
      "initial_value": 20000000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "First_Adoption",
      "equation": "In_Person_Only * Trial_Rate * (Convenience_Factor + Access_Need)",
      "from_stock": "In_Person_Only",
      "to_stock": "Telemedicine_Users",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Hybrid_Shift",
      "equation": "Telemedicine_Users * Hybrid_Rate",
      "from_stock": "Telemedicine_Users",
      "to_stock": "Hybrid_Users",
      "position": {
        "x": 325,
        "y": 275
      }
    },
    {
      "id": "f3",
      "name": "Return_InPerson",
      "equation": "Telemedicine_Users * Return_Rate * (1 - Satisfaction)",
      "from_stock": "Telemedicine_Users",
      "to_stock": "In_Person_Only",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Hybrid_to_Tele",
      "equation": "Hybrid_Users * 0.1",
      "from_stock": "Hybrid_Users",
      "to_stock": "Telemedicine_Users",
      "position": {
        "x": 325,
        "y": 325
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Trial_Rate",
      "equation": "0.08",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Convenience_Factor",
      "equation": "0.7",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Access_Need",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Hybrid_Rate",
      "equation": "0.15",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v5",
      "name": "Return_Rate",
      "equation": "0.05",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Satisfaction",
      "equation": "0.75",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Digital_Healthcare_Share",
      "equation": "(Telemedicine_Users + Hybrid_Users) / (In_Person_Only + Telemedicine_Users + Hybrid_Users)",
      "position": {
        "x": 250,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2035,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1056/NEJMsr2024312",
  "reference": "Wosik, J., et al. (2020). Telehealth transformation: COVID-19 and the rise of virtual care. Journal of the American Medical Informatics Association, 27(6), 957-962. DOI: 10.1056/NEJMsr2024312",
  "created_at": "2026-01-15T19:34:06.223149+00:00",
  "updated_at": "2026-01-15T19:34:06.223149+00:00"
}