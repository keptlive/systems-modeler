      "to_stock": "Ventilator_Patients",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Ward_Discharge",
      "equation": "General_Ward * (1 - ICU_Rate) / Ward_LOS",
      "from_stock": "General_Ward",
      "to_stock": "Discharged",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "f5",
      "name": "ICU_Discharge",
      "equation": "ICU * (1 - Ventilator_Rate) * (1 - ICU_Mortality) / ICU_LOS",
      "from_stock": "ICU",
      "to_stock": "Discharged",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "f6",
      "name": "ICU_Deaths",
      "equation": "ICU * ICU_Mortality / ICU_LOS",
      "from_stock": "ICU",
      "to_stock": "Deaths",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "f7",
      "name": "Vent_Deaths",
      "equation": "Ventilator_Patients * Vent_Mortality / Vent_LOS",
      "from_stock": "Ventilator_Patients",
      "to_stock": "Deaths",
      "position": {
        "x": 550,
        "y": 250
      }
    },
    {
      "id": "f8",
      "name": "Vent_Recovery",
      "equation": "Ventilator_Patients * (1 - Vent_Mortality) / Vent_LOS",
      "from_stock": "Ventilator_Patients",
      "to_stock": "Discharged",
      "position": {
        "x": 450,
        "y": 350
      }
    }
