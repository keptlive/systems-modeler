  "flows": [
    {
      "id": "f1",
      "name": "Admissions",
      "equation": "Daily_Cases * Hospitalization_Rate",
      "from_stock": null,
      "to_stock": "General_Ward",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "ICU_Transfer",
      "equation": "General_Ward * ICU_Rate / Ward_LOS",
      "from_stock": "General_Ward",
      "to_stock": "ICU",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Ventilator_Need",
      "equation": "ICU * Ventilator_Rate / ICU_LOS",
