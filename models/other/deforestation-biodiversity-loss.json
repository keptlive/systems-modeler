{
  "id": "deforestation-biodiversity-loss",
  "name": "Deforestation Biodiversity Loss Model",
  "description": "Model of species extinction from habitat fragmentation and deforestation.",
  "stocks": [
    {
      "id": "s1",
      "name": "Forest_Area",
      "initial_value": 4000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Species_Count",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Protected_Area",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 150,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Deforestation",
      "equation": "Forest_Area * Deforestation_Rate * Economic_Pressure",
      "from_stock": "Forest_Area",
      "to_stock": null,
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Extinction",
      "equation": "Species_Count * Extinction_Rate * (1 - Habitat_Ratio)",
      "from_stock": "Species_Count",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Protection",
      "equation": "Forest_Area * Protection_Rate * Conservation_Effort",
      "from_stock": "Forest_Area",
      "to_stock": "Protected_Area",
      "position": {
        "x": 150,
        "y": 275
      }
    },
    {
      "id": "f4",
      "name": "Reforestation",
      "equation": "Reforestation_Rate * Investment",
      "from_stock": null,
      "to_stock": "Forest_Area",
      "position": {
        "x": 250,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Deforestation_Rate",
      "equation": "0.01",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Economic_Pressure",
      "equation": "0.8",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Extinction_Rate",
      "equation": "0.001",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Habitat_Ratio",
      "equation": "(Forest_Area + Protected_Area) / 5000",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Protection_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "v6",
      "name": "Conservation_Effort",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "v7",
      "name": "Reforestation_Rate",
      "equation": "10",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "v8",
      "name": "Investment",
      "equation": "0.3",
      "position": {
        "x": 350,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "source": "https://doi.org/10.1126/science.aax3100",
  "reference": "Brondizio, E.S., et al. (2019). Global assessment report on biodiversity and ecosystem services. IPBES. Science, 366(6462). DOI: 10.1126/science.aax3100",
