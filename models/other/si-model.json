{
  "id": "si-model",
  "name": "Si Model",
  "description": "Model from SI_Model.mdl",
  "stocks": [
    {
      "id": "s1",
      "name": "Population_Infected_with_Ebola",
      "initial_value": 1.0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Population_Susceptible_to_Ebola",
      "initial_value": 0.0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Cumulative_Reported_Cases",
      "initial_value": 0.0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Infection_Rate",
      "equation": "Contacts_Between_Infected_and_Uninfected_Persons * Infectivity",
      "from_stock": "Population_Susceptible_to_Ebola",
      "to_stock": "Population_Infected_with_Ebola",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Contact_Frequency",
      "equation": "7.0",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Contacts_Between_Infected_and_Uninfected_Persons",
      "equation": "Probability_of_Contact_with_Infected_Person * Susceptible_Contacts",
      "position": {
        "x": 230,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Infectivity",
      "equation": "0.05",
      "position": {
        "x": 360,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Probability_of_Contact_with_Infected_Person",
      "equation": "Population_Infected_with_Ebola / Total_Population",
      "position": {
        "x": 490,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Susceptible_Contacts",
      "equation": "Contact_Frequency * Population_Susceptible_to_Ebola",
      "position": {
        "x": 620,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Total_Population",
      "equation": "7150.0",
      "position": {
        "x": 100,
        "y": 130
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Infectivity",
      "to_element": "Infection_Rate"
    },
    {
      "id": "c2",
      "from_element": "Contacts_Between_Infected_and_Uninfected_Persons",
      "to_element": "Infection_Rate"
    },
    {
      "id": "c3",
      "from_element": "Probability_of_Contact_with_Infected_Person",
      "to_element": "Contacts_Between_Infected_and_Uninfected_Persons"
    },
    {
      "id": "c4",
      "from_element": "Susceptible_Contacts",
