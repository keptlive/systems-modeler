    },
    {
      "id": "c6",
      "from_element": "Total_Population",
      "to_element": "Probability_of_Contact_with_Infected_Person"
    },
    {
      "id": "c7",
      "from_element": "Contact_Frequency",
      "to_element": "Susceptible_Contacts"
    },
    {
      "id": "c8",
      "from_element": "Population_Susceptible_to_Ebola",
      "to_element": "Susceptible_Contacts"
    }
