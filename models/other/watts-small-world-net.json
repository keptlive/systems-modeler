{
  "id": "watts-small-world-net",
  "name": "Watts-Strogatz Small World Network Model",
  "description": "Model of small-world network formation showing high clustering with short path lengths. Reference: Watts, D.J. & Strogatz, S.H. (1998). Collective dynamics of small-world networks.",
  "stocks": [
    {
      "id": "s1",
      "name": "Local_Connections",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Random_Connections",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Information_Spread",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Rewiring",
      "equation": "Local_Connections * Rewiring_Probability - Random_Connections * Decay_Rate",
      "from_stock": "Local_Connections",
      "to_stock": "Random_Connections",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Spread_Rate",
      "equation": "Information_Spread * (Local_Clustering * Local_Spread + Random_Connections * Long_Range_Spread)",
      "from_stock": null,
      "to_stock": "Information_Spread",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Rewiring_Probability",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Decay_Rate",
      "equation": "0.01",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Total_Connections",
      "equation": "Local_Connections + Random_Connections",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Local_Clustering",
      "equation": "Local_Connections / Total_Connections",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Local_Spread",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Long_Range_Spread",
      "equation": "0.5",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Path_Length",
      "equation": "LOG(Total_Connections) / MAX(0.1, Random_Connections)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Small_World_Index",
      "equation": "Local_Clustering / MAX(0.01, Path_Length)",
      "position": {
        "x": 550,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1038/30918",
  "reference": "Watts, D.J. & Strogatz, S.H. (1998). Collective dynamics of small-world networks. Nature, 393, 440-442.",
  "created_at": "2026-01-15T20:00:17.841627+00:00",
  "updated_at": "2026-01-15T20:00:17.841627+00:00"
}