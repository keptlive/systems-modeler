{
  "id": "ev-adoption-infrastructure",
  "name": "Electric Vehicle Adoption Model",
  "description": "Co-evolution of EV adoption and charging infrastructure showing network effects and policy impacts.",
  "stocks": [
    {
      "id": "s1",
      "name": "ICE_Vehicles",
      "initial_value": 270000000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "EV_Vehicles",
      "initial_value": 2000000,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Charging_Stations",
      "initial_value": 50000,
      "equation": "",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "EV_Adoption",
      "equation": "ICE_Vehicles * Adoption_Rate * Attractiveness",
      "from_stock": "ICE_Vehicles",
      "to_stock": "EV_Vehicles",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Vehicle_Retirement",
      "equation": "EV_Vehicles / Vehicle_Lifetime",
      "from_stock": "EV_Vehicles",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "ICE_Retirement",
      "equation": "ICE_Vehicles / Vehicle_Lifetime",
      "from_stock": "ICE_Vehicles",
      "to_stock": null,
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "New_ICE",
      "equation": "Total_New_Sales * (1 - EV_Market_Share)",
      "from_stock": null,
      "to_stock": "ICE_Vehicles",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "f5",
      "name": "Station_Construction",
      "equation": "Desired_Stations - Charging_Stations",
      "from_stock": null,
      "to_stock": "Charging_Stations",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Adoption_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Vehicle_Lifetime",
      "equation": "12",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Total_New_Sales",
      "equation": "17000000",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Stations_Per_EV",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "v5",
      "name": "Desired_Stations",
      "equation": "EV_Vehicles * Stations_Per_EV",
      "position": {
        "x": 500,
        "y": 400
      }
    },
    {
      "id": "v6",
      "name": "Charging_Availability",
      "equation": "MIN(1, Charging_Stations / (EV_Vehicles * 0.05))",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Cost_Parity",
      "equation": "0.7",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v8",
      "name": "Attractiveness",
      "equation": "Charging_Availability * Cost_Parity",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "EV_Market_Share",
      "equation": "EV_Vehicles / (ICE_Vehicles + EV_Vehicles)",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2050,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/s41560-021-00814-9",
  "reference": "Hoekstra, A. & Steinbuch, M. (2020). Comparing the lifetime greenhouse gas emissions of EVs and ICEVs. Nature Energy, 6, 1058-1060. DOI: 10.1038/s41560-021-00814-9",
  "created_at": "2026-01-15T19:23:00.599757+00:00",
  "updated_at": "2026-01-15T19:23:00.599757+00:00"
}