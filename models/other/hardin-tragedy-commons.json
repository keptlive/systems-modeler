{
  "id": "hardin-tragedy-commons",
  "name": "Tragedy of the Commons Model",
  "description": "System dynamics model of Hardin's tragedy of the commons showing how individual rational behavior leads to collective resource depletion.",
  "stocks": [
    {
      "id": "s1",
      "name": "Common_Resource",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Number_of_Users",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Resource_Regeneration",
      "equation": "Common_Resource * Regeneration_Rate * (1 - Common_Resource / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "Common_Resource",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Resource_Extraction",
      "equation": "Number_of_Users * Extraction_Per_User",
      "from_stock": "Common_Resource",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "New_Users",
      "equation": "Number_of_Users * Entry_Rate * Profitability",
      "from_stock": null,
      "to_stock": "Number_of_Users",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Exiting_Users",
      "equation": "Number_of_Users * Exit_Rate / Profitability",
      "from_stock": "Number_of_Users",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Regeneration_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Carrying_Capacity",
      "equation": "1000",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Extraction_Per_User",
      "equation": "20",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Entry_Rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Exit_Rate",
      "equation": "0.02",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Profitability",
      "equation": "MAX(0.1, Common_Resource / 500)",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.1
  },
  "source": "https://doi.org/10.1126/science.162.3859.1243",
  "reference": "Hardin, G. (1968). The Tragedy of the Commons. Science, 162(3859), 1243-1248. DOI: 10.1126/science.162.3859.1243",
