{
  "id": "population-growth-001",
  "name": "Population Growth",
  "description": "Classic population dynamics model with births, deaths, and carrying capacity Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "stock-population",
      "name": "Population",
      "initial_value": 100.0,
      "equation": "",
      "position": {
        "x": 350.0,
        "y": 200.0
      }
    }
  ],
  "flows": [
    {
      "id": "flow-births",
      "name": "Births",
      "equation": "Population * birth_rate * (1 - Population / carrying_capacity)",
      "from_stock": null,
      "to_stock": "Population",
      "position": {
        "x": 200.0,
        "y": 200.0
      }
    },
    {
      "id": "flow-deaths",
      "name": "Deaths",
      "equation": "Population * death_rate",
      "from_stock": "Population",
      "to_stock": null,
      "position": {
        "x": 500.0,
        "y": 200.0
      }
    }
  ],
  "variables": [
    {
      "id": "var-birth-rate",
      "name": "birth_rate",
      "equation": "0.03",
      "position": {
        "x": 200.0,
        "y": 100.0
      }
    },
    {
      "id": "var-death-rate",
      "name": "death_rate",
      "equation": "0.01",
      "position": {
        "x": 500.0,
        "y": 100.0
      }
    },
    {
      "id": "var-carrying-capacity",
      "name": "carrying_capacity",
      "equation": "1000",
      "position": {
        "x": 350.0,
        "y": 350.0
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Population",
      "to_element": "Births"
    },
    {
      "id": "conn-2",
      "from_element": "Population",
      "to_element": "Deaths"
    },
    {
      "id": "conn-3",
      "from_element": "birth_rate",
      "to_element": "Births"
    },
    {
      "id": "conn-4",
      "from_element": "death_rate",
      "to_element": "Deaths"
    },
    {
      "id": "conn-5",
      "from_element": "carrying_capacity",
      "to_element": "Births"
    }
  ],
  "time_settings": {
    "start": 0.0,
    "end": 200.0,
    "dt": 0.5
  },
  "created_at": "2024-01-01T00:00:00Z",
  "updated_at": "2026-01-08T23:29:21.024002",
  "source": "https://github.com/SDXorg/test-models",
  "reference": "SDXorg System Dynamics Model Repository"
}