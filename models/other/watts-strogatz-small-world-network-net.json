{
  "id": "watts-strogatz-small-world-network-net",
  "name": "Watts-Strogatz Small World Network",
  "description": "Model showing transition from regular lattice to small world network. Source: Watts & Strogatz (1998), Nature.",
  "stocks": [
    {
      "id": "s1",
      "name": "Path_Length",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Clustering",
      "initial_value": 0.75,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Path_Change",
      "equation": "-Path_Length * Rewiring_Prob * Path_Reduction",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Clustering_Change",
      "equation": "-Clustering * Rewiring_Prob * Cluster_Reduction",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "N",
      "equation": "1000",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "K",
      "equation": "10",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Rewiring_Prob",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Path_Reduction",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Cluster_Reduction",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Regular_Path",
      "equation": "N / (2 * K)",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Regular_Clustering",
      "equation": "3 * (K - 2) / (4 * (K - 1))",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Small_World_Index",
      "equation": "(Clustering / Regular_Clustering) / (Path_Length / Regular_Path)",
      "position": {
        "x": 300,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Rewiring_Prob",
      "to_element": "Path_Change"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-15T14:43:05.813230+00:00",
  "updated_at": "2026-01-15T14:43:05.813237+00:00",
  "source": "https://doi.org/10.1038/30918",
  "reference": "Watts, D.J. & Strogatz, S.H. (1998). Collective dynamics of 'small-world' networks. Nature 393:440-442."
}