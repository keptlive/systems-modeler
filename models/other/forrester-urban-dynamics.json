{
  "id": "forrester-urban-dynamics",
  "name": "Urban Dynamics Core Model",
  "description": "Jay Forrester's urban dynamics model showing the interaction between population, housing, and industry in urban areas. Demonstrates how well-intentioned policies can have counterintuitive effects.",
  "stocks": [
    {
      "id": "s1",
      "name": "Labor_Force",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Housing_Units",
      "initial_value": 40000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Business_Units",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Immigration",
      "equation": "Labor_Force * Immigration_Rate * Job_Attractiveness",
      "from_stock": null,
      "to_stock": "Labor_Force",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Emigration",
      "equation": "Labor_Force * Emigration_Rate / Housing_Availability",
      "from_stock": "Labor_Force",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Housing_Construction",
      "equation": "Housing_Units * Construction_Rate * Land_Availability",
      "from_stock": null,
      "to_stock": "Housing_Units",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Housing_Demolition",
      "equation": "Housing_Units * Demolition_Rate",
      "from_stock": "Housing_Units",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Business_Growth",
      "equation": "Business_Units * Growth_Rate * Labor_Availability",
      "from_stock": null,
      "to_stock": "Business_Units",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Business_Closure",
      "equation": "Business_Units * Closure_Rate",
      "from_stock": "Business_Units",
      "to_stock": null,
      "position": {
        "x": 750,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Immigration_Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Emigration_Rate",
      "equation": "0.03",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Construction_Rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Demolition_Rate",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Growth_Rate",
      "equation": "0.04",
      "position": {
        "x": 650,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Closure_Rate",
      "equation": "0.02",
      "position": {
        "x": 750,
        "y": 50
      }
    },
    {
      "id": "v7",
      "name": "Job_Attractiveness",
      "equation": "MIN(2, Business_Units * 20 / Labor_Force)",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Housing_Availability",
      "equation": "MAX(0.1, Housing_Units * 2.5 / Labor_Force)",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Land_Availability",
      "equation": "MAX(0, 1 - (Housing_Units + Business_Units * 10) / 100000)",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Labor_Availability",
      "equation": "MIN(2, Labor_Force / (Business_Units * 20))",
      "position": {
        "x": 650,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1287/mnsc.14.4.1",
  "reference": "Forrester, J.W. (1969). Urban Dynamics. MIT Press. DOI: 10.1287/mnsc.14.4.1",
