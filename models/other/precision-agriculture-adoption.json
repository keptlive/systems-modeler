{
  "id": "precision-agriculture-adoption",
  "name": "Precision Agriculture Technology Adoption Model",
  "description": "Model of smart farming technology diffusion and yield improvements.",
  "stocks": [
    {
      "id": "s1",
      "name": "Traditional_Farms",
      "initial_value": 1800000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Precision_Farms",
      "initial_value": 200000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Total_Yield",
      "initial_value": 400000000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Adoption",
      "equation": "Traditional_Farms * Adoption_Rate * (ROI_Perception + Social_Learning)",
      "from_stock": "Traditional_Farms",
      "to_stock": "Precision_Farms",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Reversion",
      "equation": "Precision_Farms * Reversion_Rate * (1 - Tech_Support)",
      "from_stock": "Precision_Farms",
      "to_stock": "Traditional_Farms",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Yield_Change",
      "equation": "(Traditional_Farms * Traditional_Yield + Precision_Farms * Precision_Yield) - Total_Yield * 0.1",
      "from_stock": null,
      "to_stock": "Total_Yield",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Adoption_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "ROI_Perception",
      "equation": "0.6",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Social_Learning",
      "equation": "Precision_Farms / (Traditional_Farms + Precision_Farms)",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Reversion_Rate",
      "equation": "0.02",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Tech_Support",
      "equation": "0.7",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Traditional_Yield",
      "equation": "150",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Precision_Yield",
      "equation": "200",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Precision_Share",
      "equation": "Precision_Farms / (Traditional_Farms + Precision_Farms)",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2050,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/s43016-020-00177-y",
  "reference": "Lowenberg-DeBoer, J. & Erickson, B. (2019). Setting the Record Straight on Precision Agriculture Adoption. Agronomy Journal. DOI: 10.1038/s43016-020-00177-y",
