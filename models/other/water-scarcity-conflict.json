{
  "id": "water-scarcity-conflict",
  "name": "Water Scarcity and Conflict Model",
  "description": "Model of water resource depletion leading to social conflict and migration.",
  "stocks": [
    {
      "id": "s1",
      "name": "Water_Reserve",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Population",
      "initial_value": 10000000,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Conflict_Level",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Recharge",
      "equation": "Rainfall_Rate * Catchment_Area",
      "from_stock": null,
      "to_stock": "Water_Reserve",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Consumption",
      "equation": "Population * Per_Capita_Use / 1000",
      "from_stock": "Water_Reserve",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Pop_Growth",
      "equation": "Population * Growth_Rate * Water_Availability",
      "from_stock": null,
      "to_stock": "Population",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Migration_Out",
      "equation": "Population * Migration_Rate * Conflict_Level",
      "from_stock": "Population",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Conflict_Increase",
      "equation": "Scarcity_Pressure * 0.1",
      "from_stock": null,
      "to_stock": "Conflict_Level",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "f6",
      "name": "Conflict_Resolution",
      "equation": "Conflict_Level * Resolution_Rate",
      "from_stock": "Conflict_Level",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Rainfall_Rate",
      "equation": "50",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Catchment_Area",
      "equation": "100",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Per_Capita_Use",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Growth_Rate",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Migration_Rate",
      "equation": "0.01",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Resolution_Rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 400
      }
    },
    {
      "id": "v7",
      "name": "Water_Availability",
      "equation": "Water_Reserve / (Population * Per_Capita_Use + 1)",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "v8",
      "name": "Scarcity_Pressure",
      "equation": "MAX(0, 1 - Water_Availability)",
      "position": {
        "x": 250,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2070,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/s41558-019-0669-5",
  "reference": "Serdeczny, O., et al. (2020). Water conflicts under climate change. Nature Climate Change. DOI: 10.1038/s41558-019-0669-5",
  "created_at": "2026-01-15T19:31:51.617641+00:00",
  "updated_at": "2026-01-15T19:31:51.617641+00:00"
}