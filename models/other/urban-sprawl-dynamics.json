{
  "id": "urban-sprawl-dynamics",
  "name": "Urban Sprawl Model",
  "description": "Model of urban expansion with land use change, transportation, and housing dynamics.",
  "stocks": [
    {
      "id": "s1",
      "name": "Urban_Area",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Suburban_Area",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Rural_Land",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Urban_Population",
      "initial_value": 2000000,
      "equation": "",
      "position": {
        "x": 325,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Urban_Densification",
      "equation": "Urban_Area * Densification_Rate * (1 - Urban_Density / Max_Density)",
      "from_stock": null,
      "to_stock": "Urban_Area",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Suburbanization",
      "equation": "Rural_Land * Sprawl_Rate * Population_Pressure",
      "from_stock": "Rural_Land",
      "to_stock": "Suburban_Area",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Population_Growth",
      "equation": "Urban_Population * Pop_Growth_Rate",
      "from_stock": null,
      "to_stock": "Urban_Population",
      "position": {
        "x": 225,
        "y": 350
      }
    },
    {
      "id": "f4",
      "name": "Population_Outmigration",
      "equation": "Urban_Population * Outmigration_Rate * Housing_Pressure",
      "from_stock": "Urban_Population",
      "to_stock": null,
      "position": {
        "x": 425,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Densification_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Max_Density",
      "equation": "10000",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Urban_Density",
      "equation": "Urban_Population / Urban_Area",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Sprawl_Rate",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Population_Pressure",
      "equation": "MAX(0, Urban_Density / 5000 - 1)",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Pop_Growth_Rate",
      "equation": "0.01",
      "position": {
        "x": 225,
        "y": 400
      }
    },
    {
      "id": "v7",
      "name": "Outmigration_Rate",
      "equation": "0.005",
      "position": {
        "x": 425,
        "y": 400
      }
    },
    {
      "id": "v8",
      "name": "Housing_Pressure",
      "equation": "Urban_Density / 3000",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Total_Urban_Land",
      "equation": "Urban_Area + Suburban_Area",
      "position": {
        "x": 325,
        "y": 450
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2070,
    "dt": 1
  },
  "source": "https://doi.org/10.1073/pnas.1211658109",
  "reference": "Seto, K.C., et al. (2012). Global forecasts of urban expansion to 2030. PNAS, 109(40), 16083-16088. DOI: 10.1073/pnas.1211658109",
