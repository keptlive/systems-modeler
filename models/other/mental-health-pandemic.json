{
  "id": "mental-health-pandemic",
  "name": "Pandemic Mental Health Impact Model",
  "description": "Model of mental health deterioration during pandemic with intervention effects.",
  "stocks": [
    {
      "id": "s1",
      "name": "Healthy",
      "initial_value": 200000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Mild_Symptoms",
      "initial_value": 40000000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Severe_Symptoms",
      "initial_value": 10000000,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Onset_Mild",
      "equation": "Healthy * Stress_Factor * Isolation_Impact * 0.01",
      "from_stock": "Healthy",
      "to_stock": "Mild_Symptoms",
      "position": {
        "x": 225,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Progression",
      "equation": "Mild_Symptoms * Progression_Rate * (1 - Treatment_Access)",
      "from_stock": "Mild_Symptoms",
      "to_stock": "Severe_Symptoms",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Recovery_Mild",
      "equation": "Mild_Symptoms * Recovery_Rate * (1 + Support_Level)",
      "from_stock": "Mild_Symptoms",
      "to_stock": "Healthy",
      "position": {
        "x": 225,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Recovery_Severe",
      "equation": "Severe_Symptoms * Recovery_Rate * Treatment_Access * 0.5",
      "from_stock": "Severe_Symptoms",
      "to_stock": "Mild_Symptoms",
      "position": {
        "x": 475,
        "y": 150
      }
    }
  ],
  "variables": [
