{
  "id": "wildfire-climate-feedback",
  "name": "Wildfire-Climate Feedback Model",
  "description": "Model of wildfire dynamics with climate feedback showing increasing fire risk with warming.",
  "stocks": [
    {
      "id": "s1",
      "name": "Forest_Biomass",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Dead_Fuel",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Burned_Area",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Forest_Growth",
      "equation": "Forest_Biomass * Growth_Rate * (1 - Forest_Biomass / Carrying_Capacity) * Moisture_Effect",
      "from_stock": null,
      "to_stock": "Forest_Biomass",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Natural_Mortality",
      "equation": "Forest_Biomass * Mortality_Rate",
      "from_stock": "Forest_Biomass",
      "to_stock": "Dead_Fuel",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Fire_Consumption",
      "equation": "(Forest_Biomass + Dead_Fuel) * Fire_Probability * Fire_Spread_Rate",
      "from_stock": "Forest_Biomass",
      "to_stock": "Burned_Area",
      "position": {
        "x": 325,
        "y": 275
      }
    },
    {
      "id": "f4",
      "name": "Fuel_Burn",
      "equation": "Dead_Fuel * Fire_Probability * 0.9",
      "from_stock": "Dead_Fuel",
      "to_stock": "Burned_Area",
      "position": {
        "x": 450,
        "y": 275
      }
    },
    {
      "id": "f5",
      "name": "Regeneration",
      "equation": "Burned_Area * Regeneration_Rate",
      "from_stock": "Burned_Area",
      "to_stock": "Forest_Biomass",
      "position": {
        "x": 325,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Growth_Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Carrying_Capacity",
      "equation": "1500",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Mortality_Rate",
      "equation": "0.02",
      "position": {
        "x": 325,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Temperature_Anomaly",
      "equation": "1.5 + 0.03 * time",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Moisture_Effect",
      "equation": "MAX(0.5, 1 - 0.1 * Temperature_Anomaly)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Fire_Probability",
      "equation": "0.01 * (1 + 0.5 * Temperature_Anomaly) * Dead_Fuel / 100",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Fire_Spread_Rate",
      "equation": "0.1 + 0.05 * Temperature_Anomaly",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Regeneration_Rate",
      "equation": "0.02",
      "position": {
        "x": 325,
        "y": 400
      }
    },
    {
      "id": "v9",
      "name": "Fire_Risk_Index",
      "equation": "Fire_Probability * Dead_Fuel * 100",
      "position": {
        "x": 500,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/s41558-019-0456-2",
  "reference": "Bowman, D.M.J.S., et al. (2020). Vegetation fires in the Anthropocene. Nature Reviews Earth & Environment, 1, 500-515. DOI: 10.1038/s41558-019-0456-2",
  "created_at": "2026-01-15T19:28:04.273639+00:00",
  "updated_at": "2026-01-15T19:28:04.273639+00:00"
}