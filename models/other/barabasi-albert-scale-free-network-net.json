{
  "id": "barabasi-albert-scale-free-network-net",
  "name": "Barab\u00e1si-Albert Scale-Free Network",
  "description": "Model of preferential attachment generating scale-free networks. Source: Barab\u00e1si & Albert (1999), Science.",
  "stocks": [
    {
      "id": "s1",
      "name": "Total_Nodes",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Total_Edges",
      "initial_value": 15,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Max_Degree",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Node_Addition",
      "equation": "Node_Add_Rate",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Edge_Addition",
      "equation": "m * Node_Add_Rate",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Max_Degree_Growth",
      "equation": "Growth_Exponent * Max_Degree / Total_Nodes",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Node_Add_Rate",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "m",
      "equation": "3",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Average_Degree",
      "equation": "2 * Total_Edges / Total_Nodes",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Growth_Exponent",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Clustering_Approx",
      "equation": "(m - 1) * LN(Total_Nodes)^2 / (8 * Total_Nodes)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Power_Law_Exponent",
      "equation": "3",
      "position": {
        "x": 300,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Total_Nodes",
      "to_element": "Clustering_Approx"
    }
  ],
