      "to_stock": "Immune",
      "position": {
        "x": 200,
        "y": 275
      }
    },
    {
      "id": "f4",
      "name": "Immunization",
      "equation": "Corrected * Immunization_Rate",
      "from_stock": "Corrected",
      "to_stock": "Immune",
      "position": {
        "x": 400,
        "y": 275
      }
    },
    {
      "id": "f5",
      "name": "Re_exposure",
      "equation": "Corrected * Re_exposure_Rate",
      "from_stock": "Corrected",
      "to_stock": "Misinformed",
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "variables": [
