      "position": {
        "x": 230,
        "y": 130
      }
    },
    {
      "id": "v8",
      "name": "Total_Productivity",
      "equation": "Good_Fit_Productivity*Sales_Agents_with_Good_Fit + Poor_Fit_Productivity*Sales_Agents_with_Poor_Fit",
      "position": {
        "x": 360,
        "y": 130
      }
    },
    {
      "id": "v9",
      "name": "Turnover_of_Good_Fit_Agents",
