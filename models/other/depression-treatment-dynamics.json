{
  "id": "depression-treatment-dynamics",
  "name": "Depression Treatment Dynamics Model",
  "description": "Model of depression onset, treatment seeking, and recovery with relapse dynamics.",
  "stocks": [
    {
      "id": "s1",
      "name": "Healthy",
      "initial_value": 90000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Untreated_Depression",
      "initial_value": 8000000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "In_Treatment",
      "initial_value": 5000000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Remission",
      "initial_value": 7000000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Onset",
      "equation": "Healthy * Incidence_Rate * Stress_Multiplier",
      "from_stock": "Healthy",
      "to_stock": "Untreated_Depression",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Seek_Treatment",
      "equation": "Untreated_Depression * Treatment_Seeking_Rate",
      "from_stock": "Untreated_Depression",
      "to_stock": "In_Treatment",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Spontaneous_Remission",
      "equation": "Untreated_Depression * Spontaneous_Rate",
      "from_stock": "Untreated_Depression",
      "to_stock": "Healthy",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Treatment_Success",
      "equation": "In_Treatment * Treatment_Efficacy",
      "from_stock": "In_Treatment",
      "to_stock": "Remission",
      "position": {
        "x": 500,
        "y": 275
      }
    },
    {
      "id": "f5",
      "name": "Relapse",
      "equation": "Remission * Relapse_Rate",
      "from_stock": "Remission",
      "to_stock": "Untreated_Depression",
      "position": {
        "x": 400,
        "y": 275
      }
    },
    {
      "id": "f6",
      "name": "Full_Recovery",
      "equation": "Remission * Recovery_Rate",
      "from_stock": "Remission",
      "to_stock": "Healthy",
      "position": {
        "x": 300,
        "y": 275
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Incidence_Rate",
      "equation": "0.03",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Stress_Multiplier",
      "equation": "1.0",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Treatment_Seeking_Rate",
      "equation": "0.15",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Treatment_Efficacy",
      "equation": "0.5",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Spontaneous_Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Relapse_Rate",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Recovery_Rate",
      "equation": "0.2",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Prevalence",
      "equation": "(Untreated_Depression + In_Treatment) / (Healthy + Untreated_Depression + In_Treatment + Remission)",
      "position": {
        "x": 300,
        "y": 450
      }
    },
    {
      "id": "v9",
      "name": "Treatment_Gap",
      "equation": "Untreated_Depression / (Untreated_Depression + In_Treatment)",
      "position": {
        "x": 500,
        "y": 450
      }
    }
  ],
