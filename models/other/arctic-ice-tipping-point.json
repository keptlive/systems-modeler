{
  "id": "arctic-ice-tipping-point",
  "name": "Arctic Sea Ice Tipping Point Model",
  "description": "Model of potential Arctic sea ice collapse due to ice-albedo feedback and climate warming.",
  "stocks": [
    {
      "id": "s1",
      "name": "Ice_Area",
      "initial_value": 6.5,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Ocean_Heat",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Ice_Loss",
      "equation": "Ice_Area * Melt_Rate * (1 + Albedo_Feedback * (1 - Ice_Area / Initial_Ice))",
      "from_stock": "Ice_Area",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Ice_Recovery",
      "equation": "MAX(0, (Initial_Ice - Ice_Area)) * Freeze_Rate * (1 - Ocean_Heat / Heat_Threshold)",
      "from_stock": null,
      "to_stock": "Ice_Area",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Heat_Absorption",
      "equation": "(1 - Ice_Area / Initial_Ice) * Solar_Input",
      "from_stock": null,
      "to_stock": "Ocean_Heat",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Heat_Loss",
      "equation": "Ocean_Heat * Heat_Loss_Rate",
      "from_stock": "Ocean_Heat",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Initial_Ice",
      "equation": "6.5",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Melt_Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Freeze_Rate",
      "equation": "0.03",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Albedo_Feedback",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Solar_Input",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Heat_Loss_Rate",
      "equation": "0.02",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v7",
      "name": "Heat_Threshold",
      "equation": "10",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Ice_Free_Risk",
      "equation": "1 / (1 + EXP(5 * (Ice_Area - 1)))",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/s41558-020-0860-7",
  "reference": "Notz, D. & SIMIP Community (2020). Arctic Sea Ice in CMIP6. Geophysical Research Letters, 47(10). DOI: 10.1038/s41558-020-0860-7",
  "created_at": "2026-01-15T19:23:00.599757+00:00",
  "updated_at": "2026-01-15T19:23:00.599757+00:00"
}