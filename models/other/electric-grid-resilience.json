      }
    },
    {
      "id": "s2",
      "name": "Renewable_Capacity",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Storage_Capacity",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "s4",
      "name": "Grid_Reliability",
      "initial_value": 99.9,
      "equation": "",
      "position": {
        "x": 150,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Fossil_Retirement",
      "equation": "Grid_Capacity * Retirement_Rate",
      "from_stock": "Grid_Capacity",
      "to_stock": null,
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Renewable_Addition",
      "equation": "Investment * Renewable_Cost_Decline",
      "from_stock": null,
      "to_stock": "Renewable_Capacity",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Storage_Addition",
      "equation": "Storage_Investment * Storage_Learning",
      "from_stock": null,
      "to_stock": "Storage_Capacity",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "f4",
      "name": "Reliability_Change",
      "equation": "(Base_Reliability - Grid_Reliability) * 0.1 - Weather_Impact * Vulnerability",
      "from_stock": null,
      "to_stock": "Grid_Reliability",
      "position": {
        "x": 50,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
