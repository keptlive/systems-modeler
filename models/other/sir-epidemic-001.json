{
  "id": "sir-epidemic-001",
  "name": "SIR Epidemic Model",
  "description": "Classic Susceptible-Infected-Recovered epidemic model",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 990,
      "equation": "",
      "position": { "x": 150, "y": 200 }
    },
    {
      "id": "stock-infected",
      "name": "Infected",
      "initial_value": 10,
      "equation": "",
      "position": { "x": 350, "y": 200 }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": { "x": 550, "y": 200 }
    }
  ],
  "flows": [
    {
      "id": "flow-infection",
      "name": "Infection",
      "equation": "contact_rate * Susceptible * Infected / total_population",
      "from_stock": "Susceptible",
      "to_stock": "Infected",
      "position": { "x": 250, "y": 200 }
    },
    {
      "id": "flow-recovery",
      "name": "Recovery",
      "equation": "Infected * recovery_rate",
      "from_stock": "Infected",
      "to_stock": "Recovered",
      "position": { "x": 450, "y": 200 }
    }
  ],
  "variables": [
    {
      "id": "var-contact-rate",
      "name": "contact_rate",
      "equation": "0.5",
      "position": { "x": 250, "y": 80 }
    },
    {
      "id": "var-recovery-rate",
      "name": "recovery_rate",
      "equation": "0.1",
      "position": { "x": 450, "y": 80 }
    },
    {
      "id": "var-total-population",
      "name": "total_population",
      "equation": "1000",
      "position": { "x": 350, "y": 350 }
    }
  ],
  "connectors": [
    { "id": "conn-1", "from_element": "Susceptible", "to_element": "Infection" },
    { "id": "conn-2", "from_element": "Infected", "to_element": "Infection" },
    { "id": "conn-3", "from_element": "Infected", "to_element": "Recovery" },
    { "id": "conn-4", "from_element": "contact_rate", "to_element": "Infection" },
    { "id": "conn-5", "from_element": "recovery_rate", "to_element": "Recovery" },
    { "id": "conn-6", "from_element": "total_population", "to_element": "Infection" }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2024-01-01T00:00:00Z",
  "updated_at": "2024-01-01T00:00:00Z"
}
