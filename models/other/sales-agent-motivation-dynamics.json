        "x": 490,
        "y": 130
      }
    },
    {
      "id": "v10",
      "name": "Income",
      "equation": "Months_of_Expenses_per_Sale * Sales + IF THEN ELSE(Time < Startup_Subsidy_Length, Startup_Subsidy\\ , 0 )",
      "position": {
        "x": 620,
        "y": 130
      }
    },
    {
      "id": "v11",
      "name": "Months_of_Expenses_per_Sale",
      "equation": "12/50",
      "position": {
        "x": 100,
        "y": 210
      }
    },
    {
      "id": "v12",
      "name": "Motivation_Adjustment",
      "equation": "(Income - Motivation) / Motivation_Adjustment_Time",
      "position": {
        "x": 230,
        "y": 210
      }
    },
    {
      "id": "v13",
      "name": "Motivation_Adjustment_Time",
      "equation": "3.0",
      "position": {
        "x": 360,
        "y": 210
      }
    },
    {
      "id": "v14",
      "name": "Sales",
      "equation": "Effort / Effort_Required_to_Make_a_Sale * Success_Rate",
      "position": {
        "x": 490,
        "y": 210
      }
    },
    {
      "id": "v15",
      "name": "Startup_Subsidy",
      "equation": "0.5",
      "position": {
        "x": 620,
        "y": 210
      }
