        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Sales_Effort_Available",
      "equation": "IF THEN ELSE(Still Employed > 0, Total_Effort_Available * Fraction_of_Effort_for_Sales\\ , 0 )",
      "position": {
        "x": 230,
        "y": 130
      }
    },
    {
      "id": "v8",
      "name": "Effort",
      "equation": "Sales_Effort_Available * Impact of Motivation on Effort(Motivation)",
      "position": {
        "x": 360,
        "y": 130
      }
    },
    {
      "id": "v9",
      "name": "Effort_Required_to_Make_a_Sale",
      "equation": "4.0",
