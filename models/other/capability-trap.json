      "equation": "0.0",
      "position": {
        "x": 360,
        "y": 210
      }
    },
    {
      "id": "v14",
      "name": "Time_Spend_on_Improvement",
      "equation": "Normal_Time_Spent_on_Improvement * Influence of Capability Pressure on Improvement Time\\ (Pressure_to_Improve_Capability) *Influence of Work Pressure on Improvement Time(Pressure_to_Do_Work\\ )",
      "position": {
        "x": 490,
        "y": 210
      }
    },
    {
      "id": "v15",
      "name": "Stretch",
      "equation": "Desired_Performance / Actual_Performance",
      "position": {
        "x": 620,
        "y": 210
      }
    },
    {
      "id": "v16",
      "name": "Time_Spent_Working",
      "equation": "MIN(Normal_Time_Spent_Working * Influence of Pressure on Work Time(Pressure_to_Do_Work\\ ), Maximum_Work_Time - Time_Spend_on_Improvement)",
      "position": {
        "x": 100,
        "y": 290
      }
    },
    {
      "id": "v17",
      "name": "Actual_Performance",
      "equation": "Capability * Time_Spent_Working",
      "position": {
        "x": 230,
        "y": 290
      }
    }
