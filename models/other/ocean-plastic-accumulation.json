{
  "id": "ocean-plastic-accumulation",
  "name": "Ocean Plastic Accumulation Model",
  "description": "Model of plastic pollution accumulation in ocean gyres with degradation dynamics.",
  "stocks": [
    {
      "id": "s1",
      "name": "Land_Plastic_Waste",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Ocean_Plastic",
      "initial_value": 150,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Microplastic",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Plastic_Production",
      "equation": "Annual_Production * (1 - Recycling_Rate)",
      "from_stock": null,
      "to_stock": "Land_Plastic_Waste",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Ocean_Leakage",
      "equation": "Land_Plastic_Waste * Leakage_Rate * Mismanagement_Factor",
      "from_stock": "Land_Plastic_Waste",
      "to_stock": "Ocean_Plastic",
      "position": {
        "x": 275,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Degradation",
      "equation": "Ocean_Plastic * Degradation_Rate",
      "from_stock": "Ocean_Plastic",
      "to_stock": "Microplastic",
      "position": {
        "x": 400,
        "y": 275
      }
    },
    {
      "id": "f4",
      "name": "Sedimentation",
      "equation": "Microplastic * Sedimentation_Rate",
      "from_stock": "Microplastic",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "f5",
      "name": "Cleanup",
      "equation": "Ocean_Plastic * Cleanup_Rate",
      "from_stock": "Ocean_Plastic",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Annual_Production",
      "equation": "400",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Recycling_Rate",
      "equation": "0.09",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Leakage_Rate",
      "equation": "0.03",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Mismanagement_Factor",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Degradation_Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Sedimentation_Rate",
      "equation": "0.005",
      "position": {
        "x": 550,
        "y": 400
      }
    },
    {
      "id": "v7",
      "name": "Cleanup_Rate",
      "equation": "0.001",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v8",
      "name": "Total_Ocean_Plastic",
      "equation": "Ocean_Plastic + Microplastic",
      "position": {
        "x": 400,
        "y": 450
      }
    },
    {
      "id": "v9",
      "name": "Plastic_Accumulation_Rate",
      "equation": "(Ocean_Leakage - Cleanup - Sedimentation) / Total_Ocean_Plastic",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "source": "https://doi.org/10.1126/science.aaq0524",
