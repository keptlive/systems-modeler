{
  "id": "sterman-beer-game-retailer",
  "name": "Beer Game - Retailer Tier",
  "description": "Retailer component of the MIT Beer Distribution Game. Demonstrates the bullwhip effect in supply chains.",
  "stocks": [
    {
      "id": "s1",
      "name": "Retailer_Inventory",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Retailer_Backlog",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Retailer_Shipments_Received",
      "equation": "Wholesaler_Shipments",
      "from_stock": null,
      "to_stock": "Retailer_Inventory",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Retailer_Sales",
      "equation": "MIN(Retailer_Inventory + Retailer_Shipments_Received, Customer_Demand + Retailer_Backlog)",
      "from_stock": "Retailer_Inventory",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Backlog_Increase",
      "equation": "MAX(0, Customer_Demand - Retailer_Sales)",
      "from_stock": null,
      "to_stock": "Retailer_Backlog",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "f4",
      "name": "Backlog_Decrease",
      "equation": "MIN(Retailer_Backlog, Retailer_Sales - Customer_Demand)",
      "from_stock": "Retailer_Backlog",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Customer_Demand",
      "equation": "100 + 50 * (time > 4)",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Wholesaler_Shipments",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Desired_Inventory",
      "equation": "400",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Inventory_Gap",
      "equation": "Desired_Inventory - Retailer_Inventory",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Retailer_Order",
      "equation": "MAX(0, Customer_Demand + Inventory_Gap / Adjustment_Time + Retailer_Backlog)",
      "position": {
        "x": 300,
        "y": 450
      }
    },
    {
      "id": "v6",
      "name": "Adjustment_Time",
      "equation": "4",
      "position": {
        "x": 450,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 52,
    "dt": 1
  },
  "source": "https://doi.org/10.1287/mnsc.35.3.321",
  "reference": "Sterman, J.D. (1989). Modeling Managerial Behavior: Misperceptions of Feedback in a Dynamic Decision Making Experiment. Management Science, 35(3), 321-339. DOI: 10.1287/mnsc.35.3.321",
