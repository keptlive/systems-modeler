{
  "id": "drift-diffusion-decision-cog",
  "name": "Drift-Diffusion Decision Model",
  "description": "The gold standard model for perceptual decision-making. Evidence accumulates stochastically until reaching a decision threshold. Explains both response times and accuracy. Source: Ratcliff (1978). Psychological Review. DOI: 10.1037/0033-295X.85.2.59",
  "stocks": [
    {"id": "stock-evidence", "name": "Accumulated_Evidence", "initial_value": 0, "equation": "", "position": {"x": 300, "y": 200}},
    {"id": "stock-time", "name": "Decision_Time", "initial_value": 0, "equation": "", "position": {"x": 300, "y": 350}}
  ],
  "flows": [
    {"id": "flow-drift", "name": "Evidence_Accumulation", "equation": "IF(ABS(Accumulated_Evidence) < Threshold, Drift_Rate + Noise, 0)", "from_stock": null, "to_stock": "stock-evidence", "position": {"x": 150, "y": 200}},
    {"id": "flow-time", "name": "Time_Increment", "equation": "IF(ABS(Accumulated_Evidence) < Threshold, 1, 0)", "from_stock": null, "to_stock": "stock-time", "position": {"x": 150, "y": 350}}
  ],
  "variables": [
    {"id": "var-drift", "name": "Drift_Rate", "equation": "0.3", "position": {"x": 150, "y": 100}},
    {"id": "var-threshold", "name": "Threshold", "equation": "1.0", "position": {"x": 400, "y": 100}},
    {"id": "var-noise", "name": "Noise", "equation": "0.1 * (2 * RANDOM() - 1)", "position": {"x": 250, "y": 100}},
    {"id": "var-decision", "name": "Decision", "equation": "IF(Accumulated_Evidence >= Threshold, 1, IF(Accumulated_Evidence <= -Threshold, -1, 0))", "position": {"x": 400, "y": 200}},
    {"id": "var-accuracy", "name": "Correct_Response", "equation": "IF(Drift_Rate > 0 AND Decision = 1, 1, IF(Drift_Rate < 0 AND Decision = -1, 1, 0))", "position": {"x": 400, "y": 350}},
    {"id": "var-starting-point", "name": "Starting_Point_Bias", "equation": "0", "position": {"x": 300, "y": 50}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 50, "dt": 0.01},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1037/0033-295X.85.2.59",
  "reference": "Ratcliff, R. (1978). A theory of memory retrieval. Psychological Review, 85(2), 59-108."
}
