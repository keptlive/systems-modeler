{
  "id": "traffic-congestion-dynamics",
  "name": "Traffic Congestion Dynamics Model",
  "description": "Model of urban traffic flow with induced demand and public transit competition.",
  "stocks": [
    {
      "id": "s1",
      "name": "Road_Capacity",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Vehicle_Volume",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Transit_Ridership",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Road_Construction",
      "equation": "Construction_Budget / Construction_Cost",
      "from_stock": null,
      "to_stock": "Road_Capacity",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Induced_Demand",
      "equation": "Latent_Demand * Road_Capacity / 100 * (1 - Congestion_Level)",
      "from_stock": null,
      "to_stock": "Vehicle_Volume",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Mode_Shift_to_Transit",
      "equation": "Vehicle_Volume * Mode_Shift_Rate * Congestion_Level * Transit_Quality",
      "from_stock": "Vehicle_Volume",
      "to_stock": "Transit_Ridership",
      "position": {
        "x": 400,
        "y": 275
      }
    },
    {
      "id": "f4",
      "name": "Mode_Shift_to_Car",
      "equation": "Transit_Ridership * Car_Preference * (1 - Congestion_Level)",
      "from_stock": "Transit_Ridership",
      "to_stock": "Vehicle_Volume",
      "position": {
        "x": 400,
        "y": 325
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Construction_Budget",
      "equation": "5",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Construction_Cost",
      "equation": "10",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Latent_Demand",
      "equation": "20",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Congestion_Level",
      "equation": "MIN(1, Vehicle_Volume / Road_Capacity)",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Mode_Shift_Rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 275
      }
    },
    {
      "id": "v6",
      "name": "Transit_Quality",
      "equation": "0.5",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Car_Preference",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Average_Speed",
      "equation": "60 * (1 - 0.8 * Congestion_Level)",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Total_Trips",
      "equation": "Vehicle_Volume + Transit_Ridership",
      "position": {
        "x": 400,
        "y": 450
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1257/aer.101.6.2616",
  "reference": "Duranton, G. & Turner, M.A. (2011). The Fundamental Law of Road Congestion. American Economic Review, 101(6), 2616-2652. DOI: 10.1257/aer.101.6.2616",
  "created_at": "2026-01-15T19:28:04.273639+00:00",
  "updated_at": "2026-01-15T19:28:04.273639+00:00"
}