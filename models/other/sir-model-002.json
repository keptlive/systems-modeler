{
  "id": "sir-model-002",
  "name": "SIR Model",
  "description": "A simple SIR (Susceptible, Infected, Recovered) epidemic model. Reference: WHO Disease Outbreak Information. Source: https://www.who.int/",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 990.0,
      "equation": "",
      "position": {
        "x": 200.0,
        "y": 200.0
      }
    },
    {
      "id": "s2",
      "name": "Infected",
      "initial_value": 10.0,
      "equation": "",
      "position": {
        "x": 400.0,
        "y": 200.0
      }
    },
    {
      "id": "s3",
      "name": "Recovered",
      "initial_value": 0.0,
      "equation": "",
      "position": {
        "x": 600.0,
        "y": 200.0
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Infection",
      "equation": "infection_rate * Susceptible * Infected",
      "from_stock": "Susceptible",
      "to_stock": "Infected",
      "position": {
        "x": 300.0,
        "y": 200.0
      }
    },
    {
      "id": "f2",
      "name": "Recovery",
      "equation": "recovery_rate * Infected",
      "from_stock": "Infected",
      "to_stock": "Recovered",
      "position": {
        "x": 500.0,
        "y": 200.0
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "infection_rate",
      "equation": "0.001",
      "position": {
        "x": 300.0,
        "y": 100.0
      }
    },
    {
      "id": "v2",
      "name": "recovery_rate",
      "equation": "0.1",
      "position": {
        "x": 500.0,
        "y": 100.0
      }
    }
  ],
  "connectors": [
