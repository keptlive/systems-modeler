      "from_element": "infection_rate",
      "to_element": "Infection"
    },
    {
      "id": "conn-2",
      "from_element": "Susceptible",
      "to_element": "Infection"
    },
    {
      "id": "conn-3",
      "from_element": "Infected",
      "to_element": "Infection"
    },
    {
      "id": "conn-4",
      "from_element": "recovery_rate",
      "to_element": "Recovery"
    },
    {
      "id": "conn-5",
      "from_element": "Infected",
      "to_element": "Recovery"
    }
  ],
