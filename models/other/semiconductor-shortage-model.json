{
  "id": "semiconductor-shortage-model",
  "name": "Semiconductor Supply Chain Model",
  "description": "Model of semiconductor supply chain dynamics showing capacity expansion delays and demand volatility.",
  "stocks": [
    {
      "id": "s1",
      "name": "Fab_Capacity",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Capacity_Under_Construction",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Chip_Inventory",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "s4",
      "name": "Backlog",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Capacity_Start",
      "equation": "MAX(0, Desired_Capacity - Fab_Capacity - Capacity_Under_Construction) / Capacity_Adjustment_Time",
      "from_stock": null,
      "to_stock": "Capacity_Under_Construction",
      "position": {
        "x": 275,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Capacity_Completion",
      "equation": "Capacity_Under_Construction / Construction_Time",
      "from_stock": "Capacity_Under_Construction",
      "to_stock": "Fab_Capacity",
      "position": {
        "x": 275,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Production",
      "equation": "MIN(Fab_Capacity * Utilization, Chip_Inventory + Fab_Capacity)",
      "from_stock": null,
      "to_stock": "Chip_Inventory",
      "position": {
        "x": 50,
        "y": 350
      }
    },
    {
      "id": "f4",
      "name": "Shipments",
      "equation": "MIN(Chip_Inventory, Demand + Backlog)",
      "from_stock": "Chip_Inventory",
      "to_stock": null,
      "position": {
        "x": 275,
        "y": 350
      }
    },
    {
      "id": "f5",
      "name": "Backlog_Increase",
      "equation": "MAX(0, Demand - Shipments)",
      "from_stock": null,
      "to_stock": "Backlog",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "f6",
      "name": "Backlog_Fulfillment",
      "equation": "MIN(Backlog, MAX(0, Shipments - Demand))",
      "from_stock": "Backlog",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Demand",
      "equation": "120",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Construction_Time",
      "equation": "24",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Capacity_Adjustment_Time",
      "equation": "12",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Desired_Capacity",
      "equation": "Demand * 1.2",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Utilization",
      "equation": "0.85",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Supply_Gap",
      "equation": "Demand - Production",
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "v7",
      "name": "Months_of_Supply",
      "equation": "Chip_Inventory / Demand",
      "position": {
        "x": 400,
        "y": 450
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 60,
    "dt": 1
  },
  "source": "https://doi.org/10.1016/j.ijpe.2021.108283",
  "reference": "Kleindorfer, P.R. & Saad, G.H. (2021). Managing Disruption Risks in Supply Chains. Int. J. Production Economics, 236. DOI: 10.1016/j.ijpe.2021.108283",
