{
  "id": "kermack-mckendrick-sir",
  "name": "Kermack-McKendrick SIR Model",
  "description": "The original 1927 SIR epidemic model by Kermack and McKendrick. Foundation of mathematical epidemiology and compartmental models.",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 999,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Infected",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Infection_Rate",
      "equation": "Beta * Susceptible * Infected / Total_Population",
      "from_stock": "Susceptible",
      "to_stock": "Infected",
      "position": {
        "x": 275,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Recovery_Rate",
      "equation": "Gamma * Infected",
      "from_stock": "Infected",
      "to_stock": "Recovered",
      "position": {
        "x": 525,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Beta",
      "equation": "0.4",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Gamma",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Total_Population",
      "equation": "Susceptible + Infected + Recovered",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "R0",
      "equation": "Beta / Gamma",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Herd_Immunity_Threshold",
      "equation": "1 - 1 / R0",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.1
  },
  "source": "https://doi.org/10.1098/rspa.1927.0118",
  "reference": "Kermack, W.O. & McKendrick, A.G. (1927). A contribution to the mathematical theory of epidemics. Proceedings of the Royal Society A, 115(772), 700-721. DOI: 10.1098/rspa.1927.0118",
