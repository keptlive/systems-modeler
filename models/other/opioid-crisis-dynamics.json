      "to_stock": "Addicted",
      "position": {
        "x": 400,
        "y": 275
      }
    },
    {
      "id": "f7",
      "name": "Overdose_Deaths",
      "equation": "Addicted * Overdose_Rate",
      "from_stock": "Addicted",
