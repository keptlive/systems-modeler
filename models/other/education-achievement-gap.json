{
  "id": "education-achievement-gap",
  "name": "Education Achievement Gap Model",
  "description": "Model of educational achievement disparities with resource allocation and intervention effects.",
  "stocks": [
    {
      "id": "s1",
      "name": "Low_Achievement",
      "initial_value": 3000000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Medium_Achievement",
      "initial_value": 10000000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "High_Achievement",
      "initial_value": 2000000,
      "equation": "",
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Low_to_Medium",
      "equation": "Low_Achievement * Improvement_Rate * (Resource_Level + Intervention_Effect)",
      "from_stock": "Low_Achievement",
      "to_stock": "Medium_Achievement",
      "position": {
        "x": 275,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Medium_to_High",
      "equation": "Medium_Achievement * Advancement_Rate * Quality_Teaching",
      "from_stock": "Medium_Achievement",
      "to_stock": "High_Achievement",
      "position": {
        "x": 525,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Regression_Low",
      "equation": "Medium_Achievement * Regression_Rate * (1 - Resource_Level)",
      "from_stock": "Medium_Achievement",
      "to_stock": "Low_Achievement",
      "position": {
        "x": 275,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "New_Students_Low",
      "equation": "Entry_Rate * Socioeconomic_Factor",
      "from_stock": null,
      "to_stock": "Low_Achievement",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "New_Students_Med",
      "equation": "Entry_Rate * (1 - Socioeconomic_Factor)",
      "from_stock": null,
      "to_stock": "Medium_Achievement",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Graduation",
      "equation": "(Low_Achievement + Medium_Achievement + High_Achievement) / School_Years",
      "from_stock": "High_Achievement",
      "to_stock": null,
      "position": {
        "x": 750,
        "y": 200
      }
    }
  ],
  "variables": [
