{
  "id": "antimicrobial-resistance-spread",
  "name": "Antimicrobial Resistance Global Spread Model",
  "description": "Model of AMR pathogen evolution and transmission.",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible_Bacteria",
      "initial_value": 1000000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Resistant_Bacteria",
      "initial_value": 100000000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Antibiotic_Effectiveness",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Resistance_Emergence",
      "equation": "Susceptible_Bacteria * Mutation_Rate * Selection_Pressure",
      "from_stock": "Susceptible_Bacteria",
      "to_stock": "Resistant_Bacteria",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Susceptible_Growth",
      "equation": "Susceptible_Bacteria * Growth_Rate * (1 - Total_Pop / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "Susceptible_Bacteria",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Resistant_Growth",
      "equation": "Resistant_Bacteria * Growth_Rate * Fitness_Cost * (1 - Total_Pop / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "Resistant_Bacteria",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Effectiveness_Decline",
      "equation": "Resistant_Fraction * Decline_Rate",
      "from_stock": "Antibiotic_Effectiveness",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Mutation_Rate",
      "equation": "0.0001",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Selection_Pressure",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Growth_Rate",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Carrying_Capacity",
      "equation": "10000000000",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Fitness_Cost",
      "equation": "0.95",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Decline_Rate",
      "equation": "0.5",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Total_Pop",
      "equation": "Susceptible_Bacteria + Resistant_Bacteria",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "v8",
      "name": "Resistant_Fraction",
      "equation": "Resistant_Bacteria / Total_Pop",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2050,
    "dt": 1
  },
  "source": "https://doi.org/10.1016/S0140-6736(21)02724-0",
  "reference": "Murray, C.J.L., et al. (2022). Global burden of bacterial antimicrobial resistance in 2019. Lancet, 399(10325), 629-655. DOI: 10.1016/S0140-6736(21)02724-0",
