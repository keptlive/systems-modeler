      "equation": "0.2",
      "position": {
        "x": 360,
        "y": 210
      }
    },
    {
      "id": "v14",
      "name": "Tier_1_Sales",
      "equation": "Success_Rate*MIN(Effort_Devoted_to_Tier_1_Leads / Effort_Required_to_Make_a_Sale, Tier_1_Leads\\ /Minimum_Time_to_Make_a_Sale)",
      "position": {
        "x": 490,
        "y": 210
      }
    },
    {
      "id": "v15",
      "name": "Tier_2_Sales",
      "equation": "Success_Rate*MIN(Effort_Devoted_to_Tier_2_Leads / Effort_Required_to_Make_a_Sale, Tier_2_Leads\\ /Minimum_Time_to_Make_a_Sale)",
      "position": {
        "x": 620,
        "y": 210
      }
    },
    {
      "id": "v16",
      "name": "Still_Employed",
      "equation": "IF THEN ELSE(Months_of_Buffer < 0 , 0 , 1 )",
      "position": {
        "x": 100,
        "y": 290
      }
    },
    {
      "id": "v17",
      "name": "Effort_Devoted_to_Tier_1_Clients",
      "equation": "Tier_1_Clients * Time_per_Client_Meeting * Frequency_of_Meetings",
      "position": {
        "x": 230,
        "y": 290
      }
    },
    {
      "id": "v18",
      "name": "Tier_1_Income",
