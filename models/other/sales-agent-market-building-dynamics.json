      "position": {
        "x": 360,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Effort_Remaining_after_Servicing_Existing_Clients",
      "equation": "MAX(Sales_Effort_Available - (Effort_Devoted_to_Tier_1_Clients + Effort_Devoted_to_Tier_2_Clients\\ ), 0)",
      "position": {
        "x": 490,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Down_Referral_Fraction",
      "equation": "0.2",
      "position": {
        "x": 620,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Effort_Devoted_to_Tier_2_Leads",
      "equation": "MIN(Effort_Remaining_after_Servicing_Existing_Clients, Effort_Required_to_Make_a_Sale\\ * Tier_2_Leads / Minimum_Time_to_Make_a_Sale )",
      "position": {
        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Tier_2_Lead_Aquisition",
      "equation": "Qualification_Rate * (Tier_2_Referrals + Tier_2_Referrals_from_Tier_1)",
      "position": {
        "x": 230,
        "y": 130
      }
    },
    {
      "id": "v8",
      "name": "Tier_1_Referrals_from_Tier_2",
      "equation": "Referrals_from_Tier_2_Clients * Down_Referral_Fraction",
      "position": {
        "x": 360,
        "y": 130
      }
    },
    {
      "id": "v9",
      "name": "Effort_Remaining_after_Servicing_Tier_2_Leads",
      "equation": "MAX(Effort_Remaining_after_Servicing_Existing_Clients - Effort_Devoted_to_Tier_2_Leads\\ , 0)",
      "position": {
        "x": 490,
        "y": 130
      }
    },
    {
      "id": "v10",
      "name": "Income",
      "equation": "Tier_1_Income + Tier_2_Income + IF THEN ELSE(Time < Startup_Subsidy_Length, Startup_Subsidy\\ , 0 )",
      "position": {
        "x": 620,
        "y": 130
      }
    },
    {
      "id": "v11",
