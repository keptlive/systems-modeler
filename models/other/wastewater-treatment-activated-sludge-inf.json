{
  "id": "wastewater-treatment-activated-sludge-inf",
  "name": "Activated Sludge Wastewater Treatment Model",
  "description": "Model of biological wastewater treatment process. Source: Henze et al. (2000), Activated Sludge Models ASM1.",
  "stocks": [
    {
      "id": "s1",
      "name": "BOD",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Biomass",
      "initial_value": 2000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Effluent_Quality",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "BOD_Removal",
      "equation": "-(mu_max * BOD / (Ks + BOD) * Biomass) / Y + Influent_BOD / HRT",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Biomass_Growth",
      "equation": "mu_max * BOD / (Ks + BOD) * Biomass - b * Biomass - Wasting_Rate",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Effluent_Change",
      "equation": "(BOD - Effluent_Quality) / HRT",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Influent_BOD",
      "equation": "250",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "mu_max",
      "equation": "6",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Ks",
      "equation": "60",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Y",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "b",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "HRT",
      "equation": "0.25",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "SRT",
      "equation": "10",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Wasting_Rate",
      "equation": "Biomass / SRT",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Removal_Efficiency",
      "equation": "(Influent_BOD - Effluent_Quality) / Influent_BOD * 100",
      "position": {
        "x": 450,
        "y": 420
      }
    },
    {
      "id": "v10",
      "name": "F_M_Ratio",
      "equation": "Influent_BOD / (Biomass * HRT)",
      "position": {
        "x": 300,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "BOD",
      "to_element": "BOD_Removal"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.1
  },
