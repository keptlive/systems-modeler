{
  "id": "tidal-flat-morphodynamics-coa",
  "name": "Tidal Flat Morphodynamics Model",
  "description": "Sediment transport and tidal flat evolution. Source: Mariotti & Fagherazzi (2010), JGR Earth Surface.",
  "stocks": [
    {
      "id": "s1",
      "name": "Flat_Elevation",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Sediment_Concentration",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Vegetation_Cover",
      "initial_value": 0.2,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Accretion",
      "equation": "Deposition - Erosion - Compaction",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "SSC_Change",
      "equation": "Resuspension - Settling + External_Input",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Vegetation_Change",
      "equation": "Veg_Growth - Veg_Mortality",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Tidal_Range",
      "equation": "2",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Inundation_Time",
      "equation": "MAX(0, MIN(1, (Tidal_Range / 2 - Flat_Elevation) / Tidal_Range))",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Deposition",
      "equation": "0.001 * Sediment_Concentration * Inundation_Time * (1 + 2 * Vegetation_Cover)",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Tau",
      "equation": "1 - Vegetation_Cover * 0.5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Erosion",
      "equation": "0.0001 * Tau * Inundation_Time",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v6",
      "name": "Compaction",
      "equation": "0.001 * Flat_Elevation",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "v7",
      "name": "Resuspension",
      "equation": "0.01 * Tau",
      "position": {
        "x": 200,
        "y": 480
      }
    },
    {
      "id": "v8",
      "name": "Settling",
      "equation": "0.02 * Sediment_Concentration",
      "position": {
        "x": 350,
        "y": 480
      }
    },
    {
      "id": "v9",
      "name": "External_Input",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 480
      }
    },
    {
      "id": "v10",
      "name": "Veg_Growth",
      "equation": "0.1 * (1 - Vegetation_Cover) * MAX(0, Flat_Elevation)",
      "position": {
        "x": 200,
        "y": 540
      }
    },
    {
      "id": "v11",
      "name": "Veg_Mortality",
      "equation": "0.05 * Vegetation_Cover * Inundation_Time",
      "position": {
        "x": 400,
        "y": 540
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Flat_Elevation",
      "to_element": "Inundation_Time"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-15T14:52:39.347028+00:00",
  "updated_at": "2026-01-15T14:52:39.347035+00:00",
  "source": "https://doi.org/10.1029/2009JF001566",
  "reference": "Mariotti, G. & Fagherazzi, S. (2010). A numerical model for the coupled long-term evolution of salt marshes and tidal flats. JGR Earth Surface 115:F01004."
}