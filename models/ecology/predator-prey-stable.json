{
  "id": "predator-prey-stable",
  "name": "Predator-Prey with Stable Equilibrium",
  "description": "Classic predator-prey model with prey carrying capacity. The logistic growth term ensures stable equilibrium rather than endless oscillations. Watch both populations settle to steady values.",
  "category": "ecology",
  "stocks": [
    {"id": "prey", "name": "Prey", "initial_value": 80, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "predator", "name": "Predator", "initial_value": 30, "equation": "", "position": {"x": 500, "y": 200}}
  ],
  "flows": [
    {"id": "prey-birth", "name": "Prey Growth", "equation": "r * Prey * (1 - Prey / K)", "from_stock": null, "to_stock": "prey", "position": {"x": 100, "y": 200}},
    {"id": "predation", "name": "Predation", "equation": "a * Prey * Predator", "from_stock": "prey", "to_stock": null, "position": {"x": 350, "y": 200}},
    {"id": "predator-birth", "name": "Predator Growth", "equation": "b * a * Prey * Predator", "from_stock": null, "to_stock": "predator", "position": {"x": 450, "y": 200}},
    {"id": "predator-death", "name": "Predator Death", "equation": "m * Predator", "from_stock": "predator", "to_stock": null, "position": {"x": 600, "y": 200}}
  ],
  "variables": [
    {"id": "v-r", "name": "r", "equation": "1.0", "position": {"x": 100, "y": 100}},
    {"id": "v-K", "name": "K", "equation": "100", "position": {"x": 200, "y": 100}},
    {"id": "v-a", "name": "a", "equation": "0.02", "position": {"x": 300, "y": 100}},
    {"id": "v-b", "name": "b", "equation": "0.5", "position": {"x": 400, "y": 100}},
    {"id": "v-m", "name": "m", "equation": "0.5", "position": {"x": 500, "y": 100}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 100, "dt": 0.1}
}
