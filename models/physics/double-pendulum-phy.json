    {
      "id": "flow-change-in-angular-velocity",
      "name": "Change in Angular Velocity",
      "equation": "(Acceleration_due_to_Gravity*(2*Mass_of_Pendulum+Mass_of_Pendulum_2)*SIN(Angular_Position) - Mass_of_Pendulum_2*Acceleration_due_to_Gravity*SIN(Angular_Position-2*Angular_Position_2) - 2*SIN(Angular_Position-Angular_Position_2)*Mass_of_Pendulum_2*(Angular_Velocity_2^2*Length_of_Pendulum_2 + Angular_Velocity^2*Length_of_Pendulum*COS(Angular_Position-Angular_Position_2))) / (Length_of_Pendulum*(2*Mass_of_Pendulum+Mass_of_Pendulum_2-Mass_of_Pendulum_2*COS(2*Angular_Position-2*Angular_Position_2)))",
      "from_stock": null,
      "to_stock": "stock-angular-velocity",
