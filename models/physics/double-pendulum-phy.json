        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-change-in-angular-position-2",
      "name": "Change in Angular Position 2",
      "equation": "Angular_Velocity_2",
      "from_stock": null,
      "to_stock": "stock-angular-position-2",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-change-in-angular-velocity-2",
      "name": "Change in Angular Velocity 2",
      "equation": "(2*SIN(Angular_Position-Angular_Position_2)*(Angular_Velocity^2*Length_of_Pendulum*(Mass_of_Pendulum+Mass_of_Pendulum_2) + Acceleration_due_to_Gravity*(Mass_of_Pendulum+Mass_of_Pendulum_2)*COS(Angular_Position) + Angular_Velocity_2^2*Length_of_Pendulum_2*Mass_of_Pendulum_2*COS(Angular_Position-Angular_Position_2))) / (Length_of_Pendulum_2*(2*Mass_of_Pendulum+Mass_of_Pendulum_2-Mass_of_Pendulum_2*COS(2*Angular_Position-2*Angular_Position_2)))",
      "from_stock": null,
      "to_stock": "stock-angular-velocity-2",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
