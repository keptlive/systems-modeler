{
  "id": "kolmogorov-turbulence-cascade-phy",
  "name": "Kolmogorov Turbulence Cascade Model",
  "description": "Kolmogorov's 1941 theory of turbulent energy cascade from large to small scales. Energy is injected at large scales and dissipated at the Kolmogorov microscale. The famous -5/3 power law emerges in the inertial subrange. Source: Kolmogorov, A.N. (1941). Dokl. Akad. Nauk SSSR. DOI: 10.1098/rspa.1991.0075",
  "stocks": [
    {
      "id": "stock-large-scale",
      "name": "Large_Scale_Energy",
      "initial_value": 100,
      "equation": "",
      "position": {"x": 100, "y": 200}
    },
    {
      "id": "stock-inertial",
      "name": "Inertial_Range_Energy",
      "initial_value": 50,
      "equation": "",
      "position": {"x": 300, "y": 200}
    },
    {
      "id": "stock-dissipation",
      "name": "Dissipation_Scale_Energy",
      "initial_value": 10,
      "equation": "",
      "position": {"x": 500, "y": 200}
    }
  ],
  "flows": [
    {
      "id": "flow-injection",
      "name": "Energy_Injection",
      "equation": "Forcing_Rate",
      "from_stock": null,
      "to_stock": "stock-large-scale",
      "position": {"x": 50, "y": 200}
    },
    {
      "id": "flow-cascade1",
      "name": "Large_To_Inertial_Transfer",
      "equation": "Cascade_Rate * Large_Scale_Energy",
      "from_stock": "stock-large-scale",
      "to_stock": "stock-inertial",
      "position": {"x": 200, "y": 200}
    },
    {
      "id": "flow-cascade2",
      "name": "Inertial_To_Dissipation_Transfer",
      "equation": "Cascade_Rate * Inertial_Range_Energy",
      "from_stock": "stock-inertial",
      "to_stock": "stock-dissipation",
      "position": {"x": 400, "y": 200}
    },
    {
      "id": "flow-dissipation",
      "name": "Viscous_Dissipation",
      "equation": "Dissipation_Rate * Dissipation_Scale_Energy",
      "from_stock": "stock-dissipation",
      "to_stock": null,
      "position": {"x": 550, "y": 200}
    }
  ],
  "variables": [
    {
      "id": "var-forcing",
      "name": "Forcing_Rate",
      "equation": "10",
      "position": {"x": 50, "y": 100}
    },
    {
      "id": "var-cascade",
      "name": "Cascade_Rate",
      "equation": "0.1",
      "position": {"x": 300, "y": 100}
    },
    {
      "id": "var-dissipation",
      "name": "Dissipation_Rate",
      "equation": "0.5",
      "position": {"x": 500, "y": 100}
    },
    {
      "id": "var-kolmogorov-scale",
      "name": "Kolmogorov_Scale",
      "equation": "(Kinematic_Viscosity^3 / Dissipation_Rate)^0.25",
      "position": {"x": 300, "y": 300}
    },
    {
      "id": "var-viscosity",
      "name": "Kinematic_Viscosity",
      "equation": "0.00001",
      "position": {"x": 400, "y": 300}
    }
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 100, "dt": 0.1},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1098/rspa.1991.0075",
  "reference": "Kolmogorov, A.N. (1941). The local structure of turbulence in incompressible viscous fluid for very large Reynolds numbers. Dokl. Akad. Nauk SSSR, 30, 301-305."
}
