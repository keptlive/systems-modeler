        "y": 160
      }
    },
    {
      "id": "var-initial-angle-1",
      "name": "Initial Angle 1",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 160
      }
    },
    {
      "id": "var-initial-angle-2",
      "name": "Initial Angle 2",
      "equation": "0",
      "position": {
        "x": 700,
        "y": 160
      }
    },
    {
      "id": "var-initial-velocity-1",
      "name": "Initial Velocity 1",
      "equation": "0",
      "position": {
        "x": 100,
        "y": 240
      }
    },
    {
      "id": "var-initial-velocity-2",
      "name": "Initial Velocity 2",
      "equation": "0",
      "position": {
        "x": 250,
        "y": 240
      }
    },
    {
      "id": "var-natural-frequency-1",
      "name": "Natural Frequency 1",
      "equation": "SQRT(\"Gravitational Acceleration\" / \"Length of Pendulum 1\")",
      "position": {
        "x": 400,
        "y": 240
      }
    },
    {
      "id": "var-natural-frequency-2",
      "name": "Natural Frequency 2",
      "equation": "SQRT(\"Gravitational Acceleration\" / \"Length of Pendulum 2\")",
      "position": {
        "x": 550,
        "y": 240
      }
    },
    {
      "id": "var-coupling-frequency",
      "name": "Coupling Frequency",
      "equation": "SQRT(\"Coupling Spring Constant\" * \"Coupling Distance from Pivot\"^2 / (\"Mass of Pendulum 1\" * \"Length of Pendulum 1\"^2))",
      "position": {
        "x": 700,
        "y": 240
      }
    },
    {
      "id": "var-normal-mode-1-frequency-in-phase",
      "name": "Normal Mode 1 Frequency (In-Phase)",
      "equation": "Natural_Frequency_1",
      "position": {
        "x": 100,
        "y": 320
      }
    },
    {
      "id": "var-normal-mode-2-frequency-out-of-phase",
      "name": "Normal Mode 2 Frequency (Out-of-Phase)",
      "equation": "SQRT(Natural_Frequency_1^2 + 2 * Coupling_Frequency^2)",
      "position": {
        "x": 250,
        "y": 320
      }
    },
    {
      "id": "var-beat-frequency",
      "name": "Beat Frequency",
      "equation": "ABS(\"Normal Mode 2 Frequency (Out-of-Phase)\" - \"Normal Mode 1 Frequency (In-Phase)\")",
      "position": {
        "x": 400,
        "y": 320
      }
    },
    {
      "id": "var-beat-period",
      "name": "Beat Period",
      "equation": "2 * 3.14159 / Beat_Frequency",
      "position": {
        "x": 550,
        "y": 320
      }
    },
    {
      "id": "var-angular-acceleration-1",
      "name": "Angular Acceleration 1",
      "equation": "-\"Gravitational Acceleration\" / \"Length of Pendulum 1\" * SIN(\"Angular Position 1\") - Damping_Coefficient / (\"Mass of Pendulum 1\" * \"Length of Pendulum 1\") * \"Angular Velocity 1\" - Coupling_Term_1",
      "position": {
        "x": 700,
        "y": 320
      }
    },
    {
      "id": "var-angular-acceleration-2",
      "name": "Angular Acceleration 2",
      "equation": "-\"Gravitational Acceleration\" / \"Length of Pendulum 2\" * SIN(\"Angular Position 2\") - Damping_Coefficient / (\"Mass of Pendulum 2\" * \"Length of Pendulum 2\") * \"Angular Velocity 2\" - Coupling_Term_2",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-coupling-term-1",
      "name": "Coupling Term 1",
      "equation": "\"Coupling Spring Constant\" * \"Coupling Distance from Pivot\"^2 / (\"Mass of Pendulum 1\" * \"Length of Pendulum 1\"^2) * (\"Angular Position 1\" - \"Angular Position 2\")",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "var-coupling-term-2",
      "name": "Coupling Term 2",
      "equation": "\"Coupling Spring Constant\" * \"Coupling Distance from Pivot\"^2 / (\"Mass of Pendulum 2\" * \"Length of Pendulum 2\"^2) * (\"Angular Position 2\" - \"Angular Position 1\")",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "var-coupling-power-transfer",
      "name": "Coupling Power Transfer",
      "equation": "\"Coupling Spring Constant\" * \"Coupling Distance from Pivot\" * (\"Angular Position 1\" - \"Angular Position 2\") * (\"Angular Velocity 1\" * \"Coupling Distance from Pivot\")",
      "position": {
        "x": 550,
        "y": 400
      }
    },
    {
      "id": "var-kinetic-energy-1",
      "name": "Kinetic Energy 1",
      "equation": "0.5 * \"Mass of Pendulum 1\" * (\"Length of Pendulum 1\" * \"Angular Velocity 1\")^2",
      "position": {
        "x": 700,
        "y": 400
      }
    },
    {
      "id": "var-potential-energy-1",
      "name": "Potential Energy 1",
      "equation": "\"Mass of Pendulum 1\" * \"Gravitational Acceleration\" * \"Length of Pendulum 1\" * (1 - COS(\"Angular Position 1\"))",
      "position": {
        "x": 100,
        "y": 480
      }
    },
    {
      "id": "var-kinetic-energy-2",
      "name": "Kinetic Energy 2",
      "equation": "0.5 * \"Mass of Pendulum 2\" * (\"Length of Pendulum 2\" * \"Angular Velocity 2\")^2",
      "position": {
        "x": 250,
        "y": 480
      }
    },
    {
      "id": "var-potential-energy-2",
      "name": "Potential Energy 2",
      "equation": "\"Mass of Pendulum 2\" * \"Gravitational Acceleration\" * \"Length of Pendulum 2\" * (1 - COS(\"Angular Position 2\"))",
      "position": {
        "x": 400,
        "y": 480
      }
    },
    {
      "id": "var-spring-potential-energy",
      "name": "Spring Potential Energy",
      "equation": "0.5 * \"Coupling Spring Constant\" * (\"Coupling Distance from Pivot\" * (\"Angular Position 1\" - \"Angular Position 2\"))^2",
      "position": {
        "x": 550,
        "y": 480
      }
    },
    {
      "id": "var-total-system-energy",
      "name": "Total System Energy",
      "equation": "Kinetic_Energy_1 + Potential_Energy_1 + Kinetic_Energy_2 + Potential_Energy_2 + Spring_Potential_Energy",
      "position": {
        "x": 700,
        "y": 480
      }
    },
    {
      "id": "var-initial-energy-1",
      "name": "Initial Energy 1",
      "equation": "\"Mass of Pendulum 1\" * \"Gravitational Acceleration\" * \"Length of Pendulum 1\" * (1 - COS(Initial_Angle_1))",
      "position": {
        "x": 100,
        "y": 560
      }
    },
    {
      "id": "var-initial-energy-2",
      "name": "Initial Energy 2",
      "equation": "\"Mass of Pendulum 2\" * \"Gravitational Acceleration\" * \"Length of Pendulum 2\" * (1 - COS(Initial_Angle_2))",
      "position": {
        "x": 250,
        "y": 560
      }
    },
    {
      "id": "var-horizontal-position-1",
      "name": "Horizontal Position 1",
      "equation": "\"Length of Pendulum 1\" * SIN(\"Angular Position 1\")",
      "position": {
        "x": 400,
        "y": 560
      }
    },
    {
      "id": "var-vertical-position-1",
      "name": "Vertical Position 1",
      "equation": "-\"Length of Pendulum 1\" * COS(\"Angular Position 1\")",
      "position": {
        "x": 550,
        "y": 560
      }
    },
    {
      "id": "var-horizontal-position-2",
      "name": "Horizontal Position 2",
      "equation": "\"Length of Pendulum 2\" * SIN(\"Angular Position 2\")",
      "position": {
        "x": 700,
        "y": 560
      }
    },
    {
      "id": "var-vertical-position-2",
      "name": "Vertical Position 2",
      "equation": "-\"Length of Pendulum 2\" * COS(\"Angular Position 2\")",
      "position": {
        "x": 100,
        "y": 640
      }
    },
    {
      "id": "var-phase-difference",
      "name": "Phase Difference",
      "equation": "\"Angular Position 1\" - \"Angular Position 2\"",
      "position": {
        "x": 250,
        "y": 640
      }
    },
    {
      "id": "var-in-phase-mode-amplitude",
      "name": "In-Phase Mode Amplitude",
      "equation": "(\"Angular Position 1\" + \"Angular Position 2\") / 2",
      "position": {
        "x": 400,
        "y": 640
      }
    },
    {
      "id": "var-out-of-phase-mode-amplitude",
      "name": "Out-of-Phase Mode Amplitude",
      "equation": "(\"Angular Position 1\" - \"Angular Position 2\") / 2",
      "position": {
        "x": 550,
        "y": 640
      }
    },
    {
      "id": "var-coupling-strength-ratio",
      "name": "Coupling Strength Ratio",
      "equation": "Coupling_Frequency / Natural_Frequency_1",
      "position": {
        "x": 700,
        "y": 640
      }
    }
  ],
