        "x": 400,
        "y": 240
      }
    },
    {
      "id": "var-natural-frequency-2",
      "name": "Natural Frequency 2",
      "equation": "SQRT(Gravity / Length_2)",
      "position": {
        "x": 550,
        "y": 240
      }
    },
    {
      "id": "var-coupling-frequency",
      "name": "Coupling Frequency",
      "equation": "SQRT(Spring_Constant * Coupling_Distance^2 / (Mass_1 * Length_1^2))",
      "position": {
        "x": 700,
        "y": 240
      }
    },
    {
      "id": "var-normal-mode-1-frequency-in-phase",
      "name": "Normal Mode 1 Frequency (In-Phase)",
      "equation": "Natural_Frequency_1",
      "position": {
        "x": 100,
        "y": 320
      }
    },
    {
      "id": "var-normal-mode-2-frequency-out-of-phase",
      "name": "Normal Mode 2 Frequency (Out-of-Phase)",
      "equation": "SQRT(Natural_Frequency_1^2 + 2 * Coupling_Frequency^2)",
      "position": {
        "x": 250,
        "y": 320
      }
    },
    {
      "id": "var-beat-frequency",
      "name": "Beat Frequency",
      "equation": "ABS(Normal_Mode_2_Frequency - Normal_Mode_1_Frequency)",
      "position": {
        "x": 400,
        "y": 320
      }
    },
    {
      "id": "var-beat-period",
      "name": "Beat Period",
      "equation": "2 * 3.14159 / Beat_Frequency",
      "position": {
        "x": 550,
        "y": 320
      }
    },
    {
      "id": "var-angular-acceleration-1",
      "name": "Angular Acceleration 1",
      "equation": "-Gravity / Length_1 * SIN(Theta1) - Damping_Coefficient / (Mass_1 * Length_1) * Omega1 - Coupling_Term_1",
      "position": {
        "x": 700,
        "y": 320
      }
    },
    {
      "id": "var-angular-acceleration-2",
      "name": "Angular Acceleration 2",
      "equation": "-Gravity / Length_2 * SIN(Theta2) - Damping_Coefficient / (Mass_2 * Length_2) * Omega2 - Coupling_Term_2",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-coupling-term-1",
      "name": "Coupling Term 1",
      "equation": "Spring_Constant * Coupling_Distance^2 / (Mass_1 * Length_1^2) * (Theta1 - Theta2)",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "var-coupling-term-2",
      "name": "Coupling Term 2",
      "equation": "Spring_Constant * Coupling_Distance^2 / (Mass_2 * Length_2^2) * (Theta2 - Theta1)",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "var-coupling-power-transfer",
      "name": "Coupling Power Transfer",
      "equation": "Spring_Constant * Coupling_Distance * (Theta1 - Theta2) * (Omega1 * Coupling_Distance)",
      "position": {
        "x": 550,
        "y": 400
      }
    },
    {
      "id": "var-kinetic-energy-1",
      "name": "Kinetic Energy 1",
      "equation": "0.5 * Mass_1 * (Length_1 * Omega1)^2",
      "position": {
        "x": 700,
        "y": 400
      }
    },
    {
      "id": "var-potential-energy-1",
      "name": "Potential Energy 1",
      "equation": "Mass_1 * Gravity * Length_1 * (1 - COS(Theta1))",
      "position": {
        "x": 100,
        "y": 480
      }
    },
    {
      "id": "var-kinetic-energy-2",
      "name": "Kinetic Energy 2",
      "equation": "0.5 * Mass_2 * (Length_2 * Omega2)^2",
      "position": {
        "x": 250,
        "y": 480
      }
    },
    {
      "id": "var-potential-energy-2",
      "name": "Potential Energy 2",
      "equation": "Mass_2 * Gravity * Length_2 * (1 - COS(Theta2))",
      "position": {
        "x": 400,
        "y": 480
      }
    },
    {
      "id": "var-spring-potential-energy",
      "name": "Spring Potential Energy",
      "equation": "0.5 * Spring_Constant * (Coupling_Distance * (Theta1 - Theta2))^2",
      "position": {
        "x": 550,
        "y": 480
      }
    },
    {
      "id": "var-total-system-energy",
      "name": "Total System Energy",
      "equation": "Kinetic_Energy_1 + Potential_Energy_1 + Kinetic_Energy_2 + Potential_Energy_2 + Spring_Potential_Energy",
      "position": {
        "x": 700,
        "y": 480
      }
    },
    {
      "id": "var-initial-energy-1",
      "name": "Initial Energy 1",
      "equation": "Mass_1 * Gravity * Length_1 * (1 - COS(Initial_Angle_1))",
      "position": {
        "x": 100,
        "y": 560
      }
    },
    {
      "id": "var-initial-energy-2",
      "name": "Initial Energy 2",
