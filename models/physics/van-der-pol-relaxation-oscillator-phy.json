{
  "id": "van-der-pol-relaxation-oscillator-phy",
  "name": "Van der Pol Relaxation Oscillator",
  "description": "Balthasar van der Pol's (1920s) nonlinear oscillator model showing self-sustained oscillations with amplitude-dependent damping. Exhibits limit cycles and is foundational for understanding biological rhythms and electronic oscillators.",
  "stocks": [
    {"id": "stock-position", "name": "Position", "initial_value": 0.1, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-velocity", "name": "Velocity", "initial_value": 0, "equation": "", "position": {"x": 450, "y": 200}}
  ],
  "flows": [
    {"id": "flow-velocity-change", "name": "Velocity Change", "equation": "Mu * (1 - Position ^ 2) * Velocity - Position", "from_stock": null, "to_stock": "stock-velocity", "position": {"x": 350, "y": 200}},
    {"id": "flow-position-change", "name": "Position Change", "equation": "Velocity", "from_stock": null, "to_stock": "stock-position", "position": {"x": 100, "y": 200}}
  ],
  "variables": [
    {"id": "var-mu", "name": "Mu", "equation": "3", "position": {"x": 300, "y": 100}},
    {"id": "var-energy", "name": "Energy", "equation": "0.5 * Velocity ^ 2 + 0.5 * Position ^ 2", "position": {"x": 350, "y": 300}},
    {"id": "var-period", "name": "Period", "equation": "(3 - 2 * LN(2)) * Mu + 2 * 3.14159", "position": {"x": 550, "y": 300}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 50, "dt": 0.01},
  "source": "https://doi.org/10.1080/14786442608564127",
  "reference": "van der Pol B. On relaxation-oscillations. The London, Edinburgh, and Dublin Philosophical Magazine. 1926;2(11):978-992."
}
