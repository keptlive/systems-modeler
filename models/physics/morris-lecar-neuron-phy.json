{
  "id": "morris-lecar-neuron-phy",
  "name": "Morris-Lecar Neuron Model",
  "description": "The Morris-Lecar model (1981) of neural excitability in barnacle giant muscle fibers. A two-dimensional reduction showing how ionic currents generate action potentials. Shows type I and type II neural firing patterns. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-voltage",
      "name": "Membrane Voltage V",
      "initial_value": -60,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-w",
      "name": "Recovery Variable W",
      "initial_value": 0.01,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-dv",
      "name": "dV/dt",
      "equation": "(I_ext - g_Ca * M_inf * (Membrane_Voltage_V - V_Ca) - g_K * Recovery_Variable_W * (Membrane_Voltage_V - V_K) - g_L * (Membrane_Voltage_V - V_L)) / C",
      "from_stock": null,
      "to_stock": "stock-voltage",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-dw",
      "name": "dW/dt",
      "equation": "Phi * (W_inf - Recovery_Variable_W) / Tau_W",
      "from_stock": null,
      "to_stock": "stock-w",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-c",
      "name": "C",
      "equation": "20",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-g-ca",
      "name": "g_Ca",
      "equation": "4",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-g-k",
      "name": "g_K",
      "equation": "8",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-g-l",
      "name": "g_L",
      "equation": "2",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-v-ca",
      "name": "V_Ca",
      "equation": "120",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-v-k",
      "name": "V_K",
      "equation": "-84",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "var-v-l",
      "name": "V_L",
      "equation": "-60",
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "id": "var-i-ext",
      "name": "I_ext",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-phi",
      "name": "Phi",
      "equation": "0.04",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "var-v1",
      "name": "V1",
      "equation": "-1.2",
      "position": {
        "x": 150,
        "y": 400
      }
    },
    {
      "id": "var-v2",
      "name": "V2",
      "equation": "18",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "var-v3",
      "name": "V3",
      "equation": "2",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "var-v4",
      "name": "V4",
      "equation": "30",
      "position": {
        "x": 450,
        "y": 400
      }
    },
    {
      "id": "var-m-inf",
      "name": "M_inf",
      "equation": "0.5 * (1 + TANH((Membrane_Voltage_V - V1) / V2))",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-w-inf",
      "name": "W_inf",
      "equation": "0.5 * (1 + TANH((Membrane_Voltage_V - V3) / V4))",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-tau-w",
      "name": "Tau_W",
      "equation": "1 / (COSH((Membrane_Voltage_V - V3) / (2 * V4)))",
      "position": {
        "x": 600,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Membrane Voltage V",
      "to_element": "M_inf"
    },
    {
      "id": "conn-2",
      "from_element": "Membrane Voltage V",
      "to_element": "W_inf"
    },
    {
      "id": "conn-3",
      "from_element": "Recovery Variable W",
      "to_element": "dV/dt"
    },
    {
      "id": "conn-4",
      "from_element": "W_inf",
      "to_element": "dW/dt"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.1
  },
  "created_at": "2026-01-12T01:30:00.000Z",
