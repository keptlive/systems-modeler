{
  "id": "spring-mass-damper-forced-phy",
  "name": "Forced Spring-Mass-Damper",
  "description": "Forced spring-mass-damper system showing mechanical vibration dynamics with external forcing. Demonstrates resonance and damped oscillation. Source: Standard mechanical vibration analysis.",
  "stocks": [
    {
      "id": "stock-position",
      "name": "Position",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-velocity",
      "name": "Velocity",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-velocity",
      "name": "Position_Change",
      "equation": "Velocity",
      "from_stock": null,
      "to_stock": "stock-position",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-acceleration",
      "name": "Velocity_Change",
      "equation": "(Forcing - Damping_Force - Spring_Force) / Mass",
      "from_stock": null,
      "to_stock": "stock-velocity",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-mass",
      "name": "Mass",
      "equation": "1.0",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-spring-constant",
      "name": "Spring_Constant",
      "equation": "10",
      "position": {
        "x": 150,
        "y": 80
      }
    },
    {
      "id": "var-damping-coefficient",
      "name": "Damping_Coefficient",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-spring-force",
      "name": "Spring_Force",
      "equation": "Spring_Constant * Position",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "var-damping-force",
      "name": "Damping_Force",
      "equation": "Damping_Coefficient * Velocity",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-forcing-amplitude",
      "name": "Forcing_Amplitude",
      "equation": "5",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "var-forcing-frequency",
      "name": "Forcing_Frequency",
      "equation": "1.0",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-forcing",
      "name": "Forcing",
      "equation": "Forcing_Amplitude * SIN(Forcing_Frequency * TIME)",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "var-natural-frequency",
      "name": "Natural_Frequency",
      "equation": "SQRT(Spring_Constant / Mass)",
      "position": {
        "x": 300,
        "y": 280
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Velocity",
      "to_element": "Position_Change"
    },
    {
      "id": "conn-2",
      "from_element": "Position",
      "to_element": "Spring_Force"
    },
    {
      "id": "conn-3",
      "from_element": "Velocity",
      "to_element": "Damping_Force"
    },
    {
      "id": "conn-4",
      "from_element": "Forcing",
      "to_element": "Velocity_Change"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.05
  },
