      "id": "conn-1",
      "from_element": "Membrane Voltage",
      "to_element": "Voltage Change"
    },
    {
      "id": "conn-2",
      "from_element": "Recovery Variable",
      "to_element": "Voltage Change"
    },
    {
      "id": "conn-3",
      "from_element": "Membrane Voltage",
      "to_element": "Recovery Change"
    },
    {
      "id": "conn-4",
      "from_element": "Recovery Variable",
      "to_element": "Recovery Change"
    }
  ],
