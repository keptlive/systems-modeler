{
  "id": "ising-mean-field-phase-transition-phy",
  "name": "Ising Model Mean-Field Phase Transition",
  "description": "Mean-field approximation of Ising model for ferromagnetism phase transitions. Nobel Prize 1982 (Wilson). Source: Landau & Lifshitz (1980).",
  "stocks": [
    {
      "id": "s1",
      "name": "Magnetization",
      "initial_value": 0.8,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Energy",
      "initial_value": -1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Magnetization_Relax",
      "equation": "-relaxation_rate * (Magnetization - Equilibrium_M)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Energy_Relax",
      "equation": "-relaxation_rate * (Energy - Equilibrium_E)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Temperature",
      "equation": "2.0",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Critical_Temp",
      "equation": "2.27",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "J_coupling",
      "equation": "1.0",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "relaxation_rate",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Equilibrium_M",
      "equation": "IF(Temperature < Critical_Temp, ((Critical_Temp - Temperature)/Critical_Temp)^0.125, 0)",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Equilibrium_E",
      "equation": "-J_coupling * Magnetization * Magnetization",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Temperature",
      "to_element": "Equilibrium_M"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.1
  },
  "created_at": "2026-01-15T14:36:21.172844+00:00",
  "updated_at": "2026-01-15T14:36:21.172847+00:00",
  "source": "https://doi.org/10.1103/PhysRevLett.28.548",
  "reference": "Wilson, K.G. (1972). Renormalization Group and Critical Phenomena. Nobel Prize 1982."
}