      }
    },
    {
      "id": "var-k-reverse",
      "name": "k_reverse",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-equilibrium-constant",
      "name": "Equilibrium_Constant",
      "equation": "k_forward / k_reverse",
