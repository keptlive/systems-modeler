{
  "id": "electric-grid-frequency-phy",
  "name": "Electric Grid Frequency Stability",
  "description": "Model of power grid frequency stability under supply-demand imbalances. Captures generator inertia, primary frequency response, and load balancing. Based on power systems engineering. Reference: EIA Electric Power Annual. Source: https://www.eia.gov/electricity/annual/",
  "stocks": [
    {
      "id": "s1",
      "name": "Grid_Frequency",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Generator_Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Kinetic_Energy",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Frequency_Change",
      "equation": "(Generator_Output - Load) / System_Inertia",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Governor_Response",
      "equation": "(Frequency_Setpoint - Grid_Frequency) * Droop_Coefficient",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 350,
        "y": 280
      }
    },
    {
      "id": "f3",
      "name": "Energy_Exchange",
      "equation": "(Kinetic_Energy - Nominal_Energy) / Energy_Time_Constant",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 280
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Load",
