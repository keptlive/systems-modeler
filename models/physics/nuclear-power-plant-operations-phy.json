{
  "id": "nuclear-power-plant-operations-phy",
  "name": "Nuclear Power Plant Operations Model",
  "description": "A system dynamics model of nuclear reactor operations based on the point kinetics equations and Stacey (2018) 'Nuclear Reactor Physics' (Wiley, doi:10.1002/9783527812318). Models neutron population dynamics, reactivity feedback, thermal hydraulics, and power control. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "stock-neutron-population",
      "name": "Neutron Population",
      "initial_value": 1000000000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-delayed-precursors",
      "name": "Delayed Neutron Precursors",
      "initial_value": 50000000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-fuel-temperature",
      "name": "Fuel Temperature",
      "initial_value": 600,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "stock-coolant-temperature",
      "name": "Coolant Temperature",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "stock-control-rod-position",
      "name": "Control Rod Position",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 300,
        "y": 420
      }
    },
    {
      "id": "stock-xenon-concentration",
      "name": "Xenon Concentration",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 420
      }
    },
    {
      "id": "stock-power-output",
      "name": "Thermal Power Output",
      "initial_value": 3000,
      "equation": "",
      "position": {
        "x": 600,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-prompt-neutrons",
      "name": "Prompt Neutron Generation",
      "equation": "Neutron_Population * (Net_Reactivity - Beta) / Prompt_Lifetime",
      "from_stock": null,
      "to_stock": "stock-neutron-population",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-delayed-neutrons",
      "name": "Delayed Neutron Release",
      "equation": "Delayed_Neutron_Precursors * Decay_Constant",
      "from_stock": "stock-delayed-precursors",
      "to_stock": "stock-neutron-population",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-precursor-production",
      "name": "Precursor Production",
      "equation": "Neutron_Population * Beta / Prompt_Lifetime",
      "from_stock": null,
      "to_stock": "stock-delayed-precursors",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-precursor-decay",
      "name": "Precursor Decay",
      "equation": "Delayed_Neutron_Precursors * Decay_Constant",
      "from_stock": null,
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "flow-fuel-heating",
      "name": "Fuel Heating",
      "equation": "Fission_Power / Fuel_Heat_Capacity",
      "from_stock": null,
      "to_stock": "stock-fuel-temperature",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "flow-fuel-to-coolant",
      "name": "Heat Transfer to Coolant",
      "equation": "(Fuel_Temperature - Coolant_Temperature) * Heat_Transfer_Coefficient",
      "from_stock": "stock-fuel-temperature",
      "to_stock": "stock-coolant-temperature",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "flow-coolant-cooling",
      "name": "Coolant Heat Removal",
      "equation": "(Coolant_Temperature - Inlet_Temperature) * Coolant_Flow_Rate",
      "from_stock": "stock-coolant-temperature",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "flow-rod-insertion",
      "name": "Rod Insertion",
      "equation": "IF(Power_Error > 0, Rod_Speed, 0)",
      "from_stock": null,
      "to_stock": "stock-control-rod-position",
      "position": {
        "x": 250,
        "y": 420
      }
    },
    {
      "id": "flow-rod-withdrawal",
      "name": "Rod Withdrawal",
      "equation": "IF(Power_Error < 0, Rod_Speed, 0)",
      "from_stock": "stock-control-rod-position",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 420
      }
    },
    {
      "id": "flow-xenon-production",
      "name": "Xenon Production",
      "equation": "Fission_Rate * Xenon_Yield + Iodine_Decay",
      "from_stock": null,
      "to_stock": "stock-xenon-concentration",
      "position": {
        "x": 450,
        "y": 420
      }
    },
    {
      "id": "flow-xenon-burnup",
      "name": "Xenon Burnup",
      "equation": "Xenon_Concentration * Neutron_Flux * Xenon_Cross_Section + Xenon_Concentration * Xenon_Decay_Rate",
      "from_stock": "stock-xenon-concentration",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 420
      }
    },
    {
      "id": "flow-power-generation",
      "name": "Power Generation",
      "equation": "(Fission_Power - Thermal_Power_Output) / Power_Time_Constant",
      "from_stock": null,
      "to_stock": "stock-power-output",
      "position": {
        "x": 550,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-net-reactivity",
      "name": "Net Reactivity",
      "equation": "Control_Reactivity + Temperature_Feedback + Xenon_Reactivity",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-control-reactivity",
      "name": "Control Reactivity",
      "equation": "(0.5 - Control_Rod_Position) * Rod_Worth",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-rod-worth",
      "name": "Rod Worth",
      "equation": "0.05",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-temperature-feedback",
      "name": "Temperature Feedback",
      "equation": "(Fuel_Temperature - Reference_Temperature) * Doppler_Coefficient",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-doppler-coefficient",
      "name": "Doppler Coefficient",
      "equation": "-0.000005",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-reference-temperature",
      "name": "Reference Temperature",
      "equation": "600",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "var-xenon-reactivity",
      "name": "Xenon Reactivity",
      "equation": "-Xenon_Concentration * Xenon_Reactivity_Coefficient",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-xenon-reactivity-coefficient",
      "name": "Xenon Reactivity Coefficient",
      "equation": "0.00000001",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.0065",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "var-prompt-lifetime",
      "name": "Prompt Lifetime",
      "equation": "0.0001",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "var-decay-constant",
      "name": "Decay Constant",
      "equation": "0.08",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "var-fission-power",
      "name": "Fission Power",
      "equation": "Neutron_Population * Energy_per_Fission / 1000000000",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "var-energy-per-fission",
      "name": "Energy per Fission",
      "equation": "3.2e-11",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "var-fuel-heat-capacity",
      "name": "Fuel Heat Capacity",
      "equation": "1000",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-heat-transfer-coefficient",
      "name": "Heat Transfer Coefficient",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-inlet-temperature",
      "name": "Inlet Temperature",
      "equation": "280",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-coolant-flow-rate",
      "name": "Coolant Flow Rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-power-setpoint",
      "name": "Power Setpoint",
      "equation": "3000",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-power-error",
      "name": "Power Error",
      "equation": "Thermal_Power_Output - Power_Setpoint",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-rod-speed",
      "name": "Rod Speed",
      "equation": "0.001",
      "position": {
        "x": 300,
        "y": 470
      }
    },
    {
      "id": "var-fission-rate",
      "name": "Fission Rate",
      "equation": "Neutron_Population / 1000000",
      "position": {
        "x": 400,
        "y": 470
      }
    },
    {
      "id": "var-xenon-yield",
      "name": "Xenon Yield",
      "equation": "0.003",
      "position": {
        "x": 450,
        "y": 470
      }
    },
    {
      "id": "var-iodine-decay",
      "name": "Iodine Decay",
      "equation": "Fission_Rate * 0.06",
      "position": {
        "x": 500,
        "y": 470
      }
    },
    {
      "id": "var-neutron-flux",
      "name": "Neutron Flux",
      "equation": "Neutron_Population / 1000000000",
      "position": {
        "x": 550,
        "y": 470
      }
    },
    {
      "id": "var-xenon-cross-section",
      "name": "Xenon Cross Section",
      "equation": "0.000001",
      "position": {
        "x": 600,
        "y": 470
      }
    },
    {
      "id": "var-xenon-decay-rate",
      "name": "Xenon Decay Rate",
      "equation": "0.0000209",
      "position": {
        "x": 600,
        "y": 420
      }
    },
    {
      "id": "var-power-time-constant",
      "name": "Power Time Constant",
      "equation": "5",
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
