      "equation": "8000",
      "units": "kg/s"
    },
    {
      "id": "var-source-coolant-capacity",
      "position": {
        "x": 650,
        "y": 350
      },
      "name": "Coolant_Heat_Capacity",
      "equation": "Coolant_Mass * Coolant_Specific_Heat",
      "units": "J/K"
    },
    {
      "id": "var-source-fuel-mass",
      "position": {
        "x": 650,
        "y": 350
      },
      "name": "Fuel_Mass",
      "equation": "40000",
      "units": "kg"
    },
    {
      "id": "var-source-coolant-mass",
      "position": {
        "x": 650,
        "y": 350
      },
      "name": "Coolant_Mass",
      "equation": "7000",
      "units": "kg"
    },
    {
      "id": "var-source-fuel-cp",
      "position": {
        "x": 650,
        "y": 350
      },
      "name": "Fuel_Specific_Heat",
      "equation": "200",
      "units": "J/(kg*K)"
    },
    {
      "id": "var-source-coolant-cp",
      "position": {
        "x": 650,
        "y": 350
      },
