    },
    {
      "id": "conn-5",
      "from_element": "Control Rod Position",
      "to_element": "Control Reactivity"
    },
    {
      "id": "conn-6",
      "from_element": "Fuel Temperature",
      "to_element": "Temperature Feedback"
    },
    {
