{
  "id": "nuclear-power-plant-operations-phy",
  "name": "Reactor Point Kinetics and Thermal Feedback \u2014 KTH Example 3-2",
  "description": "Source reconstruction of KTH Nuclear Reactor Dynamics and Stability, chapter3 pp.74-79, Table3-2 and executable Scilab PDModel Example3-2. Four physical states are one-group neutron/precursor densities and fuel/coolant temperatures. All physical coefficients and equilibrium initial conditions are taken from the example. The time origin is shifted to the source reactivity insertion at t=1s: time0 here is immediately after the +0.0022 step; the omitted preceding1s is exact equilibrium. This autonomous post-step response is extended to the saved1000s horizon. Radau resolves prompt kinetics; dt0.2s is reporting spacing, replacing the generated0.01 output grid. Energy is measured in joules and watts, with distinct fuel/coolant heat capacities; the same heat transfer leaves fuel and enters coolant. Thermal_Power_Output is derived MW, not a lagged stock. Unrelated generated control-rod and xenon sectors are archived in the repair receipt rather than presented as part of this source model. This is an educational lumped reactor model, not plant-operation or safety guidance.",
  "stocks": [
    {
      "id": "stock-neutron-population",
      "position": {
        "x": 200,
        "y": 150
      },
      "name": "Neutron_Density",
      "initial_value": 200,
      "equation": "",
      "units": "1/m^3"
    },
    {
      "id": "stock-delayed-precursors",
      "position": {
        "x": 400,
        "y": 150
      },
      "name": "Delayed_Neutron_Precursors",
      "initial_value": 15000,
      "equation": "Beta * Neutron_Density / (Prompt_Lifetime * Decay_Constant)",
      "units": "1/m^3"
    },
    {
      "id": "stock-fuel-temperature",
      "position": {
        "x": 200,
        "y": 300
      },
      "name": "Fuel_Temperature",
      "initial_value": 921.875,
      "equation": "Equilibrium_Fuel_Temperature",
      "units": "K"
    },
    {
      "id": "stock-coolant-temperature",
      "position": {
        "x": 400,
        "y": 300
      },
      "name": "Coolant_Temperature",
      "initial_value": 571.875,
      "equation": "Equilibrium_Coolant_Temperature",
      "units": "K"
    }
  ],
  "flows": [
    {
      "id": "flow-prompt-neutrons",
      "position": {
        "x": 100,
        "y": 150
      },
      "name": "Prompt_Neutron_Generation",
      "equation": "Neutron_Density * (Net_Reactivity - Beta) / Prompt_Lifetime",
      "units": "1/(m^3*s)",
      "from_stock": null,
      "to_stock": "stock-neutron-population"
    },
    {
      "id": "flow-delayed-neutrons",
      "position": {
        "x": 300,
        "y": 150
      },
      "name": "Delayed_Neutron_Release",
      "equation": "Delayed_Neutron_Precursors * Decay_Constant",
      "units": "1/(m^3*s)",
      "from_stock": "stock-delayed-precursors",
      "to_stock": "stock-neutron-population"
    },
    {
      "id": "flow-precursor-production",
      "position": {
        "x": 400,
        "y": 100
      },
      "name": "Precursor_Production",
      "equation": "Neutron_Density * Beta / Prompt_Lifetime",
      "units": "1/(m^3*s)",
      "from_stock": null,
      "to_stock": "stock-delayed-precursors"
    },
    {
      "id": "flow-fuel-heating",
      "position": {
        "x": 150,
        "y": 300
      },
      "name": "Fuel_Heating",
      "equation": "Fission_Power / Fuel_Heat_Capacity",
      "units": "K/s",
      "from_stock": null,
      "to_stock": "stock-fuel-temperature"
    },
    {
      "id": "flow-fuel-to-coolant",
      "position": {
        "x": 300,
        "y": 300
      },
      "name": "Fuel_Heat_Transfer",
      "equation": "Heat_Transfer_Rate / Fuel_Heat_Capacity",
      "units": "K/s",
      "from_stock": "stock-fuel-temperature",
      "to_stock": null
    },
    {
      "id": "flow-coolant-source-heating",
      "position": {
        "x": 650,
        "y": 350
      },
      "name": "Coolant_Heat_Transfer",
      "equation": "Heat_Transfer_Rate / Coolant_Heat_Capacity",
      "units": "K/s",
      "from_stock": null,
      "to_stock": "stock-coolant-temperature"
    },
    {
      "id": "flow-coolant-cooling",
      "position": {
        "x": 450,
        "y": 300
      },
      "name": "Coolant_Heat_Removal",
      "equation": "2 * Coolant_Flow_Rate * Coolant_Specific_Heat * (Coolant_Temperature - Inlet_Temperature) / Coolant_Heat_Capacity",
      "units": "K/s",
      "from_stock": "stock-coolant-temperature",
      "to_stock": null
    }
  ],
  "variables": [
    {
      "id": "var-net-reactivity",
      "position": {
        "x": 100,
        "y": 80
      },
      "name": "Net_Reactivity",
