{
  "id": "belousov-zhabotinsky-oscillator-phy",
  "name": "Belousov-Zhabotinsky Chemical Oscillator",
  "description": "Illustrative three-intermediate chemical kinetics variant inspired by the Oregonator. Field and Noyes (1974) is the original source, but the local effective coefficients, concentrations and time units have not been mapped to its reaction scheme. Stiffness and numerical stability at the supplied defaults remain unresolved; oscillatory behavior is not validated.",
  "stocks": [
    {
      "id": "s1",
      "name": "X_Bromous_Acid",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Y_Bromide_Ion",
      "initial_value": 2,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Z_Cerium_IV",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "X_Net_Change",
      "equation": "k1 * Y_Bromide_Ion - k2 * X_Bromous_Acid * Y_Bromide_Ion + k3 * X_Bromous_Acid - k4 * X_Bromous_Acid * X_Bromous_Acid",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Y_Net_Change",
      "equation": "-k1 * Y_Bromide_Ion - k2 * X_Bromous_Acid * Y_Bromide_Ion + k5 * Z_Cerium_IV",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Z_Net_Change",
      "equation": "k3 * X_Bromous_Acid - k5 * Z_Cerium_IV",
