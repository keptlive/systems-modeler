{
  "id": "brusselator-chemical-oscillator-phy",
  "name": "Brusselator Chemical Oscillator Model",
  "description": "Model of autocatalytic chemical reactions showing oscillatory behavior. Prigogine Nobel Prize-winning work on dissipative structures. Reference: Strogatz, S. H. (2015). Nonlinear Dynamics and Chaos. Westview Press. Source: https://doi.org/10.1201/9780429492563",
  "stocks": [
    {
      "id": "s1",
      "name": "Species X",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Species Y",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "dX dt",
      "equation": "A + Species_X^2 * Species_Y - (B + 1) * Species_X",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "dY dt",
      "equation": "B * Species_X - Species_X^2 * Species_Y",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 100,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "A",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "B",
      "equation": "3",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "v3",
      "name": "Steady State X",
      "equation": "A",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v4",
      "name": "Steady State Y",
      "equation": "B / A",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Oscillation Condition",
      "equation": "B - 1 - A^2",
      "position": {
        "x": 350,
        "y": 400
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Species X",
      "to_element": "dX dt"
    },
    {
      "id": "c2",
      "from_element": "Species Y",
      "to_element": "dY dt"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.01
  },
