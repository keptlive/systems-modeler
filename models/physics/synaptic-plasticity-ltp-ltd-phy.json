{
  "id": "synaptic-plasticity-ltp-ltd-phy",
  "name": "Synaptic Plasticity LTP/LTD Model",
  "description": "Models long-term potentiation and depression in synapses, fundamental to learning and memory. Based on Bienenstock-Cooper-Munro (BCM) theory. DOI: 10.1523/JNEUROSCI.0317-12.2012",
  "stocks": [
    {
      "id": "stock-synaptic",
      "name": "Synaptic_Weight",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-calcium",
      "name": "Calcium_Level",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-threshold",
      "name": "Modification_Threshold",
      "initial_value": 0.3,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-potent",
      "name": "Potentiation",
      "equation": "LTP_Rate * MAX(0, Calcium_Level - Modification_Threshold) * (1 - Synaptic_Weight)",
      "from_stock": null,
      "to_stock": "stock-synaptic",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-depress",
      "name": "Depression",
      "equation": "LTD_Rate * MAX(0, Modification_Threshold - Calcium_Level) * Synaptic_Weight",
      "from_stock": "stock-synaptic",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-cainflux",
      "name": "Calcium_Influx",
      "equation": "Presynaptic_Activity * NMDA_Conductance",
      "from_stock": null,
      "to_stock": "stock-calcium",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-cadecay",
      "name": "Calcium_Decay",
      "equation": "Calcium_Level / Calcium_Time_Constant",
      "from_stock": "stock-calcium",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-threshchg",
      "name": "Threshold_Adjustment",
      "equation": "(Average_Activity - Modification_Threshold) * Metaplasticity_Rate",
      "from_stock": null,
      "to_stock": "stock-threshold",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-ltprate",
      "name": "LTP_Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-ltdrate",
      "name": "LTD_Rate",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-preact",
      "name": "Presynaptic_Activity",
      "equation": "0.3 + 0.2 * SIN(TIME / 5)",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-nmda",
      "name": "NMDA_Conductance",
      "equation": "Synaptic_Weight * 0.5",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "var-catau",
      "name": "Calcium_Time_Constant",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "var-avgact",
      "name": "Average_Activity",
      "equation": "Calcium_Level * 0.5",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-metaplast",
      "name": "Metaplasticity_Rate",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 150
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Calcium_Level",
      "to_element": "Potentiation"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.1
  },
  "created_at": "2026-01-12T02:49:51.599597+00:00",
  "updated_at": "2026-01-12T02:49:51.599692+00:00",
  "source": "https://doi.org/10.1523/JNEUROSCI.0317-12.2012",
  "reference": "Cooper LN, Bear MF (2012). The BCM theory of synapse modification at 30. Nature Reviews Neuroscience."
}