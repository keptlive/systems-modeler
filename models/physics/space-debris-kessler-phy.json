{
  "id": "space-debris-kessler-phy",
  "name": "Space Debris Kessler Syndrome",
  "description": "Model of orbital debris accumulation and cascade collision risk. Captures satellite launches, collisions, and the potential for runaway debris growth (Kessler syndrome). Based on orbital mechanics and space situational awareness research. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Active_Satellites",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Debris_Objects",
      "initial_value": 30000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Collision_Risk_Index",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Launches",
      "equation": "Annual_Launch_Rate",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "End_of_Life",
      "equation": "Active_Satellites / Satellite_Lifetime",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Collisions",
      "equation": "Active_Satellites * Debris_Objects * Collision_Probability",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 270
      }
    },
    {
      "id": "f4",
      "name": "Debris_from_Collisions",
      "equation": "Collisions * Fragments_Per_Collision",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 350,
        "y": 280
      }
    },
    {
      "id": "f5",
      "name": "Debris_Decay",
      "equation": "Debris_Objects * Atmospheric_Decay_Rate",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Risk_Update",
      "equation": "(Debris_Objects / 30000 - Collision_Risk_Index) / Risk_Adjustment",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 280
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Annual_Launch_Rate",
      "equation": "2000",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "v2",
      "name": "Satellite_Lifetime",
      "equation": "7",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "v3",
      "name": "Collision_Probability",
      "equation": "0.000001",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "v4",
      "name": "Fragments_Per_Collision",
      "equation": "1000",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "v5",
      "name": "Atmospheric_Decay_Rate",
      "equation": "0.005",
      "position": {
        "x": 150,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "Risk_Adjustment",
      "equation": "2",
      "position": {
        "x": 350,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Kessler_Threshold",
      "equation": "IF Debris_Objects > 100000 THEN 1 ELSE 0",
      "position": {
        "x": 550,
        "y": 130
      }
    },
    {
      "id": "v8",
      "name": "Debris_Density",
      "equation": "Debris_Objects / 1000",
      "position": {
        "x": 300,
        "y": 180
      }
    }
  ],
  "connectors": [],
