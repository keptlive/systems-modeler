{
  "id": "arrhenius-reaction-rate-phy",
  "name": "Arrhenius Reaction Kinetics",
  "description": "Temperature dependence of chemical reaction rates. Rate increases exponentially with temperature. Foundation of chemical kinetics and explains why refrigeration preserves food. Reference: NASA GISS Surface Temperature Analysis. Source: https://data.giss.nasa.gov/gistemp/",
  "stocks": [
    {
      "id": "stock-reactant",
      "name": "Reactant Concentration",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-product",
      "name": "Product Concentration",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-reaction",
      "name": "Reaction Rate",
      "equation": "Rate_Constant * Reactant_Concentration",
      "from_stock": "stock-reactant",
      "to_stock": "stock-product",
      "position": {
        "x": 250,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-rate-const",
      "name": "Rate Constant",
      "equation": "Pre_Exponential * EXP(-Activation_Energy / (Gas_Constant * Temperature))",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-pre-exp",
      "name": "Pre Exponential",
      "equation": "1e10",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-activation",
      "name": "Activation Energy",
      "equation": "50000",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-gas",
      "name": "Gas Constant",
      "equation": "8.314",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-temp",
      "name": "Temperature",
      "equation": "300",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-halflife",
      "name": "Halflife",
      "equation": "0.693 / Rate_Constant",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-q10",
      "name": "Q10",
      "equation": "EXP(Activation_Energy * 10 / (Gas_Constant * Temperature^2))",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Reactant Concentration",
      "to_element": "Reaction Rate"
    },
    {
      "id": "conn-2",
      "from_element": "Rate Constant",
      "to_element": "Reaction Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.1
  },
  "created_at": "2026-01-12T07:39:15.418023+00:00",
  "updated_at": "2026-01-12T07:39:15.418030+00:00",
  "source": "https://doi.org/10.1002/bbpc.18890501202",
  "reference": "Arrhenius S. \u00dcber die Reaktionsgeschwindigkeit bei der Inversion von Rohrzucker durch S\u00e4uren. Zeitschrift f\u00fcr Physikalische Chemie. 1889;4(1):226-248."
}