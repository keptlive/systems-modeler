        "y": 100
      }
    },
    {
      "id": "stock-protein1",
      "name": "Protein1",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "stock-mrna2",
