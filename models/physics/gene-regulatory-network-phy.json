      "to_stock": "stock-protein2",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "flow-protdegrade2",
      "name": "Protein_Degradation2",
      "equation": "Protein2 / Protein_Half_Life",
      "from_stock": "stock-protein2",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-basaltranscr",
      "name": "Basal_Transcription",
      "equation": "0.1",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-acttranscr1",
      "name": "Activated_Transcription1",
      "equation": "Max_Transcription * Protein2^Hill_Coefficient / (K_Activation^Hill_Coefficient + Protein2^Hill_Coefficient)",
      "position": {
        "x": 100,
        "y": 175
      }
    },
    {
      "id": "var-reprtr2",
      "name": "Repressed_Transcription2",
