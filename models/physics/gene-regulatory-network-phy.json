      "to_stock": "stock-mrna2",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "flow-mrnadegrade2",
      "name": "mRNA_Degradation2",
      "equation": "mRNA_Gene2 / mRNA_Half_Life",
      "from_stock": "stock-mrna2",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "flow-transl2",
      "name": "Translation2",
      "equation": "mRNA_Gene2 * Translation_Rate",
