      "equation": "",
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-transcr1",
      "name": "Transcription1",
      "equation": "Basal_Transcription + Activated_Transcription1",
      "from_stock": null,
      "to_stock": "stock-mrna1",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-mrnadegrade1",
      "name": "mRNA_Degradation1",
      "equation": "mRNA_Gene1 / mRNA_Half_Life",
      "from_stock": "stock-mrna1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "flow-transl1",
      "name": "Translation1",
      "equation": "mRNA_Gene1 * Translation_Rate",
      "from_stock": null,
      "to_stock": "stock-protein1",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-protdegrade1",
      "name": "Protein_Degradation1",
      "equation": "Protein1 / Protein_Half_Life",
      "from_stock": "stock-protein1",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "flow-transcr2",
      "name": "Transcription2",
      "equation": "Basal_Transcription + Repressed_Transcription2",
