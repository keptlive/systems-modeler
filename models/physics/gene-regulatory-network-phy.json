      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 175
      }
    },
    {
      "id": "var-krepr",
      "name": "K_Repression",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 225
      }
    },
    {
      "id": "var-transrate",
      "name": "Translation_Rate",
      "equation": "1",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
