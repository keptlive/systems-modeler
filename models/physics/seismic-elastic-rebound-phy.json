{
  "id": "seismic-elastic-rebound-phy",
  "name": "Seismic Elastic Rebound Model",
  "description": "Simple model of earthquake occurrence based on Reid's elastic rebound theory (1910). Stress accumulates along fault until threshold, then releases in an earthquake. Shows earthquake cycles and recurrence. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-stress",
      "name": "Accumulated Stress",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-displacement",
      "name": "Fault Displacement",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-stress-accumulation",
      "name": "Stress Accumulation",
      "equation": "Tectonic_Loading_Rate",
      "from_stock": null,
      "to_stock": "stock-stress",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-stress-release",
      "name": "Stress Release",
      "equation": "IF Accumulated_Stress > Failure_Threshold THEN Accumulated_Stress * Release_Fraction ELSE 0",
      "from_stock": "stock-stress",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-slip",
      "name": "Fault Slip",
      "equation": "Stress_Release / Rigidity",
      "from_stock": null,
      "to_stock": "stock-displacement",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-tectonic-loading-rate",
      "name": "Tectonic Loading Rate",
      "equation": "1",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-failure-threshold",
      "name": "Failure Threshold",
      "equation": "100",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-release-fraction",
      "name": "Release Fraction",
      "equation": "0.9",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-rigidity",
      "name": "Rigidity",
      "equation": "30",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-earthquake-occurring",
      "name": "Earthquake Occurring",
      "equation": "IF Accumulated_Stress > Failure_Threshold THEN 1 ELSE 0",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-magnitude",
      "name": "Earthquake Magnitude",
      "equation": "IF Earthquake_Occurring THEN 2/3 * LOG10(Stress_Release) + 4 ELSE 0",
      "position": {
        "x": 300,
        "y": 160
      }
    },
    {
      "id": "var-log10",
      "name": "LOG10",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 160
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 500,
    "dt": 0.5
  },
  "created_at": "2026-01-11T21:11:32.980601+00:00",
  "updated_at": "2026-01-11T21:11:32.980601+00:00",
  "source": "https://github.com/SDXorg/test-models",
  "reference": "SDXorg System Dynamics Test Models"
}