      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-dvx",
      "name": "dVx",
      "equation": "Acceleration_X + 2 * \"Omega (Angular Velocity)\" * Y_Velocity + \"Omega (Angular Velocity)\"^2 * X_Position",
      "from_stock": null,
      "to_stock": "stock-vx",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "flow-dvy",
      "name": "dVy",
      "equation": "Acceleration_Y - 2 * \"Omega (Angular Velocity)\" * X_Velocity + \"Omega (Angular Velocity)\"^2 * Y_Position",
      "from_stock": null,
      "to_stock": "stock-vy",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-mu",
