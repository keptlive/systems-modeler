      }
    },
    {
      "id": "var-r1",
      "name": "Distance to Mass 1",
      "equation": "SQRT((X_Position + \"Mass Ratio (mu)\")^2 + Y_Position^2)",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-r2",
      "name": "Distance to Mass 2",
      "equation": "SQRT((X_Position - 1 + \"Mass Ratio (mu)\")^2 + Y_Position^2)",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-acceleration-x",
      "name": "Acceleration X",
      "equation": "- (1 - \"Mass Ratio (mu)\") * (X_Position + \"Mass Ratio (mu)\") / (Distance_to_Mass_1^3 + 0.001) - \"Mass Ratio (mu)\" * (X_Position - 1 + \"Mass Ratio (mu)\") / (Distance_to_Mass_2^3 + 0.001)",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-acceleration-y",
      "name": "Acceleration Y",
      "equation": "- (1 - \"Mass Ratio (mu)\") * Y_Position / (Distance_to_Mass_1^3 + 0.001) - \"Mass Ratio (mu)\" * Y_Position / (Distance_to_Mass_2^3 + 0.001)",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
