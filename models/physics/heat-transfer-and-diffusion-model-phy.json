      "position": {
        "x": 250,
        "y": 240
      }
    },
    {
      "id": "var-wall-density",
      "name": "Wall Density",
      "equation": "1800",
      "position": {
        "x": 400,
        "y": 240
      }
    },
    {
      "id": "var-wall-specific-heat",
      "name": "Wall Specific Heat",
      "equation": "900",
      "position": {
        "x": 550,
        "y": 240
      }
    },
    {
      "id": "var-floor-heat-capacity",
      "name": "Floor Heat Capacity",
      "equation": "Floor_Area * Floor_Thickness * Floor_Density * Floor_Specific_Heat",
      "position": {
        "x": 700,
        "y": 240
      }
    },
    {
      "id": "var-floor-area",
      "name": "Floor Area",
      "equation": "80",
      "position": {
        "x": 100,
        "y": 320
      }
    },
    {
      "id": "var-floor-thickness",
      "name": "Floor Thickness",
      "equation": "0.15",
      "position": {
        "x": 250,
        "y": 320
      }
    },
    {
      "id": "var-floor-density",
      "name": "Floor Density",
      "equation": "2400",
      "position": {
        "x": 400,
        "y": 320
      }
    },
    {
      "id": "var-floor-specific-heat",
      "name": "Floor Specific Heat",
      "equation": "880",
      "position": {
        "x": 550,
        "y": 320
      }
    },
    {
      "id": "var-wall-thermal-conductivity",
      "name": "Wall Thermal Conductivity",
      "equation": "0.5",
      "position": {
        "x": 700,
        "y": 320
      }
    },
    {
      "id": "var-wall-r-value",
      "name": "Wall R-Value",
      "equation": "Wall_Thickness / Wall_Thermal_Conductivity",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-wall-u-value",
      "name": "Wall U-Value",
      "equation": "1 / (Wall_R_Value + 1/Interior_Convection_Coefficient + 1/Exterior_Convection_Coefficient)",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "var-interior-convection-coefficient",
      "name": "Interior Convection Coefficient",
      "equation": "3",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "var-exterior-convection-coefficient",
      "name": "Exterior Convection Coefficient",
      "equation": "20",
      "position": {
        "x": 550,
        "y": 400
      }
    },
    {
      "id": "var-convection-wall-to-interior",
      "name": "Convection Wall to Interior",
      "equation": "Interior_Convection_Coefficient * Wall_Area * (Wall_Temperature - \"Interior Air Temperature\")",
      "position": {
        "x": 700,
        "y": 400
      }
    },
    {
      "id": "var-convection-exterior-to-wall",
      "name": "Convection Exterior to Wall",
      "equation": "Exterior_Convection_Coefficient * Wall_Area * (Exterior_Temperature - Wall_Temperature)",
      "position": {
        "x": 100,
        "y": 480
      }
    },
    {
      "id": "var-convection-floor-to-interior",
      "name": "Convection Floor to Interior",
      "equation": "Interior_Convection_Coefficient * Floor_Area * (\"Floor/Thermal Mass Temperature\" - \"Interior Air Temperature\")",
      "position": {
        "x": 250,
        "y": 480
      }
    },
    {
      "id": "var-infiltration-heat-loss",
      "name": "Infiltration Heat Loss",
      "equation": "Air_Changes_Per_Hour * Interior_Volume * Air_Density * Air_Specific_Heat * (\"Interior Air Temperature\" - Exterior_Temperature) / 3600",
      "position": {
        "x": 400,
        "y": 480
      }
    },
    {
      "id": "var-air-changes-per-hour",
      "name": "Air Changes Per Hour",
      "equation": "0.5",
      "position": {
        "x": 550,
        "y": 480
      }
    },
    {
      "id": "var-solar-gain-on-wall",
      "name": "Solar Gain on Wall",
      "equation": "Solar_Irradiance * Wall_Absorptivity * Wall_Area * Wall_Solar_Fraction",
      "position": {
        "x": 700,
        "y": 480
      }
    },
    {
      "id": "var-wall-absorptivity",
      "name": "Wall Absorptivity",
      "equation": "0.6",
      "position": {
        "x": 100,
        "y": 560
      }
    },
    {
      "id": "var-wall-solar-fraction",
      "name": "Wall Solar Fraction",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 560
      }
    },
    {
      "id": "var-solar-gain-through-windows",
      "name": "Solar Gain through Windows",
      "equation": "Solar_Irradiance * Window_Area * \"Window Solar Heat Gain Coefficient\"",
      "position": {
        "x": 400,
        "y": 560
      }
    },
    {
      "id": "var-window-area",
      "name": "Window Area",
      "equation": "15",
      "position": {
        "x": 550,
        "y": 560
      }
    },
    {
      "id": "var-window-solar-heat-gain-coefficient",
      "name": "Window Solar Heat Gain Coefficient",
      "equation": "0.4",
      "position": {
        "x": 700,
        "y": 560
      }
    },
    {
      "id": "var-solar-gain-to-floor",
      "name": "Solar Gain to Floor",
      "equation": "\"Solar Gain through Windows\" * 0.4",
      "position": {
        "x": 100,
        "y": 640
      }
    },
    {
      "id": "var-internal-heat-gains",
      "name": "Internal Heat Gains",
      "equation": "Internal_Gains_Schedule * \"Maximum Internal Gains\"",
      "position": {
        "x": 250,
        "y": 640
      }
    },
    {
      "id": "var-maximum-internal-gains",
      "name": "Maximum Internal Gains",
      "equation": "500",
      "position": {
        "x": 400,
        "y": 640
      }
    },
    {
      "id": "var-internal-gains-schedule",
      "name": "Internal Gains Schedule",
      "equation": "IF Time / 3600 MOD 24 > 8 AND Time / 3600 MOD 24 < 18 THEN 1 ELSE 0.2",
      "position": {
        "x": 550,
        "y": 640
      }
    },
    {
      "id": "var-radiation-wall-to-sky",
      "name": "Radiation Wall to Sky",
      "equation": "Wall_Emissivity * \"Stefan-Boltzmann Constant\" * Wall_Area * Wall_Solar_Fraction * (Wall_Temperature^4 - Sky_Temperature^4)",
      "position": {
        "x": 700,
        "y": 640
      }
    },
    {
      "id": "var-wall-emissivity",
      "name": "Wall Emissivity",
      "equation": "0.9",
      "position": {
        "x": 100,
        "y": 720
      }
    },
    {
      "id": "var-stefan-boltzmann-constant",
      "name": "Stefan-Boltzmann Constant",
      "equation": "5.67e-8",
      "position": {
        "x": 250,
        "y": 720
      }
    },
    {
      "id": "var-hvac-heating",
      "name": "HVAC Heating",
      "equation": "IF \"Interior Air Temperature\" < \"Temperature Setpoint\" - Thermostat_Deadband THEN HVAC_Capacity ELSE 0",
      "position": {
        "x": 400,
        "y": 720
      }
    },
    {
      "id": "var-hvac-cooling",
      "name": "HVAC Cooling",
      "equation": "IF \"Interior Air Temperature\" > \"Temperature Setpoint\" + Thermostat_Deadband THEN HVAC_Capacity ELSE 0",
      "position": {
        "x": 550,
        "y": 720
      }
    },
    {
      "id": "var-hvac-capacity",
      "name": "HVAC Capacity",
      "equation": "5000",
      "position": {
        "x": 700,
        "y": 720
      }
    },
    {
      "id": "var-hvac-coefficient-of-performance",
      "name": "HVAC Coefficient of Performance",
      "equation": "3",
      "position": {
        "x": 100,
        "y": 800
      }
    },
    {
      "id": "var-total-heat-loss",
      "name": "Total Heat Loss",
      "equation": "\"Convection Wall to Interior\" + \"Infiltration Heat Loss\"",
      "position": {
        "x": 250,
        "y": 800
      }
    },
    {
      "id": "var-total-heat-gain",
      "name": "Total Heat Gain",
      "equation": "\"Solar Gain through Windows\" + \"Internal Heat Gains\"",
      "position": {
        "x": 400,
        "y": 800
      }
    },
    {
      "id": "var-net-heat-flow",
      "name": "Net Heat Flow",
      "equation": "Total_Heat_Gain - Total_Heat_Loss + \"HVAC Heating\" - \"HVAC Cooling\"",
      "position": {
        "x": 550,
        "y": 800
      }
    },
    {
      "id": "var-interior-temperature-celsius",
      "name": "Interior Temperature (Celsius)",
      "equation": "\"Interior Air Temperature\" - 273.15",
      "position": {
        "x": 700,
        "y": 800
      }
    },
    {
      "id": "var-exterior-temperature-celsius",
      "name": "Exterior Temperature (Celsius)",
      "equation": "Exterior_Temperature - 273.15",
