{
  "id": "heat-transfer-and-diffusion-model-phy",
  "name": "Heat Transfer and Diffusion Model",
  "description": "A system dynamics model of heat transfer between multiple thermal masses, demonstrating conduction, convection, and radiation. Models a simplified building thermal system with walls, interior air, and external environment. Reference: Crank, J. (1979). The Mathematics of Diffusion. Oxford University Press. Source: https://global.oup.com/",
  "stocks": [
    {
      "id": "stock-interior-air-temperature",
      "name": "Interior Air Temperature",
      "initial_value": 293,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-wall-temperature",
      "name": "Wall Temperature",
      "initial_value": 290,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-floorthermal-mass-temperature",
      "name": "Floor/Thermal Mass Temperature",
      "initial_value": 291,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-total-energy-consumption",
      "name": "Total Energy Consumption",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 750,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-interior-heating-rate",
      "name": "Interior Heating Rate",
      "equation": "(\"Convection Wall to Interior\" + \"Convection Floor to Interior\" + \"Solar Gain through Windows\" + \"Internal Heat Gains\" + \"HVAC Heating\") / Interior_Heat_Capacity",
      "from_stock": null,
      "to_stock": "stock-interior-air-temperature",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-interior-cooling-rate",
      "name": "Interior Cooling Rate",
      "equation": "(\"Infiltration Heat Loss\" + \"HVAC Cooling\") / Interior_Heat_Capacity",
      "from_stock": "stock-interior-air-temperature",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-wall-heating-rate",
      "name": "Wall Heating Rate",
      "equation": "(\"Solar Gain on Wall\" + \"Convection Exterior to Wall\") / Wall_Heat_Capacity",
      "from_stock": null,
      "to_stock": "stock-wall-temperature",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-wall-cooling-rate",
      "name": "Wall Cooling Rate",
      "equation": "(\"Convection Wall to Interior\" + \"Radiation Wall to Sky\") / Wall_Heat_Capacity",
      "from_stock": "stock-wall-temperature",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-floor-heating-rate",
      "name": "Floor Heating Rate",
      "equation": "\"Solar Gain to Floor\" / Floor_Heat_Capacity",
      "from_stock": null,
      "to_stock": "stock-floorthermal-mass-temperature",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "flow-floor-cooling-rate",
      "name": "Floor Cooling Rate",
      "equation": "\"Convection Floor to Interior\" / Floor_Heat_Capacity",
      "from_stock": "stock-floorthermal-mass-temperature",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 350
      }
    },
    {
      "id": "flow-hvac-power-consumption",
      "name": "HVAC Power Consumption",
      "equation": "ABS(\"HVAC Heating\" + \"HVAC Cooling\") / \"HVAC Coefficient of Performance\"",
      "from_stock": null,
      "to_stock": "stock-total-energy-consumption",
      "position": {
        "x": 250,
        "y": 500
      }
    }
  ],
  "variables": [
    {
      "id": "var-exterior-temperature",
      "name": "Exterior Temperature",
      "equation": "283 + 5 * SIN(2 * 3.14159 * Time / 86400 - 3.14159 / 2)",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-sky-temperature",
      "name": "Sky Temperature",
      "equation": "Exterior_Temperature - 20",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-solar-irradiance",
      "name": "Solar Irradiance",
      "equation": "MAX(0, 800 * SIN(3.14159 * Time / 43200))",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-temperature-setpoint",
      "name": "Temperature Setpoint",
      "equation": "294",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-thermostat-deadband",
