{
  "id": "lorenz-strange-attractor-phy",
  "name": "Lorenz Strange Attractor Model",
  "description": "Edward Lorenz's (1963) atmospheric convection model that discovered deterministic chaos. Small differences in initial conditions lead to vastly different outcomes (butterfly effect). Foundation of chaos theory.",
  "stocks": [
    {"id": "stock-x", "name": "X", "initial_value": 1, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-y", "name": "Y", "initial_value": 1, "equation": "", "position": {"x": 400, "y": 200}},
    {"id": "stock-z", "name": "Z", "initial_value": 1, "equation": "", "position": {"x": 600, "y": 200}}
  ],
  "flows": [
    {"id": "flow-dx", "name": "dX", "equation": "Sigma * (Y - X)", "from_stock": null, "to_stock": "stock-x", "position": {"x": 100, "y": 200}},
    {"id": "flow-dy", "name": "dY", "equation": "X * (Rho - Z) - Y", "from_stock": null, "to_stock": "stock-y", "position": {"x": 300, "y": 200}},
    {"id": "flow-dz", "name": "dZ", "equation": "X * Y - Beta * Z", "from_stock": null, "to_stock": "stock-z", "position": {"x": 500, "y": 200}}
  ],
  "variables": [
    {"id": "var-sigma", "name": "Sigma", "equation": "10", "position": {"x": 200, "y": 100}},
    {"id": "var-rho", "name": "Rho", "equation": "28", "position": {"x": 400, "y": 100}},
    {"id": "var-beta", "name": "Beta", "equation": "2.667", "position": {"x": 600, "y": 100}},
    {"id": "var-radius", "name": "Radius", "equation": "SQRT(X ^ 2 + Y ^ 2 + Z ^ 2)", "position": {"x": 300, "y": 300}},
    {"id": "var-lyapunov-estimate", "name": "Lyapunov Estimate", "equation": "0.9", "position": {"x": 500, "y": 300}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 50, "dt": 0.01},
  "source": "https://doi.org/10.1175/1520-0469(1963)020<0130:DNF>2.0.CO;2",
  "reference": "Lorenz EN. Deterministic Nonperiodic Flow. Journal of the Atmospheric Sciences. 1963;20(2):130-141."
}
