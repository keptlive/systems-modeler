{
  "id": "lotka-volterra-competition-phy",
  "name": "Lotka-Volterra Competition Model",
  "description": "Two-species competition model from Lotka (1925) and Volterra (1926). Shows competitive exclusion, coexistence, and founder control depending on competition coefficients. Fundamental in ecology. Reference: Lotka, A. J. (1920). Analytical note on certain rhythmic relations in organic systems. PNAS, 6(7), 410-415. DOI: https://doi.org/10.1073/pnas.6.7.410",
  "stocks": [
    {
      "id": "stock-species1",
      "name": "Species 1 Population",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-species2",
      "name": "Species 2 Population",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-growth1",
      "name": "Species 1 Growth",
      "equation": "R1 * Species_1_Population * (1 - (Species_1_Population + Alpha12 * Species_2_Population) / K1)",
      "from_stock": null,
      "to_stock": "stock-species1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-growth2",
      "name": "Species 2 Growth",
      "equation": "R2 * Species_2_Population * (1 - (Species_2_Population + Alpha21 * Species_1_Population) / K2)",
      "from_stock": null,
      "to_stock": "stock-species2",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-r1",
      "name": "R1 (Growth Rate 1)",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-r2",
      "name": "R2 (Growth Rate 2)",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-k1",
      "name": "K1 (Carrying Capacity 1)",
      "equation": "100",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-k2",
      "name": "K2 (Carrying Capacity 2)",
      "equation": "80",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-alpha12",
      "name": "Alpha12 (Effect of 2 on 1)",
      "equation": "0.8",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-alpha21",
      "name": "Alpha21 (Effect of 1 on 2)",
      "equation": "1.2",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-total-population",
      "name": "Total Population",
      "equation": "Species_1_Population + Species_2_Population",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-species1-fraction",
      "name": "Species 1 Fraction",
      "equation": "Species_1_Population / Total_Population",
      "position": {
        "x": 250,
        "y": 160
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
