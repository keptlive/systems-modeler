{
  "id": "electric-grid-frequency-regulation-phy",
  "name": "Electric Grid Frequency Regulation Model",
  "description": "A model of power grid frequency dynamics and automatic generation control (AGC). Based on power systems engineering fundamentals for maintaining grid stability. Reference: EIA Electric Power Annual. Source: https://www.eia.gov/electricity/annual/",
  "source": "https://doi.org/10.1109/TPWRS.2012.2213277",
  "reference": "Kundur P. Power System Stability and Control. McGraw-Hill, 1994.",
  "stocks": [
    {
      "id": "stock-frequency",
      "name": "Grid Frequency Deviation",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-ace",
      "name": "Area Control Error Integral",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-generator",
      "name": "Generator Output",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-freq-change",
      "name": "Frequency Change",
      "equation": "(Power_Mismatch - D * Grid_Frequency_Deviation) / (2 * H)",
      "from_stock": null,
      "to_stock": "stock-frequency",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-ace-integral",
      "name": "ACE Integration",
      "equation": "Area_Control_Error",
      "from_stock": null,
      "to_stock": "stock-ace",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-agc-output",
      "name": "AGC Output Change",
      "equation": "AGC_Signal / Generator_Time_Constant",
      "from_stock": null,
      "to_stock": "stock-generator",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-power-mismatch",
      "name": "Power Mismatch",
      "equation": "Load - Generator_Output - Primary_Response",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-primary",
      "name": "Primary Response",
      "equation": "-Grid_Frequency_Deviation / R",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-ace",
      "name": "Area Control Error",
      "equation": "B * Grid_Frequency_Deviation + Tie_Line_Error",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-agc",
      "name": "AGC Signal",
      "equation": "-Kp * Area_Control_Error - Ki * Area_Control_Error_Integral",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-load",
      "name": "Load",
      "equation": "1000 + 50 * SIN(2 * 3.14159 * TIME / 60)",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-h",
      "name": "H",
      "equation": "5",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-d",
      "name": "D",
      "equation": "1",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-r",
      "name": "R",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-b",
      "name": "B",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-tie-error",
      "name": "Tie Line Error",
      "equation": "0",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "var-kp",
      "name": "Kp",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-ki",
      "name": "Ki",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-gen-tc",
      "name": "Generator Time Constant",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
