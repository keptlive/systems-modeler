{
  "id": "cell-cycle-regulation-phy",
  "name": "APC_Active",
  "description": "Illustrative cyclin-CDK and APC feedback model. Tyson and Novak (2001) provides conceptual background; this four-stock file is not a verified reproduction of a particular equation set in that paper. Checkpoint logic, mass-dependent synthesis, APC kinetics and continuous division loss are local assumptions requiring scientific review.",
  "stocks": [
    {
      "id": "s1",
      "name": "Cyclin_B",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Active_CDK1",
      "initial_value": 0.05,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "APC_Active",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Cell_Mass",
      "initial_value": 1.0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Cyclin_Synthesis",
      "equation": "k1 * Cell_Mass",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Cyclin_Degradation",
      "equation": "Cyclin_B * (k2 + k2_prime * APC_Active)",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "CDK_Activation",
      "equation": "(Cyclin_B - Active_CDK1) * \"Parameter lowercase k3\" / (\"Parameter uppercase K3\" + Cyclin_B - Active_CDK1)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "CDK_Inactivation",
      "equation": "Active_CDK1 * \"Parameter lowercase k4\" / (\"Parameter uppercase K4\" + Active_CDK1)",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "APC_Activation",
      "equation": "(1 - APC_Active) * \"Parameter lowercase k5\" * Active_CDK1 / (\"Parameter uppercase K5\" + 1 - APC_Active)",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "APC_Inactivation",
      "equation": "APC_Active * \"Parameter lowercase k6\" / (\"Parameter uppercase K6\" + APC_Active)",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "f7",
      "name": "Cell_Growth",
      "equation": "Cell_Mass * Growth_Rate",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "f8",
      "name": "Cell_Division",
      "equation": "Cell_Mass * Division_Rate * APC_Active",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
