{
  "id": "van-der-pol-oscillator-phy",
  "name": "Van der Pol Oscillator",
  "description": "Classic nonlinear oscillator with limit cycle behavior, important in electrical engineering and biology",
  "stocks": [
    {
      "id": "s1",
      "name": "Position",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Velocity",
      "initial_value": 0.0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [],
  "variables": [
    {
      "id": "v1",
      "name": "mu",
      "equation": "1.0",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Damping_Force",
      "equation": "mu*(1-Position*Position)*Velocity",
      "position": {
        "x": 230,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Restoring_Force",
      "equation": "-Position",
      "position": {
        "x": 360,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Acceleration",
      "equation": "Damping_Force+Restoring_Force",
      "position": {
        "x": 490,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Position",
      "to_element": "Damping_Force"
    },
    {
      "id": "c2",
      "from_element": "Velocity",
      "to_element": "Damping_Force"
    },
    {
      "id": "c3",
      "from_element": "mu",
      "to_element": "Damping_Force"
    },
    {
      "id": "c4",
      "from_element": "Position",
      "to_element": "Restoring_Force"
    }
  ],
  "time_settings": {
    "start": 0.0,
    "end": 50.0,
    "dt": 0.01
  },
  "created_at": "2026-01-15T20:40:14.102093+00:00",
  "updated_at": "2026-01-15T20:40:14.102100+00:00",
  "source": "https://doi.org/10.1080/14786442608564127",
  "reference": "Van der Pol, B. (1926) On relaxation-oscillations. Phil. Mag. 2:978-992"
}