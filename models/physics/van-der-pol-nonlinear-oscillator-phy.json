{
  "id": "van-der-pol-nonlinear-oscillator-phy",
  "name": "Van der Pol Nonlinear Oscillator Model",
  "description": "Classic nonlinear oscillator with self-sustaining oscillations and limit cycles. Used in electronics and cardiac physiology. Reference: Strogatz, S. H. (2015). Nonlinear Dynamics and Chaos. Westview Press. Source: https://doi.org/10.1201/9780429492563",
  "stocks": [
    {
      "id": "s1",
      "name": "Position x",
      "initial_value": 2,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Velocity v",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "dx dt",
      "equation": "Velocity_v",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "dv dt",
      "equation": "Mu * (1 - Position_x^2) * Velocity_v - Position_x",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 100,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Mu",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 225
      }
    },
    {
      "id": "v2",
      "name": "Energy",
      "equation": "0.5 * Velocity_v^2 + 0.5 * Position_x^2",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v3",
      "name": "Phase",
      "equation": "ATAN2(Velocity_v, Position_x)",
      "position": {
        "x": 350,
        "y": 150
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Position x",
      "to_element": "dv dt"
    },
    {
      "id": "c2",
      "from_element": "Velocity v",
      "to_element": "dx dt"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.01
  },
