{
  "id": "sustainable-development-systems-soc",
  "name": "Trust_Building",
  "description": "Dynamic model of nature-society systems for sustainable development. Integrates environmental, economic, and social subsystems with feedback loops. Based on PNAS 2023 perspective on modeling dynamic systems. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Natural_Capital",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Physical_Capital",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Human_Capital",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Social_Capital",
      "initial_value": 40,
      "equation": "",
      "position": {
        "x": 750,
        "y": 200
      }
    },
    {
      "id": "s5",
      "name": "Wellbeing_Index",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 450,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Natural_Regeneration",
      "equation": "Natural_Capital * Regeneration_Rate * (1 - Natural_Capital / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Resource_Extraction",
      "equation": "Extraction_Rate * Natural_Capital * Economic_Activity_Pressure",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Investment",
      "equation": "Savings_Rate * GDP",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Depreciation",
      "equation": "Physical_Capital * Depreciation_Rate",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Education",
      "equation": "Education_Investment * Education_Effectiveness",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Human_Capital_Decay",
      "equation": "Human_Capital * Decay_Rate",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "f7",
      "name": "Trust_Building",
      "equation": "Social_Investment * Trust_Factor",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "f8",
      "name": "Trust_Erosion",
      "equation": "Social_Capital * Erosion_Rate * Inequality",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 800,
        "y": 200
      }
    },
    {
      "id": "f9",
      "name": "Wellbeing_Change",
      "equation": "(Composite_Wellbeing - Wellbeing_Index) / Adjustment_Time",
      "from_stock": null,
      "to_stock": "s5",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
