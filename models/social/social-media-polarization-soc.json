{
  "id": "social-media-polarization-soc",
  "name": "Social Media Political Polarization Model",
  "description": "Models the dynamics of political polarization driven by social media algorithms, including echo chambers, engagement optimization, misinformation spread, and cross-cutting exposure. Based on computational social science research.",
  "source": "https://doi.org/10.1073/pnas.2024292118",
  "reference": "Bail CA, et al. Exposure to opposing views on social media can increase political polarization. PNAS. 2018. Guess A, et al. Less than you think: Prevalence and predictors of fake news dissemination. Science Advances. 2019.",
  "stocks": [
    {
      "id": "stock-moderate-left",
      "name": "Moderate Left",
      "initial_value": 30000000,
      "equation": "",
      "position": {"x": 100, "y": 100}
    },
    {
      "id": "stock-moderate-right",
      "name": "Moderate Right",
      "initial_value": 30000000,
      "equation": "",
      "position": {"x": 100, "y": 300}
    },
    {
      "id": "stock-polarized-left",
      "name": "Polarized Left",
      "initial_value": 10000000,
      "equation": "",
      "position": {"x": 300, "y": 100}
    },
    {
      "id": "stock-polarized-right",
      "name": "Polarized Right",
      "initial_value": 10000000,
      "equation": "",
      "position": {"x": 300, "y": 300}
    },
    {
      "id": "stock-misinformation",
      "name": "Misinformation Spread",
      "initial_value": 1000000,
      "equation": "",
      "position": {"x": 500, "y": 200}
    },
    {
      "id": "stock-trust-institutions",
      "name": "Trust in Institutions",
      "initial_value": 60,
      "equation": "",
      "position": {"x": 500, "y": 350}
    }
  ],
  "flows": [
    {
      "id": "flow-polarize-left",
      "name": "Left Polarization",
      "equation": "Moderate_Left * (Echo_Chamber_Effect + Algorithm_Amplification) * Engagement_Rate",
      "from_stock": "stock-moderate-left",
      "to_stock": "stock-polarized-left",
      "position": {"x": 200, "y": 100}
    },
    {
      "id": "flow-polarize-right",
      "name": "Right Polarization",
      "equation": "Moderate_Right * (Echo_Chamber_Effect + Algorithm_Amplification) * Engagement_Rate",
      "from_stock": "stock-moderate-right",
      "to_stock": "stock-polarized-right",
      "position": {"x": 200, "y": 300}
    },
    {
      "id": "flow-depolarize-left",
      "name": "Left Depolarization",
      "equation": "Polarized_Left * Cross_Cutting_Exposure * Fact_Check_Effect",
      "from_stock": "stock-polarized-left",
      "to_stock": "stock-moderate-left",
      "position": {"x": 200, "y": 150}
    },
    {
      "id": "flow-depolarize-right",
      "name": "Right Depolarization",
      "equation": "Polarized_Right * Cross_Cutting_Exposure * Fact_Check_Effect",
      "from_stock": "stock-polarized-right",
      "to_stock": "stock-moderate-right",
      "position": {"x": 200, "y": 250}
    },
    {
      "id": "flow-misinfo-spread",
      "name": "Misinformation Growth",
      "equation": "(Polarized_Left + Polarized_Right) * Misinfo_Share_Rate * Viral_Factor",
      "from_stock": null,
      "to_stock": "stock-misinformation",
      "position": {"x": 400, "y": 200}
    },
    {
      "id": "flow-misinfo-decay",
      "name": "Misinformation Decay",
      "equation": "Misinformation_Spread * Fact_Check_Rate",
      "from_stock": "stock-misinformation",
      "to_stock": null,
      "position": {"x": 600, "y": 200}
    },
    {
      "id": "flow-trust-erosion",
      "name": "Trust Erosion",
      "equation": "Trust_in_Institutions * Misinformation_Spread / 100000000 * Trust_Erosion_Rate",
      "from_stock": "stock-trust-institutions",
      "to_stock": null,
      "position": {"x": 500, "y": 400}
    }
  ],
  "variables": [
    {
      "id": "var-echo-chamber",
      "name": "Echo_Chamber_Effect",
      "equation": "0.002",
      "position": {"x": 150, "y": 50}
    },
    {
      "id": "var-algorithm",
      "name": "Algorithm_Amplification",
      "equation": "0.003",
      "position": {"x": 250, "y": 50}
    },
    {
      "id": "var-engagement",
      "name": "Engagement_Rate",
      "equation": "0.8",
      "position": {"x": 350, "y": 50}
    },
    {
      "id": "var-cross-cutting",
      "name": "Cross_Cutting_Exposure",
      "equation": "0.001",
      "position": {"x": 150, "y": 200}
    },
    {
      "id": "var-fact-check-effect",
      "name": "Fact_Check_Effect",
      "equation": "0.5",
      "position": {"x": 250, "y": 200}
    },
    {
      "id": "var-misinfo-share",
      "name": "Misinfo_Share_Rate",
      "equation": "0.00001",
      "position": {"x": 400, "y": 150}
    },
    {
      "id": "var-viral",
      "name": "Viral_Factor",
      "equation": "1.5",
      "position": {"x": 400, "y": 250}
    },
    {
      "id": "var-fact-check-rate",
      "name": "Fact_Check_Rate",
      "equation": "0.1",
      "position": {"x": 600, "y": 150}
    },
    {
      "id": "var-trust-erosion",
      "name": "Trust_Erosion_Rate",
      "equation": "0.01",
      "position": {"x": 600, "y": 350}
    },
    {
      "id": "var-polarization-index",
      "name": "Polarization_Index",
      "equation": "(Polarized_Left + Polarized_Right) / (Moderate_Left + Moderate_Right + Polarized_Left + Polarized_Right)",
      "position": {"x": 300, "y": 200}
    }
  ],
