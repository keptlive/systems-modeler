{
  "id": "dual-process-cognition-soc",
  "name": "Dual Process Theory of Cognition",
  "description": "Models System 1 (fast, intuitive) vs System 2 (slow, deliberate) thinking. Source: Kahneman (2011), Nobel Prize work. DOI: 10.1037/0033-295X.103.4.650",
  "stocks": [
    {
      "id": "stock-s1",
      "name": "System1_Activation",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-s2",
      "name": "System2_Activation",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-decision",
      "name": "Decision_Quality",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 350,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-s1act",
      "name": "System1_Response",
      "equation": "Stimulus_Intensity * (1 - Cognitive_Load) * S1_Speed",
      "from_stock": null,
      "to_stock": "stock-s1",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-s1decay",
      "name": "S1_Decay",
      "equation": "System1_Activation * S1_Decay_Rate",
      "from_stock": "stock-s1",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-s2act",
      "name": "System2_Response",
      "equation": "Task_Difficulty * S2_Effort * (1 - Fatigue)",
      "from_stock": null,
      "to_stock": "stock-s2",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "flow-s2decay",
      "name": "S2_Decay",
      "equation": "System2_Activation * S2_Decay_Rate",
      "from_stock": "stock-s2",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "flow-quality",
      "name": "Quality_Update",
      "equation": "(System2_Activation * 0.8 + System1_Activation * 0.3 - Decision_Quality) * 0.1",
      "from_stock": null,
      "to_stock": "stock-decision",
      "position": {
        "x": 250,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-stimulus",
      "name": "Stimulus_Intensity",
      "equation": "50 + 20 * SIN(TIME / 5)",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-difficulty",
      "name": "Task_Difficulty",
      "equation": "60",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-cogload",
      "name": "Cognitive_Load",
      "equation": "System2_Activation / 100",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-fatigue",
      "name": "Fatigue",
      "equation": "MIN(1, TIME * 0.01)",
      "position": {
        "x": 200,
        "y": 325
      }
    },
    {
      "id": "var-s1speed",
      "name": "S1_Speed",
      "equation": "0.8",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-s2effort",
      "name": "S2_Effort",
      "equation": "0.3",
      "position": {
        "x": 300,
        "y": 325
      }
    },
    {
      "id": "var-s1decay",
      "name": "S1_Decay_Rate",
      "equation": "0.2",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-s2decay",
      "name": "S2_Decay_Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "System2_Activation",
      "to_element": "Quality_Update"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:09:47.460422+00:00",
  "updated_at": "2026-01-12T02:09:47.460482+00:00",
  "source": "https://doi.org/10.1037/0033-295X.103.4.650",
  "reference": "Kahneman, D. (2011). Thinking, Fast and Slow. Farrar, Straus and Giroux."
}