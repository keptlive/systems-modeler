{
  "id": "social-media-misinformation-spread-soc",
  "name": "Social Media Misinformation Spread Dynamics",
  "description": "Model of misinformation spreading on social networks with fact-checking interventions. Based on Vosoughi et al. Science 2018. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Uninformed Population",
      "initial_value": 0.9,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Misinformed Population",
      "initial_value": 0.05,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "s3",
      "name": "Correctly Informed",
      "initial_value": 0.05,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "s4",
      "name": "Fact Check Reach",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Misinformation Spread",
      "equation": "Uninformed_Population * Misinformed_Population * Misinfo_Spread_Rate * Emotional_Amplification",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "f2",
      "name": "Truth Spread",
      "equation": "Uninformed_Population * Correctly_Informed * Truth_Spread_Rate",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "f3",
      "name": "Correction",
      "equation": "Misinformed_Population * Correction_Rate * Fact_Check_Reach",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 400,
        "y": 175
      }
    },
    {
      "id": "f4",
      "name": "Forgetting Truth",
      "equation": "Correctly_Informed * Forgetting_Rate",
      "from_stock": "s3",
      "to_stock": "s1",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "f5",
      "name": "Fact Check Growth",
      "equation": "Fact_Check_Investment * (1 - Fact_Check_Reach)",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 500,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Misinfo Spread Rate",
      "equation": "0.3",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Truth Spread Rate",
      "equation": "0.15",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "v3",
      "name": "Emotional Amplification",
      "equation": "1.5",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Correction Rate",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 125
      }
    },
    {
      "id": "v5",
      "name": "Forgetting Rate",
      "equation": "0.02",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "v6",
      "name": "Fact Check Investment",
      "equation": "0.05",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Network Clustering",
      "equation": "0.7",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Echo Chamber Effect",
      "equation": "1 + Network_Clustering * Misinformed_Population",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v9",
      "name": "Effective Misinfo Rate",
      "equation": "Misinfo_Spread_Rate * Echo_Chamber_Effect",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "v10",
      "name": "Misinformation Prevalence",
      "equation": "Misinformed_Population / (Misinformed_Population + Correctly_Informed + 0.001)",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v11",
      "name": "Information Quality Index",
      "equation": "Correctly_Informed / (Correctly_Informed + Misinformed_Population + 0.001)",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Uninformed Population",
      "to_element": "Misinformation Spread"
    },
    {
      "id": "c2",
      "from_element": "Misinformed Population",
      "to_element": "Correction"
    },
    {
      "id": "c3",
      "from_element": "Fact Check Reach",
      "to_element": "Correction"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-15T14:14:19.565573",
  "updated_at": "2026-01-15T14:14:19.565581",
  "source": "https://doi.org/10.1126/science.aap9559",
  "reference": "Vosoughi S, Roy D, Aral S. The spread of true and false news online. Science. 2018;359(6380):1146-1151."
}