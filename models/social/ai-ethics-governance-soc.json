{
  "id": "ai-ethics-governance-soc",
  "name": "AI Ethics and Governance Dynamics",
  "description": "A model of AI development, deployment, and governance dynamics, capturing the race between AI capabilities and safety measures, regulatory responses, and public trust. Based on emerging AI governance frameworks. Reference: Floridi, L., et al. (2018). AI4People\u2014An Ethical Framework. Minds and Machines. Source: https://doi.org/10.1007/s11023-018-9482-5",
  "source": "https://doi.org/10.1126/science.aax2342",
  "reference": "Amodei D, et al. Concrete Problems in AI Safety. arXiv:1606.06565. 2016. See also Dafoe A. AI Governance: A Research Agenda. 2018.",
  "stocks": [
    {
      "id": "stock-capabilities",
      "name": "AI Capabilities",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-safety",
      "name": "AI Safety Measures",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-regulation",
      "name": "Regulatory Framework",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "stock-trust",
      "name": "Public Trust",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-capability-growth",
      "name": "Capability Growth",
      "equation": "AI_Capabilities * R_and_D_Investment * Compute_Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-capabilities",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-safety-research",
      "name": "Safety Research",
      "equation": "Safety_Investment * Safety_Gap_Pressure",
      "from_stock": null,
      "to_stock": "stock-safety",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-regulatory-development",
      "name": "Regulatory Development",
      "equation": "Regulatory_Speed * Perceived_Risk * (1 - Regulatory_Framework / 100)",
      "from_stock": null,
      "to_stock": "stock-regulation",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "flow-trust-change",
      "name": "Trust Change",
      "equation": "(AI_Safety_Measures - AI_Capabilities * 0.5) * 0.1 + (Regulatory_Framework - 50) * 0.05",
      "from_stock": null,
      "to_stock": "stock-trust",
      "position": {
        "x": 400,
        "y": 500
      }
    }
  ],
  "variables": [
    {
      "id": "var-rd-investment",
      "name": "R and D Investment",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-compute",
      "name": "Compute Growth Rate",
      "equation": "1.5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-safety-invest",
      "name": "Safety Investment",
      "equation": "5",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-safety-gap",
      "name": "Safety Gap Pressure",
      "equation": "MAX(0.1, (AI_Capabilities - AI_Safety_Measures) / 100)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-reg-speed",
      "name": "Regulatory Speed",
      "equation": "0.5",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-perceived-risk",
      "name": "Perceived Risk",
      "equation": "(AI_Capabilities - AI_Safety_Measures) / AI_Capabilities * (100 - Public_Trust) / 100",
      "position": {
        "x": 700,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T08:00:00.000000+00:00",
  "updated_at": "2026-01-12T08:00:00.000000+00:00"
}