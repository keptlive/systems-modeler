{
  "id": "asch-social-conformity-dynamics-soc",
  "name": "Asch Social Conformity Model",
  "description": "Group pressure effects on individual judgment. Source: Asch (1956), Psychological Monographs.",
  "stocks": [
    {
      "id": "s1",
      "name": "Private_Opinion",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Public_Statement",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Conformity_Count",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Opinion_Shift",
      "equation": "Social_Influence - Independence_Tendency",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Statement_Adjustment",
      "equation": "(Expressed_Opinion - Public_Statement) / Response_Time",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Conformity_Detection",
      "equation": "IF(ABS(Public_Statement - Private_Opinion) > 0.3, 1, 0)",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Group_Opinion",
      "equation": "0.8",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Group_Size",
      "equation": "5",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Unanimity",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Conformity_Pressure",
      "equation": "0.1 * MIN(Group_Size, 4) * Unanimity",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Social_Influence",
      "equation": "Conformity_Pressure * (Group_Opinion - Private_Opinion)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Self_Confidence",
      "equation": "0.7",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v7",
      "name": "Independence_Tendency",
      "equation": "Self_Confidence * (Private_Opinion - 0.5) * 0.1",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "v8",
      "name": "Expressed_Opinion",
      "equation": "Private_Opinion + (Group_Opinion - Private_Opinion) * (1 - Self_Confidence)",
      "position": {
        "x": 200,
        "y": 480
      }
    },
    {
      "id": "v9",
      "name": "Response_Time",
      "equation": "1",
      "position": {
        "x": 400,
        "y": 480
      }
    },
    {
      "id": "v10",
      "name": "Conformity_Rate",
      "equation": "Conformity_Count / (TIME + 1)",
      "position": {
        "x": 300,
        "y": 540
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Group_Opinion",
      "to_element": "Social_Influence"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 20,
    "dt": 0.5
  },
  "created_at": "2026-01-15T14:54:39.083653+00:00",
  "updated_at": "2026-01-15T14:54:39.083657+00:00",
  "source": "https://doi.org/10.1037/h0093718",
  "reference": "Asch, S.E. (1956). Studies of independence and conformity: A minority of one against a unanimous majority. Psychological Monographs 70:1-70."
}