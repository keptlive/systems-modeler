{
  "id": "urban-traffic-flow-dynamics-soc",
  "name": "Urban Traffic Flow Dynamics Model",
  "description": "Illustrative traffic stock-flow model using a linear speed-density relation and queue heuristics. Lighthill and Whitham (1955), Part II, is conceptual background; this file is not a verified spatial discretization or reproduction of the LWR conservation law. Parameter units, vehicle conservation and numerical stability require review.",
  "stocks": [
    {
      "id": "stock-road-segment-1",
      "name": "Vehicles_Segment_1",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-road-segment-2",
      "name": "Vehicles_Segment_2",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-road-segment-3",
      "name": "Vehicles_Segment_3",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-queue-length",
      "name": "Queue_Length",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "stock-cumulative-delay",
      "name": "Cumulative_Delay",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-inflow",
      "name": "Traffic_Inflow",
      "equation": "Demand_Rate * (1 + 0.5 * SIN((TIME - 8) * 3.14159 / 4))",
      "from_stock": null,
      "to_stock": "stock-road-segment-1",
      "position": {
        "x": 75,
        "y": 200
      }
    },
    {
      "id": "flow-1-to-2",
      "name": "Flow_1_to_2",
      "equation": "Flow_Rate_1",
      "from_stock": "stock-road-segment-1",
      "to_stock": "stock-road-segment-2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-2-to-3",
      "name": "Flow_2_to_3",
      "equation": "Flow_Rate_2",
      "from_stock": "stock-road-segment-2",
      "to_stock": "stock-road-segment-3",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-outflow",
      "name": "Traffic_Outflow",
      "equation": "Flow_Rate_3",
      "from_stock": "stock-road-segment-3",
      "to_stock": null,
      "position": {
        "x": 625,
        "y": 200
      }
    },
    {
      "id": "flow-queue-buildup",
      "name": "Queue_Buildup",
      "equation": "MAX(0, Flow_Rate_2 - Bottleneck_Capacity)",
      "from_stock": null,
      "to_stock": "stock-queue-length",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-queue-discharge",
      "name": "Queue_Discharge",
      "equation": "MIN(Queue_Length / DT, Bottleneck_Capacity)",
      "from_stock": "stock-queue-length",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 420
      }
    },
    {
      "id": "flow-delay-accrual",
      "name": "Delay_Accrual",
      "equation": "Queue_Length / Bottleneck_Capacity * Flow_Rate_2",
      "from_stock": null,
      "to_stock": "stock-cumulative-delay",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-demand-rate",
      "name": "Demand_Rate",
      "equation": "500",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-free-flow-speed",
      "name": "Free_Flow_Speed",
      "equation": "60",
      "position": {
        "x": 220,
        "y": 80
      }
    },
    {
      "id": "var-jam-density",
      "name": "Jam_Density",
      "equation": "200",
      "position": {
        "x": 340,
        "y": 80
      }
    },
    {
      "id": "var-segment-length",
      "name": "Segment_Length",
      "equation": "1",
      "position": {
        "x": 460,
        "y": 80
      }
    },
    {
      "id": "var-bottleneck-capacity",
      "name": "Bottleneck_Capacity",
      "equation": "400",
