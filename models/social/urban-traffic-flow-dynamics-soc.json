        "x": 150,
        "y": 130
      }
    },
    {
      "id": "var-density-2",
      "name": "Density_2",
      "equation": "Vehicles_Segment_2 / Segment_Length",
      "position": {
        "x": 350,
        "y": 130
      }
    },
    {
      "id": "var-density-3",
      "name": "Density_3",
      "equation": "Vehicles_Segment_3 / Segment_Length",
      "position": {
        "x": 550,
        "y": 130
      }
    },
    {
      "id": "var-speed-1",
      "name": "Speed_1",
      "equation": "Free_Flow_Speed * (1 - Density_1 / Jam_Density)",
      "position": {
        "x": 150,
        "y": 280
      }
    },
    {
      "id": "var-speed-2",
      "name": "Speed_2",
      "equation": "Free_Flow_Speed * (1 - Density_2 / Jam_Density)",
      "position": {
        "x": 350,
        "y": 280
      }
    },
    {
      "id": "var-speed-3",
      "name": "Speed_3",
      "equation": "Free_Flow_Speed * (1 - Density_3 / Jam_Density)",
      "position": {
        "x": 550,
        "y": 280
      }
    },
    {
      "id": "var-flow-rate-1",
      "name": "Flow_Rate_1",
      "equation": "Density_1 * Speed_1",
      "position": {
        "x": 150,
        "y": 450
      }
    },
    {
      "id": "var-flow-rate-2",
      "name": "Flow_Rate_2",
      "equation": "Density_2 * Speed_2",
      "position": {
        "x": 350,
        "y": 450
      }
    },
    {
      "id": "var-flow-rate-3",
      "name": "Flow_Rate_3",
      "equation": "Density_3 * Speed_3",
      "position": {
        "x": 550,
        "y": 450
      }
    }
  ],
