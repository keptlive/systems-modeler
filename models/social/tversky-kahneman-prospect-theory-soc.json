{
  "id": "tversky-kahneman-prospect-theory-soc",
  "name": "Tversky-Kahneman Prospect Theory Model",
  "description": "Nobel Prize-winning model of decision-making under risk with loss aversion and probability weighting. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Reference_Point",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Accumulated_Value",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Reference_Adjustment",
      "equation": "(Current_Wealth - Reference_Point) / Adaptation_Time",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Value_Accumulation",
      "equation": "Subjective_Value",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Current_Wealth",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Outcome",
      "equation": "Current_Wealth - Reference_Point",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Loss_Aversion",
      "equation": "2.25",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Risk_Aversion_Gains",
      "equation": "0.88",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Risk_Seeking_Losses",
      "equation": "0.88",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "v6",
      "name": "Subjective_Value",
      "equation": "IF(Outcome >= 0, Outcome ^ Risk_Aversion_Gains, -Loss_Aversion * (ABS(Outcome)) ^ Risk_Seeking_Losses)",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Adaptation_Time",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:26:32.201878+00:00",
  "updated_at": "2026-01-12T11:26:32.201878+00:00",
  "source": "https://doi.org/10.2307/1914185",
  "reference": "Kahneman D, Tversky A. Prospect theory: An analysis of decision under risk. Econometrica. 1979;47(2):263-291. Nobel Prize 2002."
}