{
  "id": "schelling-segregation-dynamics-soc",
  "name": "Schelling Segregation Model",
  "description": "Model of residential segregation showing how mild preferences create strong segregation. Nobel Prize 2005. Source: Schelling (1971), J Math Sociology. Reference: Schelling, T. C. (1971). Dynamic models of segregation. Journal of Mathematical Sociology, 1(2), 143-186. DOI: https://doi.org/10.1080/0022250X.1971.9989794",
  "stocks": [
    {
      "id": "s1",
      "name": "Segregation_Index",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Integrated_Areas",
      "initial_value": 90,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Segregated_Areas",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Tipping",
      "equation": "tipping_rate * Integrated_Areas * (1 - Similarity_Tolerance)",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 300,
        "y": 275
      }
    },
    {
      "id": "f2",
      "name": "Index_Update",
      "equation": "0.1 * (Segregated_Areas / (Integrated_Areas + Segregated_Areas + 0.01) - Segregation_Index)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Similarity_Tolerance",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "tipping_rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Similarity_Tolerance",
      "to_element": "Tipping"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
