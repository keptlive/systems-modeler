{
  "id": "social-media-echo-chamber-soc",
  "name": "Social Media Echo Chamber Model",
  "description": "Models opinion polarization through algorithmic filtering and social influence. Based on Pariser (2011) and Bakshy et al. (2015). DOI: 10.1126/science.aaa1160",
  "stocks": [
    {
      "id": "stock-moderate",
      "name": "Moderate_Users",
      "initial_value": 600,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-leftpolar",
      "name": "Left_Polarized",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "stock-rightpolar",
      "name": "Right_Polarized",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "stock-engagement",
      "name": "Platform_Engagement",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-leftshift",
      "name": "Left_Polarization",
      "equation": "Moderate_Users * Left_Exposure * Polarization_Rate * Algorithm_Strength",
      "from_stock": "stock-moderate",
      "to_stock": "stock-leftpolar",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-rightshift",
      "name": "Right_Polarization",
      "equation": "Moderate_Users * Right_Exposure * Polarization_Rate * Algorithm_Strength",
      "from_stock": "stock-moderate",
      "to_stock": "stock-rightpolar",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-leftmod",
      "name": "Left_Moderation",
      "equation": "Left_Polarized * Cross_Cutting_Exposure * Moderation_Rate",
      "from_stock": "stock-leftpolar",
      "to_stock": "stock-moderate",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "flow-rightmod",
      "name": "Right_Moderation",
      "equation": "Right_Polarized * Cross_Cutting_Exposure * Moderation_Rate",
      "from_stock": "stock-rightpolar",
      "to_stock": "stock-moderate",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "flow-engageinc",
      "name": "Engagement_Increase",
      "equation": "Polarization_Level * Engagement_Sensitivity",
      "from_stock": null,
      "to_stock": "stock-engagement",
      "position": {
        "x": 250,
        "y": 175
      }
    },
    {
      "id": "flow-engagedec",
      "name": "Engagement_Decay",
      "equation": "Platform_Engagement * Decay_Rate",
      "from_stock": "stock-engagement",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-leftexp",
      "name": "Left_Exposure",
      "equation": "0.3 + 0.2 * (Left_Polarized / 800)",
      "position": {
        "x": 100,
        "y": 175
      }
    },
    {
      "id": "var-rightexp",
      "name": "Right_Exposure",
      "equation": "0.3 + 0.2 * (Right_Polarized / 800)",
      "position": {
        "x": 500,
        "y": 175
      }
    },
    {
      "id": "var-polrate",
      "name": "Polarization_Rate",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-algstrength",
      "name": "Algorithm_Strength",
      "equation": "1.5",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-crosscut",
      "name": "Cross_Cutting_Exposure",
      "equation": "0.2 / (1 + Platform_Engagement / 100)",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "var-modrate",
      "name": "Moderation_Rate",
      "equation": "0.02",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-pollevel",
      "name": "Polarization_Level",
      "equation": "(Left_Polarized + Right_Polarized) / (Moderate_Users + 1)",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "var-engagesens",
      "name": "Engagement_Sensitivity",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 325
      }
    },
    {
      "id": "var-decayrate",
      "name": "Decay_Rate",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 325
      }
    },
    {
      "id": "var-echointens",
      "name": "Echo_Chamber_Intensity",
      "equation": "1 - Cross_Cutting_Exposure",
      "position": {
        "x": 450,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Platform_Engagement",
      "to_element": "Cross_Cutting_Exposure"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:55:29.074339+00:00",
  "updated_at": "2026-01-12T02:55:29.074347+00:00",
  "source": "https://doi.org/10.1126/science.aaa1160",
  "reference": "Bakshy E, Messing S, Adamic LA (2015). Exposure to ideologically diverse news. Science."
}