{
  "id": "richardson-arms-race-model-soc",
  "name": "Richardson Arms Race Model",
  "description": "Lewis Fry Richardson's mathematical model of arms races between nations, published in 1960. Shows how mutual fear and grievances can lead to arms buildups, demonstrating the dynamics of escalation and the possibility of stable equilibria or runaway armament. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-country-a-arms",
      "name": "Country A Arms",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-country-b-arms",
      "name": "Country B Arms",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-a-armament-change",
      "name": "A Armament Change",
      "equation": "Defense_Coefficient_A * Country_B_Arms - Fatigue_Coefficient_A * Country_A_Arms + Grievance_A",
      "from_stock": null,
      "to_stock": "stock-country-a-arms",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-b-armament-change",
      "name": "B Armament Change",
      "equation": "Defense_Coefficient_B * Country_A_Arms - Fatigue_Coefficient_B * Country_B_Arms + Grievance_B",
      "from_stock": null,
      "to_stock": "stock-country-b-arms",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
