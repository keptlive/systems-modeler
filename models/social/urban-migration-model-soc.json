    },
    {
      "id": "conn-6",
      "from_element": "Urban Stress Factor",
      "to_element": "Return Migration"
    },
    {
      "id": "conn-7",
      "from_element": "Urban Population",
      "to_element": "Desired Housing"
    },
    {
      "id": "conn-8",
      "from_element": "Urban Population",
