{
  "id": "refugee-integration-dynamics-soc",
  "name": "Refugee Integration Dynamics Model",
  "description": "Models refugee integration outcomes including employment and social cohesion. Based on Ager & Strang (2008). DOI: 10.1093/jrs/fen016",
  "stocks": [
    {
      "id": "stock-newarrival",
      "name": "New_Arrivals",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "stock-integrating",
      "name": "Integrating",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-integrated",
      "name": "Integrated",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "stock-marginal",
      "name": "Marginalized",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-intake",
      "name": "New_Intake",
      "equation": "Arrival_Rate",
      "from_stock": null,
      "to_stock": "stock-newarrival",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-startinteg",
      "name": "Start_Integration",
      "equation": "New_Arrivals * Initial_Support_Rate",
      "from_stock": "stock-newarrival",
      "to_stock": "stock-integrating",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-achieve",
      "name": "Integration_Achievement",
      "equation": "Integrating * Integration_Rate * Support_Quality",
      "from_stock": "stock-integrating",
      "to_stock": "stock-integrated",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-marginalize",
      "name": "Marginalization",
      "equation": "(New_Arrivals + Integrating) * Marginalization_Rate * (1 - Social_Cohesion)",
      "from_stock": "stock-integrating",
      "to_stock": "stock-marginal",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "flow-recovery",
      "name": "Recovery",
      "equation": "Marginalized * Recovery_Rate * Support_Quality",
      "from_stock": "stock-marginal",
      "to_stock": "stock-integrating",
      "position": {
        "x": 200,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-arrrate",
      "name": "Arrival_Rate",
      "equation": "10 + 5 * SIN(TIME / 12)",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-initsupport",
      "name": "Initial_Support_Rate",
      "equation": "0.7",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "var-integrate",
      "name": "Integration_Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-supqual",
      "name": "Support_Quality",
      "equation": "(Language_Training + Employment_Support + Housing_Access) / 3",
      "position": {
        "x": 450,
        "y": 175
      }
    },
    {
      "id": "var-langtrain",
      "name": "Language_Training",
      "equation": "0.7",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "var-empsup",
      "name": "Employment_Support",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "var-housacc",
      "name": "Housing_Access",
      "equation": "0.6",
      "position": {
        "x": 550,
        "y": 175
      }
    },
    {
      "id": "var-margrate",
      "name": "Marginalization_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "var-soccoh",
      "name": "Social_Cohesion",
      "equation": "Integrated / (New_Arrivals + Integrating + Integrated + Marginalized + 1)",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-recovrate",
      "name": "Recovery_Rate",
      "equation": "0.1",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "var-integindex",
      "name": "Integration_Index",
      "equation": "Integrated / (Integrated + Marginalized + 1)",
      "position": {
        "x": 450,
        "y": 325
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Support_Quality",
      "to_element": "Integration_Achievement"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 120,
    "dt": 1
  },
  "created_at": "2026-01-12T02:55:29.074562+00:00",
  "updated_at": "2026-01-12T02:55:29.074570+00:00",
  "source": "https://doi.org/10.1093/jrs/fen016",
  "reference": "Ager A, Strang A (2008). Understanding Integration: A Conceptual Framework. Journal of Refugee Studies."
}