{
  "id": "demographic-dividend-soc",
  "name": "Demographic Dividend Model",
  "description": "Model of age structure and economic growth. Source: Bloom et al. (2003), World Development. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "stock-young",
      "name": "Youth_Population",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-working",
      "name": "Working_Age",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-elderly",
      "name": "Elderly",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-birth",
      "name": "Births",
      "equation": "Working_Age * Fertility_Rate",
      "from_stock": null,
      "to_stock": "stock-young",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-mature",
      "name": "Maturation",
      "equation": "Youth_Population / Youth_Period",
      "from_stock": "stock-young",
      "to_stock": "stock-working",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-age",
      "name": "Aging",
      "equation": "Working_Age / Working_Period",
      "from_stock": "stock-working",
      "to_stock": "stock-elderly",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-death",
      "name": "Deaths",
      "equation": "Elderly / Life_Expectancy_Elderly",
      "from_stock": "stock-elderly",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-fert",
      "name": "Fertility_Rate",
      "equation": "0.02 - 0.0003 * TIME",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-youth",
      "name": "Youth_Period",
      "equation": "18",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "var-work",
      "name": "Working_Period",
      "equation": "45",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "var-life",
      "name": "Life_Expectancy_Elderly",
      "equation": "20",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-depend",
      "name": "Dependency_Ratio",
      "equation": "(Youth_Population + Elderly) / Working_Age",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "var-dividend",
      "name": "Demographic_Dividend",
      "equation": "Working_Age / (Youth_Population + Elderly)",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-12T12:53:13.193481+00:00",
  "updated_at": "2026-01-12T12:53:13.193481+00:00",
  "source": "https://doi.org/10.1111/j.1728-4457.2003.00323.x",
  "reference": "Bloom DE, Canning D, Sevilla J. The demographic dividend: A new perspective on the economic consequences of population change. RAND Corporation; 2003."
}