{
  "id": "gentrification-dynamics-soc",
  "name": "Gentrification and Neighborhood Change Model",
  "description": "Model of neighborhood socioeconomic change showing displacement dynamics. Source: Lees et al. (2008), Gentrification; Hwang & Sampson (2014), ASR. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "stock-lowinc",
      "name": "Low_Income_Residents",
      "initial_value": 800,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-highinc",
      "name": "High_Income_Residents",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-rent",
      "name": "Average_Rent",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "stock-amenity",
      "name": "Neighborhood_Amenities",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-lowin",
      "name": "Low_Income_In",
      "equation": "Base_Low_Income_In * Affordability",
      "from_stock": null,
      "to_stock": "stock-lowinc",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-lowout",
      "name": "Low_Income_Out",
      "equation": "Low_Income_Residents * (1 - Affordability) * Displacement_Rate",
      "from_stock": "stock-lowinc",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-highin",
      "name": "High_Income_In",
      "equation": "Base_High_Income_In * Attractiveness",
      "from_stock": null,
      "to_stock": "stock-highinc",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-highout",
      "name": "High_Income_Out",
      "equation": "High_Income_Residents * Base_Turnover",
      "from_stock": "stock-highinc",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-rentinc",
      "name": "Rent_Increase",
      "equation": "(Target_Rent - Average_Rent) / Rent_Adjust_Time",
      "from_stock": null,
      "to_stock": "stock-rent",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "flow-ameninc",
      "name": "Amenity_Investment",
      "equation": "High_Income_Residents * Amenity_Spending / 100",
      "from_stock": null,
      "to_stock": "stock-amenity",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "flow-amendec",
      "name": "Amenity_Decay",
      "equation": "Neighborhood_Amenities * Amenity_Decay_Rate",
      "from_stock": "stock-amenity",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-baselo",
      "name": "Base_Low_Income_In",
      "equation": "20",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-afford",
      "name": "Affordability",
      "equation": "MAX(0, 1 - Average_Rent / Affordable_Threshold)",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-affthresh",
      "name": "Affordable_Threshold",
      "equation": "1500",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-displace",
      "name": "Displacement_Rate",
      "equation": "0.1",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-basehi",
      "name": "Base_High_Income_In",
      "equation": "10",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-attract",
      "name": "Attractiveness",
      "equation": "Neighborhood_Amenities / 50 * (1 + 0.5 * High_Income_Residents / Total_Pop)",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-turnover",
      "name": "Base_Turnover",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "var-targetrent",
      "name": "Target_Rent",
      "equation": "1000 + 2 * High_Income_Residents",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "var-rentadj",
      "name": "Rent_Adjust_Time",
      "equation": "4",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "var-amenspend",
      "name": "Amenity_Spending",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "var-amendecay",
      "name": "Amenity_Decay_Rate",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 400
      }
    },
    {
      "id": "var-total",
      "name": "Total_Pop",
      "equation": "Low_Income_Residents + High_Income_Residents",
      "position": {
        "x": 200,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T12:45:39.561864+00:00",
  "updated_at": "2026-01-12T12:45:39.561864+00:00",
  "source": "https://doi.org/10.1257/jep.28.4.3",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}