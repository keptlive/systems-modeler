      "equation": "0.002",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-elderly-mort",
      "name": "Elderly_Mortality",
      "equation": "0.04",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-contribution",
      "name": "Avg_Contribution",
      "equation": "0.005",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-pension",
      "name": "Avg_Pension",
      "equation": "0.015",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-dependency",
      "name": "Old_Age_Dependency_Ratio",
      "equation": "Elderly_65plus_Million / Working_Age_15_64_Million",
      "position": {
        "x": 300,
        "y": 450
      }
    },
    {
      "id": "var-total-dependency",
      "name": "Total_Dependency_Ratio",
      "equation": "(Youth_0_14_Million + Elderly_65plus_Million) / Working_Age_15_64_Million",
