{
  "id": "schelling-tipping-extended-soc",
  "name": "Schelling Tipping Point Extended",
  "description": "Collective behavior model where individual thresholds create population-level tipping. Explains how small preference for segregation creates complete segregation. Extended with heterogeneous thresholds. Reference: Schelling, T. C. (1971). Dynamic models of segregation. Journal of Mathematical Sociology, 1(2), 143-186. DOI: https://doi.org/10.1080/0022250X.1971.9989794",
  "stocks": [
    {
      "id": "stock-adopters",
      "name": "Behavior Adopters",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-adoption",
      "name": "Net Adoption",
      "equation": "Adoption_Rate - Abandonment_Rate",
      "from_stock": null,
      "to_stock": "stock-adopters",
      "position": {
        "x": 150,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-adoption",
      "name": "Adoption Rate",
      "equation": "(1 - Behavior_Adopters) * Fraction_Above_Threshold",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-abandonment",
      "name": "Abandonment Rate",
      "equation": "Behavior_Adopters * (1 - Fraction_Above_Threshold)",
      "position": {
        "x": 350,
        "y": 80
      }
    },
    {
      "id": "var-fraction-above",
      "name": "Fraction Above Threshold",
      "equation": "1 / (1 + EXP(-Threshold_Slope * (Behavior_Adopters - Mean_Threshold)))",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-mean-threshold",
      "name": "Mean Threshold",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-threshold-slope",
      "name": "Threshold Slope",
      "equation": "20",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-tipping-point",
      "name": "Tipping Point",
      "equation": "Mean_Threshold",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-stable-eq",
      "name": "Stable Equilibrium",
      "equation": "IF(Behavior_Adopters > Mean_Threshold, 1, 0)",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Behavior Adopters",
      "to_element": "Fraction Above Threshold"
    },
    {
      "id": "conn-2",
      "from_element": "Fraction Above Threshold",
      "to_element": "Adoption Rate"
    },
    {
      "id": "conn-3",
      "from_element": "Fraction Above Threshold",
      "to_element": "Abandonment Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.1
  },
  "created_at": "2026-01-12T07:39:15.418176+00:00",
  "updated_at": "2026-01-12T07:39:15.418183+00:00",
  "source": "https://doi.org/10.1086/225823",
  "reference": "Schelling TC. Dynamic Models of Segregation. Journal of Mathematical Sociology. 1971;1(2):143-186."
}