        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-value",
      "name": "Value",
      "equation": "50",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-impulse",
      "name": "Impulsiveness",
      "equation": "10",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-delay",
      "name": "Delay",
      "equation": "1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "var-timeleft",
      "name": "Time_Left",
      "equation": "MAX(1, 30 - TIME)",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "var-effort",
      "name": "Effort",
      "equation": "1",
      "position": {
        "x": 300,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "tables": [],
