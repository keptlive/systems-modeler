{
  "id": "barabasi-albert-scale-free-network-soc",
  "name": "Barabási-Albert Scale-Free Network Model",
  "description": "Albert-László Barabási and Réka Albert's (1999) preferential attachment model generating scale-free networks. New nodes prefer to connect to highly connected nodes, creating power-law degree distributions observed in WWW, social networks, and biological networks.",
  "stocks": [
    {"id": "stock-total-nodes", "name": "Total Nodes", "initial_value": 10, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-total-edges", "name": "Total Edges", "initial_value": 45, "equation": "", "position": {"x": 400, "y": 200}},
    {"id": "stock-hub-connections", "name": "Hub Connections", "initial_value": 9, "equation": "", "position": {"x": 600, "y": 200}}
  ],
  "flows": [
    {"id": "flow-node-addition", "name": "Node Addition", "equation": "Node_Addition_Rate", "from_stock": null, "to_stock": "stock-total-nodes", "position": {"x": 100, "y": 200}},
    {"id": "flow-edge-addition", "name": "Edge Addition", "equation": "Node_Addition_Rate * Edges_Per_Node", "from_stock": null, "to_stock": "stock-total-edges", "position": {"x": 300, "y": 200}},
    {"id": "flow-hub-growth", "name": "Hub Growth", "equation": "Node_Addition_Rate * Edges_Per_Node * Hub_Connections / (2 * Total_Edges)", "from_stock": null, "to_stock": "stock-hub-connections", "position": {"x": 500, "y": 200}}
  ],
  "variables": [
    {"id": "var-node-addition-rate", "name": "Node Addition Rate", "equation": "1", "position": {"x": 200, "y": 100}},
    {"id": "var-edges-per-node", "name": "Edges Per Node", "equation": "3", "position": {"x": 400, "y": 100}},
    {"id": "var-average-degree", "name": "Average Degree", "equation": "2 * Total_Edges / Total_Nodes", "position": {"x": 600, "y": 100}},
    {"id": "var-clustering-coefficient", "name": "Clustering Coefficient", "equation": "LN(Total_Nodes) ^ 2 / Total_Nodes", "position": {"x": 200, "y": 300}},
    {"id": "var-hub-degree", "name": "Hub Degree", "equation": "Hub_Connections", "position": {"x": 400, "y": 300}},
    {"id": "var-max-expected-degree", "name": "Max Expected Degree", "equation": "Edges_Per_Node * SQRT(Total_Nodes)", "position": {"x": 600, "y": 300}},
    {"id": "var-power-law-exponent", "name": "Power Law Exponent", "equation": "3", "position": {"x": 300, "y": 400}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 1000, "dt": 1},
  "source": "https://doi.org/10.1126/science.286.5439.509",
  "reference": "Barabási AL, Albert R. Emergence of Scaling in Random Networks. Science. 1999;286(5439):509-512."
}
