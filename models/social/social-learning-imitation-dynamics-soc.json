{
  "id": "social-learning-imitation-dynamics-soc",
  "name": "Social Learning and Imitation Model",
  "description": "Model of how behaviors spread through observation and imitation. Source: Bandura (1977), Social Learning Theory.",
  "stocks": [
    {
      "id": "s1",
      "name": "Adopters",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Non_Adopters",
      "initial_value": 900,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Adoption",
      "equation": "Imitation_Rate * Non_Adopters * Adopters / Total_Pop",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Abandonment",
      "equation": "Forgetting_Rate * Adopters",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Base_Imitation_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Social_Proof",
      "equation": "Adopters / Total_Pop",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Imitation_Rate",
      "equation": "Base_Imitation_Rate * (1 + 2 * Social_Proof)",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Forgetting_Rate",
      "equation": "0.01",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Total_Pop",
      "equation": "Adopters + Non_Adopters",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Adopters",
      "to_element": "Social_Proof"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-15T14:43:05.813104+00:00",
  "updated_at": "2026-01-15T14:43:05.813109+00:00",
  "source": "https://doi.org/10.1016/0749-5978(91)90037-T",
  "reference": "Bandura, A. (1977). Social Learning Theory. Prentice Hall."
}