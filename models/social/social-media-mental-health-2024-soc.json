{
  "id": "social-media-mental-health-2024-soc",
  "name": "Social Media and Mental Health Dynamics 2024",
  "description": "Updated model of social media usage impacts on mental health, incorporating recent research on adolescent vulnerability. Source: Twenge et al., Clinical Psychological Science; Haidt (2024).",
  "stocks": [
    {
      "id": "stock-usage",
      "name": "Daily_Screen_Time",
      "initial_value": 3,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-mental",
      "name": "Mental_Health_Index",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-sleep",
      "name": "Sleep_Quality",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "stock-social",
      "name": "In_Person_Social",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-usageinc",
      "name": "Usage_Increase",
      "equation": "Engagement_Rate * (Max_Usage - Daily_Screen_Time)",
      "from_stock": null,
      "to_stock": "stock-usage",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-usagedec",
      "name": "Usage_Reduction",
      "equation": "Daily_Screen_Time * Awareness_Effect * Mental_Health_Index / 100",
      "from_stock": "stock-usage",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-mentalinc",
      "name": "Mental_Recovery",
      "equation": "Base_Recovery * Sleep_Quality / 80 * In_Person_Social / 60",
      "from_stock": null,
      "to_stock": "stock-mental",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-mentaldec",
      "name": "Mental_Decline",
      "equation": "Screen_Impact * Daily_Screen_Time * Comparison_Effect",
      "from_stock": "stock-mental",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-sleepinc",
      "name": "Sleep_Improvement",
      "equation": "(100 - Sleep_Quality) * 0.1",
      "from_stock": null,
      "to_stock": "stock-sleep",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "flow-sleepdec",
      "name": "Sleep_Disruption",
      "equation": "Daily_Screen_Time * Blue_Light_Effect",
      "from_stock": "stock-sleep",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-socialinc",
      "name": "Social_Connection",
      "equation": "(80 - In_Person_Social) * 0.05",
      "from_stock": null,
      "to_stock": "stock-social",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "flow-socialdec",
      "name": "Social_Displacement",
      "equation": "Daily_Screen_Time * Displacement_Rate",
      "from_stock": "stock-social",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-engage",
      "name": "Engagement_Rate",
      "equation": "0.1",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-max",
      "name": "Max_Usage",
      "equation": "8",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-aware",
      "name": "Awareness_Effect",
      "equation": "0.02",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-recover",
      "name": "Base_Recovery",
      "equation": "2",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-impact",
      "name": "Screen_Impact",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-compare",
      "name": "Comparison_Effect",
      "equation": "1.5",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "var-blue",
      "name": "Blue_Light_Effect",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "var-displace",
      "name": "Displacement_Rate",
      "equation": "2",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 52,
    "dt": 0.25
  },
  "created_at": "2026-01-12T12:41:31.049432+00:00",
  "updated_at": "2026-01-12T12:41:31.049432+00:00",
  "source": "https://doi.org/10.1016/S0140-6736(21)02143-7",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}