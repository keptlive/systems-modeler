{
  "id": "social-media-misinformation-soc",
  "name": "Social Media Misinformation Model",
  "description": "A model of how misinformation spreads through social networks, including fact-checking and belief revision dynamics. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1126/science.aap9559",
  "reference": "Vosoughi S, Roy D, Aral S. The spread of true and false news online. Science. 2018;359(6380):1146-1151.",
  "stocks": [
    {
      "id": "stock-uninformed",
      "name": "Uninformed",
      "initial_value": 900000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-misinformed",
      "name": "Misinformed",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-informed",
      "name": "Correctly Informed",
      "initial_value": 99000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-misinfo-spread",
      "name": "Misinformation Spread",
      "equation": "Uninformed * Viral_Factor * Misinformed / Total_Pop",
      "from_stock": "stock-uninformed",
      "to_stock": "stock-misinformed",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-correct-info",
      "name": "Correct Info Spread",
      "equation": "Uninformed * Info_Spread_Rate * Correctly_Informed / Total_Pop",
      "from_stock": "stock-uninformed",
      "to_stock": "stock-informed",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-correction",
      "name": "Belief Correction",
      "equation": "Misinformed * Correction_Rate * Fact_Check_Exposure",
      "from_stock": "stock-misinformed",
      "to_stock": "stock-informed",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-forgetting",
      "name": "Forgetting",
      "equation": "Correctly_Informed * Forgetting_Rate",
      "from_stock": "stock-informed",
      "to_stock": "stock-uninformed",
      "position": {
        "x": 300,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-total",
      "name": "Total Pop",
      "equation": "Uninformed + Misinformed + Correctly_Informed",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-viral",
      "name": "Viral Factor",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-info-spread",
      "name": "Info Spread Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-correction",
      "name": "Correction Rate",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-fact-check",
      "name": "Fact Check Exposure",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-forget",
      "name": "Forgetting Rate",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-11T21:48:31.738280+00:00",
  "updated_at": "2026-01-11T21:48:31.738280+00:00"
}