{
  "id": "preferential-attachment-network-soc",
  "name": "Preferential Attachment Network Growth",
  "description": "Models scale-free network formation through preferential attachment. Source: Barabasi & Albert (1999), Science. DOI: 10.1126/science.286.5439.509",
  "stocks": [
    {
      "id": "stock-nodes",
      "name": "Total_Nodes",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-edges",
      "name": "Total_Edges",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-maxdeg",
      "name": "Max_Degree",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 350,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-nodegrow",
      "name": "Node_Addition",
      "equation": "Node_Addition_Rate",
      "from_stock": null,
      "to_stock": "stock-nodes",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-edgegrow",
      "name": "Edge_Addition",
      "equation": "Node_Addition_Rate * Edges_Per_New_Node",
      "from_stock": null,
      "to_stock": "stock-edges",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "flow-maxgrow",
      "name": "Max_Degree_Growth",
      "equation": "Preferential_Growth_Rate * LN(Total_Nodes)",
      "from_stock": null,
      "to_stock": "stock-maxdeg",
      "position": {
        "x": 250,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-addrate",
      "name": "Node_Addition_Rate",
      "equation": "1",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-edgesper",
      "name": "Edges_Per_New_Node",
      "equation": "3",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-prefgrow",
      "name": "Preferential_Growth_Rate",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-avgdeg",
      "name": "Average_Degree",
      "equation": "2 * Total_Edges / Total_Nodes",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-clustering",
      "name": "Clustering_Coefficient",
      "equation": "1 / LN(Total_Nodes)",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-scalefree",
      "name": "Power_Law_Exponent",
      "equation": "3",
      "position": {
        "x": 250,
        "y": 325
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Total_Nodes",
      "to_element": "Max_Degree_Growth"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 1000,
    "dt": 1
  },
  "created_at": "2026-01-12T02:17:16.214187+00:00",
  "updated_at": "2026-01-12T02:17:16.214190+00:00",
  "source": "https://doi.org/10.1126/science.286.5439.509",
  "reference": "Barabasi, A.L. & Albert, R. (1999). Emergence of Scaling in Random Networks. Science."
}