{
  "id": "habit-formation-dynamics-soc",
  "name": "Habit Formation Cue-Action Model",
  "description": "Model of habit formation. Source: Wood & Runger (2016), Annual Review of Psychology.",
  "stocks": [
    {
      "id": "stock-habit",
      "name": "Habit_Strength",
      "initial_value": 0,
