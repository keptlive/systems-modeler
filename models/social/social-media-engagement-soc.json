{
  "id": "social-media-engagement-soc",
  "name": "Social Media Engagement Model",
  "description": "Model of user engagement dynamics on social media platforms showing content, attention, and network effects. Reference: Katz, M. L., & Shapiro, C. (1985). Network externalities, competition, and compatibility. AER. Source: https://doi.org/10.2307/1814809",
  "stocks": [
    {
      "id": "stock-users",
      "name": "Active_Users",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-content",
      "name": "Content_Volume",
      "initial_value": 5000000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-engagement",
      "name": "Engagement_Level",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-user-growth",
      "name": "User_Growth",
      "equation": "Active_Users * Network_Effect * Engagement_Level / 100",
      "from_stock": null,
      "to_stock": "stock-users",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-churn",
      "name": "User_Churn",
      "equation": "Active_Users * Base_Churn * (1 - Engagement_Level / 100)",
      "from_stock": "stock-users",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-content-creation",
      "name": "Content_Creation",
      "equation": "Active_Users * Content_Per_User",
      "from_stock": null,
      "to_stock": "stock-content",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-content-decay",
      "name": "Content_Decay",
      "equation": "Content_Volume * Decay_Rate",
      "from_stock": "stock-content",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "flow-engage-change",
      "name": "Engagement_Change",
      "equation": "(Target_Engagement - Engagement_Level) * Adjustment_Rate",
      "from_stock": null,
      "to_stock": "stock-engagement",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "variables": [
    {
      "id": "var-network",
      "name": "Network_Effect",
      "equation": "0.0001",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-churn",
      "name": "Base_Churn",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-content-per",
      "name": "Content_Per_User",
      "equation": "2",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "var-decay",
      "name": "Decay_Rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-target",
      "name": "Target_Engagement",
      "equation": "40 + 30 * Content_Volume / (Content_Volume + 1000000)",
      "position": {
        "x": 450,
        "y": 400
      }
    },
    {
      "id": "var-adjust",
      "name": "Adjustment_Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Active_Users",
      "to_element": "User_Growth"
    },
    {
      "id": "c2",
      "from_element": "Network_Effect",
      "to_element": "User_Growth"
    },
    {
      "id": "c3",
      "from_element": "Engagement_Level",
      "to_element": "User_Growth"
    },
    {
      "id": "c4",
      "from_element": "Active_Users",
      "to_element": "User_Churn"
    },
    {
      "id": "c5",
      "from_element": "Base_Churn",
      "to_element": "User_Churn"
    },
    {
      "id": "c6",
      "from_element": "Engagement_Level",
      "to_element": "User_Churn"
    },
    {
      "id": "c7",
      "from_element": "Active_Users",
      "to_element": "Content_Creation"
    },
    {
      "id": "c8",
      "from_element": "Content_Per_User",
      "to_element": "Content_Creation"
    },
    {
      "id": "c9",
      "from_element": "Content_Volume",
      "to_element": "Content_Decay"
    },
    {
      "id": "c10",
      "from_element": "Decay_Rate",
      "to_element": "Content_Decay"
    },
    {
      "id": "c11",
      "from_element": "Target_Engagement",
      "to_element": "Engagement_Change"
    },
    {
      "id": "c12",
      "from_element": "Engagement_Level",
      "to_element": "Engagement_Change"
    },
    {
      "id": "c13",
      "from_element": "Adjustment_Rate",
      "to_element": "Engagement_Change"
    }
  ],
