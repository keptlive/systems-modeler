{
  "id": "trust-social-capital-soc",
  "name": "Trust and Social Capital Model",
  "description": "Models dynamics of social trust and its effects on cooperation. Based on Putnam (2000) and Coleman (1988). DOI: 10.1086/228943",
  "stocks": [
    {
      "id": "stock-trust",
      "name": "Generalized_Trust",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-networks",
      "name": "Social_Networks",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-norms",
      "name": "Cooperative_Norms",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "stock-civic",
      "name": "Civic_Participation",
      "initial_value": 40,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-trustbuild",
      "name": "Trust_Building",
      "equation": "Social_Networks * Network_Effect + Cooperative_Norms * Norm_Effect",
      "from_stock": null,
      "to_stock": "stock-trust",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-trusterode",
      "name": "Trust_Erosion",
      "equation": "Generalized_Trust * Erosion_Rate * (1 + Inequality_Effect)",
      "from_stock": "stock-trust",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-netform",
      "name": "Network_Formation",
      "equation": "Civic_Participation * Network_Formation_Rate",
      "from_stock": null,
      "to_stock": "stock-networks",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-netdecay",
      "name": "Network_Decay",
      "equation": "Social_Networks * Network_Decay_Rate",
      "from_stock": "stock-networks",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-normbuild",
      "name": "Norm_Reinforcement",
      "equation": "Generalized_Trust * Social_Networks / 1000 * Norm_Building_Rate",
      "from_stock": null,
      "to_stock": "stock-norms",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-normdecay",
      "name": "Norm_Decay",
      "equation": "Cooperative_Norms * Norm_Decay_Rate",
      "from_stock": "stock-norms",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "flow-civicchange",
      "name": "Civic_Change",
      "equation": "(Generalized_Trust * Trust_Civic_Effect + Social_Networks * Network_Civic_Effect - Civic_Participation) * 0.1",
      "from_stock": null,
      "to_stock": "stock-civic",
      "position": {
        "x": 300,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-neteffect",
      "name": "Network_Effect",
      "equation": "0.01",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-normeffect",
      "name": "Norm_Effect",
      "equation": "0.02",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-erosrate",
      "name": "Erosion_Rate",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-ineqeffect",
      "name": "Inequality_Effect",
      "equation": "0.3",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-netformrate",
      "name": "Network_Formation_Rate",
      "equation": "0.05",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "var-netdecayrate",
      "name": "Network_Decay_Rate",
      "equation": "0.03",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "var-normbuildrate",
      "name": "Norm_Building_Rate",
      "equation": "0.01",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-normdecayrate",
      "name": "Norm_Decay_Rate",
      "equation": "0.02",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "var-trustcivic",
      "name": "Trust_Civic_Effect",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 325
      }
    },
    {
      "id": "var-netcivic",
      "name": "Network_Civic_Effect",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 325
      }
    },
    {
      "id": "var-socapital",
      "name": "Social_Capital_Index",
      "equation": "(Generalized_Trust + Social_Networks + Cooperative_Norms) / 3",
      "position": {
        "x": 300,
        "y": 375
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Generalized_Trust",
      "to_element": "Trust_Building"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:55:29.074422+00:00",
  "updated_at": "2026-01-12T02:55:29.074430+00:00",
  "source": "https://doi.org/10.1086/228943",
  "reference": "Coleman JS (1988). Social Capital in the Creation of Human Capital. AJS. Also: Putnam RD (2000). Bowling Alone."
}