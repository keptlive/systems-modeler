{
  "id": "schelling-segregation-model-soc",
  "name": "Schelling Segregation Model",
  "description": "Thomas Schelling's 1971 dynamic model of racial segregation showing how mild individual preferences for neighbors of the same type can lead to complete segregation. A foundational model in agent-based dynamics that won Schelling the Nobel Prize. Reference: Schelling, T. C. (1971). Dynamic models of segregation. Journal of Mathematical Sociology, 1(2), 143-186. DOI: https://doi.org/10.1080/0022250X.1971.9989794",
  "stocks": [
    {
      "id": "stock-integrated-neighborhood",
      "name": "Integrated Neighborhoods",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-segregated-a",
      "name": "Segregated Type A",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "stock-segregated-b",
      "name": "Segregated Type B",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-to-segregated-a",
      "name": "Migration to A Areas",
      "equation": "Integrated_Neighborhoods * Dissatisfaction_Rate_A * Preference_Threshold",
      "from_stock": "stock-integrated-neighborhood",
      "to_stock": "stock-segregated-a",
      "position": {
        "x": 250,
        "y": 275
      }
    },
    {
      "id": "flow-to-segregated-b",
      "name": "Migration to B Areas",
      "equation": "Integrated_Neighborhoods * Dissatisfaction_Rate_B * Preference_Threshold",
      "from_stock": "stock-integrated-neighborhood",
      "to_stock": "stock-segregated-b",
      "position": {
        "x": 450,
        "y": 275
      }
    },
    {
      "id": "flow-reintegration",
      "name": "Reintegration",
      "equation": "(Segregated_Type_A + Segregated_Type_B) * Mobility_Rate * (1 - Preference_Threshold)",
      "from_stock": null,
      "to_stock": "stock-integrated-neighborhood",
      "position": {
        "x": 350,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "var-preference-threshold",
      "name": "Preference Threshold",
      "equation": "0.3",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-dissatisfaction-rate-a",
      "name": "Dissatisfaction Rate A",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "var-dissatisfaction-rate-b",
      "name": "Dissatisfaction Rate B",
      "equation": "0.1",
      "position": {
        "x": 600,
        "y": 250
      }
    },
    {
      "id": "var-mobility-rate",
      "name": "Mobility Rate",
      "equation": "0.05",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-segregation-index",
      "name": "Segregation Index",
      "equation": "(Segregated_Type_A + Segregated_Type_B) / (Integrated_Neighborhoods + Segregated_Type_A + Segregated_Type_B)",
      "position": {
        "x": 350,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Preference Threshold",
      "to_element": "Migration to A Areas"
    },
    {
      "id": "conn-2",
      "from_element": "Preference Threshold",
      "to_element": "Migration to B Areas"
    },
    {
      "id": "conn-3",
      "from_element": "Integrated Neighborhoods",
      "to_element": "Segregation Index"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-12T01:30:00.000Z",
  "updated_at": "2026-01-12T01:30:00.000Z",
  "source": "https://doi.org/10.1080/0022250X.1971.9989794",
  "reference": "Schelling TC. Dynamic Models of Segregation. Journal of Mathematical Sociology. 1971;1(2):143-186. Nobel Prize in Economics 2005."
}