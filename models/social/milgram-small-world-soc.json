{
  "id": "milgram-small-world-soc",
  "name": "Illustrative Logistic Network Reach (Milgram Context)",
  "description": "Illustrative continuous logistic network-reach experiment, conceptually associated with Milgram small-world studies. This generated logistic ODE is not a reconstruction of the 1967 acquaintance-chain experiment. People_Reached obeys dP/dt=50*P*(1-P/300000000). The legacy Chain_Steps stock integrates elapsed model time while reach is below half the population; it is not a count of discrete acquaintance links. Avg_Path_Length and Steps_Remaining are retained heuristic logarithmic quantities. Explicit RK4 DT 0.0025 resolves the logistic transition over the unchanged full 10-unit horizon. Default/half/quarter grids fit the work budget and agree with the exact logistic solution; threshold-duration error is bounded by half a timestep, with nonmonotone grid-phase error. No empirical calibration or native Milgram simulation is claimed.",
  "stocks": [
    {
      "id": "stock-reached",
      "name": "People_Reached",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-steps",
      "name": "Chain_Steps",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-spread",
      "name": "Network_Spread",
      "equation": "People_Reached * branching_factor * (1 - People_Reached / population)",
      "from_stock": null,
      "to_stock": "stock-reached",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-step",
      "name": "Step_Count",
      "equation": "IF(People_Reached < target_reached, 1, 0)",
      "from_stock": null,
      "to_stock": "stock-steps",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-pop",
      "name": "population",
      "equation": "300000000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-branch",
      "name": "branching_factor",
      "equation": "50",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-target",
      "name": "target_reached",
      "equation": "population * 0.5",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-coverage",
      "name": "Network_Coverage",
      "equation": "People_Reached / population",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-remaining",
      "name": "Steps_Remaining",
      "equation": "ln(population / People_Reached) / ln(branching_factor)",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-avg-path",
      "name": "Avg_Path_Length",
      "equation": "ln(population) / ln(branching_factor)",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-clustering",
      "name": "clustering_coefficient",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 100
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "People_Reached",
      "to_element": "Network_Spread"
    },
    {
      "id": "conn-2",
      "from_element": "branching_factor",
      "to_element": "Network_Spread"
    },
    {
      "id": "conn-3",
      "from_element": "population",
      "to_element": "Network_Coverage"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 10,
    "dt": 0.0025,
    "integration_method": "rk4"
  },
  "source": "https://doi.org/10.1037/e400002009-005",
  "reference": "Milgram, S. (1967), The small-world problem. Psychology Today, inaugural issue. PsycEXTRA DOI 10.1037/e400002009-005 identifies the original article; conceptual context only, not a native logistic simulation."
}
