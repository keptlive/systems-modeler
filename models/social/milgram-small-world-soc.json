{
  "id": "milgram-small-world-soc",
  "name": "Milgram Small World Network",
  "description": "Stanley Milgram's 1967 'six degrees of separation' experiment showing social networks have small average path lengths despite large size. Reference: Milgram, S. (1967). The Small World Problem. Psychology Today, 2(1), 60-67. Source: https://doi.org/10.1037/e400002009-005",
  "stocks": [
    {
      "id": "stock-reached",
      "name": "People_Reached",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-steps",
      "name": "Chain_Steps",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-spread",
      "name": "Network_Spread",
      "equation": "People_Reached * branching_factor * (1 - People_Reached / population)",
      "from_stock": null,
      "to_stock": "stock-reached",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-step",
      "name": "Step_Count",
      "equation": "IF(People_Reached < target_reached, 1, 0)",
      "from_stock": null,
      "to_stock": "stock-steps",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-pop",
      "name": "population",
      "equation": "300000000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-branch",
      "name": "branching_factor",
      "equation": "50",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-target",
      "name": "target_reached",
      "equation": "population * 0.5",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-coverage",
      "name": "Network_Coverage",
      "equation": "People_Reached / population",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-remaining",
      "name": "Steps_Remaining",
      "equation": "ln(population / People_Reached) / ln(branching_factor)",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-avg-path",
      "name": "Avg_Path_Length",
      "equation": "ln(population) / ln(branching_factor)",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-clustering",
      "name": "clustering_coefficient",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 100
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "People_Reached",
      "to_element": "Network_Spread"
    },
    {
      "id": "conn-2",
      "from_element": "branching_factor",
      "to_element": "Network_Spread"
    },
    {
      "id": "conn-3",
      "from_element": "population",
      "to_element": "Network_Coverage"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 10,
    "dt": 1
  },
  "source": "https://doi.org/10.1037/h0024480",
  "reference": "Milgram S. The Small World Problem. Psychology Today. 1967;1(1):61-67."
}