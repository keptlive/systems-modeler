{
  "id": "urban-bike-share-soc",
  "name": "Urban Bike Share System Dynamics",
  "description": "Model of bike share system usage and rebalancing. Captures station demand patterns, bike availability, and fleet management. Based on urban transportation and operations research. Reference: Bureau of Transportation Statistics. Source: https://www.bts.gov/",
  "stocks": [
    {
      "id": "s1",
      "name": "Bikes_At_Stations",
      "initial_value": 3000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Bikes_In_Use",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Bikes_In_Rebalancing",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Unmet_Demand",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Rentals",
      "equation": "MIN(Bikes_At_Stations, Demand * Service_Rate)",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Returns",
      "equation": "Bikes_In_Use / Average_Trip_Duration",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 250,
        "y": 270
      }
    },
    {
      "id": "f3",
      "name": "Pickup_For_Rebalancing",
      "equation": "Rebalancing_Rate * Station_Imbalance",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Rebalancing_Delivery",
      "equation": "Bikes_In_Rebalancing / Rebalancing_Time",
      "from_stock": "s3",
      "to_stock": "s1",
      "position": {
        "x": 350,
        "y": 280
      }
    },
    {
      "id": "f5",
      "name": "Demand_Gap",
      "equation": "MAX(0, Demand - Rentals)",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "f6",
      "name": "Demand_Clearance",
      "equation": "Unmet_Demand * 0.9",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 430
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Base_Demand",
      "equation": "1000",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "v2",
      "name": "Time_of_Day_Factor",
      "equation": "1 + 0.5 * SIN(Time * 2 * 3.14159 / 24)",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "v3",
      "name": "Demand",
      "equation": "Base_Demand * Time_of_Day_Factor * Weather_Factor",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "v4",
      "name": "Weather_Factor",
      "equation": "0.9",
      "position": {
        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v5",
      "name": "Average_Trip_Duration",
      "equation": "0.5",
      "position": {
        "x": 250,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "Service_Rate",
      "equation": "Bikes_At_Stations / (Bikes_At_Stations + 100)",
      "position": {
        "x": 450,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Station_Imbalance",
      "equation": "ABS(Bikes_At_Stations - 3000) / 3000",
      "position": {
        "x": 150,
        "y": 180
      }
    },
    {
      "id": "v8",
      "name": "Rebalancing_Rate",
      "equation": "50",
      "position": {
        "x": 350,
        "y": 180
      }
    },
    {
      "id": "v9",
      "name": "Rebalancing_Time",
      "equation": "2",
      "position": {
        "x": 500,
        "y": 180
      }
    },
    {
      "id": "v10",
      "name": "Fleet_Utilization",
      "equation": "Bikes_In_Use / (Bikes_At_Stations + Bikes_In_Use + Bikes_In_Rebalancing)",
      "position": {
        "x": 300,
        "y": 230
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 168,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1016/j.trb.2013.06.002",
  "reference": "Fishman E et al. (2013) Bike Share: A Synthesis of the Literature. Transport Reviews.",
  "created_at": "2026-01-12T07:04:13.444157+00:00",
  "updated_at": "2026-01-12T07:04:13.444157+00:00"
}