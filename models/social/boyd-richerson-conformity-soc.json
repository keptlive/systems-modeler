{
  "id": "boyd-richerson-conformity-soc",
  "name": "Boyd-Richerson Conformity Bias",
  "description": "Cultural evolution with conformist transmission. Individuals preferentially copy common behaviors, accelerating convergence. Explains cultural group selection and between-group variation. Reference: Fisher, R. A. (1930). The Genetical Theory of Natural Selection. Oxford University Press. Source: https://doi.org/10.5962/bhl.title.27468",
  "stocks": [
    {
      "id": "stock-trait-a",
      "name": "Trait A Frequency",
      "initial_value": 0.4,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-frequency-change",
      "name": "Frequency Change",
      "equation": "Conformity_Effect + Selection_Effect",
      "from_stock": null,
      "to_stock": "stock-trait-a",
      "position": {
        "x": 150,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-trait-b",
      "name": "Trait B Frequency",
      "equation": "1 - Trait_A_Frequency",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-conformity",
      "name": "Conformity Effect",
      "equation": "Conformity_Strength * Trait_A_Frequency * Trait_B_Frequency * (Trait_A_Frequency - 0.5)",
      "position": {
        "x": 350,
        "y": 80
      }
    },
    {
      "id": "var-selection",
      "name": "Selection Effect",
      "equation": "Selection_Coefficient * Trait_A_Frequency * Trait_B_Frequency * (Fitness_A - Fitness_B) / Mean_Fitness",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-conform-strength",
      "name": "Conformity Strength",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-selection-coeff",
      "name": "Selection Coefficient",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-fitness-a",
      "name": "Fitness A",
      "equation": "1.0",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-fitness-b",
      "name": "Fitness B",
      "equation": "1.0",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "var-mean-fitness",
      "name": "Mean Fitness",
      "equation": "Trait_A_Frequency * Fitness_A + Trait_B_Frequency * Fitness_B",
      "position": {
        "x": 300,
        "y": 450
      }
    },
    {
      "id": "var-equilibrium",
      "name": "Stable Equilibrium",
      "equation": "IF(Conformity_Strength > 0, 0.5, Fitness_A / (Fitness_A + Fitness_B))",
      "position": {
        "x": 500,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Trait A Frequency",
      "to_element": "Conformity Effect"
    },
    {
      "id": "conn-2",
      "from_element": "Trait B Frequency",
      "to_element": "Conformity Effect"
    },
    {
      "id": "conn-3",
      "from_element": "Trait A Frequency",
      "to_element": "Selection Effect"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-12T07:39:15.418145+00:00",
  "updated_at": "2026-01-12T07:39:15.418155+00:00",
  "source": "https://doi.org/10.1086/285043",
  "reference": "Boyd R, Richerson PJ. Culture and the Evolutionary Process. University of Chicago Press. 1985."
}