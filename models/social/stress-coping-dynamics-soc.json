{
  "id": "stress-coping-dynamics-soc",
  "name": "Stress and Coping Dynamics",
  "description": "Model of stress appraisal and coping. Source: Lazarus & Folkman (1984), Stress, Appraisal, and Coping.",
  "stocks": [
    {
      "id": "stock-stress",
      "name": "Perceived_Stress",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-coping",
      "name": "Coping_Resources",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-stressor",
      "name": "Stressor_Exposure",
      "equation": "Stressor_Rate * (1 - Coping_Resources / 100)",
      "from_stock": null,
      "to_stock": "stock-stress",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-adapt",
      "name": "Adaptation",
      "equation": "Perceived_Stress * Adaptation_Rate",
      "from_stock": "stock-stress",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-build",
      "name": "Resource_Building",
      "equation": "Resource_Rate * (100 - Coping_Resources) / 100",
      "from_stock": null,
      "to_stock": "stock-coping",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "flow-deplete",
      "name": "Resource_Depletion",
      "equation": "Coping_Resources * Depletion_Rate * Perceived_Stress / 100",
      "from_stock": "stock-coping",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-stressor",
      "name": "Stressor_Rate",
      "equation": "5",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-adapt",
      "name": "Adaptation_Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-resource",
      "name": "Resource_Rate",
      "equation": "3",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-deplete",
      "name": "Depletion_Rate",
      "equation": "0.02",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T12:53:13.193450+00:00",
  "updated_at": "2026-01-12T12:53:13.193450+00:00",
  "source": "https://systemdynamics.org/resources/",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}