{
  "id": "opinion-dynamics-and-polarization-model-soc",
  "name": "Opinion Dynamics and Polarization Model",
  "description": "Models the formation and evolution of public opinion, including social influence, media effects, confirmation bias, and polarization dynamics. Based on bounded confidence and social influence models. Reference: Fisher, R. A. (1930). The Genetical Theory of Natural Selection. Oxford University Press. Source: https://doi.org/10.5962/bhl.title.27468",
  "stocks": [
    {
      "id": "stock-progressive-population",
      "name": "Progressive Population",
      "initial_value": 200000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-moderate-population",
      "name": "Moderate Population",
      "initial_value": 600000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-conservative-population",
      "name": "Conservative Population",
      "initial_value": 200000,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-media-polarization-index",
      "name": "Media Polarization Index",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 750,
        "y": 200
      }
    },
    {
      "id": "stock-social-trust-level",
      "name": "Social Trust Level",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 150,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-shift-to-progressive",
      "name": "Shift to Progressive",
      "equation": "Moderate_Population * Progressive_Influence_Rate",
      "from_stock": "stock-moderate-population",
      "to_stock": "stock-progressive-population",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-shift-from-progressive",
      "name": "Shift from Progressive",
      "equation": "Progressive_Population * Moderation_Rate",
      "from_stock": "stock-progressive-population",
      "to_stock": "stock-moderate-population",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-shift-to-conservative",
      "name": "Shift to Conservative",
      "equation": "Moderate_Population * Conservative_Influence_Rate",
      "from_stock": "stock-moderate-population",
      "to_stock": "stock-conservative-population",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-shift-from-conservative",
      "name": "Shift from Conservative",
      "equation": "Conservative_Population * Moderation_Rate",
      "from_stock": "stock-conservative-population",
      "to_stock": "stock-moderate-population",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-polarization-increase",
      "name": "Polarization Increase",
      "equation": "(Target_Polarization - Media_Polarization) * Polarization_Adjustment_Rate * IF Target_Polarization > Media_Polarization THEN 1 ELSE 0",
      "from_stock": null,
      "to_stock": "stock-media-polarization-index",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "flow-polarization-decrease",
      "name": "Polarization Decrease",
      "equation": "(Media_Polarization - Target_Polarization) * Polarization_Adjustment_Rate * IF Target_Polarization < Media_Polarization THEN 1 ELSE 0",
      "from_stock": "stock-media-polarization-index",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 350
      }
    },
    {
      "id": "flow-trust-building",
      "name": "Trust Building",
      "equation": "(100 - Social_Trust) * Trust_Building_Rate * Cross_Group_Interaction",
      "from_stock": null,
      "to_stock": "stock-social-trust-level",
      "position": {
        "x": 250,
        "y": 500
      }
    },
    {
      "id": "flow-trust-erosion",
      "name": "Trust Erosion",
      "equation": "Social_Trust * Trust_Erosion_Rate * Polarization_Index / 50",
      "from_stock": "stock-social-trust-level",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 500
      }
    }
  ],
  "variables": [
    {
      "id": "var-total-population",
      "name": "Total Population",
      "equation": "Progressive_Population + Moderate_Population + Conservative_Population",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-progressive-fraction",
      "name": "Progressive Fraction",
      "equation": "Progressive_Population / Total_Population",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-conservative-fraction",
      "name": "Conservative Fraction",
      "equation": "Conservative_Population / Total_Population",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-moderate-fraction",
      "name": "Moderate Fraction",
      "equation": "Moderate_Population / Total_Population",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-polarization-index",
      "name": "Polarization Index",
      "equation": "(Progressive_Fraction + Conservative_Fraction - Moderate_Fraction) * 100",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-progressive-influence-rate",
      "name": "Progressive Influence Rate",
      "equation": "Base_Influence_Rate * Progressive_Fraction * (1 + Media_Progressive_Bias) * Social_Media_Amplification",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-conservative-influence-rate",
      "name": "Conservative Influence Rate",
      "equation": "Base_Influence_Rate * Conservative_Fraction * (1 + Media_Conservative_Bias) * Social_Media_Amplification",
      "position": {
        "x": 250,
        "y": 160
      }
    },
    {
      "id": "var-base-influence-rate",
      "name": "Base Influence Rate",
      "equation": "0.001",
      "position": {
        "x": 400,
        "y": 160
      }
    },
    {
      "id": "var-moderation-rate",
      "name": "Moderation Rate",
      "equation": "Base_Moderation_Rate * Moderate_Fraction * Social_Trust / 100",
      "position": {
        "x": 550,
        "y": 160
      }
    },
    {
      "id": "var-base-moderation-rate",
      "name": "Base Moderation Rate",
      "equation": "0.0005",
      "position": {
        "x": 700,
        "y": 160
      }
    },
    {
      "id": "var-media-progressive-bias",
      "name": "Media Progressive Bias",
      "equation": "Media_Polarization / 100 * 0.5",
      "position": {
        "x": 100,
        "y": 240
      }
    },
    {
      "id": "var-media-conservative-bias",
      "name": "Media Conservative Bias",
      "equation": "Media_Polarization / 100 * 0.5",
      "position": {
        "x": 250,
        "y": 240
      }
    },
    {
      "id": "var-social-media-amplification",
      "name": "Social Media Amplification",
      "equation": "1 + Algorithm_Engagement_Bias * Echo_Chamber_Effect",
      "position": {
        "x": 400,
        "y": 240
      }
    },
    {
      "id": "var-algorithm-engagement-bias",
      "name": "Algorithm Engagement Bias",
      "equation": "0.5",
      "position": {
        "x": 550,
        "y": 240
      }
    },
    {
      "id": "var-echo-chamber-effect",
      "name": "Echo Chamber Effect",
      "equation": "1 + 0.5 * (1 - Moderate_Fraction)",
      "position": {
        "x": 700,
        "y": 240
      }
    },
    {
      "id": "var-target-polarization",
      "name": "Target Polarization",
      "equation": "30 + 40 * (1 - Moderate_Fraction)",
      "position": {
        "x": 100,
        "y": 320
      }
    },
    {
      "id": "var-polarization-adjustment-rate",
      "name": "Polarization Adjustment Rate",
      "equation": "0.05",
      "position": {
        "x": 250,
        "y": 320
      }
    },
    {
      "id": "var-cross-group-interaction",
      "name": "Cross Group Interaction",
      "equation": "2 * Progressive_Fraction * Conservative_Fraction + Moderate_Fraction",
      "position": {
        "x": 400,
        "y": 320
      }
    },
    {
      "id": "var-trust-building-rate",
      "name": "Trust Building Rate",
      "equation": "0.001",
      "position": {
        "x": 550,
        "y": 320
      }
    },
    {
      "id": "var-trust-erosion-rate",
      "name": "Trust Erosion Rate",
      "equation": "0.002",
      "position": {
        "x": 700,
        "y": 320
      }
    },
    {
      "id": "var-democratic-health-index",
      "name": "Democratic Health Index",
      "equation": "Moderate_Fraction * 100 + Social_Trust - Media_Polarization",
      "position": {
        "x": 100,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-11T20:04:50.860321Z",
  "updated_at": "2026-01-11T20:04:50.860321Z",
  "source": "https://doi.org/10.1016/j.socnet.2007.04.006",
  "reference": "Social Network Analysis and System Dynamics Models"
}