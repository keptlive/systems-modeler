{
  "id": "democratic-backsliding-soc",
  "name": "Democratic Backsliding Dynamics",
  "description": "Model of gradual erosion of democratic institutions. Captures the feedback between executive power accumulation, institutional resistance, and civil society response. Based on comparative politics literature on democratic decline. Reference: Andersson, D. I., & Hughes, D. (2014). Microbiological effects of sublethal antibiotic concentrations. Nature Reviews Microbiology. Source: https://doi.org/10.1038/nrmicro3270",
  "stocks": [
    {
      "id": "s1",
      "name": "Democratic_Quality",
      "initial_value": 0.8,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Executive_Power",
      "initial_value": 0.3,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Civil_Society_Strength",
      "initial_value": 0.6,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Institutional_Resistance",
      "initial_value": 0.7,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Democratic_Erosion",
      "equation": "Executive_Power * Erosion_Rate * (1 - Institutional_Resistance) - Recovery_Rate * Civil_Society_Strength",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 280
      }
    },
    {
      "id": "f2",
      "name": "Power_Accumulation",
      "equation": "(1 - Democratic_Quality) * Accumulation_Rate * (1 - Civil_Society_Strength)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 350,
        "y": 280
      }
    },
    {
      "id": "f3",
      "name": "Civil_Society_Change",
      "equation": "(Democratic_Quality * Mobilization_Effect - Executive_Power * Repression_Effect - Civil_Society_Strength) / Adjustment_Time",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 280
      }
    },
    {
      "id": "f4",
      "name": "Institution_Change",
      "equation": "(Democratic_Quality - Institutional_Resistance + Civil_Society_Strength * 0.3) / Institution_Time",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 250,
        "y": 430
      }
    }
  ],
  "variables": [
