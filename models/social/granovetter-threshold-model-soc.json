{
  "id": "granovetter-threshold-model-soc",
  "name": "Granovetter Threshold Model",
  "description": "Models collective behavior and cascades based on individual thresholds. Based on Granovetter (1978). DOI: 10.1086/226707",
  "stocks": [
    {
      "id": "stock-adopt",
      "name": "Adopters",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-nonadopt",
      "name": "Non_Adopters",
      "initial_value": 99,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "stock-social",
      "name": "Social_Pressure",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-adoption",
      "name": "Adoption_Rate",
      "equation": "Non_Adopters * Activation_Probability",
      "from_stock": "stock-nonadopt",
      "to_stock": "stock-adopt",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "flow-pressurerise",
      "name": "Pressure_Increase",
      "equation": "(Adopters / Total_Population - Social_Pressure) * Pressure_Adjustment",
      "from_stock": null,
      "to_stock": "stock-social",
      "position": {
        "x": 400,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-totpop",
      "name": "Total_Population",
      "equation": "Adopters + Non_Adopters",
      "position": {
        "x": 150,
        "y": 175
      }
    },
    {
      "id": "var-adoptfrac",
      "name": "Adoption_Fraction",
      "equation": "Adopters / Total_Population",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-actprob",
      "name": "Activation_Probability",
      "equation": "IF(Adoption_Fraction > Average_Threshold, Activation_Rate, 0.001)",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "var-avgthresh",
      "name": "Average_Threshold",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "var-threshvar",
      "name": "Threshold_Variance",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-actrate",
      "name": "Activation_Rate",
      "equation": "0.1 * (1 + Social_Pressure)",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-pressadj",
      "name": "Pressure_Adjustment",
      "equation": "0.2",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-cascade",
      "name": "Cascade_Indicator",
      "equation": "IF(Adopters > 50, 1, 0)",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-critmasss",
      "name": "Critical_Mass",
      "equation": "Total_Population * Average_Threshold",
      "position": {
        "x": 500,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Adopters",
      "to_element": "Adoption_Fraction"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:49:51.600334+00:00",
  "updated_at": "2026-01-12T02:49:51.600342+00:00",
  "source": "https://doi.org/10.1086/226707",
  "reference": "Granovetter M (1978). Threshold Models of Collective Behavior. American Journal of Sociology."
}