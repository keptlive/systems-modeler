{
  "id": "lanchester-combat-soc",
  "name": "Lanchester Combat Dynamics",
  "description": "The classic Lanchester equations for modeling combat between two forces, capturing attrition dynamics and force effectiveness. Foundation of modern operations research in military strategy. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1287/opre.16.5.1050",
  "reference": "Lanchester FW. Aircraft in Warfare: The Dawn of the Fourth Arm. London: Constable. 1916. See also Taylor JG. Lanchester Models of Warfare. Operations Research Society. 1983.",
  "stocks": [
    {
      "id": "stock-red-force",
      "name": "Red Force",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-blue-force",
      "name": "Blue Force",
      "initial_value": 8000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-red-casualties",
      "name": "Red Casualties",
      "equation": "Blue_Effectiveness * Blue_Force",
      "from_stock": "stock-red-force",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-blue-casualties",
      "name": "Blue Casualties",
      "equation": "Red_Effectiveness * Red_Force",
      "from_stock": "stock-blue-force",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "flow-red-reinforcement",
      "name": "Red Reinforcement",
      "equation": "Red_Reinforcement_Rate",
      "from_stock": null,
      "to_stock": "stock-red-force",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-blue-reinforcement",
      "name": "Blue Reinforcement",
      "equation": "Blue_Reinforcement_Rate",
      "from_stock": null,
      "to_stock": "stock-blue-force",
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-red-effect",
      "name": "Red Effectiveness",
      "equation": "0.002",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-blue-effect",
      "name": "Blue Effectiveness",
      "equation": "0.0025",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-red-reinforce",
      "name": "Red Reinforcement Rate",
      "equation": "0",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-blue-reinforce",
      "name": "Blue Reinforcement Rate",
      "equation": "0",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "var-force-ratio",
      "name": "Force Ratio",
      "equation": "Red_Force / MAX(1, Blue_Force)",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "var-combat-power-diff",
      "name": "Combat Power Difference",
      "equation": "Red_Effectiveness * Red_Force^2 - Blue_Effectiveness * Blue_Force^2",
      "position": {
        "x": 350,
        "y": 400
      }
    }
  ],
