{
  "id": "urban-land-use-dynamics-soc",
  "name": "Urban Land Use Dynamics Model",
  "description": "Models urban growth, sprawl, and land use change. Based on Batty (2005). DOI: 10.1016/j.cities.2004.03.004",
  "stocks": [
    {
      "id": "stock-urban",
      "name": "Urban_Land",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-suburban",
      "name": "Suburban_Land",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "stock-rural",
      "name": "Rural_Land",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 175
      }
    },
    {
      "id": "stock-population",
      "name": "Urban_Population",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 100,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-urbanize",
      "name": "Urbanization",
      "equation": "Suburban_Land * Urbanization_Rate * Development_Pressure",
      "from_stock": "stock-suburban",
      "to_stock": "stock-urban",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "flow-sprawl",
      "name": "Suburban_Sprawl",
      "equation": "Rural_Land * Sprawl_Rate * (1 + Transportation_Accessibility)",
      "from_stock": "stock-rural",
      "to_stock": "stock-suburban",
      "position": {
        "x": 400,
        "y": 175
      }
    },
    {
      "id": "flow-infill",
      "name": "Urban_Infill",
      "equation": "Infill_Rate * Redevelopment_Potential",
      "from_stock": null,
      "to_stock": "stock-urban",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-popgrowth",
      "name": "Population_Growth",
      "equation": "Urban_Population * Population_Growth_Rate * Housing_Availability",
      "from_stock": null,
      "to_stock": "stock-population",
      "position": {
        "x": 50,
        "y": 175
      }
    },
    {
      "id": "flow-migration",
      "name": "Net_Migration",
      "equation": "Economic_Opportunity * Migration_Pull - Push_Factors",
      "from_stock": null,
      "to_stock": "stock-population",
      "position": {
        "x": 100,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "var-urbanrate",
      "name": "Urbanization_Rate",
      "equation": "0.02",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-sprawlrate",
      "name": "Sprawl_Rate",
      "equation": "0.01",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-devpressure",
      "name": "Development_Pressure",
      "equation": "Urban_Population / Urban_Land",
      "position": {
        "x": 200,
        "y": 175
      }
    },
    {
      "id": "var-transaccess",
      "name": "Transportation_Accessibility",
      "equation": "0.5 * LN(Urban_Land / 100 + 1)",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "var-infillrate",
      "name": "Infill_Rate",
      "equation": "5",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "var-redevpot",
      "name": "Redevelopment_Potential",
      "equation": "MAX(0, 1 - Urban_Land / 500)",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-popgrowthrate",
      "name": "Population_Growth_Rate",
      "equation": "0.02",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-housingavail",
      "name": "Housing_Availability",
      "equation": "(Urban_Land + Suburban_Land) / (Urban_Population / 100 + 1)",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "var-econopp",
      "name": "Economic_Opportunity",
      "equation": "Urban_Land * 0.1",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-migpull",
      "name": "Migration_Pull",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-pushfact",
      "name": "Push_Factors",
      "equation": "5",
      "position": {
        "x": 150,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Urban_Population",
      "to_element": "Development_Pressure"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-12T02:49:51.599932+00:00",
  "updated_at": "2026-01-12T02:49:51.599940+00:00",
  "source": "https://doi.org/10.1016/j.cities.2004.03.004",
  "reference": "Batty M (2005). Cities and Complexity. MIT Press / DOI: 10.1016/j.cities.2004.03.004"
}