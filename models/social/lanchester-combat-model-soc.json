      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-blueloss",
      "name": "Blue_Attrition",
      "equation": "Blue_Forces * Red_Fire_Rate * Red_Effectiveness * Red_Forces / MAX(1, Blue_Forces)",
