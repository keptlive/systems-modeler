{
  "id": "lanchester-combat-model-soc",
  "name": "Lanchester Combat Dynamics Model",
  "description": "Frederick Lanchester's laws of combat attrition showing force dynamics. Source: Lanchester (1916), Aircraft in Warfare; Taylor (1983), Lanchester Models of Warfare.",
  "stocks": [
    {
      "id": "stock-blue",
      "name": "Blue_Forces",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-red",
      "name": "Red_Forces",
