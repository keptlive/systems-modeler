{
  "id": "malthusian-population-growth-soc",
  "name": "Malthusian Population Model",
  "description": "Thomas Malthus's population model (1798) demonstrating exponential population growth limited by resources. This foundational model in demographics shows how population tends to outstrip food supply. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "source": "https://doi.org/10.2307/1906968",
  "reference": "Malthus TR. An Essay on the Principle of Population. J. Johnson, 1798.",
  "stocks": [
    {
      "id": "stock-pop",
      "name": "Population",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-food",
      "name": "Food Supply",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-births",
      "name": "Births",
      "equation": "Population * Birth_Rate * Food_per_Capita / Subsistence_Level",
      "from_stock": null,
      "to_stock": "stock-pop",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-deaths",
      "name": "Deaths",
      "equation": "Population * Death_Rate * Subsistence_Level / MAX(0.1, Food_per_Capita)",
      "from_stock": "stock-pop",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-food-production",
      "name": "Food Production",
      "equation": "Base_Production * (1 + Agriculture_Growth * TIME)",
      "from_stock": null,
      "to_stock": "stock-food",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-consumption",
      "name": "Consumption",
      "equation": "Population * Consumption_per_Capita",
      "from_stock": "stock-food",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-food-per-capita",
      "name": "Food per Capita",
      "equation": "Food_Supply / Population",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-birth-rate",
      "name": "Birth Rate",
      "equation": "0.03",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-death-rate",
      "name": "Death Rate",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-subsistence",
      "name": "Subsistence Level",
      "equation": "10",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-base-production",
      "name": "Base Production",
      "equation": "100",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-ag-growth",
      "name": "Agriculture Growth",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-consumption-per-capita",
      "name": "Consumption per Capita",
      "equation": "8",
      "position": {
        "x": 600,
        "y": 300
      }
    }
  ],
  "connectors": [],
