{
  "id": "social-media-addiction-soc",
  "name": "Social Media Addiction Dynamics Model",
  "description": "Model of problematic social media use showing engagement loops, mental health effects, and intervention. Reference: Koob, G. F., & Volkow, N. D. (2016). Neurobiology of addiction. Lancet Psychiatry. Source: https://doi.org/10.1016/S2215-0366(16)00104-8",
  "stocks": [
    {
      "id": "s1",
      "name": "Daily_Usage_Hours",
      "initial_value": 2,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Wellbeing_Score",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Addiction_Level",
      "initial_value": 0.2,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Usage_Increase",
      "equation": "Engagement_Pull * (1 - Usage_Saturation)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Usage_Decrease",
      "equation": "Daily_Usage_Hours * Self_Control * Intervention_Effect",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "f3",
      "name": "Wellbeing_Change",
      "equation": "Recovery_Rate - Usage_Impact",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Addiction_Development",
      "equation": "Habituation_Rate * Daily_Usage_Hours - Breaking_Habits",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Engagement_Pull",
      "equation": "0.5 * (1 + Addiction_Level)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Usage_Saturation",
      "equation": "Daily_Usage_Hours / 8",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "v3",
      "name": "Self_Control",
      "equation": "0.1 * Wellbeing_Score / 100",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Intervention_Effect",
      "equation": "1",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Recovery_Rate",
      "equation": "1",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Usage_Impact",
      "equation": "0.5 * Daily_Usage_Hours * Addiction_Level",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Habituation_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Breaking_Habits",
      "equation": "Addiction_Level * 0.05 * Intervention_Effect",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:34:23.558432+00:00",
  "updated_at": "2026-01-12T11:34:23.558432+00:00",
  "source": "https://doi.org/10.1089/cyber.2016.0259",
  "reference": "Andreassen CS, et al. The relationship between addictive use of social media and video games and symptoms of psychiatric disorders. Psychology of Addictive Behaviors. 2016;30(2):252."
}