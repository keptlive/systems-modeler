{
  "id": "trust-in-institutions-soc",
  "name": "Trust in Institutions Model",
  "description": "Model of how public trust in institutions evolves based on performance, transparency, and media coverage. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-trust",
      "name": "Public_Trust",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-performance",
      "name": "Institutional_Performance",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-trust-build",
      "name": "Trust_Building",
      "equation": "Institutional_Performance / 100 * Transparency * Communication_Effect * (100 - Public_Trust) / 100",
      "from_stock": null,
      "to_stock": "stock-trust",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-trust-erode",
      "name": "Trust_Erosion",
      "equation": "Public_Trust * Scandal_Effect * (1 - Transparency) * Erosion_Rate",
      "from_stock": "stock-trust",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-perf-improve",
      "name": "Performance_Improvement",
      "equation": "Investment * Effectiveness * (100 - Institutional_Performance) / 100",
      "from_stock": null,
      "to_stock": "stock-performance",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-perf-decay",
      "name": "Performance_Decay",
      "equation": "Institutional_Performance * Decay_Rate",
      "from_stock": "stock-performance",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-transp",
      "name": "Transparency",
      "equation": "0.6",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-comm",
      "name": "Communication_Effect",
      "equation": "1.2",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-scandal",
      "name": "Scandal_Effect",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-erosion",
      "name": "Erosion_Rate",
      "equation": "0.02",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "var-invest",
      "name": "Investment",
      "equation": "5",
      "position": {
        "x": 150,
        "y": 400
      }
    },
    {
      "id": "var-effect",
      "name": "Effectiveness",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "var-decay",
      "name": "Decay_Rate",
      "equation": "0.01",
      "position": {
        "x": 450,
        "y": 400
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Institutional_Performance",
      "to_element": "Trust_Building"
    },
    {
      "id": "c2",
      "from_element": "Transparency",
      "to_element": "Trust_Building"
    },
    {
      "id": "c3",
      "from_element": "Communication_Effect",
      "to_element": "Trust_Building"
    },
    {
      "id": "c4",
      "from_element": "Public_Trust",
      "to_element": "Trust_Building"
    },
    {
      "id": "c5",
      "from_element": "Public_Trust",
      "to_element": "Trust_Erosion"
    },
    {
      "id": "c6",
      "from_element": "Scandal_Effect",
      "to_element": "Trust_Erosion"
    },
    {
      "id": "c7",
      "from_element": "Transparency",
      "to_element": "Trust_Erosion"
    },
    {
      "id": "c8",
      "from_element": "Erosion_Rate",
      "to_element": "Trust_Erosion"
    },
    {
      "id": "c9",
      "from_element": "Investment",
      "to_element": "Performance_Improvement"
    },
    {
      "id": "c10",
      "from_element": "Effectiveness",
      "to_element": "Performance_Improvement"
    },
    {
      "id": "c11",
      "from_element": "Institutional_Performance",
      "to_element": "Performance_Improvement"
    },
    {
      "id": "c12",
      "from_element": "Institutional_Performance",
      "to_element": "Performance_Decay"
    },
    {
      "id": "c13",
      "from_element": "Decay_Rate",
      "to_element": "Performance_Decay"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 1
  },
