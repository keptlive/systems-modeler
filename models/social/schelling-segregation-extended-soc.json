{
  "id": "schelling-segregation-extended-soc",
  "name": "Schelling Segregation Extended Model",
  "description": "Extended version of Thomas Schelling's neighborhood segregation model showing how mild individual preferences can lead to strong collective segregation patterns. Reference: Schelling, T. C. (1971). Dynamic models of segregation. Journal of Mathematical Sociology, 1(2), 143-186. DOI: https://doi.org/10.1080/0022250X.1971.9989794",
  "stocks": [
    {
      "id": "stock-integrated",
      "name": "Integrated_Neighborhoods",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-segregated",
      "name": "Segregated_Neighborhoods",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-segregating",
      "name": "Segregation_Rate",
      "equation": "Integrated_Neighborhoods * Preference_Threshold * (1 - Tolerance)",
      "from_stock": "stock-integrated",
      "to_stock": "stock-segregated",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-integrating",
      "name": "Integration_Rate",
      "equation": "Segregated_Neighborhoods * Social_Mobility * Policy_Effect",
      "from_stock": "stock-segregated",
      "to_stock": "stock-integrated",
      "position": {
        "x": 300,
        "y": 280
      }
    }
  ],
  "variables": [
    {
      "id": "var-tolerance",
      "name": "Tolerance",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-threshold",
      "name": "Preference_Threshold",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-mobility",
      "name": "Social_Mobility",
      "equation": "0.05",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-policy",
      "name": "Policy_Effect",
      "equation": "1.0",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Integrated_Neighborhoods",
      "to_element": "Segregation_Rate"
    },
    {
      "id": "c2",
      "from_element": "Tolerance",
      "to_element": "Segregation_Rate"
    },
    {
      "id": "c3",
      "from_element": "Preference_Threshold",
      "to_element": "Segregation_Rate"
    },
    {
      "id": "c4",
      "from_element": "Segregated_Neighborhoods",
      "to_element": "Integration_Rate"
    },
    {
      "id": "c5",
      "from_element": "Social_Mobility",
      "to_element": "Integration_Rate"
    },
    {
      "id": "c6",
      "from_element": "Policy_Effect",
      "to_element": "Integration_Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
