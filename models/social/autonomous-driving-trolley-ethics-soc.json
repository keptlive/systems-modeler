{
  "id": "autonomous-driving-trolley-ethics-soc",
  "name": "Autonomous Vehicle Ethical Decision Model",
  "description": "Model of public preferences for autonomous vehicle crash algorithms - the 'moral machine' problem. People want AVs to minimize casualties but also to protect passengers. Source: Awad et al. (2018). Nature. DOI: 10.1038/s41586-018-0637-6",
  "stocks": [
    {"id": "stock-utilitarian", "name": "Utilitarian_Preference", "initial_value": 0.7, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-self-protect", "name": "Self_Protection_Preference", "initial_value": 0.8, "equation": "", "position": {"x": 400, "y": 200}},
    {"id": "stock-adoption", "name": "AV_Adoption_Willingness", "initial_value": 0.5, "equation": "", "position": {"x": 300, "y": 350}}
  ],
  "flows": [
    {"id": "flow-util-shift", "name": "Utilitarian_Shift", "equation": "(Moral_Reasoning_Exposure * Target_Utilitarian - Utilitarian_Preference) / Preference_Inertia", "from_stock": null, "to_stock": "stock-utilitarian", "position": {"x": 100, "y": 200}},
    {"id": "flow-self-shift", "name": "Self_Protection_Shift", "equation": "(Risk_Perception * 0.9 - Self_Protection_Preference) / Preference_Inertia", "from_stock": null, "to_stock": "stock-self-protect", "position": {"x": 500, "y": 200}},
    {"id": "flow-adoption", "name": "Adoption_Change", "equation": "(Trust_In_Algorithm - AV_Adoption_Willingness) / Adoption_Time", "from_stock": null, "to_stock": "stock-adoption", "position": {"x": 200, "y": 350}}
  ],
  "variables": [
    {"id": "var-moral-exp", "name": "Moral_Reasoning_Exposure", "equation": "0.5 + 0.02 * TIME", "position": {"x": 100, "y": 100}},
    {"id": "var-target-util", "name": "Target_Utilitarian", "equation": "0.8", "position": {"x": 200, "y": 100}},
    {"id": "var-risk", "name": "Risk_Perception", "equation": "0.6", "position": {"x": 450, "y": 100}},
    {"id": "var-inertia", "name": "Preference_Inertia", "equation": "10", "position": {"x": 300, "y": 100}},
    {"id": "var-ethical-consistency", "name": "Ethical_Consistency", "equation": "1 - ABS(Utilitarian_Preference - (1 - Self_Protection_Preference))", "position": {"x": 300, "y": 250}},
    {"id": "var-trust", "name": "Trust_In_Algorithm", "equation": "Ethical_Consistency * Transparency_Level * Safety_Record", "position": {"x": 350, "y": 400}},
    {"id": "var-transparency", "name": "Transparency_Level", "equation": "0.7", "position": {"x": 200, "y": 400}},
    {"id": "var-safety", "name": "Safety_Record", "equation": "0.95", "position": {"x": 450, "y": 400}},
    {"id": "var-adoption-time", "name": "Adoption_Time", "equation": "5", "position": {"x": 100, "y": 400}},
    {"id": "var-moral-paradox", "name": "Moral_Paradox_Index", "equation": "Utilitarian_Preference * Self_Protection_Preference", "position": {"x": 500, "y": 350}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 50, "dt": 0.5},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1038/s41586-018-0637-6",
  "reference": "Awad, E. et al. (2018). The Moral Machine experiment. Nature, 563, 59-64."
}
