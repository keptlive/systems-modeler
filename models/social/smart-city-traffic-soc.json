{
  "id": "smart-city-traffic-soc",
  "name": "Smart City Traffic Management Model",
  "description": "Model of intelligent traffic management showing autonomous vehicles, smart signals, and congestion pricing. Based on urban mobility research. Reference: Highway Capacity Manual. Transportation Research Board. Source: https://www.trb.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Traffic Flow",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Congestion Level",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "AV Penetration",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Traffic Entry",
      "equation": "Demand * (1 - Congestion_Pricing_Effect)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Traffic Exit",
      "equation": "Traffic_Flow * Exit_Rate * Smart_Signal_Effect * AV_Efficiency",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Congestion Buildup",
      "equation": "(Traffic_Flow / Road_Capacity - 1) * Congestion_Rate",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "f4",
      "name": "Congestion Dissipation",
      "equation": "Congestion_Level * Dissipation_Rate",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "AV Adoption",
      "equation": "(100 - AV_Penetration) * Adoption_Rate",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Demand",
      "equation": "6000",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Road Capacity",
      "equation": "5000",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Exit Rate",
      "equation": "0.2",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Smart Signal Effect",
      "equation": "1 + 0.2 * Smart_Signal_Deployment",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "v5",
      "name": "Smart Signal Deployment",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "v6",
      "name": "AV Efficiency",
      "equation": "1 + AV_Penetration * 0.01",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Congestion Rate",
      "equation": "10",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v8",
      "name": "Dissipation Rate",
      "equation": "0.1",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Congestion Pricing Effect",
      "equation": "Congestion_Level * Pricing_Sensitivity / 100",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "v10",
      "name": "Pricing Sensitivity",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "v11",
      "name": "Adoption Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "v12",
      "name": "Average Speed",
      "equation": "60 * (1 - Congestion_Level / 100)",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "v13",
      "name": "Emissions Index",
      "equation": "Traffic_Flow / Average_Speed",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Traffic Flow",
      "to_element": "Congestion Buildup"
    },
    {
      "id": "c2",
      "from_element": "Congestion Level",
      "to_element": "Congestion Pricing Effect"
    },
    {
      "id": "c3",
      "from_element": "AV Penetration",
      "to_element": "AV Efficiency"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 24,
    "dt": 0.1
  },
  "created_at": "2026-01-12T01:53:04.261511+00:00",
  "updated_at": "2026-01-12T01:53:04.261516+00:00",
  "source": "https://doi.org/10.1016/j.trc.2018.02.013",
  "reference": "Chen D, Ahn S, Laval J, Zheng Z. On the periodicity of traffic oscillations and capacity drop: The role of driver characteristics. Transp Res Part B. 2018;59:117-136."
}