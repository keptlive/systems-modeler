    {
      "id": "v8",
      "name": "Decay_Rate",
      "equation": "0.01",
      "position": {
        "x": 450,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Grooming_Time",
      "to_element": "Social_Capacity"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
