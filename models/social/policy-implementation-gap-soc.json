{
  "id": "policy-implementation-gap-soc",
  "name": "Policy Implementation Gap Model",
  "description": "Gap between policy intent and actual implementation outcomes. Source: Pressman & Wildavsky (1973). DOI: 10.1525/9780520342408",
  "stocks": [
    {
      "id": "stock-intent",
      "name": "Policy_Intent",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-actual",
      "name": "Actual_Implementation",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "stock-capacity",
      "name": "Implementation_Capacity",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 250,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-implement",
      "name": "Implementation_Rate",
      "equation": "Policy_Intent * Implementation_Capacity / 100 * Implementation_Effort",
      "from_stock": "stock-intent",
      "to_stock": "stock-actual",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-capbuild",
      "name": "Capacity_Building",
      "equation": "Training_Investment * (Max_Capacity - Implementation_Capacity) / Max_Capacity",
      "from_stock": null,
      "to_stock": "stock-capacity",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "flow-capdecay",
      "name": "Capacity_Decay",
      "equation": "Implementation_Capacity * Turnover_Rate",
      "from_stock": "stock-capacity",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-effort",
      "name": "Implementation_Effort",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-training",
      "name": "Training_Investment",
      "equation": "5",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-maxcap",
      "name": "Max_Capacity",
      "equation": "100",
      "position": {
        "x": 250,
        "y": 175
      }
    },
    {
      "id": "var-turnover",
      "name": "Turnover_Rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 325
      }
    },
    {
      "id": "var-gap",
      "name": "Implementation_Gap",
      "equation": "100 * (1 - Actual_Implementation / (Policy_Intent + 0.01))",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-effectiveness",
      "name": "Policy_Effectiveness",
      "equation": "Actual_Implementation / 100",
      "position": {
        "x": 450,
        "y": 175
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Implementation_Capacity",
      "to_element": "Implementation_Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-12T02:13:18.795827+00:00",
  "updated_at": "2026-01-12T02:13:18.795830+00:00",
  "source": "https://doi.org/10.1525/9780520342408",
  "reference": "Pressman, J.L. & Wildavsky, A. (1973). Implementation. UC Press."
}