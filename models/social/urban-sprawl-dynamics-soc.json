{
  "id": "urban-sprawl-dynamics-soc",
  "name": "Urban Sprawl Dynamics Model",
  "description": "Model of urban expansion showing land use change and infrastructure strain. Source: Brueckner (2000), IRSR; Bettencourt (2013), Science.",
  "stocks": [
    {
      "id": "stock-urban",
      "name": "Urban_Area",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-pop",
      "name": "Urban_Population",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "stock-infra",
      "name": "Infrastructure",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-green",
      "name": "Green_Space",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 50,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-expand",
      "name": "Urban_Expansion",
      "equation": "Expansion_Rate * Urban_Population / Urban_Density_Target",
      "from_stock": "stock-green",
      "to_stock": "stock-urban",
      "position": {
        "x": 125,
        "y": 175
      }
    },
    {
      "id": "flow-popgrow",
      "name": "Population_Growth",
      "equation": "Urban_Population * (Birth_Rate - Death_Rate + Migration_Rate * Job_Attractiveness)",
      "from_stock": null,
      "to_stock": "stock-pop",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "flow-poploss",
      "name": "Out_Migration",
      "equation": "Urban_Population * Out_Migration_Rate * Congestion_Factor",
      "from_stock": "stock-pop",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "flow-infrabuild",
      "name": "Infrastructure_Building",
      "equation": "Infrastructure_Investment / Infra_Cost",
      "from_stock": null,
      "to_stock": "stock-infra",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-infradecay",
      "name": "Infrastructure_Decay",
      "equation": "Infrastructure * Decay_Rate",
      "from_stock": "stock-infra",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-expand",
      "name": "Expansion_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-denstarget",
      "name": "Urban_Density_Target",
      "equation": "10",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-birth",
      "name": "Birth_Rate",
      "equation": "0.015",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-death",
      "name": "Death_Rate",
      "equation": "0.01",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "var-migrate",
      "name": "Migration_Rate",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-jobattract",
      "name": "Job_Attractiveness",
      "equation": "1 + 0.5 * Infrastructure / 100",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-outmigrate",
      "name": "Out_Migration_Rate",
      "equation": "0.005",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-congest",
      "name": "Congestion_Factor",
      "equation": "MAX(1, Urban_Population / (Infrastructure + 1))",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "var-infrainv",
      "name": "Infrastructure_Investment",
      "equation": "Urban_Population * Tax_Per_Capita",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-tax",
      "name": "Tax_Per_Capita",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-infracost",
      "name": "Infra_Cost",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "var-decay",
      "name": "Decay_Rate",
      "equation": "0.02",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "var-density",
      "name": "Actual_Density",
      "equation": "Urban_Population / Urban_Area",
      "position": {
        "x": 250,
        "y": 200
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T12:45:39.561847+00:00",
  "updated_at": "2026-01-12T12:45:39.561847+00:00",
  "source": "https://doi.org/10.1257/aer.101.6.2616",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}