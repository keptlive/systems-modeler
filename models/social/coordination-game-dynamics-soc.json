{
  "id": "coordination-game-dynamics-soc",
  "name": "Coordination Game with Multiple Equilibria",
  "description": "Models coordination on standards or conventions. Source: Schelling (1978) and Young (1993). DOI: 10.2307/2951778",
  "stocks": [
    {
      "id": "stock-adopta",
      "name": "Adoption_A",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-adoptb",
      "name": "Adoption_B",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 200,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-atob",
      "name": "Switch_A_to_B",
      "equation": "Adoption_A * Switch_Rate * (Payoff_B - Payoff_A) / 10 * IF(Payoff_B > Payoff_A, 1, 0)",
      "from_stock": "stock-adopta",
      "to_stock": "stock-adoptb",
      "position": {
        "x": 100,
        "y": 175
      }
    },
    {
      "id": "flow-btoa",
      "name": "Switch_B_to_A",
      "equation": "Adoption_B * Switch_Rate * (Payoff_A - Payoff_B) / 10 * IF(Payoff_A > Payoff_B, 1, 0)",
      "from_stock": "stock-adoptb",
      "to_stock": "stock-adopta",
      "position": {
        "x": 300,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-fracta",
      "name": "Fraction_A",
      "equation": "Adoption_A / (Adoption_A + Adoption_B)",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-fractb",
      "name": "Fraction_B",
      "equation": "Adoption_B / (Adoption_A + Adoption_B)",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-payoffa",
      "name": "Payoff_A",
      "equation": "Coordination_Benefit * Fraction_A + Standalone_A",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-payoffb",
      "name": "Payoff_B",
      "equation": "Coordination_Benefit * Fraction_B + Standalone_B",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-coordben",
      "name": "Coordination_Benefit",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 175
      }
    },
    {
      "id": "var-standalonea",
      "name": "Standalone_A",
      "equation": "2",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-standaloneb",
      "name": "Standalone_B",
      "equation": "3",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "var-switchrate",
      "name": "Switch_Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 175
      }
    },
    {
      "id": "var-dominant",
      "name": "Dominant_Standard",
      "equation": "IF(Adoption_A > Adoption_B, 1, 2)",
      "position": {
        "x": 300,
        "y": 325
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Adoption_A",
      "to_element": "Payoff_A"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:17:16.214158+00:00",
  "updated_at": "2026-01-12T02:17:16.214161+00:00",
  "source": "https://doi.org/10.2307/2951778",
  "reference": "Young, H.P. (1993). The Evolution of Conventions. Econometrica."
}