{
  "id": "arms-race-richardson-soc",
  "name": "Richardson Arms Race Model",
  "description": "Lewis Fry Richardson's classic model of arms race dynamics showing escalation and stability conditions. Source: Richardson (1960), Arms and Insecurity.",
  "stocks": [
    {
      "id": "stock-a",
      "name": "Country_A_Arms",
      "initial_value": 100,
      "equation": "",
