      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-threatb",
      "name": "Threat_Coef_B",
      "equation": "0.25",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-fatiguea",
      "name": "Fatigue_A",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-fatigueb",
      "name": "Fatigue_B",
      "equation": "0.12",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-grieva",
