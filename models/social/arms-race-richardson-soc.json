        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-b",
      "name": "Country_B_Arms",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-aarm",
      "name": "A_Arming",
      "equation": "Threat_Coef_A * Country_B_Arms - Fatigue_A * Country_A_Arms + Grievance_A",
      "from_stock": null,
      "to_stock": "stock-a",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-barm",
