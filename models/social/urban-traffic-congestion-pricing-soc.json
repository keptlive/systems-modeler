{
  "id": "urban-traffic-congestion-pricing-soc",
  "name": "Urban Traffic Congestion Pricing",
  "description": "Models the effects of congestion pricing on traffic flow and mode choice. Based on Small & Verhoef (2007) and Stockholm/London congestion charge experiences. Reference: NSIDC Arctic Sea Ice News. Source: https://nsidc.org/arcticseaicenews/",
  "category": "social",
  "stocks": [
    {
      "id": "stock-drivers",
      "name": "Daily_Drivers",
      "initial_value": 500000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-transit",
      "name": "Transit_Users",
      "initial_value": 300000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-wfh",
      "name": "Work_From_Home",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "stock-revenue",
      "name": "Congestion_Revenue",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-to-transit",
      "name": "Switch_to_Transit",
      "equation": "Daily_Drivers * Mode_Switch_Rate * Price_Elasticity",
      "from_stock": "stock-drivers",
      "to_stock": "stock-transit",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-to-wfh",
      "name": "Switch_to_WFH",
      "equation": "Daily_Drivers * WFH_Rate",
      "from_stock": "stock-drivers",
      "to_stock": "stock-wfh",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-back-driving",
      "name": "Return_to_Driving",
      "equation": "Transit_Users * Return_Rate * (1 - Price_Elasticity)",
      "from_stock": "stock-transit",
      "to_stock": "stock-drivers",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "flow-revenue",
      "name": "Revenue_Collection",
      "equation": "Daily_Drivers * Congestion_Price",
      "from_stock": null,
      "to_stock": "stock-revenue",
      "position": {
        "x": 200,
        "y": 275
      }
    }
  ],
  "variables": [
    {
      "id": "var-price",
      "name": "Congestion_Price",
      "equation": "15",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-elasticity",
      "name": "Price_Elasticity",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-switch",
      "name": "Mode_Switch_Rate",
      "equation": "0.001",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-wfh",
      "name": "WFH_Rate",
      "equation": "0.0005",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-return",
      "name": "Return_Rate",
      "equation": "0.002",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-travel-time",
      "name": "Avg_Travel_Time",
      "equation": "Base_Travel_Time * (1 + Congestion_Factor)",
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "var-base-time",
      "name": "Base_Travel_Time",
      "equation": "30",
      "position": {
        "x": 350,
        "y": 450
      }
    },
    {
      "id": "var-congestion",
      "name": "Congestion_Factor",
      "equation": "(Daily_Drivers / Road_Capacity) ^ 2",
      "position": {
        "x": 500,
        "y": 450
      }
    },
    {
      "id": "var-capacity",
      "name": "Road_Capacity",
      "equation": "600000",
      "position": {
        "x": 650,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "source": "https://doi.org/10.4337/9781847201263",
  "reference": "Small KA & Verhoef ET (2007) The Economics of Urban Transportation. Routledge.",
  "connectors": [],
  "created_at": "2026-01-12T06:10:19.336308+00:00",
  "updated_at": "2026-01-12T06:10:19.336308+00:00"
}