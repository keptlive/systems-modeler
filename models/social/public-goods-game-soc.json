{
  "id": "public-goods-game-soc",
  "name": "Public Goods Game with Punishment",
  "description": "Models contribution to public goods with peer punishment. Source: Fehr & Gachter (2000), American Economic Review. DOI: 10.1257/aer.90.4.980",
  "stocks": [
    {
      "id": "stock-contrib",
      "name": "Average_Contribution",
      "initial_value": 40,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-punish",
      "name": "Punishment_Level",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "stock-publicgood",
      "name": "Public_Good",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-contribchg",
      "name": "Contribution_Change",
      "equation": "(Social_Norm_Effect + Punishment_Effect - Freerider_Temptation) * Adjustment_Speed",
      "from_stock": null,
      "to_stock": "stock-contrib",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "flow-punishchg",
      "name": "Punishment_Change",
      "equation": "(Perceived_Unfairness - Punishment_Cost) * Punishment_Adjustment",
      "from_stock": null,
      "to_stock": "stock-punish",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "flow-pggrow",
      "name": "Public_Good_Growth",
      "equation": "Average_Contribution * Multiplier * Group_Size - Public_Good * Depreciation",
      "from_stock": null,
      "to_stock": "stock-publicgood",
      "position": {
        "x": 300,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-socnorm",
      "name": "Social_Norm_Effect",
      "equation": "Average_Contribution * 0.5",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-puneff",
      "name": "Punishment_Effect",
      "equation": "Punishment_Level * 0.3",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-freerider",
      "name": "Freerider_Temptation",
      "equation": "50 - Average_Contribution * 0.5",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-adjspeed",
      "name": "Adjustment_Speed",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-unfair",
      "name": "Perceived_Unfairness",
      "equation": "MAX(0, 50 - Average_Contribution)",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-puncost",
      "name": "Punishment_Cost",
      "equation": "Punishment_Level * 0.1",
      "position": {
        "x": 250,
        "y": 325
      }
    },
    {
      "id": "var-punadj",
      "name": "Punishment_Adjustment",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 325
      }
    },
    {
      "id": "var-mult",
      "name": "Multiplier",
      "equation": "1.5",
      "position": {
        "x": 450,
        "y": 125
      }
    },
    {
      "id": "var-group",
      "name": "Group_Size",
      "equation": "4",
      "position": {
        "x": 450,
        "y": 175
      }
    },
    {
      "id": "var-deprec",
      "name": "Depreciation",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Average_Contribution",
      "to_element": "Public_Good_Growth"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:17:16.214143+00:00",
  "updated_at": "2026-01-12T02:17:16.214145+00:00",
  "source": "https://doi.org/10.1257/aer.90.4.980",
  "reference": "Fehr, E. & Gachter, S. (2000). Cooperation and Punishment in Public Goods Experiments. American Economic Review."
}