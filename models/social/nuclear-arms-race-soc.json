{
  "id": "nuclear-arms-race-soc",
  "name": "Nuclear Arms Race Dynamics",
  "description": "A Richardson arms race model applied to nuclear weapons, capturing the dynamics of nuclear arsenals between two superpowers. Based on Lewis Fry Richardson's mathematical theory of arms races. Reference: IAEA Nuclear Energy Data. Source: https://www.iaea.org/",
  "source": "https://doi.org/10.1002/ejsp.2420010404",
  "reference": "Richardson LF. Arms and Insecurity. Pittsburgh: Boxwood Press. 1960. See also Brams SJ. Superpower Games. Yale University Press. 1985.",
