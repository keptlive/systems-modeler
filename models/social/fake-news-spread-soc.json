{
  "id": "fake-news-spread-soc",
  "name": "Fake News and Misinformation Spread",
  "description": "A model of misinformation spread in social networks, capturing belief adoption, fact-checking, and correction dynamics. Based on research on information cascades and motivated reasoning. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1126/science.aap9559",
  "reference": "Vosoughi S, Roy D, Aral S. The spread of true and false news online. Science. 2018;359(6380):1146-1151.",
  "stocks": [
    {
      "id": "stock-unaware",
      "name": "Unaware Population",
      "initial_value": 900000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-exposed",
      "name": "Exposed to Misinformation",
      "initial_value": 50000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-believers",
      "name": "Believers",
      "initial_value": 30000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-corrected",
      "name": "Corrected",
      "initial_value": 20000,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "stock-spreaders",
      "name": "Active Spreaders",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-exposure",
      "name": "Exposure",
      "equation": "Unaware_Population * (Active_Spreaders / Total_Pop) * Exposure_Rate * Platform_Amplification",
      "from_stock": "stock-unaware",
      "to_stock": "stock-exposed",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-belief-adoption",
      "name": "Belief Adoption",
      "equation": "Exposed_to_Misinformation * Belief_Rate * Confirmation_Bias",
      "from_stock": "stock-exposed",
      "to_stock": "stock-believers",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-correction",
      "name": "Correction",
      "equation": "Believers * Correction_Rate * Fact_Check_Exposure",
      "from_stock": "stock-believers",
      "to_stock": "stock-corrected",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "flow-rejection",
      "name": "Rejection",
      "equation": "Exposed_to_Misinformation * (1 - Belief_Rate) / Exposure_Duration",
      "from_stock": "stock-exposed",
      "to_stock": "stock-corrected",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "flow-become-spreader",
      "name": "Become Spreader",
      "equation": "Believers * Spread_Propensity * (1 - Active_Spreaders / Believers)",
      "from_stock": null,
      "to_stock": "stock-spreaders",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "flow-stop-spreading",
      "name": "Stop Spreading",
      "equation": "Active_Spreaders * (Fatigue_Rate + Platform_Moderation)",
      "from_stock": "stock-spreaders",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 400
      }
    },
    {
      "id": "flow-backslide",
      "name": "Backslide",
      "equation": "Corrected * Backslide_Rate * Echo_Chamber_Effect",
      "from_stock": "stock-corrected",
      "to_stock": "stock-believers",
      "position": {
        "x": 600,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-total-pop",
      "name": "Total Pop",
      "equation": "1000000",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-exposure-rate",
      "name": "Exposure Rate",
      "equation": "2",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-platform-amp",
      "name": "Platform Amplification",
      "equation": "1.5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-belief-rate",
      "name": "Belief Rate",
      "equation": "0.3",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-confirmation",
      "name": "Confirmation Bias",
      "equation": "1.2",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-correction-rate",
      "name": "Correction Rate",
      "equation": "0.01",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-fact-check",
      "name": "Fact Check Exposure",
      "equation": "0.3",
      "position": {
        "x": 650,
        "y": 100
      }
    },
    {
      "id": "var-exposure-duration",
      "name": "Exposure Duration",
      "equation": "7",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-spread-propensity",
      "name": "Spread Propensity",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-fatigue",
      "name": "Fatigue Rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-moderation",
      "name": "Platform Moderation",
      "equation": "0.02",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "var-backslide",
      "name": "Backslide Rate",
      "equation": "0.02",
      "position": {
        "x": 650,
        "y": 350
      }
    },
    {
      "id": "var-echo-chamber",
      "name": "Echo Chamber Effect",
      "equation": "1 + Active_Spreaders / 50000",
      "position": {
        "x": 700,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 90,
    "dt": 0.25
  },
