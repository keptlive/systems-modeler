{
  "id": "richardson-arms-race-soc",
  "name": "Richardson Arms Race Model",
  "description": "Lewis Fry Richardson's (1960) differential equation model of arms competition between nations. Classic model showing how mutual fear leads to arms buildup or war. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Country_A_Arms",
      "initial_value": 100,
      "position": {
        "x": 200,
        "y": 200
      },
      "equation": ""
    },
    {
      "id": "s2",
      "name": "Country_B_Arms",
      "initial_value": 100,
      "position": {
        "x": 400,
        "y": 200
      },
      "equation": ""
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "a_buildup",
      "to_stock": "s1",
      "equation": "fear_a * Country_B_Arms - fatigue_a * Country_A_Arms + grievance_a",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "f2",
      "name": "b_buildup",
      "to_stock": "s2",
      "equation": "fear_b * Country_A_Arms - fatigue_b * Country_B_Arms + grievance_b",
      "position": {
        "x": 0,
        "y": 0
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "fear_a",
      "equation": "0.5",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v2",
      "name": "fear_b",
      "equation": "0.5",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v3",
      "name": "fatigue_a",
      "equation": "0.3",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v4",
      "name": "fatigue_b",
      "equation": "0.3",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v5",
      "name": "grievance_a",
      "equation": "10",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v6",
      "name": "grievance_b",
      "equation": "10",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v7",
      "name": "arms_ratio",
      "equation": "Country_A_Arms / Country_B_Arms",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v8",
      "name": "total_arms",
      "equation": "Country_A_Arms + Country_B_Arms",
      "position": {
        "x": 0,
        "y": 0
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Country_B_Arms",
      "to_element": "a_buildup"
    },
    {
      "id": "c2",
      "from_element": "Country_A_Arms",
      "to_element": "a_buildup"
    },
    {
      "id": "c3",
      "from_element": "Country_A_Arms",
      "to_element": "b_buildup"
    },
    {
      "id": "c4",
      "from_element": "Country_B_Arms",
      "to_element": "b_buildup"
    }
  ],
  "time_settings": {
    "start": 0,
    "dt": 0.5,
    "end": 50
  },
  "created_at": "2026-01-12T02:25:30.586792+00:00",
  "updated_at": "2026-01-12T02:25:30.586795+00:00",
  "source": "https://doi.org/10.2307/2127396",
  "reference": "Richardson, L. F. (1960). Arms and insecurity: A mathematical study of the causes and origins of war. Boxwood Press."
}