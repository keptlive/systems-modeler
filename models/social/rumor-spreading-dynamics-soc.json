{
  "id": "rumor-spreading-dynamics-soc",
  "name": "Rumor Spreading Dynamics",
  "description": "Daley-Kendall rumor spreading model showing how information spreads through populations with different spreader and stifler dynamics. Source: Daley & Kendall (1965), IMA Journal. DOI: 10.1093/imamat/1.1.42",
  "stocks": [
    {
      "id": "stock-ignorants",
      "name": "Ignorants",
      "initial_value": 9900,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-spreaders",
      "name": "Spreaders",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-stiflers",
      "name": "Stiflers",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-hearing",
      "name": "Hearing_Rumor",
      "equation": "Contact_Rate * Ignorants * Spreaders / Total_Population",
      "from_stock": "stock-ignorants",
      "to_stock": "stock-spreaders",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-stifling-ss",
      "name": "Spreader_Spreader_Contact",
      "equation": "Stifling_Rate * Spreaders * Spreaders / Total_Population",
      "from_stock": "stock-spreaders",
      "to_stock": "stock-stiflers",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "flow-stifling-st",
      "name": "Spreader_Stifler_Contact",
      "equation": "Stifling_Rate * Spreaders * Stiflers / Total_Population",
      "from_stock": "stock-spreaders",
      "to_stock": "stock-stiflers",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "flow-forgetting",
      "name": "Forgetting",
      "equation": "Spreaders / Memory_Time",
      "from_stock": "stock-spreaders",
      "to_stock": "stock-stiflers",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-contact-rate",
      "name": "Contact_Rate",
      "equation": "5",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-stifling-rate",
      "name": "Stifling_Rate",
      "equation": "2",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-memory-time",
      "name": "Memory_Time",
      "equation": "10",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-total-pop",
      "name": "Total_Population",
      "equation": "Ignorants + Spreaders + Stiflers",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-rumor-reach",
      "name": "Rumor_Reach",
      "equation": "(Spreaders + Stiflers) / Total_Population",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Ignorants",
      "to_element": "Hearing_Rumor"
    },
    {
      "id": "conn-2",
      "from_element": "Spreaders",
      "to_element": "Hearing_Rumor"
    },
    {
      "id": "conn-3",
      "from_element": "Spreaders",
      "to_element": "Spreader_Spreader_Contact"
    },
    {
      "id": "conn-4",
      "from_element": "Spreaders",
      "to_element": "Forgetting"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-11T20:47:58.495580Z",
  "updated_at": "2026-01-11T20:47:58.495580Z",
  "source": "https://doi.org/10.1016/j.socnet.2007.04.006",
  "reference": "Social Network Analysis and System Dynamics Models"
}