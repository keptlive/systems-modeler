{
  "id": "public-transit-ridership-soc",
  "name": "Public Transit Ridership Model",
  "description": "Models transit ridership dynamics with service quality feedback. Based on Taylor et al. (2009). DOI: 10.1016/j.tra.2008.12.001",
  "stocks": [
    {
      "id": "stock-ridership",
      "name": "Transit_Ridership",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-service",
      "name": "Service_Level",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "stock-revenue",
      "name": "Fare_Revenue",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "stock-cars",
      "name": "Auto_Commuters",
      "initial_value": 300000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-riderincrease",
      "name": "Ridership_Increase",
      "equation": "Auto_Commuters * Mode_Shift_Rate * Service_Attractiveness",
      "from_stock": "stock-cars",
      "to_stock": "stock-ridership",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-riderdecrease",
      "name": "Ridership_Decrease",
      "equation": "Transit_Ridership * Attrition_Rate / Service_Quality",
      "from_stock": "stock-ridership",
      "to_stock": "stock-cars",
      "position": {
        "x": 200,
        "y": 175
      }
    },
    {
      "id": "flow-serviceexp",
      "name": "Service_Expansion",
      "equation": "(Revenue_Surplus * Investment_Rate + Subsidy) * Service_Multiplier",
      "from_stock": null,
      "to_stock": "stock-service",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "flow-servicecut",
      "name": "Service_Cuts",
      "equation": "MAX(0, -Revenue_Surplus) * Cut_Rate",
      "from_stock": "stock-service",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "flow-farerev",
      "name": "Fare_Collection",
      "equation": "Transit_Ridership * Fare * Trip_Frequency",
      "from_stock": null,
      "to_stock": "stock-revenue",
      "position": {
        "x": 400,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "var-modeshiftrate",
      "name": "Mode_Shift_Rate",
      "equation": "0.001",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "var-serviceattra",
      "name": "Service_Attractiveness",
      "equation": "Service_Level / 100 * (1 + Fuel_Price_Effect)",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-attritionrate",
      "name": "Attrition_Rate",
      "equation": "0.05",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "var-servicequal",
      "name": "Service_Quality",
      "equation": "Service_Level / 100 + 0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-revsurplus",
      "name": "Revenue_Surplus",
      "equation": "Fare_Revenue * 0.01 - Operating_Cost",
      "position": {
        "x": 400,
        "y": 175
      }
    },
    {
      "id": "var-investrate",
      "name": "Investment_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 325
      }
    },
    {
      "id": "var-subsidy",
      "name": "Subsidy",
      "equation": "5",
      "position": {
        "x": 150,
        "y": 325
      }
    },
    {
      "id": "var-servicemult",
      "name": "Service_Multiplier",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 325
      }
    },
    {
      "id": "var-cutrate",
      "name": "Cut_Rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 325
      }
    },
    {
      "id": "var-fare",
      "name": "Fare",
      "equation": "2.5",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-tripfreq",
      "name": "Trip_Frequency",
      "equation": "2",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "var-opcost",
      "name": "Operating_Cost",
      "equation": "Service_Level * 20",
      "position": {
        "x": 350,
        "y": 175
      }
    },
    {
      "id": "var-fuelpriceeff",
      "name": "Fuel_Price_Effect",
      "equation": "0.3 * (1 + 0.2 * SIN(TIME / 20))",
      "position": {
        "x": 100,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Transit_Ridership",
      "to_element": "Fare_Collection"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 120,
    "dt": 1
  },
  "created_at": "2026-01-12T02:49:51.600094+00:00",
  "updated_at": "2026-01-12T02:49:51.600104+00:00",
  "source": "https://doi.org/10.1016/j.tra.2008.12.001",
  "reference": "Taylor BD, et al. (2009). Nature and/or nurture? Analyzing the determinants of transit ridership. Transportation Research Part A."
}