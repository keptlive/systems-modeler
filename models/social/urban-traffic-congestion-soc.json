{
  "id": "urban-traffic-congestion-soc",
  "name": "Population",
  "description": "Model of urban traffic congestion and induced demand. Shows how road expansion paradoxically increases congestion. Based on Duranton & Turner (2011) fundamental law of road congestion. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Vehicle_Km_Traveled_M",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Road_Capacity_Km",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Average_Speed_Kmh",
      "initial_value": 40,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Traffic_Growth",
      "equation": "Induced_Demand + Population_Growth_Effect",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Road_Construction",
      "equation": "Construction_Budget / Cost_per_Km",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Road_Deterioration",
      "equation": "Road_Capacity_Km * Deterioration_Rate",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Speed_Change",
      "equation": "(Target_Speed - Average_Speed_Kmh) / Speed_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Population",
      "equation": "1000000 * (1 + 0.01 * TIME)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Population_Growth_Effect",
      "equation": "Population * 0.00001",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "v3",
      "name": "Road_Supply_Elasticity",
      "equation": "1.0",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Induced_Demand",
      "equation": "Road_Construction * Road_Supply_Elasticity * 0.1",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Construction_Budget",
      "equation": "50",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Cost_per_Km",
      "equation": "10",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Deterioration_Rate",
      "equation": "0.02",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Congestion_Index",
      "equation": "Vehicle_Km_Traveled_M / Road_Capacity_Km",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Free_Flow_Speed",
      "equation": "60",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v10",
      "name": "Target_Speed",
      "equation": "Free_Flow_Speed / (1 + 2 * Congestion_Index^2)",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "v11",
      "name": "Speed_Adjustment_Time",
      "equation": "0.5",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "v12",
      "name": "Travel_Time_Index",
      "equation": "Free_Flow_Speed / Average_Speed_Kmh",
      "position": {
        "x": 700,
        "y": 300
      }
    },
    {
      "id": "v13",
      "name": "Congestion_Cost_M",
      "equation": "Vehicle_Km_Traveled_M * (Travel_Time_Index - 1) * Value_of_Time",
      "position": {
        "x": 500,
        "y": 400
      }
    },
    {
      "id": "v14",
      "name": "Value_of_Time",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 450
      }
    }
  ],
