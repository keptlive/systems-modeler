{
  "id": "goldstone-tilly-social-movement-soc",
  "name": "Goldstone-Tilly Social Movement Model",
  "description": "A system dynamics model of social movement dynamics based on the work of Goldstone and Tilly (2001). Models the relationship between political opportunity, collective action frames, mobilizing structures, and social movement outcomes. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1146/annurev.soc.27.1.283",
  "reference": "Goldstone JA, Tilly C. Threat (and Opportunity): Popular Action and State Response in the Dynamics of Contentious Action. In: Aminzade et al., eds. Silence and Voice in the Study of Contentious Politics. Cambridge University Press, 2001.",
  "stocks": [
    {
      "id": "stock-mobilization",
      "name": "Movement Mobilization",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-political-opportunity",
      "name": "Political Opportunity",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-mobilization-change",
      "name": "Mobilization Change",
      "equation": "Movement_Mobilization * (Political_Opportunity / 100 - Repression_Effect)",
      "from_stock": null,
      "to_stock": "stock-mobilization",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-opportunity-change",
      "name": "Opportunity Change",
      "equation": "(Target_Opportunity - Political_Opportunity) / Adjustment_Time",
      "from_stock": null,
      "to_stock": "stock-political-opportunity",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
