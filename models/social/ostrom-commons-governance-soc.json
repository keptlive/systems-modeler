        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Harvest_Rate",
      "equation": "0.15",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Investment_Rate",
      "equation": "1",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Erosion_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Adjustment_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
