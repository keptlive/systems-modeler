{
  "id": "urban-sprawl-land-use-soc",
  "name": "Urban Sprawl and Land Use Change",
  "description": "Model of urban expansion dynamics including suburban development, commuting patterns, and land conversion from agriculture. Based on urban economics and transportation literature on sprawl causes and consequences. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Urban_Core_Population",
      "initial_value": 500000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Suburban_Population",
      "initial_value": 300000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Developed_Land",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "s4",
      "name": "Agricultural_Land",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Suburbanization",
      "equation": "Urban_Core_Population * Suburban_Pull * Housing_Affordability_Ratio",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Urban_Migration",
      "equation": "Migration_Rate * Urban_Employment_Attractiveness",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Land_Development",
      "equation": "Development_Rate * Suburban_Population / Density_Target",
      "from_stock": "s4",
      "to_stock": "s3",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Suburban_Pull",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "v2",
      "name": "Migration_Rate",
      "equation": "5000",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "v3",
      "name": "Development_Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "v4",
      "name": "Density_Target",
      "equation": "5000",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "v5",
      "name": "Urban_Housing_Cost",
      "equation": "1500 + 0.001 * Urban_Core_Population",
      "position": {
        "x": 150,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "Suburban_Housing_Cost",
      "equation": "1000 + 0.0005 * Suburban_Population",
      "position": {
        "x": 350,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Housing_Affordability_Ratio",
      "equation": "Urban_Housing_Cost / MAX(Suburban_Housing_Cost, 1)",
      "position": {
        "x": 500,
        "y": 130
      }
    },
    {
      "id": "v8",
      "name": "Urban_Employment_Attractiveness",
      "equation": "1.2",
      "position": {
        "x": 200,
        "y": 180
      }
    },
    {
      "id": "v9",
      "name": "Sprawl_Index",
      "equation": "Developed_Land / (Urban_Core_Population + Suburban_Population) * 1000",
      "position": {
        "x": 400,
        "y": 180
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2080,
    "dt": 1
  },
  "source": "https://doi.org/10.1111/j.1538-4616.2009.00242.x",
  "reference": "Brueckner JK (2000) Urban Sprawl: Diagnosis and Remedies. International Regional Science Review. Glaeser EL, Kahn ME (2004) Sprawl and Urban Growth.",
