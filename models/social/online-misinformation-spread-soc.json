{
  "id": "online-misinformation-spread-soc",
  "name": "Misinfo_Exposure",
  "description": "Model of misinformation spread on social media platforms. Shows how false information spreads faster than corrections. Based on Vosoughi et al. (2018) Science paper on false news. Reference: Parker, G. G., et al. (2016). Platform Revolution. Norton. Source: https://www.wwnorton.com/",
  "stocks": [
    {
      "id": "s1",
      "name": "Unexposed",
      "initial_value": 900000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Exposed_to_Misinfo",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Believing_Misinfo",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "s4",
      "name": "Corrected",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "s5",
      "name": "Fact_Checked",
      "initial_value": 98000,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Misinfo_Exposure",
      "equation": "Unexposed * Exposure_Rate * Sharing_Amplification",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Believing",
      "equation": "Exposed_to_Misinfo * Belief_Rate",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Skeptical",
      "equation": "Exposed_to_Misinfo * Skepticism_Rate",
      "from_stock": "s2",
      "to_stock": "s4",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "f4",
      "name": "Correction_Spread",
      "equation": "Believing_Misinfo * Correction_Rate * Fact_Check_Reach",
      "from_stock": "s3",
      "to_stock": "s5",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "f5",
      "name": "Self_Correction",
      "equation": "Corrected * 0.1",
      "from_stock": "s4",
      "to_stock": "s5",
      "position": {
        "x": 600,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Total_Population",
      "equation": "1000000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Exposure_Rate",
      "equation": "(Believing_Misinfo + Exposed_to_Misinfo) / Total_Population * Misinfo_Virality",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Misinfo_Virality",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Sharing_Amplification",
      "equation": "1.7",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "v5",
      "name": "Belief_Rate",
      "equation": "0.4 * (1 - Critical_Thinking)",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v6",
      "name": "Critical_Thinking",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "v7",
      "name": "Skepticism_Rate",
      "equation": "0.3 + 0.2 * Critical_Thinking",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Correction_Rate",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Fact_Check_Reach",
      "equation": "0.2 * (1 + Fact_Check_Resources)",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Fact_Check_Resources",
      "equation": "0.5",
      "position": {
        "x": 700,
        "y": 350
      }
    },
    {
      "id": "v11",
      "name": "Misinfo_Prevalence",
      "equation": "(Believing_Misinfo + Exposed_to_Misinfo) / Total_Population",
      "position": {
        "x": 400,
        "y": 450
      }
    },
    {
      "id": "v12",
      "name": "Truth_vs_Misinfo_Ratio",
      "equation": "Fact_Checked / MAX(1, Believing_Misinfo)",
      "position": {
        "x": 700,
        "y": 100
      }
    }
  ],
  "connectors": [
