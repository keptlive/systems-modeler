{
  "id": "trust-institutions-dynamics-soc",
  "name": "Trust in Institutions Dynamics Model",
  "description": "Model of public trust in institutions showing how performance, transparency, polarization, and media coverage affect trust levels. Demonstrates how trust erosion can create self-reinforcing cycles. Based on political science and public administration research.",
  "stocks": [
    {
      "id": "s1",
      "name": "Public_Trust",
      "initial_value": 60,
      "equation": "",
      "position": {"x": 300, "y": 200}
    },
    {
      "id": "s2",
      "name": "Institutional_Performance",
      "initial_value": 70,
      "equation": "",
      "position": {"x": 150, "y": 350}
    },
    {
      "id": "s3",
      "name": "Polarization",
      "initial_value": 40,
      "equation": "",
      "position": {"x": 450, "y": 350}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Trust_Building",
      "equation": "(Target_Trust - Public_Trust) * Building_Rate * Performance_Effect",
      "from_stock": null,
      "to_stock": "Public_Trust",
      "position": {"x": 150, "y": 200}
    },
    {
      "id": "f2",
      "name": "Trust_Erosion",
      "equation": "Public_Trust * Erosion_Rate * Scandal_Effect * Polarization_Effect",
      "from_stock": "Public_Trust",
      "to_stock": null,
      "position": {"x": 450, "y": 200}
    },
    {
      "id": "f3",
      "name": "Performance_Improvement",
      "equation": "(Investment_in_Quality - Performance_Decline) / Improvement_Time",
      "from_stock": null,
      "to_stock": "Institutional_Performance",
      "position": {"x": 50, "y": 350}
    },
    {
      "id": "f4",
      "name": "Polarization_Increase",
      "equation": "MAX(0, (Media_Amplification + Political_Incentive - Depolarization) / Polar_Time)",
      "from_stock": null,
      "to_stock": "Polarization",
      "position": {"x": 550, "y": 350}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Target_Trust",
      "equation": "Institutional_Performance * Transparency_Effect",
      "position": {"x": 100, "y": 80}
    },
    {
      "id": "v2",
      "name": "Building_Rate",
      "equation": "0.02",
      "position": {"x": 200, "y": 80}
    },
    {
      "id": "v3",
      "name": "Performance_Effect",
      "equation": "Institutional_Performance / 70",
      "position": {"x": 300, "y": 80}
    },
    {
      "id": "v4",
      "name": "Erosion_Rate",
      "equation": "0.01",
      "position": {"x": 400, "y": 80}
    },
    {
      "id": "v5",
      "name": "Scandal_Effect",
      "equation": "1",
      "position": {"x": 500, "y": 80}
    },
    {
      "id": "v6",
      "name": "Polarization_Effect",
      "equation": "1 + Polarization / 100",
      "position": {"x": 600, "y": 80}
    },
    {
      "id": "v7",
      "name": "Transparency_Effect",
      "equation": "0.9",
      "position": {"x": 100, "y": 130}
    },
    {
      "id": "v8",
      "name": "Investment_in_Quality",
      "equation": "5 * Public_Trust / 60",
      "position": {"x": 50, "y": 450}
    },
    {
      "id": "v9",
      "name": "Performance_Decline",
      "equation": "Institutional_Performance * 0.02",
      "position": {"x": 150, "y": 450}
    },
    {
      "id": "v10",
      "name": "Improvement_Time",
      "equation": "10",
      "position": {"x": 250, "y": 450}
    },
    {
      "id": "v11",
      "name": "Media_Amplification",
      "equation": "3",
      "position": {"x": 400, "y": 450}
    },
    {
      "id": "v12",
      "name": "Political_Incentive",
      "equation": "2 * (100 - Public_Trust) / 100",
      "position": {"x": 500, "y": 450}
    },
    {
      "id": "v13",
      "name": "Depolarization",
      "equation": "2",
      "position": {"x": 600, "y": 450}
    },
    {
      "id": "v14",
      "name": "Polar_Time",
      "equation": "5",
      "position": {"x": 650, "y": 400}
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1146/annurev-polisci-050718-033740",
  "reference": "Norris P. (2022). In Praise of Skepticism: Trust but Verify. Oxford University Press. Also: Citrin J, Stoker L. (2018). Political Trust in a Cynical Age. Annual Review of Political Science, 21, 49-70. DOI: 10.1146/annurev-polisci-050316-092550",
  "created_at": "2026-01-15T20:30:00.000000Z",
  "updated_at": "2026-01-15T20:30:00.000000Z"
}
