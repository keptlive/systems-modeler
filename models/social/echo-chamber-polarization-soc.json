{
  "id": "echo-chamber-polarization-soc",
  "name": "Echo Chamber and Filter Bubble Model",
  "description": "Models opinion reinforcement through selective exposure. Source: Sunstein (2001) and Pariser (2011). DOI: 10.1073/pnas.1618923114",
  "stocks": [
    {
      "id": "stock-leftop",
      "name": "Left_Opinion_Strength",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-rightop",
      "name": "Right_Opinion_Strength",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-moderate",
      "name": "Moderate_Population",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 350,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-leftpol",
      "name": "Left_Polarization",
      "equation": "Left_Opinion_Strength * Echo_Effect * Algorithm_Bias",
      "from_stock": null,
      "to_stock": "stock-leftop",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-rightpol",
      "name": "Right_Polarization",
      "equation": "Right_Opinion_Strength * Echo_Effect * Algorithm_Bias",
      "from_stock": null,
      "to_stock": "stock-rightop",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "flow-toextreme",
      "name": "Moderate_To_Extreme",
      "equation": "Moderate_Population * Radicalization_Rate * (Left_Opinion_Strength + Right_Opinion_Strength) / 100",
      "from_stock": "stock-moderate",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 175
      }
    },
    {
      "id": "flow-depolrize",
      "name": "Depolarization",
      "equation": "(Left_Opinion_Strength + Right_Opinion_Strength - 100) * Cross_Exposure * 0.1",
      "from_stock": null,
      "to_stock": "stock-moderate",
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-echo",
      "name": "Echo_Effect",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-algo",
      "name": "Algorithm_Bias",
      "equation": "1.5",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-radical",
      "name": "Radicalization_Rate",
      "equation": "0.01",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-crossexp",
      "name": "Cross_Exposure",
      "equation": "0.2",
      "position": {
        "x": 450,
        "y": 175
      }
    },
    {
      "id": "var-polarization",
      "name": "Total_Polarization",
      "equation": "Left_Opinion_Strength + Right_Opinion_Strength - 100",
      "position": {
        "x": 150,
        "y": 175
      }
    },
    {
      "id": "var-homophily",
      "name": "Homophily_Index",
      "equation": "(Left_Opinion_Strength * Right_Opinion_Strength) / 2500",
      "position": {
        "x": 250,
        "y": 325
      }
    },
    {
      "id": "var-diversity",
      "name": "Opinion_Diversity",
      "equation": "Moderate_Population / 100",
      "position": {
        "x": 400,
        "y": 325
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Left_Opinion_Strength",
      "to_element": "Left_Polarization"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:23:02.238401+00:00",
  "updated_at": "2026-01-12T02:23:02.238404+00:00",
  "source": "https://doi.org/10.1073/pnas.1618923114",
  "reference": "Sunstein, C.R. (2001). Echo Chambers. Princeton University Press."
}