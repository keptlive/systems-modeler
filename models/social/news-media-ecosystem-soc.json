{
  "id": "news-media-ecosystem-soc",
  "name": "News Media Ecosystem Model",
  "description": "Model of news media dynamics. Source: Pew Research Center (2021).",
  "stocks": [
    {
      "id": "stock-trad",
      "name": "Traditional_Media_Share",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-digital",
      "name": "Digital_Media_Share",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-social",
      "name": "Social_Media_News",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-digital-shift",
      "name": "Digital_Shift",
      "equation": "Traditional_Media_Share * Shift_Rate",
      "from_stock": "stock-trad",
      "to_stock": "stock-digital",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-social-shift",
      "name": "Social_Shift",
      "equation": "Digital_Media_Share * Social_Rate",
      "from_stock": "stock-digital",
      "to_stock": "stock-social",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-shift",
      "name": "Shift_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-social",
      "name": "Social_Rate",
      "equation": "0.03",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-total",
      "name": "Total_Share",
      "equation": "Traditional_Media_Share + Digital_Media_Share + Social_Media_News",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.5
  },
  "created_at": "2026-01-12T12:53:13.195536+00:00",
  "updated_at": "2026-01-12T12:53:13.195536+00:00",
  "source": "https://doi.org/10.1038/nature09678",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}