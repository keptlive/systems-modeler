{
  "id": "axelrod-cooperation-evolution-soc",
  "name": "Axelrod Cooperation Evolution",
  "description": "Robert Axelrod's 1984 evolution of cooperation through iterated prisoner's dilemma tournaments. Tit-for-Tat emerges as robust cooperative strategy. Reference: Fisher, R. A. (1930). The Genetical Theory of Natural Selection. Oxford University Press. Source: https://doi.org/10.5962/bhl.title.27468",
  "stocks": [
    {
      "id": "stock-coop",
      "name": "Cooperators",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-defect",
      "name": "Defectors",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-tft",
      "name": "TitForTat",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-c-to-d",
      "name": "Coop_to_Defect",
      "equation": "Cooperators * (1 - coop_fitness / avg_fitness) * mutation_rate",
      "from_stock": "stock-coop",
      "to_stock": "stock-defect",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-d-to-c",
      "name": "Defect_to_Coop",
      "equation": "Defectors * (1 - defect_fitness / avg_fitness) * mutation_rate",
      "from_stock": "stock-defect",
      "to_stock": "stock-coop",
      "position": {
        "x": 250,
        "y": 280
      }
    },
    {
      "id": "flow-to-tft",
      "name": "Evolve_TFT",
      "equation": "learning_rate * (TFT_fitness - avg_fitness) * (Cooperators + Defectors) / total_pop",
      "from_stock": null,
      "to_stock": "stock-tft",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-total",
      "name": "total_pop",
      "equation": "Cooperators + Defectors + TitForTat",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-coop-frac",
      "name": "coop_fraction",
      "equation": "(Cooperators + TitForTat) / total_pop",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-coop-fit",
      "name": "coop_fitness",
      "equation": "reward * coop_fraction + sucker * (1 - coop_fraction)",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "var-defect-fit",
      "name": "defect_fitness",
      "equation": "temptation * coop_fraction + punishment * (1 - coop_fraction)",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-tft-fit",
      "name": "TFT_fitness",
      "equation": "reward * coop_fraction + punishment * (1 - coop_fraction) * 0.5 + sucker * (1 - coop_fraction) * 0.5",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-avg-fit",
      "name": "avg_fitness",
      "equation": "(Cooperators * coop_fitness + Defectors * defect_fitness + TitForTat * TFT_fitness) / total_pop",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "var-reward",
      "name": "reward",
      "equation": "3",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-sucker",
      "name": "sucker",
      "equation": "0",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-tempt",
      "name": "temptation",
      "equation": "5",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-punish",
      "name": "punishment",
      "equation": "1",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-mut",
      "name": "mutation_rate",
      "equation": "0.01",
      "position": {
        "x": 250,
        "y": 330
      }
    },
    {
      "id": "var-learn",
      "name": "learning_rate",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "coop_fraction",
      "to_element": "coop_fitness"
    },
    {
      "id": "conn-2",
      "from_element": "coop_fraction",
      "to_element": "defect_fitness"
    },
    {
      "id": "conn-3",
      "from_element": "avg_fitness",
      "to_element": "Coop_to_Defect"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 1
  },
  "source": "https://doi.org/10.1126/science.7466396",
  "reference": "Axelrod R, Hamilton WD. The Evolution of Cooperation. Science. 1981;211(4489):1390-1396. Book: The Evolution of Cooperation, 1984."
}