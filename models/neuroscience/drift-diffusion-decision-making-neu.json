{
  "id": "drift-diffusion-decision-making-neu",
  "name": "Drift Diffusion Decision Model",
  "description": "Two-alternative forced choice decision dynamics. Source: Ratcliff (1978), Psychological Review.",
  "stocks": [
    {
      "id": "s1",
      "name": "Evidence_Accumulator",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Decision_Time",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Trial_Count",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Evidence_Change",
      "equation": "Drift_Rate + Noise",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Time_Increment",
      "equation": "1 - Decision_Made",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Trial_Increment",
      "equation": "Decision_Made",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Drift_Rate",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Threshold",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Noise_SD",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Noise",
      "equation": "0",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Decision_Made",
      "equation": "IF(ABS(Evidence_Accumulator) >= Threshold, 1, 0)",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Choice",
      "equation": "IF(Evidence_Accumulator >= Threshold, 1, IF(Evidence_Accumulator <= -Threshold, -1, 0))",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v7",
      "name": "Accuracy",
      "equation": "IF(Choice > 0, 1, 0)",
      "position": {
        "x": 400,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Evidence_Accumulator",
      "to_element": "Decision_Made"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.1
  },
  "created_at": "2026-01-15T14:54:39.082430+00:00",
  "updated_at": "2026-01-15T14:54:39.082433+00:00",
  "source": "https://doi.org/10.1037/0033-295X.85.2.59",
  "reference": "Ratcliff, R. (1978). A theory of memory retrieval. Psychological Review 85:59-108."
}