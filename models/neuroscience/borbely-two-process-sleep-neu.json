{
  "id": "borbely-two-process-sleep-neu",
  "name": "Borb\u00e9ly Two-Process Sleep Model",
  "description": "Sleep regulation by homeostatic and circadian processes. Source: Borb\u00e9ly (1982), Human Neurobiology.",
  "stocks": [
    {
      "id": "s1",
      "name": "Sleep_Pressure",
      "initial_value": 0.2,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Circadian_Phase",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Sleep_State",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Pressure_Change",
      "equation": "Wake_Buildup - Sleep_Dissipation",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Phase_Advance",
      "equation": "2 * 3.14159 / 24",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Sleep_Transition",
      "equation": "Sleep_Onset - Wake_Onset",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "tau_wake",
      "equation": "18.2",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "tau_sleep",
      "equation": "4.2",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "H_upper",
      "equation": "0.67",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "H_lower",
      "equation": "0.17",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Circadian_Amplitude",
      "equation": "0.12",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "C",
      "equation": "0.5 + Circadian_Amplitude * COS(Circadian_Phase)",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Wake_Buildup",
      "equation": "(1 - Sleep_State) * (1 - Sleep_Pressure) / tau_wake",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v8",
      "name": "Sleep_Dissipation",
      "equation": "Sleep_State * Sleep_Pressure / tau_sleep",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Upper_Threshold",
      "equation": "H_upper + C",
      "position": {
        "x": 200,
        "y": 480
      }
    },
    {
      "id": "v10",
      "name": "Lower_Threshold",
      "equation": "H_lower + C",
      "position": {
        "x": 400,
        "y": 480
      }
    },
    {
      "id": "v11",
      "name": "Sleep_Onset",
      "equation": "IF(Sleep_Pressure > Upper_Threshold, 0.1, 0)",
      "position": {
        "x": 200,
        "y": 540
      }
    },
    {
      "id": "v12",
      "name": "Wake_Onset",
      "equation": "IF(Sleep_Pressure < Lower_Threshold, 0.1, 0)",
      "position": {
        "x": 400,
        "y": 540
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Sleep_Pressure",
      "to_element": "Sleep_Onset"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 72,
    "dt": 0.1
  },
  "created_at": "2026-01-15T14:54:39.083567+00:00",
  "updated_at": "2026-01-15T14:54:39.083571+00:00",
  "source": "https://doi.org/10.1007/BF01148112",
  "reference": "Borb\u00e9ly, A.A. (1982). A two process model of sleep regulation. Human Neurobiology 1:195-204."
}