{
  "id": "hebbian-synaptic-plasticity-neu",
  "name": "Hebbian Synaptic Plasticity Model",
  "description": "Donald Hebb's theory of synaptic plasticity: 'neurons that fire together, wire together.' This model captures long-term potentiation (LTP) and depression (LTD). Source: Hebb (1949), Organization of Behavior. DOI: 10.1016/0893-6080(88)90007-X",
  "stocks": [
    {"id": "stock-weight", "name": "Synaptic_Weight", "initial_value": 0.5, "equation": "", "position": {"x": 300, "y": 200}},
    {"id": "stock-pre", "name": "Presynaptic_Activity", "initial_value": 0.3, "equation": "", "position": {"x": 100, "y": 200}},
    {"id": "stock-post", "name": "Postsynaptic_Activity", "initial_value": 0.2, "equation": "", "position": {"x": 500, "y": 200}}
  ],
  "flows": [
    {"id": "flow-ltp", "name": "Weight_Change", "equation": "Learning_Rate * (Hebbian_Term - Weight_Decay * Synaptic_Weight)", "from_stock": null, "to_stock": "stock-weight", "position": {"x": 200, "y": 200}},
    {"id": "flow-pre-stim", "name": "Pre_Stimulus", "equation": "Input_Signal - Presynaptic_Activity * Decay_Rate", "from_stock": null, "to_stock": "stock-pre", "position": {"x": 50, "y": 200}},
    {"id": "flow-post-response", "name": "Post_Response", "equation": "Synaptic_Weight * Presynaptic_Activity - Postsynaptic_Activity * Decay_Rate", "from_stock": null, "to_stock": "stock-post", "position": {"x": 400, "y": 200}}
  ],
  "variables": [
    {"id": "var-learning", "name": "Learning_Rate", "equation": "0.1", "position": {"x": 200, "y": 100}},
    {"id": "var-decay", "name": "Weight_Decay", "equation": "0.01", "position": {"x": 350, "y": 100}},
    {"id": "var-hebbian", "name": "Hebbian_Term", "equation": "Presynaptic_Activity * Postsynaptic_Activity", "position": {"x": 300, "y": 300}},
    {"id": "var-input", "name": "Input_Signal", "equation": "0.5 * (1 + SIN(TIME / 5))", "position": {"x": 50, "y": 100}},
    {"id": "var-activity-decay", "name": "Decay_Rate", "equation": "0.2", "position": {"x": 450, "y": 100}},
    {"id": "var-efficacy", "name": "Synaptic_Efficacy", "equation": "Synaptic_Weight * Presynaptic_Activity", "position": {"x": 300, "y": 350}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 100, "dt": 0.1},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1016/0893-6080(88)90007-X",
  "reference": "Hebb, D.O. (1949). The Organization of Behavior. Wiley. See also: Brown, T.H. et al. (1988). Hebbian synapses. Neural Networks, 1(1), 87-95."
}
