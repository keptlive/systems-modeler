{
  "id": "drift-diffusion-decision-neu",
  "name": "Drift-Diffusion Decision Model",
  "description": "Model of perceptual decision-making showing evidence accumulation until threshold. Reference: Ratcliff, R. & McKoon, G. (2008). The diffusion decision model.",
  "stocks": [
    {
      "id": "s1",
      "name": "Evidence",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Decisions_Made",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Drift",
      "equation": "Drift_Rate + Noise",
      "from_stock": null,
      "to_stock": "Evidence",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Decision_Count",
      "equation": "IF ABS(Evidence) >= Threshold THEN 1 ELSE 0",
      "from_stock": null,
      "to_stock": "Decisions_Made",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Reset",
      "equation": "IF ABS(Evidence) >= Threshold THEN -Evidence ELSE 0",
      "from_stock": null,
      "to_stock": "Evidence",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Drift_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Noise",
      "equation": "0.05 * SIN(time * 17) + 0.03 * SIN(time * 31)",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Threshold",
      "equation": "1.0",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Non_Decision_Time",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Starting_Point",
      "equation": "0",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Choice",
      "equation": "IF Evidence >= Threshold THEN 1 ELSE IF Evidence <= -Threshold THEN -1 ELSE 0",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "RT_Estimate",
      "equation": "Threshold / MAX(0.01, ABS(Drift_Rate))",
      "position": {
        "x": 400,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.01
  },
  "source": "https://doi.org/10.1162/neco.2008.12-06-420",
  "reference": "Ratcliff, R. & McKoon, G. (2008). The diffusion decision model: theory and data for two-choice decision tasks. Neural Computation, 20(4), 873-922.",
  "created_at": "2026-01-15T19:58:51.626980+00:00",
  "updated_at": "2026-01-15T19:58:51.626980+00:00"
}