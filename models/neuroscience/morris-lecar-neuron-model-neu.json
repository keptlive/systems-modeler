{
  "id": "morris-lecar-neuron-model-neu",
  "name": "Morris-Lecar Neuron Model",
  "description": "Simplified neuron model capturing action potentials with Ca and K channels. Source: Morris & Lecar (1981), Biophysical J.",
  "stocks": [
    {
      "id": "s1",
      "name": "Membrane_Potential",
      "initial_value": -60,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "K_Activation",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Voltage_Change",
      "equation": "(I_applied - I_Ca - I_K - I_Leak) / Capacitance",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "K_Change",
      "equation": "phi * (w_inf - K_Activation) * lambda_w",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "I_applied",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "g_Ca",
      "equation": "4.4",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "g_K",
      "equation": "8.0",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "g_L",
      "equation": "2.0",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "E_Ca",
      "equation": "120",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "E_K",
      "equation": "-84",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "E_L",
      "equation": "-60",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Capacitance",
      "equation": "20",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "phi",
      "equation": "0.04",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v10",
      "name": "m_inf",
      "equation": "0.5 * (1 + (Membrane_Potential + 1.2) / 18 / (1 + ABS((Membrane_Potential + 1.2) / 18)))",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v11",
      "name": "w_inf",
      "equation": "0.5 * (1 + (Membrane_Potential + 2) / 30 / (1 + ABS((Membrane_Potential + 2) / 30)))",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v12",
      "name": "lambda_w",
      "equation": "1.0",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "v13",
      "name": "I_Ca",
      "equation": "g_Ca * m_inf * (Membrane_Potential - E_Ca)",
      "position": {
        "x": 150,
        "y": 450
      }
    },
    {
      "id": "v14",
      "name": "I_K",
      "equation": "g_K * K_Activation * (Membrane_Potential - E_K)",
      "position": {
        "x": 300,
        "y": 450
      }
    },
    {
      "id": "v15",
      "name": "I_Leak",
      "equation": "g_L * (Membrane_Potential - E_L)",
      "position": {
        "x": 450,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Membrane_Potential",
      "to_element": "m_inf"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
