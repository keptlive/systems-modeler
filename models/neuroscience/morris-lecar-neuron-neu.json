    },
    {
      "id": "ml-v18-param-6",
      "name": "Potassium_Steady_State",
      "equation": "1 / (1 + EXP(-2 * (Membrane_Potential - V3) / V4))",
      "units": "dimensionless",
      "position": {
        "x": 400,
        "y": 435
      }
    },
    {
      "id": "ml-v18-param-7",
      "name": "Potassium_Rate",
      "equation": "phi * (EXP((Membrane_Potential - V3) / (2 * V4)) + EXP(-(Membrane_Potential - V3) / (2 * V4))) / 2",
      "units": "1/ms",
      "position": {
        "x": 550,
        "y": 435
      }
    }
