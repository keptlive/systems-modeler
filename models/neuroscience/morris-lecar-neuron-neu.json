        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "gL",
      "equation": "2.0",
      "position": {
        "x": 360,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "VCa",
      "equation": "120.0",
      "position": {
        "x": 490,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "VK",
      "equation": "-84.0",
      "position": {
        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "VL",
      "equation": "-60.0",
      "position": {
        "x": 230,
        "y": 130
      }
    },
    {
