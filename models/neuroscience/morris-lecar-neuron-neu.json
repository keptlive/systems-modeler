{
  "id": "morris-lecar-neuron-neu",
  "name": "Morris-Lecar Neuron Model",
  "description": "Reduced two-state Morris-Lecar teaching model with explicit voltage and potassium-gating derivatives. The prior file had no flows and was inert. Equations and added type-II gating constants V1=-1.2 mV, V2=18 mV, V3=2 mV, V4=30 mV, phi=0.04/ms follow Ermentrout's XPP Morris-Lecar example. Existing conductances, reversal potentials, applied current 100, initial V=-60/w=0 and 400-ms Euler grid are retained; this is an explicitly parameterized teaching adaptation, not a reproduction of a particular 1981 experimental trace. Voltage is mV, time ms, and gating is dimensionless. Logistic/exponential forms are exact identities for the source tanh/cosh gates.",
  "stocks": [
    {
      "id": "s1",
      "name": "Membrane_Potential",
      "initial_value": -60.0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      },
      "units": "mV"
    },
    {
      "id": "s2",
      "name": "Potassium_Activation",
      "initial_value": 0.0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      },
      "units": "dimensionless"
    }
  ],
  "flows": [
    {
      "id": "ml-v18-voltage",
      "name": "Voltage_Change",
      "equation": "(I_app + gL * (VL - Membrane_Potential) + gK * Potassium_Activation * (VK - Membrane_Potential) + gCa * Calcium_Activation * (VCa - Membrane_Potential)) / Capacitance",
      "from_stock": null,
      "to_stock": "s1",
      "units": "mV/ms",
      "position": {
        "x": 150,
        "y": 270
      }
    },
    {
      "id": "ml-v18-gating",
      "name": "Potassium_Change",
      "equation": "Potassium_Rate * (Potassium_Steady_State - Potassium_Activation)",
      "from_stock": null,
      "to_stock": "s2",
      "units": "1/ms",
      "position": {
        "x": 350,
        "y": 270
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "gCa",
      "equation": "4.4",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
