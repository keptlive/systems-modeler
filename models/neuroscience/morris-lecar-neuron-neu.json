      "equation": "100.0",
      "position": {
        "x": 360,
        "y": 130
      }
    },
    {
      "id": "v8",
      "name": "Capacitance",
      "equation": "20.0",
      "position": {
        "x": 490,
        "y": 130
      }
    },
    {
      "id": "ml-v18-param-0",
      "name": "V1",
      "equation": "-1.2",
