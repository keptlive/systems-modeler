{
  "id": "jacobs-urban-diversity-urb",
  "name": "Jacobs Urban Diversity Model",
  "description": "Jane Jacobs' model of urban diversity and economic vitality through mixed-use development. Reference: Jacobs, J. (1961). The Death and Life of Great American Cities.",
  "stocks": [
    {
      "id": "s1",
      "name": "Street_Activity",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Business_Diversity",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Safety_Perception",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Property_Values",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 750,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Activity_Change",
      "equation": "Business_Diversity * Diversity_Effect + Safety_Perception * Safety_Effect - Street_Activity * Decay",
      "from_stock": null,
      "to_stock": "Street_Activity",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Business_Formation",
      "equation": "Street_Activity * Foot_Traffic_Effect - Business_Diversity * Competition + Mixed_Use_Policy",
      "from_stock": null,
      "to_stock": "Business_Diversity",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Safety_Change",
      "equation": "Street_Activity * Eyes_On_Street - Safety_Perception * Crime_Effect",
      "from_stock": null,
      "to_stock": "Safety_Perception",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Value_Change",
      "equation": "(Street_Activity + Safety_Perception) * Value_Sensitivity - Property_Values * 0.02",
      "from_stock": null,
      "to_stock": "Property_Values",
      "position": {
        "x": 550,
        "y": 300
      }
    }
  ],
  "variables": [
