{
  "id": "building-energy-performance-simulation-urb",
  "name": "Building Energy Performance Model",
  "description": "Model of building heating/cooling load and energy consumption. Source: DOE EnergyPlus documentation. Reference: IEA World Energy Outlook. Source: https://www.iea.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Indoor_Temperature",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Total_Energy",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Temperature_Change",
      "equation": "(Heat_Gain - Heat_Loss + HVAC_Output) / Thermal_Mass",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Energy_Consumption",
      "equation": "HVAC_Power + Lighting + Equipment",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Outdoor_Temp",
      "equation": "10 + 10 * SIN((TIME - 6) * 3.14159 / 12)",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Solar_Radiation",
      "equation": "MAX(0, 500 * SIN((TIME - 6) * 3.14159 / 12))",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Setpoint",
      "equation": "21",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Thermal_Mass",
      "equation": "50000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "UA_Value",
      "equation": "500",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "SHGC",
      "equation": "0.4",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Window_Area",
      "equation": "50",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Heat_Gain",
      "equation": "Solar_Radiation * SHGC * Window_Area + 1000",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Heat_Loss",
      "equation": "UA_Value * (Indoor_Temperature - Outdoor_Temp)",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v10",
      "name": "HVAC_Output",
      "equation": "HVAC_Capacity * SIGN(Setpoint - Indoor_Temperature) * MIN(1, ABS(Setpoint - Indoor_Temperature) / 2)",
      "position": {
        "x": 450,
        "y": 420
      }
    },
    {
      "id": "v11",
      "name": "HVAC_Capacity",
      "equation": "10000",
      "position": {
        "x": 200,
        "y": 480
      }
    },
    {
      "id": "v12",
      "name": "HVAC_Power",
      "equation": "ABS(HVAC_Output) / 3",
      "position": {
        "x": 400,
        "y": 480
      }
    },
    {
      "id": "v13",
      "name": "Lighting",
      "equation": "IF(Solar_Radiation < 200, 500, 100)",
      "position": {
        "x": 550,
        "y": 480
      }
    },
    {
      "id": "v14",
      "name": "Equipment",
      "equation": "300",
      "position": {
        "x": 300,
        "y": 540
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Indoor_Temperature",
      "to_element": "Heat_Loss"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 24,
    "dt": 0.25
  },
  "created_at": "2026-01-15T14:49:43.657777+00:00",
  "updated_at": "2026-01-15T14:49:43.657780+00:00",
  "source": "https://energyplus.net/documentation",
  "reference": "DOE (2023). EnergyPlus Engineering Reference. US Department of Energy."
}