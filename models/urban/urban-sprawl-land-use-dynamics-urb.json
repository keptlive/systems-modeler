{
  "id": "urban-sprawl-land-use-dynamics-urb",
  "name": "Urban Sprawl and Land Use Dynamics Model",
  "description": "Model of urban expansion, land use change, and infrastructure costs. Based on urban economics research. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Urban Area km2",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Urban Population",
      "initial_value": 500000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Agricultural Land",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "s4",
      "name": "Infrastructure Deficit",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Urban Expansion",
      "equation": "Expansion_Rate * Urban_Population / Current_Density * Land_Availability",
      "from_stock": "s3",
      "to_stock": "s1",
      "position": {
        "x": 150,
        "y": 225
      }
    },
    {
      "id": "f2",
      "name": "Population Growth",
      "equation": "Urban_Population * Population_Growth_Rate + Migration_Rate",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "f3",
      "name": "Population Decline",
      "equation": "Urban_Population * Outmigration_Rate * Density_Push_Factor",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Infrastructure Need",
      "equation": "Urban_Expansion * Infrastructure_Cost_per_km2",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "f5",
      "name": "Infrastructure Investment",
      "equation": "Tax_Revenue * Investment_Fraction",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Current Density",
      "equation": "Urban_Population / Urban_Area_km2",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Target Density",
      "equation": "5000",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Expansion Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v4",
      "name": "Land Availability",
      "equation": "Agricultural_Land / (Agricultural_Land + 100)",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "v5",
      "name": "Population Growth Rate",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Migration Rate",
      "equation": "5000",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "v7",
      "name": "Outmigration Rate",
      "equation": "0.005",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "v8",
      "name": "Density Push Factor",
      "equation": "MAX(0, Current_Density / Target_Density - 0.5)",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "v9",
      "name": "Infrastructure Cost per km2",
      "equation": "1000000",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "v10",
      "name": "Tax Revenue",
      "equation": "Urban_Population * Tax_per_Capita",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "v11",
      "name": "Tax per Capita",
      "equation": "100",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "v12",
      "name": "Investment Fraction",
      "equation": "0.2",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "v13",
      "name": "Sprawl Index",
      "equation": "Urban_Area_km2 / (Urban_Population / 1000)",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "v14",
      "name": "Infrastructure Gap",
      "equation": "Infrastructure_Deficit / (Tax_Revenue + 1)",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Urban Population",
      "to_element": "Urban Expansion"
    },
    {
      "id": "c2",
      "from_element": "Agricultural Land",
      "to_element": "Land Availability"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 1
  },
  "created_at": "2026-01-15T14:24:00.394695",
  "updated_at": "2026-01-15T14:24:00.394705",
  "source": "https://doi.org/10.1086/261120",
  "reference": "Brueckner JK. Urban Sprawl: Diagnosis and Remedies. International Regional Science Review. 2000;23(2):160-171."
}