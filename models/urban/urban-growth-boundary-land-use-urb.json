{
  "id": "urban-growth-boundary-land-use-urb",
  "name": "Urban Growth Boundary Model",
  "description": "Model of urban expansion with growth boundaries and land conversion. Source: Brueckner (2000), IRSR.",
  "stocks": [
    {
      "id": "s1",
      "name": "Urban_Area",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Agricultural_Land",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Urban_Population",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Land_Conversion",
      "equation": "IF(Urban_Area < Growth_Boundary, Conversion_Rate, 0)",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Population_Growth",
      "equation": "Population_Growth_Rate * Urban_Population * (1 - Urban_Population / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Population_Growth_Rate",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Carrying_Capacity",
      "equation": "Urban_Area * 50",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Growth_Boundary",
      "equation": "150",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Land_Price_Differential",
      "equation": "1000 / (Agricultural_Land + 1)",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Conversion_Rate",
      "equation": "0.5 * Land_Price_Differential * (Urban_Population / (Urban_Area * 50))",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Population_Density",
      "equation": "Urban_Population / Urban_Area",
      "position": {
        "x": 300,
        "y": 420
      }
    },
    {
      "id": "v7",
      "name": "Housing_Price_Index",
      "equation": "100 * Population_Density / 10",
      "position": {
        "x": 500,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Urban_Area",
      "to_element": "Carrying_Capacity"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-15T14:49:43.654452+00:00",
  "updated_at": "2026-01-15T14:49:43.657620+00:00",
  "source": "https://doi.org/10.1111/1468-2427.00225",
  "reference": "Brueckner, J.K. (2000). Urban sprawl: diagnosis and remedies. International Regional Science Review 23:160-171."
}