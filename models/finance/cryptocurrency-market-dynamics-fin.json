{
  "id": "cryptocurrency-market-dynamics-fin",
  "name": "Cryptocurrency Market Dynamics Model",
  "description": "Models cryptocurrency price dynamics with speculation, adoption, and regulatory effects. Based on Liu & Tsyvinski (2021). DOI: 10.1093/rfs/hhaa113",
  "stocks": [
    {
      "id": "stock-price",
      "name": "Crypto_Price",
      "initial_value": 50000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-adoption",
      "name": "User_Adoption",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-supply",
      "name": "Circulating_Supply",
      "initial_value": 19,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "stock-sentiment",
      "name": "Market_Sentiment",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-pricechange",
      "name": "Price_Change",
      "equation": "Crypto_Price * (Demand_Pressure - Supply_Pressure) * Volatility",
      "from_stock": null,
      "to_stock": "stock-price",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-adoptgrowth",
      "name": "Adoption_Growth",
      "equation": "User_Adoption * Network_Effect * (1 + Return_Momentum)",
      "from_stock": null,
      "to_stock": "stock-adoption",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-adoptloss",
      "name": "Adoption_Loss",
      "equation": "User_Adoption * Churn_Rate * Regulatory_Impact",
      "from_stock": "stock-adoption",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-mining",
      "name": "Mining_Issuance",
      "equation": "Mining_Rate * (1 - Circulating_Supply / Max_Supply)",
      "from_stock": null,
      "to_stock": "stock-supply",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-sentimentchg",
      "name": "Sentiment_Change",
      "equation": "(Return_Momentum * 50 - Market_Sentiment + 50) * Sentiment_Speed",
      "from_stock": null,
      "to_stock": "stock-sentiment",
      "position": {
        "x": 300,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-dempress",
      "name": "Demand_Pressure",
      "equation": "User_Adoption / 100 * (1 + Market_Sentiment / 100)",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-suppress",
      "name": "Supply_Pressure",
      "equation": "Circulating_Supply / 21 * (1 - Market_Sentiment / 100)",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-volatility",
      "name": "Volatility",
      "equation": "0.03 + 0.02 * ABS(Market_Sentiment - 50) / 50",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-neteffect",
      "name": "Network_Effect",
      "equation": "0.02 * LN(User_Adoption / 100 + 1)",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-retmom",
      "name": "Return_Momentum",
      "equation": "0.5 * SIN(TIME / 20)",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-churnrate",
      "name": "Churn_Rate",
      "equation": "0.01",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "var-regimpact",
      "name": "Regulatory_Impact",
      "equation": "1 + 0.3 * IF(TIME > 50, 1, 0)",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "var-miningrate",
      "name": "Mining_Rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "var-maxsupply",
      "name": "Max_Supply",
      "equation": "21",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "var-sentspeed",
      "name": "Sentiment_Speed",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "User_Adoption",
      "to_element": "Demand_Pressure"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-12T02:59:36.700240+00:00",
  "updated_at": "2026-01-12T02:59:36.700297+00:00",
  "source": "https://doi.org/10.1093/rfs/hhaa113",
  "reference": "Liu Y, Tsyvinski A (2021). Risks and Returns of Cryptocurrency. Review of Financial Studies."
}