{
  "id": "fama-french-factor-fin",
  "name": "Fama-French Factor Model",
  "description": "Multi-factor asset pricing model showing size and value premiums. Reference: Fama, E.F. & French, K.R. (1993). Common risk factors in stocks and bonds.",
  "stocks": [
    {
      "id": "s1",
      "name": "Portfolio_Return",
