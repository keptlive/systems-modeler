        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Cumulative_Alpha",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Return_Flow",
      "equation": "Expected_Return + Idiosyncratic",
      "from_stock": null,
      "to_stock": "Portfolio_Return",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Alpha_Accumulation",
      "equation": "Alpha",
      "from_stock": null,
      "to_stock": "Cumulative_Alpha",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Risk_Free",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Market_Return",
      "equation": "0.08 + 0.02 * SIN(time / 20)",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Market_Premium",
      "equation": "Market_Return - Risk_Free",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "SMB",
      "equation": "0.03 + 0.01 * SIN(time / 15)",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "HML",
      "equation": "0.04 + 0.01 * SIN(time / 25)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Beta_Market",
      "equation": "1.1",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Beta_SMB",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Beta_HML",
      "equation": "0.4",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Alpha",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v10",
      "name": "Expected_Return",
      "equation": "Risk_Free + Beta_Market * Market_Premium + Beta_SMB * SMB + Beta_HML * HML + Alpha",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "v11",
      "name": "Idiosyncratic",
      "equation": "0.005 * SIN(time * 31)",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "v12",
      "name": "Sharpe_Ratio",
      "equation": "(Expected_Return - Risk_Free) / 0.15",
      "position": {
        "x": 550,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
