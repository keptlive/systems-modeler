{
  "id": "dornbusch-exchange-overshooting-fin",
  "name": "Dornbusch Exchange Rate Overshooting Model",
  "description": "Explains why exchange rates overshoot their long-run equilibrium in response to monetary policy changes. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Exchange_Rate",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Price_Level",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Exchange_Adjustment",
      "equation": "(Expected_Exchange - Exchange_Rate) * Adjustment_Speed",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Price_Adjustment",
      "equation": "(Long_Run_Price - Price_Level) / Price_Stickiness",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 100,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Long_Run_Exchange",
      "equation": "Money_Supply / Money_Demand_Scale",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "v2",
      "name": "Expected_Exchange",
      "equation": "Long_Run_Exchange",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Long_Run_Price",
      "equation": "Money_Supply / Real_Money_Demand",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v4",
      "name": "Money_Supply",
      "equation": "1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Money_Demand_Scale",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "v6",
      "name": "Real_Money_Demand",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Adjustment_Speed",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Price_Stickiness",
      "equation": "4",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Real_Exchange_Rate",
      "equation": "Exchange_Rate / Price_Level",
      "position": {
        "x": 350,
        "y": 225
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
