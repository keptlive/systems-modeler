{
  "id": "liquidity-crisis-dynamics-fin",
  "name": "Bank Liquidity Crisis Dynamics",
  "description": "Models liquidity spirals and fire sale dynamics in financial crises. Based on Brunnermeier & Pedersen (2009) Market Liquidity and Funding Liquidity, RFS. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "category": "finance",
  "stocks": [
    {
      "id": "stock-liquid",
      "name": "Liquid_Assets",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-illiquid",
      "name": "Illiquid_Assets",
      "initial_value": 800,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-funding",
      "name": "Available_Funding",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-fire-sale",
      "name": "Fire_Sales",
      "equation": "IF(Funding_Gap > 0, MIN(Illiquid_Assets * Fire_Sale_Rate, Funding_Gap * Hair_Cut), 0)",
      "from_stock": "stock-illiquid",
      "to_stock": "stock-liquid",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-funding-out",
      "name": "Funding_Withdrawal",
      "equation": "Available_Funding * Withdrawal_Rate * Stress_Indicator",
      "from_stock": "stock-funding",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-funding-in",
      "name": "Funding_Return",
      "equation": "Available_Funding * Return_Rate * (1 - Stress_Indicator)",
      "from_stock": null,
      "to_stock": "stock-funding",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-gap",
      "name": "Funding_Gap",
      "equation": "MAX(0, Required_Funding - Liquid_Assets)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-required",
      "name": "Required_Funding",
      "equation": "Illiquid_Assets * 0.3",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-fire-rate",
      "name": "Fire_Sale_Rate",
      "equation": "0.2",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-haircut",
      "name": "Hair_Cut",
      "equation": "1.5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-withdraw",
      "name": "Withdrawal_Rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-return",
      "name": "Return_Rate",
      "equation": "0.05",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "var-stress",
      "name": "Stress_Indicator",
      "equation": "IF(Liquid_Assets/Required_Funding < 1, 1, 0)",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1093/rfs/hhn098",
  "reference": "Brunnermeier MK, Pedersen LH (2009) Market Liquidity and Funding Liquidity. Review of Financial Studies 22(6):2201-2238.",
  "connectors": [],
  "created_at": "2026-01-12T06:27:18.295470+00:00",
  "updated_at": "2026-01-12T06:27:18.295470+00:00"
}