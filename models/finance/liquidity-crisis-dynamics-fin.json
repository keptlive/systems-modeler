{
  "id": "liquidity-crisis-dynamics-fin",
  "name": "Bank Liquidity Crisis Dynamics",
  "description": "Models liquidity spirals and fire sale dynamics in financial crises. Based on Brunnermeier & Pedersen (2009) Market Liquidity and Funding Liquidity.",
  "category": "finance",
  "stocks": [
    {
      "id": "stock-liquid",
      "name": "Liquid_Assets",
      "initial_value": 200,
      "equation": "",
      "position": { "x": 200, "y": 200 }
    },
    {
      "id": "stock-illiquid",
      "name": "Illiquid_Assets",
      "initial_value": 800,
      "equation": "",
      "position": { "x": 400, "y": 200 }
    },
    {
      "id": "stock-confidence",
      "name": "Market_Confidence",
      "initial_value": 0.8,
      "equation": "",
      "position": { "x": 300, "y": 350 }
    }
  ],
  "flows": [
    {
      "id": "flow-fire-sale",
      "name": "Fire_Sales",
      "equation": "IF(Funding_Gap > 0, MIN(Illiquid_Assets * 0.15, Funding_Gap / Recovery_Rate), 0)",
      "from_stock": "stock-illiquid",
      "to_stock": null,
      "position": { "x": 500, "y": 200 }
    },
    {
      "id": "flow-fire-cash",
      "name": "Fire_Sale_Cash",
      "equation": "Fire_Sales * Recovery_Rate",
      "from_stock": null,
      "to_stock": "stock-liquid",
      "position": { "x": 100, "y": 200 }
    },
    {
      "id": "flow-liquidity-drain",
      "name": "Liquidity_Drain",
      "equation": "Liquid_Assets * Drain_Rate * (1 - Market_Confidence)",
      "from_stock": "stock-liquid",
      "to_stock": null,
      "position": { "x": 200, "y": 100 }
    },
    {
      "id": "flow-confidence-loss",
      "name": "Confidence_Loss",
      "equation": "Market_Confidence * 0.1 * Stress_Level",
      "from_stock": "stock-confidence",
      "to_stock": null,
      "position": { "x": 200, "y": 350 }
    },
    {
      "id": "flow-confidence-recovery",
      "name": "Confidence_Recovery",
      "equation": "IF(Stress_Level < 0.3, (1 - Market_Confidence) * 0.05, 0)",
      "from_stock": null,
      "to_stock": "stock-confidence",
      "position": { "x": 400, "y": 350 }
    }
  ],
  "variables": [
    {
      "id": "var-gap",
      "name": "Funding_Gap",
      "equation": "MAX(0, Required_Funding - Liquid_Assets)",
      "position": { "x": 100, "y": 100 }
    },
    {
      "id": "var-required",
      "name": "Required_Funding",
      "equation": "Illiquid_Assets * Funding_Ratio",
      "position": { "x": 200, "y": 100 }
    },
    {
      "id": "var-funding-ratio",
      "name": "Funding_Ratio",
      "equation": "0.35",
      "position": { "x": 300, "y": 100 }
    },
    {
      "id": "var-recovery",
      "name": "Recovery_Rate",
      "equation": "0.5 + 0.3 * Market_Confidence",
      "position": { "x": 400, "y": 100 }
    },
    {
      "id": "var-drain",
      "name": "Drain_Rate",
      "equation": "0.15",
      "position": { "x": 500, "y": 100 }
    },
    {
      "id": "var-stress",
      "name": "Stress_Level",
      "equation": "MIN(1, MAX(0, (Required_Funding - Liquid_Assets) / Required_Funding))",
      "position": { "x": 300, "y": 450 }
    },
    {
      "id": "var-total-assets",
      "name": "Total_Assets",
      "equation": "Liquid_Assets + Illiquid_Assets",
      "position": { "x": 600, "y": 200 }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.1
  },
  "source": "https://doi.org/10.1093/rfs/hhn098",
  "reference": "Brunnermeier MK, Pedersen LH (2009) Market Liquidity and Funding Liquidity. Review of Financial Studies 22(6):2201-2238.",
  "connectors": [],
  "created_at": "2026-01-12T06:27:18.295470+00:00",
  "updated_at": "2026-01-21T00:00:00.000000+00:00"
}
