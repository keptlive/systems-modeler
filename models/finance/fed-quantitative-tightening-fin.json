{
  "id": "fed-quantitative-tightening-fin",
  "name": "Federal Reserve Quantitative Tightening Model",
  "description": "Model of Federal Reserve balance sheet reduction (QT) and its effects on financial markets. Captures the reverse of QE with portfolio rebalancing and term premium effects. Source: Krishnamurthy & Vissing-Jorgensen (2011). NBER. DOI: 10.1257/mac.3.4.215",
  "stocks": [
    {"id": "stock-fed-balance", "name": "Fed_Balance_Sheet", "initial_value": 8500, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-reserves", "name": "Bank_Reserves", "initial_value": 3500, "equation": "", "position": {"x": 400, "y": 200}},
    {"id": "stock-term-premium", "name": "Term_Premium", "initial_value": 0, "equation": "", "position": {"x": 300, "y": 350}}
  ],
  "flows": [
    {"id": "flow-runoff", "name": "Balance_Sheet_Runoff", "equation": "Monthly_Runoff_Cap", "from_stock": "stock-fed-balance", "to_stock": null, "position": {"x": 100, "y": 200}},
    {"id": "flow-reserve-drain", "name": "Reserve_Drain", "equation": "Monthly_Runoff_Cap * Reserve_Impact_Ratio", "from_stock": "stock-reserves", "to_stock": null, "position": {"x": 500, "y": 200}},
    {"id": "flow-premium-change", "name": "Term_Premium_Adjustment", "equation": "(Target_Term_Premium - Term_Premium) / Premium_Adjustment_Time", "from_stock": null, "to_stock": "stock-term-premium", "position": {"x": 200, "y": 350}}
  ],
  "variables": [
    {"id": "var-runoff-cap", "name": "Monthly_Runoff_Cap", "equation": "95", "position": {"x": 100, "y": 100}},
    {"id": "var-reserve-impact", "name": "Reserve_Impact_Ratio", "equation": "0.8", "position": {"x": 450, "y": 100}},
    {"id": "var-target-premium", "name": "Target_Term_Premium", "equation": "Premium_Sensitivity * (Initial_Fed_Balance - Fed_Balance_Sheet) / 1000", "position": {"x": 350, "y": 300}},
    {"id": "var-premium-sens", "name": "Premium_Sensitivity", "equation": "0.15", "position": {"x": 200, "y": 300}},
    {"id": "var-initial-balance", "name": "Initial_Fed_Balance", "equation": "8500", "position": {"x": 100, "y": 300}},
    {"id": "var-adj-time", "name": "Premium_Adjustment_Time", "equation": "6", "position": {"x": 350, "y": 400}},
    {"id": "var-10y-yield", "name": "Ten_Year_Yield", "equation": "Neutral_Rate + Term_Premium + Expected_Inflation", "position": {"x": 450, "y": 350}},
    {"id": "var-neutral", "name": "Neutral_Rate", "equation": "0.5", "position": {"x": 500, "y": 300}},
    {"id": "var-expected-inf", "name": "Expected_Inflation", "equation": "2.5", "position": {"x": 550, "y": 350}},
    {"id": "var-ample-reserves", "name": "Ample_Reserves_Threshold", "equation": "2500", "position": {"x": 450, "y": 250}},
    {"id": "var-scarcity", "name": "Reserve_Scarcity", "equation": "IF(Bank_Reserves < Ample_Reserves_Threshold, 1, 0)", "position": {"x": 500, "y": 400}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 36, "dt": 1},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1257/mac.3.4.215",
  "reference": "Krishnamurthy, A. & Vissing-Jorgensen, A. (2011). The effects of quantitative easing on interest rates. Brookings Papers on Economic Activity, Fall 2011."
}
