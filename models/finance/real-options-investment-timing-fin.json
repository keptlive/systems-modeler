{
  "id": "real-options-investment-timing-fin",
  "name": "Real Options Investment Model",
  "description": "Model of investment timing under uncertainty using real options theory. Source: Dixit & Pindyck (1994), Investment under Uncertainty.",
  "stocks": [
    {
      "id": "s1",
      "name": "Asset_Value",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Option_Value",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Invested",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Value_Drift",
      "equation": "mu * Asset_Value + sigma * Asset_Value * Noise",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Option_Change",
      "equation": "MAX(0, Asset_Value - Investment_Cost) - Option_Value",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Investment_Decision",
      "equation": "IF(Asset_Value > Trigger_Value AND Invested < 1, 1, 0)",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "mu",
      "equation": "0.05",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "sigma",
      "equation": "0.2",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "r",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Investment_Cost",
      "equation": "80",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "beta",
      "equation": "(0.5 - mu / sigma^2) + ((mu / sigma^2 - 0.5)^2 + 2 * r / sigma^2)^0.5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Trigger_Value",
      "equation": "Investment_Cost * beta / (beta - 1)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Noise",
      "equation": "(SIN(TIME * 17.3) + COS(TIME * 23.1)) * 0.05",
      "position": {
        "x": 150,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Asset_Value",
      "to_element": "Investment_Decision"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-15T14:41:20.230321+00:00",
  "updated_at": "2026-01-15T14:41:20.230325+00:00",
  "source": "https://press.princeton.edu/books/hardcover/9780691034102/investment-under-uncertainty",
  "reference": "Dixit, A.K. & Pindyck, R.S. (1994). Investment under Uncertainty. Princeton UP."
}