{
  "id": "black-scholes-option-fin",
  "name": "Black-Scholes Option Pricing Dynamics",
  "description": "Nobel Prize model dynamics of option pricing and delta hedging. Reference: Black, F. & Scholes, M. (1973). The Pricing of Options and Corporate Liabilities.",
  "stocks": [
    {
      "id": "s1",
      "name": "Stock_Price",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Option_Value",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Hedge_Position",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Price_Change",
      "equation": "Stock_Price * (Drift + Volatility * Random_Walk)",
      "from_stock": null,
      "to_stock": "Stock_Price",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Option_Change",
      "equation": "Delta * Stock_Price * (Drift + Volatility * Random_Walk) + Theta",
      "from_stock": null,
      "to_stock": "Option_Value",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Hedge_Adjustment",
      "equation": "(Delta - Hedge_Position) * Rebalance_Rate",
      "from_stock": null,
      "to_stock": "Hedge_Position",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Strike_Price",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Time_To_Expiry",
      "equation": "MAX(0.01, 1 - time / 252)",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Risk_Free_Rate",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Volatility",
      "equation": "0.2",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Drift",
      "equation": "Risk_Free_Rate / 252",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Random_Walk",
      "equation": "0.01 * SIN(time * 17)",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "d1",
      "equation": "(LOG(Stock_Price / Strike_Price) + (Risk_Free_Rate + Volatility^2 / 2) * Time_To_Expiry) / (Volatility * Time_To_Expiry^0.5)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Delta",
      "equation": "0.5 + 0.4 * d1 / (1 + ABS(d1))",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Theta",
      "equation": "-Stock_Price * Volatility / (2 * Time_To_Expiry^0.5) / 252",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v10",
      "name": "Rebalance_Rate",
      "equation": "0.5",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "v11",
      "name": "Hedge_PnL",
      "equation": "Option_Value - Hedge_Position * Stock_Price",
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 252,
    "dt": 1
  },
  "source": "https://doi.org/10.1086/260062",
  "reference": "Black, F. & Scholes, M. (1973). The Pricing of Options and Corporate Liabilities. Journal of Political Economy, 81(3), 637-654.",
