{
  "id": "pension-fund-crisis-fin",
  "name": "Pension Fund Crisis Model",
  "description": "Models pension fund solvency with demographic and market risks. Based on OECD (2021) Pensions Outlook. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-assets",
      "name": "Pension_Assets",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-liabilities",
      "name": "Pension_Liabilities",
      "initial_value": 900,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "stock-active",
      "name": "Active_Members",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "stock-retired",
      "name": "Retired_Members",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-contributions",
      "name": "Contributions",
      "equation": "Active_Members * Average_Salary * Contribution_Rate",
      "from_stock": null,
      "to_stock": "stock-assets",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "flow-returns",
      "name": "Investment_Returns",
      "equation": "Pension_Assets * (Expected_Return + Market_Shock)",
      "from_stock": null,
      "to_stock": "stock-assets",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "flow-benefits",
      "name": "Benefit_Payments",
      "equation": "Retired_Members * Average_Benefit",
      "from_stock": "stock-assets",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-liabgrowth",
      "name": "Liability_Growth",
      "equation": "Pension_Liabilities * (Discount_Rate + Longevity_Risk)",
      "from_stock": null,
      "to_stock": "stock-liabilities",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "flow-liabsettle",
      "name": "Liability_Settlement",
      "equation": "Retired_Members * Average_Benefit",
      "from_stock": "stock-liabilities",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "flow-retire",
      "name": "Retirements",
      "equation": "Active_Members * Retirement_Rate",
      "from_stock": "stock-active",
      "to_stock": "stock-retired",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "flow-newhires",
      "name": "New_Hires",
      "equation": "Hiring_Rate",
      "from_stock": null,
      "to_stock": "stock-active",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "flow-deaths",
      "name": "Deaths",
      "equation": "Retired_Members * Mortality_Rate",
      "from_stock": "stock-retired",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-avgsalary",
      "name": "Average_Salary",
      "equation": "50",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-contribrate",
      "name": "Contribution_Rate",
      "equation": "0.15",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-expreturn",
      "name": "Expected_Return",
      "equation": "0.06",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "var-mktshock",
      "name": "Market_Shock",
      "equation": "0.02 * SIN(TIME / 10)",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "var-avgbenefit",
      "name": "Average_Benefit",
      "equation": "25",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-discrate",
      "name": "Discount_Rate",
      "equation": "0.04",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-longrisk",
      "name": "Longevity_Risk",
      "equation": "0.005",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-retirerate",
      "name": "Retirement_Rate",
      "equation": "0.05",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "var-hirerate",
      "name": "Hiring_Rate",
      "equation": "3",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-mortrate",
      "name": "Mortality_Rate",
      "equation": "0.04",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "var-fundratio",
      "name": "Funding_Ratio",
      "equation": "Pension_Assets / Pension_Liabilities",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "var-depratio",
      "name": "Dependency_Ratio",
      "equation": "Retired_Members / Active_Members",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Pension_Assets",
      "to_element": "Funding_Ratio"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:59:36.700322+00:00",
  "updated_at": "2026-01-12T02:59:36.700326+00:00",
  "source": "https://www.oecd.org/pensions/oecd-pensions-outlook.htm",
  "reference": "OECD (2021). Pensions Outlook 2021."
}