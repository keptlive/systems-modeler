{
  "id": "taylor-rule-monetary-fin",
  "name": "Taylor Rule Monetary Policy",
  "description": "Central bank sets interest rates based on inflation and output gaps. Provides benchmark for systematic monetary policy. Foundation for modern macroeconomic policy analysis. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "stock-inflation",
      "name": "Inflation",
      "initial_value": 0.02,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-output-gap",
      "name": "Output Gap",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-inflation-change",
      "name": "Inflation Change",
      "equation": "Phillips_Coefficient * Output_Gap + Inflation_Persistence * (Inflation - Target_Inflation)",
      "from_stock": null,
      "to_stock": "stock-inflation",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "flow-output-change",
      "name": "Output Change",
      "equation": "-IS_Sensitivity * (Policy_Rate - Inflation - Natural_Rate)",
      "from_stock": null,
      "to_stock": "stock-output-gap",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-target",
      "name": "Target Inflation",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-natural",
      "name": "Natural Rate",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-policy",
      "name": "Policy Rate",
      "equation": "Natural_Rate + Target_Inflation + 1.5 * (Inflation - Target_Inflation) + 0.5 * Output_Gap",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-phillips",
      "name": "Phillips Coefficient",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-is",
      "name": "IS Sensitivity",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-persistence",
      "name": "Inflation Persistence",
      "equation": "-0.1",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-real-rate",
      "name": "Real Interest Rate",
      "equation": "Policy_Rate - Inflation",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Inflation",
      "to_element": "Policy Rate"
    },
    {
      "id": "conn-2",
