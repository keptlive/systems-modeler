{
  "id": "yield-curve-inversion-recession-fin",
  "name": "Yield Curve Inversion and Recession Prediction Model",
  "description": "Model of yield curve dynamics as a leading recession indicator. Inversion (short rates > long rates) historically precedes recessions by 12-18 months. Source: Estrella & Mishkin (1998). IMF Staff Papers. DOI: 10.2307/3867370",
  "stocks": [
    {"id": "stock-short-rate", "name": "Short_Term_Rate", "initial_value": 5.5, "equation": "", "position": {"x": 150, "y": 150}},
    {"id": "stock-long-rate", "name": "Long_Term_Rate", "initial_value": 4.0, "equation": "", "position": {"x": 350, "y": 150}},
    {"id": "stock-recession-prob", "name": "Recession_Probability", "initial_value": 0.1, "equation": "", "position": {"x": 250, "y": 300}},
    {"id": "stock-output", "name": "Economic_Output", "initial_value": 100, "equation": "", "position": {"x": 450, "y": 300}}
  ],
  "flows": [
    {"id": "flow-short-change", "name": "Short_Rate_Change", "equation": "(Target_Short_Rate - Short_Term_Rate) / Policy_Lag", "from_stock": null, "to_stock": "stock-short-rate", "position": {"x": 100, "y": 150}},
    {"id": "flow-long-change", "name": "Long_Rate_Change", "equation": "(Expected_Short_Rate + Term_Premium - Long_Term_Rate) / Expectation_Lag", "from_stock": null, "to_stock": "stock-long-rate", "position": {"x": 450, "y": 150}},
    {"id": "flow-prob-update", "name": "Probability_Update", "equation": "(Model_Recession_Prob - Recession_Probability) / Probability_Lag", "from_stock": null, "to_stock": "stock-recession-prob", "position": {"x": 150, "y": 300}},
    {"id": "flow-output-change", "name": "Output_Growth", "equation": "Economic_Output * (Trend_Growth - Recession_Drag)", "from_stock": null, "to_stock": "stock-output", "position": {"x": 550, "y": 300}}
  ],
  "variables": [
    {"id": "var-spread", "name": "Yield_Spread", "equation": "Long_Term_Rate - Short_Term_Rate", "position": {"x": 250, "y": 100}},
    {"id": "var-inverted", "name": "Curve_Inverted", "equation": "IF(Yield_Spread < 0, 1, 0)", "position": {"x": 350, "y": 100}},
    {"id": "var-target-short", "name": "Target_Short_Rate", "equation": "5.5 - 0.05 * TIME", "position": {"x": 100, "y": 100}},
    {"id": "var-policy-lag", "name": "Policy_Lag", "equation": "3", "position": {"x": 50, "y": 200}},
    {"id": "var-expected-short", "name": "Expected_Short_Rate", "equation": "Short_Term_Rate - 0.5", "position": {"x": 400, "y": 100}},
    {"id": "var-term-prem", "name": "Term_Premium", "equation": "0.5", "position": {"x": 500, "y": 100}},
    {"id": "var-expect-lag", "name": "Expectation_Lag", "equation": "6", "position": {"x": 550, "y": 200}},
    {"id": "var-model-prob", "name": "Model_Recession_Prob", "equation": "1 / (1 + EXP(0.5 - 0.6 * Yield_Spread))", "position": {"x": 200, "y": 350}},
    {"id": "var-prob-lag", "name": "Probability_Lag", "equation": "12", "position": {"x": 100, "y": 350}},
    {"id": "var-trend", "name": "Trend_Growth", "equation": "0.02", "position": {"x": 450, "y": 350}},
    {"id": "var-drag", "name": "Recession_Drag", "equation": "0.05 * Recession_Probability", "position": {"x": 550, "y": 350}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 36, "dt": 1},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.2307/3867370",
  "reference": "Estrella, A. & Mishkin, F.S. (1998). Predicting U.S. recessions: Financial variables as leading indicators. IMF Staff Papers, 45(1), 54-87."
}
