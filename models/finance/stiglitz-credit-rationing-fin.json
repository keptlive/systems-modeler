{
  "id": "stiglitz-credit-rationing-fin",
  "name": "Stiglitz-Weiss Credit Rationing Model",
  "description": "Nobel Prize model explaining why banks ration credit even when borrowers would pay higher interest rates. Reference: Rothschild, M., & Stiglitz, J. (1976). Equilibrium in competitive insurance markets. Quarterly Journal of Economics, 90(4), 629-649. DOI: https://doi.org/10.2307/1885326",
  "stocks": [
    {
      "id": "s1",
      "name": "Loan_Applications",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Approved_Loans",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Default_Rate",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Applications",
      "equation": "Base_Demand * (1 - Interest_Rate / Max_Interest)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Approvals",
      "equation": "Loan_Applications * Approval_Rate",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Rejections",
      "equation": "Loan_Applications * (1 - Approval_Rate)",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "f4",
      "name": "Default_Change",
      "equation": "(Adverse_Selection_Effect - Default_Rate) / Adjustment_Time",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 150,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Interest_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Max_Interest",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Base_Demand",
      "equation": "150",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Adverse_Selection_Effect",
      "equation": "0.05 + 0.5 * (Interest_Rate / Max_Interest)",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v5",
      "name": "Expected_Return",
      "equation": "Interest_Rate * (1 - Default_Rate)",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Optimal_Rate",
      "equation": "0.15",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Approval_Rate",
      "equation": "IF(Interest_Rate <= Optimal_Rate, 0.8, 0.8 - 0.5 * (Interest_Rate - Optimal_Rate))",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Adjustment_Time",
      "equation": "4",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Credit_Rationing_Severity",
      "equation": "(Loan_Applications - Approved_Loans) / Loan_Applications",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:26:32.201961+00:00",
  "updated_at": "2026-01-12T11:26:32.201961+00:00",
  "source": "https://doi.org/10.2307/1802787",
  "reference": "Stiglitz JE, Weiss A. Credit rationing in markets with imperfect information. American Economic Review. 1981;71(3):393-410. Nobel Prize 2001."
}