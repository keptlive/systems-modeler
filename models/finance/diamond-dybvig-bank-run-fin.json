{
  "id": "diamond-dybvig-bank-run-fin",
  "name": "Diamond-Dybvig Bank Run Model",
  "description": "Model of bank runs showing multiple equilibria with and without panics. Source: Diamond & Dybvig (1983), JPE. Nobel Prize 2022.",
  "stocks": [
    {
      "id": "s1",
      "name": "Bank_Deposits",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Long_Term_Assets",
      "initial_value": 800,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Panic_Probability",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Normal_Withdrawals",
      "equation": "-Early_Withdrawal_Rate * Bank_Deposits",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Asset_Return",
      "equation": "r_long * Long_Term_Assets - Liquidation_Loss",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Panic_Evolution",
      "equation": "0.1 * (Fundamentals_Weakness - Panic_Probability)",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "r_short",
      "equation": "0.02",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "r_long",
      "equation": "0.08",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "lambda",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Early_Withdrawal_Rate",
      "equation": "0.1 + Panic_Probability * 0.5",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Liquidation_Loss",
      "equation": "IF(Bank_Deposits < Long_Term_Assets * 0.5, 0.3 * Long_Term_Assets, 0)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Fundamentals_Weakness",
      "equation": "MAX(0, 1 - Bank_Deposits / (Long_Term_Assets * 1.1))",
      "position": {
        "x": 300,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Panic_Probability",
      "to_element": "Early_Withdrawal_Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 20,
    "dt": 0.25
  },
  "created_at": "2026-01-15T14:41:20.230241+00:00",
  "updated_at": "2026-01-15T14:41:20.230248+00:00",
  "source": "https://doi.org/10.1086/261155",
  "reference": "Diamond, D.W. & Dybvig, P.H. (1983). Bank runs, deposit insurance, and liquidity. JPE 91:401-419. Nobel Prize 2022."
}