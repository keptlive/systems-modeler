{
  "id": "tobin-q-investment-fin",
  "name": "Tobin Q Investment Model",
  "description": "James Tobin's (1969) Q theory of investment showing that firms invest when market value exceeds replacement cost (Q > 1). Links stock market valuation to real investment decisions. Tobin received the 1981 Nobel Prize.",
  "stocks": [
    {"id": "stock-capital-stock", "name": "Capital Stock", "initial_value": 1000, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-market-value", "name": "Market Value", "initial_value": 1200, "equation": "", "position": {"x": 450, "y": 200}}
  ],
  "flows": [
    {"id": "flow-investment", "name": "Investment", "equation": "Investment_Function * Capital_Stock", "from_stock": null, "to_stock": "stock-capital-stock", "position": {"x": 100, "y": 200}},
    {"id": "flow-depreciation", "name": "Depreciation", "equation": "Depreciation_Rate * Capital_Stock", "from_stock": "stock-capital-stock", "to_stock": null, "position": {"x": 300, "y": 200}},
    {"id": "flow-value-change", "name": "Value Change", "equation": "(Expected_Earnings / Discount_Rate - Market_Value) / Adjustment_Time", "from_stock": null, "to_stock": "stock-market-value", "position": {"x": 350, "y": 200}}
  ],
  "variables": [
    {"id": "var-replacement-cost", "name": "Replacement Cost", "equation": "Capital_Stock * Price_of_Capital", "position": {"x": 200, "y": 100}},
    {"id": "var-price-of-capital", "name": "Price of Capital", "equation": "1", "position": {"x": 400, "y": 100}},
    {"id": "var-tobins-q", "name": "Tobins Q", "equation": "Market_Value / Replacement_Cost", "position": {"x": 550, "y": 100}},
    {"id": "var-investment-function", "name": "Investment Function", "equation": "Investment_Sensitivity * (Tobins_Q - 1)", "position": {"x": 150, "y": 300}},
    {"id": "var-investment-sensitivity", "name": "Investment Sensitivity", "equation": "0.2", "position": {"x": 350, "y": 300}},
    {"id": "var-depreciation-rate", "name": "Depreciation Rate", "equation": "0.1", "position": {"x": 550, "y": 300}},
    {"id": "var-expected-earnings", "name": "Expected Earnings", "equation": "Return_on_Capital * Capital_Stock", "position": {"x": 150, "y": 400}},
    {"id": "var-return-on-capital", "name": "Return on Capital", "equation": "0.15", "position": {"x": 350, "y": 400}},
    {"id": "var-discount-rate", "name": "Discount Rate", "equation": "0.1", "position": {"x": 550, "y": 400}},
    {"id": "var-adjustment-time", "name": "Adjustment Time", "equation": "4", "position": {"x": 350, "y": 480}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 50, "dt": 0.25},
  "source": "https://doi.org/10.1016/0304-3932(78)90006-6",
  "reference": "Tobin J. A General Equilibrium Approach to Monetary Theory. Journal of Money, Credit and Banking. 1969;1(1):15-29."
}
