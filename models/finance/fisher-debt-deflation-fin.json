        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-debt-overhang",
      "name": "Debt Overhang Effect",
      "equation": "Overhang_Sensitivity * MAX(0, Debt_to_GDP - Debt_Threshold)",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
