{
  "id": "fisher-debt-deflation-fin",
  "name": "Fisher Debt Deflation Spiral",
  "description": "When debt is high, falling prices increase real debt burden, leading to more defaults, more deflation, and financial crisis. Explains Great Depression dynamics and motivated QE policies. Reference: APA Clinical Practice Guideline for Depression. Source: https://www.apa.org/depression-guideline",
  "stocks": [
    {
      "id": "stock-debt",
      "name": "Real Debt",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-price-level",
      "name": "Price Level",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-output",
      "name": "Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-debt-change",
      "name": "Real Debt Change",
      "equation": "New_Borrowing - Debt_Repayment - Deflation_Effect",
      "from_stock": null,
      "to_stock": "stock-debt",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "flow-price-change",
      "name": "Price Change",
      "equation": "-Deflation_Rate * Price_Level",
      "from_stock": null,
      "to_stock": "stock-price-level",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-output-change",
      "name": "Output Change",
      "equation": "-Debt_Overhang_Effect * Output",
      "from_stock": null,
      "to_stock": "stock-output",
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-debt-gdp",
      "name": "Debt to GDP",
      "equation": "Real_Debt / Output",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-deflation",
      "name": "Deflation Rate",
      "equation": "MAX(0, Deflation_Sensitivity * (Real_Debt / Output - Debt_Threshold))",
