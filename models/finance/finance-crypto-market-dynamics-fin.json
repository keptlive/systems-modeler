{
  "id": "finance-crypto-market-dynamics-fin",
  "name": "Cryptocurrency Market Dynamics",
  "description": "Models crypto price dynamics with speculation, adoption, and regulatory effects. Based on Liu & Tsyvinski (2021) and crypto market research. Reference: NSIDC Arctic Sea Ice News. Source: https://nsidc.org/arcticseaicenews/",
  "category": "finance",
  "stocks": [
    {
      "id": "stock-price",
      "name": "Crypto_Price_Index",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-hodlers",
      "name": "Long_Term_Holders_M",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-traders",
      "name": "Active_Traders_M",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "stock-sentiment",
      "name": "Market_Sentiment",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-price-change",
      "name": "Price_Change",
      "equation": "Crypto_Price_Index * (Net_Buy_Pressure + Sentiment_Effect) * Volatility",
      "from_stock": null,
      "to_stock": "stock-price",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-new-hodlers",
      "name": "New_Hodlers",
      "equation": "Potential_Market * Adoption_Rate * (1 + Returns / 100)",
      "from_stock": null,
      "to_stock": "stock-hodlers",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-hodler-exit",
      "name": "Hodler_Exit",
      "equation": "Long_Term_Holders_M * Exit_Rate * MAX(0, 1 - Market_Sentiment)",
      "from_stock": "stock-hodlers",
      "to_stock": null,
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-trader-entry",
      "name": "Trader_Entry",
      "equation": "10 * Volatility * Market_Sentiment",
      "from_stock": null,
      "to_stock": "stock-traders",
      "position": {
        "x": 525,
        "y": 200
      }
    },
    {
      "id": "flow-trader-exit",
      "name": "Trader_Exit",
      "equation": "Active_Traders_M * 0.2",
      "from_stock": "stock-traders",
      "to_stock": null,
      "position": {
        "x": 675,
        "y": 200
      }
    },
    {
      "id": "flow-sentiment-change",
      "name": "Sentiment_Change",
      "equation": "(Target_Sentiment - Market_Sentiment) / Sentiment_Lag",
      "from_stock": null,
      "to_stock": "stock-sentiment",
      "position": {
        "x": 325,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-volatility",
      "name": "Volatility",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-adoption",
      "name": "Adoption_Rate",
      "equation": "0.01",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-potential",
      "name": "Potential_Market",
      "equation": "500",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-exit",
      "name": "Exit_Rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-returns",
      "name": "Returns",
      "equation": "(Price_Change / Crypto_Price_Index) * 100",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-buy-pressure",
      "name": "Net_Buy_Pressure",
      "equation": "(Long_Term_Holders_M + Active_Traders_M) / 100 - 0.5",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-sentiment-effect",
      "name": "Sentiment_Effect",
      "equation": "(Market_Sentiment - 0.5) * 0.2",
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "var-target-sentiment",
      "name": "Target_Sentiment",
      "equation": "0.5 + Returns / 200",
      "position": {
        "x": 400,
        "y": 450
      }
    },
    {
      "id": "var-sentiment-lag",
      "name": "Sentiment_Lag",
      "equation": "4",
      "position": {
        "x": 600,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 52,
    "dt": 1
  },
  "source": "https://doi.org/10.1093/rfs/hhaa113",
  "reference": "Liu Y & Tsyvinski A (2021) Risks and Returns of Cryptocurrency. RFS.",
  "connectors": [],
  "created_at": "2026-01-12T06:15:34.762272+00:00",
  "updated_at": "2026-01-12T06:15:34.762272+00:00"
}