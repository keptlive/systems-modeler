{
  "id": "cryptocurrency-market-speculation-fin",
  "name": "Cryptocurrency Market Speculation Dynamics",
  "description": "Model of cryptocurrency price dynamics with speculative bubbles, fundamentals, and adoption. Based on Liu & Tsyvinski 2021 RFS. Reference: NSIDC Arctic Sea Ice News. Source: https://nsidc.org/arcticseaicenews/",
  "stocks": [
    {
      "id": "s1",
      "name": "Market Price",
      "initial_value": 50000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Speculative Capital",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "s3",
      "name": "Adoption Level",
      "initial_value": 0.05,
      "equation": "",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "s4",
      "name": "Network Value",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Price Increase",
      "equation": "Market_Price * (Speculative_Demand + Fundamental_Demand) * 0.01",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "f2",
      "name": "Price Decrease",
      "equation": "Market_Price * Sell_Pressure * 0.01",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "f3",
      "name": "Capital Inflow",
      "equation": "Momentum_Effect * FOMO_Factor * 10",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "f4",
      "name": "Capital Outflow",
      "equation": "Speculative_Capital * (Profit_Taking + Fear_Factor)",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "f5",
      "name": "New Adoption",
      "equation": "(1 - Adoption_Level) * Adoption_Rate * (Utility_Value + Price_Momentum_Effect)",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "f6",
      "name": "Network Growth",
      "equation": "Adoption_Level * Network_Effect_Strength * 100",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Speculative Demand",
      "equation": "Speculative_Capital / 100",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "v2",
      "name": "Fundamental Demand",
      "equation": "Network_Value / Market_Price * 0.1",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "v3",
      "name": "Sell Pressure",
      "equation": "MAX(0, (Market_Price - Network_Value * 50) / Market_Price)",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Momentum Effect",
      "equation": "MAX(0, (Market_Price - 40000) / 10000)",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "v5",
      "name": "FOMO Factor",
      "equation": "1 + Momentum_Effect * 2",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v6",
      "name": "Profit Taking",
      "equation": "MAX(0, (Market_Price - 60000) / 100000)",
      "position": {
        "x": 50,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Fear Factor",
      "equation": "MAX(0, (40000 - Market_Price) / 100000)",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Adoption Rate",
      "equation": "0.01",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "v9",
      "name": "Utility Value",
      "equation": "Adoption_Level * 2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "v10",
      "name": "Price Momentum Effect",
      "equation": "Momentum_Effect * 0.5",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "v11",
      "name": "Network Effect Strength",
      "equation": "SQRT(Adoption_Level)",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v12",
      "name": "Market Cap",
      "equation": "Market_Price * 21000000 * Adoption_Level",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "v13",
      "name": "Bubble Index",
      "equation": "Market_Price / (Network_Value * 50 + 1)",
      "position": {
        "x": 250,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Speculative Capital",
      "to_element": "Speculative Demand"
    },
    {
      "id": "c2",
      "from_element": "Network Value",
      "to_element": "Fundamental Demand"
    },
    {
      "id": "c3",
      "from_element": "Market Price",
      "to_element": "Momentum Effect"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "created_at": "2026-01-15T14:14:19.562105",
  "updated_at": "2026-01-15T14:14:19.562116",
  "source": "https://doi.org/10.1093/rfs/hhaa059",
  "reference": "Liu Y, Tsyvinski A. Risks and Returns of Cryptocurrency. Review of Financial Studies. 2021;34(6):2689-2727."
}