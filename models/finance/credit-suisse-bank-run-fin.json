{
  "id": "credit-suisse-bank-run-fin",
  "name": "Bank Run and Confidence Crisis Model",
  "description": "Model of bank run dynamics as seen in Credit Suisse 2023 and Silicon Valley Bank. Deposit flight accelerates when confidence falls below threshold, creating self-fulfilling prophecy. Source: Diamond & Dybvig (1983). JPE. DOI: 10.1086/261155",
  "stocks": [
    {"id": "stock-deposits", "name": "Total_Deposits", "initial_value": 100000, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-confidence", "name": "Depositor_Confidence", "initial_value": 0.9, "equation": "", "position": {"x": 400, "y": 200}},
    {"id": "stock-liquid", "name": "Liquid_Assets", "initial_value": 20000, "equation": "", "position": {"x": 200, "y": 350}}
  ],
  "flows": [
    {"id": "flow-withdrawal", "name": "Net_Withdrawals", "equation": "Total_Deposits * Withdrawal_Rate", "from_stock": "stock-deposits", "to_stock": null, "position": {"x": 100, "y": 200}},
    {"id": "flow-confidence", "name": "Confidence_Change", "equation": "(Target_Confidence - Depositor_Confidence) / Confidence_Adjustment_Time", "from_stock": null, "to_stock": "stock-confidence", "position": {"x": 500, "y": 200}},
    {"id": "flow-asset-sale", "name": "Asset_Liquidation", "equation": "IF(Liquid_Assets < Total_Deposits * Required_Liquidity_Ratio, Asset_Fire_Sale_Rate, 0)", "from_stock": null, "to_stock": "stock-liquid", "position": {"x": 100, "y": 350}}
  ],
  "variables": [
    {"id": "var-withdraw-rate", "name": "Withdrawal_Rate", "equation": "Base_Withdrawal * (1 + Panic_Multiplier * (1 - Depositor_Confidence))", "position": {"x": 100, "y": 100}},
    {"id": "var-base-withdraw", "name": "Base_Withdrawal", "equation": "0.02", "position": {"x": 200, "y": 100}},
    {"id": "var-panic-mult", "name": "Panic_Multiplier", "equation": "5", "position": {"x": 300, "y": 100}},
    {"id": "var-target-conf", "name": "Target_Confidence", "equation": "MIN(1, Liquidity_Ratio / Required_Liquidity_Ratio)", "position": {"x": 450, "y": 100}},
    {"id": "var-liquidity-ratio", "name": "Liquidity_Ratio", "equation": "Liquid_Assets / Total_Deposits", "position": {"x": 300, "y": 350}},
    {"id": "var-required-ratio", "name": "Required_Liquidity_Ratio", "equation": "0.15", "position": {"x": 400, "y": 350}},
    {"id": "var-conf-adj-time", "name": "Confidence_Adjustment_Time", "equation": "7", "position": {"x": 500, "y": 300}},
    {"id": "var-fire-sale", "name": "Asset_Fire_Sale_Rate", "equation": "1000", "position": {"x": 150, "y": 400}},
    {"id": "var-insolvency", "name": "Insolvency_Risk", "equation": "IF(Liquid_Assets < 0 OR Depositor_Confidence < 0.3, 1, 0)", "position": {"x": 350, "y": 400}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 30, "dt": 0.25},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1086/261155",
  "reference": "Diamond, D.W. & Dybvig, P.H. (1983). Bank runs, deposit insurance, and liquidity. Journal of Political Economy, 91(3), 401-419."
}
