{
  "id": "stiglitz-weiss-credit-rationing-fin",
  "name": "Stiglitz-Weiss Credit Rationing Model",
  "description": "Model of credit rationing under asymmetric information. Source: Stiglitz & Weiss (1981), AER. Nobel Prize 2001. Reference: Rothschild, M., & Stiglitz, J. (1976). Equilibrium in competitive insurance markets. Quarterly Journal of Economics, 90(4), 629-649. DOI: https://doi.org/10.2307/1885326",
  "stocks": [
    {
      "id": "s1",
      "name": "Credit_Supply",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Credit_Demand",
      "initial_value": 150,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Interest_Rate",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Supply_Adjustment",
      "equation": "0.1 * (Expected_Return * 1000 - Credit_Supply)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Demand_Adjustment",
      "equation": "-50 * (Interest_Rate - 0.1)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Rate_Dynamics",
      "equation": "IF(Credit_Demand > Credit_Supply, 0.01, -0.01) * (1 - Adverse_Selection)",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Base_Repay_Prob",
      "equation": "0.9",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Risk_Premium",
      "equation": "0.02",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Optimal_Rate",
      "equation": "0.12",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Adverse_Selection",
      "equation": "MIN(1, MAX(0, (Interest_Rate - 0.1) / 0.05))",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Repayment_Prob",
      "equation": "Base_Repay_Prob * (1 - 0.5 * Adverse_Selection)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Expected_Return",
      "equation": "Interest_Rate * Repayment_Prob",
      "position": {
        "x": 300,
        "y": 420
      }
    },
    {
      "id": "v7",
      "name": "Credit_Rationing",
      "equation": "MAX(0, Credit_Demand - Credit_Supply)",
      "position": {
        "x": 500,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Interest_Rate",
      "to_element": "Adverse_Selection"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-15T14:41:20.230336+00:00",
  "updated_at": "2026-01-15T14:41:20.230340+00:00",
  "source": "https://doi.org/10.2307/1802787",
  "reference": "Stiglitz, J.E. & Weiss, A. (1981). Credit Rationing in Markets with Imperfect Information. AER 71:393-410. Nobel Prize 2001."
}