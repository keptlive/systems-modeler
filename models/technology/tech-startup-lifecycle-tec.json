{
  "id": "tech-startup-lifecycle-tec",
  "name": "Technology Startup Growth Lifecycle",
  "description": "Models the stages of tech startup growth from founding to scale-up or failure. Based on Blank (2013) The Four Steps to the Epiphany. Reference: Blank, S. (2013). The Four Steps to the Epiphany. K&S Ranch. Source: https://steveblank.com/",
  "category": "technology",
  "stocks": [
    {
      "id": "stock-cash",
      "name": "Cash_Runway_Months",
      "initial_value": 18,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-users",
      "name": "Active_Users_K",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-product",
      "name": "Product_Market_Fit",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "stock-team",
      "name": "Team_Size",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-burn",
      "name": "Cash_Burn",
      "equation": "Team_Size * Burn_Per_Person + Marketing_Spend",
      "from_stock": "stock-cash",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-funding",
      "name": "Funding_Round",
      "equation": "IF(Product_Market_Fit > PMF_Threshold AND Cash_Runway_Months < 6, Funding_Amount/Monthly_Burn, 0)",
      "from_stock": null,
      "to_stock": "stock-cash",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-acquire",
      "name": "User_Acquisition",
      "equation": "Marketing_Spend * Acquisition_Efficiency * Product_Market_Fit/100",
      "from_stock": null,
      "to_stock": "stock-users",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "flow-churn",
      "name": "User_Churn",
      "equation": "Active_Users_K * Churn_Rate * (100 - Product_Market_Fit)/100",
      "from_stock": "stock-users",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "flow-pmf-improve",
      "name": "PMF_Improvement",
      "equation": "(Team_Size * Dev_Effectiveness + User_Feedback * Active_Users_K) * Learning_Rate",
      "from_stock": null,
      "to_stock": "stock-product",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "flow-hire",
      "name": "Hiring",
      "equation": "IF(Cash_Runway_Months > 12 AND Product_Market_Fit > 30, Hiring_Rate, 0)",
      "from_stock": null,
      "to_stock": "stock-team",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "flow-attrition",
      "name": "Attrition",
      "equation": "Team_Size * Attrition_Rate",
      "from_stock": "stock-team",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-burn-per",
      "name": "Burn_Per_Person",
      "equation": "0.8",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-marketing",
      "name": "Marketing_Spend",
      "equation": "2",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-pmf-thresh",
      "name": "PMF_Threshold",
      "equation": "50",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-funding",
      "name": "Funding_Amount",
      "equation": "36",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-burn",
      "name": "Monthly_Burn",
      "equation": "Team_Size * Burn_Per_Person + Marketing_Spend",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-acq-eff",
      "name": "Acquisition_Efficiency",
      "equation": "0.5",
      "position": {
        "x": 150,
        "y": 400
      }
    },
    {
      "id": "var-churn",
      "name": "Churn_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "var-dev-eff",
      "name": "Dev_Effectiveness",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "var-feedback",
      "name": "User_Feedback",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 400
      }
    },
    {
      "id": "var-learn",
      "name": "Learning_Rate",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 400
      }
    },
    {
      "id": "var-hire-rate",
      "name": "Hiring_Rate",
      "equation": "0.5",
      "position": {
        "x": 650,
        "y": 400
      }
    },
    {
      "id": "var-attrition",
      "name": "Attrition_Rate",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 60,
    "dt": 1
  },
  "source": "https://steveblank.com/books-for-startups/",
