{
  "id": "large-language-model-scaling-tec",
  "name": "Large Language Model Scaling Laws",
  "description": "Model of neural scaling laws for large language models. Loss decreases as a power law with compute, data, and parameters (Chinchilla scaling). Source: Hoffmann et al. (2022). arXiv. DOI: 10.48550/arXiv.2203.15556",
  "stocks": [
    {"id": "stock-compute", "name": "Total_Compute_FLOPs", "initial_value": 1000000000000000000000, "equation": "", "position": {"x": 150, "y": 200}},
    {"id": "stock-params", "name": "Model_Parameters", "initial_value": 1000000000, "equation": "", "position": {"x": 350, "y": 200}},
    {"id": "stock-data", "name": "Training_Tokens", "initial_value": 100000000000, "equation": "", "position": {"x": 550, "y": 200}}
  ],
  "flows": [
    {"id": "flow-compute-growth", "name": "Compute_Growth", "equation": "Total_Compute_FLOPs * Compute_Growth_Rate", "from_stock": null, "to_stock": "stock-compute", "position": {"x": 100, "y": 200}},
    {"id": "flow-param-growth", "name": "Parameter_Scaling", "equation": "Model_Parameters * Param_Growth_Rate", "from_stock": null, "to_stock": "stock-params", "position": {"x": 300, "y": 200}},
    {"id": "flow-data-growth", "name": "Data_Scaling", "equation": "Training_Tokens * Data_Growth_Rate", "from_stock": null, "to_stock": "stock-data", "position": {"x": 500, "y": 200}}
  ],
  "variables": [
    {"id": "var-compute-rate", "name": "Compute_Growth_Rate", "equation": "0.3", "position": {"x": 100, "y": 100}},
    {"id": "var-param-rate", "name": "Param_Growth_Rate", "equation": "0.15", "position": {"x": 300, "y": 100}},
    {"id": "var-data-rate", "name": "Data_Growth_Rate", "equation": "0.15", "position": {"x": 500, "y": 100}},
    {"id": "var-alpha", "name": "Compute_Exponent", "equation": "0.34", "position": {"x": 150, "y": 350}},
    {"id": "var-beta", "name": "Param_Exponent", "equation": "0.34", "position": {"x": 350, "y": 350}},
    {"id": "var-gamma", "name": "Data_Exponent", "equation": "0.28", "position": {"x": 550, "y": 350}},
    {"id": "var-loss", "name": "Predicted_Loss", "equation": "6.8 * Total_Compute_FLOPs^(-Compute_Exponent/10) + 0.3", "position": {"x": 300, "y": 300}},
    {"id": "var-optimal-params", "name": "Chinchilla_Optimal_Params", "equation": "0.71 * Total_Compute_FLOPs^0.5", "position": {"x": 200, "y": 400}},
    {"id": "var-optimal-tokens", "name": "Chinchilla_Optimal_Tokens", "equation": "1.4 * Total_Compute_FLOPs^0.5", "position": {"x": 450, "y": 400}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 10, "dt": 0.5},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.48550/arXiv.2203.15556",
  "reference": "Hoffmann, J. et al. (2022). Training Compute-Optimal Large Language Models. arXiv:2203.15556."
}
