{
  "id": "moore-technology-adoption-tec",
  "name": "Moore Technology Adoption Lifecycle",
  "description": "Geoffrey Moore's model of technology adoption showing the 'chasm' between early adopters and mainstream. Reference: Moore, G.A. (1991). Crossing the Chasm.",
  "stocks": [
    {
      "id": "s1",
      "name": "Innovators",
      "initial_value": 25,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Early_Adopters",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Early_Majority",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Late_Majority",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 750,
        "y": 200
      }
    },
    {
      "id": "s5",
      "name": "Laggards",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 950,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Innovator_Adoption",
      "equation": "Potential_Innovators * Innovation_Rate",
      "from_stock": null,
      "to_stock": "Innovators",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Early_Adoption",
      "equation": "Innovators * Word_of_Mouth * 0.5",
      "from_stock": null,
      "to_stock": "Early_Adopters",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Chasm_Crossing",
      "equation": "IF Early_Adopters > Chasm_Threshold THEN Early_Adopters * Chasm_Rate ELSE 0",
      "from_stock": null,
      "to_stock": "Early_Majority",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Mainstream_Adoption",
      "equation": "Early_Majority * Mainstream_Rate",
      "from_stock": null,
      "to_stock": "Late_Majority",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "f5",
      "name": "Laggard_Adoption",
      "equation": "Late_Majority * Laggard_Rate",
      "from_stock": null,
      "to_stock": "Laggards",
      "position": {
        "x": 700,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Total_Market",
      "equation": "1000",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Potential_Innovators",
      "equation": "Total_Market * 0.025 - Innovators",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Innovation_Rate",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Word_of_Mouth",
      "equation": "0.05",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Chasm_Threshold",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Chasm_Rate",
      "equation": "0.02",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Mainstream_Rate",
      "equation": "0.03",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Laggard_Rate",
      "equation": "0.01",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Total_Adopted",
      "equation": "Innovators + Early_Adopters + Early_Majority + Late_Majority + Laggards",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v10",
      "name": "Penetration_Rate",
      "equation": "Total_Adopted / Total_Market",
      "position": {
        "x": 250,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 1
  },
