{
  "id": "ai-capability-progress-tec",
  "name": "AI Capability Progress Model",
  "description": "Model of AI advancement. Source: Sevilla et al. (2022); Kaplan et al. (2020), Scaling Laws.",
  "stocks": [
    {
      "id": "stock-compute",
      "name": "Compute",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-cap",
      "name": "AI_Capability",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-compute",
      "name": "Compute_Growth",
      "equation": "Compute * Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-compute",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-cap",
      "name": "Capability_Growth",
      "equation": "Compute * Scaling * (Ceiling - AI_Capability) / Ceiling",
      "from_stock": null,
      "to_stock": "stock-cap",
      "position": {
        "x": 200,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-growth",
      "name": "Growth_Rate",
      "equation": "0.3",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-scale",
      "name": "Scaling",
      "equation": "0.01",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-ceiling",
      "name": "Ceiling",
      "equation": "1000",
      "position": {
        "x": 300,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.25
  },
