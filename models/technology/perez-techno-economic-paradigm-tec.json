        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Installation_Rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Deployment_Rate",
      "equation": "0.03",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Financial_Capital",
      "equation": "1 + Financial_Bubble / 100",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Speculation_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Turning_Point",
      "equation": "50",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Crash_Rate",
      "equation": "0.2",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Paradigm_Maturity",
      "equation": "Deployment / (Technological_Potential + Installation + Deployment)",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v10",
      "name": "Surge_Phase",
