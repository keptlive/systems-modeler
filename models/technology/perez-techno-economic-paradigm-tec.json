{
  "id": "perez-techno-economic-paradigm-tec",
  "name": "Perez Techno-Economic Paradigm Model",
  "description": "Carlota Perez's model of technological revolutions and financial capital dynamics. Reference: Perez, C. (2002). Technological Revolutions and Financial Capital.",
  "stocks": [
    {
      "id": "s1",
      "name": "Technological_Potential",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Installation",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Deployment",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Financial_Bubble",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 750,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Tech_Development",
      "equation": "RD_Investment * Innovation_Rate",
      "from_stock": null,
      "to_stock": "Technological_Potential",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Installation_Phase",
      "equation": "Technological_Potential * Installation_Rate * Financial_Capital",
      "from_stock": "Technological_Potential",
      "to_stock": "Installation",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Deployment_Phase",
      "equation": "IF time > Turning_Point THEN Installation * Deployment_Rate ELSE 0",
      "from_stock": "Installation",
      "to_stock": "Deployment",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Bubble_Formation",
      "equation": "IF time < Turning_Point THEN Installation * Speculation_Rate ELSE -Financial_Bubble * Crash_Rate",
      "from_stock": null,
      "to_stock": "Financial_Bubble",
      "position": {
        "x": 550,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "RD_Investment",
      "equation": "5",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Innovation_Rate",
      "equation": "0.05",
      "position": {
