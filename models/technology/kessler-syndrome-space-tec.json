{
  "id": "kessler-syndrome-space-tec",
  "name": "Kessler Syndrome Space Debris",
  "description": "Cascading collisions in orbit create debris that causes more collisions. Above critical density, debris growth becomes self-sustaining. Threatens space infrastructure. Reference: ASCE (2021). Infrastructure Report Card. American Society of Civil Engineers. Source: https://infrastructurereportcard.org/",
  "stocks": [
    {
      "id": "stock-debris",
      "name": "Debris Objects",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-satellites",
      "name": "Active Satellites",
      "initial_value": 3000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-debris-creation",
      "name": "New Debris",
      "equation": "Collision_Rate * Fragments_Per_Collision + Launch_Debris",
      "from_stock": null,
      "to_stock": "stock-debris",
      "position": {
        "x": 80,
        "y": 150
      }
    },
    {
      "id": "flow-debris-decay",
      "name": "Atmospheric Decay",
      "equation": "Decay_Rate * Debris_Objects",
      "from_stock": "stock-debris",
      "to_stock": null,
      "position": {
        "x": 80,
        "y": 250
      }
    },
    {
      "id": "flow-launches",
      "name": "New Satellites",
      "equation": "Launch_Rate",
      "from_stock": null,
      "to_stock": "stock-satellites",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "flow-losses",
      "name": "Satellite Losses",
      "equation": "Collision_Rate * Satellite_Vulnerability + End_of_Life_Rate * Active_Satellites",
      "from_stock": "stock-satellites",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-collision-rate",
      "name": "Collision Rate",
      "equation": "Collision_Probability * Debris_Objects * Active_Satellites / Orbital_Volume",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-collision-prob",
      "name": "Collision Probability",
      "equation": "0.00001",
      "position": {
        "x": 350,
        "y": 80
      }
    },
    {
      "id": "var-fragments",
      "name": "Fragments Per Collision",
      "equation": "1000",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-orbital-volume",
      "name": "Orbital Volume",
      "equation": "1e12",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-decay-rate",
      "name": "Decay Rate",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-launch-rate",
      "name": "Launch Rate",
      "equation": "1000",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-launch-debris",
      "name": "Launch Debris",
      "equation": "Launch_Rate * 5",
      "position": {
        "x": 100,
        "y": 420
      }
    },
    {
      "id": "var-sat-vulnerability",
      "name": "Satellite Vulnerability",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 420
      }
    },
    {
      "id": "var-eol-rate",
      "name": "End of Life Rate",
      "equation": "0.05",
      "position": {
        "x": 550,
        "y": 420
      }
    },
    {
      "id": "var-critical-density",
      "name": "Critical Density",
      "equation": "IF(Collision_Rate * Fragments_Per_Collision > Decay_Rate * Debris_Objects, 1, 0)",
      "position": {
        "x": 300,
        "y": 490
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Debris Objects",
      "to_element": "Collision Rate"
    },
    {
      "id": "conn-2",
      "from_element": "Active Satellites",
      "to_element": "Collision Rate"
    },
    {
      "id": "conn-3",
      "from_element": "Collision Rate",
      "to_element": "New Debris"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T07:48:28.113805+00:00",
  "updated_at": "2026-01-12T07:48:28.113808+00:00",
  "source": "https://doi.org/10.1029/JA083iA06p02637",
  "reference": "Kessler DJ, Cour-Palais BG. Collision Frequency of Artificial Satellites: The Creation of a Debris Belt. Journal of Geophysical Research. 1978;83(A6):2637-2646."
}