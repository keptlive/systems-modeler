{
  "id": "technology-s-curve-adoption-tec",
  "name": "Technology S-Curve Adoption Model",
  "description": "Models technology adoption following S-curve diffusion pattern. Based on Rogers (2003) and Foster (1986). Reference: Rogers, E. M. (2003). Diffusion of Innovations (5th ed.). Free Press.",
  "stocks": [
    {
      "id": "stock-adopters",
      "name": "Technology_Adopters",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-potential",
      "name": "Potential_Adopters",
      "initial_value": 995,
      "equation": "",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "stock-performance",
      "name": "Technology_Performance",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "stock-investment",
      "name": "R_and_D_Investment",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-adopt",
      "name": "New_Adoption",
      "equation": "Potential_Adopters * Adoption_Rate * Word_of_Mouth_Effect",
      "from_stock": "stock-potential",
      "to_stock": "stock-adopters",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-abandon",
      "name": "Abandonment",
      "equation": "Technology_Adopters * Obsolescence_Rate",
      "from_stock": "stock-adopters",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-improve",
      "name": "Performance_Improvement",
      "equation": "R_and_D_Investment * Learning_Effect * (1 - Technology_Performance / Performance_Limit)",
      "from_stock": null,
      "to_stock": "stock-performance",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "flow-invest",
      "name": "Investment_Flow",
      "equation": "Technology_Adopters * Investment_per_Adopter",
      "from_stock": null,
      "to_stock": "stock-investment",
      "position": {
        "x": 400,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-adoptrate",
      "name": "Adoption_Rate",
      "equation": "Base_Adoption * (1 + Technology_Performance / 50)",
      "position": {
        "x": 100,
        "y": 175
      }
    },
    {
      "id": "var-baseadopt",
      "name": "Base_Adoption",
      "equation": "0.01",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-wom",
      "name": "Word_of_Mouth_Effect",
      "equation": "1 + 0.1 * LN(Technology_Adopters / 5 + 1)",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-obsrate",
      "name": "Obsolescence_Rate",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-learneff",
      "name": "Learning_Effect",
      "equation": "0.1 * LN(R_and_D_Investment / 10 + 1)",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "var-perflimit",
      "name": "Performance_Limit",
      "equation": "100",
      "position": {
        "x": 200,
        "y": 325
      }
    },
    {
      "id": "var-investper",
      "name": "Investment_per_Adopter",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-marketpen",
      "name": "Market_Penetration",
      "equation": "Technology_Adopters / 1000",
      "position": {
        "x": 350,
        "y": 175
      }
    },
    {
      "id": "var-scurvestage",
      "name": "S_Curve_Stage",
      "equation": "IF(Market_Penetration < 0.1, 1, IF(Market_Penetration < 0.5, 2, IF(Market_Penetration < 0.9, 3, 4)))",
      "position": {
        "x": 100,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Technology_Adopters",
      "to_element": "Word_of_Mouth_Effect"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5,
    "integration_method": "radau"
  },
  "created_at": "2026-01-12T02:49:51.600372+00:00",
  "updated_at": "2026-01-12T02:49:51.600380+00:00",
  "source": "https://doi.org/10.1287/mnsc.32.10.1205",
  "reference": "Rogers EM (2003). Diffusion of Innovations, 5th ed. Free Press. Foster RN (1986). Innovation: The Attacker's Advantage."
}
