{
  "id": "ransomware-attack-spread-tec",
  "name": "Ransomware Attack Spread Model",
  "description": "Model of ransomware propagation in networks. Source: Verizon DBIR; CISA guidance.",
  "stocks": [
    {
      "id": "stock-vuln",
      "name": "Vulnerable_Systems",
      "initial_value": 9000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-infected",
      "name": "Infected_Systems",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered_Systems",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infect",
      "name": "Infection",
      "equation": "Infection_Rate * Vulnerable_Systems * Infected_Systems / Total",
      "from_stock": "stock-vuln",
      "to_stock": "stock-infected",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-patch",
      "name": "Patching",
      "equation": "Vulnerable_Systems * Patch_Rate",
      "from_stock": "stock-vuln",
      "to_stock": "stock-recovered",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-recover",
      "name": "Recovery",
      "equation": "Infected_Systems * Recovery_Rate * Response_Team",
      "from_stock": "stock-infected",
      "to_stock": "stock-recovered",
      "position": {
        "x": 325,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-infrate",
      "name": "Infection_Rate",
      "equation": "0.3",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "var-patch",
      "name": "Patch_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-recrate",
      "name": "Recovery_Rate",
      "equation": "0.05",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "var-response",
      "name": "Response_Team",
      "equation": "1 + 0.5 * IF(Infected_Systems > 100, 1, 0)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-total",
      "name": "Total",
      "equation": "Vulnerable_Systems + Infected_Systems + Recovered_Systems",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.1
  },
  "created_at": "2026-01-12T12:53:13.193229+00:00",
  "updated_at": "2026-01-12T12:53:13.193229+00:00",
  "source": "https://doi.org/10.1016/j.cose.2017.10.010",
  "reference": "Kharraz A, et al. Cutting the Gordian Knot: A Look Under the Hood of Ransomware Attacks. DIMVA; 2015."
}