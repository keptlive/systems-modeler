{
  "id": "technology-ai-automation-impact-tec",
  "name": "AI Automation Labor Market Impact",
  "description": "Models the displacement and creation of jobs due to AI automation. Based on Acemoglu & Restrepo (2020) and Frey & Osborne (2017). DOI: 10.1257/jel.20191246",
  "category": "technology",
  "stocks": [
    {
      "id": "stock-routine",
      "name": "Routine_Jobs_Millions",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-nonroutine",
      "name": "Non_Routine_Jobs",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-ai-jobs",
      "name": "AI_Related_Jobs",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-unemployed",
      "name": "Displaced_Workers",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "stock-ai-capability",
      "name": "AI_Capability_Index",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-automation",
      "name": "Job_Automation",
      "equation": "Routine_Jobs_Millions * Automation_Rate * AI_Capability_Index / 100",
      "from_stock": "stock-routine",
      "to_stock": null,
      "position": {
        "x": 25,
        "y": 200
      }
    },
    {
      "id": "flow-displacement",
      "name": "Worker_Displacement",
      "equation": "Job_Automation",
      "from_stock": null,
      "to_stock": "stock-unemployed",
      "position": {
        "x": 100,
        "y": 275
      }
    },
    {
      "id": "flow-retraining",
      "name": "Retraining",
      "equation": "Displaced_Workers * Retraining_Rate",
      "from_stock": "stock-unemployed",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "flow-ai-jobs",
      "name": "New_AI_Jobs",
      "equation": "AI_Investment * Jobs_Per_Investment",
      "from_stock": null,
      "to_stock": "stock-ai-jobs",
      "position": {
        "x": 425,
        "y": 200
      }
    },
    {
      "id": "flow-ai-progress",
      "name": "AI_Capability_Growth",
      "equation": "AI_Capability_Index * AI_Progress_Rate",
      "from_stock": null,
      "to_stock": "stock-ai-capability",
      "position": {
        "x": 325,
        "y": 350
      }
    },
    {
      "id": "flow-augmentation",
      "name": "Job_Augmentation",
      "equation": "AI_Investment * Augmentation_Factor",
      "from_stock": null,
      "to_stock": "stock-nonroutine",
      "position": {
        "x": 350,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-auto-rate",
      "name": "Automation_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-retrain",
      "name": "Retraining_Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-investment",
      "name": "AI_Investment",
      "equation": "100",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-jobs-per",
      "name": "Jobs_Per_Investment",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-progress",
      "name": "AI_Progress_Rate",
      "equation": "0.15",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-augment",
      "name": "Augmentation_Factor",
      "equation": "0.005",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-total-jobs",
      "name": "Total_Employment",
      "equation": "Routine_Jobs_Millions + Non_Routine_Jobs + AI_Related_Jobs",
      "position": {
        "x": 400,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2050,
    "dt": 1
  },
  "source": "https://doi.org/10.1257/jel.20191246",
  "reference": "Acemoglu D & Restrepo P (2020) Robots and Jobs: Evidence from US Labor Markets. JEL.",
  "connectors": [],
  "created_at": "2026-01-12T06:10:19.344915+00:00",
  "updated_at": "2026-01-12T06:10:19.344915+00:00"
}