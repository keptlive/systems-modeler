{
  "id": "semiconductor-yield-learning-curve-tec",
  "name": "Semiconductor Manufacturing Yield Model",
  "description": "Model of semiconductor fab yield improvement with production volume. Source: Weber (2004), IEEE Trans Semiconductor Manufacturing.",
  "stocks": [
    {
      "id": "s1",
      "name": "Cumulative_Wafers",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Yield",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Defect_Density",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Production",
      "equation": "Production_Rate",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Yield_Improvement",
      "equation": "Learning_Effect * (1 - Yield)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Defect_Reduction",
      "equation": "-Defect_Learning * Defect_Density * Production_Rate / Cumulative_Wafers",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Production_Rate",
      "equation": "100",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Die_Area",
      "equation": "100",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Defect_Learning",
      "equation": "0.2",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Learning_Effect",
      "equation": "0.1 * Production_Rate / Cumulative_Wafers",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Poisson_Yield",
      "equation": "EXP(-Defect_Density * Die_Area / 1000)",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Good_Die_Per_Wafer",
      "equation": "Yield * 1000 / Die_Area",
      "position": {
        "x": 300,
        "y": 420
      }
    },
    {
      "id": "v7",
      "name": "Cost_Per_Die",
      "equation": "1000 / (Good_Die_Per_Wafer + 0.1)",
      "position": {
        "x": 500,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Defect_Density",
      "to_element": "Poisson_Yield"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "created_at": "2026-01-15T14:44:54.461119+00:00",
  "updated_at": "2026-01-15T14:44:54.461122+00:00",
  "source": "https://doi.org/10.1109/TSM.2004.836657",
  "reference": "Weber, C.M. (2004). Yield learning and the sources of profitability in semiconductor manufacturing. IEEE Trans Semiconductor Manufacturing 17:590-596."
}