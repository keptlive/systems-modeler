{
  "id": "arthur-increasing-returns-tec",
  "name": "Arthur Increasing Returns Model",
  "description": "W. Brian Arthur's model of increasing returns and path dependence in technology adoption. Reference: Arthur, W.B. (1989). Competing Technologies, Increasing Returns.",
  "stocks": [
    {
      "id": "s1",
      "name": "Tech_A_Adopters",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Tech_B_Adopters",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Uncommitted",
      "initial_value": 980,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Adopt_A",
      "equation": "Uncommitted * Prob_Choose_A * Adoption_Rate",
      "from_stock": "Uncommitted",
      "to_stock": "Tech_A_Adopters",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Adopt_B",
      "equation": "Uncommitted * (1 - Prob_Choose_A) * Adoption_Rate",
      "from_stock": "Uncommitted",
      "to_stock": "Tech_B_Adopters",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Total_Adopters",
      "equation": "Tech_A_Adopters + Tech_B_Adopters",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Share_A",
      "equation": "Tech_A_Adopters / MAX(1, Total_Adopters)",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Share_B",
      "equation": "Tech_B_Adopters / MAX(1, Total_Adopters)",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Base_Utility_A",
      "equation": "10",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Base_Utility_B",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Network_Effect",
      "equation": "0.5",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Utility_A",
      "equation": "Base_Utility_A + Network_Effect * Tech_A_Adopters",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Utility_B",
      "equation": "Base_Utility_B + Network_Effect * Tech_B_Adopters",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Prob_Choose_A",
      "equation": "Utility_A / (Utility_A + Utility_B)",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v10",
      "name": "Adoption_Rate",
      "equation": "0.05",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "v11",
      "name": "Lock_In",
      "equation": "IF Share_A > 0.9 OR Share_B > 0.9 THEN 1 ELSE 0",
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 1
  },
  "source": "https://doi.org/10.2307/2234208",
  "reference": "Arthur, W.B. (1989). Competing Technologies, Increasing Returns, and Lock-In by Historical Events. Economic Journal, 99(394), 116-131.",
