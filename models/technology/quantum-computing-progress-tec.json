      "to_stock": "stock-qubits",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-error-improvement",
      "name": "Error Improvement",
      "equation": "Error_Rate * Error_Reduction_Rate * R_and_D_Investment / 1000",
      "from_stock": "stock-error-rate",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "flow-algorithm-development",
      "name": "Algorithm Development",
      "equation": "Algorithm_Discovery_Rate * Quantum_Utility * Research_Community_Size",
      "from_stock": null,
      "to_stock": "stock-algorithms",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "flow-commercialization",
      "name": "Commercialization",
      "equation": "IF(Quantum_Utility > Utility_Threshold, Commercial_Adoption_Rate * Useful_Algorithms * Market_Pull, 0)",
      "from_stock": null,
      "to_stock": "stock-commercial",
      "position": {
        "x": 400,
        "y": 500
      }
    },
    {
      "id": "flow-investment-growth",
      "name": "Investment Growth",
      "equation": "R_and_D_Investment * Investment_Growth_Rate * (1 + Commercial_Applications * 0.1)",
      "from_stock": null,
      "to_stock": "stock-investment",
      "position": {
        "x": 100,
        "y": 400
      }
    }
  ],
