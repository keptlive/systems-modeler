{
  "id": "technology-social-media-engagement-tec",
  "name": "Social Media Platform Engagement Dynamics",
  "description": "Models user engagement loops, content virality, and platform health metrics. Based on Facebook/Meta research and Allcott et al. (2020) welfare effects. Reference: Parker, G. G., et al. (2016). Platform Revolution. Norton. Source: https://www.wwnorton.com/",
  "category": "technology",
  "stocks": [
    {
      "id": "stock-users",
      "name": "Monthly_Active_Users_M",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-content",
      "name": "Daily_Content_Posts_M",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-engagement",
      "name": "Avg_Daily_Minutes",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-toxic-content",
      "name": "Toxic_Content_Pct",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-user-growth",
      "name": "User_Growth",
      "equation": "Monthly_Active_Users_M * User_Growth_Rate * Network_Effect",
      "from_stock": null,
      "to_stock": "stock-users",
      "position": {
        "x": 25,
        "y": 200
      }
    },
    {
      "id": "flow-user-churn",
      "name": "User_Churn",
      "equation": "Monthly_Active_Users_M * Churn_Rate * (1 + Toxic_Content_Pct / 10)",
      "from_stock": "stock-users",
      "to_stock": null,
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-content-creation",
      "name": "Content_Creation",
      "equation": "Monthly_Active_Users_M * Content_Per_User * Creator_Incentive",
      "from_stock": null,
      "to_stock": "stock-content",
      "position": {
        "x": 225,
        "y": 200
      }
    },
    {
      "id": "flow-content-decay",
      "name": "Content_Decay",
      "equation": "Daily_Content_Posts_M / Content_Lifetime",
      "from_stock": "stock-content",
      "to_stock": null,
      "position": {
        "x": 375,
        "y": 200
      }
    },
    {
      "id": "flow-engagement-change",
      "name": "Engagement_Change",
      "equation": "(Target_Engagement - Avg_Daily_Minutes) / Engagement_Adj_Time",
      "from_stock": null,
      "to_stock": "stock-engagement",
      "position": {
        "x": 425,
        "y": 200
      }
    },
    {
      "id": "flow-toxicity-growth",
      "name": "Toxicity_Growth",
      "equation": "Toxic_Content_Pct * Toxicity_Amplification * (Avg_Daily_Minutes / 30)",
      "from_stock": null,
      "to_stock": "stock-toxic-content",
      "position": {
        "x": 225,
        "y": 350
      }
    },
    {
      "id": "flow-moderation",
      "name": "Moderation",
      "equation": "Toxic_Content_Pct * Moderation_Rate",
      "from_stock": "stock-toxic-content",
      "to_stock": null,
      "position": {
        "x": 375,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-user-growth",
      "name": "User_Growth_Rate",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-network",
      "name": "Network_Effect",
      "equation": "1 + LOG(Monthly_Active_Users_M / 100)",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-churn",
      "name": "Churn_Rate",
      "equation": "0.02",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-content-per",
      "name": "Content_Per_User",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-incentive",
      "name": "Creator_Incentive",
      "equation": "1.2",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-content-life",
      "name": "Content_Lifetime",
      "equation": "7",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-target-eng",
      "name": "Target_Engagement",
      "equation": "30 * (1 + Daily_Content_Posts_M / 100)",
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "var-eng-adj",
      "name": "Engagement_Adj_Time",
      "equation": "4",
      "position": {
        "x": 350,
        "y": 450
      }
    },
    {
      "id": "var-toxic-amp",
      "name": "Toxicity_Amplification",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 450
      }
    },
    {
      "id": "var-moderation",
      "name": "Moderation_Rate",
      "equation": "0.1",
      "position": {
        "x": 650,
        "y": 450
      }
    }
  ],
