{
  "id": "space-debris-cascade-tec",
  "name": "Space Debris Kessler Syndrome",
  "description": "Model of space debris cascade. Source: Kessler & Cour-Palais (1978), JGR.",
  "stocks": [
    {
      "id": "stock-sat",
      "name": "Active_Satellites",
      "initial_value": 3000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-debris",
      "name": "Debris_Objects",
      "initial_value": 20000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-launch",
      "name": "Satellite_Launch",
      "equation": "Launch_Rate",
      "from_stock": null,
      "to_stock": "stock-sat",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-deorbit",
      "name": "Deorbit",
      "equation": "Active_Satellites * Deorbit_Rate",
      "from_stock": "stock-sat",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-fail",
      "name": "Failure_To_Debris",
      "equation": "Active_Satellites * Failure_Rate * Fragments_Per_Event",
      "from_stock": null,
      "to_stock": "stock-debris",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-collision",
      "name": "Collision_Cascade",
      "equation": "Collision_Rate * Active_Satellites * Debris_Objects / 1e9 * Cascade_Factor",
      "from_stock": null,
      "to_stock": "stock-debris",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-decay",
      "name": "Atmospheric_Decay",
      "equation": "Debris_Objects * Decay_Rate",
      "from_stock": "stock-debris",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-launch",
      "name": "Launch_Rate",
      "equation": "500 + 100 * TIME",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-deorbit",
      "name": "Deorbit_Rate",
      "equation": "0.1",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-fail",
      "name": "Failure_Rate",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-frags",
      "name": "Fragments_Per_Event",
      "equation": "100",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "var-collrate",
      "name": "Collision_Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-cascade",
      "name": "Cascade_Factor",
      "equation": "500",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-decay",
      "name": "Decay_Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T12:55:38.760848+00:00",
  "updated_at": "2026-01-12T12:55:38.760848+00:00",
  "source": "https://systemdynamics.org/resources/",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}