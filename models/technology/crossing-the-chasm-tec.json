{
  "id": "crossing-the-chasm-tec",
  "name": "Crossing the Chasm Innovation Model",
  "description": "Moore (1991) technology adoption lifecycle model. Extends Bass diffusion to show the 'chasm' between early adopters and mainstream market that many innovations fail to cross. Reference: Bass, F. M. (1969). A new product growth for model consumer durables. Management Science, 15(5), 215-227. DOI: https://doi.org/10.1287/mnsc.15.5.215",
  "stocks": [
    {
      "id": "s1",
      "name": "Innovators",
      "initial_value": 2.5,
      "position": {
        "x": 100,
        "y": 200
      },
      "equation": ""
    },
    {
      "id": "s2",
      "name": "Early_Adopters",
      "initial_value": 0,
      "position": {
        "x": 200,
        "y": 200
      },
      "equation": ""
    },
    {
      "id": "s3",
      "name": "Early_Majority",
      "initial_value": 0,
      "position": {
        "x": 350,
        "y": 200
      },
      "equation": ""
    },
    {
      "id": "s4",
      "name": "Late_Majority",
      "initial_value": 0,
      "position": {
        "x": 450,
        "y": 200
      },
      "equation": ""
    },
    {
      "id": "s5",
      "name": "Laggards",
      "initial_value": 0,
      "position": {
        "x": 550,
        "y": 200
      },
      "equation": ""
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "innovator_to_early",
      "from_stock": "s1",
      "to_stock": "s2",
      "equation": "Innovators * visionary_adoption_rate",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "f2",
      "name": "early_to_majority",
      "from_stock": "s2",
      "to_stock": "s3",
      "equation": "Early_Adopters * chasm_crossing_rate * product_maturity",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "f3",
      "name": "early_to_late",
      "from_stock": "s3",
      "to_stock": "s4",
      "equation": "Early_Majority * pragmatist_adoption_rate",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "f4",
      "name": "late_to_laggard",
      "from_stock": "s4",
      "to_stock": "s5",
      "equation": "Late_Majority * conservative_adoption_rate",
      "position": {
        "x": 0,
        "y": 0
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "visionary_adoption_rate",
      "equation": "0.15",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v2",
      "name": "chasm_crossing_rate",
      "equation": "0.05",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v3",
      "name": "pragmatist_adoption_rate",
      "equation": "0.2",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v4",
      "name": "conservative_adoption_rate",
      "equation": "0.1",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v5",
      "name": "product_maturity",
      "equation": "MIN(1, (Early_Adopters + Early_Majority) / 20)",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v6",
      "name": "total_adopters",
      "equation": "Early_Adopters + Early_Majority + Late_Majority + Laggards",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v7",
      "name": "market_penetration",
      "equation": "total_adopters / 100",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v8",
      "name": "in_chasm",
      "equation": "IF(Early_Adopters > 5 AND Early_Majority < 10, 1, 0)",
      "position": {
        "x": 0,
        "y": 0
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "product_maturity",
      "to_element": "early_to_majority"
    },
    {
      "id": "c2",
      "from_element": "Early_Adopters",
      "to_element": "product_maturity"
    }
  ],
  "time_settings": {
    "start": 0,
    "dt": 0.5,
    "end": 50
  },
  "created_at": "2026-01-12T02:25:30.586847+00:00",
  "updated_at": "2026-01-12T02:25:30.586850+00:00",
  "source": "https://www.harpercollins.com/products/crossing-the-chasm-3rd-edition-geoffrey-a-moore",
  "reference": "Moore, G. A. (1991). Crossing the Chasm: Marketing and Selling High-Tech Products to Mainstream Customers. HarperBusiness."
}