{
  "id": "digital-transformation-dynamics-tec",
  "name": "Digital Transformation Dynamics Model",
  "description": "Model of organizational digital transformation including adoption, resistance, and capability building. Reference: Andersson, D. I., & Hughes, D. (2014). Microbiological effects of sublethal antibiotic concentrations. Nature Reviews Microbiology. Source: https://doi.org/10.1038/nrmicro3270",
  "stocks": [
    {
      "id": "s1",
      "name": "Digital_Maturity",
      "initial_value": 0.2,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Employee_Digital_Skills",
      "initial_value": 0.3,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Change_Resistance",
      "initial_value": 0.6,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Digitalization",
      "equation": "Digitalization_Rate * (1 - Digital_Maturity) * Investment_Factor * (1 - Change_Resistance)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Skill_Development",
      "equation": "Training_Rate * (1 - Employee_Digital_Skills) * Digital_Maturity",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Skill_Attrition",
      "equation": "Skill_Decay_Rate * Employee_Digital_Skills",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "f4",
      "name": "Resistance_Reduction",
      "equation": "Change_Resistance * Success_Visibility * Communication_Effect / Resistance_Decay_Time",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Digitalization_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Investment_Factor",
      "equation": "1 + Digital_Investment / 100",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Digital_Investment",
      "equation": "50",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Training_Rate",
      "equation": "0.15",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Skill_Decay_Rate",
      "equation": "0.05",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Success_Visibility",
      "equation": "Digital_Maturity * Employee_Digital_Skills",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Communication_Effect",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Resistance_Decay_Time",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Transformation_Progress",
      "equation": "Digital_Maturity * Employee_Digital_Skills * (1 - Change_Resistance)",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:29:23.539552+00:00",
  "updated_at": "2026-01-12T11:29:23.539552+00:00",
  "source": "https://doi.org/10.1016/j.jsis.2019.101385",
  "reference": "Vial G. Understanding digital transformation: A review and a research agenda. Journal of Strategic Information Systems. 2019;28(2):118-144."
}