{
  "id": "antibiotic-resistance-evolution-extended-hea",
  "name": "Antibiotic Resistance Evolution Extended Model",
  "description": "Illustrative Antibiotic Resistance Evolution Extended Model. Source reconciliation 2026-10-20: The corrected Laxminarayan et al. citation is a commission review, not the source of these ODEs. All bacterial stocks and effectiveness start at zero, giving 0/0 in Effectiveness_Decay. Drug_Approval transfers an amount of pipeline drugs directly to dimensionless effectiveness; no unit conversion or source for coefficients/initial values is established. No guessed bacterial seed or effectiveness was inserted. Scientific calibration and applicability remain unverified.",
  "stocks": [
    {
      "id": "stock-susceptible-bacteria",
      "name": "Susceptible_Bacteria",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "stock-resistant-bacteria",
      "name": "Resistant_Bacteria",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "stock-multi-resistant",
      "name": "Multi_Resistant_Bacteria",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "stock-antibiotic-effectiveness",
      "name": "Antibiotic_Effectiveness",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "stock-new-drug-pipeline",
      "name": "New_Drug_Pipeline",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 450,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-susceptible-growth",
      "name": "Susceptible_Growth",
      "equation": "Susceptible_Bacteria * Growth_Rate * (1 - Total_Bacteria / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-susceptible-bacteria",
      "position": {
        "x": 75,
        "y": 150
      }
    },
    {
      "id": "flow-mutation-single",
      "name": "Single_Mutation",
      "equation": "Susceptible_Bacteria * Mutation_Rate * Antibiotic_Pressure",
      "from_stock": "stock-susceptible-bacteria",
      "to_stock": "stock-resistant-bacteria",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-mutation-multi",
      "name": "Multi_Mutation",
      "equation": "Resistant_Bacteria * Mutation_Rate * Antibiotic_Pressure * 0.1",
      "from_stock": "stock-resistant-bacteria",
      "to_stock": "stock-multi-resistant",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "flow-antibiotic-kill-susceptible",
      "name": "Kill_Susceptible",
      "equation": "Susceptible_Bacteria * Antibiotic_Effectiveness * Treatment_Rate",
      "from_stock": "stock-susceptible-bacteria",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 220
      }
    },
    {
      "id": "flow-antibiotic-kill-resistant",
      "name": "Kill_Resistant",
      "equation": "Resistant_Bacteria * Antibiotic_Effectiveness * Treatment_Rate * Resistance_Reduction",
      "from_stock": "stock-resistant-bacteria",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 220
      }
    },
    {
      "id": "flow-effectiveness-decay",
      "name": "Effectiveness_Decay",
      "equation": "Antibiotic_Effectiveness * (Resistant_Bacteria + Multi_Resistant_Bacteria) / Total_Bacteria * Decay_Rate",
      "from_stock": "stock-antibiotic-effectiveness",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 370
      }
    },
    {
      "id": "flow-new-drug-development",
      "name": "New_Drug_Development",
      "equation": "RD_Investment / Development_Cost",
      "from_stock": null,
      "to_stock": "stock-new-drug-pipeline",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "flow-drug-approval",
      "name": "Drug_Approval",
      "equation": "New_Drug_Pipeline / Approval_Time",
      "from_stock": "stock-new-drug-pipeline",
      "to_stock": "stock-antibiotic-effectiveness",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "variables": [
