{
  "id": "antimicrobial-resistance-spread-hea",
  "name": "Antimicrobial Resistance Spread Model",
  "description": "Models spread of antibiotic-resistant bacteria in hospitals and communities. Based on Laxminarayan et al. (2013). DOI: 10.1016/S1473-3099(13)70318-9",
  "stocks": [
    {
      "id": "stock-suscept",
      "name": "Susceptible_Infections",
      "initial_value": 900,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-resist",
      "name": "Resistant_Infections",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "stock-antiuse",
      "name": "Antibiotic_Use",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-susceptnew",
      "name": "New_Susceptible",
      "equation": "Infection_Rate * (1 - Resistant_Fraction)",
      "from_stock": null,
      "to_stock": "stock-suscept",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-susceptcure",
      "name": "Susceptible_Cured",
      "equation": "Susceptible_Infections * Treatment_Success",
      "from_stock": "stock-suscept",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "flow-resistnew",
      "name": "New_Resistant",
      "equation": "Infection_Rate * Resistant_Fraction + Susceptible_Infections * Mutation_Rate",
      "from_stock": null,
      "to_stock": "stock-resist",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-resistconv",
      "name": "Resistance_Acquisition",
      "equation": "Susceptible_Infections * Selection_Pressure * Antibiotic_Use / 100",
      "from_stock": "stock-suscept",
      "to_stock": "stock-resist",
      "position": {
        "x": 250,
        "y": 175
      }
    },
    {
      "id": "flow-resistcure",
      "name": "Resistant_Cleared",
      "equation": "Resistant_Infections * (Base_Clearance + Alternative_Treatment)",
      "from_stock": "stock-resist",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "flow-antiinc",
      "name": "Antibiotic_Increase",
      "equation": "(Susceptible_Infections + Resistant_Infections) * Prescribing_Rate",
      "from_stock": null,
      "to_stock": "stock-antiuse",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-antidec",
      "name": "Antibiotic_Decrease",
      "equation": "Antibiotic_Use * Stewardship_Effect",
      "from_stock": "stock-antiuse",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-infrate",
      "name": "Infection_Rate",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 175
      }
    },
    {
      "id": "var-resistfrac",
      "name": "Resistant_Fraction",
      "equation": "Resistant_Infections / (Susceptible_Infections + Resistant_Infections + 1)",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-treatsuccess",
      "name": "Treatment_Success",
      "equation": "0.9 * (1 - Resistant_Fraction)",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-mutrate",
      "name": "Mutation_Rate",
      "equation": "0.001",
      "position": {
        "x": 200,
        "y": 175
      }
    },
    {
      "id": "var-selpress",
      "name": "Selection_Pressure",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "var-baseclear",
      "name": "Base_Clearance",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-alttreat",
      "name": "Alternative_Treatment",
      "equation": "0.05",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "var-prescrate",
      "name": "Prescribing_Rate",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-steward",
      "name": "Stewardship_Effect",
      "equation": "0.02",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "var-resistburden",
      "name": "Resistance_Burden",
      "equation": "Resistant_Infections / (Susceptible_Infections + Resistant_Infections)",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Antibiotic_Use",
      "to_element": "Resistance_Acquisition"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:55:29.074159+00:00",
  "updated_at": "2026-01-12T02:55:29.074167+00:00",
  "source": "https://doi.org/10.1016/S1473-3099(13)70318-9",
  "reference": "Laxminarayan R, et al. (2013). Antibiotic resistance\u2014the need for global solutions. Lancet ID."
}