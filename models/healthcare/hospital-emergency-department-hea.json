{
  "id": "hospital-emergency-department-hea",
  "name": "Hospital Emergency Department Model",
  "description": "A system dynamics model of ED patient flow based on Hoot & Aronsky (2008) 'Systematic Review of Emergency Department Crowding' (doi:10.1016/j.annemergmed.2008.03.014) and the Institute for Healthcare Improvement's ED flow models. Tracks patient arrivals, triage, treatment, and boarding. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-waiting-room",
      "name": "Waiting Room Patients",
      "initial_value": 15,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "stock-triage",
      "name": "In Triage",
      "initial_value": 3,
      "equation": "",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "stock-treatment-beds",
      "name": "In Treatment Beds",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "stock-boarding",
      "name": "Boarding Patients",
      "initial_value": 8,
      "equation": "",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "stock-discharged",
      "name": "Discharged",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "stock-admitted",
      "name": "Admitted to Hospital",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "stock-lwbs",
      "name": "Left Without Being Seen",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "stock-staff-on-duty",
      "name": "Staff On Duty",
      "initial_value": 15,
      "equation": "",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-arrivals",
      "name": "Patient Arrivals",
      "equation": "Base_Arrival_Rate * Arrival_Variability",
      "from_stock": null,
      "to_stock": "stock-waiting-room",
      "position": {
        "x": 75,
        "y": 150
      }
    },
    {
      "id": "flow-to-triage",
      "name": "To Triage",
      "equation": "MIN(Waiting_Room_Patients, Triage_Capacity - In_Triage)",
      "from_stock": "stock-waiting-room",
      "to_stock": "stock-triage",
      "position": {
        "x": 225,
        "y": 150
      }
    },
    {
      "id": "flow-to-treatment",
      "name": "To Treatment",
      "equation": "MIN(In_Triage / Triage_Time, Available_Beds)",
      "from_stock": "stock-triage",
      "to_stock": "stock-treatment-beds",
      "position": {
        "x": 375,
        "y": 150
      }
    },
    {
      "id": "flow-lwbs-flow",
      "name": "LWBS Flow",
      "equation": "Waiting_Room_Patients * LWBS_Rate * Wait_Time_Factor",
      "from_stock": "stock-waiting-room",
      "to_stock": "stock-lwbs",
      "position": {
        "x": 150,
        "y": 225
      }
    },
    {
      "id": "flow-discharge",
      "name": "Discharge",
      "equation": "In_Treatment_Beds * (1 - Admission_Rate) / Treatment_Time",
      "from_stock": "stock-treatment-beds",
      "to_stock": "stock-discharged",
      "position": {
        "x": 525,
        "y": 150
      }
    },
    {
      "id": "flow-to-boarding",
      "name": "To Boarding",
      "equation": "In_Treatment_Beds * Admission_Rate / Treatment_Time",
      "from_stock": "stock-treatment-beds",
      "to_stock": "stock-boarding",
      "position": {
        "x": 450,
        "y": 225
      }
    },
    {
      "id": "flow-admission",
      "name": "Hospital Admission",
      "equation": "Boarding_Patients / Boarding_Time * Bed_Availability",
      "from_stock": "stock-boarding",
      "to_stock": "stock-admitted",
      "position": {
        "x": 525,
        "y": 300
      }
    },
    {
      "id": "flow-staff-arrival",
      "name": "Staff Arrival",
      "equation": "Scheduled_Staff - Staff_On_Duty",
      "from_stock": null,
      "to_stock": "stock-staff-on-duty",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "flow-staff-departure",
      "name": "Staff Departure",
      "equation": "Staff_On_Duty * Shift_End_Rate",
      "from_stock": "stock-staff-on-duty",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-base-arrival-rate",
      "name": "Base Arrival Rate",
      "equation": "5",
      "position": {
        "x": 75,
        "y": 80
      }
    },
    {
      "id": "var-arrival-variability",
      "name": "Arrival Variability",
      "equation": "1 + 0.3 * SIN(TIME * 3.14159 / 12)",
      "position": {
        "x": 75,
        "y": 220
      }
    },
    {
      "id": "var-triage-capacity",
      "name": "Triage Capacity",
      "equation": "4",
      "position": {
        "x": 225,
        "y": 80
      }
    },
    {
      "id": "var-triage-time",
      "name": "Triage Time",
      "equation": "0.25",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-total-beds",
      "name": "Total Beds",
      "equation": "30",
      "position": {
        "x": 375,
        "y": 80
      }
    },
    {
      "id": "var-available-beds",
      "name": "Available Beds",
      "equation": "MAX(0, Total_Beds - In_Treatment_Beds - Boarding_Patients)",
      "position": {
        "x": 450,
        "y": 80
      }
    },
    {
      "id": "var-treatment-time",
      "name": "Treatment Time",
      "equation": "3",
      "position": {
        "x": 525,
        "y": 80
      }
    },
    {
      "id": "var-admission-rate",
      "name": "Admission Rate",
      "equation": "0.25",
      "position": {
        "x": 500,
        "y": 225
      }
    },
    {
      "id": "var-boarding-time",
      "name": "Boarding Time",
      "equation": "4",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "var-bed-availability",
      "name": "Bed Availability",
      "equation": "0.8",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "var-lwbs-rate",
      "name": "LWBS Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-wait-time-factor",
      "name": "Wait Time Factor",
      "equation": "1 + Waiting_Room_Patients / 10",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-scheduled-staff",
      "name": "Scheduled Staff",
      "equation": "15",
      "position": {
        "x": 200,
        "y": 430
      }
    },
    {
      "id": "var-shift-end-rate",
      "name": "Shift End Rate",
      "equation": "0.125",
      "position": {
        "x": 400,
        "y": 430
      }
    },
    {
      "id": "var-ed-crowding-index",
      "name": "ED Crowding Index",
      "equation": "(Waiting_Room_Patients + In_Treatment_Beds + Boarding_Patients) / Total_Beds",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-door-to-provider-time",
      "name": "Door to Provider Time",
      "equation": "Waiting_Room_Patients / (To_Triage + 0.1) + Triage_Time",
      "position": {
        "x": 150,
        "y": 80
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Base Arrival Rate",
      "to_element": "Patient Arrivals"
    },
    {
      "id": "conn-2",
      "from_element": "Arrival Variability",
      "to_element": "Patient Arrivals"
    },
    {
      "id": "conn-3",
      "from_element": "Waiting Room Patients",
      "to_element": "To Triage"
    },
    {
      "id": "conn-4",
      "from_element": "Triage Capacity",
      "to_element": "To Triage"
    },
    {
      "id": "conn-5",
      "from_element": "In Triage",
      "to_element": "To Treatment"
    },
    {
      "id": "conn-6",
      "from_element": "Available Beds",
      "to_element": "To Treatment"
    },
    {
      "id": "conn-7",
      "from_element": "Total Beds",
      "to_element": "Available Beds"
    },
    {
      "id": "conn-8",
      "from_element": "In Treatment Beds",
      "to_element": "Available Beds"
    },
    {
      "id": "conn-9",
      "from_element": "Boarding Patients",
      "to_element": "Available Beds"
    },
    {
      "id": "conn-10",
      "from_element": "Waiting Room Patients",
      "to_element": "LWBS Flow"
    },
    {
      "id": "conn-11",
      "from_element": "Wait Time Factor",
      "to_element": "LWBS Flow"
    },
    {
      "id": "conn-12",
      "from_element": "In Treatment Beds",
      "to_element": "Discharge"
    },
    {
      "id": "conn-13",
      "from_element": "Admission Rate",
      "to_element": "To Boarding"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 168,
    "dt": 0.25
  },
  "created_at": "2026-01-11T21:00:00.000000Z",
  "updated_at": "2026-01-11T21:00:00.000000Z",
  "source": "https://doi.org/10.1016/j.socscimed.2013.03.004",
  "reference": "Healthcare System Dynamics Models"
}