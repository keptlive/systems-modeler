{
  "id": "hospital-bed-capacity-hea",
  "name": "Hospital Bed Capacity Model",
  "description": "A model of hospital bed capacity dynamics during health emergencies. Developed from COVID-19 healthcare surge planning and capacity modeling research. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "source": "https://doi.org/10.1016/S2213-2600(20)30229-0",
  "reference": "Emanuel EJ, et al. Fair Allocation of Scarce Medical Resources in the Time of Covid-19. NEJM. 2020;382:2049-2055.",
  "stocks": [
    {
      "id": "stock-available",
      "name": "Available Beds",
      "initial_value": 800,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-occupied",
      "name": "Occupied Beds",
      "initial_value": 600,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-surge",
      "name": "Surge Capacity",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-admissions",
      "name": "Admissions",
      "equation": "MIN(Admission_Demand, Available_Beds / Min_Bed_Availability)",
      "from_stock": "stock-available",
      "to_stock": "stock-occupied",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-discharges",
      "name": "Discharges",
      "equation": "Occupied_Beds / Average_LOS",
      "from_stock": "stock-occupied",
      "to_stock": "stock-available",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "flow-surge-activation",
      "name": "Surge Activation",
      "equation": "MAX(0, (Occupancy_Rate - Surge_Threshold) * Surge_Rate * Max_Surge)",
      "from_stock": null,
      "to_stock": "stock-surge",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "flow-surge-deactivation",
      "name": "Surge Deactivation",
      "equation": "Surge_Capacity / Surge_Decay_Time * (1 - Crisis_Mode)",
      "from_stock": "stock-surge",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "flow-surge-to-available",
      "name": "Surge to Available",
      "equation": "Surge_Activation * 0.8",
      "from_stock": null,
      "to_stock": "stock-available",
      "position": {
        "x": 350,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-total-capacity",
      "name": "Total Capacity",
      "equation": "Available_Beds + Occupied_Beds + Surge_Capacity",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-occupancy",
      "name": "Occupancy Rate",
      "equation": "Occupied_Beds / (Available_Beds + Occupied_Beds)",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-crisis",
      "name": "Crisis Mode",
      "equation": "IF(Occupancy_Rate > 0.95, 1, 0)",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-demand",
      "name": "Admission Demand",
      "equation": "Normal_Demand * (1 + Epidemic_Factor)",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-normal-demand",
      "name": "Normal Demand",
      "equation": "50",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-epidemic",
      "name": "Epidemic Factor",
      "equation": "0.5 * SIN(2 * 3.14159 * TIME / 30)",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-los",
      "name": "Average LOS",
      "equation": "5",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-min-avail",
      "name": "Min Bed Availability",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-surge-thresh",
      "name": "Surge Threshold",
      "equation": "0.85",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "var-surge-rate",
      "name": "Surge Rate",
      "equation": "10",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "var-max-surge",
      "name": "Max Surge",
      "equation": "200",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-surge-decay",
      "name": "Surge Decay Time",
      "equation": "14",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 180,
    "dt": 0.25
  },
  "created_at": "2026-01-11T21:45:15.069664+00:00",
  "updated_at": "2026-01-11T21:45:15.069664+00:00"
}