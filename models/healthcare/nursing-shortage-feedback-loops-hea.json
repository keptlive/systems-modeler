{
  "id": "nursing-shortage-feedback-loops-hea",
  "name": "Nursing Shortage Self-Reinforcing Feedback Model",
  "description": "System dynamics model examining whether nursing shortages are self-reinforcing through burnout, workload, and retention feedback loops. Based on umbrella review evidence. Reference: Mather, C., et al. (2025). Causes and effects of hospital nursing shortages to consider potential feedback effects. Human Resources for Health, 23, 10. Source: https://doi.org/10.1186/s12960-025-01028-w",
  "stocks": [
    {
      "id": "s1",
      "name": "Active Nurses",
      "initial_value": 3500000,
      "equation": "",
      "position": {"x": 300, "y": 150}
    },
    {
      "id": "s2",
      "name": "Nursing Students",
      "initial_value": 350000,
      "equation": "",
      "position": {"x": 100, "y": 150}
    },
    {
      "id": "s3",
      "name": "Nurse Burnout Level",
      "initial_value": 0.3,
      "equation": "",
      "position": {"x": 300, "y": 300}
    },
    {
      "id": "s4",
      "name": "Patient Care Quality",
      "initial_value": 0.8,
      "equation": "",
      "position": {"x": 500, "y": 300}
    },
    {
      "id": "s5",
      "name": "Workload Per Nurse",
      "initial_value": 5,
      "equation": "",
      "position": {"x": 500, "y": 150}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "New Nurse Entry",
      "equation": "Nursing_Students / Training_Time * Graduation_Rate * Profession_Attractiveness",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {"x": 200, "y": 150}
    },
    {
      "id": "f2",
      "name": "Nurse Attrition",
      "equation": "Active_Nurses * (Base_Attrition + Burnout_Driven_Attrition)",
      "from_stock": "s1",
      "to_stock": null,
      "position": {"x": 350, "y": 200}
    },
    {
      "id": "f3",
      "name": "Student Enrollment",
      "equation": "Enrollment_Capacity * Profession_Attractiveness",
      "from_stock": null,
      "to_stock": "s2",
      "position": {"x": 50, "y": 150}
    },
    {
      "id": "f4",
      "name": "Burnout Accumulation",
      "equation": "(Workload_Effect + Staff_Ratio_Effect - Recovery_Rate * Nurse_Burnout_Level) * Burnout_Sensitivity",
      "from_stock": null,
      "to_stock": "s3",
      "position": {"x": 300, "y": 350}
    },
    {
      "id": "f5",
      "name": "Quality Change",
      "equation": "(-Burnout_Quality_Impact + Staffing_Quality_Effect) * Quality_Adjustment_Rate",
      "from_stock": null,
      "to_stock": "s4",
      "position": {"x": 500, "y": 350}
    },
    {
      "id": "f6",
      "name": "Workload Adjustment",
      "equation": "(Target_Patient_Load / Active_Nurses * Demand_Factor - Workload_Per_Nurse) / Workload_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s5",
      "position": {"x": 500, "y": 200}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Training Time",
      "equation": "3",
      "position": {"x": 150, "y": 100}
    },
    {
      "id": "v2",
      "name": "Graduation Rate",
      "equation": "0.85",
      "position": {"x": 200, "y": 100}
    },
    {
      "id": "v3",
      "name": "Profession Attractiveness",
      "equation": "1 - Nurse_Burnout_Level * 0.5",
      "position": {"x": 100, "y": 250}
    },
    {
      "id": "v4",
      "name": "Base Attrition",
      "equation": "0.05",
      "position": {"x": 350, "y": 100}
    },
    {
      "id": "v5",
      "name": "Burnout Driven Attrition",
      "equation": "Nurse_Burnout_Level * 0.1",
      "position": {"x": 400, "y": 250}
    },
    {
      "id": "v6",
      "name": "Enrollment Capacity",
      "equation": "120000",
      "position": {"x": 50, "y": 100}
    },
    {
      "id": "v7",
      "name": "Workload Effect",
      "equation": "MAX(0, (Workload_Per_Nurse - 4) * 0.05)",
      "position": {"x": 400, "y": 350}
    },
    {
      "id": "v8",
      "name": "Staff Ratio Effect",
      "equation": "MAX(0, (1 - Active_Nurses / 4000000) * 0.1)",
      "position": {"x": 200, "y": 350}
    },
    {
      "id": "v9",
      "name": "Recovery Rate",
      "equation": "0.1",
      "position": {"x": 250, "y": 400}
    },
    {
      "id": "v10",
      "name": "Burnout Sensitivity",
      "equation": "0.1",
      "position": {"x": 350, "y": 400}
    },
    {
      "id": "v11",
      "name": "Burnout Quality Impact",
      "equation": "Nurse_Burnout_Level * 0.3",
      "position": {"x": 450, "y": 400}
    },
    {
      "id": "v12",
      "name": "Staffing Quality Effect",
      "equation": "MIN(0.1, (Active_Nurses / 3500000 - 1) * 0.2)",
      "position": {"x": 550, "y": 400}
    },
    {
      "id": "v13",
      "name": "Quality Adjustment Rate",
      "equation": "0.05",
      "position": {"x": 600, "y": 350}
    },
    {
      "id": "v14",
      "name": "Target Patient Load",
      "equation": "20000000",
      "position": {"x": 550, "y": 100}
    },
    {
      "id": "v15",
      "name": "Demand Factor",
      "equation": "1.02",
      "position": {"x": 600, "y": 150}
    },
    {
      "id": "v16",
      "name": "Workload Adjustment Time",
      "equation": "1",
      "position": {"x": 600, "y": 200}
    }
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 20, "dt": 1},
  "created_at": "2026-01-15T16:00:00.000000",
  "updated_at": "2026-01-15T16:00:00.000000",
  "source": "https://doi.org/10.1186/s12960-025-01028-w",
  "reference": "Mather, C., et al. (2025). Causes and effects of hospital nursing shortages to consider potential feedback effects: an umbrella review. Human Resources for Health, 23, 10."
}
