{
  "id": "healthcare-capacity-surge-hea",
  "name": "Healthcare Capacity Surge Model",
  "description": "Model of healthcare system surge capacity during emergencies. Shows how staff, beds, equipment, and supplies interact during crisis. Based on Hick et al. (2020) crisis standards of care framework. Reference: Cachon, G., & Terwiesch, C. (2012). Matching Supply with Demand. McGraw-Hill. Source: https://www.mheducation.com/",
  "stocks": [
    {
      "id": "stock-available-beds",
      "name": "Available Beds",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-patients",
      "name": "Current Patients",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-staff-available",
      "name": "Available Staff",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "stock-ppe-supply",
      "name": "PPE Supply",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "stock-ventilators",
      "name": "Available Ventilators",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 600,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-bed-expansion",
      "name": "Bed Expansion",
      "equation": "Surge_Bed_Activation",
      "from_stock": null,
      "to_stock": "stock-available-beds",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-admissions",
      "name": "Admissions",
      "equation": "MIN(Admission_Demand, Effective_Capacity)",
      "from_stock": null,
      "to_stock": "stock-patients",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-discharges",
      "name": "Discharges",
      "equation": "Current_Patients * Discharge_Rate",
      "from_stock": "stock-patients",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "flow-staff-call-in",
      "name": "Staff Call-In",
      "equation": "Staff_Surge_Activation",
      "from_stock": null,
      "to_stock": "stock-staff-available",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "flow-staff-burnout",
      "name": "Staff Burnout",
      "equation": "Available_Staff * Burnout_Rate * Stress_Multiplier",
      "from_stock": "stock-staff-available",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "flow-ppe-delivery",
      "name": "PPE Delivery",
      "equation": "PPE_Order_Rate",
      "from_stock": null,
      "to_stock": "stock-ppe-supply",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "flow-ppe-consumption",
      "name": "PPE Consumption",
      "equation": "Current_Patients * PPE_per_Patient_Day",
      "from_stock": "stock-ppe-supply",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "flow-ventilator-acquisition",
      "name": "Ventilator Acquisition",
      "equation": "Ventilator_Surge_Rate",
      "from_stock": null,
      "to_stock": "stock-ventilators",
      "position": {
        "x": 500,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "var-admission-demand",
      "name": "Admission Demand",
      "equation": "50 + 30 * SIN(2 * 3.14159 * Time / 14)",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-beds-per-staff",
      "name": "Beds per Staff",
      "equation": "0.5",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-staff-limited-beds",
      "name": "Staff Limited Beds",
      "equation": "Available_Staff * Beds_per_Staff",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-ppe-limited-beds",
      "name": "PPE Limited Beds",
      "equation": "IF PPE_Supply > PPE_per_Patient_Day * Available_Beds THEN Available_Beds ELSE PPE_Supply / PPE_per_Patient_Day",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-effective-capacity",
      "name": "Effective Capacity",
      "equation": "MIN(Available_Beds - Current_Patients, Staff_Limited_Beds - Current_Patients, PPE_Limited_Beds - Current_Patients)",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-discharge-rate",
      "name": "Discharge Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-surge-bed-activation",
      "name": "Surge Bed Activation",
      "equation": "IF Current_Patients / Available_Beds > 0.8 THEN 5 ELSE 0",
      "position": {
        "x": 500,
        "y": 400
      }
    },
    {
      "id": "var-staff-surge-activation",
      "name": "Staff Surge Activation",
      "equation": "IF Current_Patients / Staff_Limited_Beds > 0.9 THEN 10 ELSE 0",
      "position": {
        "x": 100,
        "y": 470
      }
    },
    {
      "id": "var-burnout-rate",
      "name": "Base Burnout Rate",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 470
      }
    },
    {
      "id": "var-stress-multiplier",
      "name": "Stress Multiplier",
      "equation": "1 + 2 * MAX(0, (Current_Patients / Staff_Limited_Beds) - 0.7)",
      "position": {
        "x": 500,
        "y": 470
      }
    },
    {
      "id": "var-ppe-per-patient-day",
      "name": "PPE per Patient Day",
      "equation": "20",
      "position": {
        "x": 700,
        "y": 470
      }
    },
    {
      "id": "var-ppe-order-rate",
      "name": "PPE Order Rate",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 540
      }
    },
    {
      "id": "var-ventilator-surge-rate",
      "name": "Ventilator Surge Rate",
      "equation": "IF Available_Ventilators < Current_Patients * 0.3 THEN 2 ELSE 0",
      "position": {
        "x": 400,
        "y": 540
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 60,
    "dt": 0.25
  },
  "created_at": "2026-01-11T21:16:29.727599+00:00",
  "updated_at": "2026-01-11T21:16:29.727599+00:00",
  "source": "https://doi.org/10.1016/j.socscimed.2013.03.004",
  "reference": "Healthcare System Dynamics Models"
}