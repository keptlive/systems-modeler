{
  "id": "mental-health-treatment-pathway-hea",
  "name": "Mental Health Treatment Pathways",
  "description": "Mental health service delivery model showing patient flow through treatment stages. Models screening, treatment initiation, and recovery or relapse. Source: Based on WHO Mental Health Gap Action Programme (mhGAP).",
  "stocks": [
    {
      "id": "stock-untreated",
      "name": "Untreated_Population",
      "initial_value": 50000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-in-treatment",
      "name": "In_Treatment",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "stock-chronic",
      "name": "Chronic_Condition",
      "initial_value": 2000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-screening",
      "name": "Treatment_Initiation",
      "equation": "Untreated_Population * Screening_Rate * Treatment_Access_Rate",
      "from_stock": "stock-untreated",
      "to_stock": "stock-in-treatment",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-recovery",
      "name": "Successful_Recovery",
      "equation": "In_Treatment * Recovery_Rate",
      "from_stock": "stock-in-treatment",
      "to_stock": "stock-recovered",
      "position": {
        "x": 400,
        "y": 175
      }
    },
    {
      "id": "flow-chronic-transition",
      "name": "Chronic_Transition",
      "equation": "In_Treatment * Chronicity_Rate",
      "from_stock": "stock-in-treatment",
      "to_stock": "stock-chronic",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "flow-relapse",
      "name": "Relapse",
      "equation": "Recovered * Relapse_Rate",
      "from_stock": "stock-recovered",
      "to_stock": "stock-untreated",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-new-cases",
      "name": "New_Cases",
      "equation": "New_Case_Rate * General_Population",
      "from_stock": null,
      "to_stock": "stock-untreated",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-dropout",
      "name": "Treatment_Dropout",
      "equation": "In_Treatment * Dropout_Rate",
      "from_stock": "stock-in-treatment",
      "to_stock": "stock-untreated",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-screening-rate",
      "name": "Screening_Rate",
      "equation": "0.1",
      "position": {
        "x": 150,
        "y": 80
      }
    },
    {
      "id": "var-treatment-access",
      "name": "Treatment_Access_Rate",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-recovery-rate",
      "name": "Recovery_Rate",
      "equation": "0.15",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-chronicity-rate",
      "name": "Chronicity_Rate",
      "equation": "0.05",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-relapse-rate",
      "name": "Relapse_Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-dropout-rate",
      "name": "Dropout_Rate",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-new-case-rate",
      "name": "New_Case_Rate",
      "equation": "0.01",
      "position": {
        "x": 50,
        "y": 80
      }
    },
    {
      "id": "var-general-pop",
      "name": "General_Population",
      "equation": "1000000",
      "position": {
        "x": 50,
        "y": 350
      }
    },
    {
      "id": "var-treatment-gap",
      "name": "Treatment_Gap",
      "equation": "Untreated_Population / (Untreated_Population + In_Treatment + Chronic_Condition)",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Untreated_Population",
      "to_element": "Treatment_Initiation"
    },
    {
      "id": "conn-2",
      "from_element": "Screening_Rate",
      "to_element": "Treatment_Initiation"
    },
    {
      "id": "conn-3",
      "from_element": "In_Treatment",
      "to_element": "Successful_Recovery"
    },
    {
      "id": "conn-4",
      "from_element": "Recovered",
      "to_element": "Relapse"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-11T20:47:58.495679Z",
  "updated_at": "2026-01-11T20:47:58.495679Z",
  "source": "https://doi.org/10.1016/j.socscimed.2013.03.004",
  "reference": "Healthcare System Dynamics Models"
}