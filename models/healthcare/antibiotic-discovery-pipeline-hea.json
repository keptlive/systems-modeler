  "flows": [
    {
      "id": "flow-new-research",
      "name": "New Research",
      "equation": "Research_Funding / Cost_per_Project",
      "from_stock": null,
      "to_stock": "stock-research",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-to-preclinical",
      "name": "To Preclinical",
      "equation": "Research_Projects * Research_Success_Rate / Research_Duration",
      "from_stock": "stock-research",
      "to_stock": "stock-preclinical",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-to-clinical",
      "name": "To Clinical",
      "equation": "Preclinical * Preclinical_Success / Preclinical_Duration",
      "from_stock": "stock-preclinical",
      "to_stock": "stock-clinical",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-approval",
      "name": "Approval",
      "equation": "Clinical_Trials * Clinical_Success / Clinical_Duration",
      "from_stock": "stock-clinical",
      "to_stock": "stock-approved",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-obsolescence",
      "name": "Obsolescence",
      "equation": "Approved_Antibiotics * Resistance_Development * Resistant_Bacteria / 100",
      "from_stock": "stock-approved",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "flow-resistance-growth",
      "name": "Resistance Growth",
      "equation": "Resistant_Bacteria * Resistance_Growth_Rate * (1 - Resistant_Bacteria / Resistance_Ceiling)",
      "from_stock": null,
      "to_stock": "stock-resistance",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "flow-resistance-reduction",
      "name": "Resistance Reduction",
      "equation": "Resistant_Bacteria * Stewardship_Effect * Approved_Antibiotics / 10",
      "from_stock": "stock-resistance",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
