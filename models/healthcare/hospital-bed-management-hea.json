{
  "id": "hospital-bed-management-hea",
  "name": "Hospital Bed Management Model",
  "description": "A system dynamics model of hospital bed management and patient flow. Models the dynamics of patient admissions, bed occupancy, length of stay, discharge planning, and the feedback effects of congestion on quality of care. Reference: Juran, J. M. (1999). Juran's Quality Handbook. McGraw-Hill. Source: https://www.mheducation.com/",
  "stocks": [
    {
      "id": "stock-ed-patients",
      "name": "ED Patients",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "stock-admitted-waiting",
      "name": "Admitted Waiting for Bed",
      "initial_value": 15,
      "equation": "",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "stock-icu-patients",
      "name": "ICU Patients",
      "initial_value": 40,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "stock-acute-patients",
      "name": "Acute Care Patients",
      "initial_value": 180,
      "equation": "",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "stock-step-down",
      "name": "Step Down Patients",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 550,
        "y": 175
      }
    },
    {
      "id": "stock-discharge-ready",
      "name": "Discharge Ready",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 700,
        "y": 175
      }
    },
    {
      "id": "stock-available-beds",
      "name": "Available Beds",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "stock-staff-fatigue",
      "name": "Staff Fatigue Index",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 250,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-ed-arrivals",
      "name": "ED Arrivals",
      "equation": "Arrival_Rate * (1 + 0.2 * SIN(TIME * 2 * 3.14159 / 24))",
      "from_stock": null,
      "to_stock": "stock-ed-patients",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "flow-ed-discharge",
      "name": "ED Discharge",
      "equation": "ED_Patients * ED_Discharge_Rate",
      "from_stock": "stock-ed-patients",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "flow-admission-decision",
      "name": "Admission Decision",
      "equation": "ED_Patients * Admission_Rate",
      "from_stock": "stock-ed-patients",
      "to_stock": "stock-admitted-waiting",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "flow-to-icu",
      "name": "ICU Placement",
      "equation": "Admitted_Waiting_for_Bed * ICU_Fraction * Bed_Availability",
      "from_stock": "stock-admitted-waiting",
      "to_stock": "stock-icu-patients",
      "position": {
        "x": 325,
        "y": 125
      }
    },
    {
      "id": "flow-to-acute",
      "name": "Acute Placement",
      "equation": "Admitted_Waiting_for_Bed * (1 - ICU_Fraction) * Bed_Availability",
      "from_stock": "stock-admitted-waiting",
      "to_stock": "stock-acute-patients",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-icu-to-stepdown",
      "name": "ICU to Step Down",
      "equation": "ICU_Patients / ICU_LOS * ICU_Survival_Rate",
      "from_stock": "stock-icu-patients",
      "to_stock": "stock-step-down",
      "position": {
        "x": 475,
        "y": 137
      }
    },
    {
      "id": "flow-acute-to-stepdown",
      "name": "Acute to Step Down",
      "equation": "Acute_Care_Patients * Acute_Stepdown_Rate",
      "from_stock": "stock-acute-patients",
      "to_stock": "stock-step-down",
      "position": {
        "x": 475,
        "y": 215
      }
    },
    {
      "id": "flow-acute-to-discharge",
      "name": "Acute to Discharge Ready",
      "equation": "Acute_Care_Patients / Acute_LOS * (1 - Acute_Stepdown_Rate)",
      "from_stock": "stock-acute-patients",
      "to_stock": "stock-discharge-ready",
      "position": {
        "x": 550,
        "y": 250
      }
    },
    {
      "id": "flow-stepdown-to-discharge",
      "name": "Step Down to Discharge",
      "equation": "Step_Down_Patients / Stepdown_LOS",
      "from_stock": "stock-step-down",
      "to_stock": "stock-discharge-ready",
      "position": {
        "x": 625,
        "y": 175
      }
    },
    {
      "id": "flow-discharge",
      "name": "Discharge",
      "equation": "Discharge_Ready / Discharge_Processing_Time",
      "from_stock": "stock-discharge-ready",
      "to_stock": null,
      "position": {
        "x": 800,
        "y": 175
      }
    },
    {
      "id": "flow-beds-freed",
      "name": "Beds Freed",
      "equation": "Discharge",
      "from_stock": null,
      "to_stock": "stock-available-beds",
      "position": {
        "x": 500,
        "y": 400
      }
    },
    {
      "id": "flow-beds-occupied",
      "name": "Beds Occupied",
      "equation": "ICU_Placement + Acute_Placement",
      "from_stock": "stock-available-beds",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "flow-fatigue-increase",
      "name": "Fatigue Increase",
      "equation": "Occupancy_Rate * Fatigue_Buildup_Rate",
      "from_stock": null,
      "to_stock": "stock-staff-fatigue",
      "position": {
        "x": 175,
        "y": 400
      }
    },
    {
      "id": "flow-fatigue-recovery",
      "name": "Fatigue Recovery",
      "equation": "Staff_Fatigue_Index / Fatigue_Recovery_Time * (1 - Occupancy_Rate)",
      "from_stock": "stock-staff-fatigue",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 500
      }
    }
  ],
  "variables": [
    {
      "id": "var-arrival-rate",
      "name": "Arrival Rate",
      "equation": "10",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-ed-discharge-rate",
      "name": "ED Discharge Rate",
      "equation": "0.4",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "var-admission-rate",
      "name": "Admission Rate",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-icu-fraction",
      "name": "ICU Fraction",
      "equation": "0.15",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-total-beds",
      "name": "Total Beds",
      "equation": "300",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-occupied-beds",
      "name": "Occupied Beds",
      "equation": "ICU_Patients + Acute_Care_Patients + Step_Down_Patients + Discharge_Ready",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "var-occupancy-rate",
      "name": "Occupancy Rate",
      "equation": "Occupied_Beds / Total_Beds",
      "position": {
        "x": 700,
        "y": 50
      }
    },
    {
      "id": "var-bed-availability",
      "name": "Bed Availability",
      "equation": "MIN(1, Available_Beds / (Admitted_Waiting_for_Bed + 0.1))",
      "position": {
        "x": 100,
        "y": 500
      }
    },
    {
      "id": "var-icu-los",
      "name": "ICU LOS",
      "equation": "5",
      "position": {
        "x": 200,
        "y": 500
      }
    },
    {
      "id": "var-icu-survival",
      "name": "ICU Survival Rate",
      "equation": "0.85",
      "position": {
        "x": 300,
        "y": 500
      }
    },
    {
      "id": "var-acute-los",
      "name": "Acute LOS",
      "equation": "4 * (1 + Staff_Fatigue_Index / 100)",
      "position": {
        "x": 400,
        "y": 500
      }
    },
    {
      "id": "var-acute-stepdown-rate",
      "name": "Acute Stepdown Rate",
      "equation": "0.3",
      "position": {
        "x": 500,
        "y": 500
      }
    },
    {
      "id": "var-stepdown-los",
      "name": "Stepdown LOS",
      "equation": "3",
      "position": {
        "x": 600,
        "y": 500
      }
    },
    {
      "id": "var-discharge-time",
      "name": "Discharge Processing Time",
      "equation": "0.5 * (1 + Staff_Fatigue_Index / 50)",
      "position": {
        "x": 700,
        "y": 500
      }
    },
    {
      "id": "var-fatigue-buildup",
      "name": "Fatigue Buildup Rate",
      "equation": "5",
      "position": {
        "x": 100,
        "y": 600
      }
    },
    {
      "id": "var-fatigue-recovery-time",
      "name": "Fatigue Recovery Time",
      "equation": "8",
      "position": {
        "x": 250,
        "y": 600
      }
    },
    {
      "id": "var-wait-time",
      "name": "Average Wait Time",
      "equation": "Admitted_Waiting_for_Bed / (ICU_Placement + Acute_Placement + 0.1)",
      "position": {
        "x": 400,
        "y": 600
      }
    },
    {
      "id": "var-quality-index",
      "name": "Care Quality Index",
      "equation": "100 * (1 - Staff_Fatigue_Index / 100) * (1 - MAX(0, Occupancy_Rate - 0.85) * 2)",
      "position": {
        "x": 550,
        "y": 600
      }
    },
    {
      "id": "var-boarding-time",
      "name": "ED Boarding Time",
      "equation": "Admitted_Waiting_for_Bed * 4",
      "position": {
        "x": 700,
        "y": 600
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "ED Patients",
      "to_element": "Admission Decision"
    },
    {
      "id": "conn-2",
      "from_element": "Admitted Waiting for Bed",
      "to_element": "ICU Placement"
    },
    {
      "id": "conn-3",
      "from_element": "Admitted Waiting for Bed",
      "to_element": "Acute Placement"
    },
    {
      "id": "conn-4",
      "from_element": "Bed Availability",
      "to_element": "ICU Placement"
    },
    {
      "id": "conn-5",
      "from_element": "ICU Patients",
      "to_element": "ICU to Step Down"
    },
    {
      "id": "conn-6",
      "from_element": "Acute Care Patients",
      "to_element": "Acute to Discharge Ready"
    },
    {
      "id": "conn-7",
      "from_element": "Staff Fatigue Index",
      "to_element": "Acute LOS"
    },
    {
      "id": "conn-8",
      "from_element": "Occupancy Rate",
      "to_element": "Fatigue Increase"
    },
    {
      "id": "conn-9",
      "from_element": "Available Beds",
      "to_element": "Bed Availability"
    },
    {
      "id": "conn-10",
      "from_element": "Staff Fatigue Index",
      "to_element": "Care Quality Index"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.0625
  },
  "created_at": "2026-01-11T21:00:00.000000Z",
  "updated_at": "2026-01-11T21:00:00.000000Z",
  "source": "https://doi.org/10.1016/j.socscimed.2013.03.004",
  "reference": "Healthcare System Dynamics Models"
}