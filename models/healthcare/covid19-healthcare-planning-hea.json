{
  "id": "covid19-healthcare-planning-hea",
  "name": "COVID-19 Healthcare Services Planning Model",
  "description": "System dynamics model to simulate pandemic progress and impact of interventions on viral spread, healthcare utilisation and demand in secondary care. Developed for Southeast England NHS planning. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "source": "https://doi.org/10.1136/bmjopen-2023-072975",
  "reference": "MacLeod et al. (2023). Planning for healthcare services during COVID-19 in Southeast England: a system dynamics modelling approach. BMJ Open.",
  "stocks": [
    {
      "id": "stock-community-susceptible",
      "name": "Community Susceptible",
      "initial_value": 8000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "stock-community-infected",
      "name": "Community Infected",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "stock-community-recovered",
      "name": "Community Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "stock-hospital-beds",
      "name": "Hospital Bed Occupancy",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "stock-icu-beds",
      "name": "ICU Bed Occupancy",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "stock-staff-available",
      "name": "Staff Available",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "stock-staff-absent",
      "name": "Staff Absent (COVID)",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-community-infection",
      "name": "Community Infection",
      "equation": "Transmission_Rate * Community_Susceptible * Community_Infected / Total_Population * (1 - Intervention_Effect)",
      "from_stock": "stock-community-susceptible",
      "to_stock": "stock-community-infected",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-community-recovery",
      "name": "Community Recovery",
      "equation": "Community_Infected * (1 - Hospital_Admission_Rate) / Infection_Duration",
      "from_stock": "stock-community-infected",
      "to_stock": "stock-community-recovered",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-hospital-admission",
      "name": "Hospital Admission",
      "equation": "Community_Infected * Hospital_Admission_Rate / Infection_Duration",
      "from_stock": null,
      "to_stock": "stock-hospital-beds",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-hospital-discharge",
      "name": "Hospital Discharge",
      "equation": "Hospital_Bed_Occupancy * (1 - ICU_Transfer_Rate - Mortality_Ward) / Ward_Stay",
      "from_stock": "stock-hospital-beds",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "flow-icu-transfer",
      "name": "ICU Transfer",
      "equation": "Hospital_Bed_Occupancy * ICU_Transfer_Rate / Ward_Stay",
      "from_stock": "stock-hospital-beds",
      "to_stock": "stock-icu-beds",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "flow-icu-discharge",
      "name": "ICU Discharge",
      "equation": "ICU_Bed_Occupancy * (1 - Mortality_ICU) / ICU_Stay",
      "from_stock": "stock-icu-beds",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "flow-staff-sickness",
      "name": "Staff Sickness",
      "equation": "Staff_Available * Staff_Infection_Rate",
      "from_stock": "stock-staff-available",
      "to_stock": "stock-staff-absent",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "flow-staff-return",
      "name": "Staff Return",
      "equation": "Staff_Absent__COVID_ / Staff_Recovery_Time",
      "from_stock": "stock-staff-absent",
      "to_stock": "stock-staff-available",
      "position": {
        "x": 100,
        "y": 450
      }
    }
  ],
  "variables": [
    {
      "id": "var-transmission",
      "name": "Transmission Rate",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-total-pop",
      "name": "Total Population",
      "equation": "8000000",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-intervention",
      "name": "Intervention Effect",
      "equation": "0.4",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-infection-duration",
      "name": "Infection Duration",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-hosp-admission",
      "name": "Hospital Admission Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "var-icu-transfer",
      "name": "ICU Transfer Rate",
      "equation": "0.15",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-ward-stay",
      "name": "Ward Stay",
      "equation": "8",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-icu-stay",
      "name": "ICU Stay",
      "equation": "14",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-mortality-ward",
      "name": "Mortality Ward",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "var-mortality-icu",
      "name": "Mortality ICU",
      "equation": "0.25",
      "position": {
        "x": 550,
        "y": 250
      }
    },
    {
      "id": "var-staff-infection",
      "name": "Staff Infection Rate",
      "equation": "Community_Infected / Total_Population * 2",
      "position": {
        "x": 50,
        "y": 350
      }
    },
    {
      "id": "var-staff-recovery",
      "name": "Staff Recovery Time",
      "equation": "10",
      "position": {
        "x": 150,
        "y": 450
      }
    },
    {
      "id": "var-capacity-ratio",
      "name": "Capacity Ratio",
      "equation": "Staff_Available / 10000",
      "position": {
        "x": 200,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.25
  },
  "created_at": "2026-01-12T03:11:09.889262+00:00",
  "updated_at": "2026-01-12T03:11:09.889262+00:00"
}