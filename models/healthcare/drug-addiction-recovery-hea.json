{
  "id": "drug-addiction-recovery-hea",
  "name": "Drug Addiction and Recovery Model",
  "description": "A system dynamics model of drug addiction and recovery pathways. Models the transition of individuals through stages from susceptible population through experimentation, addiction, treatment, and recovery with relapse dynamics. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible Population",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "stock-experimenters",
      "name": "Experimenters",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "stock-regular-users",
      "name": "Regular Users",
      "initial_value": 3000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-addicted",
      "name": "Addicted",
      "initial_value": 2000,
      "equation": "",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "stock-in-treatment",
      "name": "In Treatment",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "stock-in-recovery",
      "name": "In Recovery",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "stock-long-term-recovery",
      "name": "Long Term Recovery",
      "initial_value": 2000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-initiation",
      "name": "Initiation Rate",
      "equation": "Susceptible_Population * (Social_Influence + Availability_Factor) * Vulnerability_Factor",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-experimenters",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "flow-escalation",
      "name": "Escalation Rate",
      "equation": "Experimenters * Escalation_Probability",
      "from_stock": "stock-experimenters",
      "to_stock": "stock-regular-users",
      "position": {
        "x": 325,
        "y": 150
      }
    },
    {
      "id": "flow-addiction-onset",
      "name": "Addiction Onset",
      "equation": "Regular_Users * Addiction_Rate",
      "from_stock": "stock-regular-users",
      "to_stock": "stock-addicted",
      "position": {
        "x": 475,
        "y": 150
      }
    },
    {
      "id": "flow-treatment-entry",
      "name": "Treatment Entry",
      "equation": "Addicted * Treatment_Seeking_Rate * Treatment_Availability",
      "from_stock": "stock-addicted",
      "to_stock": "stock-in-treatment",
      "position": {
        "x": 550,
        "y": 225
      }
    },
    {
      "id": "flow-treatment-completion",
      "name": "Treatment Completion",
      "equation": "In_Treatment * Treatment_Success_Rate / Treatment_Duration",
      "from_stock": "stock-in-treatment",
      "to_stock": "stock-in-recovery",
      "position": {
        "x": 475,
        "y": 300
      }
    },
    {
      "id": "flow-treatment-dropout",
      "name": "Treatment Dropout",
      "equation": "In_Treatment * (1 - Treatment_Success_Rate) / Treatment_Duration",
      "from_stock": "stock-in-treatment",
      "to_stock": "stock-addicted",
      "position": {
        "x": 650,
        "y": 225
      }
    },
    {
      "id": "flow-early-recovery-progress",
      "name": "Recovery Progress",
      "equation": "In_Recovery * Recovery_Transition_Rate",
      "from_stock": "stock-in-recovery",
      "to_stock": "stock-long-term-recovery",
      "position": {
        "x": 325,
        "y": 300
      }
    },
    {
      "id": "flow-early-relapse",
      "name": "Early Relapse",
      "equation": "In_Recovery * Early_Relapse_Rate * Stress_Factor",
      "from_stock": "stock-in-recovery",
      "to_stock": "stock-regular-users",
      "position": {
        "x": 400,
        "y": 225
      }
    },
    {
      "id": "flow-late-relapse",
      "name": "Late Relapse",
      "equation": "Long_Term_Recovery * Late_Relapse_Rate * Stress_Factor",
      "from_stock": "stock-long-term-recovery",
      "to_stock": "stock-experimenters",
      "position": {
        "x": 250,
        "y": 225
      }
    },
    {
      "id": "flow-quit-experimenting",
      "name": "Quit Experimenting",
      "equation": "Experimenters * Natural_Quit_Rate",
      "from_stock": "stock-experimenters",
      "to_stock": "stock-susceptible",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "flow-overdose-death",
      "name": "Overdose Deaths",
      "equation": "Addicted * Overdose_Rate",
      "from_stock": "stock-addicted",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-social-influence",
      "name": "Social Influence",
      "equation": "(Experimenters + Regular_Users + Addicted) / Total_Population * Influence_Strength",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-total-population",
      "name": "Total Population",
      "equation": "Susceptible_Population + Experimenters + Regular_Users + Addicted + In_Treatment + In_Recovery + Long_Term_Recovery",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-influence-strength",
      "name": "Influence Strength",
      "equation": "0.3",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "var-availability-factor",
      "name": "Availability Factor",
      "equation": "0.02",
      "position": {
        "x": 650,
        "y": 50
      }
    },
    {
      "id": "var-vulnerability-factor",
      "name": "Vulnerability Factor",
      "equation": "1 + Economic_Stress * 0.5",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-economic-stress",
      "name": "Economic Stress",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "var-escalation-prob",
      "name": "Escalation Probability",
      "equation": "0.15",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "var-addiction-rate",
      "name": "Addiction Rate",
      "equation": "0.2",
      "position": {
        "x": 550,
        "y": 400
      }
    },
    {
      "id": "var-treatment-seeking",
      "name": "Treatment Seeking Rate",
      "equation": "0.1",
      "position": {
        "x": 700,
        "y": 400
      }
    },
    {
      "id": "var-treatment-availability",
      "name": "Treatment Availability",
      "equation": "MIN(1, Treatment_Capacity / (Addicted * Treatment_Seeking_Rate))",
      "position": {
        "x": 100,
        "y": 500
      }
    },
    {
      "id": "var-treatment-capacity",
      "name": "Treatment Capacity",
      "equation": "1000",
      "position": {
        "x": 250,
        "y": 500
      }
    },
    {
      "id": "var-treatment-success",
      "name": "Treatment Success Rate",
      "equation": "0.4",
      "position": {
        "x": 400,
        "y": 500
      }
    },
    {
      "id": "var-treatment-duration",
      "name": "Treatment Duration",
      "equation": "0.25",
      "position": {
        "x": 550,
        "y": 500
      }
    },
    {
      "id": "var-recovery-transition",
      "name": "Recovery Transition Rate",
      "equation": "0.5",
      "position": {
        "x": 700,
        "y": 500
      }
    },
    {
      "id": "var-early-relapse-rate",
      "name": "Early Relapse Rate",
      "equation": "0.4",
      "position": {
        "x": 100,
        "y": 600
      }
    },
    {
      "id": "var-late-relapse-rate",
      "name": "Late Relapse Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 600
      }
    },
    {
      "id": "var-stress-factor",
      "name": "Stress Factor",
      "equation": "1 + Economic_Stress * 0.3",
      "position": {
        "x": 400,
        "y": 600
      }
    },
    {
      "id": "var-natural-quit",
      "name": "Natural Quit Rate",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 600
      }
    },
    {
      "id": "var-overdose-rate",
      "name": "Overdose Rate",
      "equation": "0.02",
      "position": {
        "x": 700,
        "y": 600
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Susceptible Population",
      "to_element": "Initiation Rate"
    },
    {
      "id": "conn-2",
      "from_element": "Social Influence",
      "to_element": "Initiation Rate"
    },
    {
      "id": "conn-3",
      "from_element": "Experimenters",
      "to_element": "Escalation Rate"
    },
    {
      "id": "conn-4",
      "from_element": "Regular Users",
      "to_element": "Addiction Onset"
    },
    {
      "id": "conn-5",
      "from_element": "Addicted",
      "to_element": "Treatment Entry"
    },
    {
      "id": "conn-6",
      "from_element": "Treatment Availability",
      "to_element": "Treatment Entry"
    },
    {
      "id": "conn-7",
      "from_element": "In Treatment",
      "to_element": "Treatment Completion"
    },
    {
      "id": "conn-8",
      "from_element": "In Recovery",
      "to_element": "Early Relapse"
    },
    {
      "id": "conn-9",
      "from_element": "Stress Factor",
      "to_element": "Early Relapse"
    },
    {
      "id": "conn-10",
      "from_element": "Long Term Recovery",
      "to_element": "Late Relapse"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 20,
    "dt": 0.0625
  },
  "created_at": "2026-01-11T21:00:00.000000Z",
  "updated_at": "2026-01-11T21:00:00.000000Z",
  "source": "https://doi.org/10.1016/j.socscimed.2013.03.004",
  "reference": "Healthcare System Dynamics Models"
}