{
  "id": "mental-health-care-access-dynamics-hea",
  "name": "Mental Health Care Access Dynamics Model",
  "description": "System dynamics model of mental health care system examining direct access, service capacity, and population outcomes. Based on Australian research showing that increased access combined with service capacity growth reduces ED presentations and hospitalizations. Reference: Skinner, A., et al. (2024). Improving access to mental health care: a system dynamics model of direct access to specialist care. BMC Health Services Research, 24, 330. Source: https://doi.org/10.1186/s12913-024-10758-x",
  "stocks": [
    {
      "id": "s1",
      "name": "Population With Low Distress",
      "initial_value": 0.6,
      "equation": "",
      "position": {"x": 100, "y": 100}
    },
    {
      "id": "s2",
      "name": "Population With Moderate Distress",
      "initial_value": 0.25,
      "equation": "",
      "position": {"x": 300, "y": 100}
    },
    {
      "id": "s3",
      "name": "Population With High Distress",
      "initial_value": 0.12,
      "equation": "",
      "position": {"x": 500, "y": 100}
    },
    {
      "id": "s4",
      "name": "Population With Very High Distress",
      "initial_value": 0.03,
      "equation": "",
      "position": {"x": 650, "y": 100}
    },
    {
      "id": "s5",
      "name": "Primary Care Capacity",
      "initial_value": 0.5,
      "equation": "",
      "position": {"x": 200, "y": 250}
    },
    {
      "id": "s6",
      "name": "Specialist Service Capacity",
      "initial_value": 0.2,
      "equation": "",
      "position": {"x": 450, "y": 250}
    },
    {
      "id": "s7",
      "name": "ED Presentations Mental Health",
      "initial_value": 0.02,
      "equation": "",
      "position": {"x": 550, "y": 350}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Onset Moderate",
      "equation": "Population_With_Low_Distress * Onset_Rate_Moderate * Stress_Factor",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {"x": 200, "y": 100}
    },
    {
      "id": "f2",
      "name": "Escalation to High",
      "equation": "Population_With_Moderate_Distress * Escalation_Rate * (1 - Treatment_Effect_Primary)",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {"x": 400, "y": 100}
    },
    {
      "id": "f3",
      "name": "Escalation to Very High",
      "equation": "Population_With_High_Distress * Crisis_Rate * (1 - Treatment_Effect_Specialist)",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {"x": 575, "y": 100}
    },
    {
      "id": "f4",
      "name": "Recovery from Moderate",
      "equation": "Population_With_Moderate_Distress * Recovery_Rate_Moderate * (1 + Treatment_Effect_Primary)",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {"x": 200, "y": 150}
    },
    {
      "id": "f5",
      "name": "Recovery from High",
      "equation": "Population_With_High_Distress * Recovery_Rate_High * (1 + Treatment_Effect_Specialist)",
      "from_stock": "s3",
      "to_stock": "s2",
      "position": {"x": 400, "y": 150}
    },
    {
      "id": "f6",
      "name": "Primary Capacity Growth",
      "equation": "Investment_Rate * Primary_Priority * (1 - Primary_Care_Capacity)",
      "from_stock": null,
      "to_stock": "s5",
      "position": {"x": 150, "y": 250}
    },
    {
      "id": "f7",
      "name": "Specialist Capacity Growth",
      "equation": "Investment_Rate * (1 - Primary_Priority) * Capacity_Growth_Factor * (1 - Specialist_Service_Capacity)",
      "from_stock": null,
      "to_stock": "s6",
      "position": {"x": 400, "y": 250}
    },
    {
      "id": "f8",
      "name": "ED Presentation Rate",
      "equation": "Population_With_Very_High_Distress * Crisis_ED_Rate * (1 - Direct_Access_Effect)",
      "from_stock": null,
      "to_stock": "s7",
      "position": {"x": 600, "y": 300}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Onset Rate Moderate",
      "equation": "0.03",
      "position": {"x": 150, "y": 50}
    },
    {
      "id": "v2",
      "name": "Stress Factor",
      "equation": "1.0",
      "position": {"x": 250, "y": 50}
    },
    {
      "id": "v3",
      "name": "Escalation Rate",
      "equation": "0.15",
      "position": {"x": 350, "y": 50}
    },
    {
      "id": "v4",
      "name": "Crisis Rate",
      "equation": "0.1",
      "position": {"x": 500, "y": 50}
    },
    {
      "id": "v5",
      "name": "Treatment Effect Primary",
      "equation": "Primary_Care_Capacity * 0.4",
      "position": {"x": 250, "y": 200}
    },
    {
      "id": "v6",
      "name": "Treatment Effect Specialist",
      "equation": "Specialist_Service_Capacity * Direct_Access_Proportion * 0.6",
      "position": {"x": 500, "y": 200}
    },
    {
      "id": "v7",
      "name": "Recovery Rate Moderate",
      "equation": "0.08",
      "position": {"x": 150, "y": 200}
    },
    {
      "id": "v8",
      "name": "Recovery Rate High",
      "equation": "0.05",
      "position": {"x": 350, "y": 200}
    },
    {
      "id": "v9",
      "name": "Investment Rate",
      "equation": "0.02",
      "position": {"x": 300, "y": 300}
    },
    {
      "id": "v10",
      "name": "Primary Priority",
      "equation": "0.6",
      "position": {"x": 200, "y": 300}
    },
    {
      "id": "v11",
      "name": "Capacity Growth Factor",
      "equation": "5",
      "position": {"x": 400, "y": 300}
    },
    {
      "id": "v12",
      "name": "Direct Access Proportion",
      "equation": "0.5",
      "position": {"x": 550, "y": 200}
    },
    {
      "id": "v13",
      "name": "Crisis ED Rate",
      "equation": "0.5",
      "position": {"x": 650, "y": 250}
    },
    {
      "id": "v14",
      "name": "Direct Access Effect",
      "equation": "Direct_Access_Proportion * Specialist_Service_Capacity",
      "position": {"x": 500, "y": 350}
    },
    {
      "id": "v15",
      "name": "Total High Distress Prevalence",
      "equation": "Population_With_High_Distress + Population_With_Very_High_Distress",
      "position": {"x": 600, "y": 150}
    }
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 365, "dt": 1},
  "created_at": "2026-01-15T16:00:00.000000",
  "updated_at": "2026-01-15T16:00:00.000000",
  "source": "https://doi.org/10.1186/s12913-024-10758-x",
  "reference": "Skinner, A., et al. (2024). Improving access to mental health care: a system dynamics model of direct access to specialist care and accelerated specialist service capacity growth. BMC Health Services Research, 24, 330."
}
