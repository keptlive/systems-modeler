        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "New_Prescriptions",
      "equation": "Non_Users * Prescription_Rate",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Prescription_End",
      "equation": "Prescription_Users / Prescription_Duration",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 175,
        "y": 270
      }
    },
    {
      "id": "f3",
      "name": "Misuse_Onset",
      "equation": "Prescription_Users * Misuse_Rate",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Addiction_Development",
      "equation": "Misusers * Addiction_Rate",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Treatment_Entry",
      "equation": "Opioid_Use_Disorder * Treatment_Seeking_Rate * Treatment_Availability",
      "from_stock": "s4",
      "to_stock": "s5",
      "position": {
        "x": 550,
        "y": 280
      }
    },
    {
      "id": "f6",
      "name": "Treatment_Completion",
      "equation": "In_Treatment / Treatment_Duration",
      "from_stock": "s5",
      "to_stock": "s6",
      "position": {
        "x": 475,
        "y": 350
      }
    },
    {
      "id": "f7",
      "name": "Relapse",
      "equation": "In_Recovery * Relapse_Rate",
      "from_stock": "s6",
      "to_stock": "s4",
      "position": {
        "x": 475,
        "y": 280
      }
    },
    {
      "id": "f8",
      "name": "Overdose_Deaths",
      "equation": "Opioid_Use_Disorder * Overdose_Rate + Misusers * Overdose_Rate * 0.3",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
