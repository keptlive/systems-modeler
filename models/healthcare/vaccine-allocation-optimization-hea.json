  "flows": [
    {
      "id": "flow-supply",
      "name": "Supply",
      "equation": "Weekly_Supply",
      "from_stock": null,
      "to_stock": "stock-available-vaccines",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "flow-elderly-allocation",
      "name": "Elderly Allocation",
      "equation": "MIN(Elderly_Allocation_Rate * Available_Vaccines, Elderly_Unvaccinated)",
      "from_stock": "stock-available-vaccines",
      "to_stock": "stock-elderly-vaccinated",
      "position": {
        "x": 225,
        "y": 150
      }
    },
    {
      "id": "flow-adult-allocation",
      "name": "Adult Allocation",
      "equation": "MIN(Adult_Allocation_Rate * Available_Vaccines, Adult_Unvaccinated)",
      "from_stock": "stock-available-vaccines",
      "to_stock": "stock-adult-vaccinated",
      "position": {
        "x": 225,
        "y": 250
      }
    },
    {
      "id": "flow-young-allocation",
      "name": "Young Allocation",
      "equation": "MIN(Young_Allocation_Rate * Available_Vaccines, Young_Unvaccinated)",
      "from_stock": "stock-available-vaccines",
      "to_stock": "stock-young-vaccinated",
      "position": {
        "x": 225,
        "y": 350
      }
    },
    {
      "id": "flow-lives-saved",
      "name": "Lives Saved",
      "equation": "Elderly_Allocation * VE * Elderly_IFR + Adult_Allocation * VE * Adult_IFR + Young_Allocation * VE * Young_IFR",
      "from_stock": null,
      "to_stock": "stock-deaths-averted",
      "position": {
        "x": 475,
        "y": 250
      }
    }
  ],
