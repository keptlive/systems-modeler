        "y": 160
      },
      "units": "mg/L"
    },
    {
      "id": "var-half-life",
      "name": "Half Life",
      "equation": "LN(2) / ((Kel + K12 + K21 - SQRT((Kel + K12 + K21)^2 - 4 * Kel * K21)) / 2)",
      "position": {
        "x": 400,
        "y": 160
      },
      "units": "h"
    },
    {
      "id": "var-therapeutic-range-low",
      "name": "Therapeutic Range Low",
      "equation": "2",
      "position": {
        "x": 550,
        "y": 160
      },
      "units": "mg/L"
    },
    {
      "id": "var-therapeutic-range-high",
      "name": "Therapeutic Range High",
      "equation": "10",
      "position": {
        "x": 700,
        "y": 160
      },
      "units": "mg/L"
    },
    {
      "id": "var-therapeutic-status",
      "name": "Therapeutic Status",
      "equation": "IF Plasma_Concentration < Therapeutic_Range_Low THEN 0 ELSE IF Plasma_Concentration > Therapeutic_Range_High THEN 2 ELSE 1",
      "position": {
        "x": 100,
        "y": 240
      },
      "units": "dimensionless"
    },
    {
      "id": "var-clearance",
