    },
    {
      "id": "var-k12",
      "name": "K12",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 80
      },
      "units": "1/h"
    },
    {
      "id": "var-k21",
      "name": "K21",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 80
      },
      "units": "1/h"
    },
    {
