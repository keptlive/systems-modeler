{
  "id": "two-compartment-pharmacokinetics-model-hea",
  "name": "Two-Compartment Pharmacokinetics Model",
  "description": "Illustrative Two-Compartment Pharmacokinetics Model. Source reconciliation 2026-10-20: The invalid book DOI was replaced by the publisher record of Gibaldi/Perrier (1982), a conceptual reference. The mechanistic equations were reconciled to the published Torsten two-compartment mass ODEs: Kel=CL/Vcentral, K12=Q/Vcentral, K21=Q/Vperipheral. Undeclared shorthand references now use existing stock names. An explicit non-systemic GI loss of Ka*GI*(1-F) makes GI depletion Ka*GI and systemic input F*Ka*GI, so F controls extent rather than only speed. Half Life now gives the slower disposition eigenmode, not ln(2)/Kel; if absorption is slower it need not equal the observed oral terminal half-life. Stocks are amounts (mg), volume L, time h, rates 1/h and concentration mg/L. Existing numerical constants and the 100 mg oral amount are illustrative, with no identified drug, fit or clinical therapeutic range; the existing therapeutic status diagnostic is not clinical advice. Scientific calibration and applicability remain unverified.",
  "stocks": [
    {
      "id": "stock-drug-in-central-compartment",
      "name": "Drug in Central Compartment",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      },
      "units": "mg"
    },
    {
      "id": "stock-drug-in-peripheral-compartment",
      "name": "Drug in Peripheral Compartment",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      },
      "units": "mg"
    },
    {
      "id": "stock-drug-in-gi-tract",
      "name": "Drug in GI Tract",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      },
      "units": "mg"
    }
  ],
  "flows": [
    {
      "id": "flow-absorption",
      "name": "Absorption",
      "equation": "Ka * Drug_in_GI_Tract * Bioavailability",
      "from_stock": "stock-drug-in-gi-tract",
      "to_stock": "stock-drug-in-central-compartment",
      "position": {
        "x": 250,
        "y": 200
      },
      "units": "mg/h"
    },
    {
      "id": "flow-distribution",
      "name": "Distribution",
      "equation": "K12 * Drug_in_Central_Compartment",
      "from_stock": "stock-drug-in-central-compartment",
      "to_stock": "stock-drug-in-peripheral-compartment",
      "position": {
        "x": 450,
        "y": 200
      },
      "units": "mg/h"
    },
    {
      "id": "flow-return-from-tissue",
      "name": "Return from Tissue",
      "equation": "K21 * Drug_in_Peripheral_Compartment",
      "from_stock": "stock-drug-in-peripheral-compartment",
      "to_stock": "stock-drug-in-central-compartment",
      "position": {
        "x": 650,
        "y": 200
      },
      "units": "mg/h"
    },
    {
      "id": "flow-elimination",
      "name": "Elimination",
      "equation": "Kel * Drug_in_Central_Compartment",
      "from_stock": "stock-drug-in-central-compartment",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 350
      },
      "units": "mg/h"
    },
    {
      "id": "flow-nonsystemic-gi-loss",
      "name": "Non-systemic GI Loss",
      "equation": "Ka * Drug_in_GI_Tract * (1 - Bioavailability)",
      "from_stock": "stock-drug-in-gi-tract",
      "to_stock": null,
      "units": "mg/h",
      "position": {
        "x": 650,
        "y": 350
      }
    }
  ],
  "variables": [
