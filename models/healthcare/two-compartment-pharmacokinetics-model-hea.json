{
  "id": "two-compartment-pharmacokinetics-model-hea",
  "name": "Two-Compartment Pharmacokinetics Model",
  "description": "A classic pharmacokinetic model tracking drug concentration in plasma (central compartment) and tissues (peripheral compartment). Models ADME - Absorption, Distribution, Metabolism, and Elimination. Used to design dosing regimens that maintain therapeutic drug levels while avoiding toxicity. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-drug-in-central-compartment",
      "name": "Drug in Central Compartment",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-drug-in-peripheral-compartment",
      "name": "Drug in Peripheral Compartment",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-drug-in-gi-tract",
      "name": "Drug in GI Tract",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-absorption",
      "name": "Absorption",
      "equation": "Ka * Drug_GI * Bioavailability",
      "from_stock": "stock-drug-in-gi-tract",
      "to_stock": "stock-drug-in-central-compartment",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-distribution",
      "name": "Distribution",
      "equation": "K12 * Drug_Central",
      "from_stock": "stock-drug-in-central-compartment",
      "to_stock": "stock-drug-in-peripheral-compartment",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-return-from-tissue",
      "name": "Return from Tissue",
      "equation": "K21 * Drug_Peripheral",
      "from_stock": "stock-drug-in-peripheral-compartment",
      "to_stock": "stock-drug-in-central-compartment",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-elimination",
      "name": "Elimination",
      "equation": "Kel * Drug_Central",
      "from_stock": "stock-drug-in-central-compartment",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-ka",
      "name": "Ka",
      "equation": "1.5",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-bioavailability",
      "name": "Bioavailability",
      "equation": "0.85",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-k12",
      "name": "K12",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-k21",
      "name": "K21",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-kel",
      "name": "Kel",
      "equation": "0.2",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-volume-central",
      "name": "Volume Central",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-plasma-concentration",
      "name": "Plasma Concentration",
      "equation": "Drug_Central / Volume_Central",
      "position": {
        "x": 250,
        "y": 160
      }
    },
    {
      "id": "var-half-life",
      "name": "Half Life",
      "equation": "0.693 / Kel",
      "position": {
        "x": 400,
        "y": 160
      }
    },
    {
      "id": "var-therapeutic-range-low",
      "name": "Therapeutic Range Low",
      "equation": "2",
      "position": {
        "x": 550,
        "y": 160
      }
    },
    {
      "id": "var-therapeutic-range-high",
      "name": "Therapeutic Range High",
      "equation": "10",
      "position": {
        "x": 700,
        "y": 160
      }
    },
    {
      "id": "var-therapeutic-status",
      "name": "Therapeutic Status",
      "equation": "IF Plasma_Concentration < Therapeutic_Range_Low THEN 0 ELSE IF Plasma_Concentration > Therapeutic_Range_High THEN 2 ELSE 1",
      "position": {
        "x": 100,
        "y": 240
      }
    },
    {
      "id": "var-clearance",
      "name": "Clearance",
      "equation": "Kel * Volume_Central",
      "position": {
        "x": 250,
        "y": 240
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Drug in GI Tract",
      "to_element": "Absorption"
    },
    {
      "id": "conn-2",
      "from_element": "Ka",
      "to_element": "Absorption"
    },
    {
      "id": "conn-3",
      "from_element": "Bioavailability",
      "to_element": "Absorption"
    },
    {
      "id": "conn-4",
      "from_element": "Drug in Central Compartment",
      "to_element": "Distribution"
    },
    {
      "id": "conn-5",
      "from_element": "Drug in Central Compartment",
      "to_element": "Elimination"
    },
    {
      "id": "conn-6",
      "from_element": "Drug in Peripheral Compartment",
      "to_element": "Return from Tissue"
    },
    {
      "id": "conn-7",
      "from_element": "Drug in Central Compartment",
      "to_element": "Plasma Concentration"
    },
    {
      "id": "conn-8",
      "from_element": "Volume Central",
      "to_element": "Plasma Concentration"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 24,
    "dt": 0.0625
  },
  "created_at": "2026-01-11T20:04:50.812079Z",
  "updated_at": "2026-01-11T20:04:50.812079Z",
  "source": "https://doi.org/10.1002/9780470918890",
  "reference": "Gibaldi M, Perrier D. Pharmacokinetics. 2nd ed. Marcel Dekker, 1982."
}