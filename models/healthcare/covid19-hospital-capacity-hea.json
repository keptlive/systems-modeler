{
  "id": "covid19-hospital-capacity-hea",
  "name": "COVID-19 Hospital Capacity Model",
  "description": "Hospital and ICU capacity model for COVID-19 surge planning. Models patient flow through general wards and ICU, with capacity constraints affecting outcomes. Based on healthcare system modeling during the pandemic. Source: Weissman et al. (2020), Annals of Internal Medicine. DOI: 10.7326/M20-1260",
  "stocks": [
    {
      "id": "stock-community",
      "name": "Community_Infected",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-hospitalized",
      "name": "Hospitalized",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-icu",
      "name": "ICU_Patients",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "stock-deceased",
      "name": "Deceased",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 600,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-admission",
      "name": "Hospital_Admission",
      "equation": "Community_Infected * Hospitalization_Rate",
      "from_stock": "stock-community",
      "to_stock": "stock-hospitalized",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-icu-transfer",
      "name": "ICU_Transfer",
      "equation": "Hospitalized * ICU_Rate * (ICU_Beds / (ICU_Patients + 1))",
      "from_stock": "stock-hospitalized",
      "to_stock": "stock-icu",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-hospital-recovery",
      "name": "Hospital_Recovery",
      "equation": "Hospitalized * (1 - ICU_Rate) / Hospital_LOS",
      "from_stock": "stock-hospitalized",
      "to_stock": "stock-recovered",
      "position": {
        "x": 300,
        "y": 275
      }
    },
    {
      "id": "flow-icu-recovery",
      "name": "ICU_Recovery",
      "equation": "ICU_Patients * ICU_Survival_Rate / ICU_LOS",
      "from_stock": "stock-icu",
      "to_stock": "stock-recovered",
      "position": {
        "x": 500,
        "y": 275
      }
    },
    {
      "id": "flow-icu-death",
      "name": "ICU_Death",
      "equation": "ICU_Patients * (1 - ICU_Survival_Rate) / ICU_LOS",
      "from_stock": "stock-icu",
      "to_stock": "stock-deceased",
      "position": {
        "x": 550,
        "y": 275
      }
    },
    {
      "id": "flow-community-recovery",
      "name": "Community_Recovery",
      "equation": "Community_Infected * (1 - Hospitalization_Rate) / Recovery_Time",
      "from_stock": "stock-community",
      "to_stock": "stock-recovered",
      "position": {
        "x": 150,
        "y": 275
      }
    }
  ],
  "variables": [
    {
      "id": "var-hosp-rate",
      "name": "Hospitalization_Rate",
      "equation": "0.05",
      "position": {
        "x": 150,
        "y": 80
      }
    },
    {
      "id": "var-icu-rate",
      "name": "ICU_Rate",
      "equation": "0.3",
      "position": {
        "x": 350,
        "y": 80
      }
    },
    {
      "id": "var-hospital-los",
      "name": "Hospital_LOS",
      "equation": "7",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-icu-los",
      "name": "ICU_LOS",
      "equation": "14",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-icu-survival",
      "name": "ICU_Survival_Rate",
      "equation": "0.7",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-icu-beds",
      "name": "ICU_Beds",
      "equation": "50",
      "position": {
        "x": 450,
        "y": 80
      }
    },
    {
      "id": "var-recovery-time",
      "name": "Recovery_Time",
      "equation": "14",
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Community_Infected",
      "to_element": "Hospital_Admission"
    },
    {
      "id": "conn-2",
      "from_element": "Hospitalization_Rate",
      "to_element": "Hospital_Admission"
    },
    {
      "id": "conn-3",
      "from_element": "Hospitalized",
      "to_element": "ICU_Transfer"
    },
    {
      "id": "conn-4",
      "from_element": "ICU_Rate",
      "to_element": "ICU_Transfer"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 180,
    "dt": 0.5
  },
  "created_at": "2026-01-11T20:47:58.493298Z",
  "updated_at": "2026-01-11T20:47:58.493298Z",
  "source": "https://doi.org/10.1016/j.chaos.2020.109889",
  "reference": "COVID-19 SEIR Models - Various Authors 2020-2022"
}