{
  "id": "long-covid-disease-burden-hea",
  "name": "Long COVID Disease Burden Model",
  "description": "System dynamics model of Long COVID (PASC) disease burden, capturing transition from acute COVID to chronic symptoms, healthcare utilization, and workforce impact. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "source": "https://doi.org/10.1038/s41591-021-01283-z",
  "reference": "Al-Aly Z, Xie Y, Bowe B. (2021). High-dimensional characterization of post-acute sequelae of COVID-19. Nature, 594, 259-264.",
  "stocks": [
    {
      "id": "stock-acute",
      "name": "Acute COVID Cases",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-recovered-full",
      "name": "Fully Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-long-covid",
      "name": "Long COVID Cases",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-long-covid-recovered",
      "name": "Long COVID Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-disabled",
      "name": "Chronically Disabled",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "stock-workforce-lost",
      "name": "Workforce Capacity Lost",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-new-cases",
      "name": "New Infections",
      "equation": "New_Infection_Rate",
      "from_stock": null,
      "to_stock": "stock-acute",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-full-recovery",
      "name": "Full Recovery",
      "equation": "Acute_COVID_Cases * (1 - Long_COVID_Rate) / Acute_Duration",
      "from_stock": "stock-acute",
      "to_stock": "stock-recovered-full",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-to-long-covid",
      "name": "Transition to Long COVID",
      "equation": "Acute_COVID_Cases * Long_COVID_Rate / Acute_Duration",
      "from_stock": "stock-acute",
      "to_stock": "stock-long-covid",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-lc-recovery",
      "name": "Long COVID Recovery",
      "equation": "Long_COVID_Cases * LC_Recovery_Rate / LC_Average_Duration",
      "from_stock": "stock-long-covid",
      "to_stock": "stock-long-covid-recovered",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-to-disabled",
      "name": "Chronic Disability",
      "equation": "Long_COVID_Cases * Disability_Rate / LC_Average_Duration",
      "from_stock": "stock-long-covid",
      "to_stock": "stock-disabled",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "flow-workforce-impact",
      "name": "Workforce Impact",
      "equation": "Long_COVID_Cases * Productivity_Loss_Fraction + Chronically_Disabled",
      "from_stock": null,
      "to_stock": "stock-workforce-lost",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-new-rate",
      "name": "New Infection Rate",
      "equation": "1000",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-lc-rate",
      "name": "Long COVID Rate",
      "equation": "0.15",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "var-acute-dur",
      "name": "Acute Duration",
      "equation": "14",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-lc-recovery",
      "name": "LC Recovery Rate",
      "equation": "0.7",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-lc-duration",
      "name": "LC Average Duration",
      "equation": "180",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "var-disability",
      "name": "Disability Rate",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "var-prod-loss",
      "name": "Productivity Loss Fraction",
      "equation": "0.5",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "var-healthcare-cost",
      "name": "Healthcare Cost per LC Case",
      "equation": "Long_COVID_Cases * 5000",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 730,
    "dt": 1
  },
  "created_at": "2026-01-12T03:15:51.638420+00:00",
  "updated_at": "2026-01-12T03:15:51.638420+00:00"
}