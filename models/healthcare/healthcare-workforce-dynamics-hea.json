{
  "id": "healthcare-workforce-dynamics-hea",
  "name": "Healthcare Workforce Dynamics Model",
  "description": "Models physician and nurse supply with training pipeline and burnout. Based on AAMC (2021) Physician Shortage Report. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-medstud",
      "name": "Medical_Students",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "stock-residents",
      "name": "Residents",
      "initial_value": 120,
      "equation": "",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "stock-physicians",
      "name": "Active_Physicians",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "stock-nurses",
      "name": "Active_Nurses",
      "initial_value": 3000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "stock-burnout",
      "name": "Burnout_Level",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 550,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-medenroll",
      "name": "Med_School_Enrollment",
      "equation": "Enrollment_Capacity * Applicant_Quality",
      "from_stock": null,
      "to_stock": "stock-medstud",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-medgrad",
      "name": "Med_School_Graduation",
      "equation": "Medical_Students / Med_School_Duration",
      "from_stock": "stock-medstud",
      "to_stock": "stock-residents",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "flow-rescomp",
      "name": "Residency_Completion",
      "equation": "Residents / Residency_Duration",
      "from_stock": "stock-residents",
      "to_stock": "stock-physicians",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "flow-physretire",
      "name": "Physician_Retirement",
      "equation": "Active_Physicians * Retirement_Rate * (1 + Burnout_Effect)",
      "from_stock": "stock-physicians",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "flow-nursehire",
      "name": "Nurse_Hiring",
      "equation": "Nursing_School_Graduates * Hiring_Rate",
      "from_stock": null,
      "to_stock": "stock-nurses",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "flow-nurseleave",
      "name": "Nurse_Turnover",
      "equation": "Active_Nurses * Turnover_Rate * (1 + Burnout_Effect)",
      "from_stock": "stock-nurses",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "flow-burnoutinc",
      "name": "Burnout_Increase",
      "equation": "Workload_Stress * Staff_Ratio_Pressure",
      "from_stock": null,
      "to_stock": "stock-burnout",
      "position": {
        "x": 500,
        "y": 125
      }
    },
    {
      "id": "flow-burnoutdec",
      "name": "Burnout_Recovery",
      "equation": "Burnout_Level * Recovery_Interventions",
      "from_stock": "stock-burnout",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 125
      }
    }
  ],
  "variables": [
    {
      "id": "var-enrollcap",
      "name": "Enrollment_Capacity",
      "equation": "25",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-appqual",
      "name": "Applicant_Quality",
      "equation": "0.9",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-meddur",
      "name": "Med_School_Duration",
      "equation": "4",
      "position": {
        "x": 175,
        "y": 50
      }
    },
    {
      "id": "var-resdur",
      "name": "Residency_Duration",
      "equation": "4",
      "position": {
        "x": 325,
        "y": 50
      }
    },
    {
      "id": "var-retirerate",
      "name": "Retirement_Rate",
      "equation": "0.03",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-burnouteff",
      "name": "Burnout_Effect",
      "equation": "Burnout_Level / 100",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "var-nursegrads",
      "name": "Nursing_School_Graduates",
      "equation": "150",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "var-hirerate",
      "name": "Hiring_Rate",
      "equation": "0.8",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "var-turnrate",
      "name": "Turnover_Rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "var-workstress",
      "name": "Workload_Stress",
      "equation": "Patient_Demand / (Active_Physicians + Active_Nurses / 4)",
      "position": {
        "x": 450,
        "y": 175
      }
    },
    {
      "id": "var-patdem",
      "name": "Patient_Demand",
      "equation": "5000 * (1 + 0.02 * TIME)",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "var-staffratio",
      "name": "Staff_Ratio_Pressure",
      "equation": "MAX(0.5, 1.5 - (Active_Physicians + Active_Nurses / 4) / Patient_Demand * 1000)",
      "position": {
        "x": 350,
        "y": 325
      }
    },
    {
      "id": "var-recovery",
      "name": "Recovery_Interventions",
      "equation": "0.05",
      "position": {
        "x": 600,
        "y": 175
      }
    },
    {
      "id": "var-shortage",
      "name": "Workforce_Shortage",
      "equation": "MAX(0, Patient_Demand / 1000 - Active_Physicians)",
      "position": {
        "x": 550,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Burnout_Level",
      "to_element": "Burnout_Effect"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:59:36.700432+00:00",
  "updated_at": "2026-01-12T02:59:36.700436+00:00",
  "source": "https://www.aamc.org/media/54681/download",
  "reference": "AAMC (2021). The Complexities of Physician Supply and Demand: Projections From 2019 to 2034."
}