{
  "id": "vaccine-distribution-equity-hea",
  "name": "Vaccine Distribution Equity Model",
  "description": "System dynamics model of global vaccine distribution considering equity, logistics, and cold chain constraints. Addresses disparities between high and low-income countries. Reference: Council of Supply Chain Management Professionals. Source: https://cscmp.org/",
  "source": "https://doi.org/10.1016/j.vaccine.2020.12.048",
  "reference": "Wouters OJ et al. (2021). Challenges in ensuring global access to COVID-19 vaccines: production, affordability, allocation. Lancet, 397(10278), 1023-1034.",
  "stocks": [
    {
      "id": "stock-global-supply",
      "name": "Global Vaccine Supply",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-hic-doses",
      "name": "High Income Country Doses",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-lmic-doses",
      "name": "Low/Middle Income Doses",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "stock-hic-vaccinated",
      "name": "HIC Vaccinated Population",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "stock-lmic-vaccinated",
      "name": "LMIC Vaccinated Population",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "stock-wasted",
      "name": "Wasted Doses",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-production",
      "name": "Vaccine Production",
      "equation": "Production_Capacity * Capacity_Utilization",
      "from_stock": null,
      "to_stock": "stock-global-supply",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-hic-allocation",
      "name": "HIC Allocation",
      "equation": "Global_Vaccine_Supply * HIC_Allocation_Share / Allocation_Time",
      "from_stock": "stock-global-supply",
      "to_stock": "stock-hic-doses",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-lmic-allocation",
      "name": "LMIC Allocation",
      "equation": "Global_Vaccine_Supply * (1 - HIC_Allocation_Share) / Allocation_Time",
      "from_stock": "stock-global-supply",
      "to_stock": "stock-lmic-doses",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "flow-hic-admin",
      "name": "HIC Administration",
      "equation": "MIN(High_Income_Country_Doses / Admin_Time, HIC_Admin_Capacity) * HIC_Uptake",
      "from_stock": "stock-hic-doses",
      "to_stock": "stock-hic-vaccinated",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-lmic-admin",
      "name": "LMIC Administration",
      "equation": "MIN(Low_Middle_Income_Doses / Admin_Time, LMIC_Admin_Capacity) * LMIC_Uptake * Cold_Chain_Factor",
      "from_stock": "stock-lmic-doses",
      "to_stock": "stock-lmic-vaccinated",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "flow-hic-waste",
      "name": "HIC Wastage",
      "equation": "High_Income_Country_Doses * HIC_Wastage_Rate",
      "from_stock": "stock-hic-doses",
      "to_stock": "stock-wasted",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-lmic-waste",
      "name": "LMIC Wastage",
      "equation": "Low_Middle_Income_Doses * LMIC_Wastage_Rate",
      "from_stock": "stock-lmic-doses",
      "to_stock": "stock-wasted",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-prod-cap",
