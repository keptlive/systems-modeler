{
  "id": "gene-therapy-development-pipeline-hea",
  "name": "Gene Therapy Development Pipeline Model",
  "description": "Model of gene therapy drug development from discovery through approval. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Discovery_Phase",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Preclinical",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Clinical_Trials",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Approved_Therapies",
      "initial_value": 2,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "New_Discoveries",
      "equation": "Discovery_Rate",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "f2",
      "name": "To_Preclinical",
      "equation": "Discovery_Phase * Discovery_Success_Rate / Discovery_Duration",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Discovery_Failures",
      "equation": "Discovery_Phase * (1 - Discovery_Success_Rate) / Discovery_Duration",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "To_Clinical",
      "equation": "Preclinical * Preclinical_Success_Rate / Preclinical_Duration",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Preclinical_Failures",
      "equation": "Preclinical * (1 - Preclinical_Success_Rate) / Preclinical_Duration",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f6",
      "name": "Approvals",
      "equation": "Clinical_Trials * Clinical_Success_Rate / Clinical_Duration",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "f7",
      "name": "Clinical_Failures",
      "equation": "Clinical_Trials * (1 - Clinical_Success_Rate) / Clinical_Duration",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Discovery_Rate",
      "equation": "20",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "v2",
      "name": "Discovery_Success_Rate",
      "equation": "0.3",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Discovery_Duration",
      "equation": "2",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "v4",
      "name": "Preclinical_Success_Rate",
      "equation": "0.5",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Preclinical_Duration",
      "equation": "3",
      "position": {
        "x": 325,
        "y": 150
      }
    },
    {
      "id": "v6",
      "name": "Clinical_Success_Rate",
      "equation": "0.2",
      "position": {
        "x": 475,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Clinical_Duration",
      "equation": "7",
      "position": {
        "x": 475,
        "y": 150
      }
    },
    {
      "id": "v8",
      "name": "Overall_Success_Rate",
      "equation": "Discovery_Success_Rate * Preclinical_Success_Rate * Clinical_Success_Rate",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Total_Pipeline",
      "equation": "Discovery_Phase + Preclinical + Clinical_Trials",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 20,
    "dt": 0.5,
    "integration_method": "euler"
  },
