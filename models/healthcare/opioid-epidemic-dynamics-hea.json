{
  "id": "opioid-epidemic-dynamics-hea",
  "name": "Opioid Epidemic Dynamics Model",
  "description": "Models the dynamics of opioid addiction including prescription pathways, illicit drug transition, treatment capacity, overdose deaths, and the role of harm reduction. Based on CDC opioid surveillance data and NIDA research.",
  "source": "https://doi.org/10.1126/science.aau5514",
  "reference": "Jalal H, et al. Changing dynamics of the drug overdose epidemic in the United States. Science. 2018. CDC Wide-ranging Online Data for Epidemiologic Research (WONDER).",
  "stocks": [
    {"id": "stock-naive", "name": "Opioid Naive Population", "initial_value": 250000000, "equation": "", "position": {"x": 100, "y": 150}},
    {"id": "stock-prescription-users", "name": "Prescription Users", "initial_value": 10000000, "equation": "", "position": {"x": 250, "y": 150}},
    {"id": "stock-misusers", "name": "Misusers", "initial_value": 5000000, "equation": "", "position": {"x": 400, "y": 150}},
    {"id": "stock-oud", "name": "Opioid Use Disorder", "initial_value": 2000000, "equation": "", "position": {"x": 550, "y": 150}},
    {"id": "stock-treatment", "name": "In Treatment", "initial_value": 500000, "equation": "", "position": {"x": 700, "y": 150}},
    {"id": "stock-deaths", "name": "Overdose Deaths", "initial_value": 0, "equation": "", "position": {"x": 700, "y": 300}}
  ],
  "flows": [
    {"id": "flow-new-prescriptions", "name": "New Prescriptions", "equation": "Opioid_Naive_Population * Prescription_Rate", "from_stock": "stock-naive", "to_stock": "stock-prescription-users", "position": {"x": 175, "y": 150}},
    {"id": "flow-to-misuse", "name": "Transition to Misuse", "equation": "Prescription_Users * Misuse_Rate", "from_stock": "stock-prescription-users", "to_stock": "stock-misusers", "position": {"x": 325, "y": 150}},
    {"id": "flow-to-oud", "name": "Develop OUD", "equation": "Misusers * OUD_Development_Rate", "from_stock": "stock-misusers", "to_stock": "stock-oud", "position": {"x": 475, "y": 150}},
    {"id": "flow-enter-treatment", "name": "Enter Treatment", "equation": "MIN(Opioid_Use_Disorder * Treatment_Seeking_Rate, Treatment_Capacity)", "from_stock": "stock-oud", "to_stock": "stock-treatment", "position": {"x": 625, "y": 150}},
    {"id": "flow-overdose", "name": "Overdose Deaths", "equation": "Opioid_Use_Disorder * Overdose_Rate", "from_stock": "stock-oud", "to_stock": "stock-deaths", "position": {"x": 625, "y": 225}}
  ],
  "variables": [
    {"id": "var-prescription-rate", "name": "Prescription_Rate", "equation": "0.005", "position": {"x": 175, "y": 100}},
    {"id": "var-misuse-rate", "name": "Misuse_Rate", "equation": "0.03", "position": {"x": 325, "y": 100}},
    {"id": "var-oud-rate", "name": "OUD_Development_Rate", "equation": "0.05", "position": {"x": 475, "y": 100}},
    {"id": "var-treatment-seeking", "name": "Treatment_Seeking_Rate", "equation": "0.02", "position": {"x": 625, "y": 100}},
    {"id": "var-treatment-capacity", "name": "Treatment_Capacity", "equation": "100000", "position": {"x": 700, "y": 100}},
    {"id": "var-overdose", "name": "Overdose_Rate", "equation": "0.003", "position": {"x": 625, "y": 275}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 120, "dt": 1},
  "created_at": "2026-01-15T21:00:00.000000+00:00",
  "updated_at": "2026-01-15T21:00:00.000000+00:00"
}
