{
  "id": "substance-addiction-recovery-dynamics-hea",
  "name": "Substance Addiction and Recovery Dynamics",
  "description": "Model of addiction progression and recovery with relapse dynamics and treatment. Based on Homer et al. addiction modeling research. Reference: Koob, G. F., & Volkow, N. D. (2016). Neurobiology of addiction. Lancet Psychiatry. Source: https://doi.org/10.1016/S2215-0366(16)00104-8",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 0.85,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Casual Users",
      "initial_value": 0.08,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Addicted",
      "initial_value": 0.05,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "In Treatment",
      "initial_value": 0.01,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "s5",
      "name": "Recovered",
      "initial_value": 0.01,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Initiation",
      "equation": "Susceptible * Initiation_Rate * Social_Exposure",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Addiction Development",
      "equation": "Casual_Users * Addiction_Rate * Vulnerability",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Treatment Entry",
      "equation": "Addicted * Treatment_Seeking_Rate * Treatment_Availability",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 400,
        "y": 275
      }
    },
    {
      "id": "f4",
      "name": "Treatment Completion",
      "equation": "In_Treatment * Treatment_Success_Rate",
      "from_stock": "s4",
      "to_stock": "s5",
      "position": {
        "x": 325,
        "y": 350
      }
    },
    {
      "id": "f5",
      "name": "Relapse",
      "equation": "Recovered * Relapse_Rate * Stress_Factor",
      "from_stock": "s5",
      "to_stock": "s3",
      "position": {
        "x": 325,
        "y": 275
      }
    },
    {
      "id": "f6",
      "name": "Casual to Clean",
      "equation": "Casual_Users * Spontaneous_Quit_Rate",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "f7",
      "name": "Treatment Dropout",
      "equation": "In_Treatment * Dropout_Rate",
      "from_stock": "s4",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 275
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Initiation Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v2",
      "name": "Social Exposure",
      "equation": "1 + Casual_Users * 5 + Addicted * 2",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Addiction Rate",
      "equation": "0.1",
      "position": {
        "x": 325,
        "y": 150
      }
    },
    {
      "id": "v4",
      "name": "Vulnerability",
      "equation": "1.2",
      "position": {
        "x": 275,
        "y": 150
      }
    },
    {
      "id": "v5",
      "name": "Treatment Seeking Rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "v6",
      "name": "Treatment Availability",
      "equation": "0.7",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "v7",
      "name": "Treatment Success Rate",
      "equation": "0.1",
      "position": {
        "x": 325,
        "y": 400
      }
    },
    {
      "id": "v8",
      "name": "Relapse Rate",
      "equation": "0.3",
      "position": {
        "x": 275,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "Stress Factor",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "v10",
      "name": "Spontaneous Quit Rate",
      "equation": "0.05",
      "position": {
        "x": 175,
        "y": 250
      }
    },
    {
      "id": "v11",
      "name": "Dropout Rate",
      "equation": "0.2",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "v12",
      "name": "Addiction Prevalence",
      "equation": "Addicted + In_Treatment",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "v13",
      "name": "Recovery Success Rate",
      "equation": "Recovered / (Recovered + Addicted + In_Treatment + 0.001)",
      "position": {
        "x": 250,
        "y": 400
      }
    }
  ],
  "connectors": [
