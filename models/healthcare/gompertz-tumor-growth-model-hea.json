{
  "id": "gompertz-tumor-growth-model-hea",
  "name": "Gompertz Tumor Growth Model",
  "description": "Models tumor growth using the Gompertz equation, which captures the characteristic slowing of growth as tumors enlarge. Initially tumors grow exponentially, but growth rate decreases as the tumor outgrows its blood supply and nutrients become limiting. Widely used in oncology for treatment planning and prognosis. Reference: Byrne, H. M. (2010). Dissecting cancer through mathematics. Nature Reviews Cancer. Source: https://doi.org/10.1038/nrc2808",
  "stocks": [
    {
      "id": "stock-tumor-volume",
      "name": "Tumor Volume",
      "initial_value": 0.01,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-tumor-growth",
      "name": "Tumor Growth",
      "equation": "Growth_Rate * Tumor_Volume * LN(Carrying_Capacity / Tumor_Volume)",
      "from_stock": null,
      "to_stock": "stock-tumor-volume",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-treatment-kill",
      "name": "Treatment Kill",
      "equation": "Treatment_Effect * Tumor_Volume",
      "from_stock": "stock-tumor-volume",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-growth-rate",
      "name": "Growth Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-carrying-capacity",
      "name": "Carrying Capacity",
      "equation": "1000",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-treatment-effect",
      "name": "Treatment Effect",
      "equation": "IF Treatment_Active THEN Kill_Rate ELSE 0",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-treatment-active",
      "name": "Treatment Active",
      "equation": "IF Time >= Treatment_Start AND Time <= Treatment_End THEN 1 ELSE 0",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-treatment-start",
      "name": "Treatment Start",
      "equation": "30",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-treatment-end",
      "name": "Treatment End",
      "equation": "60",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-kill-rate",
      "name": "Kill Rate",
      "equation": "0.05",
      "position": {
        "x": 250,
        "y": 160
      }
    },
    {
      "id": "var-doubling-time",
      "name": "Doubling Time",
      "equation": "0.693 / (Growth_Rate * LN(Carrying_Capacity / Tumor_Volume))",
      "position": {
        "x": 400,
        "y": 160
      }
    },
    {
      "id": "var-tumor-diameter",
      "name": "Tumor Diameter",
      "equation": "2 * (3 * Tumor_Volume / (4 * 3.14159))^0.333",
      "position": {
        "x": 550,
        "y": 160
      }
    },
    {
      "id": "var-clinical-stage",
      "name": "Clinical Stage",
      "equation": "IF Tumor_Diameter < 2 THEN 1 ELSE IF Tumor_Diameter < 5 THEN 2 ELSE IF Tumor_Diameter < 10 THEN 3 ELSE 4",
      "position": {
        "x": 700,
        "y": 160
      }
    },
    {
      "id": "var-detection-threshold",
      "name": "Detection Threshold",
      "equation": "1",
      "position": {
        "x": 100,
        "y": 240
      }
    },
    {
      "id": "var-is-detectable",
      "name": "Is Detectable",
      "equation": "IF Tumor_Volume >= Detection_Threshold THEN 1 ELSE 0",
      "position": {
        "x": 250,
        "y": 240
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Tumor Volume",
      "to_element": "Tumor Growth"
    },
    {
      "id": "conn-2",
      "from_element": "Growth Rate",
      "to_element": "Tumor Growth"
    },
    {
      "id": "conn-3",
      "from_element": "Carrying Capacity",
      "to_element": "Tumor Growth"
    },
    {
      "id": "conn-4",
      "from_element": "Tumor Volume",
      "to_element": "Treatment Kill"
    },
    {
      "id": "conn-5",
      "from_element": "Treatment Effect",
      "to_element": "Treatment Kill"
    },
    {
      "id": "conn-6",
      "from_element": "Treatment Active",
      "to_element": "Treatment Effect"
    },
    {
      "id": "conn-7",
      "from_element": "Tumor Volume",
      "to_element": "Tumor Diameter"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "created_at": "2026-01-11T20:04:50.820627Z",
  "updated_at": "2026-01-11T20:04:50.820627Z",
  "source": "https://doi.org/10.1016/j.socscimed.2013.03.004",
  "reference": "Healthcare System Dynamics Models"
}