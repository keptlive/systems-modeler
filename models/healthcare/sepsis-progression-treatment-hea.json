{
  "id": "sepsis-progression-treatment-hea",
  "name": "Sepsis Progression and Treatment Response",
  "description": "Models sepsis progression from infection to organ failure and treatment effects. Based on Singer et al. (2016) Sepsis-3 definitions, JAMA. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "category": "health",
  "stocks": [
    {
      "id": "stock-pathogen",
      "name": "Pathogen_Load",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-immune",
      "name": "Immune_Response",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-organ",
      "name": "Organ_Function",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-inflam",
      "name": "Inflammation_Level",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-pathogen-grow",
      "name": "Pathogen_Growth",
      "equation": "Pathogen_Load * Growth_Rate * (1 - Pathogen_Load/Max_Load) * (1 - Antibiotic_Effect)",
      "from_stock": null,
      "to_stock": "stock-pathogen",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-pathogen-kill",
      "name": "Pathogen_Clearance",
      "equation": "Pathogen_Load * Immune_Response * Kill_Rate / 1000",
      "from_stock": "stock-pathogen",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-immune-up",
      "name": "Immune_Activation",
      "equation": "(Pathogen_Load / 10) * Activation_Rate",
      "from_stock": null,
      "to_stock": "stock-immune",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-immune-down",
      "name": "Immune_Exhaustion",
      "equation": "Immune_Response * Exhaustion_Rate * Inflammation_Level / 100",
      "from_stock": "stock-immune",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-organ-damage",
      "name": "Organ_Damage",
      "equation": "Organ_Function * Damage_Rate * (Pathogen_Load + Inflammation_Level) / 200",
      "from_stock": "stock-organ",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "flow-organ-recover",
      "name": "Organ_Recovery",
      "equation": "(100 - Organ_Function) * Recovery_Rate * (1 - Inflammation_Level/200)",
      "from_stock": null,
      "to_stock": "stock-organ",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "flow-inflam-up",
      "name": "Inflammation_Increase",
      "equation": "Pathogen_Load * Inflam_Rate + Immune_Response * Cytokine_Release",
      "from_stock": null,
      "to_stock": "stock-inflam",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-inflam-down",
      "name": "Inflammation_Resolution",
      "equation": "Inflammation_Level * Resolution_Rate",
      "from_stock": "stock-inflam",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
