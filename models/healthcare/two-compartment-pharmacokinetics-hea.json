{
  "id": "two-compartment-pharmacokinetics-hea",
  "name": "Two-Compartment Pharmacokinetic Model",
  "description": "Standard two-compartment model for drug distribution between central (blood) and peripheral (tissue) compartments. Used in clinical pharmacology for dosing optimization. Based on Gibaldi & Perrier (1982) textbook principles. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-central",
      "name": "Drug in Central Compartment",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-peripheral",
      "name": "Drug in Peripheral Compartment",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-elimination",
      "name": "Elimination",
      "equation": "Drug_in_Central_Compartment * Elimination_Rate",
      "from_stock": "stock-central",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-central-to-peripheral",
      "name": "Central to Peripheral",
      "equation": "Drug_in_Central_Compartment * K12",
      "from_stock": "stock-central",
      "to_stock": "stock-peripheral",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-peripheral-to-central",
      "name": "Peripheral to Central",
      "equation": "Drug_in_Peripheral_Compartment * K21",
      "from_stock": "stock-peripheral",
      "to_stock": "stock-central",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-elimination-rate",
      "name": "Elimination Rate (k10)",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-k12",
      "name": "K12 (Central to Peripheral Rate)",
      "equation": "0.05",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-k21",
      "name": "K21 (Peripheral to Central Rate)",
      "equation": "0.03",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-central-concentration",
      "name": "Central Concentration",
      "equation": "Drug_in_Central_Compartment / Volume_Central",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-volume-central",
      "name": "Volume Central",
      "equation": "5",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-half-life",
      "name": "Half Life",
      "equation": "0.693 / Elimination_Rate",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-clearance",
      "name": "Clearance",
      "equation": "Elimination_Rate * Volume_Central",
      "position": {
        "x": 250,
        "y": 160
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 48,
    "dt": 0.1
  },
  "created_at": "2026-01-11T21:11:32.978647+00:00",
  "updated_at": "2026-01-11T21:11:32.978647+00:00",
  "source": "https://doi.org/10.1002/9780470918890",
  "reference": "Gibaldi M, Perrier D. Pharmacokinetics. 2nd ed. Marcel Dekker, 1982."
}