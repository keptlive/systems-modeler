{
  "id": "healthcare-worker-burnout-hea",
  "name": "Healthcare Worker Burnout Dynamics",
  "description": "Model of healthcare worker burnout. Source: Maslach & Leiter (2016); Shaukat et al. (2020).",
  "stocks": [
    {
      "id": "stock-engaged",
      "name": "Engaged",
      "initial_value": 800,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-burnout",
      "name": "Burned_Out",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-stress",
      "name": "Burnout_Onset",
      "equation": "Engaged * Stress_Rate * Workload",
      "from_stock": "stock-engaged",
      "to_stock": "stock-burnout",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-recover",
      "name": "Recovery",
      "equation": "Burned_Out * Recovery_Rate",
      "from_stock": "stock-burnout",
      "to_stock": "stock-engaged",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "flow-leave",
      "name": "Turnover",
      "equation": "Burned_Out * Turnover_Rate",
      "from_stock": "stock-burnout",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-stress",
      "name": "Stress_Rate",
      "equation": "0.05",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-work",
      "name": "Workload",
      "equation": "1.5",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-recover",
      "name": "Recovery_Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-turnover",
      "name": "Turnover_Rate",
      "equation": "0.2",
      "position": {
        "x": 350,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T12:50:58.059814+00:00",
  "updated_at": "2026-01-12T12:50:58.059814+00:00",
  "source": "https://doi.org/10.1016/j.cmi.2020.05.021",
  "reference": "Shaukat N, Ali DM, Razzak J. Physical and mental health impacts of COVID-19 on healthcare workers. Clinical Microbiology and Infection. 2020;26(9):1161-1163."
}