{
  "id": "nursing-shortage-healthcare-hea",
  "name": "Nursing Shortage Self-Reinforcing Feedback Model",
  "description": "Models the nursing workforce shortage dynamics including burnout, retirement, training pipeline constraints, and the self-reinforcing feedback loops that worsen shortages. Based on ANA and Bureau of Labor Statistics projections.",
  "source": "https://doi.org/10.1097/NNA.0000000000001123",
  "reference": "American Nurses Association. Nursing Shortage. Bureau of Labor Statistics Occupational Outlook. Aiken LH, et al. Hospital nurse staffing and patient mortality. JAMA. 2002.",
  "stocks": [
    {"id": "stock-active-nurses", "name": "Active Nurses", "initial_value": 3000000, "equation": "", "position": {"x": 300, "y": 150}},
    {"id": "stock-nursing-students", "name": "Nursing Students", "initial_value": 200000, "equation": "", "position": {"x": 100, "y": 150}},
    {"id": "stock-retired", "name": "Retired Nurses", "initial_value": 500000, "equation": "", "position": {"x": 500, "y": 150}},
    {"id": "stock-burnout-pool", "name": "Burnout Pool", "initial_value": 100000, "equation": "", "position": {"x": 300, "y": 300}},
    {"id": "stock-demand", "name": "Nursing Demand", "initial_value": 3500000, "equation": "", "position": {"x": 500, "y": 300}}
  ],
  "flows": [
    {"id": "flow-enrollment", "name": "New Enrollment", "equation": "Enrollment_Rate * Attractiveness * Program_Capacity", "from_stock": null, "to_stock": "stock-nursing-students", "position": {"x": 100, "y": 100}},
    {"id": "flow-graduation", "name": "Graduation", "equation": "Nursing_Students / Training_Duration", "from_stock": "stock-nursing-students", "to_stock": "stock-active-nurses", "position": {"x": 200, "y": 150}},
    {"id": "flow-retirement", "name": "Retirement", "equation": "Active_Nurses * Retirement_Rate", "from_stock": "stock-active-nurses", "to_stock": "stock-retired", "position": {"x": 400, "y": 150}},
    {"id": "flow-leaving", "name": "Leaving Profession", "equation": "Active_Nurses * Burnout_Rate * Workload_Stress", "from_stock": "stock-active-nurses", "to_stock": "stock-burnout-pool", "position": {"x": 300, "y": 225}},
    {"id": "flow-returning", "name": "Returning", "equation": "Burnout_Pool * Return_Rate * (1 - Shortage_Severity)", "from_stock": "stock-burnout-pool", "to_stock": "stock-active-nurses", "position": {"x": 250, "y": 225}},
    {"id": "flow-demand-growth", "name": "Demand Growth", "equation": "Nursing_Demand * Population_Aging_Effect", "from_stock": null, "to_stock": "stock-demand", "position": {"x": 500, "y": 250}}
  ],
  "variables": [
    {"id": "var-enrollment", "name": "Enrollment_Rate", "equation": "50000", "position": {"x": 50, "y": 100}},
    {"id": "var-attractiveness", "name": "Attractiveness", "equation": "1 - Shortage_Severity * 0.5", "position": {"x": 150, "y": 100}},
    {"id": "var-capacity", "name": "Program_Capacity", "equation": "1", "position": {"x": 50, "y": 200}},
    {"id": "var-training", "name": "Training_Duration", "equation": "4", "position": {"x": 150, "y": 200}},
    {"id": "var-retirement", "name": "Retirement_Rate", "equation": "0.03", "position": {"x": 450, "y": 100}},
    {"id": "var-burnout", "name": "Burnout_Rate", "equation": "0.02", "position": {"x": 350, "y": 300}},
    {"id": "var-workload", "name": "Workload_Stress", "equation": "1 + Shortage_Severity", "position": {"x": 250, "y": 350}},
    {"id": "var-shortage", "name": "Shortage_Severity", "equation": "MAX(0, (Nursing_Demand - Active_Nurses) / Nursing_Demand)", "position": {"x": 400, "y": 250}},
    {"id": "var-return", "name": "Return_Rate", "equation": "0.05", "position": {"x": 200, "y": 300}},
    {"id": "var-aging", "name": "Population_Aging_Effect", "equation": "0.02", "position": {"x": 600, "y": 250}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 240, "dt": 1},
  "created_at": "2026-01-15T21:00:00.000000+00:00",
  "updated_at": "2026-01-15T21:00:00.000000+00:00"
}
