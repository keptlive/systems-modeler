{
  "id": "antibiotic-pharmacodynamics-emax-hea",
  "name": "Antibiotic Pharmacodynamic Emax Model",
  "description": "Concentration-effect relationship for antibiotics with Emax model. Source: Mouton et al. (2005), Clin Microbiol Infect.",
  "stocks": [
    {
      "id": "s1",
      "name": "Bacterial_Count",
      "initial_value": 100000000.0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Drug_Concentration",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Bacterial_Growth",
      "equation": "k_growth * Bacterial_Count * (1 - Bacterial_Count / K_max) - Kill_Rate * Bacterial_Count",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Drug_Elimination",
      "equation": "-ke * Drug_Concentration",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "k_growth",
      "equation": "0.5",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "K_max",
      "equation": "1e10",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Emax",
      "equation": "2.0",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "EC50",
      "equation": "5",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "ke",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Hill",
      "equation": "2",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Kill_Rate",
      "equation": "Emax * Drug_Concentration^Hill / (EC50^Hill + Drug_Concentration^Hill)",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Drug_Concentration",
      "to_element": "Kill_Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 24,
    "dt": 0.1
  },
  "created_at": "2026-01-15T14:39:40.986701+00:00",
  "updated_at": "2026-01-15T14:39:40.986704+00:00",
  "source": "https://doi.org/10.1111/j.1469-0691.2005.01029.x",
  "reference": "Mouton, J.W. et al. (2005). Standardization of pharmacokinetic/pharmacodynamic terminology. Clin Microbiol Infect 11:59-64."
}