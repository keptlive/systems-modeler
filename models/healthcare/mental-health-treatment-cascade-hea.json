{
  "id": "mental-health-treatment-cascade-hea",
  "name": "Mental Health Treatment Cascade",
  "description": "Model of the mental health treatment cascade showing how people progress from undiagnosed to diagnosed, treated, and recovered. Highlights treatment gaps and barriers to care. Reference: WHO (2022). Mental Health Action Plan. Source: https://www.who.int/publications/i/item/9789241506021",
  "source": "https://doi.org/10.1016/S0140-6736(07)61238-0",
  "reference": "Wang PS, Aguilar-Gaxiola S, Alonso J, et al. Use of mental health services for anxiety, mood, and substance disorders in 17 countries. Lancet. 2007;370(9590):841-850.",
  "stocks": [
    {
      "id": "stock-undiag",
      "name": "Undiagnosed",
      "initial_value": 150,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-diagnosed",
      "name": "Diagnosed_Untreated",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-treated",
      "name": "In_Treatment",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-onset",
      "name": "Disorder_Onset",
      "equation": "incidence_rate * general_population",
      "from_stock": null,
      "to_stock": "stock-undiag",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-diagnose",
      "name": "Diagnosis",
      "equation": "Undiagnosed * diagnosis_rate * screening_coverage",
      "from_stock": "stock-undiag",
      "to_stock": "stock-diagnosed",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-treat",
      "name": "Treatment_Initiation",
      "equation": "Diagnosed_Untreated * treatment_rate * access_to_care",
      "from_stock": "stock-diagnosed",
      "to_stock": "stock-treated",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-recover",
      "name": "Recovery",
      "equation": "In_Treatment * recovery_rate * treatment_effectiveness",
      "from_stock": "stock-treated",
      "to_stock": "stock-recovered",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-dropout",
      "name": "Treatment_Dropout",
      "equation": "In_Treatment * dropout_rate",
      "from_stock": "stock-treated",
      "to_stock": "stock-diagnosed",
      "position": {
        "x": 325,
        "y": 300
      }
    },
    {
      "id": "flow-relapse",
      "name": "Relapse",
      "equation": "Recovered * relapse_rate",
      "from_stock": "stock-recovered",
      "to_stock": "stock-undiag",
      "position": {
        "x": 325,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "var-incid",
      "name": "incidence_rate",
      "equation": "0.03",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-pop",
      "name": "general_population",
      "equation": "1000",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "var-diag",
      "name": "diagnosis_rate",
      "equation": "0.1",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "var-screen",
      "name": "screening_coverage",
      "equation": "0.5",
      "position": {
        "x": 175,
        "y": 300
      }
    },
    {
      "id": "var-treat",
      "name": "treatment_rate",
      "equation": "0.2",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "var-access",
      "name": "access_to_care",
      "equation": "0.6",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "var-recov",
      "name": "recovery_rate",
      "equation": "0.15",
      "position": {
        "x": 475,
        "y": 100
      }
    },
    {
      "id": "var-eff",
      "name": "treatment_effectiveness",
      "equation": "0.7",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-drop",
      "name": "dropout_rate",
      "equation": "0.1",
      "position": {
        "x": 325,
        "y": 350
      }
    },
    {
      "id": "var-relapse",
      "name": "relapse_rate",
      "equation": "0.05",
      "position": {
        "x": 325,
        "y": 50
      }
    },
    {
      "id": "var-gap",
      "name": "Treatment_Gap",
      "equation": "(Undiagnosed + Diagnosed_Untreated) / (Undiagnosed + Diagnosed_Untreated + In_Treatment + Recovered)",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T12:00:00.000000+00:00",
  "updated_at": "2026-01-12T12:00:00.000000+00:00"
}