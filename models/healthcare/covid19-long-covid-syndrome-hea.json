{
  "id": "covid19-long-covid-syndrome-hea",
  "name": "COVID-19 Long COVID Syndrome Model",
  "description": "Model of post-acute COVID-19 syndrome progression, recovery, and healthcare burden. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Acute_Cases",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Long_COVID_Patients",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Recovered",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 550,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Developing_Long_COVID",
      "equation": "Long_COVID_Rate * Acute_Cases / Recovery_Time_Acute",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Full_Recovery_Acute",
      "equation": "(1 - Long_COVID_Rate) * Acute_Cases / Recovery_Time_Acute",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "f3",
      "name": "Long_COVID_Recovery",
      "equation": "Long_COVID_Patients / Long_COVID_Duration",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "New_Cases",
      "equation": "Daily_Incidence",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Long_COVID_Rate",
      "equation": "0.15",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Recovery_Time_Acute",
      "equation": "14",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Long_COVID_Duration",
      "equation": "90",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Daily_Incidence",
      "equation": "100",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Healthcare_Burden",
      "equation": "Long_COVID_Patients * Healthcare_Cost_per_Patient",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "v6",
      "name": "Healthcare_Cost_per_Patient",
      "equation": "0.5",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "v7",
      "name": "Disability_Days",
      "equation": "Long_COVID_Patients * Disability_Factor",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "v8",
      "name": "Disability_Factor",
      "equation": "0.3",
      "position": {
        "x": 150,
        "y": 250
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:29:23.539438+00:00",
  "updated_at": "2026-01-12T11:29:23.539438+00:00",
  "source": "https://doi.org/10.1038/s41591-022-01909-w",
  "reference": "Davis HE, et al. Long COVID: major findings, mechanisms and recommendations. Nature Reviews Microbiology. 2023;21:133-146."
}