{
  "id": "renal-drug-clearance-model-hea",
  "name": "Renal Drug Clearance Model",
  "description": "Model of renal drug elimination including glomerular filtration and tubular processes. Source: Rowland & Tozer (2010), Clinical Pharmacokinetics.",
  "stocks": [
    {
      "id": "s1",
      "name": "Plasma_Drug",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Tubular_Drug",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Glomerular_Filtration",
      "equation": "GFR * fu * Plasma_Drug / Vd",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Tubular_Reabsorption",
      "equation": "Reabsorption_Rate * Tubular_Drug",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 300,
        "y": 280
      }
    },
    {
      "id": "f3",
      "name": "Urinary_Excretion",
      "equation": "Tubular_Drug * Excretion_Rate",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "GFR",
      "equation": "120",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "fu",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Vd",
      "equation": "50",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Reabsorption_Rate",
      "equation": "0.5",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Excretion_Rate",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Renal_Clearance",
      "equation": "GFR * fu * (1 - Reabsorption_Rate / (Reabsorption_Rate + Excretion_Rate))",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Plasma_Drug",
      "to_element": "Glomerular_Filtration"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 24,
    "dt": 0.1
  },
  "created_at": "2026-01-15T14:39:40.986735+00:00",
  "updated_at": "2026-01-15T14:39:40.986739+00:00",
  "source": "https://doi.org/10.1002/9780470035153",
  "reference": "Rowland, M. & Tozer, T.N. (2010). Clinical Pharmacokinetics and Pharmacodynamics. 4th ed. Lippincott Williams & Wilkins."
}