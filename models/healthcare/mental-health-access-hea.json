{
  "id": "mental-health-access-hea",
  "name": "Mental Health Service Access",
  "description": "Model of mental health service capacity. Source: WHO mhGAP; Wang et al. (2007), Lancet.",
  "stocks": [
    {
      "id": "stock-need",
      "name": "Unmet_Need",
      "initial_value": 800,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-treat",
      "name": "In_Treatment",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-recover",
      "name": "Recovered",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-new",
      "name": "New_Cases",
      "equation": "Incidence_Rate * Population / 100",
      "from_stock": null,
      "to_stock": "stock-need",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-access",
      "name": "Service_Access",
      "equation": "MIN(Unmet_Need * Access_Rate, Service_Capacity)",
      "from_stock": "stock-need",
      "to_stock": "stock-treat",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-recover",
      "name": "Recovery",
      "equation": "In_Treatment * Recovery_Rate * Treatment_Quality",
      "from_stock": "stock-treat",
      "to_stock": "stock-recover",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-relapse",
      "name": "Relapse",
      "equation": "Recovered * Relapse_Rate",
      "from_stock": "stock-recover",
      "to_stock": "stock-need",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "flow-dropout",
      "name": "Dropout",
      "equation": "In_Treatment * Dropout_Rate",
      "from_stock": "stock-treat",
      "to_stock": "stock-need",
      "position": {
        "x": 175,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-incid",
      "name": "Incidence_Rate",
      "equation": "5",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-pop",
      "name": "Population",
      "equation": "10000",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-access",
      "name": "Access_Rate",
      "equation": "0.1",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "var-cap",
      "name": "Service_Capacity",
      "equation": "50 + TIME",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "var-recrate",
      "name": "Recovery_Rate",
      "equation": "0.2",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "var-quality",
      "name": "Treatment_Quality",
      "equation": "0.7",
      "position": {
        "x": 375,
        "y": 100
      }
    },
    {
      "id": "var-relapse",
      "name": "Relapse_Rate",
      "equation": "0.3",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-dropout",
      "name": "Dropout_Rate",
      "equation": "0.2",
      "position": {
        "x": 175,
        "y": 300
      }
    },
    {
      "id": "var-gap",
      "name": "Treatment_Gap",
      "equation": "Unmet_Need / (Unmet_Need + In_Treatment + 1)",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T12:55:38.761039+00:00",
  "updated_at": "2026-01-12T12:55:38.761039+00:00",
  "source": "https://doi.org/10.1016/S0140-6736(21)02143-7",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}