{
  "id": "air-quality-health-impacts-hea",
  "name": "Air Quality and Health Impacts Model",
  "description": "Models air pollution dynamics and associated health impacts. Based on Landrigan et al. (2018) Lancet Commission on pollution and health. Reference: WHO (2021). Air Quality Guidelines. Source: https://www.who.int/publications/i/item/9789240034228",
  "stocks": [
    {
      "id": "stock-pm25-concentration",
      "name": "PM25_Concentration",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-ozone-level",
      "name": "Ozone_Level",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-exposure-burden",
      "name": "Population_Exposure_Burden",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "stock-health-impacts",
      "name": "Health_Impacts",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-pm25-emissions",
      "name": "PM25_Emissions",
      "equation": "Industrial_Emissions + Vehicle_Emissions + Residential_Emissions",
      "from_stock": null,
      "to_stock": "stock-pm25-concentration",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-pm25-removal",
      "name": "PM25_Removal",
      "equation": "PM25_Concentration * (Natural_Removal + Rain_Washout)",
      "from_stock": "stock-pm25-concentration",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 220
      }
    },
    {
      "id": "flow-ozone-formation",
      "name": "Ozone_Formation",
      "equation": "NOx_Emissions * VOC_Ratio * Sunlight_Factor",
      "from_stock": null,
      "to_stock": "stock-ozone-level",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-ozone-destruction",
      "name": "Ozone_Destruction",
      "equation": "Ozone_Level * Ozone_Destruction_Rate",
      "from_stock": "stock-ozone-level",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 220
      }
    },
    {
      "id": "flow-exposure-accumulation",
      "name": "Exposure_Accumulation",
      "equation": "Population * (PM25_Concentration * PM25_Toxicity + Ozone_Level * Ozone_Toxicity)",
      "from_stock": null,
      "to_stock": "stock-exposure-burden",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-health-impact-rate",
      "name": "Health_Impact_Rate",
      "equation": "Population_Exposure_Burden * Health_Impact_Factor",
      "from_stock": null,
      "to_stock": "stock-health-impacts",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-industrial-emissions",
      "name": "Industrial_Emissions",
      "equation": "50 * (1 - 0.02 * TIME)",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-vehicle-emissions",
      "name": "Vehicle_Emissions",
      "equation": "30 * (1 - 0.03 * TIME)",
      "position": {
        "x": 260,
        "y": 80
      }
    },
    {
      "id": "var-residential-emissions",
      "name": "Residential_Emissions",
      "equation": "20 * (1 + 0.3 * SIN(TIME * 0.5))",
      "position": {
        "x": 420,
        "y": 80
      }
    },
    {
      "id": "var-natural-removal",
      "name": "Natural_Removal",
      "equation": "0.1",
      "position": {
        "x": 580,
        "y": 80
      }
    },
    {
      "id": "var-rain-washout",
      "name": "Rain_Washout",
      "equation": "0.05 * (1 + 0.5 * SIN(TIME * 0.2))",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-nox-emissions",
      "name": "NOx_Emissions",
      "equation": "40",
      "position": {
        "x": 240,
        "y": 400
      }
    },
    {
      "id": "var-voc-ratio",
      "name": "VOC_Ratio",
      "equation": "0.5",
      "position": {
        "x": 360,
        "y": 400
      }
    },
    {
      "id": "var-sunlight-factor",
      "name": "Sunlight_Factor",
      "equation": "0.5 + 0.5 * SIN((TIME - 6) * 3.14159 / 12)",
      "position": {
        "x": 480,
        "y": 400
      }
    },
    {
      "id": "var-ozone-destruction-rate",
      "name": "Ozone_Destruction_Rate",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 440
      }
    },
    {
      "id": "var-population",
      "name": "Population",
      "equation": "1000000",
      "position": {
        "x": 240,
        "y": 440
      }
    },
    {
      "id": "var-pm25-toxicity",
      "name": "PM25_Toxicity",
      "equation": "0.1",
      "position": {
        "x": 360,
        "y": 440
      }
    },
    {
      "id": "var-ozone-toxicity",
      "name": "Ozone_Toxicity",
      "equation": "0.05",
      "position": {
        "x": 480,
        "y": 440
      }
    },
    {
      "id": "var-health-impact-factor",
      "name": "Health_Impact_Factor",
      "equation": "0.0001",
      "position": {
        "x": 600,
        "y": 440
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.5
  },
  "created_at": "2026-01-12T01:19:34.568140+00:00",
  "updated_at": "2026-01-12T01:19:34.568153+00:00",
  "source": "https://doi.org/10.1016/S0140-6736(17)32345-0",
  "reference": "Landrigan PJ, et al. The Lancet Commission on pollution and health. Lancet. 2018;391(10119):462-512."
}