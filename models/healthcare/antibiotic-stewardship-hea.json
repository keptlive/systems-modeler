{
  "id": "antibiotic-stewardship-hea",
  "name": "Antibiotic Stewardship Program Dynamics",
  "description": "A model of hospital antibiotic stewardship programs, capturing the dynamics between prescribing practices, resistance development, infection outcomes, and program effectiveness. Reference: Andersson, D. I., & Hughes, D. (2014). Microbiological effects of sublethal antibiotic concentrations. Nature Reviews Microbiology. Source: https://doi.org/10.1038/nrmicro3270",
  "source": "https://doi.org/10.1016/S1473-3099(13)70318-9",
  "reference": "Barlam TF, et al. Implementing an Antibiotic Stewardship Program: Guidelines by the IDSA and SHEA. Clinical Infectious Diseases. 2016;62(10):e51-e77.",
  "stocks": [
    {
      "id": "stock-prescriptions",
      "name": "Antibiotic Prescriptions",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-resistance",
      "name": "Resistance Level",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-compliance",
      "name": "Provider Compliance",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "stock-outcomes",
      "name": "Patient Outcomes Quality",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-new-prescriptions",
      "name": "New Prescriptions",
      "equation": "Baseline_Prescribing * (1 - Provider_Compliance / 100 * Stewardship_Effect)",
      "from_stock": null,
      "to_stock": "stock-prescriptions",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-prescription-expiry",
      "name": "Prescription Expiry",
      "equation": "Antibiotic_Prescriptions / Average_Course_Length",
      "from_stock": "stock-prescriptions",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-resistance-growth",
      "name": "Resistance Growth",
      "equation": "Antibiotic_Prescriptions * Resistance_Selection_Pressure * (1 - Resistance_Level / 100)",
      "from_stock": null,
      "to_stock": "stock-resistance",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-resistance-decay",
      "name": "Resistance Decay",
      "equation": "Resistance_Level * Fitness_Cost / 100",
      "from_stock": "stock-resistance",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "flow-compliance-change",
      "name": "Compliance Change",
      "equation": "(Training_Effect + Feedback_Effect - Resistance_to_Change) * (100 - Provider_Compliance) / 100",
      "from_stock": null,
      "to_stock": "stock-compliance",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "flow-outcome-change",
      "name": "Outcome Change",
      "equation": "(Provider_Compliance * 0.3 - Resistance_Level * 0.5) / 10",
      "from_stock": null,
      "to_stock": "stock-outcomes",
      "position": {
        "x": 400,
        "y": 500
      }
    }
  ],
  "variables": [
    {
      "id": "var-baseline",
      "name": "Baseline Prescribing",
      "equation": "500",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-stewardship",
      "name": "Stewardship Effect",
      "equation": "0.3",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "var-course-length",
      "name": "Average Course Length",
      "equation": "7",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-selection",
      "name": "Resistance Selection Pressure",
      "equation": "0.001",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-fitness",
      "name": "Fitness Cost",
      "equation": "2",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-training",
      "name": "Training Effect",
      "equation": "2",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-feedback",
      "name": "Feedback Effect",
      "equation": "1",
      "position": {
        "x": 650,
        "y": 100
      }
    },
    {
      "id": "var-resistance-change",
      "name": "Resistance to Change",
      "equation": "1.5",
      "position": {
        "x": 750,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "created_at": "2026-01-12T08:00:00.000000+00:00",
  "updated_at": "2026-01-12T08:00:00.000000+00:00"
}