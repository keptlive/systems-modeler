{
  "id": "psychology-burnout-recovery-cycle-hea",
  "name": "Workplace Burnout and Recovery Dynamics",
  "description": "Models the progression from engagement to burnout and recovery pathways. Based on Maslach & Leiter (2016) and conservation of resources theory. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "category": "health",
  "stocks": [
    {
      "id": "stock-engaged",
      "name": "Engaged_Workers",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-exhausted",
      "name": "Exhausted_Workers",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-burnout",
      "name": "Burned_Out_Workers",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-resources",
      "name": "Personal_Resources",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-exhaust",
      "name": "Exhaustion",
      "equation": "Engaged_Workers * Exhaustion_Rate * Workload_Factor",
      "from_stock": "stock-engaged",
      "to_stock": "stock-exhausted",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-burnout",
      "name": "Burnout_Onset",
      "equation": "Exhausted_Workers * Burnout_Rate * (1 - Recovery_Support)",
      "from_stock": "stock-exhausted",
      "to_stock": "stock-burnout",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-recovery-ex",
      "name": "Recovery_from_Exhaustion",
      "equation": "Exhausted_Workers * Recovery_Rate * Recovery_Support",
      "from_stock": "stock-exhausted",
      "to_stock": "stock-engaged",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-recovery-bo",
      "name": "Recovery_from_Burnout",
      "equation": "Burned_Out_Workers * Long_Recovery_Rate",
      "from_stock": "stock-burnout",
      "to_stock": "stock-engaged",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-resource-drain",
      "name": "Resource_Depletion",
      "equation": "Personal_Resources * Depletion_Rate * Workload_Factor",
      "from_stock": "stock-resources",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-resource-restore",
      "name": "Resource_Restoration",
      "equation": "(100 - Personal_Resources) * Restoration_Rate",
      "from_stock": null,
      "to_stock": "stock-resources",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-exhaust-rate",
      "name": "Exhaustion_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-burnout-rate",
      "name": "Burnout_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-recovery",
      "name": "Recovery_Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-long-recovery",
      "name": "Long_Recovery_Rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-workload",
      "name": "Workload_Factor",
      "equation": "1.5",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-support",
      "name": "Recovery_Support",
      "equation": "0.3",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-depletion",
      "name": "Depletion_Rate",
      "equation": "0.01",
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "var-restore",
      "name": "Restoration_Rate",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 52,
    "dt": 1
  },
  "source": "https://doi.org/10.1146/annurev-orgpsych-041015-062544",
  "reference": "Maslach C & Leiter MP (2016) Burnout: A Brief History and How to Measure. Organizational Dynamics.",
  "connectors": [],
