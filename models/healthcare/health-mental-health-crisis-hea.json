{
  "id": "health-mental-health-crisis-hea",
  "name": "Mental Health Crisis System Dynamics",
  "description": "Models the flow through mental health treatment system including crisis, treatment access, and recovery. Based on WHO Mental Health Gap Action Programme. Reference: WHO (2022). Mental Health Action Plan. Source: https://www.who.int/publications/i/item/9789241506021",
  "category": "health",
  "stocks": [
    {
      "id": "stock-undiagnosed",
      "name": "Undiagnosed_Cases",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-waitlist",
      "name": "Treatment_Waitlist",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-treatment",
      "name": "In_Treatment",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-crisis",
      "name": "In_Crisis",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-onset",
      "name": "New_Onset",
      "equation": "Population * Incidence_Rate",
      "from_stock": null,
      "to_stock": "stock-undiagnosed",
      "position": {
        "x": 25,
        "y": 200
      }
    },
    {
      "id": "flow-diagnosis",
      "name": "Diagnosis",
      "equation": "Undiagnosed_Cases * Diagnosis_Rate",
      "from_stock": "stock-undiagnosed",
      "to_stock": "stock-waitlist",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-access",
      "name": "Treatment_Access",
      "equation": "MIN(Treatment_Waitlist / Wait_Time, Treatment_Capacity - In_Treatment)",
      "from_stock": "stock-waitlist",
      "to_stock": "stock-treatment",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-recovery",
      "name": "Recovery",
      "equation": "In_Treatment * Recovery_Rate",
      "from_stock": "stock-treatment",
      "to_stock": "stock-recovered",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-relapse",
      "name": "Relapse",
      "equation": "Recovered * Relapse_Rate",
      "from_stock": "stock-recovered",
      "to_stock": "stock-waitlist",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-crisis-onset",
      "name": "Crisis_Onset",
      "equation": "(Undiagnosed_Cases + Treatment_Waitlist) * Crisis_Rate",
      "from_stock": null,
      "to_stock": "stock-crisis",
      "position": {
        "x": 175,
        "y": 275
      }
    },
    {
      "id": "flow-crisis-resolution",
      "name": "Crisis_Resolution",
      "equation": "In_Crisis * Crisis_Resolution_Rate",
      "from_stock": "stock-crisis",
      "to_stock": "stock-treatment",
      "position": {
        "x": 325,
        "y": 275
      }
    }
  ],
  "variables": [
    {
      "id": "var-pop",
      "name": "Population",
      "equation": "10000",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-incidence",
      "name": "Incidence_Rate",
      "equation": "0.01",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-diagnosis",
      "name": "Diagnosis_Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-capacity",
      "name": "Treatment_Capacity",
      "equation": "150",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-wait",
      "name": "Wait_Time",
      "equation": "4",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-recovery-rate",
      "name": "Recovery_Rate",
      "equation": "0.08",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-relapse-rate",
      "name": "Relapse_Rate",
      "equation": "0.03",
      "position": {
        "x": 250,
        "y": 450
      }
    },
    {
      "id": "var-crisis-rate",
      "name": "Crisis_Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 450
      }
    },
    {
      "id": "var-crisis-resolve",
      "name": "Crisis_Resolution_Rate",
