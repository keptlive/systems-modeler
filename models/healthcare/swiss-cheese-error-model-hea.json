{
  "id": "swiss-cheese-error-model-hea",
  "name": "Swiss Cheese Model of Medical Errors",
  "description": "Layers of defenses with holes that can align to cause adverse events. Source: Reason (1990), Human Error. DOI: 10.1017/CBO9781139062367",
  "stocks": [
    {
      "id": "stock-latent",
      "name": "Latent_Errors",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-active",
      "name": "Active_Errors",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-adverse",
      "name": "Adverse_Events",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "stock-nearmiss",
      "name": "Near_Misses",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 275
      }
    }
  ],
  "flows": [
    {
      "id": "flow-latentgen",
      "name": "Latent_Generation",
      "equation": "System_Complexity * Error_Tendency",
      "from_stock": null,
      "to_stock": "stock-latent",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-latentfix",
      "name": "Latent_Fix",
      "equation": "Latent_Errors * Learning_Rate",
      "from_stock": "stock-latent",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-activegen",
      "name": "Active_Generation",
      "equation": "Workload_Pressure * Fatigue_Factor",
      "from_stock": null,
      "to_stock": "stock-active",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-intercept",
      "name": "Error_Intercept",
      "equation": "Active_Errors * Defense_Effectiveness",
      "from_stock": "stock-active",
      "to_stock": "stock-nearmiss",
      "position": {
        "x": 250,
        "y": 237
      }
    },
    {
      "id": "flow-penetrate",
      "name": "Error_Penetration",
      "equation": "Active_Errors * (1 - Defense_Effectiveness) * Latent_Errors / 100 * Alignment_Probability",
      "from_stock": "stock-active",
      "to_stock": "stock-adverse",
      "position": {
        "x": 250,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-complex",
      "name": "System_Complexity",
      "equation": "50",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-errtend",
      "name": "Error_Tendency",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-learn",
      "name": "Learning_Rate",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-workload",
      "name": "Workload_Pressure",
      "equation": "30",
      "position": {
        "x": 100,
        "y": 275
      }
    },
    {
      "id": "var-fatigue",
      "name": "Fatigue_Factor",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 275
      }
    },
    {
      "id": "var-defense",
      "name": "Defense_Effectiveness",
      "equation": "0.8",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-align",
      "name": "Alignment_Probability",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Latent_Errors",
      "to_element": "Error_Penetration"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
