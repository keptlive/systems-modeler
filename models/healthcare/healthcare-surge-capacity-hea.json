{
  "id": "healthcare-surge-capacity-hea",
  "name": "Healthcare Surge Capacity Model",
  "description": "Model of hospital and ICU surge capacity during public health emergencies. Based on CDC surge capacity planning frameworks showing how staffing, equipment, and space constraints interact to limit care capacity.",
  "stocks": [
    {"id": "stock-available-beds", "name": "Available Beds", "initial_value": 1000, "equation": "", "position": {"x": 200, "y": 150}},
    {"id": "stock-occupied-beds", "name": "Occupied Beds", "initial_value": 700, "equation": "", "position": {"x": 450, "y": 150}},
    {"id": "stock-available-icu", "name": "Available ICU", "initial_value": 100, "equation": "", "position": {"x": 200, "y": 300}},
    {"id": "stock-occupied-icu", "name": "Occupied ICU", "initial_value": 70, "equation": "", "position": {"x": 450, "y": 300}},
    {"id": "stock-available-staff", "name": "Available Staff", "initial_value": 500, "equation": "", "position": {"x": 200, "y": 450}}
  ],
  "flows": [
    {"id": "flow-admissions", "name": "Admissions", "equation": "MIN(Admission_Demand, Effective_Bed_Capacity - Occupied_Beds)", "from_stock": "stock-available-beds", "to_stock": "stock-occupied-beds", "position": {"x": 325, "y": 150}},
    {"id": "flow-discharges", "name": "Discharges", "equation": "Occupied_Beds / Length_of_Stay", "from_stock": "stock-occupied-beds", "to_stock": "stock-available-beds", "position": {"x": 325, "y": 200}},
    {"id": "flow-icu-admissions", "name": "ICU Admissions", "equation": "MIN(ICU_Demand, Effective_ICU_Capacity - Occupied_ICU)", "from_stock": "stock-available-icu", "to_stock": "stock-occupied-icu", "position": {"x": 325, "y": 300}},
    {"id": "flow-icu-discharges", "name": "ICU Discharges", "equation": "Occupied_ICU / ICU_LOS", "from_stock": "stock-occupied-icu", "to_stock": "stock-available-icu", "position": {"x": 325, "y": 350}},
    {"id": "flow-staff-burnout", "name": "Staff Burnout", "equation": "IF Occupancy_Rate > Crisis_Threshold THEN Available_Staff * Burnout_Rate ELSE 0", "from_stock": "stock-available-staff", "to_stock": null, "position": {"x": 100, "y": 450}}
  ],
  "variables": [
    {"id": "var-admission-demand", "name": "Admission Demand", "equation": "100", "position": {"x": 550, "y": 100}},
    {"id": "var-icu-demand", "name": "ICU Demand", "equation": "Admission_Demand * ICU_Fraction", "position": {"x": 550, "y": 180}},
    {"id": "var-icu-fraction", "name": "ICU Fraction", "equation": "0.15", "position": {"x": 700, "y": 180}},
    {"id": "var-length-of-stay", "name": "Length of Stay", "equation": "7", "position": {"x": 550, "y": 260}},
    {"id": "var-icu-los", "name": "ICU LOS", "equation": "14", "position": {"x": 700, "y": 260}},
    {"id": "var-staff-per-bed", "name": "Staff Per Bed", "equation": "0.3", "position": {"x": 550, "y": 340}},
    {"id": "var-staff-per-icu", "name": "Staff Per ICU", "equation": "2", "position": {"x": 700, "y": 340}},
    {"id": "var-staff-limited-beds", "name": "Staff Limited Beds", "equation": "Available_Staff / Staff_Per_Bed", "position": {"x": 550, "y": 420}},
    {"id": "var-staff-limited-icu", "name": "Staff Limited ICU", "equation": "Available_Staff / Staff_Per_ICU", "position": {"x": 700, "y": 420}},
    {"id": "var-effective-bed-capacity", "name": "Effective Bed Capacity", "equation": "MIN(Available_Beds + Occupied_Beds, Staff_Limited_Beds)", "position": {"x": 550, "y": 500}},
    {"id": "var-effective-icu-capacity", "name": "Effective ICU Capacity", "equation": "MIN(Available_ICU + Occupied_ICU, Staff_Limited_ICU)", "position": {"x": 700, "y": 500}},
    {"id": "var-occupancy-rate", "name": "Occupancy Rate", "equation": "Occupied_Beds / (Available_Beds + Occupied_Beds)", "position": {"x": 400, "y": 500}},
    {"id": "var-crisis-threshold", "name": "Crisis Threshold", "equation": "0.9", "position": {"x": 400, "y": 560}},
    {"id": "var-burnout-rate", "name": "Burnout Rate", "equation": "0.01", "position": {"x": 200, "y": 560}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 180, "dt": 1},
  "source": "https://www.cdc.gov/cpr/readiness/healthcare/surge-capacity.htm",
  "reference": "CDC. Healthcare System Preparedness and Response: Surge Capacity. Centers for Disease Control and Prevention. 2022."
}
