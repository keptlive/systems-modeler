{
  "id": "cardiac-action-potential-fitzhugh-hea",
  "name": "Cardiac Action Potential Model",
  "description": "Simplified cardiac action potential model based on FitzHugh-Nagumo formulation. Source: FitzHugh (1961), Biophysical J.",
  "stocks": [
    {
      "id": "s1",
      "name": "Membrane_Voltage",
      "initial_value": -1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Recovery_Variable",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Voltage_Dynamics",
      "equation": "Membrane_Voltage - Membrane_Voltage^3 / 3 - Recovery_Variable + I_stim",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Recovery_Dynamics",
      "equation": "epsilon * (Membrane_Voltage + a - b * Recovery_Variable)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "a",
      "equation": "0.7",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "b",
      "equation": "0.8",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "epsilon",
      "equation": "0.08",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "I_stim",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Action_Potential_Duration",
      "equation": "1 / epsilon",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Membrane_Voltage",
      "to_element": "Voltage_Dynamics"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.1
  },
  "created_at": "2026-01-15T14:39:40.986621+00:00",
  "updated_at": "2026-01-15T14:39:40.986625+00:00",
  "source": "https://doi.org/10.1016/S0006-3495(61)86902-6",
  "reference": "FitzHugh, R. (1961). Impulses and Physiological States in Theoretical Models of Nerve Membrane. Biophys J 1:445-466."
}