{
  "id": "healthcare-opioid-prescribing-cascade-hea",
  "name": "Opioid Prescribing Cascade Model",
  "description": "Models the pathway from acute pain to chronic opioid use and potential opioid use disorder. Based on CDC guidelines and Volkow & McLellan (2016) NEJM. DOI: 10.1056/NEJMra1507771",
  "category": "health",
  "stocks": [
    {
      "id": "stock-acute",
      "name": "Acute_Pain_Patients",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-prescribed",
      "name": "Short_Term_Opioid_Users",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-chronic",
      "name": "Chronic_Opioid_Users",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-oud",
      "name": "Opioid_Use_Disorder",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-treatment",
      "name": "In_Treatment",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-new-pain",
      "name": "New_Acute_Pain",
      "equation": "Incidence_Rate",
      "from_stock": null,
      "to_stock": "stock-acute",
      "position": {
        "x": 25,
        "y": 200
      }
    },
    {
      "id": "flow-prescribing",
      "name": "Opioid_Prescribing",
      "equation": "Acute_Pain_Patients * Prescribing_Rate",
      "from_stock": "stock-acute",
      "to_stock": "stock-prescribed",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-resolve",
      "name": "Pain_Resolution",
      "equation": "Acute_Pain_Patients * (1 - Prescribing_Rate) / Resolution_Time",
      "from_stock": "stock-acute",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "flow-transition",
      "name": "Transition_to_Chronic",
      "equation": "Short_Term_Opioid_Users * Chronicity_Rate",
      "from_stock": "stock-prescribed",
      "to_stock": "stock-chronic",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-taper",
      "name": "Successful_Taper",
      "equation": "Short_Term_Opioid_Users * (1 - Chronicity_Rate) / Taper_Time",
      "from_stock": "stock-prescribed",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-develop-oud",
      "name": "Develop_OUD",
      "equation": "Chronic_Opioid_Users * OUD_Rate",
      "from_stock": "stock-chronic",
      "to_stock": "stock-oud",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-enter-treatment",
      "name": "Enter_Treatment",
      "equation": "Opioid_Use_Disorder * Treatment_Entry_Rate",
      "from_stock": "stock-oud",
      "to_stock": "stock-treatment",
      "position": {
        "x": 550,
        "y": 275
      }
    },
    {
      "id": "flow-recovery",
      "name": "Recovery",
      "equation": "In_Treatment * Recovery_Rate",
      "from_stock": "stock-treatment",
      "to_stock": "stock-recovered",
      "position": {
        "x": 475,
        "y": 350
      }
    },
    {
      "id": "flow-relapse",
      "name": "Relapse",
      "equation": "Recovered * Relapse_Rate",
      "from_stock": "stock-recovered",
      "to_stock": "stock-oud",
      "position": {
        "x": 475,
        "y": 275
      }
    }
  ],
  "variables": [
    {
      "id": "var-incidence",
      "name": "Incidence_Rate",
      "equation": "500",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-prescribing",
      "name": "Prescribing_Rate",
      "equation": "0.4",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-resolution",
      "name": "Resolution_Time",
      "equation": "2",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-chronicity",
      "name": "Chronicity_Rate",
      "equation": "0.06",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-taper",
      "name": "Taper_Time",
      "equation": "4",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-oud-rate",
      "name": "OUD_Rate",
      "equation": "0.08",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-treatment-entry",
      "name": "Treatment_Entry_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 450
      }
    },
    {
      "id": "var-recovery",
      "name": "Recovery_Rate",
      "equation": "0.4",
      "position": {
        "x": 400,
        "y": 450
      }
    },
    {
      "id": "var-relapse",
      "name": "Relapse_Rate",
      "equation": "0.5",
      "position": {
        "x": 550,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 120,
    "dt": 1
  },
  "source": "https://doi.org/10.1056/NEJMra1507771",
  "reference": "Volkow ND & McLellan AT (2016) Opioid Abuse in Chronic Pain. NEJM.",
  "connectors": [],
