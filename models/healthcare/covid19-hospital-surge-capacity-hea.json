{
  "id": "covid19-hospital-surge-capacity-hea",
  "name": "COVID-19 Hospital Surge Capacity Model",
  "description": "Hospital resource allocation during pandemic surge showing ICU beds, ventilators, and staffing constraints. Based on Weissman et al. 2020. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Available ICU Beds",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Occupied ICU Beds",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Available Ventilators",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "s4",
      "name": "In Use Ventilators",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "s5",
      "name": "Available Staff",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 150,
        "y": 450
      }
    },
    {
      "id": "s6",
      "name": "Exhausted Staff",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 350,
        "y": 450
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "ICU Admissions",
      "equation": "MIN(Admission_Demand, Available_ICU_Beds * Admission_Rate)",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "ICU Discharges",
      "equation": "Occupied_ICU_Beds / Average_ICU_Stay",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "f3",
      "name": "Ventilator Assignment",
      "equation": "ICU_Admissions * Ventilator_Rate",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Ventilator Release",
      "equation": "In_Use_Ventilators / Average_Ventilator_Time",
      "from_stock": "s4",
      "to_stock": "s3",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "f5",
      "name": "Staff Burnout",
      "equation": "Available_Staff * Burnout_Rate * Surge_Stress_Factor",
      "from_stock": "s5",
      "to_stock": "s6",
      "position": {
        "x": 250,
        "y": 450
      }
    },
    {
      "id": "f6",
      "name": "Staff Recovery",
      "equation": "Exhausted_Staff / Recovery_Time",
      "from_stock": "s6",
      "to_stock": "s5",
      "position": {
        "x": 250,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Admission Demand",
      "equation": "50 + 100 * SIN(TIME / 30)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Admission Rate",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Average ICU Stay",
      "equation": "14",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Ventilator Rate",
      "equation": "0.6",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "v5",
      "name": "Average Ventilator Time",
      "equation": "12",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "v6",
      "name": "Burnout Rate",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "v7",
      "name": "Surge Stress Factor",
      "equation": "1 + (Occupied_ICU_Beds / 100)",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "v8",
      "name": "Recovery Time",
      "equation": "30",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "v9",
      "name": "Capacity Utilization",
      "equation": "Occupied_ICU_Beds / (Available_ICU_Beds + Occupied_ICU_Beds)",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "v10",
      "name": "Unmet Demand",
      "equation": "MAX(0, Admission_Demand - ICU_Admissions)",
      "position": {
        "x": 500,
        "y": 100
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Available ICU Beds",
      "to_element": "ICU Admissions"
    },
    {
      "id": "c2",
      "from_element": "Occupied ICU Beds",
      "to_element": "ICU Discharges"
    },
    {
      "id": "c3",
      "from_element": "Available Staff",
      "to_element": "Staff Burnout"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "created_at": "2026-01-15T14:14:19.552130",
  "updated_at": "2026-01-15T14:14:19.552139",
  "source": "https://doi.org/10.7326/M20-1260",
  "reference": "Weissman GE, et al. Locally Informed Simulation to Predict Hospital Capacity Needs During the COVID-19 Pandemic. Annals of Internal Medicine. 2020;173(1):21-28."
}