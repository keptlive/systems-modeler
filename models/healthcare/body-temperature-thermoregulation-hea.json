      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Metabolic_Heat_Production",
      "equation": "Basal_Metabolic_Rate + Shivering_Heat + Activity_Heat",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "f2",
      "name": "Heat_Loss",
      "equation": "Radiation_Loss + Convection_Loss + Evaporation_Loss",
