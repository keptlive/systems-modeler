      }
    },
    {
      "id": "v5",
      "name": "Shivering_Heat",
      "equation": "MAX(0, -50 * Error_Signal)",
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "v6",
      "name": "Ambient_Temperature",
      "equation": "25",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Vasodilation",
      "equation": "1 + MAX(0, Error_Signal)",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Radiation_Loss",
      "equation": "5 * (Skin_Temperature - Ambient_Temperature) * Vasodilation",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Convection_Loss",
      "equation": "3 * (Skin_Temperature - Ambient_Temperature)",
      "position": {
        "x": 500,
        "y": 400
      }
    },
    {
      "id": "v10",
      "name": "Sweat_Rate",
      "equation": "MAX(0, 10 * Error_Signal)",
      "position": {
        "x": 400,
        "y": 450
      }
    },
    {
      "id": "v11",
      "name": "Evaporation_Loss",
      "equation": "Sweat_Rate * 2.4",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "v12",
      "name": "Thermal_Capacitance",
      "equation": "27",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v13",
      "name": "Core_Response_Time",
      "equation": "5",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "v14",
      "name": "Skin_Target",
      "equation": "33 + 2 * Error_Signal * Vasodilation",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "v15",
      "name": "Skin_Response_Time",
      "equation": "2",
      "position": {
        "x": 600,
        "y": 250
      }
    }
