{
  "id": "mental-health-treatment-gap-hea",
  "name": "Mental Health Treatment Gap Model",
  "description": "Model of mental health service delivery showing unmet need, provider capacity, and stigma effects. Reference: Schuppan, D., & Afdhal, N. H. (2008). Liver cirrhosis. Lancet. Source: https://doi.org/10.1016/S0140-6736(08)60383-9",
  "stocks": [
    {
      "id": "s1",
      "name": "Untreated_Population",
      "initial_value": 40,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "In_Treatment",
      "initial_value": 15,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Provider_Capacity",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "New_Cases",
      "equation": "Incidence_Rate * Population",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Treatment_Entry",
      "equation": "MIN(Untreated_Population * Help_Seeking_Rate, Available_Capacity)",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Treatment_Exit",
      "equation": "In_Treatment * Recovery_Rate + In_Treatment * Dropout_Rate",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Capacity_Change",
      "equation": "Workforce_Growth - Attrition",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 150,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Incidence_Rate",
      "equation": "0.05",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Population",
      "equation": "100",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "v3",
      "name": "Help_Seeking_Rate",
      "equation": "0.3 * (1 - Stigma_Factor)",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Stigma_Factor",
      "equation": "0.4",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Available_Capacity",
      "equation": "Provider_Capacity - In_Treatment * 0.8",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "v6",
      "name": "Recovery_Rate",
      "equation": "0.15",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Dropout_Rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Workforce_Growth",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Attrition",
      "equation": "Provider_Capacity * 0.08",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Treatment_Gap",
      "equation": "Untreated_Population / (Untreated_Population + In_Treatment)",
      "position": {
        "x": 450,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:34:23.558391+00:00",
  "updated_at": "2026-01-12T11:34:23.558391+00:00",
  "source": "https://doi.org/10.1016/S2215-0366(17)30138-9",
  "reference": "Patel V, et al. The Lancet Commission on global mental health and sustainable development. The Lancet. 2018;392(10157):1553-1598."
}