{
  "id": "healthcare-emergency-dept-crowding-hea",
  "name": "Emergency Department Crowding Dynamics",
  "description": "Models ED patient flow, boarding, and crowding impacts on quality. Based on Asplin et al. (2003) conceptual model and subsequent research. DOI: 10.1016/S0196-0644(03)00657-1",
  "category": "health",
  "stocks": [
    {
      "id": "stock-waiting",
      "name": "Patients_Waiting",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-treatment",
      "name": "Patients_In_Treatment",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-boarding",
      "name": "Patients_Boarding",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-lwbs",
      "name": "Left_Without_Being_Seen",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-arrivals",
      "name": "ED_Arrivals",
      "equation": "Base_Arrival_Rate * (1 + Seasonal_Factor * SIN(2*3.14159*Time/365))",
      "from_stock": null,
      "to_stock": "stock-waiting",
      "position": {
        "x": 25,
        "y": 200
      }
    },
    {
      "id": "flow-triage",
      "name": "Triage_to_Treatment",
      "equation": "MIN(Patients_Waiting / Wait_Time, Available_Capacity)",
      "from_stock": "stock-waiting",
      "to_stock": "stock-treatment",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-admit",
      "name": "Admission_Boarding",
      "equation": "Patients_In_Treatment * Admission_Rate / Treatment_Time",
      "from_stock": "stock-treatment",
      "to_stock": "stock-boarding",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-discharge",
      "name": "ED_Discharge",
      "equation": "Patients_In_Treatment * (1 - Admission_Rate) / Treatment_Time",
      "from_stock": "stock-treatment",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "flow-transfer",
      "name": "Inpatient_Transfer",
      "equation": "Patients_Boarding / Boarding_Time",
      "from_stock": "stock-boarding",
      "to_stock": null,
      "position": {
        "x": 575,
        "y": 200
      }
    },
    {
      "id": "flow-lwbs",
      "name": "Leave_Without_Seen",
      "equation": "Patients_Waiting * LWBS_Rate * (1 + Crowding_Factor)",
      "from_stock": "stock-waiting",
      "to_stock": "stock-lwbs",
      "position": {
        "x": 100,
        "y": 275
      }
    }
  ],
  "variables": [
    {
      "id": "var-arrival",
      "name": "Base_Arrival_Rate",
      "equation": "5",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-seasonal",
      "name": "Seasonal_Factor",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-wait",
      "name": "Wait_Time",
      "equation": "1",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-treatment",
      "name": "Treatment_Time",
      "equation": "3",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-admission",
      "name": "Admission_Rate",
      "equation": "0.25",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-boarding",
      "name": "Boarding_Time",
      "equation": "8",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-capacity",
      "name": "Available_Capacity",
      "equation": "MAX(0, Total_Beds - Patients_In_Treatment - Patients_Boarding)",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-beds",
      "name": "Total_Beds",
      "equation": "40",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-lwbs-rate",
      "name": "LWBS_Rate",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-crowding",
      "name": "Crowding_Factor",
      "equation": "(Patients_Waiting + Patients_Boarding) / Total_Beds",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 168,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1016/S0196-0644(03)00657-1",
  "reference": "Asplin BR et al. (2003) A conceptual model of emergency department crowding. Ann Emerg Med.",
  "connectors": [],
  "created_at": "2026-01-12T06:10:19.332880+00:00",
  "updated_at": "2026-01-12T06:10:19.332880+00:00"
}