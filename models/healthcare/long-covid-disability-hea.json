{
  "id": "long-covid-disability-hea",
  "name": "Long COVID Disease Burden Dynamics",
  "description": "A model of Long COVID (post-acute sequelae of SARS-CoV-2), capturing progression from acute infection to persistent symptoms, recovery patterns, and disability burden. Based on emerging clinical evidence. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "source": "https://doi.org/10.1038/s41591-022-01909-w",
  "reference": "Davis HE, et al. Long COVID: major findings, mechanisms and recommendations. Nature Reviews Microbiology. 2023;21:133-146. See also Al-Aly Z, et al. Nature Medicine. 2021.",
  "stocks": [
    {
      "id": "stock-acute-covid",
      "name": "Acute COVID Cases",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-long-covid",
      "name": "Long COVID Cases",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-severe-lc",
      "name": "Severe Long COVID",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Fully Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "stock-disability",
      "name": "Disabled",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 500,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-new-cases",
      "name": "New Acute Cases",
      "equation": "Daily_Infections",
      "from_stock": null,
      "to_stock": "stock-acute-covid",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-acute-resolution",
      "name": "Acute Resolution",
      "equation": "Acute_COVID_Cases / Acute_Duration",
      "from_stock": "stock-acute-covid",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "flow-to-long-covid",
      "name": "Long COVID Onset",
      "equation": "(Acute_COVID_Cases / Acute_Duration) * Long_COVID_Rate",
      "from_stock": null,
      "to_stock": "stock-long-covid",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-lc-to-severe",
      "name": "Progression to Severe",
      "equation": "Long_COVID_Cases * Severe_Progression_Rate",
      "from_stock": "stock-long-covid",
      "to_stock": "stock-severe-lc",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-mild-recovery",
      "name": "Mild LC Recovery",
      "equation": "Long_COVID_Cases * Mild_Recovery_Rate",
      "from_stock": "stock-long-covid",
      "to_stock": "stock-recovered",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "flow-severe-recovery",
      "name": "Severe LC Recovery",
      "equation": "Severe_Long_COVID * Severe_Recovery_Rate",
      "from_stock": "stock-severe-lc",
      "to_stock": "stock-recovered",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "flow-to-disability",
      "name": "Disability Onset",
      "equation": "Severe_Long_COVID * Disability_Rate",
      "from_stock": "stock-severe-lc",
      "to_stock": "stock-disability",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-daily-infections",
      "name": "Daily Infections",
      "equation": "5000",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-acute-duration",
      "name": "Acute Duration",
      "equation": "14",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-lc-rate",
      "name": "Long COVID Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-severe-rate",
      "name": "Severe Progression Rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-mild-recovery",
      "name": "Mild Recovery Rate",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-severe-recovery",
      "name": "Severe Recovery Rate",
      "equation": "0.003",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-disability-rate",
      "name": "Disability Rate",
      "equation": "0.005",
      "position": {
        "x": 650,
        "y": 100
      }
    },
    {
      "id": "var-prevalence",
      "name": "Long COVID Prevalence",
      "equation": "Long_COVID_Cases + Severe_Long_COVID",
      "position": {
        "x": 400,
        "y": 450
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 730,
    "dt": 1
  },
