{
  "id": "opioid-crisis-dynamics-hea",
  "name": "Opioid Epidemic System Dynamics Model",
  "description": "Model of opioid addiction epidemic. Source: Homer et al. (2019), System Dynamics Review; CDC. Reference: WHO Disease Outbreak Information. Source: https://www.who.int/",
  "stocks": [
    {
      "id": "stock-naive",
      "name": "Opioid_Naive",
      "initial_value": 900,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-rx",
      "name": "Rx_Users",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-oud",
      "name": "OUD",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-rx",
      "name": "Prescriptions",
      "equation": "Opioid_Naive * Rx_Rate",
      "from_stock": "stock-naive",
      "to_stock": "stock-rx",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-oud",
      "name": "Develop_OUD",
      "equation": "Rx_Users * OUD_Rate",
      "from_stock": "stock-rx",
      "to_stock": "stock-oud",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-treat",
      "name": "Treatment",
      "equation": "OUD * Treatment_Rate",
      "from_stock": "stock-oud",
      "to_stock": "stock-naive",
      "position": {
        "x": 250,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-rx",
      "name": "Rx_Rate",
      "equation": "0.05",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "var-oud",
      "name": "OUD_Rate",
      "equation": "0.15",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "var-treat",
      "name": "Treatment_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T12:50:58.059747+00:00",
  "updated_at": "2026-01-12T12:50:58.059747+00:00",
  "source": "https://doi.org/10.1016/S0140-6736(20)30260-9",
  "reference": "Anderson RM, et al. How will country-based mitigation measures influence the course of the COVID-19 epidemic? Lancet. 2020;395(10228):931-934."
}