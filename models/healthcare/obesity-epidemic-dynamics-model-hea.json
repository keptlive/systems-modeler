        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-overweight-population",
      "name": "Overweight Population",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-obese-population",
      "name": "Obese Population",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-average-daily-caloric-intake",
      "name": "Average Daily Caloric Intake",
      "initial_value": 2200,
      "equation": "",
      "position": {
        "x": 750,
        "y": 200
      }
    },
    {
      "id": "stock-average-physical-activity",
      "name": "Average Physical Activity",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "stock-food-environment-score",
      "name": "Food Environment Score",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "stock-obesity-healthcare-capacity",
      "name": "Obesity Healthcare Capacity",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-normal-to-overweight-transition",
      "name": "Normal to Overweight Transition",
      "equation": "Normal_Weight * Weight_Gain_Rate_Normal",
      "from_stock": "stock-normal-weight-population",
      "to_stock": "stock-overweight-population",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-overweight-to-normal-transition",
      "name": "Overweight to Normal Transition",
      "equation": "Overweight * Weight_Loss_Rate_Overweight",
      "from_stock": "stock-overweight-population",
      "to_stock": "stock-normal-weight-population",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-overweight-to-obese-transition",
      "name": "Overweight to Obese Transition",
      "equation": "Overweight * Weight_Gain_Rate_Overweight",
      "from_stock": "stock-overweight-population",
      "to_stock": "stock-obese-population",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-obese-to-overweight-transition",
      "name": "Obese to Overweight Transition",
      "equation": "Obese * Weight_Loss_Rate_Obese",
      "from_stock": "stock-obese-population",
      "to_stock": "stock-overweight-population",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-births-into-normal-weight",
      "name": "Births into Normal Weight",
      "equation": "Total_Population * Birth_Rate * (1 - Childhood_Obesity_Rate)",
      "from_stock": null,
      "to_stock": "stock-normal-weight-population",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "flow-deaths-normal-weight",
      "name": "Deaths Normal Weight",
      "equation": "Normal_Weight * Death_Rate_Normal",
      "from_stock": "stock-normal-weight-population",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 350
      }
    },
    {
      "id": "flow-deaths-overweight",
      "name": "Deaths Overweight",
      "equation": "Overweight * Death_Rate_Overweight",
      "from_stock": "stock-overweight-population",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 500
      }
    },
    {
      "id": "flow-deaths-obese",
      "name": "Deaths Obese",
      "equation": "Obese * Death_Rate_Obese",
      "from_stock": "stock-obese-population",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 500
      }
    },
    {
      "id": "flow-caloric-intake-increase",
      "name": "Caloric Intake Increase",
      "equation": "(Target_Intake - Average_Caloric_Intake) / Intake_Adjustment_Time * IF Target_Intake > Average_Caloric_Intake THEN 1 ELSE 0",
      "from_stock": null,
      "to_stock": "stock-average-daily-caloric-intake",
      "position": {
        "x": 650,
        "y": 500
      }
    },
    {
      "id": "flow-caloric-intake-decrease",
      "name": "Caloric Intake Decrease",
      "equation": "(Average_Caloric_Intake - Target_Intake) / Intake_Adjustment_Time * IF Target_Intake < Average_Caloric_Intake THEN 1 ELSE 0",
      "from_stock": "stock-average-daily-caloric-intake",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 650
      }
    },
    {
      "id": "flow-physical-activity-increase",
      "name": "Physical Activity Increase",
      "equation": "(Target_Activity - Average_Physical_Activity) / Activity_Adjustment_Time * IF Target_Activity > Average_Physical_Activity THEN 1 ELSE 0",
      "from_stock": null,
      "to_stock": "stock-average-physical-activity",
      "position": {
        "x": 450,
        "y": 650
      }
    },
    {
      "id": "flow-physical-activity-decrease",
      "name": "Physical Activity Decrease",
      "equation": "(Average_Physical_Activity - Target_Activity) / Activity_Adjustment_Time * IF Target_Activity < Average_Physical_Activity THEN 1 ELSE 0",
      "from_stock": "stock-average-physical-activity",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 650
      }
    },
    {
      "id": "flow-food-environment-improvement",
      "name": "Food Environment Improvement",
      "equation": "Policy_Effect_on_Environment",
      "from_stock": null,
      "to_stock": "stock-food-environment-score",
      "position": {
        "x": 250,
        "y": 800
      }
    },
    {
      "id": "flow-food-environment-degradation",
      "name": "Food Environment Degradation",
      "equation": "Food_Environment_Score * Environment_Degradation_Rate",
      "from_stock": "stock-food-environment-score",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 800
      }
    },
    {
      "id": "flow-healthcare-capacity-expansion",
      "name": "Healthcare Capacity Expansion",
      "equation": "MAX(0, Obesity_Rate - 0.3) * 100 * Capacity_Investment_Rate",
      "from_stock": null,
      "to_stock": "stock-obesity-healthcare-capacity",
      "position": {
        "x": 650,
        "y": 800
      }
    },
    {
      "id": "flow-healthcare-capacity-reduction",
      "name": "Healthcare Capacity Reduction",
      "equation": "Healthcare_Capacity * 0.02",
      "from_stock": "stock-obesity-healthcare-capacity",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 950
      }
    }
  ],
  "variables": [
    {
      "id": "var-total-adult-population",
      "name": "Total Adult Population",
      "equation": "Normal_Weight + Overweight + Obese",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-initial-population",
      "name": "Initial Population",
      "equation": "200000000",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-obesity-prevalence-rate",
      "name": "Obesity Prevalence Rate",
      "equation": "Obese / Total_Population",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-overweight-prevalence-rate",
      "name": "Overweight Prevalence Rate",
      "equation": "(Overweight + Obese) / Total_Population",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-average-energy-balance",
      "name": "Average Energy Balance",
      "equation": "Average_Caloric_Intake - Energy_Expenditure",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-total-energy-expenditure",
      "name": "Total Energy Expenditure",
      "equation": "Basal_Metabolic_Rate + Average_Physical_Activity + Thermic_Effect",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-basal-metabolic-rate",
      "name": "Basal Metabolic Rate",
      "equation": "1800",
      "position": {
        "x": 250,
        "y": 160
      }
    },
    {
      "id": "var-thermic-effect-of-food",
      "name": "Thermic Effect of Food",
      "equation": "Average_Caloric_Intake * 0.10",
      "position": {
        "x": 400,
        "y": 160
      }
    },
    {
      "id": "var-weight-gain-rate-normal",
      "name": "Weight Gain Rate Normal",
      "equation": "Base_Transition_Rate * (1 + Energy_Balance_Effect) * Social_Contagion_Effect * (1 - Prevention_Effect)",
      "position": {
        "x": 550,
        "y": 160
      }
    },
    {
      "id": "var-weight-gain-rate-overweight",
      "name": "Weight Gain Rate Overweight",
      "equation": "Base_Transition_Rate * 1.5 * (1 + Energy_Balance_Effect) * Social_Contagion_Effect * (1 - Prevention_Effect)",
      "position": {
        "x": 700,
        "y": 160
      }
    },
    {
      "id": "var-weight-loss-rate-overweight",
      "name": "Weight Loss Rate Overweight",
      "equation": "Base_Weight_Loss_Rate * Treatment_Effect * Motivation_Factor",
      "position": {
        "x": 100,
        "y": 240
      }
    },
    {
      "id": "var-weight-loss-rate-obese",
      "name": "Weight Loss Rate Obese",
      "equation": "Base_Weight_Loss_Rate * 0.5 * Treatment_Effect * Motivation_Factor",
      "position": {
        "x": 250,
        "y": 240
      }
    },
    {
      "id": "var-base-transition-rate",
      "name": "Base Transition Rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 240
      }
    },
    {
      "id": "var-base-weight-loss-rate",
      "name": "Base Weight Loss Rate",
      "equation": "0.05",
      "position": {
        "x": 550,
        "y": 240
      }
    },
    {
      "id": "var-energy-balance-effect",
      "name": "Energy Balance Effect",
      "equation": "MAX(-0.5, MIN(2, Energy_Balance / 200))",
      "position": {
        "x": 700,
        "y": 240
      }
    },
    {
      "id": "var-social-contagion-effect",
      "name": "Social Contagion Effect",
      "equation": "1 + Social_Contagion_Strength * Obesity_Rate",
      "position": {
        "x": 100,
        "y": 320
      }
    },
    {
      "id": "var-social-contagion-strength",
      "name": "Social Contagion Strength",
      "equation": "0.5",
      "position": {
        "x": 250,
        "y": 320
      }
    },
    {
      "id": "var-target-caloric-intake",
      "name": "Target Caloric Intake",
      "equation": "2000 + Food_Availability_Effect - Food_Environment_Score * 5 + Marketing_Pressure",
      "position": {
        "x": 400,
        "y": 320
      }
    },
    {
      "id": "var-food-availability-effect",
      "name": "Food Availability Effect",
      "equation": "300 * (1 + 0.01 * (Time - 1980))",
      "position": {
        "x": 550,
        "y": 320
      }
    },
    {
      "id": "var-marketing-pressure",
      "name": "Marketing Pressure",
      "equation": "100 * (1 - Policy_Marketing_Restrictions)",
      "position": {
        "x": 700,
        "y": 320
      }
    },
    {
      "id": "var-target-physical-activity",
      "name": "Target Physical Activity",
      "equation": "250 - Sedentary_Trend + Built_Environment_Effect + Policy_Activity_Promotion",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-sedentary-trend",
      "name": "Sedentary Trend",
      "equation": "2 * (Time - 1980)",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "var-built-environment-effect",
      "name": "Built Environment Effect",
      "equation": "20",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "var-intake-adjustment-time",
      "name": "Intake Adjustment Time",
      "equation": "5",
      "position": {
        "x": 550,
        "y": 400
      }
    },
    {
      "id": "var-activity-adjustment-time",
      "name": "Activity Adjustment Time",
      "equation": "3",
      "position": {
        "x": 700,
        "y": 400
      }
    },
    {
      "id": "var-prevention-effect",
      "name": "Prevention Effect",
      "equation": "Policy_Prevention_Investment * 0.1 * Healthcare_Capacity / 100",
      "position": {
        "x": 100,
        "y": 480
      }
    },
    {
      "id": "var-treatment-effect",
      "name": "Treatment Effect",
      "equation": "1 + Policy_Treatment_Investment * 0.5 * Healthcare_Capacity / 100",
      "position": {
        "x": 250,
        "y": 480
      }
    },
    {
      "id": "var-motivation-factor",
      "name": "Motivation Factor",
      "equation": "1 + 0.3 * Awareness_Level / 100",
      "position": {
        "x": 400,
        "y": 480
      }
    },
    {
      "id": "var-public-awareness-level",
      "name": "Public Awareness Level",
      "equation": "50 + 30 * Obesity_Rate",
      "position": {
        "x": 550,
        "y": 480
      }
    },
    {
      "id": "var-prevention-policy-investment",
      "name": "Prevention Policy Investment",
      "equation": "0.2",
      "position": {
        "x": 700,
        "y": 480
      }
    },
    {
      "id": "var-treatment-policy-investment",
      "name": "Treatment Policy Investment",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 560
      }
    },
    {
      "id": "var-marketing-restriction-policy",
      "name": "Marketing Restriction Policy",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 560
      }
    },
    {
      "id": "var-activity-promotion-policy",
      "name": "Activity Promotion Policy",
      "equation": "20",
      "position": {
        "x": 400,
        "y": 560
      }
    },
    {
      "id": "var-policy-effect-on-environment",
      "name": "Policy Effect on Environment",
      "equation": "2 * (Policy_Prevention_Investment + Policy_Marketing_Restrictions)",
      "position": {
        "x": 550,
        "y": 560
      }
    },
    {
      "id": "var-environment-degradation-rate",
      "name": "Environment Degradation Rate",
      "equation": "0.02",
      "position": {
        "x": 700,
        "y": 560
      }
    },
    {
      "id": "var-capacity-investment-rate",
      "name": "Capacity Investment Rate",
      "equation": "5",
      "position": {
        "x": 100,
        "y": 640
      }
    },
    {
      "id": "var-birth-rate",
      "name": "Birth Rate",
      "equation": "0.015",
      "position": {
        "x": 250,
        "y": 640
      }
    },
    {
      "id": "var-death-rate-normal-weight",
      "name": "Death Rate Normal Weight",
      "equation": "0.012",
      "position": {
        "x": 400,
        "y": 640
      }
    },
    {
      "id": "var-death-rate-overweight",
      "name": "Death Rate Overweight",
      "equation": "0.014",
      "position": {
        "x": 550,
        "y": 640
      }
    },
    {
      "id": "var-death-rate-obese",
      "name": "Death Rate Obese",
      "equation": "0.018",
      "position": {
        "x": 700,
        "y": 640
      }
    },
    {
      "id": "var-childhood-obesity-rate",
      "name": "Childhood Obesity Rate",
      "equation": "Obesity_Rate * 0.6",
      "position": {
        "x": 100,
        "y": 720
      }
    },
    {
      "id": "var-annual-economic-cost",
      "name": "Annual Economic Cost",
      "equation": "Obese * 3000 + Overweight * 500",
      "position": {
        "x": 250,
        "y": 720
      }
    },
    {
      "id": "var-quality-adjusted-life-years-lost",
      "name": "Quality-Adjusted Life Years Lost",
      "equation": "Obese * 0.05 + Overweight * 0.01",
      "position": {
        "x": 400,
        "y": 720
      }
    }
  ],
