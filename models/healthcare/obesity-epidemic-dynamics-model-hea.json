{
  "id": "obesity-epidemic-dynamics-model-hea",
  "name": "Obesity Epidemic Dynamics Model",
  "description": "A system dynamics model of obesity prevalence in a population, capturing the interplay of energy balance, food environment, physical activity, social influences, and intervention policies. Models the spread of obesity as both a physiological and social phenomenon. Reference: WHO Disease Outbreak Information. Source: https://www.who.int/",
  "stocks": [
