{
  "id": "obesity-epidemic-dynamics-hea",
  "name": "Obesity Epidemic Dynamics Model",
  "description": "Models obesity prevalence with social contagion and environmental factors. Based on Christakis & Fowler (2007). DOI: 10.1056/NEJMsa066082",
  "stocks": [
    {
      "id": "stock-normalwt",
      "name": "Normal_Weight",
      "initial_value": 700,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-overweight",
      "name": "Overweight",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "stock-obese",
      "name": "Obese",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 100
      }
    }
  ],
  "flows": [
    {
      "id": "flow-gainwt",
      "name": "Weight_Gain",
      "equation": "Normal_Weight * (Environmental_Risk + Social_Influence_Normal)",
      "from_stock": "stock-normalwt",
      "to_stock": "stock-overweight",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-losewt",
      "name": "Weight_Loss_Overweight",
      "equation": "Overweight * Weight_Loss_Rate",
      "from_stock": "stock-overweight",
      "to_stock": "stock-normalwt",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "flow-gainmore",
      "name": "Become_Obese",
      "equation": "Overweight * (Environmental_Risk + Social_Influence_Overweight) * Progression_Rate",
      "from_stock": "stock-overweight",
      "to_stock": "stock-obese",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "flow-loseobese",
      "name": "Weight_Loss_Obese",
      "equation": "Obese * Weight_Loss_Rate * Intervention_Effect",
      "from_stock": "stock-obese",
      "to_stock": "stock-overweight",
      "position": {
        "x": 450,
        "y": 50
      }
    }
  ],
  "variables": [
    {
      "id": "var-envrisk",
      "name": "Environmental_Risk",
      "equation": "Food_Environment * Physical_Activity_Deficit",
      "position": {
        "x": 250,
        "y": 175
      }
    },
    {
      "id": "var-foodenv",
      "name": "Food_Environment",
      "equation": "0.05 + 0.01 * TIME / 50",
      "position": {
        "x": 150,
        "y": 175
      }
    },
    {
      "id": "var-physactdef",
      "name": "Physical_Activity_Deficit",
      "equation": "0.8",
      "position": {
        "x": 350,
        "y": 175
      }
    },
    {
      "id": "var-socinfnorm",
      "name": "Social_Influence_Normal",
      "equation": "(Overweight + Obese) / 1000 * Social_Transmission",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "var-socinfover",
      "name": "Social_Influence_Overweight",
      "equation": "Obese / 1000 * Social_Transmission",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "var-soctrans",
      "name": "Social_Transmission",
      "equation": "0.3",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "var-wtlossrate",
      "name": "Weight_Loss_Rate",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-prograte",
      "name": "Progression_Rate",
      "equation": "0.5",
      "position": {
        "x": 450,
        "y": 175
      }
    },
    {
      "id": "var-interv",
      "name": "Intervention_Effect",
      "equation": "1.5",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "var-obsprev",
      "name": "Obesity_Prevalence",
      "equation": "Obese / (Normal_Weight + Overweight + Obese)",
      "position": {
        "x": 500,
        "y": 175
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Obese",
      "to_element": "Social_Influence_Overweight"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T02:55:29.074117+00:00",
  "updated_at": "2026-01-12T02:55:29.074124+00:00",
  "source": "https://doi.org/10.1056/NEJMsa066082",
  "reference": "Christakis NA, Fowler JH (2007). The Spread of Obesity in a Large Social Network. NEJM."
}