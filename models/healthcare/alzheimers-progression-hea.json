      "id": "stock-amyloid",
      "name": "Amyloid_Burden",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-tau",
      "name": "Tau_Pathology",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-neuron",
      "name": "Neuronal_Health",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-cognition",
      "name": "Cognitive_Function",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-amyloid-acc",
      "name": "Amyloid_Accumulation",
      "equation": "Amyloid_Production * (1 - Amyloid_Clearance)",
      "from_stock": null,
      "to_stock": "stock-amyloid",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-amyloid-clear",
      "name": "Amyloid_Removal",
      "equation": "Amyloid_Burden * Clearance_Rate",
      "from_stock": "stock-amyloid",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-tau-spread",
      "name": "Tau_Spread",
      "equation": "Tau_Pathology * Tau_Propagation * (Amyloid_Burden/100)",
      "from_stock": null,
      "to_stock": "stock-tau",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-neuron-loss",
      "name": "Neuronal_Loss",
      "equation": "Neuronal_Health * (Tau_Pathology * Tau_Toxicity + Amyloid_Burden * Amyloid_Toxicity) / 10000",
      "from_stock": "stock-neuron",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "flow-cog-decline",
      "name": "Cognitive_Decline",
      "equation": "(100 - Neuronal_Health) * Cog_Sensitivity + Tau_Pathology * Direct_Effect",
      "from_stock": "stock-cognition",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 280
      }
    }
  ],
  "variables": [
