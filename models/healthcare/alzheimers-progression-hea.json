{
  "id": "alzheimers-progression-hea",
  "name": "Alzheimer's Disease Progression Model",
  "description": "Models amyloid plaque accumulation, tau spread, and cognitive decline. Based on Jack et al. (2010) Hypothetical Model of AD, Lancet Neurology. Reference: Jack, C. R., et al. (2018). NIA-AA Research Framework. Alzheimer's & Dementia. Source: https://doi.org/10.1016/j.jalz.2018.02.018",
  "category": "health",
  "stocks": [
