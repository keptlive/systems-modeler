{
  "id": "chronic-disease-aging-hea",
  "name": "Chronic Disease with Aging",
  "description": "Chronic disease prevalence model accounting for aging population demographics. Models disease incidence and progression across age cohorts. Source: Based on WHO chronic disease projections methodology. Reference: Based on project dynamics models (Lyneis & Ford, 2007). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-young-healthy",
      "name": "Young_Healthy",
      "initial_value": 500000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "stock-young-diseased",
      "name": "Young_Diseased",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "stock-middle-healthy",
      "name": "Middle_Healthy",
      "initial_value": 300000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "stock-middle-diseased",
      "name": "Middle_Diseased",
      "initial_value": 50000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "stock-elderly-healthy",
      "name": "Elderly_Healthy",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "stock-elderly-diseased",
      "name": "Elderly_Diseased",
      "initial_value": 80000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-young-incidence",
      "name": "Young_Incidence",
      "equation": "Young_Healthy * Young_Incidence_Rate",
      "from_stock": "stock-young-healthy",
      "to_stock": "stock-young-diseased",
      "position": {
        "x": 100,
        "y": 225
      }
    },
    {
      "id": "flow-middle-incidence",
      "name": "Middle_Incidence",
      "equation": "Middle_Healthy * Middle_Incidence_Rate",
      "from_stock": "stock-middle-healthy",
      "to_stock": "stock-middle-diseased",
      "position": {
        "x": 300,
        "y": 225
      }
    },
    {
      "id": "flow-elderly-incidence",
      "name": "Elderly_Incidence",
      "equation": "Elderly_Healthy * Elderly_Incidence_Rate",
      "from_stock": "stock-elderly-healthy",
      "to_stock": "stock-elderly-diseased",
      "position": {
        "x": 500,
        "y": 225
      }
    },
    {
      "id": "flow-aging-healthy1",
      "name": "Aging_Healthy_YM",
      "equation": "Young_Healthy / Young_Age_Duration",
      "from_stock": "stock-young-healthy",
      "to_stock": "stock-middle-healthy",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-aging-healthy2",
      "name": "Aging_Healthy_ME",
      "equation": "Middle_Healthy / Middle_Age_Duration",
      "from_stock": "stock-middle-healthy",
      "to_stock": "stock-elderly-healthy",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-aging-diseased1",
      "name": "Aging_Diseased_YM",
      "equation": "Young_Diseased / Young_Age_Duration",
      "from_stock": "stock-young-diseased",
      "to_stock": "stock-middle-diseased",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-aging-diseased2",
      "name": "Aging_Diseased_ME",
      "equation": "Middle_Diseased / Middle_Age_Duration",
      "from_stock": "stock-middle-diseased",
      "to_stock": "stock-elderly-diseased",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-young-incidence-rate",
      "name": "Young_Incidence_Rate",
      "equation": "0.002",
      "position": {
        "x": 50,
        "y": 80
      }
    },
    {
      "id": "var-middle-incidence-rate",
      "name": "Middle_Incidence_Rate",
      "equation": "0.01",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-elderly-incidence-rate",
      "name": "Elderly_Incidence_Rate",
      "equation": "0.03",
      "position": {
        "x": 450,
        "y": 80
      }
    },
    {
      "id": "var-young-duration",
      "name": "Young_Age_Duration",
      "equation": "20",
      "position": {
        "x": 150,
        "y": 380
      }
    },
    {
      "id": "var-middle-duration",
      "name": "Middle_Age_Duration",
      "equation": "25",
      "position": {
        "x": 350,
        "y": 380
      }
    },
    {
      "id": "var-total-diseased",
      "name": "Total_Diseased",
      "equation": "Young_Diseased + Middle_Diseased + Elderly_Diseased",
      "position": {
        "x": 550,
        "y": 380
      }
    },
    {
      "id": "var-prevalence",
      "name": "Disease_Prevalence",
      "equation": "Total_Diseased / (Young_Healthy + Young_Diseased + Middle_Healthy + Middle_Diseased + Elderly_Healthy + Elderly_Diseased)",
      "position": {
        "x": 300,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Young_Healthy",
      "to_element": "Young_Incidence"
    },
    {
      "id": "conn-2",
      "from_element": "Middle_Healthy",
      "to_element": "Middle_Incidence"
    },
    {
      "id": "conn-3",
      "from_element": "Elderly_Healthy",
      "to_element": "Elderly_Incidence"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-11T20:47:58.495664Z",
  "updated_at": "2026-01-11T20:47:58.495664Z",
  "source": "https://doi.org/10.1016/j.socscimed.2013.03.004",
  "reference": "Healthcare System Dynamics Models"
}