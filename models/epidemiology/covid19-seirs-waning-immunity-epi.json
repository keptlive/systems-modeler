{
  "id": "covid19-seirs-waning-immunity-epi",
  "name": "COVID-19 SEIRS with Waning Immunity",
  "description": "COVID-19 model incorporating waning natural immunity and reinfection dynamics. Explores the endemic transition of COVID-19. Source: Lavine et al. (2021), Science. DOI: 10.1126/science.abe6522",
  "stocks": [
    {
      "id": "stock-s",
      "name": "Susceptible",
      "initial_value": 999000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-e",
      "name": "Exposed",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-i",
      "name": "Infectious",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-r",
      "name": "Recovered",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-w",
      "name": "Waned_Immunity",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-exp",
      "name": "Exposure",
      "equation": "Beta * Susceptible * Infectious / Total_Pop",
      "from_stock": "stock-s",
      "to_stock": "stock-e",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-inf",
      "name": "Onset",
      "equation": "Exposed / Latent_Period",
      "from_stock": "stock-e",
      "to_stock": "stock-i",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-rec",
      "name": "Recovery",
      "equation": "Infectious / Infectious_Period",
      "from_stock": "stock-i",
      "to_stock": "stock-r",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-wane",
      "name": "Waning",
      "equation": "Recovered / Immunity_Duration",
      "from_stock": "stock-r",
      "to_stock": "stock-w",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-reinf",
      "name": "Reinfection",
      "equation": "Beta * Waned_Immunity * Infectious * Susceptibility_Reinfection / Total_Pop",
      "from_stock": "stock-w",
      "to_stock": "stock-e",
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.4",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-latent",
      "name": "Latent_Period",
      "equation": "5",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-infper",
      "name": "Infectious_Period",
      "equation": "7",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-immdur",
      "name": "Immunity_Duration",
      "equation": "365",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-suscr",
      "name": "Susceptibility_Reinfection",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-total",
      "name": "Total_Pop",
      "equation": "Susceptible + Exposed + Infectious + Recovered + Waned_Immunity",
      "position": {
        "x": 300,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Susceptible",
      "to_element": "Exposure"
    },
    {
      "id": "conn-2",
      "from_element": "Infectious",
      "to_element": "Exposure"
    },
    {
      "id": "conn-3",
      "from_element": "Waned_Immunity",
      "to_element": "Reinfection"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 1095,
    "dt": 1
  },
  "created_at": "2026-01-11T22:11:19.082772Z",
  "updated_at": "2026-01-11T22:11:19.082781Z",
  "source": "https://doi.org/10.1126/science.abe6522",
  "reference": "Lavine, J.S. et al. (2021). Immunological characteristics govern the transition of COVID-19 to endemicity."
}