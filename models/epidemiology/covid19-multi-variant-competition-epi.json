{
  "id": "covid19-multi-variant-competition-epi",
  "name": "COVID-19 Multi-Variant Competition Model",
  "description": "SEIR model with multiple competing SARS-CoV-2 variants. Models variant fitness, immune escape, and competition dynamics. Based on Obermeyer et al. (2022) analysis of variant competition. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-exposed-original",
      "name": "Exposed_Original",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "stock-exposed-variant",
      "name": "Exposed_Variant",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "stock-infected-original",
      "name": "Infected_Original",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-infected-variant",
      "name": "Infected_Variant",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-exposure-original",
      "name": "Exposure_Original",
      "equation": "Beta * Susceptible * Infected_Original / Population",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-exposed-original",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "flow-exposure-variant",
      "name": "Exposure_Variant",
      "equation": "Beta * Variant_Fitness * Susceptible * Infected_Variant / Population",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-exposed-variant",
      "position": {
        "x": 175,
        "y": 250
      }
    },
    {
      "id": "flow-infection-original",
      "name": "Infection_Original",
      "equation": "Exposed_Original / Latent_Period",
      "from_stock": "stock-exposed-original",
      "to_stock": "stock-infected-original",
      "position": {
        "x": 325,
        "y": 150
      }
    },
    {
      "id": "flow-infection-variant",
      "name": "Infection_Variant",
      "equation": "Exposed_Variant / Latent_Period",
      "from_stock": "stock-exposed-variant",
      "to_stock": "stock-infected-variant",
      "position": {
        "x": 325,
        "y": 250
      }
    },
    {
      "id": "flow-recovery-original",
      "name": "Recovery_Original",
      "equation": "Infected_Original / Infectious_Period",
      "from_stock": "stock-infected-original",
      "to_stock": "stock-recovered",
      "position": {
        "x": 475,
        "y": 150
      }
    },
    {
      "id": "flow-recovery-variant",
      "name": "Recovery_Variant",
      "equation": "Infected_Variant / Infectious_Period",
      "from_stock": "stock-infected-variant",
      "to_stock": "stock-recovered",
      "position": {
        "x": 475,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-population",
      "name": "Population",
      "equation": "10000000",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-variant-fitness",
      "name": "Variant_Fitness",
      "equation": "1.5",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-latent-period",
      "name": "Latent_Period",
      "equation": "3",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-infectious-period",
      "name": "Infectious_Period",
      "equation": "5",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-initial-infected",
      "name": "Initial_Infected",
      "equation": "100",
      "position": {
        "x": 600,
        "y": 80
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.25
  },
