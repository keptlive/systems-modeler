{
  "id": "covid19-seir-hospitalization-epi",
  "name": "COVID-19 SEIR with Hospitalization",
  "description": "An extended SEIR model for COVID-19 that includes hospitalization dynamics. Based on models developed during the 2020-2022 pandemic to assess healthcare capacity needs. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "source": "https://doi.org/10.1016/j.chaos.2020.109889",
  "reference": "Giordano G, et al. Modelling the COVID-19 epidemic and implementation of population-wide interventions in Italy. Nature Medicine. 2020;26:855-860.",
  "stocks": [
    {
      "id": "stock-s",
      "name": "Susceptible",
      "initial_value": 999000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-e",
      "name": "Exposed",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-i",
      "name": "Infectious",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-h",
      "name": "Hospitalized",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-r",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "stock-d",
      "name": "Deaths",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 700,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-exposure",
      "name": "Exposure",
      "equation": "beta * Susceptible * Infectious / Total_Population",
      "from_stock": "stock-s",
      "to_stock": "stock-e",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-infection",
      "name": "Infection",
      "equation": "Exposed / Incubation_Period",
      "from_stock": "stock-e",
      "to_stock": "stock-i",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-hospitalization",
      "name": "Hospitalization",
      "equation": "Infectious * Hospitalization_Rate / Infectious_Period",
      "from_stock": "stock-i",
      "to_stock": "stock-h",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-home-recovery",
      "name": "Home Recovery",
      "equation": "Infectious * (1 - Hospitalization_Rate) / Infectious_Period",
      "from_stock": "stock-i",
      "to_stock": "stock-r",
      "position": {
        "x": 475,
        "y": 300
      }
    },
    {
      "id": "flow-hospital-recovery",
      "name": "Hospital Recovery",
      "equation": "Hospitalized * (1 - Hospital_Death_Rate) / Hospital_Stay",
      "from_stock": "stock-h",
      "to_stock": "stock-r",
      "position": {
        "x": 625,
        "y": 200
      }
    },
    {
      "id": "flow-death",
      "name": "Death",
      "equation": "Hospitalized * Hospital_Death_Rate / Hospital_Stay",
      "from_stock": "stock-h",
      "to_stock": "stock-d",
      "position": {
        "x": 625,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "beta",
      "equation": "0.5",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "var-incubation",
      "name": "Incubation Period",
      "equation": "5.2",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "var-infectious",
      "name": "Infectious Period",
      "equation": "10",
      "position": {
        "x": 475,
        "y": 100
      }
    },
    {
      "id": "var-hosp-rate",
      "name": "Hospitalization Rate",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-hospital-stay",
      "name": "Hospital Stay",
      "equation": "12",
      "position": {
        "x": 625,
        "y": 100
      }
    },
    {
      "id": "var-death-rate",
      "name": "Hospital Death Rate",
      "equation": "0.2",
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "id": "var-total-pop",
      "name": "Total Population",
      "equation": "1000000",
      "position": {
        "x": 100,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.25
  },
