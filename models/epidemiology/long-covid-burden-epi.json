{
  "id": "long-covid-burden-epi",
  "name": "Long COVID Disease Burden Model",
  "description": "Model of post-acute COVID-19 syndrome (Long COVID) showing progression from acute infection to various long-term symptoms and recovery. Based on Al-Aly et al. (2021). Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Recovered from Acute COVID",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Long COVID Patients",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Fully Recovered",
      "initial_value": 500000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Chronic Disability",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "New COVID Cases",
      "equation": "COVID_Incidence * Population * Survival_Rate",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Long COVID Onset",
      "equation": "Recovered_from_Acute_COVID * Long_COVID_Rate",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Full Recovery from Acute",
      "equation": "Recovered_from_Acute_COVID * (1 - Long_COVID_Rate) / Acute_Recovery_Time",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "f4",
      "name": "Long COVID Recovery",
      "equation": "Long_COVID_Patients * Recovery_Rate",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Chronic Progression",
      "equation": "Long_COVID_Patients * Chronic_Rate",
      "from_stock": "s2",
      "to_stock": "s4",
      "position": {
        "x": 400,
        "y": 275
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "COVID Incidence",
      "equation": "0.001",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Population",
      "equation": "330000000",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "v3",
      "name": "Survival Rate",
      "equation": "0.99",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Long COVID Rate",
      "equation": "0.15",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Acute Recovery Time",
      "equation": "14",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Recovery Rate",
      "equation": "0.005",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Chronic Rate",
      "equation": "0.001",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Total Burden",
      "equation": "Long_COVID_Patients + Chronic_Disability",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Recovered from Acute COVID",
      "to_element": "Long COVID Onset"
    },
    {
      "id": "c2",
      "from_element": "Long COVID Patients",
      "to_element": "Long COVID Recovery"
    },
    {
      "id": "c3",
      "from_element": "Long COVID Patients",
      "to_element": "Chronic Progression"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 730,
    "dt": 1
  },
  "created_at": "2026-01-12T01:45:26.877245+00:00",
  "updated_at": "2026-01-12T01:45:26.877300+00:00",
  "source": "https://doi.org/10.1038/s41586-021-03553-9",
  "reference": "Al-Aly Z, Xie Y, Bowe B. High-dimensional characterization of post-acute sequelae of COVID-19. Nature. 2021;594:259-264."
}