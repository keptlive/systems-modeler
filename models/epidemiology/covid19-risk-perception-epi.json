{
  "id": "covid19-risk-perception-epi",
  "name": "COVID-19 Risk Perception Model",
  "description": "System dynamics model of COVID-19 pandemic considering risk perception. Includes media influence, awareness dynamics, and acceptable death rate thresholds. Based on case study of Iran pandemic response. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "source": "https://doi.org/10.1111/risa.14115",
  "reference": "Korzebor et al. (2024). A system dynamics model of the COVID-19 pandemic considering risk perception: A case study of Iran. Risk Analysis.",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 10000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-infected",
      "name": "Infected",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-awareness",
      "name": "Public Awareness",
      "initial_value": 0.2,
      "equation": "",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "stock-risk-perception",
      "name": "Risk Perception",
      "initial_value": 0.3,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infection",
      "name": "Infection Rate",
      "equation": "beta * Susceptible * Infected * (1 - Behavioral_Response) / Total_Population",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-infected",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-recovery",
      "name": "Recovery Rate",
      "equation": "Infected / Recovery_Time",
      "from_stock": "stock-infected",
      "to_stock": "stock-recovered",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-awareness-increase",
      "name": "Awareness Increase",
      "equation": "Media_Influence * (1 - Public_Awareness) * Infected / Total_Population",
      "from_stock": null,
      "to_stock": "stock-awareness",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "flow-awareness-decay",
      "name": "Awareness Decay",
      "equation": "Public_Awareness / Awareness_Decay_Time",
      "from_stock": "stock-awareness",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "flow-risk-increase",
      "name": "Risk Perception Increase",
      "equation": "Public_Awareness * Death_Visibility * (1 - Risk_Perception)",
      "from_stock": null,
      "to_stock": "stock-risk-perception",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-risk-decay",
      "name": "Risk Perception Decay",
      "equation": "Risk_Perception / Risk_Decay_Time",
      "from_stock": "stock-risk-perception",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "beta",
      "equation": "0.4",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-total-pop",
      "name": "Total Population",
      "equation": "10000000",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-recovery-time",
      "name": "Recovery Time",
      "equation": "14",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-behavioral",
      "name": "Behavioral Response",
      "equation": "Risk_Perception * Response_Effectiveness",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-response-eff",
      "name": "Response Effectiveness",
      "equation": "0.7",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-media",
      "name": "Media Influence",
      "equation": "5",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "var-awareness-decay",
      "name": "Awareness Decay Time",
      "equation": "30",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-death-visibility",
      "name": "Death Visibility",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-risk-decay",
      "name": "Risk Decay Time",
      "equation": "60",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.25
  },
  "created_at": "2026-01-12T03:11:09.889165+00:00",
  "updated_at": "2026-01-12T03:11:09.889165+00:00"
}