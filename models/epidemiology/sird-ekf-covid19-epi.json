{
  "id": "sird-ekf-covid19-epi",
  "name": "SIRD-EKF COVID-19 Model",
  "description": "SIRD epidemic model with Extended Kalman Filter for real-time parameter estimation. Predicts COVID-19 spreading dynamics with uncertainty quantification. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 10000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-infected",
      "name": "Infected",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-dead",
      "name": "Dead",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infection",
      "name": "Infection Rate",
      "equation": "Beta * Susceptible * Infected / Total_Pop",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-infected",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-recovery",
      "name": "Recovery Rate",
      "equation": "Gamma * Infected",
      "from_stock": "stock-infected",
      "to_stock": "stock-recovered",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-death",
      "name": "Death Rate",
      "equation": "Delta * Infected",
      "from_stock": "stock-infected",
      "to_stock": "stock-dead",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.3 + RANDOM(-0.02, 0.02)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-gamma",
      "name": "Gamma",
      "equation": "0.07",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-delta",
      "name": "Delta",
      "equation": "0.005",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-total-pop",
      "name": "Total Pop",
      "equation": "10000000",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-r0",
      "name": "R0",
      "equation": "Beta / (Gamma + Delta)",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-cfr",
      "name": "CFR",
      "equation": "Delta / (Gamma + Delta)",
      "position": {
        "x": 350,
        "y": 450
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 180,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1038/s41598-022-16496-6",
  "reference": "EKF-SIRD model algorithm for predicting coronavirus spreading dynamics. Scientific Reports (2022).",
  "created_at": "2026-01-12T08:11:11.789037+00:00",
  "updated_at": "2026-01-12T08:11:11.789037+00:00"
}