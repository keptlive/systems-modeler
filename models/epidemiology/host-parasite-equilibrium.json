{
  "id": "host-parasite-equilibrium",
  "name": "Host-Parasite Dynamic Equilibrium",
  "description": "Anderson-May model tuned for stable equilibrium with similar-scale populations for easy visualization.",
  "category": "epidemiology",
  "stocks": [
    {"id": "H", "name": "Hosts", "initial_value": 100, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "P", "name": "Parasites", "initial_value": 150, "equation": "", "position": {"x": 500, "y": 200}}
  ],
  "flows": [
    {"id": "host-birth", "name": "Host Births", "equation": "birth_rate * Hosts", "from_stock": null, "to_stock": "H", "position": {"x": 100, "y": 200}},
    {"id": "host-death", "name": "Host Deaths", "equation": "(death_rate + virulence * burden) * Hosts", "from_stock": "H", "to_stock": null, "position": {"x": 300, "y": 200}},
    {"id": "parasite-birth", "name": "Parasite Reproduction", "equation": "repro * Parasites", "from_stock": null, "to_stock": "P", "position": {"x": 400, "y": 200}},
    {"id": "parasite-death", "name": "Parasite Deaths", "equation": "(pmort + death_rate + virulence * (clump + 1) * burden / clump) * Parasites", "from_stock": "P", "to_stock": null, "position": {"x": 600, "y": 200}}
  ],
  "variables": [
    {"id": "v1", "name": "birth_rate", "equation": "0.5", "position": {"x": 100, "y": 100}},
    {"id": "v2", "name": "death_rate", "equation": "0.1", "position": {"x": 200, "y": 100}},
    {"id": "v3", "name": "virulence", "equation": "0.05", "position": {"x": 300, "y": 100}},
    {"id": "v4", "name": "repro", "equation": "1.0", "position": {"x": 400, "y": 100}},
    {"id": "v5", "name": "pmort", "equation": "0.3", "position": {"x": 500, "y": 100}},
    {"id": "v6", "name": "clump", "equation": "2", "position": {"x": 600, "y": 100}},
    {"id": "v7", "name": "burden", "equation": "Parasites / max(Hosts, 1)", "position": {"x": 350, "y": 300}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 100, "dt": 0.1}
}
