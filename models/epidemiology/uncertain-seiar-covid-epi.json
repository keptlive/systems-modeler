{
  "id": "uncertain-seiar-covid-epi",
  "name": "Uncertain SEIAR COVID-19 Community Health Model",
  "description": "System dynamics model integrating uncertain SEIAR compartments for community health management of respiratory viruses. Uses Ensemble Kalman Filter for parameter estimation. Source: Heliyon (2024). DOI: 10.1016/j.heliyon.2024.e24711",
  "stocks": [
    {
      "id": "stock-s",
      "name": "Susceptible",
      "initial_value": 990000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-e",
      "name": "Exposed",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-i",
      "name": "Infected_Symptomatic",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "stock-a",
      "name": "Asymptomatic",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "stock-r",
      "name": "Recovered",
      "initial_value": 8000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-exp",
      "name": "Exposure",
      "equation": "Beta * Susceptible * (Infected_Symptomatic + Asymp_Infectivity * Asymptomatic) / Total_Pop",
      "from_stock": "stock-s",
      "to_stock": "stock-e",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-symp",
      "name": "Symptomatic_Onset",
      "equation": "Exposed * Symptomatic_Fraction / Latent_Period",
      "from_stock": "stock-e",
      "to_stock": "stock-i",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-asymp",
      "name": "Asymptomatic_Onset",
      "equation": "Exposed * (1 - Symptomatic_Fraction) / Latent_Period",
      "from_stock": "stock-e",
      "to_stock": "stock-a",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "flow-recs",
      "name": "Recovery_Symptomatic",
      "equation": "Infected_Symptomatic / Infectious_Period",
      "from_stock": "stock-i",
      "to_stock": "stock-r",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "flow-reca",
      "name": "Recovery_Asymptomatic",
      "equation": "Asymptomatic / Infectious_Period",
      "from_stock": "stock-a",
      "to_stock": "stock-r",
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.4",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-lat",
      "name": "Latent_Period",
      "equation": "5.2",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-inf",
      "name": "Infectious_Period",
      "equation": "7",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-symp",
      "name": "Symptomatic_Fraction",
      "equation": "0.65",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-asymp-inf",
      "name": "Asymp_Infectivity",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-total",
      "name": "Total_Pop",
      "equation": "Susceptible + Exposed + Infected_Symptomatic + Asymptomatic + Recovered",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.25
  },
  "created_at": "2026-01-12T12:41:31.048747+00:00",
  "updated_at": "2026-01-12T12:41:31.048747+00:00",
  "source": "https://doi.org/10.1038/s41586-020-2012-7",
  "reference": "WHO. COVID-19 Weekly Epidemiological Update. World Health Organization; 2020-2024."
}