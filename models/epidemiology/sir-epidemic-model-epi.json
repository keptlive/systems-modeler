{
  "id": "sir-epidemic-model-epi",
  "name": "SIR Epidemic Model",
  "description": "A standard Susceptible-Infectious-Recovered (SIR) compartmental model for infectious disease dynamics. The population moves from Susceptible to Infectious to Recovered, with transmission determined by contact infectivity and recovery by disease duration. Reference: WHO Disease Outbreak Information. Source: https://www.who.int/",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-infectious",
      "name": "Infectious",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-succumbing",
      "name": "Succumbing",
      "equation": "Susceptible * Infectious / Total_Population * Contact_Infectivity",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-infectious",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-recovering",
      "name": "Recovering",
      "equation": "Infectious / Duration",
      "from_stock": "stock-infectious",
      "to_stock": "stock-recovered",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-contact-infectivity",
      "name": "Contact Infectivity",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-duration",
      "name": "Duration",
      "equation": "5",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-total-population",
      "name": "Total Population",
      "equation": "1000",
      "position": {
        "x": 400,
        "y": 80
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Susceptible",
      "to_element": "Succumbing"
    },
    {
      "id": "conn-2",
      "from_element": "Infectious",
      "to_element": "Succumbing"
    },
    {
      "id": "conn-3",
      "from_element": "Total Population",
      "to_element": "Succumbing"
    },
    {
      "id": "conn-4",
      "from_element": "Contact Infectivity",
      "to_element": "Succumbing"
    },
    {
      "id": "conn-5",
      "from_element": "Infectious",
      "to_element": "Recovering"
    },
    {
      "id": "conn-6",
      "from_element": "Duration",
      "to_element": "Recovering"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.03125
  },
  "created_at": "2026-01-11T20:04:50.805935Z",
  "updated_at": "2026-01-11T20:04:50.805935Z",
  "source": "https://doi.org/10.1098/rspa.1927.0118",
  "reference": "Kermack WO, McKendrick AG. A contribution to the mathematical theory of epidemics. Proc R Soc Lond A. 1927;115(772):700-721."
}