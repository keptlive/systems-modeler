{
  "id": "covid-dynamic-heterogeneity-epi",
  "name": "COVID-19 Dynamic Heterogeneity Model",
  "description": "Mechanistic model capturing range of clinical courses after SARS-CoV-2 infection. Examines viral properties, immune properties, and treatment effects. Source: PLoS ONE (2024). DOI: 10.1371/journal.pone.0301780",
  "stocks": [
    {
      "id": "stock-v",
      "name": "Viral_Load",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-t",
      "name": "Target_Cells",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-inf",
      "name": "Infected_Cells",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-imm",
      "name": "Immune_Response",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infect",
      "name": "Cell_Infection",
      "equation": "Beta_V * Target_Cells * Viral_Load",
      "from_stock": "stock-t",
      "to_stock": "stock-inf",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-vprod",
      "name": "Viral_Production",
      "equation": "P * Infected_Cells",
      "from_stock": null,
      "to_stock": "stock-v",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "flow-vclear",
      "name": "Viral_Clearance",
      "equation": "C * Viral_Load + K * Immune_Response * Viral_Load",
      "from_stock": "stock-v",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-celldeath",
      "name": "Infected_Cell_Death",
      "equation": "Delta * Infected_Cells + Kappa * Immune_Response * Infected_Cells",
      "from_stock": "stock-inf",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "flow-immgrow",
      "name": "Immune_Growth",
      "equation": "R * Viral_Load * Immune_Response / (V50 + Viral_Load)",
      "from_stock": null,
      "to_stock": "stock-imm",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-immdecay",
      "name": "Immune_Decay",
      "equation": "D_I * Immune_Response",
      "from_stock": "stock-imm",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
