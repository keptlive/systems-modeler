{
  "id": "covid19-xbb-immune-escape-epi",
  "name": "COVID-19 XBB Variant Immune Escape Model",
  "description": "Model of the XBB variant family with enhanced immune escape properties, allowing reinfection of previously infected and vaccinated individuals. Based on neutralization studies. Source: Wang et al. (2023). Cell. DOI: 10.1016/j.cell.2022.12.018",
  "stocks": [
    {"id": "stock-naive", "name": "Naive_Susceptible", "initial_value": 100000, "equation": "", "position": {"x": 100, "y": 150}},
    {"id": "stock-immune", "name": "Previously_Immune", "initial_value": 800000, "equation": "", "position": {"x": 100, "y": 300}},
    {"id": "stock-infected", "name": "Infected_XBB", "initial_value": 100, "equation": "", "position": {"x": 350, "y": 225}},
    {"id": "stock-recovered", "name": "XBB_Recovered", "initial_value": 0, "equation": "", "position": {"x": 550, "y": 225}}
  ],
  "flows": [
    {"id": "flow-naive-infection", "name": "Naive_Infection", "equation": "Beta * Naive_Susceptible * Infected_XBB / Total_Population", "from_stock": "stock-naive", "to_stock": "stock-infected", "position": {"x": 225, "y": 150}},
    {"id": "flow-reinfection", "name": "Reinfection_Rate", "equation": "Beta * Immune_Escape * Previously_Immune * Infected_XBB / Total_Population", "from_stock": "stock-immune", "to_stock": "stock-infected", "position": {"x": 225, "y": 300}},
    {"id": "flow-recovery", "name": "Recovery", "equation": "Infected_XBB / Infectious_Period", "from_stock": "stock-infected", "to_stock": "stock-recovered", "position": {"x": 450, "y": 225}}
  ],
  "variables": [
    {"id": "var-beta", "name": "Beta", "equation": "0.5", "position": {"x": 225, "y": 50}},
    {"id": "var-escape", "name": "Immune_Escape", "equation": "0.7", "position": {"x": 350, "y": 50}},
    {"id": "var-infectious", "name": "Infectious_Period", "equation": "5", "position": {"x": 450, "y": 100}},
    {"id": "var-total", "name": "Total_Population", "equation": "Naive_Susceptible + Previously_Immune + Infected_XBB + XBB_Recovered", "position": {"x": 350, "y": 350}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 150, "dt": 0.25},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1016/j.cell.2022.12.018",
  "reference": "Wang, Q. et al. (2023). Alarming antibody evasion properties of rising SARS-CoV-2 BQ and XBB subvariants. Cell, 186(2), 279-286."
}
