{
  "id": "covid19-test-trace-isolate-epi",
  "name": "COVID-19 Test-Trace-Isolate Strategy",
  "description": "Models the effectiveness of testing, contact tracing, and isolation in COVID-19 control. Based on Kucharski et al. (2020) Lancet Infectious Diseases. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "category": "epidemiology",
  "stocks": [
    {
      "id": "stock-s",
      "name": "Susceptible",
      "initial_value": 999000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-e",
      "name": "Exposed",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-i",
      "name": "Infectious_Undetected",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-id",
      "name": "Infectious_Detected",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "stock-r",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infect",
      "name": "New_Infections",
      "equation": "Susceptible * (Beta * Infectious_Undetected + Beta_Isolated * Infectious_Detected) / Total_Pop",
      "from_stock": "stock-s",
      "to_stock": "stock-e",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-become-inf",
      "name": "Become_Infectious",
      "equation": "Exposed / Latent_Period",
      "from_stock": "stock-e",
      "to_stock": "stock-i",
      "position": {
        "x": 325,
        "y": 175
      }
    },
    {
      "id": "flow-detect",
      "name": "Case_Detection",
      "equation": "Infectious_Undetected * Detection_Rate * Test_Capacity",
      "from_stock": "stock-i",
      "to_stock": "stock-id",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-recover-u",
      "name": "Recovery_Undetected",
      "equation": "Infectious_Undetected / Infectious_Period",
      "from_stock": "stock-i",
      "to_stock": "stock-r",
      "position": {
        "x": 475,
        "y": 150
      }
    },
    {
      "id": "flow-recover-d",
      "name": "Recovery_Detected",
      "equation": "Infectious_Detected / Infectious_Period",
      "from_stock": "stock-id",
      "to_stock": "stock-r",
      "position": {
        "x": 475,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-beta-iso",
      "name": "Beta_Isolated",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-total",
      "name": "Total_Pop",
      "equation": "Susceptible + Exposed + Infectious_Undetected + Infectious_Detected + Recovered",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-latent",
      "name": "Latent_Period",
      "equation": "3",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-detect",
      "name": "Detection_Rate",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-test-cap",
      "name": "Test_Capacity",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-inf-period",
      "name": "Infectious_Period",
      "equation": "7",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-r-eff",
      "name": "Effective_R",
      "equation": "Beta * Susceptible / Total_Pop * Infectious_Period",
      "position": {
        "x": 350,
        "y": 400
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "source": "https://doi.org/10.1016/S1473-3099(20)30457-6",
  "reference": "Kucharski AJ et al. (2020) Effectiveness of isolation, testing, contact tracing, and physical distancing. Lancet Infectious Diseases 20(10):1151-1160.",
  "connectors": [],
  "created_at": "2026-01-12T06:32:44.851842+00:00",
  "updated_at": "2026-01-12T06:32:44.851842+00:00"
}