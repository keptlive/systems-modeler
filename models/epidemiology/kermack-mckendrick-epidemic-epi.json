{
  "id": "kermack-mckendrick-epidemic-epi",
  "name": "Kermack-McKendrick Epidemic Model",
  "description": "The original 1927 SIR epidemic model by Kermack and McKendrick, foundational for mathematical epidemiology. Introduced the concept of epidemic threshold (R0) and herd immunity. The basis for all modern compartmental disease models. Reference: Kermack, W. O., & McKendrick, A. G. (1927). A contribution to the mathematical theory of epidemics. Proceedings of the Royal Society A, 115(772), 700-721. DOI: https://doi.org/10.1098/rspa.1927.0118",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 999,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-infected",
      "name": "Infected",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infection",
      "name": "Infection Rate",
      "equation": "Beta * Susceptible * Infected / Total_Population",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-infected",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-recovery",
      "name": "Recovery Rate",
      "equation": "Gamma * Infected",
      "from_stock": "stock-infected",
      "to_stock": "stock-recovered",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.4",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-gamma",
      "name": "Gamma",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-total-pop",
      "name": "Total Population",
      "equation": "Susceptible + Infected + Recovered",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-r0",
      "name": "Basic Reproduction Number R0",
      "equation": "Beta / Gamma",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-effective-r",
      "name": "Effective Reproduction Number",
      "equation": "R0 * (Susceptible / Total_Population)",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "var-herd-immunity-threshold",
      "name": "Herd Immunity Threshold",
      "equation": "1 - 1/R0",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "var-attack-rate",
      "name": "Attack Rate",
      "equation": "Recovered / Total_Population",
      "position": {
        "x": 550,
        "y": 400
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Susceptible",
      "to_element": "Infection Rate"
    },
    {
      "id": "conn-2",
      "from_element": "Infected",
      "to_element": "Infection Rate"
    },
    {
      "id": "conn-3",
      "from_element": "Infected",
      "to_element": "Recovery Rate"
    },
    {
      "id": "conn-4",
      "from_element": "Beta",
      "to_element": "R0"
    },
    {
      "id": "conn-5",
      "from_element": "Gamma",
      "to_element": "R0"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 160,
    "dt": 0.1
  },
  "created_at": "2026-01-12T01:30:00.000Z",
  "updated_at": "2026-01-12T01:30:00.000Z",
  "source": "https://doi.org/10.1098/rspa.1927.0118",
  "reference": "Kermack WO, McKendrick AG. A Contribution to the Mathematical Theory of Epidemics. Proceedings of the Royal Society A. 1927;115(772):700-721."
}