{
  "id": "kermack-mckendrick-epidemic-epi",
  "name": "Kermack-McKendrick Epidemic Model",
  "description": "Educational constant-rate SIR example corresponding to the special case in Kermack and McKendrick (1927), equation 29. The parameters are illustrative; this does not reproduce their observed epidemic data. Reproduction-number diagnostics are derived for this homogeneous closed population.\n\nReview 2026-10-20: repaired two diagnostic references to the existing reproduction-number variable. The dynamics implement the constant-rate SIR special case (Kermack-McKendrick 1927, equation 29), with illustrative parameters. This is not a reproduction of their observed epidemic data or a calibrated forecast. The default integrator is explicitly RK4 at the existing time grid, checked against an independent high-accuracy solution over the complete trajectory. Numerical accuracy does not establish empirical validity.",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 999,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-infected",
      "name": "Infected",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infection",
      "name": "Infection Rate",
      "equation": "Beta * Susceptible * Infected / Total_Population",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-infected",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-recovery",
      "name": "Recovery Rate",
      "equation": "Gamma * Infected",
      "from_stock": "stock-infected",
      "to_stock": "stock-recovered",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.4",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-gamma",
      "name": "Gamma",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-total-pop",
      "name": "Total Population",
      "equation": "Susceptible + Infected + Recovered",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-r0",
      "name": "Basic Reproduction Number R0",
      "equation": "Beta / Gamma",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-effective-r",
      "name": "Effective Reproduction Number",
      "equation": "\"Basic Reproduction Number R0\" * (Susceptible / Total_Population)",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "var-herd-immunity-threshold",
      "name": "Herd Immunity Threshold",
      "equation": "1 - 1/\"Basic Reproduction Number R0\"",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "var-attack-rate",
      "name": "Attack Rate",
      "equation": "Recovered / Total_Population",
      "position": {
        "x": 550,
        "y": 400
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Susceptible",
      "to_element": "Infection Rate"
    },
    {
      "id": "conn-2",
      "from_element": "Infected",
      "to_element": "Infection Rate"
    },
    {
      "id": "conn-3",
      "from_element": "Infected",
      "to_element": "Recovery Rate"
    },
    {
      "id": "conn-4",
      "from_element": "Beta",
      "to_element": "R0"
    },
    {
      "id": "conn-5",
      "from_element": "Gamma",
      "to_element": "R0"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 160,
    "dt": 0.1,
    "integration_method": "rk4"
  },
  "created_at": "2026-01-12T01:30:00.000Z",
  "updated_at": "2026-01-12T01:30:00.000Z",
  "source": "https://doi.org/10.1098/rspa.1927.0118",
  "reference": "Kermack WO, McKendrick AG. A Contribution to the Mathematical Theory of Epidemics. Proceedings of the Royal Society A. 1927;115(772):700-721."
}
