{
  "id": "seir-vital-dynamics-epi",
  "name": "SEIR Model with Vital Dynamics",
  "description": "Extended SEIR model including birth and death rates for endemic disease dynamics. Captures long-term disease persistence in populations. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 99000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Exposed",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Infectious",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Recovered",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Births",
      "equation": "Birth_Rate * Total_Population",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Infection",
      "equation": "Beta * Susceptible * Infectious / Total_Population",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Becoming_Infectious",
      "equation": "Exposed / Latent_Period",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Recovery",
      "equation": "Infectious / Infectious_Period",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "S_Deaths",
      "equation": "Death_Rate * Susceptible",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "f6",
      "name": "E_Deaths",
      "equation": "Death_Rate * Exposed",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "f7",
      "name": "I_Deaths",
      "equation": "Death_Rate * Infectious",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "f8",
      "name": "R_Deaths",
      "equation": "Death_Rate * Recovered",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Beta",
      "equation": "0.3",
      "position": {
        "x": 175,
        "y": 300
      }
    },
    {
      "id": "v2",
      "name": "Latent_Period",
      "equation": "5",
      "position": {
        "x": 325,
        "y": 300
      }
    },
    {
      "id": "v3",
      "name": "Infectious_Period",
      "equation": "7",
      "position": {
        "x": 475,
        "y": 300
      }
    },
    {
      "id": "v4",
      "name": "Birth_Rate",
      "equation": "0.00004",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "v5",
      "name": "Death_Rate",
      "equation": "0.00004",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Total_Population",
      "equation": "Susceptible + Exposed + Infectious + Recovered",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25,
    "integration_method": "euler"
  },
