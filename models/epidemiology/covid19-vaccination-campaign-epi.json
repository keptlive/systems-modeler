{
  "id": "covid19-vaccination-campaign-epi",
  "name": "COVID-19 Vaccination Campaign Model",
  "description": "Model of COVID-19 vaccination campaign dynamics including supply constraints, hesitancy, and waning immunity. Source: Bubar et al. (2021), Science. DOI: 10.1126/science.abe6959",
  "stocks": [
    {
      "id": "stock-unvax",
      "name": "Unvaccinated",
      "initial_value": 900000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-dose1",
      "name": "One_Dose",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-dose2",
      "name": "Two_Doses",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-boosted",
      "name": "Boosted",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-waned",
      "name": "Waned_Protection",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-first",
      "name": "First_Dose",
      "equation": "MIN(Unvaccinated * Uptake_Rate * (1 - Hesitancy), Daily_Supply)",
      "from_stock": "stock-unvax",
      "to_stock": "stock-dose1",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-second",
      "name": "Second_Dose",
      "equation": "One_Dose / Dose_Interval",
      "from_stock": "stock-dose1",
      "to_stock": "stock-dose2",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-boost",
      "name": "Booster",
      "equation": "MIN((Two_Doses + Waned_Protection) * Booster_Uptake, Daily_Supply * 0.3)",
      "from_stock": "stock-dose2",
      "to_stock": "stock-boosted",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-wane2",
      "name": "Waning_From_2Dose",
      "equation": "Two_Doses / Waning_Time",
      "from_stock": "stock-dose2",
      "to_stock": "stock-waned",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "flow-waneb",
      "name": "Waning_From_Boost",
      "equation": "Boosted / (Waning_Time * 1.5)",
      "from_stock": "stock-boosted",
      "to_stock": "stock-waned",
      "position": {
        "x": 475,
        "y": 300
      }
    },
    {
      "id": "flow-reboost",
      "name": "Reboosting",
      "equation": "Waned_Protection * Reboost_Rate",
      "from_stock": "stock-waned",
      "to_stock": "stock-boosted",
      "position": {
        "x": 500,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-uptake",
      "name": "Uptake_Rate",
      "equation": "0.02",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-hesitancy",
      "name": "Hesitancy",
      "equation": "0.15",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-supply",
      "name": "Daily_Supply",
      "equation": "5000",
      "position": {
        "x": 175,
        "y": 50
      }
    },
    {
      "id": "var-interval",
      "name": "Dose_Interval",
      "equation": "21",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "var-boostup",
      "name": "Booster_Uptake",
      "equation": "0.01",
      "position": {
        "x": 475,
        "y": 100
      }
    },
    {
      "id": "var-wane",
      "name": "Waning_Time",
      "equation": "180",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-reboost",
      "name": "Reboost_Rate",
      "equation": "0.005",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Unvaccinated",
      "to_element": "First_Dose"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 730,
    "dt": 1
  },
  "created_at": "2026-01-11T22:15:10.906184+00:00",
  "updated_at": "2026-01-11T22:15:10.906184+00:00",
  "source": "https://doi.org/10.1126/science.abe6959",
  "reference": "Bubar, K.M. et al. (2021). Model-informed COVID-19 vaccine prioritization strategies."
}