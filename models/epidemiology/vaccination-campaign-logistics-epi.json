  "flows": [
    {
      "id": "flow-first-vaccination",
      "name": "First Dose Administration",
      "equation": "MIN(Unvaccinated_Population * Willingness_Rate, Daily_Capacity, Vaccine_Inventory / 2)",
      "from_stock": "stock-unvaccinated",
      "to_stock": "stock-first-dose",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-second-vaccination",
      "name": "Second Dose Administration",
      "equation": "MIN(Eligible_for_Second_Dose, Daily_Capacity * 0.5, Vaccine_Inventory / 2)",
      "from_stock": "stock-first-dose",
      "to_stock": "stock-fully-vaccinated",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-vaccine-delivery",
      "name": "Vaccine Delivery",
      "equation": "Weekly_Delivery_Rate / 7",
      "from_stock": null,
      "to_stock": "stock-vaccine-inventory",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "flow-vaccine-use",
      "name": "Vaccine Use",
      "equation": "First_Dose_Administration + Second_Dose_Administration",
      "from_stock": "stock-vaccine-inventory",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "flow-wastage",
      "name": "Wastage",
      "equation": "Vaccine_Inventory * Wastage_Rate",
      "from_stock": "stock-vaccine-inventory",
      "to_stock": "stock-wasted-doses",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "flow-site-opening",
      "name": "Site Opening",
      "equation": "IF(Active_Vaccination_Sites < Target_Sites, Site_Opening_Rate, 0)",
      "from_stock": null,
      "to_stock": "stock-vaccination-sites",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "flow-site-closing",
      "name": "Site Closing",
      "equation": "IF(Coverage_Rate > 0.8, Active_Vaccination_Sites * 0.1, 0)",
      "from_stock": "stock-vaccination-sites",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "flow-staff-training",
      "name": "Staff Training",
      "equation": "Training_Rate",
      "from_stock": null,
      "to_stock": "stock-trained-staff",
      "position": {
        "x": 350,
        "y": 450
      }
    },
    {
      "id": "flow-staff-attrition",
      "name": "Staff Attrition",
      "equation": "Trained_Vaccination_Staff * 0.02",
      "from_stock": "stock-trained-staff",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 450
      }
    }
  ],
