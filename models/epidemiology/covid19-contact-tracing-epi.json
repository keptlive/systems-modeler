{
  "id": "covid19-contact-tracing-epi",
  "name": "COVID-19 Contact Tracing Model",
  "description": "Models effectiveness of contact tracing in controlling COVID-19 spread. Based on Ferretti et al. (2020). DOI: 10.1126/science.abb6936",
  "stocks": [
    {
      "id": "stock-suscep",
      "name": "Susceptible",
      "initial_value": 99000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "stock-exposed",
      "name": "Exposed",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "stock-presymp",
      "name": "Presymptomatic",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "stock-asymp",
      "name": "Asymptomatic",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-symp",
      "name": "Symptomatic",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "stock-quarantine",
      "name": "Quarantined",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 700,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-expose",
      "name": "Exposure",
      "equation": "Beta * Susceptible * Total_Infectious / Total_Pop",
      "from_stock": "stock-suscep",
      "to_stock": "stock-exposed",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "flow-presymp",
      "name": "Become_Presymptomatic",
      "equation": "Exposed * Symptomatic_Fraction / Latent_Period",
      "from_stock": "stock-exposed",
      "to_stock": "stock-presymp",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "flow-asymp",
      "name": "Become_Asymptomatic",
      "equation": "Exposed * (1 - Symptomatic_Fraction) / Latent_Period",
      "from_stock": "stock-exposed",
      "to_stock": "stock-asymp",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-symp",
      "name": "Develop_Symptoms",
      "equation": "Presymptomatic / Presymptomatic_Period",
      "from_stock": "stock-presymp",
      "to_stock": "stock-symp",
      "position": {
        "x": 475,
        "y": 100
      }
    },
    {
      "id": "flow-trace",
      "name": "Contact_Traced",
      "equation": "(Presymptomatic + Asymptomatic) * Tracing_Success * Tracing_Speed",
      "from_stock": null,
      "to_stock": "stock-quarantine",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-recov",
      "name": "Recovery",
      "equation": "(Symptomatic + Quarantined + Asymptomatic) / Recovery_Time",
      "from_stock": null,
      "to_stock": "stock-recovered",
      "position": {
        "x": 625,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.4",
      "position": {
        "x": 175,
        "y": 50
      }
    },
    {
      "id": "var-latent",
      "name": "Latent_Period",
      "equation": "3",
      "position": {
        "x": 325,
        "y": 50
      }
    },
    {
      "id": "var-presympperiod",
      "name": "Presymptomatic_Period",
      "equation": "2",
      "position": {
        "x": 475,
        "y": 50
      }
    },
    {
      "id": "var-sympfrac",
      "name": "Symptomatic_Fraction",
      "equation": "0.6",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-tracesuccess",
      "name": "Tracing_Success",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-tracespeed",
      "name": "Tracing_Speed",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "var-rectime",
      "name": "Recovery_Time",
      "equation": "7",
      "position": {
        "x": 625,
        "y": 50
      }
    },
    {
      "id": "var-totinf",
      "name": "Total_Infectious",
      "equation": "Presymptomatic + Asymptomatic * 0.5 + Symptomatic * 0.3",
      "position": {
        "x": 175,
        "y": 250
      }
    },
    {
      "id": "var-totpop",
      "name": "Total_Pop",
      "equation": "100000",
      "position": {
        "x": 100,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Susceptible",
      "to_element": "Exposure"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 120,
    "dt": 0.25
  },
  "created_at": "2026-01-12T02:45:00.574820+00:00",
  "updated_at": "2026-01-12T02:45:00.574823+00:00",
  "source": "https://doi.org/10.1126/science.abb6936",
  "reference": "Ferretti L, et al. (2020). Quantifying SARS-CoV-2 transmission suggests epidemic control with digital contact tracing. Science."
}