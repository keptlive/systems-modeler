{
  "id": "influenza-antigenic-drift-epi",
  "name": "Infectious_Period",
  "description": "Model of influenza evolution through antigenic drift. Shows how viral mutations reduce vaccine effectiveness and cause seasonal outbreaks. Based on Bedford et al. and WHO surveillance. Reference: Fisher, R. A. (1930). The Genetical Theory of Natural Selection. Oxford University Press. Source: https://doi.org/10.5962/bhl.title.27468",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 900000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Infected",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Recovered",
      "initial_value": 99000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Antigenic_Distance",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Infection",
      "equation": "Beta * Susceptible * Infected / Total_Population",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Recovery",
      "equation": "Infected / Infectious_Period",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Immunity_Waning",
      "equation": "Recovered * Waning_Rate * Antigenic_Effect",
      "from_stock": "s3",
      "to_stock": "s1",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Antigenic_Evolution",
      "equation": "Drift_Rate * Infected / 10000",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Total_Population",
      "equation": "1000000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Beta",
      "equation": "Transmission_Base * Seasonal_Factor",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Transmission_Base",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Seasonal_Factor",
      "equation": "1 + 0.5 * COS(2 * 3.14159 * TIME / 365)",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Infectious_Period",
      "equation": "5",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Waning_Rate",
      "equation": "0.003",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Antigenic_Effect",
      "equation": "1 + Antigenic_Distance / 5",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "v8",
      "name": "Drift_Rate",
      "equation": "0.01",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "v9",
      "name": "Vaccine_Match",
      "equation": "MAX(0, 1 - Antigenic_Distance / 10)",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Vaccine_Effectiveness",
      "equation": "Base_VE * Vaccine_Match",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "v11",
      "name": "Base_VE",
      "equation": "0.6",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "v12",
      "name": "R0",
      "equation": "Beta * Infectious_Period",
      "position": {
        "x": 100,
        "y": 300
      }
    }
  ],
  "connectors": [
