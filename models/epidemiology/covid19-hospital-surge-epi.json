{
  "id": "covid19-hospital-surge-epi",
  "name": "COVID-19 Hospital Surge Capacity Model",
  "description": "Model of hospital capacity during COVID-19 surges showing ICU beds, ventilators, healthcare workers, and patient flow. Based on Weissman et al. (2020) CHIME model. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Hospitalized COVID Patients",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "ICU Patients",
      "initial_value": 15,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Ventilated Patients",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "s4",
      "name": "Cumulative Admissions",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Hospital Admissions",
      "equation": "New_Cases * Hospitalization_Rate",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "ICU Transfer",
      "equation": "Hospitalized_COVID_Patients * ICU_Rate / Hospital_LOS",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Ventilator Need",
      "equation": "ICU_Patients * Ventilation_Rate / ICU_LOS",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Hospital Discharge",
      "equation": "Hospitalized_COVID_Patients * (1 - ICU_Rate) / Hospital_LOS",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "f5",
      "name": "ICU Discharge",
      "equation": "ICU_Patients * (1 - Ventilation_Rate) * (1 - ICU_Mortality) / ICU_LOS",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "f6",
      "name": "Vent Discharge",
      "equation": "Ventilated_Patients * (1 - Vent_Mortality) / Vent_LOS",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 250
      }
    },
    {
      "id": "f7",
      "name": "Recording Admissions",
      "equation": "Hospital_Admissions",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 100,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "New Cases",
      "equation": "1000 * EXP(Growth_Rate * TIME)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Growth Rate",
      "equation": "0.1",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Hospitalization Rate",
      "equation": "0.05",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "ICU Rate",
      "equation": "0.3",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Ventilation Rate",
      "equation": "0.6",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Hospital LOS",
      "equation": "7",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "ICU LOS",
      "equation": "9",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Vent LOS",
      "equation": "10",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "ICU Mortality",
      "equation": "0.15",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v10",
      "name": "Vent Mortality",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "v11",
      "name": "Hospital Bed Capacity",
      "equation": "500",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v12",
      "name": "ICU Capacity",
      "equation": "100",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v13",
      "name": "Ventilator Capacity",
      "equation": "50",
      "position": {
        "x": 600,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "New Cases",
      "to_element": "Hospital Admissions"
    },
    {
      "id": "c2",
      "from_element": "Hospitalized COVID Patients",
      "to_element": "ICU Transfer"
    },
    {
      "id": "c3",
      "from_element": "ICU Patients",
      "to_element": "Ventilator Need"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 90,
    "dt": 0.25
  },
  "created_at": "2026-01-12T01:41:05.118022Z",
  "updated_at": "2026-01-12T01:41:05.118025Z",
  "source": "https://doi.org/10.7326/M20-1260",
  "reference": "Weissman GE, et al. Locally Informed Simulation to Predict Hospital Capacity Needs During the COVID-19 Pandemic. Ann Intern Med. 2020;173(1):21-28."
}