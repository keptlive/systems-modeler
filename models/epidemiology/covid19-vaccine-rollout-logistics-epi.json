{
  "id": "covid19-vaccine-rollout-logistics-epi",
  "name": "COVID-19 Vaccine Rollout Logistics",
  "description": "Supply chain and logistics model for COVID-19 vaccine distribution including cold chain requirements, allocation priorities, and coverage targets. Based on Bubar et al. (2021) Science paper on vaccine prioritization. DOI: 10.1126/science.abe6959",
  "category": "epidemiology",
  "stocks": [
    {
      "id": "stock-doses-mfg",
      "name": "Doses_Manufactured",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-doses-dist",
      "name": "Doses_Distributed",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-doses-admin",
      "name": "Doses_Administered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-fully-vacc",
      "name": "Fully_Vaccinated",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-wastage",
      "name": "Doses_Wasted",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-production",
      "name": "Production",
      "equation": "Production_Capacity",
      "from_stock": null,
      "to_stock": "stock-doses-mfg",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-distribution",
      "name": "Distribution",
      "equation": "MIN(Doses_Manufactured / Distribution_Delay, Distribution_Capacity)",
      "from_stock": "stock-doses-mfg",
      "to_stock": "stock-doses-dist",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-administration",
      "name": "Administration",
      "equation": "MIN(Doses_Distributed / Admin_Delay, Admin_Capacity * (1 - Hesitancy_Rate))",
      "from_stock": "stock-doses-dist",
      "to_stock": "stock-doses-admin",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-completion",
      "name": "Full_Vaccination",
      "equation": "Doses_Administered / Doses_Per_Person / Completion_Delay",
      "from_stock": "stock-doses-admin",
      "to_stock": "stock-fully-vacc",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-wastage",
      "name": "Wastage",
      "equation": "Doses_Distributed * Wastage_Rate / Cold_Chain_Time",
      "from_stock": "stock-doses-dist",
      "to_stock": "stock-wastage",
      "position": {
        "x": 325,
        "y": 275
      }
    }
  ],
