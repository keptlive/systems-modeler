{
  "id": "amr-hospital-spread-epi",
  "name": "Antimicrobial Resistance Hospital Spread Model",
  "description": "Model of antimicrobial resistant bacteria spread in hospitals showing colonization, infection, and transmission dynamics. Based on Austin et al. (1999). Reference: Andersson, D. I., & Hughes, D. (2014). Microbiological effects of sublethal antibiotic concentrations. Nature Reviews Microbiology. Source: https://doi.org/10.1038/nrmicro3270",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible Patients",
      "initial_value": 90,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Colonized Patients",
      "initial_value": 8,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Infected Patients",
      "initial_value": 2,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Healthcare Worker Colonization",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Patient Admissions",
      "equation": "Admission_Rate",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Colonization Transmission",
      "equation": "Beta * Susceptible_Patients * (Colonized_Patients + Infected_Patients + HCW_Contribution) / Total_Patients",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Progression to Infection",
      "equation": "Colonized_Patients * Infection_Rate",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Patient Discharge S",
      "equation": "Susceptible_Patients / Length_of_Stay",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "f5",
      "name": "Patient Discharge C",
      "equation": "Colonized_Patients / Length_of_Stay",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "f6",
      "name": "Patient Discharge I",
      "equation": "Infected_Patients / Infection_Duration",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "f7",
      "name": "HCW Contamination",
      "equation": "(Colonized_Patients + Infected_Patients) * HCW_Contact_Rate * Contamination_Prob",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "f8",
      "name": "HCW Decontamination",
      "equation": "Healthcare_Worker_Colonization / Decontamination_Time",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Admission Rate",
      "equation": "10",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Beta",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Infection Rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Length of Stay",
      "equation": "7",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Infection Duration",
      "equation": "14",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Total Patients",
      "equation": "Susceptible_Patients + Colonized_Patients + Infected_Patients",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v7",
      "name": "HCW Contact Rate",
      "equation": "10",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "v8",
      "name": "Contamination Prob",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "v9",
      "name": "Decontamination Time",
      "equation": "0.5",
      "position": {
        "x": 450,
        "y": 400
      }
    },
    {
      "id": "v10",
      "name": "HCW Contribution",
      "equation": "Healthcare_Worker_Colonization * HCW_Contact_Rate",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Susceptible Patients",
      "to_element": "Colonization Transmission"
    },
    {
      "id": "c2",
      "from_element": "Colonized Patients",
      "to_element": "Progression to Infection"
    },
    {
      "id": "c3",
      "from_element": "Healthcare Worker Colonization",
      "to_element": "HCW Contamination"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.25
  },
  "created_at": "2026-01-12T01:41:05.120445Z",
  "updated_at": "2026-01-12T01:41:05.120448Z",
  "source": "https://doi.org/10.1073/pnas.96.3.1152",
  "reference": "Austin DJ, Bonten MJ, Weinstein RA, Slaughter S, Anderson RM. Vancomycin-resistant enterococci in intensive-care hospital settings: transmission dynamics, persistence, and the impact of infection control programs. PNAS. 1999;96(3):1152-1157."
}