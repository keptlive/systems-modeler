{
  "id": "covid19-vaccine-hesitancy-uptake-epi",
  "name": "COVID-19 Vaccine Hesitancy and Uptake Dynamics",
  "description": "Model of vaccine uptake influenced by social factors, misinformation, and disease prevalence. Based on Larson et al. vaccine confidence research. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Unvaccinated Willing",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Unvaccinated Hesitant",
      "initial_value": 0.3,
      "equation": "",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "s3",
      "name": "Vaccinated",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Infected Unvacc",
      "initial_value": 0.05,
      "equation": "",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "s5",
      "name": "Infected Vacc",
      "initial_value": 0.005,
      "equation": "",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "s6",
      "name": "Misinformation Exposure",
      "initial_value": 0.2,
      "equation": "",
      "position": {
        "x": 200,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Vaccination Willing",
      "equation": "Unvaccinated_Willing * Vaccination_Rate * Vaccine_Availability",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 225,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Hesitant to Willing",
      "equation": "Unvaccinated_Hesitant * Conversion_Rate * (Disease_Fear_Effect + Social_Norm_Effect)",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 225
      }
    },
    {
      "id": "f3",
      "name": "Willing to Hesitant",
      "equation": "Unvaccinated_Willing * Misinformation_Exposure * Misinfo_Effectiveness",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 100,
        "y": 225
      }
    },
    {
      "id": "f4",
      "name": "Unvacc Infection",
      "equation": "Unvaccinated_Willing * Infection_Force * (1 - Partial_Protection)",
      "from_stock": "s1",
      "to_stock": "s4",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "f5",
      "name": "Vacc Breakthrough",
      "equation": "Vaccinated * Infection_Force * (1 - Vaccine_Efficacy)",
      "from_stock": "s3",
      "to_stock": "s5",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "f6",
      "name": "Misinfo Spread",
      "equation": "0.01 * (1 - Misinformation_Exposure)",
      "from_stock": null,
      "to_stock": "s6",
      "position": {
        "x": 150,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Vaccination Rate",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Vaccine Availability",
      "equation": "MIN(1, TIME / 100)",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Vaccine Efficacy",
      "equation": "0.9",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Conversion Rate",
      "equation": "0.01",
      "position": {
        "x": 50,
        "y": 225
      }
    },
    {
      "id": "v5",
      "name": "Disease Fear Effect",
      "equation": "(Infected_Unvacc + Infected_Vacc) * 10",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Social Norm Effect",
      "equation": "Vaccinated * 2",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Infection Force",
      "equation": "0.3 * (Infected_Unvacc + Infected_Vacc)",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v8",
      "name": "Misinfo Effectiveness",
      "equation": "0.1",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Partial Protection",
      "equation": "0",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v10",
      "name": "Total Vaccinated Fraction",
      "equation": "Vaccinated / (Vaccinated + Unvaccinated_Willing + Unvaccinated_Hesitant)",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Unvaccinated Willing",
      "to_element": "Vaccination Willing"
    },
    {
      "id": "c2",
      "from_element": "Vaccinated",
      "to_element": "Social Norm Effect"
    },
    {
      "id": "c3",
      "from_element": "Misinformation Exposure",
      "to_element": "Willing to Hesitant"
    }
  ],
  "time_settings": {
    "start": 0,
