  "flows": [
    {
      "id": "f1",
      "name": "Infection",
      "equation": "Beta * Susceptible * Symptomatic / Population * (1 - NPI_Effectiveness)",
      "from_stock": "Susceptible",
      "to_stock": "Exposed",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Symptom_Onset",
      "equation": "Exposed / Incubation_Period",
      "from_stock": "Exposed",
      "to_stock": "Symptomatic",
      "position": {
        "x": 220,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Hospitalization",
      "equation": "Symptomatic * Hospital_Rate / Symptom_Duration",
      "from_stock": "Symptomatic",
      "to_stock": "Hospitalized",
      "position": {
        "x": 340,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "ICU_Admission",
      "equation": "Hospitalized * ICU_Rate / Hospital_Stay",
      "from_stock": "Hospitalized",
      "to_stock": "Critical",
      "position": {
        "x": 460,
        "y": 300
      }
    },
    {
      "id": "f5",
      "name": "Recovery_Home",
      "equation": "Symptomatic * (1 - Hospital_Rate) / Symptom_Duration",
      "from_stock": "Symptomatic",
      "to_stock": "Recovered",
      "position": {
        "x": 580,
        "y": 300
      }
    },
    {
      "id": "f6",
      "name": "Recovery_Hospital",
      "equation": "Hospitalized * (1 - ICU_Rate) * (1 - Hospital_Death_Rate) / Hospital_Stay",
      "from_stock": "Hospitalized",
      "to_stock": "Recovered",
      "position": {
        "x": 700,
        "y": 300
      }
    },
    {
      "id": "f7",
      "name": "Recovery_ICU",
      "equation": "Critical * (1 - ICU_Death_Rate) / ICU_Stay",
      "from_stock": "Critical",
      "to_stock": "Recovered",
      "position": {
        "x": 820,
        "y": 300
      }
    },
    {
      "id": "f8",
      "name": "Death_Hospital",
      "equation": "Hospitalized * Hospital_Death_Rate / Hospital_Stay",
      "from_stock": "Hospitalized",
      "to_stock": "Deaths",
      "position": {
        "x": 940,
        "y": 300
      }
    },
    {
      "id": "f9",
      "name": "Death_ICU",
      "equation": "Critical * ICU_Death_Rate / ICU_Stay",
      "from_stock": "Critical",
      "to_stock": "Deaths",
      "position": {
        "x": 1060,
        "y": 300
      }
    }
  ],
