      "name": "Doubt_Rate",
      "equation": "0.02",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "v3",
      "name": "Hardening_Rate",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "v4",
