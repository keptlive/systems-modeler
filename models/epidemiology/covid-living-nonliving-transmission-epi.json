{
  "id": "covid-living-nonliving-transmission-epi",
  "name": "COVID-19 Bifurcation Living and Nonliving Media Transmission",
  "description": "Model examining COVID-19 transmission through both living media (human contact) and nonliving objects (fomites). Source: Wiraya et al. (2024), J Applied Mathematics. DOI: 10.1155/2024/5669308",
  "stocks": [
    {
      "id": "stock-s",
      "name": "Susceptible",
      "initial_value": 990000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-e",
      "name": "Exposed",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-i",
      "name": "Infected",
      "initial_value": 3000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-r",
      "name": "Recovered",
      "initial_value": 2000,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-f",
      "name": "Fomite_Contamination",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-exp-human",
      "name": "Human_Exposure",
      "equation": "Beta_H * Susceptible * Infected / Total_Pop",
      "from_stock": "stock-s",
      "to_stock": "stock-e",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "flow-exp-fomite",
      "name": "Fomite_Exposure",
      "equation": "Beta_F * Susceptible * Fomite_Contamination / (K_F + Fomite_Contamination)",
      "from_stock": "stock-s",
      "to_stock": "stock-e",
      "position": {
        "x": 175,
        "y": 250
      }
    },
    {
      "id": "flow-infect",
      "name": "Infection",
      "equation": "Exposed / Latent_Period",
      "from_stock": "stock-e",
      "to_stock": "stock-i",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-rec",
      "name": "Recovery",
      "equation": "Infected / Infectious_Period",
      "from_stock": "stock-i",
      "to_stock": "stock-r",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-shed",
      "name": "Viral_Shedding",
      "equation": "Shedding_Rate * Infected",
      "from_stock": null,
      "to_stock": "stock-f",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "flow-decay",
      "name": "Fomite_Decay",
      "equation": "Decay_Rate * Fomite_Contamination",
      "from_stock": "stock-f",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-betah",
      "name": "Beta_H",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-betaf",
      "name": "Beta_F",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-kf",
      "name": "K_F",
      "equation": "1000",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-lat",
      "name": "Latent_Period",
      "equation": "5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-inf",
      "name": "Infectious_Period",
      "equation": "10",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-shed",
      "name": "Shedding_Rate",
      "equation": "10",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-decay",
      "name": "Decay_Rate",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 400
      }
    },
    {
      "id": "var-total",
      "name": "Total_Pop",
      "equation": "Susceptible + Exposed + Infected + Recovered",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.25
  },
  "created_at": "2026-01-12T12:41:31.048965+00:00",
  "updated_at": "2026-01-12T12:41:31.048965+00:00",
  "source": "https://doi.org/10.1038/s41586-020-2012-7",
  "reference": "WHO. COVID-19 Weekly Epidemiological Update. World Health Organization; 2020-2024."
}