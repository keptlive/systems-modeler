{
  "id": "seir-epidemic-model-epi",
  "name": "SEIR Epidemic Model",
  "description": "Illustrative closed Susceptible-Exposed-Infectious-Recovered compartmental model with a latent period. Hethcote (2000) provides conceptual background. Initial exposed individuals come from the existing Initial Exposed parameter and the remainder start susceptible. The coefficients are not WHO data or a verified parameter set from the cited review.\n\nReview 2026-10-20: reconstructed the closed SEIR initial state using the already supplied Total Population and Initial Exposed parameters; infectious and recovered remain zero. Corrected the diagnostic R0 reference and the DOI to match the named Hethcote review. The values are illustrative, not WHO data, calibration or a reproduction of a paper-specific parameter set. The default integrator is explicitly RK4 at the existing time grid, checked against an independent high-accuracy solution over the complete trajectory. Numerical accuracy does not establish empirical validity.",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 0,
      "equation": "Total_Population - Initial_Exposed",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-exposed",
      "name": "Exposed",
      "initial_value": 0,
      "equation": "Initial_Exposed",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-infectious",
      "name": "Infectious",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 750,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-exposure-rate",
      "name": "Exposure Rate",
      "equation": "Beta * Susceptible * Infectious / Total_Population",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-exposed",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-infection-rate",
      "name": "Infection Rate",
      "equation": "Exposed / Latent_Period",
      "from_stock": "stock-exposed",
      "to_stock": "stock-infectious",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-recovery-rate",
      "name": "Recovery Rate",
      "equation": "Infectious / Infectious_Period",
      "from_stock": "stock-infectious",
      "to_stock": "stock-recovered",
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-total-population",
      "name": "Total Population",
      "equation": "100000",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-initial-exposed",
      "name": "Initial Exposed",
      "equation": "10",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-latent-period",
      "name": "Latent Period",
      "equation": "5",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-infectious-period",
      "name": "Infectious Period",
      "equation": "7",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-basic-reproduction-number-r0",
      "name": "Basic Reproduction Number (R0)",
      "equation": "Beta * Infectious_Period",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-effective-reproduction-number",
      "name": "Effective Reproduction Number",
      "equation": "\"Basic Reproduction Number (R0)\" * Susceptible / Total_Population",
      "position": {
        "x": 250,
        "y": 160
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Susceptible",
      "to_element": "Exposure Rate"
    },
    {
      "id": "conn-2",
      "from_element": "Infectious",
      "to_element": "Exposure Rate"
    },
    {
      "id": "conn-3",
      "from_element": "Total Population",
      "to_element": "Exposure Rate"
    },
    {
      "id": "conn-4",
      "from_element": "Beta",
      "to_element": "Exposure Rate"
    },
    {
      "id": "conn-5",
      "from_element": "Exposed",
      "to_element": "Infection Rate"
    },
    {
      "id": "conn-6",
      "from_element": "Latent Period",
      "to_element": "Infection Rate"
    },
    {
      "id": "conn-7",
      "from_element": "Infectious",
      "to_element": "Recovery Rate"
    },
    {
      "id": "conn-8",
      "from_element": "Infectious Period",
      "to_element": "Recovery Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.0625,
    "integration_method": "rk4"
  },
  "created_at": "2026-01-11T20:04:50.803576Z",
  "updated_at": "2026-01-11T20:04:50.803576Z",
  "source": "https://doi.org/10.1137/S0036144500371907",
  "reference": "Hethcote HW. The mathematics of infectious diseases. SIAM Review. 2000;42(4):599-653."
}
