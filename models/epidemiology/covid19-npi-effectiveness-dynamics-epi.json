  "name": "COVID-19 Non-Pharmaceutical Intervention Effectiveness",
  "description": "Model of COVID-19 transmission reduction from NPIs including masks, distancing, and lockdowns. Based on Brauner et al. Science 2021 meta-analysis. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 0.95,
