        "x": 750,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "New_Infections",
      "equation": "Active_Infections * Growth_Rate * (1 - Mobility_Reduction)",
      "from_stock": null,
      "to_stock": "Active_Infections",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Recoveries",
      "equation": "Active_Infections / Infection_Duration",
      "from_stock": "Active_Infections",
      "to_stock": null,
      "position": {
        "x": 220,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Hospital_Demand_Change",
      "equation": "Active_Infections * Hospital_Rate / Average_Stay - Hospital_Beds_Needed * 0.1",
      "from_stock": null,
      "to_stock": "Hospital_Beds_Needed",
      "position": {
        "x": 340,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "ICU_Demand_Change",
      "equation": "Hospital_Beds_Needed * ICU_Fraction / ICU_Stay - ICU_Beds_Needed * 0.1",
      "from_stock": null,
      "to_stock": "ICU_Beds_Needed",
      "position": {
        "x": 460,
        "y": 300
      }
    },
    {
      "id": "f5",
      "name": "Ventilator_Demand_Change",
      "equation": "ICU_Beds_Needed * Vent_Fraction - Ventilators_Needed * 0.15",
      "from_stock": null,
      "to_stock": "Ventilators_Needed",
      "position": {
        "x": 580,
        "y": 300
      }
    },
    {
      "id": "f6",
      "name": "Daily_Deaths",
      "equation": "Hospital_Beds_Needed * Death_Rate / Average_Stay",
      "from_stock": null,
      "to_stock": "Cumulative_Deaths",
      "position": {
        "x": 700,
        "y": 300
      }
    }
  ],
