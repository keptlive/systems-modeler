{
  "id": "covid19-behavioral-response-epi",
  "name": "COVID-19 Behavioral Response to Risk",
  "description": "Models how public behavior changes in response to perceived COVID-19 risk. Based on Petherick et al. (2021) Nature Human Behaviour. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "category": "epidemiology",
  "stocks": [
    {
      "id": "stock-s",
      "name": "Susceptible",
      "initial_value": 990000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-i",
      "name": "Infected",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-r",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-risk",
      "name": "Perceived_Risk",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "stock-fatigue",
      "name": "Behavioral_Fatigue",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infect",
      "name": "New_Infections",
      "equation": "Beta_Effective * Susceptible * Infected / Total_Pop",
      "from_stock": "stock-s",
      "to_stock": "stock-i",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-recover",
      "name": "Recovery",
      "equation": "Infected / Infectious_Period",
      "from_stock": "stock-i",
      "to_stock": "stock-r",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-risk-up",
      "name": "Risk_Increase",
      "equation": "(Actual_Risk - Perceived_Risk) / Risk_Update_Time * Risk_Sensitivity",
      "from_stock": null,
      "to_stock": "stock-risk",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-risk-down",
      "name": "Risk_Decay",
      "equation": "Perceived_Risk * Risk_Forgetting_Rate",
      "from_stock": "stock-risk",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "flow-fatigue-build",
      "name": "Fatigue_Buildup",
      "equation": "Perceived_Risk * Fatigue_Rate * (100 - Behavioral_Fatigue) / 100",
      "from_stock": null,
      "to_stock": "stock-fatigue",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "flow-fatigue-decay",
      "name": "Fatigue_Recovery",
      "equation": "Behavioral_Fatigue * Fatigue_Recovery_Rate",
      "from_stock": "stock-fatigue",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta-base",
      "name": "Beta_Base",
      "equation": "0.4",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-beta-eff",
      "name": "Beta_Effective",
      "equation": "Beta_Base * (1 - Behavioral_Reduction * (1 - Behavioral_Fatigue/100))",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-behav-red",
      "name": "Behavioral_Reduction",
      "equation": "MIN(0.7, Perceived_Risk / 100)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-total",
      "name": "Total_Pop",
      "equation": "Susceptible + Infected + Recovered",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-inf-period",
      "name": "Infectious_Period",
      "equation": "10",
      "position": {
        "x": 150,
        "y": 400
      }
    },
    {
      "id": "var-actual",
      "name": "Actual_Risk",
      "equation": "100 * Infected / Total_Pop * 1000",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-update",
      "name": "Risk_Update_Time",
      "equation": "7",
      "position": {
        "x": 450,
        "y": 400
      }
    },
    {
      "id": "var-sens",
      "name": "Risk_Sensitivity",
      "equation": "1.5",
      "position": {
        "x": 150,
        "y": 450
      }
    },
    {
      "id": "var-forget",
      "name": "Risk_Forgetting_Rate",
      "equation": "0.03",
      "position": {
        "x": 300,
        "y": 450
      }
    },
    {
      "id": "var-fat-rate",
      "name": "Fatigue_Rate",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 450
      }
    },
    {
      "id": "var-fat-recov",
      "name": "Fatigue_Recovery_Rate",
      "equation": "0.01",
      "position": {
        "x": 600,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/s41562-021-01079-8",
  "reference": "Petherick A et al. (2021) A worldwide assessment of changes in adherence to COVID-19 protective behaviours. Nature Human Behaviour 5:1145-1160.",
  "connectors": [],
  "created_at": "2026-01-12T06:32:44.851842+00:00",
  "updated_at": "2026-01-12T06:32:44.851842+00:00"
}