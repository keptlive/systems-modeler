{
  "id": "covid19-wastewater-surveillance-epi",
  "name": "COVID-19 Wastewater Surveillance Model",
  "description": "Model of COVID-19 monitoring through wastewater surveillance. Viral RNA in wastewater provides early warning of community transmission trends. Based on public health surveillance literature and pandemic response research. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Active_Infections",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Wastewater_Viral_Load",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Detected_Cases",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Cumulative_Infections",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "New_Infections",
      "equation": "Active_Infections * Transmission_Rate * (1 - Detected_Cases / Population * Isolation_Effect)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Recoveries",
      "equation": "Active_Infections / Infectious_Period",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 280
      }
    },
    {
      "id": "f3",
      "name": "Viral_Shedding",
      "equation": "Active_Infections * Shedding_Rate - Wastewater_Viral_Load * Decay_Rate",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 350,
        "y": 280
      }
    },
    {
      "id": "f4",
      "name": "Case_Detection",
      "equation": "Active_Infections * Testing_Rate * Test_Sensitivity",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Case_Resolution",
      "equation": "Detected_Cases / Case_Duration",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 280
      }
    },
    {
      "id": "f6",
      "name": "Cumulative_Add",
      "equation": "New_Infections",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 250,
        "y": 430
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Population",
      "equation": "100000",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "v2",
      "name": "Transmission_Rate",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "v3",
      "name": "Infectious_Period",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "v4",
      "name": "Shedding_Rate",
      "equation": "10",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "v5",
      "name": "Decay_Rate",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "Testing_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Test_Sensitivity",
      "equation": "0.8",
      "position": {
        "x": 400,
        "y": 130
      }
    },
    {
      "id": "v8",
      "name": "Case_Duration",
      "equation": "14",
      "position": {
        "x": 550,
        "y": 130
      }
    },
    {
      "id": "v9",
      "name": "Isolation_Effect",
      "equation": "0.8",
      "position": {
        "x": 150,
        "y": 180
      }
    },
    {
      "id": "v10",
      "name": "Wastewater_Signal",
      "equation": "Wastewater_Viral_Load / MAX(Active_Infections, 1) * 100",
      "position": {
        "x": 350,
        "y": 180
      }
    },
    {
      "id": "v11",
      "name": "Detection_Ratio",
      "equation": "Detected_Cases / MAX(Active_Infections, 1)",
      "position": {
        "x": 550,
        "y": 180
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 180,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/s41587-020-0684-z",
  "reference": "Peccia J et al. (2020) Measurement of SARS-CoV-2 RNA in wastewater tracks community infection dynamics. Nature Biotechnology.",
  "created_at": "2026-01-12T06:57:53.545407+00:00",
  "updated_at": "2026-01-12T06:57:53.545407+00:00"
