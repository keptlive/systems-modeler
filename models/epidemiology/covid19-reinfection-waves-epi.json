{
  "id": "covid19-reinfection-waves-epi",
  "name": "COVID-19 Reinfection and Wave Dynamics",
  "description": "SEIRS model with waning immunity capturing multiple waves of COVID-19 infection. Based on Lavine et al. (2021) Science paper on endemic transition. DOI: 10.1126/science.abe6522",
  "category": "epidemiology",
  "stocks": [
    {
      "id": "stock-s",
      "name": "Susceptible",
      "initial_value": 9000000.0,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-e",
      "name": "Exposed",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-i",
      "name": "Infected",
      "initial_value": 10000.0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-r",
      "name": "Recovered_Immune",
      "initial_value": 1000000.0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-v",
      "name": "Vaccinated",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 325,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infection",
      "name": "New_Infections",
      "equation": "Beta * Susceptible * Infected / Total_Pop",
      "from_stock": "stock-s",
      "to_stock": "stock-e",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-incubation",
      "name": "Incubation",
      "equation": "Exposed / Latent_Period",
      "from_stock": "stock-e",
      "to_stock": "stock-i",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-recovery",
      "name": "Recovery",
      "equation": "Infected / Infectious_Period",
      "from_stock": "stock-i",
      "to_stock": "stock-r",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-waning",
      "name": "Immunity_Waning",
      "equation": "Recovered_Immune / Immunity_Duration",
      "from_stock": "stock-r",
      "to_stock": "stock-s",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "flow-vaccination",
      "name": "Vaccination",
      "equation": "Susceptible * Vaccination_Rate",
      "from_stock": "stock-s",
      "to_stock": "stock-v",
      "position": {
        "x": 100,
        "y": 275
      }
    },
    {
      "id": "flow-vacc-waning",
      "name": "Vaccine_Waning",
      "equation": "Vaccinated / Vaccine_Immunity_Duration",
      "from_stock": "stock-v",
      "to_stock": "stock-s",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-latent",
      "name": "Latent_Period",
      "equation": "4",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-infectious",
      "name": "Infectious_Period",
      "equation": "7",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-immunity",
      "name": "Immunity_Duration",
      "equation": "180",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-vacc-rate",
      "name": "Vaccination_Rate",
      "equation": "0.002",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-vacc-immunity",
      "name": "Vaccine_Immunity_Duration",
      "equation": "365",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-total",
      "name": "Total_Pop",
      "equation": "1e7",
      "position": {
        "x": 350,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 730,
    "dt": 1
  },
  "source": "https://doi.org/10.1126/science.abe6522",
  "reference": "Lavine JS, Bjornstad ON, Antia R (2021) Immunological characteristics govern the transition of COVID-19 to endemicity. Science.",
