{
  "id": "influenza-antigenic-drift-vaccine-epi",
  "name": "Influenza Antigenic Drift and Vaccine Matching",
  "description": "Model of influenza strain evolution through antigenic drift affecting vaccine effectiveness. Based on Bedford et al. 2014. Reference: Fisher, R. A. (1930). The Genetical Theory of Natural Selection. Oxford University Press. Source: https://doi.org/10.5962/bhl.title.27468",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 0.6,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Infected Current Strain",
      "initial_value": 0.01,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "s3",
      "name": "Infected Drifted Strain",
      "initial_value": 0.001,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "s4",
      "name": "Immune Current",
      "initial_value": 0.2,
      "equation": "",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "s5",
      "name": "Immune Drifted",
      "initial_value": 0.05,
      "equation": "",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "s6",
      "name": "Antigenic Distance",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Current Strain Infection",
      "equation": "Susceptible * Beta * Infected_Current_Strain * (1 - Vaccine_Effectiveness)",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "f2",
      "name": "Drifted Strain Infection",
      "equation": "Susceptible * Beta * Infected_Drifted_Strain * (1 - Reduced_Vaccine_Effect)",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "f3",
      "name": "Current Recovery",
      "equation": "Infected_Current_Strain / Infectious_Period",
      "from_stock": "s2",
      "to_stock": "s4",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "f4",
      "name": "Drifted Recovery",
      "equation": "Infected_Drifted_Strain / Infectious_Period",
      "from_stock": "s3",
      "to_stock": "s5",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "f5",
      "name": "Cross Immunity from Current",
      "equation": "Immune_Current * Cross_Immunity_Rate * (1 - Antigenic_Distance / Max_Distance)",
      "from_stock": "s4",
      "to_stock": "s5",
      "position": {
        "x": 500,
        "y": 175
      }
    },
    {
      "id": "f6",
      "name": "Antigenic Evolution",
      "equation": "Drift_Rate",
      "from_stock": null,
      "to_stock": "s6",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "f7",
      "name": "Immunity Waning",
      "equation": "Immune_Current * Waning_Rate",
      "from_stock": "s4",
      "to_stock": "s1",
      "position": {
        "x": 300,
        "y": 50
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Beta",
      "equation": "0.4",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Infectious Period",
      "equation": "5",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Base Vaccine Effectiveness",
      "equation": "0.6",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "v4",
      "name": "Vaccine Effectiveness",
      "equation": "Base_Vaccine_Effectiveness * (1 - Antigenic_Distance / Max_Distance)",
      "position": {
        "x": 200,
        "y": 175
      }
    },
    {
      "id": "v5",
      "name": "Reduced Vaccine Effect",
      "equation": "Vaccine_Effectiveness * 0.5",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Cross Immunity Rate",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 175
      }
    },
    {
      "id": "v7",
      "name": "Drift Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "v8",
      "name": "Max Distance",
      "equation": "10",
      "position": {
        "x": 450,
        "y": 400
      }
    },
    {
      "id": "v9",
      "name": "Waning Rate",
      "equation": "0.01",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "v10",
      "name": "Total Infected",
      "equation": "Infected_Current_Strain + Infected_Drifted_Strain",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "v11",
      "name": "Strain Dominance",
      "equation": "Infected_Drifted_Strain / (Total_Infected + 0.001)",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "connectors": [
