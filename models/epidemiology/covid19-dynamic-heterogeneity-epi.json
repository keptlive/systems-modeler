{
  "id": "covid19-dynamic-heterogeneity-epi",
  "name": "COVID-19 Dynamic Heterogeneity Model",
  "description": "Mechanistic mathematical model determining range of possible clinical courses after SARS-CoV-2 infection. Examines viral properties, immune response, treatment modality, and random factors like initial viral load. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "stock-viral-load",
      "name": "Viral Load",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "stock-target-cells",
      "name": "Target Cells",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "stock-infected-cells",
      "name": "Infected Cells",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "stock-immune-response",
      "name": "Immune Response",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "stock-tissue-damage",
      "name": "Tissue Damage",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infection",
      "name": "Cell Infection",
      "equation": "Beta_Infection * Viral_Load * Target_Cells",
      "from_stock": "stock-target-cells",
      "to_stock": "stock-infected-cells",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "flow-viral-prod",
      "name": "Viral Production",
      "equation": "Infected_Cells * Viral_Production_Rate",
      "from_stock": null,
      "to_stock": "stock-viral-load",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-viral-clear",
      "name": "Viral Clearance",
      "equation": "Viral_Load * (Clearance_Rate + Immune_Response * Immune_Effect)",
      "from_stock": "stock-viral-load",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-cell-death",
      "name": "Infected Cell Death",
      "equation": "Infected_Cells * (Death_Rate + Immune_Response * CTL_Effect)",
      "from_stock": "stock-infected-cells",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "flow-immune-act",
      "name": "Immune Activation",
      "equation": "Immune_Stim * Viral_Load / (Viral_Half_Sat + Viral_Load)",
      "from_stock": null,
      "to_stock": "stock-immune-response",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-damage",
      "name": "Damage Accumulation",
      "equation": "Infected_Cells * Damage_Rate + Immune_Response * Immunopathology",
      "from_stock": null,
      "to_stock": "stock-tissue-damage",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta Infection",
      "equation": "0.00001",
      "position": {
        "x": 100,
        "y": 100
      }
    },
