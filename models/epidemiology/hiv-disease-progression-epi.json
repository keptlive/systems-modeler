{
  "id": "hiv-disease-progression-epi",
  "name": "HIV Disease Progression",
  "description": "HIV/AIDS disease progression model showing stages from acute infection through AIDS. Models CD4 cell dynamics and viral load. Source: Based on Hollingsworth et al. (2008), JID. DOI: 10.1086/533417",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 990000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-acute",
      "name": "Acute_HIV",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-chronic",
      "name": "Chronic_HIV",
      "initial_value": 8000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-aids",
      "name": "AIDS",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-on-art",
      "name": "On_ART",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infection",
      "name": "New_Infection",
      "equation": "Susceptible * (Beta_Acute * Acute_HIV + Beta_Chronic * Chronic_HIV + Beta_AIDS * AIDS) / Total_Population",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-acute",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-progression1",
      "name": "To_Chronic",
      "equation": "Acute_HIV / Acute_Duration",
      "from_stock": "stock-acute",
      "to_stock": "stock-chronic",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-progression2",
      "name": "To_AIDS",
      "equation": "Chronic_HIV * (1 - ART_Coverage) / Chronic_Duration",
      "from_stock": "stock-chronic",
      "to_stock": "stock-aids",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-art-initiation",
      "name": "ART_Initiation",
      "equation": "Chronic_HIV * ART_Coverage / Time_to_ART",
      "from_stock": "stock-chronic",
      "to_stock": "stock-on-art",
      "position": {
        "x": 400,
        "y": 275
      }
    },
    {
      "id": "flow-aids-death",
      "name": "AIDS_Death",
      "equation": "AIDS / AIDS_Survival",
      "from_stock": "stock-aids",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta-acute",
      "name": "Beta_Acute",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-beta-chronic",
      "name": "Beta_Chronic",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 80
      }
    },
    {
      "id": "var-beta-aids",
      "name": "Beta_AIDS",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-acute-duration",
      "name": "Acute_Duration",
      "equation": "0.25",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-chronic-duration",
      "name": "Chronic_Duration",
      "equation": "8",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-aids-survival",
      "name": "AIDS_Survival",
      "equation": "2",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "var-art-coverage",
      "name": "ART_Coverage",
      "equation": "0.5",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-time-to-art",
      "name": "Time_to_ART",
      "equation": "1",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "var-total-pop",
      "name": "Total_Population",
      "equation": "Susceptible + Acute_HIV + Chronic_HIV + AIDS + On_ART",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-hiv-prevalence",
      "name": "HIV_Prevalence",
      "equation": "(Acute_HIV + Chronic_HIV + AIDS + On_ART) / Total_Population",
      "position": {
        "x": 100,
        "y": 80
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Susceptible",
      "to_element": "New_Infection"
    },
    {
      "id": "conn-2",
      "from_element": "Acute_HIV",
      "to_element": "New_Infection"
    },
    {
      "id": "conn-3",
      "from_element": "Chronic_HIV",
      "to_element": "New_Infection"
    },
    {
      "id": "conn-4",
      "from_element": "Acute_HIV",
      "to_element": "To_Chronic"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-11T20:52:52.274868+00:00",
  "updated_at": "2026-01-11T20:52:52.274868+00:00",
  "source": "https://doi.org/10.1016/j.jtbi.2017.11.024",
  "reference": "Keeling MJ, Rohani P. Modeling Infectious Diseases in Humans and Animals. Princeton University Press, 2008."
}