{
  "id": "covid-vaccination-policy-us-epi",
  "name": "COVID-19 Vaccination and Social Mobilization Policy Model",
  "description": "System dynamics analysis of vaccination and social mobilization effectiveness for COVID-19 containment in the US. Source: Chen et al. (2022), PLoS ONE. DOI: 10.1371/journal.pone.0268443",
  "stocks": [
    {
      "id": "stock-s",
      "name": "Susceptible",
      "initial_value": 280000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-v",
      "name": "Vaccinated",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "stock-e",
      "name": "Exposed",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-i",
      "name": "Infected",
      "initial_value": 50000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-r",
      "name": "Recovered",
      "initial_value": 50000000,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-vax",
      "name": "Vaccination",
      "equation": "Vaccination_Rate * Susceptible",
      "from_stock": "stock-s",
      "to_stock": "stock-v",
      "position": {
        "x": 100,
        "y": 275
      }
    },
    {
      "id": "flow-exp",
      "name": "Exposure",
      "equation": "Beta * Contact_Reduction * Susceptible * Infected / Total_Pop",
      "from_stock": "stock-s",
      "to_stock": "stock-e",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-expv",
      "name": "Breakthrough_Exposure",
      "equation": "Beta * (1 - Vaccine_Efficacy) * Contact_Reduction * Vaccinated * Infected / Total_Pop",
      "from_stock": "stock-v",
      "to_stock": "stock-e",
      "position": {
        "x": 175,
        "y": 350
      }
    },
    {
      "id": "flow-infect",
      "name": "Infection",
      "equation": "Exposed / Latent_Period",
      "from_stock": "stock-e",
      "to_stock": "stock-i",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-rec",
      "name": "Recovery",
      "equation": "Infected / Infectious_Period",
      "from_stock": "stock-i",
      "to_stock": "stock-r",
      "position": {
        "x": 475,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-vaxrate",
      "name": "Vaccination_Rate",
      "equation": "0.003",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-vaxeff",
      "name": "Vaccine_Efficacy",
      "equation": "0.9",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-contact",
      "name": "Contact_Reduction",
      "equation": "0.7",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-lat",
      "name": "Latent_Period",
      "equation": "5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-inf",
      "name": "Infectious_Period",
      "equation": "10",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-total",
      "name": "Total_Pop",
      "equation": "Susceptible + Vaccinated + Exposed + Infected + Recovered",
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 730,
    "dt": 1
  },
  "created_at": "2026-01-12T12:41:31.048929+00:00",
  "updated_at": "2026-01-12T12:41:31.048929+00:00",
  "source": "https://doi.org/10.1038/s41586-020-2012-7",
  "reference": "WHO. COVID-19 Weekly Epidemiological Update. World Health Organization; 2020-2024."
}