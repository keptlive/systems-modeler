      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-efficacy",
      "name": "Drug_Efficacy",
      "equation": "5.0",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-total",
      "name": "Total_Population",
      "equation": "Susceptible_Bacteria + Resistant_Bacteria",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
