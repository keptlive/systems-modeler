{
  "id": "drug-resistance-evolution-epi",
  "name": "Drug Resistance Evolution Model",
  "description": "Model of antimicrobial resistance evolution showing how drug use drives resistance and how stewardship can slow it. Reference: Fisher, R. A. (1930). The Genetical Theory of Natural Selection. Oxford University Press. Source: https://doi.org/10.5962/bhl.title.27468",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible_Bacteria",
      "initial_value": 900,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-resistant",
      "name": "Resistant_Bacteria",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-s-growth",
      "name": "Susceptible_Growth",
      "equation": "Susceptible_Bacteria * Growth_Rate * (1 - Total_Population / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-susceptible",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "flow-r-growth",
      "name": "Resistant_Growth",
      "equation": "Resistant_Bacteria * Growth_Rate * Fitness_Cost * (1 - Total_Population / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-resistant",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "flow-mutation",
      "name": "Mutation_Rate",
      "equation": "Susceptible_Bacteria * Mutation_Probability * Drug_Pressure",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-resistant",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-s-death",
      "name": "Susceptible_Death",
      "equation": "Susceptible_Bacteria * Death_Rate * (1 + Drug_Pressure * Drug_Efficacy)",
      "from_stock": "stock-susceptible",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "flow-r-death",
      "name": "Resistant_Death",
      "equation": "Resistant_Bacteria * Death_Rate",
      "from_stock": "stock-resistant",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-growth",
      "name": "Growth_Rate",
      "equation": "0.2",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-fitness",
      "name": "Fitness_Cost",
      "equation": "0.9",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "var-capacity",
      "name": "Carrying_Capacity",
      "equation": "1500",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-mutation",
      "name": "Mutation_Probability",
      "equation": "0.0001",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "var-drug",
      "name": "Drug_Pressure",
      "equation": "1.0",
      "position": {
