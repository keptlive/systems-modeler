{
  "id": "covid19-policy-response-epi",
  "name": "COVID-19 Policy Response Model",
  "description": "A system dynamics model for analyzing COVID-19 policy interventions including lockdowns, testing, and vaccination based on Struben (2020). Models the feedback between infection rates, healthcare capacity, and policy responses. DOI: 10.1007/s41660-020-00130-x",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 999000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "stock-exposed",
      "name": "Exposed",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "stock-infectious",
      "name": "Infectious",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-hospitalized",
      "name": "Hospitalized",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 350,
      "equation": "",
      "position": {
        "x": 700,
        "y": 150
      }
    },
    {
      "id": "stock-deceased",
      "name": "Deceased",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "stock-vaccinated",
      "name": "Vaccinated",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "stock-hospital-capacity",
      "name": "Hospital Capacity",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infection",
      "name": "Infection Rate",
      "equation": "Susceptible * Infectious / Total_Population * Transmission_Rate * (1 - Policy_Effect)",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-exposed",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "flow-becoming-infectious",
      "name": "Becoming Infectious",
      "equation": "Exposed / Incubation_Period",
      "from_stock": "stock-exposed",
      "to_stock": "stock-infectious",
      "position": {
        "x": 325,
        "y": 150
      }
    },
    {
      "id": "flow-hospitalization",
      "name": "Hospitalization Rate",
      "equation": "Infectious * Hospitalization_Fraction / Infectious_Period",
      "from_stock": "stock-infectious",
      "to_stock": "stock-hospitalized",
      "position": {
        "x": 475,
        "y": 150
      }
    },
    {
      "id": "flow-recovery-home",
      "name": "Home Recovery",
      "equation": "Infectious * (1 - Hospitalization_Fraction) / Infectious_Period",
      "from_stock": "stock-infectious",
      "to_stock": "stock-recovered",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "flow-hospital-recovery",
      "name": "Hospital Recovery",
      "equation": "Hospitalized * (1 - Fatality_Rate) / Hospital_Stay",
      "from_stock": "stock-hospitalized",
      "to_stock": "stock-recovered",
      "position": {
        "x": 625,
        "y": 150
      }
    },
    {
      "id": "flow-death",
      "name": "Death Rate",
      "equation": "Hospitalized * Fatality_Rate / Hospital_Stay",
      "from_stock": "stock-hospitalized",
      "to_stock": "stock-deceased",
      "position": {
        "x": 550,
        "y": 225
      }
    },
    {
      "id": "flow-vaccination",
      "name": "Vaccination Rate",
      "equation": "MIN(Susceptible, Vaccination_Capacity) * Vaccine_Uptake",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-vaccinated",
      "position": {
        "x": 100,
        "y": 225
      }
    },
    {
      "id": "flow-capacity-expansion",
      "name": "Capacity Expansion",
      "equation": "Hospital_Investment_Rate",
      "from_stock": null,
      "to_stock": "stock-hospital-capacity",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-total-population",
      "name": "Total Population",
      "equation": "1000000",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-transmission-rate",
      "name": "Transmission Rate",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-incubation-period",
      "name": "Incubation Period",
      "equation": "5",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-infectious-period",
      "name": "Infectious Period",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-hospitalization-fraction",
      "name": "Hospitalization Fraction",
      "equation": "0.15",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "var-fatality-rate",
      "name": "Fatality Rate",
      "equation": "Base_Fatality * (1 + Capacity_Pressure)",
      "position": {
        "x": 600,
        "y": 50
      }
    },
    {
      "id": "var-base-fatality",
      "name": "Base Fatality",
      "equation": "0.02",
      "position": {
        "x": 700,
        "y": 50
      }
    },
    {
      "id": "var-hospital-stay",
      "name": "Hospital Stay",
      "equation": "14",
      "position": {
        "x": 100,
        "y": 500
      }
    },
    {
      "id": "var-capacity-pressure",
      "name": "Capacity Pressure",
      "equation": "MAX(0, (Hospitalized - Hospital_Capacity) / Hospital_Capacity)",
      "position": {
        "x": 200,
        "y": 500
      }
    },
    {
      "id": "var-policy-effect",
      "name": "Policy Effect",
      "equation": "Lockdown_Intensity * Lockdown_Effectiveness + Mask_Compliance * Mask_Effectiveness",
      "position": {
        "x": 300,
        "y": 500
      }
    },
    {
      "id": "var-lockdown-intensity",
      "name": "Lockdown Intensity",
      "equation": "IF(Hospitalized > Hospital_Capacity * 0.8, 0.8, IF(Hospitalized > Hospital_Capacity * 0.5, 0.5, 0))",
      "position": {
        "x": 400,
        "y": 500
      }
    },
    {
      "id": "var-lockdown-effectiveness",
      "name": "Lockdown Effectiveness",
      "equation": "0.7",
      "position": {
        "x": 500,
        "y": 500
      }
    },
    {
      "id": "var-mask-compliance",
      "name": "Mask Compliance",
      "equation": "0.6",
      "position": {
        "x": 600,
        "y": 500
      }
    },
    {
      "id": "var-mask-effectiveness",
      "name": "Mask Effectiveness",
      "equation": "0.3",
      "position": {
        "x": 700,
        "y": 500
      }
    },
    {
      "id": "var-vaccination-capacity",
      "name": "Vaccination Capacity",
      "equation": "5000",
      "position": {
        "x": 100,
        "y": 600
      }
    },
    {
      "id": "var-vaccine-uptake",
      "name": "Vaccine Uptake",
      "equation": "0.7",
      "position": {
        "x": 200,
        "y": 600
      }
    },
    {
      "id": "var-hospital-investment",
      "name": "Hospital Investment Rate",
      "equation": "100",
      "position": {
        "x": 300,
        "y": 600
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Susceptible",
      "to_element": "Infection Rate"
    },
    {
      "id": "conn-2",
      "from_element": "Infectious",
      "to_element": "Infection Rate"
    },
    {
      "id": "conn-3",
      "from_element": "Transmission Rate",
      "to_element": "Infection Rate"
    },
    {
      "id": "conn-4",
      "from_element": "Policy Effect",
      "to_element": "Infection Rate"
    },
    {
      "id": "conn-5",
      "from_element": "Exposed",
      "to_element": "Becoming Infectious"
    },
    {
      "id": "conn-6",
      "from_element": "Infectious",
      "to_element": "Hospitalization Rate"
    },
    {
      "id": "conn-7",
      "from_element": "Hospitalized",
      "to_element": "Hospital Recovery"
    },
    {
      "id": "conn-8",
      "from_element": "Hospitalized",
      "to_element": "Death Rate"
    },
    {
      "id": "conn-9",
      "from_element": "Fatality Rate",
      "to_element": "Death Rate"
    },
    {
      "id": "conn-10",
      "from_element": "Capacity Pressure",
      "to_element": "Fatality Rate"
    },
    {
      "id": "conn-11",
      "from_element": "Hospitalized",
      "to_element": "Capacity Pressure"
    },
    {
      "id": "conn-12",
      "from_element": "Hospital Capacity",
      "to_element": "Capacity Pressure"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.25
  },
  "created_at": "2026-01-11T21:00:00.000000Z",
  "updated_at": "2026-01-11T21:00:00.000000Z",
  "source": "https://doi.org/10.1016/j.chaos.2020.109889",
  "reference": "COVID-19 SEIR Models - Various Authors 2020-2022"
}