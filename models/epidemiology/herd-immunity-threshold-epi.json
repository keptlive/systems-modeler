{
  "id": "herd-immunity-threshold-epi",
  "name": "Herd Immunity Threshold Model",
  "description": "Model demonstrating the critical vaccination coverage needed to achieve herd immunity for infectious diseases with different R0 values. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 900,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-vaccinated",
      "name": "Vaccinated",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-infected",
      "name": "Infected",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-vaccinating",
      "name": "Vaccination_Rate",
      "equation": "Susceptible * Vaccination_Campaign",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-vaccinated",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-infecting",
      "name": "Infection_Rate",
      "equation": "Susceptible * Infected * R0 / (Population * Infectious_Period)",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-infected",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "flow-recovering",
      "name": "Recovery_Rate",
      "equation": "Infected / Infectious_Period",
      "from_stock": "stock-infected",
      "to_stock": "stock-recovered",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-r0",
      "name": "R0",
      "equation": "3",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-period",
      "name": "Infectious_Period",
      "equation": "7",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-campaign",
      "name": "Vaccination_Campaign",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-pop",
      "name": "Population",
      "equation": "1001",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Susceptible",
      "to_element": "Vaccination_Rate"
    },
    {
      "id": "c2",
      "from_element": "Vaccination_Campaign",
      "to_element": "Vaccination_Rate"
    },
    {
      "id": "c3",
      "from_element": "Susceptible",
      "to_element": "Infection_Rate"
    },
    {
      "id": "c4",
      "from_element": "Infected",
      "to_element": "Infection_Rate"
    },
    {
      "id": "c5",
      "from_element": "R0",
      "to_element": "Infection_Rate"
    },
    {
      "id": "c6",
      "from_element": "Population",
      "to_element": "Infection_Rate"
    },
    {
      "id": "c7",
      "from_element": "Infectious_Period",
      "to_element": "Infection_Rate"
    },
    {
      "id": "c8",
      "from_element": "Infected",
      "to_element": "Recovery_Rate"
    },
    {
      "id": "c9",
      "from_element": "Infectious_Period",
      "to_element": "Recovery_Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "created_at": "2026-01-12T11:47:36.905328Z",
  "updated_at": "2026-01-12T11:47:36.905331Z",
  "source": "https://doi.org/10.1093/cid/cir007",
  "reference": "Fine P, Eames K, Heymann DL. Herd Immunity: A Rough Guide. Clinical Infectious Diseases. 2011;52(7):911-916."
}