{
  "id": "covid-19-seir-model-with-vaccination-epi",
  "name": "COVID-19 SEIR Model with Vaccination",
  "description": "Extended COVID-19 model incorporating vaccination dynamics, waning immunity, and variant effects. Models the transition from pandemic to endemic state. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "stock-susceptible-unvaccinated",
      "name": "Susceptible Unvaccinated",
      "initial_value": 50000000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-susceptible-vaccinated",
      "name": "Susceptible Vaccinated",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-exposed",
      "name": "Exposed",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-infectious",
      "name": "Infectious",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 750,
        "y": 200
      }
    },
    {
      "id": "stock-recovered-natural-immunity",
      "name": "Recovered Natural Immunity",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "stock-recovered-hybrid-immunity",
      "name": "Recovered Hybrid Immunity",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "stock-deceased",
      "name": "Deceased",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "stock-cumulative-vaccinations",
      "name": "Cumulative Vaccinations",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 750,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infection-unvaccinated",
      "name": "Infection Unvaccinated",
      "equation": "Beta * Susceptible_Unvaccinated * Infectious / Total_Population",
      "from_stock": "stock-susceptible-unvaccinated",
      "to_stock": "stock-exposed",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-infection-vaccinated",
      "name": "Infection Vaccinated",
      "equation": "Beta * Susceptible_Vaccinated * Infectious / Total_Population * (1 - Vaccine_Efficacy_Infection)",
      "from_stock": "stock-susceptible-vaccinated",
      "to_stock": "stock-exposed",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-vaccination",
      "name": "Vaccination",
      "equation": "MIN(Susceptible_Unvaccinated, Vaccination_Rate)",
      "from_stock": "stock-susceptible-unvaccinated",
      "to_stock": "stock-cumulative-vaccinations",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-booster-vaccination",
      "name": "Booster Vaccination",
      "equation": "MIN(Susceptible_Vaccinated * Booster_Eligibility_Fraction, Booster_Rate)",
      "from_stock": "stock-susceptible-vaccinated",
      "to_stock": "stock-cumulative-vaccinations",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-waning-natural-immunity",
      "name": "Waning Natural Immunity",
      "equation": "Recovered_Natural / Natural_Immunity_Duration",
      "from_stock": "stock-recovered-natural-immunity",
      "to_stock": "stock-susceptible-unvaccinated",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "flow-waning-vaccine-immunity",
      "name": "Waning Vaccine Immunity",
      "equation": "Recovered_Hybrid / Vaccine_Immunity_Duration",
      "from_stock": "stock-recovered-hybrid-immunity",
      "to_stock": "stock-susceptible-vaccinated",
      "position": {
        "x": 650,
        "y": 350
      }
    }
  ],
  "variables": [
