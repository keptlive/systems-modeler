{
  "id": "kermack-mckendrick-threshold-epi",
  "name": "Kermack-McKendrick Epidemic Threshold Model",
  "description": "Original 1927 model establishing the epidemic threshold theorem - epidemics only occur when R0 > 1. Reference: Kermack, W. O., & McKendrick, A. G. (1927). A contribution to the mathematical theory of epidemics. Proceedings of the Royal Society A, 115(772), 700-721. DOI: https://doi.org/10.1098/rspa.1927.0118",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 990,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Infectious",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Removed",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Infection",
      "equation": "Beta * Susceptible * Infectious / Total_Population",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Removal",
      "equation": "Gamma * Infectious",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Beta",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Gamma",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Total_Population",
      "equation": "Susceptible + Infectious + Removed",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v4",
      "name": "R0",
      "equation": "Beta / Gamma",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Effective_R",
      "equation": "R0 * Susceptible / Total_Population",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.1,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:20:56.316207+00:00",
  "updated_at": "2026-01-12T11:20:56.316207+00:00",
  "source": "https://doi.org/10.1098/rspa.1927.0118",
  "reference": "Kermack WO, McKendrick AG. A contribution to the mathematical theory of epidemics. Proc R Soc Lond A. 1927;115(772):700-721."
}