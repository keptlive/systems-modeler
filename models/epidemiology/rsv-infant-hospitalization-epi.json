{
  "id": "rsv-infant-hospitalization-epi",
  "name": "RSV Infant Hospitalization Model",
  "description": "Model of Respiratory Syncytial Virus (RSV) seasonal dynamics and pediatric hospitalizations. RSV is the leading cause of infant hospitalization. Source: Glezen et al. (1986). NEJM. DOI: 10.1056/NEJM198601023140104",
  "stocks": [
    {"id": "stock-susceptible", "name": "Susceptible_Infants", "initial_value": 10000, "equation": "", "position": {"x": 100, "y": 200}},
    {"id": "stock-infected", "name": "Infected", "initial_value": 100, "equation": "", "position": {"x": 300, "y": 200}},
    {"id": "stock-hospitalized", "name": "Hospitalized", "initial_value": 10, "equation": "", "position": {"x": 300, "y": 350}},
    {"id": "stock-recovered", "name": "Recovered", "initial_value": 0, "equation": "", "position": {"x": 500, "y": 200}}
  ],
  "flows": [
    {"id": "flow-infection", "name": "Infection_Rate", "equation": "Beta * Susceptible_Infants * Infected / Total_Pop * Seasonal_Factor", "from_stock": "stock-susceptible", "to_stock": "stock-infected", "position": {"x": 200, "y": 200}},
    {"id": "flow-hospitalization", "name": "Hospitalization_Rate", "equation": "Infected * Hospitalization_Fraction / Onset_To_Hospital", "from_stock": "stock-infected", "to_stock": "stock-hospitalized", "position": {"x": 200, "y": 275}},
    {"id": "flow-recovery-inf", "name": "Community_Recovery", "equation": "Infected * (1 - Hospitalization_Fraction) / Infectious_Period", "from_stock": "stock-infected", "to_stock": "stock-recovered", "position": {"x": 400, "y": 200}},
    {"id": "flow-recovery-hosp", "name": "Hospital_Discharge", "equation": "Hospitalized / Hospital_Stay", "from_stock": "stock-hospitalized", "to_stock": "stock-recovered", "position": {"x": 400, "y": 350}}
  ],
  "variables": [
    {"id": "var-beta", "name": "Beta", "equation": "0.5", "position": {"x": 150, "y": 100}},
    {"id": "var-seasonal", "name": "Seasonal_Factor", "equation": "1 + 0.8 * COS(6.28 * (TIME - 0) / 52)", "position": {"x": 300, "y": 100}},
    {"id": "var-total", "name": "Total_Pop", "equation": "Susceptible_Infants + Infected + Hospitalized + Recovered", "position": {"x": 450, "y": 100}},
    {"id": "var-hosp-frac", "name": "Hospitalization_Fraction", "equation": "0.03", "position": {"x": 150, "y": 350}},
    {"id": "var-onset-hosp", "name": "Onset_To_Hospital", "equation": "3", "position": {"x": 250, "y": 400}},
    {"id": "var-infectious", "name": "Infectious_Period", "equation": "10", "position": {"x": 350, "y": 300}},
    {"id": "var-hosp-stay", "name": "Hospital_Stay", "equation": "4", "position": {"x": 450, "y": 400}},
    {"id": "var-r0", "name": "R0", "equation": "Beta * Infectious_Period", "position": {"x": 500, "y": 50}},
    {"id": "var-icu-need", "name": "ICU_Need", "equation": "Hospitalized * 0.15", "position": {"x": 400, "y": 450}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 104, "dt": 0.5},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1056/NEJM198601023140104",
  "reference": "Glezen, W.P. et al. (1986). Risk of primary infection and reinfection with respiratory syncytial virus. American Journal of Diseases of Children, 140, 543-546."
}
