{
  "id": "covid19-superspreading-k-epi",
  "name": "COVID-19 Superspreading (Dispersion k Parameter)",
  "description": "Model of COVID-19 transmission heterogeneity accounting for superspreading events. The dispersion parameter k quantifies individual variation in secondary infections. Low k indicates higher superspreading potential. Based on epidemiological analysis of early COVID-19 clusters. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 99999,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Exposed",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Infectious",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s5",
      "name": "Cumulative_Secondary_Infections",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 325,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Exposure",
      "equation": "Beta * Susceptible * Infectious / Population * Overdispersion_Factor",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Infection_Onset",
      "equation": "Exposed / Latent_Period",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Recovery",
      "equation": "Infectious / Infectious_Period",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "New_Secondary_Cases",
      "equation": "Exposure",
      "from_stock": null,
      "to_stock": "s5",
      "position": {
        "x": 325,
        "y": 280
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Population",
      "equation": "100000",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "v2",
      "name": "Beta",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "v3",
      "name": "Latent_Period",
      "equation": "5.2",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "v4",
      "name": "Infectious_Period",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "v5",
      "name": "Dispersion_k",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "v6",
      "name": "Overdispersion_Factor",
      "equation": "1 + 1/Dispersion_k",
      "position": {
        "x": 200,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "R0",
      "equation": "Beta * Infectious_Period",
      "position": {
        "x": 400,
        "y": 130
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 180,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1038/s41591-020-1092-0",
  "reference": "Endo A, et al. (2020) Estimating the overdispersion in COVID-19 transmission using outbreak sizes outside China. Wellcome Open Research.",
