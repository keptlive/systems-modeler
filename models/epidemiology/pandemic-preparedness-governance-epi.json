{
  "id": "pandemic-preparedness-governance-epi",
  "name": "Pandemic Preparedness and Governance Model",
  "description": "Models the dynamics of pandemic preparedness including surveillance systems, stockpiles, healthcare surge capacity, and the cycle of attention and funding following outbreaks. Based on WHO pandemic preparedness frameworks.",
  "source": "https://doi.org/10.1016/S0140-6736(21)01807-1",
  "reference": "Independent Panel for Pandemic Preparedness and Response. COVID-19: Make it the Last Pandemic. WHO. 2021. Global Health Security Index.",
  "stocks": [
    {"id": "stock-preparedness", "name": "Preparedness Level", "initial_value": 50, "equation": "", "position": {"x": 100, "y": 150}},
    {"id": "stock-stockpiles", "name": "Medical Stockpiles", "initial_value": 1000000, "equation": "", "position": {"x": 300, "y": 100}},
    {"id": "stock-surge-capacity", "name": "Surge Capacity", "initial_value": 10000, "equation": "", "position": {"x": 300, "y": 250}},
    {"id": "stock-funding", "name": "Preparedness Funding", "initial_value": 5000000000, "equation": "", "position": {"x": 500, "y": 150}},
    {"id": "stock-attention", "name": "Public Attention", "initial_value": 20, "equation": "", "position": {"x": 500, "y": 300}}
  ],
  "flows": [
    {"id": "flow-prep-improvement", "name": "Preparedness Improvement", "equation": "Preparedness_Investment_Effect * (1 - Preparedness_Level / 100)", "from_stock": null, "to_stock": "stock-preparedness", "position": {"x": 100, "y": 100}},
    {"id": "flow-prep-decay", "name": "Preparedness Decay", "equation": "Preparedness_Level * Decay_Rate * (1 - Public_Attention / 100)", "from_stock": "stock-preparedness", "to_stock": null, "position": {"x": 100, "y": 200}},
    {"id": "flow-stockpile-build", "name": "Stockpile Building", "equation": "Preparedness_Funding * Stockpile_Allocation / Unit_Cost", "from_stock": null, "to_stock": "stock-stockpiles", "position": {"x": 200, "y": 100}},
    {"id": "flow-stockpile-expiry", "name": "Stockpile Expiry", "equation": "Medical_Stockpiles / Shelf_Life", "from_stock": "stock-stockpiles", "to_stock": null, "position": {"x": 400, "y": 100}},
    {"id": "flow-capacity-build", "name": "Capacity Building", "equation": "Preparedness_Funding * Capacity_Allocation / Capacity_Cost", "from_stock": null, "to_stock": "stock-surge-capacity", "position": {"x": 200, "y": 250}},
    {"id": "flow-capacity-decay", "name": "Capacity Decay", "equation": "Surge_Capacity * Capacity_Decay_Rate", "from_stock": "stock-surge-capacity", "to_stock": null, "position": {"x": 400, "y": 250}},
    {"id": "flow-funding-change", "name": "Funding Change", "equation": "(Target_Funding - Preparedness_Funding) / Funding_Adjustment_Time", "from_stock": null, "to_stock": "stock-funding", "position": {"x": 500, "y": 100}},
    {"id": "flow-attention-decay", "name": "Attention Decay", "equation": "Public_Attention * Attention_Decay_Rate", "from_stock": "stock-attention", "to_stock": null, "position": {"x": 500, "y": 350}}
  ],
  "variables": [
    {"id": "var-invest-effect", "name": "Preparedness_Investment_Effect", "equation": "Preparedness_Funding / 1000000000", "position": {"x": 50, "y": 100}},
    {"id": "var-decay", "name": "Decay_Rate", "equation": "0.05", "position": {"x": 50, "y": 200}},
    {"id": "var-stockpile-alloc", "name": "Stockpile_Allocation", "equation": "0.3", "position": {"x": 200, "y": 50}},
    {"id": "var-unit-cost", "name": "Unit_Cost", "equation": "100", "position": {"x": 300, "y": 50}},
    {"id": "var-shelf-life", "name": "Shelf_Life", "equation": "60", "position": {"x": 400, "y": 50}},
    {"id": "var-capacity-alloc", "name": "Capacity_Allocation", "equation": "0.4", "position": {"x": 200, "y": 300}},
    {"id": "var-capacity-cost", "name": "Capacity_Cost", "equation": "100000", "position": {"x": 300, "y": 300}},
    {"id": "var-capacity-decay", "name": "Capacity_Decay_Rate", "equation": "0.02", "position": {"x": 400, "y": 300}},
    {"id": "var-target-funding", "name": "Target_Funding", "equation": "2000000000 + Public_Attention * 200000000", "position": {"x": 600, "y": 100}},
    {"id": "var-funding-adj", "name": "Funding_Adjustment_Time", "equation": "24", "position": {"x": 600, "y": 150}},
    {"id": "var-attention-decay", "name": "Attention_Decay_Rate", "equation": "0.1", "position": {"x": 600, "y": 350}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 520, "dt": 1},
  "created_at": "2026-01-15T21:00:00.000000+00:00",
  "updated_at": "2026-01-15T21:00:00.000000+00:00"
}
