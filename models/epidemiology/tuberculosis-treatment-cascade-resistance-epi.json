{
  "id": "tuberculosis-treatment-cascade-resistance-epi",
  "name": "Tuberculosis Treatment Cascade and Drug Resistance",
  "description": "Model of TB treatment pathway with latent/active TB, drug-sensitive and multi-drug resistant strains. Based on WHO TB reports. Reference: Andersson, D. I., & Hughes, D. (2014). Microbiological effects of sublethal antibiotic concentrations. Nature Reviews Microbiology. Source: https://doi.org/10.1038/nrmicro3270",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 990000,
      "equation": "",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Latent TB",
      "initial_value": 8000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Active DS TB",
      "initial_value": 1500,
      "equation": "",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "s4",
      "name": "Active MDR TB",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "s5",
      "name": "On DS Treatment",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "s6",
      "name": "On MDR Treatment",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "s7",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Infection",
      "equation": "Susceptible * (Active_DS_TB * Beta_DS + Active_MDR_TB * Beta_MDR) / Total_Pop",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 125,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "DS Activation",
      "equation": "Latent_TB * DS_Activation_Rate",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 275,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "MDR Activation",
      "equation": "Latent_TB * MDR_Activation_Rate",
      "from_stock": "s2",
      "to_stock": "s4",
      "position": {
        "x": 275,
        "y": 250
      }
    },
    {
      "id": "f4",
      "name": "DS Treatment Start",
      "equation": "Active_DS_TB * DS_Detection_Rate",
      "from_stock": "s3",
      "to_stock": "s5",
      "position": {
        "x": 425,
        "y": 100
      }
    },
    {
      "id": "f5",
      "name": "MDR Treatment Start",
      "equation": "Active_MDR_TB * MDR_Detection_Rate",
      "from_stock": "s4",
      "to_stock": "s6",
      "position": {
        "x": 425,
        "y": 300
      }
    },
    {
      "id": "f6",
      "name": "DS Treatment Success",
      "equation": "On_DS_Treatment * DS_Cure_Rate",
      "from_stock": "s5",
      "to_stock": "s7",
      "position": {
        "x": 575,
        "y": 150
      }
    },
    {
      "id": "f7",
      "name": "MDR Treatment Success",
      "equation": "On_MDR_Treatment * MDR_Cure_Rate",
      "from_stock": "s6",
      "to_stock": "s7",
      "position": {
        "x": 575,
        "y": 250
      }
    },
    {
      "id": "f8",
      "name": "DS to MDR Conversion",
      "equation": "On_DS_Treatment * Resistance_Development_Rate",
      "from_stock": "s5",
      "to_stock": "s4",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f9",
      "name": "DS Treatment Failure",
      "equation": "On_DS_Treatment * DS_Failure_Rate",
      "from_stock": "s5",
      "to_stock": "s3",
      "position": {
        "x": 425,
        "y": 50
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Beta DS",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Beta MDR",
      "equation": "8",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "v3",
      "name": "DS Activation Rate",
      "equation": "0.05",
      "position": {
        "x": 275,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "MDR Activation Rate",
      "equation": "0.05",
      "position": {
        "x": 275,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "DS Detection Rate",
      "equation": "0.7",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "MDR Detection Rate",
      "equation": "0.4",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "DS Cure Rate",
      "equation": "0.85 / 6",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v8",
      "name": "MDR Cure Rate",
      "equation": "0.55 / 24",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "DS Failure Rate",
      "equation": "0.05 / 6",
      "position": {
        "x": 475,
        "y": 50
      }
    },
    {
      "id": "v10",
      "name": "Resistance Development Rate",
      "equation": "0.03",
      "position": {
        "x": 475,
        "y": 250
      }
    },
    {
      "id": "v11",
      "name": "Total Pop",
      "equation": "Susceptible + Latent_TB + Active_DS_TB + Active_MDR_TB + On_DS_Treatment + On_MDR_Treatment + Recovered",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "v12",
      "name": "MDR Fraction",
      "equation": "(Active_MDR_TB + On_MDR_Treatment) / (Active_DS_TB + Active_MDR_TB + On_DS_Treatment + On_MDR_Treatment + 1)",
      "position": {
        "x": 500,
        "y": 400
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Active DS TB",
      "to_element": "Infection"
    },
    {
      "id": "c2",
      "from_element": "Active MDR TB",
      "to_element": "Infection"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 120,
    "dt": 1
  },
