{
  "id": "covid19-school-reopening-epi",
  "name": "COVID-19 School Reopening Model",
  "description": "Models COVID-19 transmission dynamics in schools and community with various mitigation strategies. Based on Paltiel et al. (2020). DOI: 10.1001/jamanetworkopen.2020.16818",
  "stocks": [
    {
      "id": "stock-students",
      "name": "Susceptible_Students",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "stock-infstud",
      "name": "Infected_Students",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-staff",
      "name": "Susceptible_Staff",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "stock-infstaff",
      "name": "Infected_Staff",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "stock-community",
      "name": "Community_Infections",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 500,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-studtrans",
      "name": "Student_Transmission",
      "equation": "Beta_School * Susceptible_Students * Infected_Students / Total_School * Mask_Effect * Ventilation_Effect",
      "from_stock": "stock-students",
      "to_stock": "stock-infstud",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-stafftrans",
      "name": "Staff_Transmission",
      "equation": "Beta_School * Susceptible_Staff * (Infected_Students + Infected_Staff) / Total_School * Mask_Effect * Ventilation_Effect",
      "from_stock": "stock-staff",
      "to_stock": "stock-infstaff",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "flow-commtrans",
      "name": "Community_Spillover",
      "equation": "(Infected_Students + Infected_Staff) * Community_Contact_Rate",
      "from_stock": null,
      "to_stock": "stock-community",
      "position": {
        "x": 400,
        "y": 175
      }
    },
    {
      "id": "flow-studrecov",
      "name": "Student_Recovery",
      "equation": "Infected_Students / Recovery_Time",
      "from_stock": "stock-infstud",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-staffrecov",
      "name": "Staff_Recovery",
      "equation": "Infected_Staff / Recovery_Time",
      "from_stock": "stock-infstaff",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-betaschool",
      "name": "Beta_School",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-maskeff",
      "name": "Mask_Effect",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-venteff",
      "name": "Ventilation_Effect",
      "equation": "0.7",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-totschool",
      "name": "Total_School",
      "equation": "Susceptible_Students + Infected_Students + Susceptible_Staff + Infected_Staff",
      "position": {
        "x": 100,
        "y": 175
      }
    },
    {
      "id": "var-commrate",
      "name": "Community_Contact_Rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-rectime",
      "name": "Recovery_Time",
      "equation": "10",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "var-r0school",
      "name": "R0_School",
      "equation": "Beta_School * Recovery_Time * Mask_Effect * Ventilation_Effect * Total_School / (Susceptible_Students + Susceptible_Staff + 1)",
      "position": {
        "x": 200,
        "y": 325
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Susceptible_Students",
      "to_element": "Student_Transmission"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 180,
    "dt": 1
  },
  "created_at": "2026-01-12T02:45:00.574838+00:00",
  "updated_at": "2026-01-12T02:45:00.574841+00:00",
  "source": "https://doi.org/10.1001/jamanetworkopen.2020.16818",
  "reference": "Paltiel AD, et al. (2020). Assessment of SARS-CoV-2 Screening Strategies to Permit the Safe Reopening of College Campuses. JAMA Network Open."
}