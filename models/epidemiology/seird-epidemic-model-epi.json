{
  "id": "seird-epidemic-model-epi",
  "name": "SEIRD Epidemic Model",
  "description": "Susceptible-Exposed-Infectious-Recovered-Dead compartmental model. Includes incubation period critical for diseases like COVID-19 with 14-day incubation. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 999000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-exposed",
      "name": "Exposed",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-infectious",
      "name": "Infectious",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-deceased",
      "name": "Deceased",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-exposure",
      "name": "Exposure",
      "equation": "Beta * Susceptible * Infectious / Total_Population",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-exposed",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-infection",
      "name": "Becoming Infectious",
      "equation": "Exposed / Incubation_Period",
      "from_stock": "stock-exposed",
      "to_stock": "stock-infectious",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-recovery",
      "name": "Recovery",
      "equation": "Infectious * (1 - Infection_Fatality_Rate) / Infectious_Period",
      "from_stock": "stock-infectious",
      "to_stock": "stock-recovered",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-death",
      "name": "Death",
      "equation": "Infectious * Infection_Fatality_Rate / Infectious_Period",
      "from_stock": "stock-infectious",
      "to_stock": "stock-deceased",
      "position": {
        "x": 475,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "R0 / Infectious_Period",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-r0",
      "name": "R0",
      "equation": "2.5",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-incubation",
      "name": "Incubation Period",
      "equation": "5.2",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-infectious-period",
      "name": "Infectious Period",
      "equation": "7",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-ifr",
      "name": "Infection Fatality Rate",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-total-pop",
      "name": "Total Population",
      "equation": "1000000",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-r-eff",
      "name": "Effective R",
      "equation": "R0 * Susceptible / Total_Population",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1016/j.jeconom.2020.07.038",
  "reference": "Identification and estimation of the SEIRD epidemic model for COVID-19. Journal of Econometrics (2020).",
  "created_at": "2026-01-12T08:11:11.789037+00:00",
  "updated_at": "2026-01-12T08:11:11.789037+00:00"
}