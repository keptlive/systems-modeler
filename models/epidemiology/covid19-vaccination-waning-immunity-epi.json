{
  "id": "covid19-vaccination-waning-immunity-epi",
  "name": "COVID-19 Vaccination with Waning Immunity Model",
  "description": "SEIRS model with vaccination and waning immunity to model booster needs. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 70000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Vaccinated",
      "initial_value": 20000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "s3",
      "name": "Exposed",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Infected",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s5",
      "name": "Recovered",
      "initial_value": 9100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Vaccination",
      "equation": "Vaccination_Rate * Susceptible",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 100,
        "y": 275
      }
    },
    {
      "id": "f2",
      "name": "S_Infection",
      "equation": "Beta * Susceptible * Infected / Total_Pop",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "V_Infection",
      "equation": "Beta * (1 - Vaccine_Efficacy) * Vaccinated * Infected / Total_Pop",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 175,
        "y": 350
      }
    },
    {
      "id": "f4",
      "name": "Incubation",
      "equation": "Exposed / Latent_Period",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Recovery",
      "equation": "Infected / Infectious_Period",
      "from_stock": "s4",
      "to_stock": "s5",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Immunity_Waning",
      "equation": "Recovered / Immunity_Duration",
      "from_stock": "s5",
      "to_stock": "s1",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "f7",
      "name": "Vaccine_Waning",
      "equation": "Vaccinated / Vaccine_Duration",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Beta",
      "equation": "0.4",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Latent_Period",
      "equation": "5",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Infectious_Period",
      "equation": "7",
      "position": {
        "x": 475,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Vaccination_Rate",
      "equation": "0.005",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "v5",
      "name": "Vaccine_Efficacy",
      "equation": "0.85",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Immunity_Duration",
      "equation": "180",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Vaccine_Duration",
      "equation": "180",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Total_Pop",
      "equation": "Susceptible + Vaccinated + Exposed + Infected + Recovered",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 730,
    "dt": 0.5,
    "integration_method": "euler"
  },
