{
  "id": "covid19-behavioral-fatigue-epi",
  "name": "COVID-19 Behavioral Fatigue Model",
  "description": "Models compliance decline with prolonged pandemic measures. Source: Petherick et al. (2021), Nature Human Behaviour. DOI: 10.1038/s41562-021-01181-x",
  "stocks": [
    {
      "id": "stock-compliance",
      "name": "Compliance_Level",
      "initial_value": 90,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-fatigue",
      "name": "Behavioral_Fatigue",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "stock-cases",
      "name": "Active_Cases",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-restore",
      "name": "Compliance_Restoration",
      "equation": "(Risk_Perception - Behavioral_Fatigue) * Restoration_Rate * (100 - Compliance_Level) / 100",
      "from_stock": null,
      "to_stock": "stock-compliance",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "flow-decline",
      "name": "Compliance_Decline",
      "equation": "Compliance_Level * Fatigue_Effect * 0.01",
      "from_stock": "stock-compliance",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-fatbuild",
      "name": "Fatigue_Buildup",
      "equation": "Restriction_Intensity * Duration_Effect * (100 - Behavioral_Fatigue) / 100",
      "from_stock": null,
      "to_stock": "stock-fatigue",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "flow-fatdecay",
      "name": "Fatigue_Decay",
      "equation": "Behavioral_Fatigue * Recovery_Rate",
      "from_stock": "stock-fatigue",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "flow-casechg",
      "name": "Case_Change",
      "equation": "Active_Cases * (Transmission_Rate * (1 - Compliance_Level * Measure_Effectiveness / 100) - Recovery_Rate_Disease)",
      "from_stock": null,
      "to_stock": "stock-cases",
      "position": {
        "x": 300,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-riskperc",
      "name": "Risk_Perception",
      "equation": "MIN(100, Active_Cases / 100)",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-restrate",
      "name": "Restoration_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-fateff",
      "name": "Fatigue_Effect",
      "equation": "Behavioral_Fatigue / 50",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-restrict",
      "name": "Restriction_Intensity",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-duration",
      "name": "Duration_Effect",
      "equation": "1 + TIME / 100",
      "position": {
        "x": 200,
        "y": 325
      }
    },
    {
      "id": "var-recrate",
      "name": "Recovery_Rate",
      "equation": "0.02",
      "position": {
        "x": 350,
        "y": 325
      }
    },
    {
      "id": "var-transrate",
      "name": "Transmission_Rate",
      "equation": "0.15",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-measeff",
      "name": "Measure_Effectiveness",
      "equation": "0.7",
      "position": {
        "x": 450,
        "y": 175
      }
    },
    {
      "id": "var-recdis",
      "name": "Recovery_Rate_Disease",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Behavioral_Fatigue",
      "to_element": "Compliance_Decline"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "created_at": "2026-01-12T02:17:16.213936+00:00",
  "updated_at": "2026-01-12T02:17:16.213989+00:00",
  "source": "https://doi.org/10.1038/s41562-021-01181-x",
  "reference": "Petherick, A. et al. (2021). A worldwide assessment of changes in adherence to COVID-19 protective behaviours. Nature Human Behaviour."
}