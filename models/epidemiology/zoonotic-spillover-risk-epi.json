{
  "id": "zoonotic-spillover-risk-epi",
  "name": "Zoonotic Spillover Risk Model",
  "description": "Model of zoonotic disease emergence risk from human-wildlife interface expansion. Based on Jones et al. (2008) and pandemic preparedness research. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Wildlife Habitat",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Human Wildlife Interface",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Spillover Events",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Habitat Loss",
      "equation": "Wildlife_Habitat * Deforestation_Rate",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Interface Expansion",
      "equation": "Habitat_Loss * Interface_Fraction + Agricultural_Expansion",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "New Spillovers",
      "equation": "Human_Wildlife_Interface * Wildlife_Diversity * Spillover_Rate",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Deforestation Rate",
      "equation": "0.01",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Interface Fraction",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Agricultural Expansion",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Wildlife Diversity",
      "equation": "Wildlife_Habitat / 100",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v5",
      "name": "Spillover Rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Pandemic Risk Index",
      "equation": "Spillover_Events * Human_Wildlife_Interface / 100",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Surveillance Capacity",
      "equation": "0.3",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Detected Spillovers",
      "equation": "Spillover_Events * Surveillance_Capacity",
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Wildlife Habitat",
      "to_element": "Habitat Loss"
    },
    {
      "id": "c2",
      "from_element": "Human Wildlife Interface",
      "to_element": "New Spillovers"
    },
    {
      "id": "c3",
      "from_element": "Wildlife Diversity",
      "to_element": "New Spillovers"
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "created_at": "2026-01-12T01:55:42.037555+00:00",
  "updated_at": "2026-01-12T01:55:42.037560+00:00",
  "source": "https://doi.org/10.1038/nature06536",
  "reference": "Jones KE, et al. Global trends in emerging infectious diseases. Nature. 2008;451:990-993."
}