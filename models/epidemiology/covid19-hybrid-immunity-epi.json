{
  "id": "covid19-hybrid-immunity-epi",
  "name": "COVID-19 Hybrid Immunity Model",
  "description": "Model of hybrid immunity from combined vaccination and natural infection, showing enhanced protection compared to either alone. Source: Bobrovitz et al. (2023). The Lancet Infectious Diseases. DOI: 10.1016/S1473-3099(22)00801-5",
  "stocks": [
    {"id": "stock-naive", "name": "Naive", "initial_value": 200000, "equation": "", "position": {"x": 100, "y": 100}},
    {"id": "stock-vax", "name": "Vaccinated_Only", "initial_value": 400000, "equation": "", "position": {"x": 100, "y": 250}},
    {"id": "stock-natural", "name": "Natural_Immunity", "initial_value": 200000, "equation": "", "position": {"x": 100, "y": 400}},
    {"id": "stock-hybrid", "name": "Hybrid_Immunity", "initial_value": 100000, "equation": "", "position": {"x": 300, "y": 325}},
    {"id": "stock-infected", "name": "Currently_Infected", "initial_value": 100, "equation": "", "position": {"x": 450, "y": 200}}
  ],
  "flows": [
    {"id": "flow-naive-vax", "name": "Naive_Vaccination", "equation": "Naive * Vaccination_Rate", "from_stock": "stock-naive", "to_stock": "stock-vax", "position": {"x": 50, "y": 175}},
    {"id": "flow-naive-infection", "name": "Naive_Infection", "equation": "Force_of_Infection * Naive", "from_stock": "stock-naive", "to_stock": "stock-infected", "position": {"x": 275, "y": 100}},
    {"id": "flow-vax-infection", "name": "Vax_Breakthrough", "equation": "Force_of_Infection * Vaccinated_Only * Vax_Susceptibility", "from_stock": "stock-vax", "to_stock": "stock-infected", "position": {"x": 275, "y": 250}},
    {"id": "flow-recovery-natural", "name": "Recovery_To_Natural", "equation": "Currently_Infected * (1 - Fraction_Vaccinated) / Infectious_Period", "from_stock": "stock-infected", "to_stock": "stock-natural", "position": {"x": 400, "y": 350}},
    {"id": "flow-recovery-hybrid", "name": "Recovery_To_Hybrid", "equation": "Currently_Infected * Fraction_Vaccinated / Infectious_Period", "from_stock": "stock-infected", "to_stock": "stock-hybrid", "position": {"x": 400, "y": 275}}
  ],
  "variables": [
    {"id": "var-beta", "name": "Beta", "equation": "0.4", "position": {"x": 450, "y": 50}},
    {"id": "var-foi", "name": "Force_of_Infection", "equation": "Beta * Currently_Infected / Total_Pop", "position": {"x": 350, "y": 100}},
    {"id": "var-vax-rate", "name": "Vaccination_Rate", "equation": "0.002", "position": {"x": 50, "y": 100}},
    {"id": "var-vax-susc", "name": "Vax_Susceptibility", "equation": "0.3", "position": {"x": 200, "y": 200}},
    {"id": "var-hybrid-susc", "name": "Hybrid_Susceptibility", "equation": "0.1", "position": {"x": 350, "y": 400}},
    {"id": "var-infectious", "name": "Infectious_Period", "equation": "7", "position": {"x": 500, "y": 100}},
    {"id": "var-frac-vax", "name": "Fraction_Vaccinated", "equation": "0.6", "position": {"x": 500, "y": 275}},
    {"id": "var-total", "name": "Total_Pop", "equation": "Naive + Vaccinated_Only + Natural_Immunity + Hybrid_Immunity + Currently_Infected", "position": {"x": 300, "y": 450}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 365, "dt": 0.5},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1016/S1473-3099(22)00801-5",
  "reference": "Bobrovitz, N. et al. (2023). Protective effectiveness of previous SARS-CoV-2 infection and hybrid immunity against the omicron variant and severe disease. The Lancet Infectious Diseases, 23(5), 556-567."
}
