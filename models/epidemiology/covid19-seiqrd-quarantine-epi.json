{
  "id": "covid19-seiqrd-quarantine-epi",
  "name": "COVID-19 SEIQRD with Quarantine",
  "description": "Extended SEIR model for COVID-19 with Quarantine and Death compartments. Based on pandemic modeling approaches published in 2020. Models exposed, infectious, quarantined, recovered, and deceased populations with public health interventions. Source: Various COVID-19 modeling papers, e.g., Giordano et al. (2020), Nature Medicine. DOI: 10.1038/s41591-020-0883-7",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 999000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-exposed",
      "name": "Exposed",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-infectious",
      "name": "Infectious",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-quarantined",
      "name": "Quarantined",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-deceased",
      "name": "Deceased",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-exposure",
      "name": "Exposure",
      "equation": "Beta * Susceptible * Infectious / Total_Population",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-exposed",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-infection",
      "name": "Infection",
      "equation": "Exposed / Incubation_Period",
      "from_stock": "stock-exposed",
      "to_stock": "stock-infectious",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-quarantine",
      "name": "Quarantine",
      "equation": "Infectious * Quarantine_Rate",
      "from_stock": "stock-infectious",
      "to_stock": "stock-quarantined",
      "position": {
        "x": 400,
        "y": 275
      }
    },
    {
      "id": "flow-recovery-i",
      "name": "Recovery_I",
      "equation": "Infectious * (1 - Case_Fatality_Rate) / Recovery_Time",
      "from_stock": "stock-infectious",
      "to_stock": "stock-recovered",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-recovery-q",
      "name": "Recovery_Q",
      "equation": "Quarantined * (1 - Case_Fatality_Rate) / Recovery_Time",
      "from_stock": "stock-quarantined",
      "to_stock": "stock-recovered",
      "position": {
        "x": 475,
        "y": 350
      }
    },
    {
      "id": "flow-death-i",
      "name": "Death_I",
      "equation": "Infectious * Case_Fatality_Rate / Recovery_Time",
      "from_stock": "stock-infectious",
      "to_stock": "stock-deceased",
      "position": {
        "x": 550,
        "y": 275
      }
    },
    {
      "id": "flow-death-q",
      "name": "Death_Q",
      "equation": "Quarantined * Case_Fatality_Rate / Recovery_Time",
      "from_stock": "stock-quarantined",
      "to_stock": "stock-deceased",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.4",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-incubation",
      "name": "Incubation_Period",
      "equation": "5.2",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-recovery-time",
      "name": "Recovery_Time",
      "equation": "14",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-quarantine-rate",
      "name": "Quarantine_Rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-cfr",
      "name": "Case_Fatality_Rate",
      "equation": "0.02",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-total-pop",
      "name": "Total_Population",
      "equation": "1000000",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Beta",
      "to_element": "Exposure"
    },
    {
      "id": "conn-2",
      "from_element": "Susceptible",
      "to_element": "Exposure"
    },
    {
      "id": "conn-3",
      "from_element": "Infectious",
      "to_element": "Exposure"
    },
    {
      "id": "conn-4",
      "from_element": "Total_Population",
      "to_element": "Exposure"
    },
    {
      "id": "conn-5",
      "from_element": "Exposed",
      "to_element": "Infection"
    },
    {
      "id": "conn-6",
      "from_element": "Incubation_Period",
      "to_element": "Infection"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.5
  },
  "created_at": "2026-01-11T20:47:58.493264Z",
  "updated_at": "2026-01-11T20:47:58.493264Z",
  "source": "https://doi.org/10.1016/j.chaos.2020.109889",
  "reference": "COVID-19 SEIR Models - Various Authors 2020-2022"
}