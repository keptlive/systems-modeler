{
  "id": "sd-fever-sir-model-epi",
  "name": "SD Fever SIR Model",
  "description": "A simple SIR epidemic model with cumulative case tracking. Models the spread of an infectious disease through a population with susceptible, infectious, and recovered compartments. Reference: WHO Disease Outbreak Information. Source: https://www.who.int/",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-infectious",
      "name": "Infectious",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-recovered",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-cumulative-cases",
      "name": "Cumulative Cases",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 750,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infect",
      "name": "Infect",
      "equation": "Susceptible * (Infectious / Total_Population) * Contact_Infectivity",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-infectious",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-recover",
      "name": "Recover",
      "equation": "Infectious / Recovery_Period",
      "from_stock": "stock-infectious",
      "to_stock": "stock-recovered",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-report-case",
      "name": "Report Case",
      "equation": "Infect",
      "from_stock": null,
      "to_stock": "stock-cumulative-cases",
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-total-population",
      "name": "Total Population",
      "equation": "1000",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-contact-infectivity",
      "name": "Contact Infectivity",
      "equation": "0.7",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-recovery-period",
      "name": "Recovery Period",
      "equation": "5",
      "position": {
        "x": 400,
        "y": 80
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-11T20:04:50.802954Z",
  "updated_at": "2026-01-11T20:04:50.802954Z",
  "source": "https://doi.org/10.1016/j.jtbi.2017.11.024",
  "reference": "Keeling MJ, Rohani P. Modeling Infectious Diseases in Humans and Animals. Princeton University Press, 2008."
}