{
  "id": "kermack-mckendrick-sir-1927-epi",
  "name": "Kermack-McKendrick SIR Model (1927)",
  "description": "The original mathematical model of infectious disease spread by Kermack and McKendrick. This foundational paper established the SIR framework and the concept of epidemic threshold (R0). Source: Kermack & McKendrick (1927), Proceedings of the Royal Society A. DOI: 10.1098/rspa.1927.0118",
  "stocks": [
    {
      "id": "stock-s",
      "name": "Susceptible",
      "initial_value": 999,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-i",
      "name": "Infected",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-r",
      "name": "Recovered",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infection",
      "name": "Infection_Rate",
      "equation": "Beta * Susceptible * Infected / Total_Population",
      "from_stock": "stock-s",
      "to_stock": "stock-i",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-recovery",
      "name": "Recovery_Rate",
      "equation": "Gamma * Infected",
      "from_stock": "stock-i",
      "to_stock": "stock-r",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.4",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-gamma",
      "name": "Gamma",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-total",
      "name": "Total_Population",
      "equation": "Susceptible + Infected + Recovered",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-r0",
      "name": "R0",
      "equation": "Beta / Gamma",
      "position": {
        "x": 300,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Susceptible",
      "to_element": "Infection_Rate"
    },
    {
      "id": "conn-2",
      "from_element": "Infected",
      "to_element": "Infection_Rate"
    },
    {
      "id": "conn-3",
      "from_element": "Beta",
      "to_element": "Infection_Rate"
    },
    {
      "id": "conn-4",
      "from_element": "Infected",
      "to_element": "Recovery_Rate"
    },
    {
      "id": "conn-5",
      "from_element": "Gamma",
      "to_element": "Recovery_Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.25
  },
  "created_at": "2026-01-11T22:11:19.082512Z",
  "updated_at": "2026-01-11T22:11:19.082656Z",
  "source": "https://doi.org/10.1098/rspa.1927.0118",
  "reference": "Kermack, W.O. & McKendrick, A.G. (1927). A contribution to the mathematical theory of epidemics."
}