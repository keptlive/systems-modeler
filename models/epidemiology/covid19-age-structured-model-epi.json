{
  "id": "covid19-age-structured-model-epi",
  "name": "COVID-19 Age-Structured SEIR Model",
  "description": "Age-structured COVID-19 model capturing differential susceptibility and severity by age group. Includes contact matrix effects and age-specific hospitalization. Source: Davies et al. (2020), Nature Medicine. DOI: 10.1038/s41591-020-0962-9",
  "stocks": [
    {
      "id": "stock-sy",
      "name": "Susceptible_Young",
      "initial_value": 400000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "stock-ey",
      "name": "Exposed_Young",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-iy",
      "name": "Infected_Young",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-ry",
      "name": "Recovered_Young",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "stock-so",
      "name": "Susceptible_Old",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "stock-eo",
      "name": "Exposed_Old",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "stock-io",
      "name": "Infected_Old",
      "initial_value": 25,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "stock-ro",
      "name": "Recovered_Old",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "stock-hosp",
      "name": "Hospitalized",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-expy",
      "name": "Exposure_Young",
      "equation": "Beta * Susceptible_Young * (Infected_Young + Cross_Contact * Infected_Old) / Total_Pop",
      "from_stock": "stock-sy",
      "to_stock": "stock-ey",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "flow-infy",
      "name": "Infection_Young",
      "equation": "Exposed_Young / Latent_Period",
      "from_stock": "stock-ey",
      "to_stock": "stock-iy",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-recy",
      "name": "Recovery_Young",
      "equation": "Infected_Young / Infectious_Period",
      "from_stock": "stock-iy",
      "to_stock": "stock-ry",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "flow-expo",
      "name": "Exposure_Old",
      "equation": "Beta * Susceptible_Old * (Infected_Old + Cross_Contact * Infected_Young) / Total_Pop",
      "from_stock": "stock-so",
      "to_stock": "stock-eo",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "flow-info",
      "name": "Infection_Old",
      "equation": "Exposed_Old / Latent_Period",
      "from_stock": "stock-eo",
      "to_stock": "stock-io",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "flow-reco",
      "name": "Recovery_Old",
      "equation": "Infected_Old * (1 - Hosp_Rate_Old) / Infectious_Period",
      "from_stock": "stock-io",
      "to_stock": "stock-ro",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "flow-hospadm",
      "name": "Hospitalization",
      "equation": "(Infected_Young * Hosp_Rate_Young + Infected_Old * Hosp_Rate_Old) / Infectious_Period",
      "from_stock": null,
      "to_stock": "stock-hosp",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-hospdis",
      "name": "Hospital_Discharge",
      "equation": "Hospitalized / Hospital_LOS",
      "from_stock": "stock-hosp",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-beta",
      "name": "Beta",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-cross",
      "name": "Cross_Contact",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-latent",
      "name": "Latent_Period",
      "equation": "5",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-infect",
      "name": "Infectious_Period",
      "equation": "7",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-hospry",
      "name": "Hosp_Rate_Young",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-hospro",
      "name": "Hosp_Rate_Old",
      "equation": "0.15",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-hosplos",
      "name": "Hospital_LOS",
      "equation": "10",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "var-total",
      "name": "Total_Pop",
      "equation": "Susceptible_Young + Exposed_Young + Infected_Young + Recovered_Young + Susceptible_Old + Exposed_Old + Infected_Old + Recovered_Old",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Susceptible_Young",
      "to_element": "Exposure_Young"
    },
    {
      "id": "conn-2",
      "from_element": "Infected_Young",
      "to_element": "Exposure_Young"
    },
    {
      "id": "conn-3",
      "from_element": "Infected_Old",
      "to_element": "Exposure_Young"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.5
  },
  "created_at": "2026-01-11T22:11:19.082723Z",
  "updated_at": "2026-01-11T22:11:19.082735Z",
  "source": "https://doi.org/10.1038/s41591-020-0962-9",
  "reference": "Davies, N.G. et al. (2020). Age-dependent effects in the transmission and control of COVID-19 epidemics."
}