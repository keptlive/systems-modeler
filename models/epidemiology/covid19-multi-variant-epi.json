      "to_stock": "stock-r",
      "position": {
        "x": 475,
        "y": 250
      }
    },
    {
      "id": "flow-vaccination",
      "name": "Vaccination",
      "equation": "Susceptible * Vaccination_Rate",
      "from_stock": "stock-s",
      "to_stock": "stock-v",
      "position": {
        "x": 100,
        "y": 275
      }
    },
    {
