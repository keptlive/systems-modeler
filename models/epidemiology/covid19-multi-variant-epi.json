{
  "id": "covid19-multi-variant-epi",
  "name": "COVID-19 Multi-Variant Dynamics Model",
  "description": "SEIR-based model for multiple strains of COVID-19 with optimal control. Includes wild-type and variant competition, cross-immunity, and vaccination effects. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "source": "https://doi.org/10.1371/journal.pone.0303791",
  "reference": "Akinyemi et al. (2024). A mathematical model of COVID-19 with multiple variants under optimal control in Ghana. PLoS ONE, 19(7), e0303791.",
  "stocks": [
