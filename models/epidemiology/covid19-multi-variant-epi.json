        "x": 100,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-exposure1",
      "name": "Exposure V1",
      "equation": "beta1 * Susceptible * Infectious_Variant_1 / N",
      "from_stock": "stock-s",
      "to_stock": "stock-e1",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "flow-exposure2",
      "name": "Exposure V2",
      "equation": "beta2 * Susceptible * Infectious_Variant_2 / N",
      "from_stock": "stock-s",
      "to_stock": "stock-e2",
      "position": {
        "x": 175,
        "y": 250
      }
    },
    {
      "id": "flow-infection1",
      "name": "Infection V1",
      "equation": "Exposed_Variant_1 / Latent_Period",
      "from_stock": "stock-e1",
      "to_stock": "stock-i1",
      "position": {
        "x": 325,
        "y": 150
      }
    },
    {
      "id": "flow-infection2",
      "name": "Infection V2",
      "equation": "Exposed_Variant_2 / Latent_Period",
      "from_stock": "stock-e2",
      "to_stock": "stock-i2",
      "position": {
        "x": 325,
        "y": 250
      }
    },
    {
      "id": "flow-recovery1",
      "name": "Recovery V1",
      "equation": "Infectious_Variant_1 * (1 - CFR1) / Infectious_Period",
      "from_stock": "stock-i1",
      "to_stock": "stock-r",
      "position": {
        "x": 475,
        "y": 150
      }
    },
    {
      "id": "flow-recovery2",
      "name": "Recovery V2",
      "equation": "Infectious_Variant_2 * (1 - CFR2) / Infectious_Period",
