{
  "id": "anderson-may-host-parasite-epi",
  "name": "Anderson-May Host-Parasite Population Dynamics",
  "description": "Roy Anderson and Robert May (1978) foundational model of host-parasite dynamics. Note: With default parameters, parasites over-exploit hosts causing extinction. Try the Coexistence version for stable dynamics.",
  "category": "epidemiology",
  "stocks": [
    {"id": "stock-host-population", "name": "Host Population", "initial_value": 1000, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-parasite-population", "name": "Parasite Population", "initial_value": 5000, "equation": "", "position": {"x": 500, "y": 200}}
  ],
  "flows": [
    {"id": "flow-host-births", "name": "Host Births", "equation": "Host_Birth_Rate * Host_Population", "from_stock": null, "to_stock": "stock-host-population", "position": {"x": 100, "y": 200}},
    {"id": "flow-host-deaths", "name": "Host Deaths", "equation": "(Host_Death_Rate + Alpha * Mean_Parasite_Burden) * Host_Population", "from_stock": "stock-host-population", "to_stock": null, "position": {"x": 300, "y": 200}},
    {"id": "flow-parasite-production", "name": "Parasite Production", "equation": "Lambda * Parasite_Population", "from_stock": null, "to_stock": "stock-parasite-population", "position": {"x": 400, "y": 200}},
    {"id": "flow-parasite-death", "name": "Parasite Death", "equation": "(Mu + Host_Death_Rate + Alpha * (K + 1) * Mean_Parasite_Burden / K) * Parasite_Population", "from_stock": "stock-parasite-population", "to_stock": null, "position": {"x": 600, "y": 200}}
  ],
  "variables": [
    {"id": "var-host-birth-rate", "name": "Host Birth Rate", "equation": "0.5", "position": {"x": 150, "y": 100}},
    {"id": "var-host-death-rate", "name": "Host Death Rate", "equation": "0.1", "position": {"x": 300, "y": 100}},
    {"id": "var-alpha", "name": "Alpha", "equation": "0.001", "position": {"x": 450, "y": 100}},
    {"id": "var-mean-parasite-burden", "name": "Mean Parasite Burden", "equation": "Parasite_Population / max(Host_Population, 0.001)", "position": {"x": 600, "y": 100}},
    {"id": "var-lambda", "name": "Lambda", "equation": "10", "position": {"x": 150, "y": 300}},
    {"id": "var-mu", "name": "Mu", "equation": "2", "position": {"x": 300, "y": 300}},
    {"id": "var-k", "name": "K", "equation": "1", "position": {"x": 450, "y": 300}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 100, "dt": 0.1},
  "source": "https://doi.org/10.2307/3933",
  "reference": "Anderson RM, May RM. Regulation and Stability of Host-Parasite Population Interactions: I. Regulatory Processes. Journal of Animal Ecology. 1978;47(1):219-247."
}
