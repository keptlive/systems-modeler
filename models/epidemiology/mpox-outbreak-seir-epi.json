{
  "id": "mpox-outbreak-seir-epi",
  "name": "Mpox (Monkeypox) Outbreak SEIR Model",
  "description": "SEIR model calibrated for the 2022 global mpox outbreak, featuring close-contact transmission dynamics and vaccination response. Source: Thornhill et al. (2022). NEJM. DOI: 10.1056/NEJMoa2207323",
  "stocks": [
    {"id": "stock-s", "name": "Susceptible", "initial_value": 999900, "equation": "", "position": {"x": 100, "y": 200}},
    {"id": "stock-e", "name": "Exposed", "initial_value": 50, "equation": "", "position": {"x": 250, "y": 200}},
    {"id": "stock-i", "name": "Infectious", "initial_value": 50, "equation": "", "position": {"x": 400, "y": 200}},
    {"id": "stock-r", "name": "Recovered", "initial_value": 0, "equation": "", "position": {"x": 550, "y": 200}},
    {"id": "stock-v", "name": "Vaccinated", "initial_value": 0, "equation": "", "position": {"x": 100, "y": 350}}
  ],
  "flows": [
    {"id": "flow-exposure", "name": "Exposure", "equation": "Beta * Susceptible * Infectious / Total_Pop * Contact_Rate_Factor", "from_stock": "stock-s", "to_stock": "stock-e", "position": {"x": 175, "y": 200}},
    {"id": "flow-onset", "name": "Symptom_Onset", "equation": "Exposed / Incubation_Period", "from_stock": "stock-e", "to_stock": "stock-i", "position": {"x": 325, "y": 200}},
    {"id": "flow-recovery", "name": "Recovery", "equation": "Infectious / Infectious_Period", "from_stock": "stock-i", "to_stock": "stock-r", "position": {"x": 475, "y": 200}},
    {"id": "flow-vaccination", "name": "Vaccination", "equation": "Susceptible * Vaccination_Rate * Vaccine_Availability", "from_stock": "stock-s", "to_stock": "stock-v", "position": {"x": 100, "y": 275}}
  ],
  "variables": [
    {"id": "var-beta", "name": "Beta", "equation": "0.4", "position": {"x": 175, "y": 100}},
    {"id": "var-incubation", "name": "Incubation_Period", "equation": "8", "position": {"x": 325, "y": 100}},
    {"id": "var-infectious", "name": "Infectious_Period", "equation": "21", "position": {"x": 475, "y": 100}},
    {"id": "var-total", "name": "Total_Pop", "equation": "Susceptible + Exposed + Infectious + Recovered + Vaccinated", "position": {"x": 350, "y": 50}},
    {"id": "var-r0", "name": "R0", "equation": "Beta * Infectious_Period", "position": {"x": 500, "y": 50}},
    {"id": "var-contact-factor", "name": "Contact_Rate_Factor", "equation": "IF(TIME > Behavior_Change_Time, 0.5, 1)", "position": {"x": 175, "y": 300}},
    {"id": "var-behavior-time", "name": "Behavior_Change_Time", "equation": "30", "position": {"x": 300, "y": 300}},
    {"id": "var-vax-rate", "name": "Vaccination_Rate", "equation": "0.001", "position": {"x": 50, "y": 400}},
    {"id": "var-vax-avail", "name": "Vaccine_Availability", "equation": "IF(TIME > 14, 1, 0)", "position": {"x": 150, "y": 400}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 180, "dt": 0.5},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1056/NEJMoa2207323",
  "reference": "Thornhill, J.P. et al. (2022). Monkeypox virus infection in humans across 16 countries. New England Journal of Medicine, 387, 679-691."
}
