{
  "id": "covid19-space-age-structured-epi",
  "name": "Target_Viral_Load",
  "description": "Space-age structured COVID-19 model coupling within-host infection and between-host transmission. Models infection age, spatial diffusion, and SARS-CoV-2 infection processes. Based on 2024 Communications in Nonlinear Science paper. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 990000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Exposed",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Infected_Early",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Infected_Peak",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s5",
      "name": "Infected_Late",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "s6",
      "name": "Recovered",
      "initial_value": 8000,
      "equation": "",
      "position": {
        "x": 850,
        "y": 200
      }
    },
    {
      "id": "s7",
      "name": "Viral_Load_Average",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Exposure_Rate",
      "equation": "Beta * Susceptible * (Infected_Early + Infected_Peak * Peak_Infectivity + Infected_Late * Late_Infectivity) / Total_Population",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Infection_Onset",
      "equation": "Exposed / Latent_Period",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Peak_Transition",
      "equation": "Infected_Early / Early_Duration",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Late_Transition",
      "equation": "Infected_Peak / Peak_Duration",
      "from_stock": "s4",
      "to_stock": "s5",
      "position": {
        "x": 625,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Recovery_Rate",
      "equation": "Infected_Late / Late_Duration",
      "from_stock": "s5",
      "to_stock": "s6",
      "position": {
        "x": 775,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Viral_Dynamics",
      "equation": "(Target_Viral_Load - Viral_Load_Average) / Viral_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s7",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Beta",
      "equation": "0.3",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Total_Population",
      "equation": "Susceptible + Exposed + Infected_Early + Infected_Peak + Infected_Late + Recovered",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Latent_Period",
      "equation": "3",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Early_Duration",
      "equation": "2",
      "position": {
        "x": 475,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Peak_Duration",
      "equation": "3",
      "position": {
        "x": 625,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Late_Duration",
      "equation": "5",
      "position": {
        "x": 775,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Peak_Infectivity",
      "equation": "2.5",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Late_Infectivity",
      "equation": "0.5",
      "position": {
        "x": 700,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "Target_Viral_Load",
      "equation": "50 * Infected_Early + 200 * Infected_Peak + 30 * Infected_Late",
      "position": {
        "x": 400,
        "y": 500
      }
    },
    {
      "id": "v10",
      "name": "Viral_Adjustment_Time",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 500
      }
    },
    {
      "id": "v11",
      "name": "R0",
      "equation": "Beta * (Early_Duration + Peak_Duration * Peak_Infectivity + Late_Duration * Late_Infectivity) / (Early_Duration + Peak_Duration + Late_Duration)",
      "position": {
        "x": 300,
        "y": 500
      }
    }
  ],
