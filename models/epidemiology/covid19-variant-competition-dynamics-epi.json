{
  "id": "covid19-variant-competition-dynamics-epi",
  "name": "COVID-19 Variant Competition with Immune Escape",
  "description": "Multi-strain SARS-CoV-2 model showing competition between variants with differential transmissibility and immune escape. Based on Althaus et al. 2021 analysis of Alpha, Delta variants. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 0.7,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Infected Alpha",
      "initial_value": 0.001,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "s3",
      "name": "Infected Delta",
      "initial_value": 0.0001,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "s4",
      "name": "Recovered Alpha",
      "initial_value": 0.15,
      "equation": "",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "s5",
      "name": "Recovered Delta",
      "initial_value": 0.05,
      "equation": "",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Alpha Infection",
      "equation": "Beta_Alpha * Susceptible * Infected_Alpha",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "f2",
      "name": "Delta Infection",
      "equation": "Beta_Delta * Susceptible * Infected_Delta * (1 + Cross_Immunity_Escape)",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Alpha Recovery",
      "equation": "Infected_Alpha / Infectious_Period",
      "from_stock": "s2",
      "to_stock": "s4",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "f4",
      "name": "Delta Recovery",
      "equation": "Infected_Delta / Infectious_Period",
      "from_stock": "s3",
      "to_stock": "s5",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "f5",
      "name": "Reinfection Alpha to Delta",
      "equation": "Beta_Delta * Recovered_Alpha * Infected_Delta * Immune_Escape_Delta",
      "from_stock": "s4",
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
