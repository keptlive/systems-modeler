      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "v6",
      "name": "Total Infected",
      "equation": "Infected_Alpha + Infected_Delta",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "v7",
      "name": "Delta Fraction",
      "equation": "Infected_Delta / (Total_Infected + 0.0001)",
      "position": {
