{
  "id": "seihr-hospital-capacity-epi",
  "name": "SEIHR Hospital Capacity Model",
  "description": "Extended compartmental model including hospitalization, used for COVID-19 hospital capacity planning. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Susceptible",
      "initial_value": 99000,
      "equation": "",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Exposed",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Infectious",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 320,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Hospitalized",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 440,
        "y": 200
      }
    },
    {
      "id": "s5",
      "name": "Recovered",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 560,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Exposure",
      "equation": "Beta * Susceptible * Infectious / Total_Pop",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 140,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Becoming_Infectious",
      "equation": "Exposed / Latent_Period",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 260,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Hospitalization",
      "equation": "Hospitalization_Rate * Infectious / Infectious_Period",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 380,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Mild_Recovery",
      "equation": "(1 - Hospitalization_Rate) * Infectious / Infectious_Period",
      "from_stock": "s3",
      "to_stock": "s5",
      "position": {
        "x": 380,
        "y": 250
      }
    },
    {
      "id": "f5",
      "name": "Hospital_Discharge",
      "equation": "Hospitalized / Hospital_Stay",
      "from_stock": "s4",
      "to_stock": "s5",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Beta",
      "equation": "0.4",
      "position": {
        "x": 140,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Latent_Period",
      "equation": "5",
      "position": {
        "x": 260,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Infectious_Period",
      "equation": "7",
      "position": {
        "x": 380,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Hospitalization_Rate",
      "equation": "0.05",
      "position": {
        "x": 440,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Hospital_Stay",
      "equation": "10",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Total_Pop",
      "equation": "Susceptible + Exposed + Infectious + Hospitalized + Recovered",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Hospital_Capacity",
      "equation": "500",
      "position": {
        "x": 440,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Capacity_Utilization",
      "equation": "Hospitalized / Hospital_Capacity",
      "position": {
        "x": 560,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:20:56.316222+00:00",
  "updated_at": "2026-01-12T11:20:56.316222+00:00",
  "source": "https://doi.org/10.1001/jamainternmed.2020.2033",
  "reference": "Weissman GE, et al. Locally informed simulation to predict hospital capacity needs during the COVID-19 pandemic. Ann Intern Med. 2020;173(1):21-28."
}