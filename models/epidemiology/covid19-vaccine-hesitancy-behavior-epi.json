{
  "id": "covid19-vaccine-hesitancy-behavior-epi",
  "name": "COVID-19 Vaccine Hesitancy Behavioral Model",
  "description": "Behavioral epidemiology model of vaccine hesitancy dynamics during COVID-19. Shows how risk perception, social influence, and trust in institutions affect vaccination uptake. Includes information environment effects and the hesitancy-infection feedback loop.",
  "stocks": [
    {
      "id": "s1",
      "name": "Unvaccinated_Susceptible",
      "initial_value": 60000000,
      "equation": "",
      "position": {"x": 100, "y": 200}
    },
    {
      "id": "s2",
      "name": "Vaccinated",
      "initial_value": 20000000,
      "equation": "",
      "position": {"x": 350, "y": 200}
    },
    {
      "id": "s3",
      "name": "Infected",
      "initial_value": 100000,
      "equation": "",
      "position": {"x": 600, "y": 200}
    },
    {
      "id": "s4",
      "name": "Hesitancy_Level",
      "initial_value": 30,
      "equation": "",
      "position": {"x": 225, "y": 380}
    },
    {
      "id": "s5",
      "name": "Trust_in_Science",
      "initial_value": 60,
      "equation": "",
      "position": {"x": 475, "y": 380}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Vaccination",
      "equation": "Unvaccinated_Susceptible * Vaccination_Rate * (1 - Hesitancy_Effect)",
      "from_stock": "Unvaccinated_Susceptible",
      "to_stock": "Vaccinated",
      "position": {"x": 225, "y": 200}
    },
    {
      "id": "f2",
      "name": "Infection_Unvacc",
      "equation": "Beta * Unvaccinated_Susceptible * Infected / Total_Pop",
      "from_stock": "Unvaccinated_Susceptible",
      "to_stock": "Infected",
      "position": {"x": 350, "y": 150}
    },
    {
      "id": "f3",
      "name": "Recovery",
      "equation": "Infected / Recovery_Time",
      "from_stock": "Infected",
      "to_stock": null,
      "position": {"x": 700, "y": 200}
    },
    {
      "id": "f4",
      "name": "Hesitancy_Change",
      "equation": "(Misinformation_Effect - Trust_Effect - Fear_Effect) / Attitude_Adj_Time",
      "from_stock": null,
      "to_stock": "Hesitancy_Level",
      "position": {"x": 125, "y": 380}
    },
    {
      "id": "f5",
      "name": "Trust_Change",
      "equation": "(Target_Trust - Trust_in_Science) / Trust_Adj_Time",
      "from_stock": null,
      "to_stock": "Trust_in_Science",
      "position": {"x": 575, "y": 380}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Vaccination_Rate",
      "equation": "0.01",
      "position": {"x": 100, "y": 80}
    },
    {
      "id": "v2",
      "name": "Hesitancy_Effect",
      "equation": "Hesitancy_Level / 100",
      "position": {"x": 225, "y": 80}
    },
    {
      "id": "v3",
      "name": "Beta",
      "equation": "0.3",
      "position": {"x": 350, "y": 80}
    },
    {
      "id": "v4",
      "name": "Recovery_Time",
      "equation": "14",
      "position": {"x": 475, "y": 80}
    },
    {
      "id": "v5",
      "name": "Total_Pop",
      "equation": "Unvaccinated_Susceptible + Vaccinated + Infected",
      "position": {"x": 600, "y": 80}
    },
    {
      "id": "v6",
      "name": "Misinformation_Effect",
      "equation": "10 * (1 - Trust_in_Science / 100)",
      "position": {"x": 100, "y": 480}
    },
    {
      "id": "v7",
      "name": "Trust_Effect",
      "equation": "5 * Trust_in_Science / 100",
      "position": {"x": 225, "y": 480}
    },
    {
      "id": "v8",
      "name": "Fear_Effect",
      "equation": "10 * Infected / Total_Pop * 100",
      "position": {"x": 350, "y": 480}
    },
    {
      "id": "v9",
      "name": "Attitude_Adj_Time",
      "equation": "30",
      "position": {"x": 475, "y": 480}
    },
    {
      "id": "v10",
      "name": "Target_Trust",
      "equation": "50 + 20 * (Vaccinated / Total_Pop)",
      "position": {"x": 600, "y": 480}
    },
    {
      "id": "v11",
      "name": "Trust_Adj_Time",
      "equation": "60",
      "position": {"x": 700, "y": 380}
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "source": "https://doi.org/10.1016/j.vaccine.2021.02.001",
  "reference": "Troiano G, Nardi A. (2021). Vaccine hesitancy in the era of COVID-19. Public Health, 194, 245-251. DOI: 10.1016/j.puhe.2021.02.025. Also: Sallam M. (2021). COVID-19 Vaccine Hesitancy Worldwide: A Concise Systematic Review of Vaccine Acceptance Rates. Vaccines, 9(2), 160.",
  "created_at": "2026-01-15T20:30:00.000000Z",
  "updated_at": "2026-01-15T20:30:00.000000Z"
}
