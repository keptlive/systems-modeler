{
  "id": "ramsey-cass-koopmans-optimal-growth-eco",
  "name": "Ramsey-Cass-Koopmans Optimal Growth Model",
  "description": "The foundational optimal growth model in economics, independently developed by Ramsey (1928), Cass (1965), and Koopmans (1965). Models intertemporal consumption choice with capital accumulation, featuring the fundamental Euler equation for consumption. Central to modern macroeconomics and growth theory.",
  "stocks": [
    {
      "id": "stock-capital",
      "name": "Capital",
      "initial_value": 10,
      "equation": "",
      "position": {"x": 300, "y": 200}
    },
    {
      "id": "stock-consumption-habit",
      "name": "Consumption Habit",
      "initial_value": 1,
      "equation": "",
      "position": {"x": 500, "y": 200}
    }
  ],
  "flows": [
    {
      "id": "flow-net-investment",
      "name": "Net Investment",
      "equation": "Output - Consumption - Depreciation_Rate * Capital",
      "from_stock": null,
      "to_stock": "stock-capital",
      "position": {"x": 200, "y": 200}
    },
    {
      "id": "flow-habit-adjustment",
      "name": "Habit Adjustment",
      "equation": "(Consumption - Consumption_Habit) / Habit_Adjustment_Time",
      "from_stock": null,
      "to_stock": "stock-consumption-habit",
      "position": {"x": 600, "y": 200}
    }
  ],
  "variables": [
    {
      "id": "var-output",
      "name": "Output",
      "equation": "Technology * Capital ^ Alpha * Labor ^ (1 - Alpha)",
      "position": {"x": 200, "y": 100}
    },
    {
      "id": "var-alpha",
      "name": "Alpha",
      "equation": "0.33",
      "position": {"x": 350, "y": 100}
    },
    {
      "id": "var-technology",
      "name": "Technology",
      "equation": "1",
      "position": {"x": 500, "y": 100}
    },
    {
      "id": "var-labor",
      "name": "Labor",
      "equation": "100",
      "position": {"x": 650, "y": 100}
    },
    {
      "id": "var-depreciation-rate",
      "name": "Depreciation Rate",
      "equation": "0.05",
      "position": {"x": 200, "y": 300}
    },
    {
      "id": "var-discount-rate",
      "name": "Discount Rate",
      "equation": "0.02",
      "position": {"x": 350, "y": 300}
    },
    {
      "id": "var-intertemporal-elasticity",
      "name": "Intertemporal Elasticity",
      "equation": "0.5",
      "position": {"x": 500, "y": 300}
    },
    {
      "id": "var-consumption",
      "name": "Consumption",
      "equation": "Output * Consumption_Share",
      "position": {"x": 650, "y": 300}
    },
    {
      "id": "var-consumption-share",
      "name": "Consumption Share",
      "equation": "0.7",
      "position": {"x": 200, "y": 400}
    },
    {
      "id": "var-habit-adjustment-time",
      "name": "Habit Adjustment Time",
      "equation": "5",
      "position": {"x": 350, "y": 400}
    },
    {
      "id": "var-marginal-product-capital",
      "name": "Marginal Product Capital",
      "equation": "Alpha * Output / Capital",
      "position": {"x": 500, "y": 400}
    }
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 200, "dt": 0.5},
  "source": "https://doi.org/10.2307/2296458",
  "reference": "Cass D. Optimum Growth in an Aggregative Model of Capital Accumulation. Review of Economic Studies. 1965;32(3):233-240."
}
