{
  "id": "ayres-kneese-materials-balance-eco",
  "name": "Ayres-Kneese Materials Balance",
  "description": "Ayres and Kneese's 1969 materials balance model applying first law of thermodynamics to economics. All extracted materials eventually become waste. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "stock-raw",
      "name": "Raw_Materials",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-economy",
      "name": "Economic_Stock",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-waste",
      "name": "Residuals",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-extraction",
      "name": "Extraction",
      "equation": "extraction_rate * Raw_Materials",
      "from_stock": "stock-raw",
      "to_stock": "stock-economy",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-discharge",
      "name": "Residual_Discharge",
      "equation": "Economic_Stock * discharge_rate",
      "from_stock": "stock-economy",
      "to_stock": "stock-waste",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-recycle",
      "name": "Recycling",
      "equation": "Residuals * recycling_rate",
      "from_stock": "stock-waste",
      "to_stock": "stock-economy",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-extr-rate",
      "name": "extraction_rate",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-discharge",
      "name": "discharge_rate",
      "equation": "0.15",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-recycle",
      "name": "recycling_rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-mass-balance",
      "name": "Mass_Balance_Check",
      "equation": "Raw_Materials + Economic_Stock + Residuals",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-throughput",
      "name": "Material_Throughput",
      "equation": "Extraction - Recycling",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Raw_Materials",
      "to_element": "Extraction"
    },
    {
      "id": "conn-2",
      "from_element": "Economic_Stock",
      "to_element": "Residual_Discharge"
    },
    {
      "id": "conn-3",
      "from_element": "Residuals",
      "to_element": "Recycling"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1257/aer.59.3.282",
  "reference": "Ayres RU, Kneese AV. Production, Consumption, and Externalities. American Economic Review. 1969;59(3):282-297."
}