    },
    {
      "id": "conn-4",
      "from_element": "Native Population",
      "to_element": "Native Reproduction"
    },
    {
      "id": "conn-5",
      "from_element": "Total Population",
      "to_element": "Native Reproduction"
    },
    {
      "id": "conn-6",
      "from_element": "Invasive Population",
      "to_element": "Displacement"
    },
    {
      "id": "conn-7",
      "from_element": "Native Population",
      "to_element": "Displacement"
    },
    {
      "id": "conn-8",
      "from_element": "Invaded Area",
      "to_element": "Spread"
    }
  ],
