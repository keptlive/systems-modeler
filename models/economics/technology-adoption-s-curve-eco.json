{
  "id": "technology-adoption-s-curve-eco",
  "name": "Technology Adoption S-Curve Model",
  "description": "A general model of technology adoption following the classic S-curve pattern. Based on Everett Rogers' Diffusion of Innovations theory. Reference: Rogers, E. M. (2003). Diffusion of Innovations (5th ed.). Free Press.",
  "source": "https://doi.org/10.1086/266678",
  "reference": "Rogers EM. Diffusion of Innovations. 5th ed. Free Press, 2003.",
  "stocks": [
    {
      "id": "stock-potential",
      "name": "Potential Adopters",
      "initial_value": 990,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-adopters",
      "name": "Adopters",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-adoption",
      "name": "Adoption Rate",
      "equation": "Potential_Adopters * (Innovation_Coefficient + Imitation_Coefficient * Adopters / Total_Market)",
      "from_stock": "stock-potential",
      "to_stock": "stock-adopters",
      "position": {
        "x": 250,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-total-market",
      "name": "Total Market",
      "equation": "Potential_Adopters + Adopters",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-p",
      "name": "Innovation Coefficient",
      "equation": "0.03",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "var-q",
      "name": "Imitation Coefficient",
      "equation": "0.38",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "var-market-penetration",
      "name": "Market Penetration",
      "equation": "Adopters / Total_Market",
      "position": {
        "x": 450,
        "y": 100
      }
    }
  ],
