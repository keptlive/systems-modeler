{
  "id": "wetland-ecosystem-services-eco",
  "name": "Wetland Ecosystem Services Model",
  "description": "Models wetland functions including water filtration, flood control, and carbon storage. Based on Costanza et al. (1997). DOI: 10.1038/387253a0",
  "stocks": [
    {
      "id": "stock-wetarea",
      "name": "Wetland_Area",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-waterqual",
      "name": "Water_Quality",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "stock-carbon",
      "name": "Stored_Carbon",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "stock-biodiv",
      "name": "Biodiversity_Index",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-wetloss",
      "name": "Wetland_Loss",
      "equation": "Wetland_Area * Development_Pressure",
      "from_stock": "stock-wetarea",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "flow-wetrestore",
      "name": "Wetland_Restoration",
      "equation": "Restoration_Budget * Restoration_Efficiency",
      "from_stock": null,
      "to_stock": "stock-wetarea",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "flow-filtration",
      "name": "Water_Filtration",
      "equation": "Wetland_Area * Filtration_Rate * (100 - Water_Quality) / 100",
      "from_stock": null,
      "to_stock": "stock-waterqual",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-pollution",
      "name": "Pollution_Input",
      "equation": "Pollution_Load",
      "from_stock": "stock-waterqual",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "flow-carbonseq",
      "name": "Carbon_Sequestration",
      "equation": "Wetland_Area * Carbon_Uptake_Rate",
      "from_stock": null,
      "to_stock": "stock-carbon",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "flow-carbonrel",
      "name": "Carbon_Release",
      "equation": "Stored_Carbon * Decomposition_Rate * (1 + Drought_Factor)",
      "from_stock": "stock-carbon",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "flow-biodivchange",
      "name": "Biodiversity_Change",
      "equation": "(Wetland_Area / 1000 * 100 - Biodiversity_Index) * Biodiversity_Response",
      "from_stock": null,
      "to_stock": "stock-biodiv",
      "position": {
        "x": 350,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-devpress",
      "name": "Development_Pressure",
      "equation": "0.02 + 0.01 * SIN(TIME / 10)",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-restbudget",
      "name": "Restoration_Budget",
      "equation": "10",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "var-resteff",
      "name": "Restoration_Efficiency",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-filtrate",
      "name": "Filtration_Rate",
      "equation": "0.001",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-pollload",
      "name": "Pollution_Load",
      "equation": "5",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "var-carbrate",
      "name": "Carbon_Uptake_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 175
      }
    },
    {
      "id": "var-decomprate",
      "name": "Decomposition_Rate",
      "equation": "0.01",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "var-drought",
      "name": "Drought_Factor",
      "equation": "0.2 * MAX(0, SIN(TIME / 15))",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "var-biodivresp",
      "name": "Biodiversity_Response",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 175
      }
    },
    {
      "id": "var-ecoservval",
      "name": "Ecosystem_Service_Value",
      "equation": "Wetland_Area * (Water_Quality / 100 + Stored_Carbon / 1000 + Biodiversity_Index / 100)",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Wetland_Area",
      "to_element": "Water_Filtration"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:55:29.074081+00:00",
  "updated_at": "2026-01-12T02:55:29.074088+00:00",
  "source": "https://doi.org/10.1038/387253a0",
  "reference": "Costanza R, et al. (1997). The value of the world's ecosystem services and natural capital. Nature."
}