{
  "id": "housing-market-dynamics-eco",
  "name": "Housing Market Dynamics Model",
  "description": "Model of housing market cycles showing price dynamics, construction, and affordability feedback. Reference: NSIDC Arctic Sea Ice News. Source: https://nsidc.org/arcticseaicenews/",
  "stocks": [
    {
      "id": "stock-supply",
      "name": "Housing_Supply",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-demand",
      "name": "Housing_Demand",
      "initial_value": 95000,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "stock-price",
      "name": "Price_Index",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-construction",
      "name": "New_Construction",
      "equation": "Construction_Rate * Price_Index / 100 * Developer_Confidence",
      "from_stock": null,
      "to_stock": "stock-supply",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "flow-demolition",
      "name": "Demolition_Rate",
      "equation": "Housing_Supply * Depreciation_Rate",
      "from_stock": "stock-supply",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "flow-demand-change",
      "name": "Demand_Change",
      "equation": "Population_Growth * Household_Formation - Demand_Destruction * (Price_Index - 100) / 100",
      "from_stock": null,
      "to_stock": "stock-demand",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "flow-price-adjust",
      "name": "Price_Adjustment",
      "equation": "(Housing_Demand - Housing_Supply) / Housing_Supply * Price_Sensitivity * Price_Index",
      "from_stock": null,
      "to_stock": "stock-price",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "variables": [
    {
      "id": "var-constr",
      "name": "Construction_Rate",
      "equation": "2000",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-conf",
      "name": "Developer_Confidence",
      "equation": "1.0",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-deprec",
      "name": "Depreciation_Rate",
      "equation": "0.01",
      "position": {
        "x": 50,
        "y": 350
      }
    },
    {
      "id": "var-pop",
      "name": "Population_Growth",
      "equation": "1000",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-household",
      "name": "Household_Formation",
      "equation": "1.2",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "var-destr",
      "name": "Demand_Destruction",
      "equation": "500",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "var-sens",
      "name": "Price_Sensitivity",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Construction_Rate",
      "to_element": "New_Construction"
    },
    {
      "id": "c2",
      "from_element": "Price_Index",
      "to_element": "New_Construction"
    },
    {
      "id": "c3",
      "from_element": "Developer_Confidence",
      "to_element": "New_Construction"
    },
    {
      "id": "c4",
      "from_element": "Housing_Supply",
      "to_element": "Demolition_Rate"
    },
    {
      "id": "c5",
      "from_element": "Depreciation_Rate",
      "to_element": "Demolition_Rate"
    },
    {
      "id": "c6",
      "from_element": "Population_Growth",
      "to_element": "Demand_Change"
    },
    {
      "id": "c7",
      "from_element": "Household_Formation",
      "to_element": "Demand_Change"
    },
    {
      "id": "c8",
      "from_element": "Demand_Destruction",
      "to_element": "Demand_Change"
    },
    {
      "id": "c9",
      "from_element": "Price_Index",
      "to_element": "Demand_Change"
    },
    {
      "id": "c10",
      "from_element": "Housing_Demand",
      "to_element": "Price_Adjustment"
    },
    {
      "id": "c11",
      "from_element": "Housing_Supply",
      "to_element": "Price_Adjustment"
    },
    {
      "id": "c12",
      "from_element": "Price_Sensitivity",
      "to_element": "Price_Adjustment"
    },
    {
      "id": "c13",
      "from_element": "Price_Index",
      "to_element": "Price_Adjustment"
    }
  ],
