{
  "id": "monod-microbial-growth-eco",
  "name": "Monod Microbial Growth Model",
  "description": "Jacques Monod's 1949 model of microbial growth as a function of substrate concentration. Shows how bacterial growth rate depends on nutrient availability through Michaelis-Menten-like kinetics. Essential for bioreactor design and wastewater treatment. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-biomass",
      "name": "Biomass",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-substrate",
      "name": "Substrate",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-biomass-growth",
      "name": "Biomass Growth",
      "equation": "Specific_Growth_Rate * Biomass",
      "from_stock": null,
      "to_stock": "stock-biomass",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-substrate-consumption",
      "name": "Substrate Consumption",
      "equation": "Biomass_Growth / Yield_Coefficient",
      "from_stock": "stock-substrate",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "flow-substrate-input",
      "name": "Substrate Input",
      "equation": "Dilution_Rate * Substrate_Input_Concentration",
      "from_stock": null,
      "to_stock": "stock-substrate",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "flow-biomass-washout",
      "name": "Biomass Washout",
      "equation": "Dilution_Rate * Biomass",
      "from_stock": "stock-biomass",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-max-growth-rate",
      "name": "Maximum Growth Rate",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-half-saturation",
      "name": "Half Saturation Constant",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-specific-growth-rate",
      "name": "Specific Growth Rate",
      "equation": "Maximum_Growth_Rate * Substrate / (Half_Saturation_Constant + Substrate)",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-yield-coefficient",
      "name": "Yield Coefficient",
      "equation": "0.4",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-dilution-rate",
      "name": "Dilution Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-substrate-input-conc",
      "name": "Substrate Input Concentration",
      "equation": "10",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "var-critical-dilution-rate",
      "name": "Critical Dilution Rate",
      "equation": "Maximum_Growth_Rate * Substrate_Input_Concentration / (Half_Saturation_Constant + Substrate_Input_Concentration)",
      "position": {
        "x": 350,
        "y": 400
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Substrate",
      "to_element": "Specific Growth Rate"
    },
    {
      "id": "conn-2",
      "from_element": "Specific Growth Rate",
      "to_element": "Biomass Growth"
    },
    {
      "id": "conn-3",
      "from_element": "Biomass",
      "to_element": "Biomass Growth"
    },
    {
      "id": "conn-4",
      "from_element": "Biomass Growth",
      "to_element": "Substrate Consumption"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.1
  },
  "created_at": "2026-01-12T01:30:00.000Z",
  "updated_at": "2026-01-12T01:30:00.000Z",
  "source": "https://doi.org/10.1146/annurev.mi.03.100149.002103",
  "reference": "Monod J. The Growth of Bacterial Cultures. Annual Review of Microbiology. 1949;3:371-394. Nobel Prize in Physiology or Medicine 1965."
}