{
  "id": "holling-type-iii-eco",
  "name": "Holling Type III Functional Response",
  "description": "Predator-prey model with sigmoidal functional response. At low prey density, predators switch to alternative prey or are inefficient. Creates refugia and multiple stable states. Reference: Holling, C. S. (1973). Resilience and stability of ecological systems. Annual Review of Ecology and Systematics, 4, 1-23. DOI: https://doi.org/10.1146/annurev.es.04.110173.000245",
  "stocks": [
    {
      "id": "stock-prey",
      "name": "Prey Population",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-predator",
      "name": "Predator Population",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-prey-birth",
      "name": "Prey Birth",
      "equation": "Prey_Birth_Rate * Prey_Population * (1 - Prey_Population / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-prey",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "flow-predation",
      "name": "Predation",
      "equation": "Functional_Response * Predator_Population",
      "from_stock": "stock-prey",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 280
      }
    },
    {
      "id": "flow-predator-birth",
      "name": "Predator Birth",
      "equation": "Conversion_Efficiency * Functional_Response * Predator_Population",
      "from_stock": null,
      "to_stock": "stock-predator",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-predator-death",
      "name": "Predator Death",
      "equation": "Predator_Death_Rate * Predator_Population",
      "from_stock": "stock-predator",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 280
      }
    }
  ],
  "variables": [
    {
      "id": "var-prey-birth",
      "name": "Prey Birth Rate",
      "equation": "1.0",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-carrying",
      "name": "Carrying Capacity",
      "equation": "500",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-attack",
      "name": "Attack Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-handling",
      "name": "Handling Time",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-half-sat",
      "name": "Half Saturation",
      "equation": "50",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-functional",
      "name": "Functional Response",
      "equation": "Attack_Rate * Prey_Population^2 / (Half_Saturation^2 + Prey_Population^2)",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-conversion",
      "name": "Conversion Efficiency",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-predator-death",
      "name": "Predator Death Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Prey Population",
      "to_element": "Functional Response"
    },
    {
      "id": "conn-2",
      "from_element": "Functional Response",
      "to_element": "Predation"
    },
    {
      "id": "conn-3",
      "from_element": "Functional Response",
      "to_element": "Predator Birth"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.1
  },
