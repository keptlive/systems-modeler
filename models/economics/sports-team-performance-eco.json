{
  "id": "sports-team-performance-eco",
  "name": "Sports Team Performance Dynamics",
  "description": "Model of professional sports team performance cycles. Captures roster talent, team chemistry, management decisions, and revenue feedback. Based on sports economics and organizational behavior research. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Team_Talent",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Team_Chemistry",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Win_Percentage",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Revenue",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Talent_Acquisition",
      "equation": "Player_Budget * Acquisition_Efficiency",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Talent_Attrition",
      "equation": "Team_Talent * Attrition_Rate",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 280
      }
    },
    {
      "id": "f3",
      "name": "Chemistry_Development",
      "equation": "(Team_Talent * Chemistry_Potential - Team_Chemistry) / Chemistry_Time + Coaching_Effect",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 350,
        "y": 280
      }
    },
    {
      "id": "f4",
      "name": "Performance_Update",
      "equation": "(Expected_Win_Pct - Win_Percentage) / Performance_Lag",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 280
      }
    },
    {
      "id": "f5",
      "name": "Revenue_Change",
      "equation": "(Win_Percentage * Revenue_Sensitivity + Base_Revenue - Revenue) / Revenue_Lag",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 350,
        "y": 430
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
