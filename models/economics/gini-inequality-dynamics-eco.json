{
  "id": "gini-inequality-dynamics-eco",
  "name": "Gini Inequality Dynamics",
  "description": "Evolution of income/wealth inequality measured by Gini coefficient. Models how inequality grows through capital accumulation and is reduced by redistribution and progressive taxation. Reference: Fisher, R. A. (1930). The Genetical Theory of Natural Selection. Oxford University Press. Source: https://doi.org/10.5962/bhl.title.27468",
  "stocks": [
    {
      "id": "stock-gini",
      "name": "Gini Coefficient",
      "initial_value": 0.35,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-wealth-top",
      "name": "Top Decile Wealth",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-wealth-bottom",
      "name": "Bottom Decile Wealth",
      "initial_value": 2,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-gini-change",
      "name": "Gini Change",
      "equation": "Concentration_Force - Redistribution_Force",
      "from_stock": null,
      "to_stock": "stock-gini",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "flow-top-growth",
      "name": "Top Wealth Growth",
      "equation": "Top_Decile_Wealth * (Capital_Return - Tax_Rate)",
      "from_stock": null,
      "to_stock": "stock-wealth-top",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "flow-bottom-growth",
      "name": "Bottom Wealth Growth",
      "equation": "Bottom_Decile_Wealth * Labor_Income_Growth + Transfers",
      "from_stock": null,
      "to_stock": "stock-wealth-bottom",
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-concentration",
      "name": "Concentration Force",
      "equation": "0.01 * (Capital_Return - Economic_Growth) * Gini_Coefficient",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-redistribution",
      "name": "Redistribution Force",
      "equation": "Tax_Rate * Gini_Coefficient * Redistribution_Efficiency",
      "position": {
        "x": 350,
        "y": 80
      }
    },
    {
      "id": "var-capital-return",
      "name": "Capital Return",
      "equation": "0.05",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-econ-growth",
      "name": "Economic Growth",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-tax-rate",
      "name": "Tax Rate",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-redistrib-eff",
      "name": "Redistribution Efficiency",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-labor-growth",
      "name": "Labor Income Growth",
      "equation": "0.02",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "var-transfers",
      "name": "Transfers",
      "equation": "Tax_Rate * Top_Decile_Wealth * 0.1",
      "position": {
        "x": 300,
        "y": 450
      }
    },
    {
      "id": "var-r-g-gap",
      "name": "r minus g",
      "equation": "Capital_Return - Economic_Growth",
      "position": {
        "x": 500,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Gini Coefficient",
      "to_element": "Concentration Force"
    },
    {
      "id": "conn-2",
      "from_element": "Gini Coefficient",
      "to_element": "Redistribution Force"
    },
    {
      "id": "conn-3",
      "from_element": "Top Decile Wealth",
      "to_element": "Transfers"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
