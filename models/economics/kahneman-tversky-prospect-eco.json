{
  "id": "kahneman-tversky-prospect-eco",
  "name": "Kahneman-Tversky Prospect Theory",
  "description": "Kahneman and Tversky's 1979 prospect theory modeling decision-making under risk with loss aversion and probability weighting. Nobel Prize 2002. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-wealth",
      "name": "Reference_Point",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-actual",
      "name": "Actual_Wealth",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-outcome",
      "name": "Outcome",
      "equation": "gamble_outcome",
      "from_stock": null,
      "to_stock": "stock-actual",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "flow-adapt",
      "name": "Reference_Adaptation",
      "equation": "(Actual_Wealth - Reference_Point) * adaptation_rate",
      "from_stock": null,
      "to_stock": "stock-wealth",
      "position": {
        "x": 200,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-outcome",
      "name": "gamble_outcome",
      "equation": "IF(RANDOM(0,1) < weighted_prob, gain, -loss)",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-gain",
      "name": "gain",
      "equation": "50",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "var-loss",
      "name": "loss",
      "equation": "25",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-prob",
      "name": "objective_prob",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-weighted",
      "name": "weighted_prob",
      "equation": "objective_prob^gamma / (objective_prob^gamma + (1-objective_prob)^gamma)^(1/gamma)",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-gamma",
      "name": "gamma",
      "equation": "0.65",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-change",
      "name": "Wealth_Change",
      "equation": "Actual_Wealth - Reference_Point",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-value",
      "name": "Prospect_Value",
      "equation": "IF(Wealth_Change >= 0, Wealth_Change^alpha, -lambda * (-Wealth_Change)^alpha)",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-alpha",
      "name": "alpha",
      "equation": "0.88",
      "position": {
        "x": 150,
        "y": 400
      }
    },
    {
      "id": "var-lambda",
      "name": "lambda",
      "equation": "2.25",
      "position": {
        "x": 450,
        "y": 400
      }
    },
    {
      "id": "var-adapt",
      "name": "adaptation_rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Reference_Point",
      "to_element": "Wealth_Change"
    },
    {
      "id": "conn-2",
      "from_element": "Actual_Wealth",
      "to_element": "Wealth_Change"
    },
    {
      "id": "conn-3",
      "from_element": "Wealth_Change",
      "to_element": "Prospect_Value"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "source": "https://doi.org/10.2307/1914185",
  "reference": "Kahneman D, Tversky A. Prospect Theory: An Analysis of Decision under Risk. Econometrica. 1979;47(2):263-291. Nobel Prize 2002."
}