{
  "id": "sterman-commodity-cycles-eco",
  "name": "Sterman Commodity Cycles Model",
  "description": "Model of commodity price cycles showing how production delays, capacity constraints, and price expectations create oscillations. Based on Sterman (2000) Business Dynamics. Reference: Sterman, J. D. (2000). Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill. Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Production Capacity",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Inventory",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Expected Price",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Capacity Addition Rate",
      "equation": "MAX(0, Desired_Capacity - Production_Capacity) / Capacity_Construction_Time",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Capacity Depreciation",
      "equation": "Production_Capacity / Capacity_Lifetime",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Production Rate",
      "equation": "Production_Capacity * Capacity_Utilization",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Consumption Rate",
      "equation": "Demand",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Price Change",
      "equation": "(Actual_Price - Expected_Price) / Price_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Capacity Construction Time",
      "equation": "3",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Capacity Lifetime",
      "equation": "20",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Demand",
      "equation": "100",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Desired Inventory",
      "equation": "200",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Capacity Utilization",
      "equation": "MIN(1, Demand / Production_Capacity)",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Inventory Coverage",
      "equation": "Inventory / Demand",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Actual Price",
      "equation": "Reference_Price * (Desired_Inventory / MAX(1, Inventory))**Price_Elasticity",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Reference Price",
      "equation": "1",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Price Elasticity",
      "equation": "0.5",
      "position": {
        "x": 650,
        "y": 100
      }
    },
    {
      "id": "v10",
      "name": "Price Adjustment Time",
      "equation": "2",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "v11",
      "name": "Desired Capacity",
      "equation": "Demand * (1 + Expected_Price)",
      "position": {
        "x": 50,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Production Capacity",
      "to_element": "Production Rate"
    },
    {
      "id": "c2",
      "from_element": "Inventory",
      "to_element": "Consumption Rate"
    },
    {
      "id": "c3",
      "from_element": "Expected Price",
      "to_element": "Price Change"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-12T01:41:05.117841Z",
  "updated_at": "2026-01-12T01:41:05.117845Z",
  "source": "https://mitpress.mit.edu/9780262194457/business-dynamics/",
  "reference": "Sterman JD. Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill, 2000. Chapter 20."
}