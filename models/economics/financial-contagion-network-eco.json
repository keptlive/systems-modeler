{
  "id": "financial-contagion-network-eco",
  "name": "Financial Contagion Network Model",
  "description": "Models systemic risk propagation through banking networks. Based on Acemoglu et al. (2015) analysis of how network structure affects financial contagion. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-bank-a-assets",
      "name": "Bank_A_Assets",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "stock-bank-b-assets",
      "name": "Bank_B_Assets",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "stock-bank-c-assets",
      "name": "Bank_C_Assets",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "stock-bank-a-capital",
      "name": "Bank_A_Capital",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "stock-bank-b-capital",
      "name": "Bank_B_Capital",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "stock-bank-c-capital",
      "name": "Bank_C_Capital",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "stock-systemic-stress",
      "name": "Systemic_Stress",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 450
      }
    }
  ],
  "flows": [
    {
      "id": "flow-a-losses",
      "name": "Bank_A_Losses",
      "equation": "Bank_A_Assets * Shock_A + Interbank_Exposure * MAX(0, Bank_B_Capital - B_Threshold) * Contagion_Rate",
      "from_stock": "stock-bank-a-assets",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 220
      }
    },
    {
      "id": "flow-b-losses",
      "name": "Bank_B_Losses",
      "equation": "Bank_B_Assets * Shock_B + Interbank_Exposure * MAX(0, Bank_A_Capital - A_Threshold) * Contagion_Rate",
      "from_stock": "stock-bank-b-assets",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 220
      }
    },
    {
      "id": "flow-c-losses",
      "name": "Bank_C_Losses",
      "equation": "Bank_C_Assets * Shock_C + Interbank_Exposure * (MAX(0, Bank_A_Capital - A_Threshold) + MAX(0, Bank_B_Capital - B_Threshold)) * Contagion_Rate",
      "from_stock": "stock-bank-c-assets",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 220
      }
    },
    {
      "id": "flow-a-capital-erosion",
      "name": "Bank_A_Capital_Erosion",
      "equation": "Bank_A_Losses * Capital_Impact",
      "from_stock": "stock-bank-a-capital",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 370
      }
    },
    {
      "id": "flow-b-capital-erosion",
      "name": "Bank_B_Capital_Erosion",
      "equation": "Bank_B_Losses * Capital_Impact",
      "from_stock": "stock-bank-b-capital",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 370
      }
    },
    {
      "id": "flow-c-capital-erosion",
      "name": "Bank_C_Capital_Erosion",
      "equation": "Bank_C_Losses * Capital_Impact",
      "from_stock": "stock-bank-c-capital",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 370
      }
    },
    {
      "id": "flow-stress-buildup",
      "name": "Stress_Buildup",
      "equation": "MAX(0, A_Threshold - Bank_A_Capital) + MAX(0, B_Threshold - Bank_B_Capital) + MAX(0, C_Threshold - Bank_C_Capital)",
      "from_stock": null,
      "to_stock": "stock-systemic-stress",
      "position": {
        "x": 350,
        "y": 400
      }
    }
  ],
  "variables": [
