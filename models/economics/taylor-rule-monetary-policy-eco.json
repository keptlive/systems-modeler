{
  "id": "taylor-rule-monetary-policy-eco",
  "name": "Taylor Rule Monetary Policy Model",
  "description": "John Taylor's monetary policy rule relating interest rates to inflation and output gaps. Reference: Taylor, J.B. (1993). Discretion versus Policy Rules in Practice.",
  "stocks": [
    {
      "id": "s1",
      "name": "Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Inflation",
      "initial_value": 2,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Interest_Rate",
      "initial_value": 4,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Output_Dynamics",
      "equation": "-Interest_Sensitivity * (Interest_Rate - Natural_Rate) + Demand_Shock",
      "from_stock": null,
      "to_stock": "Output",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Phillips_Curve",
      "equation": "Output_Gap * Phillips_Slope + Inflation_Expectations + Supply_Shock",
      "from_stock": null,
      "to_stock": "Inflation",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Rate_Adjustment",
      "equation": "(Taylor_Rate - Interest_Rate) * Policy_Speed",
      "from_stock": null,
      "to_stock": "Interest_Rate",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Potential_Output",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Output_Gap",
      "equation": "(Output - Potential_Output) / Potential_Output",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Inflation_Target",
      "equation": "2",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Inflation_Gap",
      "equation": "Inflation - Inflation_Target",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Natural_Rate",
      "equation": "2",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Taylor_Rate",
      "equation": "Natural_Rate + Inflation + 0.5 * Inflation_Gap + 0.5 * Output_Gap * 100",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Interest_Sensitivity",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Phillips_Slope",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Inflation_Expectations",
      "equation": "0",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v10",
      "name": "Demand_Shock",
      "equation": "SIN(time / 10)",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "v11",
      "name": "Supply_Shock",
      "equation": "0.5 * SIN(time / 15)",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "v12",
      "name": "Policy_Speed",
      "equation": "0.25",
      "position": {
        "x": 550,
        "y": 150
      }
    }
  ],
