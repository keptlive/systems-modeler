{
  "id": "tourism-carrying-capacity-eco",
  "name": "Tourism Carrying Capacity Model",
  "description": "Model of sustainable tourism dynamics. Source: UNWTO; Butler (1980), Tourism Area Life Cycle.",
  "stocks": [
    {
      "id": "stock-visitors",
      "name": "Annual_Visitors",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-quality",
      "name": "Destination_Quality",
      "initial_value": 90,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-growth",
      "name": "Visitor_Growth",
      "equation": "Annual_Visitors * Growth_Rate * Attractiveness",
      "from_stock": null,
      "to_stock": "stock-visitors",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-decline",
      "name": "Visitor_Decline",
      "equation": "Annual_Visitors * Decline_Rate * (1 - Destination_Quality / 100)",
      "from_stock": "stock-visitors",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-degrade",
      "name": "Quality_Degradation",
      "equation": "MAX(0, Annual_Visitors - Carrying_Capacity) * Degradation_Rate / 1000",
      "from_stock": "stock-quality",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "flow-restore",
      "name": "Quality_Restoration",
      "equation": "(100 - Destination_Quality) * Restoration_Rate * Conservation_Investment",
      "from_stock": null,
      "to_stock": "stock-quality",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-growth",
      "name": "Growth_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-attract",
      "name": "Attractiveness",
      "equation": "Destination_Quality / 100",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-decline",
      "name": "Decline_Rate",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-carry",
      "name": "Carrying_Capacity",
      "equation": "50000",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-degrad",
      "name": "Degradation_Rate",
      "equation": "0.5",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "var-restore",
      "name": "Restoration_Rate",
      "equation": "0.02",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-conserve",
      "name": "Conservation_Investment",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T12:53:13.195584+00:00",
  "updated_at": "2026-01-12T12:53:13.195584+00:00",
  "source": "https://doi.org/10.1016/j.tourman.2008.07.008",
  "reference": "Butler RW. The concept of a tourist area cycle of evolution. Canadian Geographer. 1980;24(1):5-12."
}