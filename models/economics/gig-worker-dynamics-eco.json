{
  "id": "gig-worker-dynamics-eco",
  "name": "Gig Economy Worker Dynamics Model",
  "description": "Model of gig economy workforce showing entry, exit, income volatility, and worker classification dynamics. Based on Katz & Krueger (2019). Reference: Katz, L. F., & Krueger, A. B. (2019). The Rise and Nature of Alternative Work. Journal of Economic Perspectives. Source: https://doi.org/10.1257/jep.33.3.3",
  "stocks": [
    {
      "id": "s1",
      "name": "Traditional Workers",
      "initial_value": 120000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Gig Workers",
      "initial_value": 15000000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Hybrid Workers",
      "initial_value": 5000000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Gig Entry",
      "equation": "Traditional_Workers * Gig_Entry_Rate * Platform_Growth_Effect",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Gig Exit",
      "equation": "Gig_Workers * Gig_Exit_Rate",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "f3",
      "name": "Hybrid Transition",
      "equation": "Gig_Workers * Hybrid_Rate",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Hybrid Return",
      "equation": "Hybrid_Workers * Return_Rate",
      "from_stock": "s3",
      "to_stock": "s1",
      "position": {
        "x": 300,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Gig Entry Rate",
      "equation": "0.02",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Platform Growth Effect",
      "equation": "1.5",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Gig Exit Rate",
      "equation": "0.15",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "v4",
      "name": "Hybrid Rate",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Return Rate",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Average Gig Income",
      "equation": "25000",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Income Volatility",
      "equation": "0.4",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Total Gig Workforce",
      "equation": "Gig_Workers + Hybrid_Workers",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Traditional Workers",
      "to_element": "Gig Entry"
    },
    {
      "id": "c2",
      "from_element": "Gig Workers",
      "to_element": "Gig Exit"
    },
    {
      "id": "c3",
      "from_element": "Gig Workers",
      "to_element": "Hybrid Transition"
    }
  ],
  "time_settings": {
    "start": 2010,
    "end": 2030,
    "dt": 0.25
  },
  "created_at": "2026-01-12T01:45:26.877356+00:00",
  "updated_at": "2026-01-12T01:45:26.877359+00:00",
  "source": "https://doi.org/10.1257/aer.20180150",
  "reference": "Katz LF, Krueger AB. The Rise and Nature of Alternative Work Arrangements in the United States, 1995-2015. ILR Review. 2019;72(2):382-416."
}