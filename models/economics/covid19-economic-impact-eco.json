{
  "id": "covid19-economic-impact-eco",
  "name": "COVID-19 Economic Impact Model",
  "description": "Models pandemic economic effects including lockdown trade-offs. Source: Eichenbaum et al. (2021), Review of Economic Studies. DOI: 10.1093/restud/rdab010",
  "stocks": [
    {
      "id": "stock-inf",
      "name": "Infected_Workers",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-gdp",
      "name": "GDP",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-unemp",
      "name": "Unemployed",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-deaths",
      "name": "Cumulative_Deaths",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-infgrow",
      "name": "Infection_Growth",
      "equation": "Infected_Workers * (Infection_Rate * (1 - Lockdown_Intensity) - Recovery_Rate)",
      "from_stock": null,
      "to_stock": "stock-inf",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-gdpchange",
      "name": "GDP_Change",
      "equation": "GDP * (-Lockdown_Intensity * Economic_Sensitivity - Infected_Workers * Productivity_Loss / Workforce)",
      "from_stock": null,
      "to_stock": "stock-gdp",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-unempgrow",
      "name": "Unemployment_Growth",
      "equation": "Workforce * Lockdown_Intensity * Layoff_Rate",
      "from_stock": null,
      "to_stock": "stock-unemp",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "flow-death",
      "name": "Death_Rate",
      "equation": "Infected_Workers * Mortality_Rate",
      "from_stock": null,
      "to_stock": "stock-deaths",
      "position": {
        "x": 250,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-infrate",
      "name": "Infection_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-recrate",
      "name": "Recovery_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-lockdown",
      "name": "Lockdown_Intensity",
      "equation": "IF(Infected_Workers > 5000, 0.5, IF(Infected_Workers > 2000, 0.3, 0.1))",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-ecosens",
      "name": "Economic_Sensitivity",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-workforce",
      "name": "Workforce",
      "equation": "50000",
      "position": {
        "x": 100,
        "y": 175
      }
    },
    {
      "id": "var-prodloss",
      "name": "Productivity_Loss",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 175
      }
    },
    {
      "id": "var-layoff",
      "name": "Layoff_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-mort",
      "name": "Mortality_Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Infected_Workers",
      "to_element": "Lockdown_Intensity"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "created_at": "2026-01-12T02:06:16.307956+00:00",
  "updated_at": "2026-01-12T02:06:16.307959+00:00",
  "source": "https://doi.org/10.1093/restud/rdab010",
  "reference": "Eichenbaum, M.S. et al. (2021). The Macroeconomics of Epidemics. Review of Economic Studies."
}