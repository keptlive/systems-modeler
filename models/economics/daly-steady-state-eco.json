{
  "id": "daly-steady-state-eco",
  "name": "Daly Steady-State Economy",
  "description": "Herman Daly's steady-state economics model showing economy at optimal scale within ecological limits. Throughput maintained at sustainable level. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "stock-artifact",
      "name": "Artifact_Stock",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-resource",
      "name": "Natural_Resources",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-waste",
      "name": "Waste_Sink",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-production",
      "name": "Production",
      "equation": "MIN(throughput, Natural_Resources * extraction_rate)",
      "from_stock": "stock-resource",
      "to_stock": "stock-artifact",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-depreciation",
      "name": "Depreciation",
      "equation": "Artifact_Stock * depreciation_rate",
      "from_stock": "stock-artifact",
      "to_stock": "stock-waste",
      "position": {
        "x": 200,
        "y": 280
      }
    },
    {
      "id": "flow-regeneration",
      "name": "Regeneration",
      "equation": "Natural_Resources * regeneration_rate * (1 - Natural_Resources / resource_capacity)",
      "from_stock": null,
      "to_stock": "stock-resource",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "flow-assimilation",
      "name": "Waste_Assimilation",
      "equation": "Waste_Sink * assimilation_rate",
      "from_stock": "stock-waste",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 420
      }
    }
  ],
  "variables": [
    {
      "id": "var-throughput",
      "name": "throughput",
      "equation": "50",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-depr",
      "name": "depreciation_rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 280
      }
    },
    {
      "id": "var-extr",
      "name": "extraction_rate",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-regen",
      "name": "regeneration_rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-capacity",
      "name": "resource_capacity",
      "equation": "15000",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-assim",
      "name": "assimilation_rate",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 420
      }
    },
    {
      "id": "var-service",
      "name": "Service_Flow",
      "equation": "Artifact_Stock * service_efficiency",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "var-efficiency",
      "name": "service_efficiency",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 150
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Natural_Resources",
      "to_element": "Production"
    },
    {
      "id": "conn-2",
      "from_element": "Artifact_Stock",
      "to_element": "Service_Flow"
    },
    {
      "id": "conn-3",
      "from_element": "Waste_Sink",
      "to_element": "Waste_Assimilation"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 1
  },
  "source": "https://doi.org/10.1016/0921-8009(91)90040-K",
  "reference": "Daly HE. Steady-State Economics. 2nd ed. Island Press; 1991. Originally 1977."
}