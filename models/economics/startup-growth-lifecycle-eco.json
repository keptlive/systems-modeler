{
  "id": "startup-growth-lifecycle-eco",
  "name": "Startup Growth Lifecycle Model",
  "description": "Model of startup company growth through funding rounds, hiring, and product-market fit. Reference: Blank, S. (2013). The Four Steps to the Epiphany. K&S Ranch. Source: https://steveblank.com/",
  "stocks": [
    {
      "id": "s1",
      "name": "Cash",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Employees",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Users",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "s4",
      "name": "Revenue",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Funding",
      "equation": "IF(Cash < Runway_Threshold, Funding_Round, 0)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Burn_Rate",
      "equation": "Monthly_Burn * Employees",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "f3",
      "name": "Hiring",
      "equation": "IF(Cash > Hiring_Threshold, Hire_Rate * Employees, 0)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "f4",
      "name": "Attrition",
      "equation": "Attrition_Rate * Employees",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "f5",
      "name": "User_Growth",
      "equation": "Viral_Coefficient * Users + Marketing_Effectiveness * Marketing_Spend",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "f6",
      "name": "User_Churn",
      "equation": "User_Churn_Rate * Users",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 150
      }
    },
    {
      "id": "f7",
      "name": "Revenue_Growth",
      "equation": "ARPU * Users - Revenue",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Monthly_Burn",
      "equation": "10000",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Funding_Round",
      "equation": "2000000",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Runway_Threshold",
      "equation": "500000",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "v4",
      "name": "Hire_Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Hiring_Threshold",
      "equation": "1000000",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "v6",
      "name": "Attrition_Rate",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Viral_Coefficient",
      "equation": "0.05",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Marketing_Spend",
      "equation": "0.1 * Cash",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "v9",
      "name": "Marketing_Effectiveness",
      "equation": "0.001",
      "position": {
        "x": 650,
        "y": 100
      }
    },
    {
      "id": "v10",
      "name": "User_Churn_Rate",
      "equation": "0.05",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "v11",
      "name": "ARPU",
      "equation": "10",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "v12",
      "name": "Runway_Months",
      "equation": "Cash / (Monthly_Burn * Employees)",
      "position": {
        "x": 150,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 60,
    "dt": 1,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:23:21.190179+00:00",
  "updated_at": "2026-01-12T11:23:21.190179+00:00",
  "source": "https://doi.org/10.1257/jep.15.4.145",
  "reference": "Gompers P, Lerner J. The venture capital revolution. Journal of Economic Perspectives. 2001;15(4):145-168."
}