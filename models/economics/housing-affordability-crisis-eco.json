{
  "id": "housing-affordability-crisis-eco",
  "name": "Housing Affordability Crisis Model",
  "description": "Models the dynamics of housing affordability including supply constraints, zoning regulations, investor speculation, wage-price gaps, and the rent vs buy decision. Based on urban economics research and housing market analysis.",
  "source": "https://doi.org/10.1257/jep.32.1.3",
  "reference": "Glaeser EL, Gyourko J. The economic implications of housing supply. Journal of Economic Perspectives. 2018. Case-Shiller housing research.",
  "stocks": [
    {"id": "stock-housing-stock", "name": "Housing Stock", "initial_value": 1000000, "equation": "", "position": {"x": 100, "y": 100}},
    {"id": "stock-households", "name": "Households", "initial_value": 1100000, "equation": "", "position": {"x": 100, "y": 250}},
    {"id": "stock-home-prices", "name": "Home Prices", "initial_value": 300000, "equation": "", "position": {"x": 300, "y": 175}},
    {"id": "stock-construction-pipeline", "name": "Construction Pipeline", "initial_value": 20000, "equation": "", "position": {"x": 250, "y": 100}},
    {"id": "stock-renter-households", "name": "Renter Households", "initial_value": 400000, "equation": "", "position": {"x": 450, "y": 250}},
    {"id": "stock-investor-owned", "name": "Investor Owned Units", "initial_value": 100000, "equation": "", "position": {"x": 450, "y": 100}}
  ],
  "flows": [
    {"id": "flow-construction-starts", "name": "Construction Starts", "equation": "Permitted_Starts * (Price_Signal / Zoning_Constraint)", "from_stock": null, "to_stock": "stock-construction-pipeline", "position": {"x": 175, "y": 50}},
    {"id": "flow-completions", "name": "Completions", "equation": "Construction_Pipeline / Construction_Time", "from_stock": "stock-construction-pipeline", "to_stock": "stock-housing-stock", "position": {"x": 175, "y": 100}},
    {"id": "flow-depreciation", "name": "Depreciation", "equation": "Housing_Stock * Depreciation_Rate", "from_stock": "stock-housing-stock", "to_stock": null, "position": {"x": 100, "y": 150}},
    {"id": "flow-household-formation", "name": "Household Formation", "equation": "Formation_Rate * Population_Base", "from_stock": null, "to_stock": "stock-households", "position": {"x": 100, "y": 300}},
    {"id": "flow-price-change", "name": "Price Change", "equation": "Home_Prices * Supply_Demand_Gap / Price_Adjustment_Time", "from_stock": null, "to_stock": "stock-home-prices", "position": {"x": 300, "y": 125}},
    {"id": "flow-investor-purchases", "name": "Investor Purchases", "equation": "Investment_Rate * (Expected_Return - Risk_Free_Rate)", "from_stock": null, "to_stock": "stock-investor-owned", "position": {"x": 450, "y": 50}}
  ],
  "variables": [
    {"id": "var-permitted-starts", "name": "Permitted_Starts", "equation": "30000", "position": {"x": 175, "y": 25}},
    {"id": "var-price-signal", "name": "Price_Signal", "equation": "Home_Prices / 300000", "position": {"x": 250, "y": 50}},
    {"id": "var-zoning", "name": "Zoning_Constraint", "equation": "1.5", "position": {"x": 325, "y": 50}},
    {"id": "var-construction-time", "name": "Construction_Time", "equation": "24", "position": {"x": 175, "y": 150}},
    {"id": "var-depreciation", "name": "Depreciation_Rate", "equation": "0.02", "position": {"x": 50, "y": 150}},
    {"id": "var-formation-rate", "name": "Formation_Rate", "equation": "0.01", "position": {"x": 50, "y": 300}},
    {"id": "var-population", "name": "Population_Base", "equation": "3000000", "position": {"x": 50, "y": 350}},
    {"id": "var-median-income", "name": "Median_Income", "equation": "70000", "position": {"x": 175, "y": 300}},
    {"id": "var-supply-demand-gap", "name": "Supply_Demand_Gap", "equation": "(Households - Housing_Stock) / Housing_Stock * 0.1", "position": {"x": 200, "y": 200}},
    {"id": "var-price-adj", "name": "Price_Adjustment_Time", "equation": "12", "position": {"x": 375, "y": 125}},
    {"id": "var-investment-rate", "name": "Investment_Rate", "equation": "10000", "position": {"x": 525, "y": 50}},
    {"id": "var-expected-return", "name": "Expected_Return", "equation": "0.08", "position": {"x": 525, "y": 100}},
    {"id": "var-risk-free", "name": "Risk_Free_Rate", "equation": "0.04", "position": {"x": 525, "y": 150}}
  ],
