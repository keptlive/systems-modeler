{
  "id": "financial-contagion-systemic-risk-eco",
  "name": "Financial Contagion and Systemic Risk Model",
  "description": "Model of financial contagion through interbank networks. Explores how shocks propagate through the financial system. Source: Allen & Gale (2000), JPE. DOI: 10.1086/262109",
  "stocks": [
    {
      "id": "stock-b1",
      "name": "Bank_1_Assets",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "stock-b2",
      "name": "Bank_2_Assets",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-b3",
      "name": "Bank_3_Assets",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "stock-b4",
      "name": "Bank_4_Assets",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "id": "stock-failures",
      "name": "Bank_Failures",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-shock1",
      "name": "Shock_To_Bank_1",
      "equation": "IF(TIME > Shock_Time AND TIME < Shock_Time + 1, Initial_Shock, 0)",
      "from_stock": "stock-b1",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-contagion12",
      "name": "Contagion_1_to_2",
      "equation": "MAX(0, (Failure_Threshold - Bank_1_Assets) * Interbank_Exposure)",
      "from_stock": "stock-b2",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-contagion23",
      "name": "Contagion_2_to_3",
      "equation": "MAX(0, (Failure_Threshold - Bank_2_Assets) * Interbank_Exposure)",
      "from_stock": "stock-b3",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-contagion34",
      "name": "Contagion_3_to_4",
      "equation": "MAX(0, (Failure_Threshold - Bank_3_Assets) * Interbank_Exposure)",
      "from_stock": "stock-b4",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-shock-time",
      "name": "Shock_Time",
      "equation": "10",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-init-shock",
      "name": "Initial_Shock",
      "equation": "80",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "var-threshold",
      "name": "Failure_Threshold",
      "equation": "20",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-exposure",
      "name": "Interbank_Exposure",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Bank_1_Assets",
      "to_element": "Contagion_1_to_2"
    },
    {
      "id": "conn-2",
      "from_element": "Bank_2_Assets",
      "to_element": "Contagion_2_to_3"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-11T22:11:19.083072Z",
  "updated_at": "2026-01-11T22:11:19.083080Z",
  "source": "https://doi.org/10.1086/262109",
  "reference": "Allen, F. & Gale, D. (2000). Financial Contagion. Journal of Political Economy."
}