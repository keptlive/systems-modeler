{
  "id": "akerlof-yellen-near-rationality-eco",
  "name": "Akerlof-Yellen Near Rationality Model",
  "description": "Shows how small deviations from rationality can have large macroeconomic effects. Reference: Akerlof, G. A. (1970). The market for lemons. Quarterly Journal of Economics, 84(3), 488-500. DOI: https://doi.org/10.2307/1879431",
  "stocks": [
    {
      "id": "s1",
      "name": "Output_Level",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Price",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Output_Change",
      "equation": "(Demand - Output_Level) / Output_Adj_Time",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Price_Change",
      "equation": "(Optimal_Price - Price) * Adjustment_Fraction / Price_Adj_Time",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
