{
  "id": "bolton-ockenfels-erc-eco",
  "name": "Bolton-Ockenfels ERC Model",
  "description": "Equity, Reciprocity, and Competition (ERC) model showing how relative payoff share affects utility. Reference: Bolton, G.E. & Ockenfels, A. (2000). ERC.",
  "stocks": [
    {
      "id": "s1",
      "name": "Own_Payoff",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Other_Payoff",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "ERC_Utility",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Own_Earnings",
      "equation": "Own_Share * Total_Pie",
      "from_stock": null,
      "to_stock": "Own_Payoff",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Other_Earnings",
      "equation": "(1 - Own_Share) * Total_Pie",
      "from_stock": null,
      "to_stock": "Other_Payoff",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Utility_Update",
      "equation": "Motivation_Function",
      "from_stock": null,
      "to_stock": "ERC_Utility",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Total_Pie",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Own_Share",
      "equation": "0.5 + 0.3 * SIN(time / 8)",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Relative_Share",
      "equation": "Own_Payoff / MAX(1, Own_Payoff + Other_Payoff)",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Fair_Share",
      "equation": "0.5",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Share_Deviation",
      "equation": "Relative_Share - Fair_Share",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Motivation_Function",
      "equation": "Own_Payoff - 0.5 * (Share_Deviation)^2",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Sigma",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1257/aer.90.1.166",
  "reference": "Bolton, G.E. & Ockenfels, A. (2000). ERC: A Theory of Equity, Reciprocity, and Competition. American Economic Review, 90(1), 166-193.",
