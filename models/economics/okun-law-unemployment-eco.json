{
  "id": "okun-law-unemployment-eco",
  "name": "Okun's Law Unemployment-Output",
  "description": "Empirical relationship between unemployment and GDP gap. For every 1% unemployment above natural rate, output is about 2% below potential. Key macroeconomic policy relationship. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "stock-gdp",
      "name": "Real GDP",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-unemployment",
      "name": "Unemployment Rate",
      "initial_value": 0.05,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-gdp-growth",
      "name": "GDP Growth",
      "equation": "Real_GDP * (Trend_Growth + Demand_Shock)",
      "from_stock": null,
      "to_stock": "stock-gdp",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "flow-unemployment-change",
      "name": "Unemployment Change",
      "equation": "-Okun_Coefficient * Output_Gap_Change",
      "from_stock": null,
      "to_stock": "stock-unemployment",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-potential",
      "name": "Potential GDP",
      "equation": "100 * EXP(Trend_Growth * TIME)",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-output-gap",
      "name": "Output Gap",
      "equation": "(Real_GDP - Potential_GDP) / Potential_GDP",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-gap-change",
      "name": "Output Gap Change",
      "equation": "GDP_Growth / Potential_GDP - Trend_Growth",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-trend",
      "name": "Trend Growth",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-okun",
      "name": "Okun Coefficient",
      "equation": "0.5",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-natural",
      "name": "Natural Unemployment",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-demand-shock",
      "name": "Demand Shock",
      "equation": "0",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "var-unemployment-gap",
      "name": "Unemployment Gap",
      "equation": "Unemployment_Rate - Natural_Unemployment",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "connectors": [
