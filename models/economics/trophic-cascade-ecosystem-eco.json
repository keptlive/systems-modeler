{
  "id": "trophic-cascade-ecosystem-eco",
  "name": "Trophic Cascade Ecosystem Model",
  "description": "Models top-down effects in food webs. Classic ecology from Yellowstone wolves. Source: Ripple & Beschta (2012), Biological Conservation. DOI: 10.1016/j.biocon.2011.11.005",
  "stocks": [
    {
      "id": "stock-apex",
      "name": "Apex_Predators",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "stock-meso",
      "name": "Mesopredators",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "stock-herb",
      "name": "Herbivores",
      "initial_value": 2000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "stock-veg",
      "name": "Vegetation",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 550,
        "y": 100
      }
    }
  ],
  "flows": [
    {
      "id": "flow-apexgrow",
      "name": "Apex_Growth",
      "equation": "Apex_Predators * Apex_Growth_Rate * (Mesopredators / Meso_Capacity)",
      "from_stock": null,
      "to_stock": "stock-apex",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-apexdie",
      "name": "Apex_Death",
      "equation": "Apex_Predators * Apex_Death_Rate",
      "from_stock": "stock-apex",
      "to_stock": null,
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "flow-mesogrow",
      "name": "Meso_Growth",
      "equation": "Mesopredators * Meso_Growth_Rate * (Herbivores / Herb_Capacity) - Apex_Predators * Predation_Apex_Meso",
      "from_stock": null,
      "to_stock": "stock-meso",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-herbgrow",
      "name": "Herb_Growth",
      "equation": "Herbivores * Herb_Growth_Rate * (Vegetation / Veg_Capacity) - Mesopredators * Predation_Meso_Herb - Apex_Predators * Predation_Apex_Herb",
      "from_stock": null,
      "to_stock": "stock-herb",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "flow-veggrow",
      "name": "Veg_Growth",
      "equation": "Vegetation * Veg_Growth_Rate * (1 - Vegetation / Veg_Capacity) - Herbivores * Grazing_Rate",
      "from_stock": null,
      "to_stock": "stock-veg",
      "position": {
        "x": 500,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "var-apexgr",
      "name": "Apex_Growth_Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-apexdr",
      "name": "Apex_Death_Rate",
      "equation": "0.02",
      "position": {
        "x": 175,
        "y": 50
      }
    },
    {
      "id": "var-mesogr",
      "name": "Meso_Growth_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-herbgr",
      "name": "Herb_Growth_Rate",
      "equation": "0.15",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-veggr",
      "name": "Veg_Growth_Rate",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "var-mesocap",
