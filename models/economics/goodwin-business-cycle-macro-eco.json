{
  "id": "goodwin-business-cycle-macro-eco",
  "name": "Goodwin Class Struggle Business Cycle",
  "description": "Marxian business cycle model with predator-prey dynamics between wages and employment. Source: Goodwin (1967).",
  "stocks": [
    {
      "id": "s1",
      "name": "Employment_Rate",
      "initial_value": 0.9,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Wage_Share",
      "initial_value": 0.6,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Employment_Change",
      "equation": "Employment_Rate * (Capital_Growth_Rate - alpha - beta)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Wage_Share_Change",
      "equation": "Wage_Share * (Phillips_Curve - alpha)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "alpha",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "beta",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "sigma",
      "equation": "3.0",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "rho",
      "equation": "1.0",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "gamma",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Capital_Growth_Rate",
      "equation": "(1 - Wage_Share) / sigma",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Phillips_Curve",
      "equation": "-gamma + rho * Employment_Rate",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Wage_Share",
      "to_element": "Capital_Growth_Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.1
  },
  "created_at": "2026-01-15T14:36:21.172796+00:00",
  "updated_at": "2026-01-15T14:36:21.172801+00:00",
  "source": "https://doi.org/10.1007/978-1-349-05504-3_12",
  "reference": "Goodwin, R.M. (1967). A Growth Cycle. Cambridge UP."
}