{
  "id": "gig-economy-labor-dynamics-eco",
  "name": "Gig Economy Labor Dynamics",
  "description": "Models worker flows between gig and traditional employment. Source: Katz & Krueger (2019), ILR Review. DOI: 10.1177/0019793918762902",
  "stocks": [
    {
      "id": "stock-trad",
      "name": "Traditional_Workers",
      "initial_value": 80000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-gig",
      "name": "Gig_Workers",
      "initial_value": 15000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "stock-unemp",
      "name": "Unemployed",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-totogig",
      "name": "Trad_To_Gig",
      "equation": "Traditional_Workers * Gig_Transition_Rate",
      "from_stock": "stock-trad",
      "to_stock": "stock-gig",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-gigtotrad",
      "name": "Gig_To_Trad",
      "equation": "Gig_Workers * Trad_Transition_Rate",
      "from_stock": "stock-gig",
      "to_stock": "stock-trad",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-layoff",
      "name": "Layoffs",
      "equation": "Traditional_Workers * Layoff_Rate",
      "from_stock": "stock-trad",
      "to_stock": "stock-unemp",
      "position": {
        "x": 150,
        "y": 175
      }
    },
    {
      "id": "flow-gigend",
      "name": "Gig_Exit",
      "equation": "Gig_Workers * Gig_Exit_Rate",
      "from_stock": "stock-gig",
      "to_stock": "stock-unemp",
      "position": {
        "x": 350,
        "y": 175
      }
    },
    {
      "id": "flow-hire",
      "name": "Traditional_Hire",
      "equation": "Unemployed * Hire_Rate",
      "from_stock": "stock-unemp",
      "to_stock": "stock-trad",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "flow-gigstart",
      "name": "Gig_Entry",
      "equation": "Unemployed * Gig_Entry_Rate",
      "from_stock": "stock-unemp",
      "to_stock": "stock-gig",
      "position": {
        "x": 300,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-gigtrans",
      "name": "Gig_Transition_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-tradtrans",
      "name": "Trad_Transition_Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-layoff",
      "name": "Layoff_Rate",
      "equation": "0.03",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-gigexit",
      "name": "Gig_Exit_Rate",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 325
      }
    },
    {
      "id": "var-hire",
      "name": "Hire_Rate",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 325
      }
    },
    {
      "id": "var-gigentry",
      "name": "Gig_Entry_Rate",
      "equation": "0.3",
      "position": {
        "x": 300,
        "y": 325
      }
    },
    {
      "id": "var-gigshare",
      "name": "Gig_Share",
      "equation": "Gig_Workers / (Traditional_Workers + Gig_Workers + Unemployed) * 100",
      "position": {
        "x": 250,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Traditional_Workers",
      "to_element": "Trad_To_Gig"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:06:16.308103+00:00",
  "updated_at": "2026-01-12T02:06:16.308106+00:00",
  "source": "https://doi.org/10.1177/0019793918762902",
  "reference": "Katz, L.F. & Krueger, A.B. (2019). The Rise and Nature of Alternative Work. ILR Review."
}