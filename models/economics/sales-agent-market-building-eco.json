{
  "id": "sales-agent-market-building-eco",
  "name": "Sales Agent Market Building Dynamics",
  "description": "A model of how sales agents build markets through relationship development. Shows the dynamics of customer acquisition and the impact of sales effort on market growth. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "source": "https://github.com/SDXorg/PySD-Cookbook",
  "reference": "PySD-Cookbook: Sales Agent Dynamics - Market Building Model",
  "stocks": [
    {
      "id": "stock-prospects",
      "name": "Prospects",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-customers",
      "name": "Customers",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-conversion",
      "name": "Conversion",
      "equation": "Prospects * Sales_Effort * Conversion_Rate",
      "from_stock": "stock-prospects",
      "to_stock": "stock-customers",
      "position": {
        "x": 250,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-sales-effort",
      "name": "Sales Effort",
      "equation": "0.1",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-conversion-rate",
      "name": "Conversion Rate",
      "equation": "0.01",
      "position": {
        "x": 350,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
