{
  "id": "aghion-howitt-creative-destruction-eco",
  "name": "Aghion-Howitt Creative Destruction",
  "description": "Growth through quality-improving innovations that destroy previous technology. Research creates new products that make old ones obsolete. Explains growth and firm dynamics. Reference: Aghion, P., & Howitt, P. (1992). A model of growth through creative destruction. Econometrica, 60(2), 323-351. DOI: https://doi.org/10.2307/2951599",
  "stocks": [
    {
      "id": "stock-productivity",
      "name": "Leading Edge Productivity",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-research",
      "name": "Research Intensity",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-innovation",
      "name": "Innovation",
      "equation": "Innovation_Rate * (Step_Size - 1) * Leading_Edge_Productivity",
      "from_stock": null,
      "to_stock": "stock-productivity",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "flow-research-change",
      "name": "Research Adjustment",
      "equation": "Adjustment_Speed * (Optimal_Research - Research_Intensity)",
      "from_stock": null,
      "to_stock": "stock-research",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-innovation-rate",
      "name": "Innovation Rate",
      "equation": "Research_Intensity * Research_Productivity",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-step-size",
      "name": "Step Size",
      "equation": "1.05",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-research-prod",
      "name": "Research Productivity",
      "equation": "0.2",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-optimal-research",
      "name": "Optimal Research",
      "equation": "1 - (Interest_Rate + Innovation_Rate) / (Step_Size * Monopoly_Profit)",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-monopoly-profit",
      "name": "Monopoly Profit",
      "equation": "0.2",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-interest",
      "name": "Interest Rate",
      "equation": "0.05",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-growth-rate",
      "name": "Growth Rate",
      "equation": "Innovation_Rate * LOG(Step_Size)",
      "position": {
        "x": 100,
        "y": 420
      }
    },
    {
      "id": "var-creative-destruction",
      "name": "Creative Destruction Rate",
      "equation": "Innovation_Rate",
      "position": {
        "x": 350,
        "y": 420
      }
    },
    {
      "id": "var-adjust",
      "name": "Adjustment Speed",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Research Intensity",
      "to_element": "Innovation Rate"
    },
    {
      "id": "conn-2",
      "from_element": "Innovation Rate",
      "to_element": "Innovation"
    },
    {
      "id": "conn-3",
      "from_element": "Innovation Rate",
      "to_element": "Creative Destruction Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
