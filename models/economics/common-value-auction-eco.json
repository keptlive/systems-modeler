{
  "id": "common-value-auction-eco",
  "name": "Common Value Auction Model",
  "description": "Models bidding dynamics in auctions with winner's curse. Based on Milgrom & Weber (1982). DOI: 10.2307/1911865",
  "stocks": [
    {
      "id": "stock-avgbid",
      "name": "Average_Bid",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-winbid",
      "name": "Winning_Bid",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "stock-profit",
      "name": "Winner_Profit",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "stock-learning",
      "name": "Bidder_Experience",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-bidadj",
      "name": "Bid_Adjustment",
      "equation": "(Signal_Value - Average_Bid) * Adjustment_Rate * (1 + Bidder_Experience / 100)",
      "from_stock": null,
      "to_stock": "stock-avgbid",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-winbidadj",
      "name": "Winning_Bid_Update",
      "equation": "(Average_Bid * (1 + Competition_Premium) - Winning_Bid) * 0.5",
      "from_stock": null,
      "to_stock": "stock-winbid",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-profitcalc",
      "name": "Profit_Realization",
      "equation": "True_Value - Winning_Bid",
      "from_stock": null,
      "to_stock": "stock-profit",
      "position": {
        "x": 450,
        "y": 175
      }
    },
    {
      "id": "flow-learning",
      "name": "Experience_Gain",
      "equation": "IF(Winner_Profit < 0, -Winner_Profit * 0.1, Winner_Profit * 0.05)",
      "from_stock": null,
      "to_stock": "stock-learning",
      "position": {
        "x": 100,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-truevalue",
      "name": "True_Value",
      "equation": "50 + 10 * SIN(TIME / 20)",
      "position": {
        "x": 350,
        "y": 175
      }
    },
    {
      "id": "var-signalval",
      "name": "Signal_Value",
      "equation": "True_Value + Signal_Noise",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-signoise",
      "name": "Signal_Noise",
      "equation": "5 * SIN(TIME / 3)",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-adjrate",
      "name": "Adjustment_Rate",
      "equation": "0.3",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-compprem",
      "name": "Competition_Premium",
      "equation": "0.2 / (1 + Number_of_Bidders / 10)",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-numbidders",
      "name": "Number_of_Bidders",
      "equation": "5",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-winnercurse",
      "name": "Winners_Curse",
      "equation": "Winning_Bid - True_Value",
      "position": {
        "x": 500,
        "y": 175
      }
    },
    {
      "id": "var-optbidshade",
      "name": "Optimal_Bid_Shade",
      "equation": "Signal_Noise * Number_of_Bidders / (Number_of_Bidders + 1)",
      "position": {
        "x": 300,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Average_Bid",
      "to_element": "Winning_Bid_Update"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-12T02:49:51.600194+00:00",
  "updated_at": "2026-01-12T02:49:51.600201+00:00",
  "source": "https://doi.org/10.2307/1911865",
  "reference": "Milgrom PR, Weber RJ (1982). A Theory of Auctions and Competitive Bidding. Econometrica."
}