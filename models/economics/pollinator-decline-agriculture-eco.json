{
  "id": "pollinator-decline-agriculture-eco",
  "name": "Pollinator Decline and Food Security",
  "description": "Models bee population decline effects on crop pollination. Source: Potts et al. (2010), Trends in Ecology & Evolution. DOI: 10.1016/j.tree.2010.01.007",
  "stocks": [
    {
      "id": "stock-bees",
      "name": "Bee_Population",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-habitat",
      "name": "Habitat_Quality",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-crops",
      "name": "Pollinated_Crop_Yield",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-beegrow",
      "name": "Bee_Reproduction",
      "equation": "Bee_Population * Reproduction_Rate * Habitat_Quality / 100",
      "from_stock": null,
      "to_stock": "stock-bees",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-beedecline",
      "name": "Bee_Mortality",
      "equation": "Bee_Population * (Base_Mortality + Pesticide_Effect + Disease_Effect)",
      "from_stock": "stock-bees",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-habdecl",
      "name": "Habitat_Loss",
      "equation": "Habitat_Quality * Land_Conversion_Rate",
      "from_stock": "stock-habitat",
      "to_stock": null,
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "flow-habrest",
      "name": "Habitat_Restoration",
      "equation": "Conservation_Effort * (100 - Habitat_Quality) / 100",
      "from_stock": null,
      "to_stock": "stock-habitat",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "flow-cropchg",
      "name": "Crop_Yield_Change",
      "equation": "(Pollination_Service - Pollinated_Crop_Yield) * 0.1",
      "from_stock": null,
      "to_stock": "stock-crops",
      "position": {
        "x": 250,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-reprod",
      "name": "Reproduction_Rate",
      "equation": "0.15",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-basemort",
      "name": "Base_Mortality",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-pesticide",
      "name": "Pesticide_Effect",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 125
      }
    },
    {
      "id": "var-disease",
      "name": "Disease_Effect",
      "equation": "0.02",
      "position": {
        "x": 350,
        "y": 75
      }
    },
    {
      "id": "var-landconv",
      "name": "Land_Conversion_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-conserv",
      "name": "Conservation_Effort",
      "equation": "3",
      "position": {
        "x": 350,
        "y": 325
      }
    },
    {
      "id": "var-pollserv",
      "name": "Pollination_Service",
      "equation": "100 * Bee_Population / 1000 * Habitat_Quality / 70",
      "position": {
        "x": 400,
        "y": 175
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Habitat_Quality",
      "to_element": "Bee_Reproduction"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:17:16.214045+00:00",
  "updated_at": "2026-01-12T02:17:16.214048+00:00",
  "source": "https://doi.org/10.1016/j.tree.2010.01.007",
  "reference": "Potts, S.G. et al. (2010). Global pollinator declines: trends, impacts and drivers. Trends in Ecology & Evolution."
}