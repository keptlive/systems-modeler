{
  "id": "information-cascade-herd-behavior-eco",
  "name": "Information Cascade and Herd Behavior",
  "description": "Model of information cascades leading to herd behavior in markets. Source: Bikhchandani et al. (1992), JPE.",
  "stocks": [
    {
      "id": "s1",
      "name": "Cumulative_Signals",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Adoption_Rate",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Cascade_Strength",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Signal_Flow",
      "equation": "New_Agent_Rate * (Signal_Precision * 2 - 1)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Adoption_Update",
      "equation": "0.1 * (Cascade_Probability - Adoption_Rate)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Cascade_Update",
      "equation": "IF(ABS(Cumulative_Signals) > Cascade_Threshold, 0.2, -0.1 * Cascade_Strength)",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Signal_Precision",
      "equation": "0.6",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "New_Agent_Rate",
      "equation": "1.0",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Cascade_Threshold",
      "equation": "3",
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "v4",
      "name": "Cascade_Probability",
      "equation": "0.5 + 0.4 * Cascade_Strength",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Cumulative_Signals",
      "to_element": "Cascade_Probability"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-15T14:36:21.172644+00:00",
  "updated_at": "2026-01-15T14:36:21.172649+00:00",
  "source": "https://doi.org/10.1086/261849",
  "reference": "Bikhchandani, S., Hirshleifer, D. & Welch, I. (1992). A Theory of Fads, Fashion, Custom, and Cultural Change as Informational Cascades. JPE 100:992-1026."
}