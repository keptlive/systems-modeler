      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-value-created",
      "name": "Digital Value Created",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "stock-legacy-systems",
      "name": "Legacy System Debt",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-maturity-growth",
      "name": "Maturity Growth",
      "equation": "Digital_Capability * Investment_Rate * (1 - Organizational_Resistance / 100) * (100 - Digital_Maturity) / 100 / Maturity_Growth_Time",
      "from_stock": null,
      "to_stock": "stock-digital-maturity",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-capability-build",
      "name": "Capability Building",
      "equation": "Training_Investment * (100 - Digital_Capability) / 100 / Capability_Build_Time",
      "from_stock": null,
      "to_stock": "stock-digital-capability",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-capability-decay",
      "name": "Capability Decay",
      "equation": "Digital_Capability * Skill_Obsolescence_Rate",
      "from_stock": "stock-digital-capability",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-resistance-increase",
      "name": "Resistance Increase",
      "equation": "Change_Intensity * (100 - Organizational_Resistance) / 100",
      "from_stock": null,
      "to_stock": "stock-resistance",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-resistance-decrease",
      "name": "Resistance Decrease",
      "equation": "Organizational_Resistance * Change_Management_Effect * Success_Visibility / 100",
      "from_stock": "stock-resistance",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "flow-value-creation",
      "name": "Value Creation",
      "equation": "Digital_Maturity * Business_Model_Innovation * Customer_Experience_Impact / 100",
      "from_stock": null,
      "to_stock": "stock-value-created",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-legacy-retirement",
      "name": "Legacy Retirement",
      "equation": "Legacy_System_Debt * Modernization_Rate * Digital_Maturity / 100",
      "from_stock": "stock-legacy-systems",
      "to_stock": null,
      "position": {
        "x": 50,
        "y": 350
      }
    },
    {
      "id": "flow-legacy-accumulation",
      "name": "Legacy Accumulation",
      "equation": "Technical_Debt_Rate * (1 - Digital_Maturity / 100)",
      "from_stock": null,
      "to_stock": "stock-legacy-systems",
      "position": {
        "x": 150,
        "y": 350
      }
    }
  ],
