{
  "id": "lake-eutrophication-phosphorus-eco",
  "name": "Lake Eutrophication Model",
  "description": "Lake eutrophication model showing how phosphorus loading leads to algal blooms and ecosystem degradation. Models nutrient cycling with sediment feedback. Source: Based on Carpenter (2005), Ecology Letters. DOI: 10.1111/j.1461-0248.2005.00744.x",
  "stocks": [
    {
      "id": "stock-phosphorus-water",
      "name": "Water_Phosphorus",
      "initial_value": 0.02,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-phosphorus-sediment",
      "name": "Sediment_Phosphorus",
      "initial_value": 1.0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "stock-algae",
      "name": "Algae_Biomass",
      "initial_value": 1.0,
      "equation": "",
      "position": {
        "x": 450,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-loading",
      "name": "External_Loading",
      "equation": "External_P_Loading",
      "from_stock": null,
      "to_stock": "stock-phosphorus-water",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-sedimentation",
      "name": "Sedimentation",
      "equation": "Sedimentation_Rate * Water_Phosphorus",
      "from_stock": "stock-phosphorus-water",
      "to_stock": "stock-phosphorus-sediment",
      "position": {
        "x": 200,
        "y": 225
      }
    },
    {
      "id": "flow-recycling",
      "name": "Internal_Recycling",
      "equation": "Recycling_Rate * Sediment_Phosphorus * (Water_Phosphorus / (Water_Phosphorus + Half_Saturation))",
      "from_stock": "stock-phosphorus-sediment",
      "to_stock": "stock-phosphorus-water",
      "position": {
        "x": 280,
        "y": 225
      }
    },
    {
      "id": "flow-outflow",
      "name": "Outflow",
      "equation": "Outflow_Rate * Water_Phosphorus",
      "from_stock": "stock-phosphorus-water",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-algae-growth",
      "name": "Algae_Growth",
      "equation": "Max_Growth_Rate * Algae_Biomass * (Water_Phosphorus / (Water_Phosphorus + Half_Saturation))",
      "from_stock": null,
      "to_stock": "stock-algae",
      "position": {
        "x": 370,
        "y": 150
      }
    },
    {
      "id": "flow-algae-death",
      "name": "Algae_Death",
      "equation": "Death_Rate * Algae_Biomass",
      "from_stock": "stock-algae",
      "to_stock": null,
      "position": {
        "x": 530,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-external-loading",
      "name": "External_P_Loading",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-sedimentation-rate",
      "name": "Sedimentation_Rate",
      "equation": "0.5",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "var-recycling-rate",
      "name": "Recycling_Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-half-saturation",
      "name": "Half_Saturation",
      "equation": "0.01",
      "position": {
        "x": 350,
        "y": 80
      }
    },
    {
      "id": "var-outflow-rate",
      "name": "Outflow_Rate",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-max-growth",
      "name": "Max_Growth_Rate",
      "equation": "1.0",
      "position": {
        "x": 450,
        "y": 80
      }
    },
    {
      "id": "var-death-rate",
      "name": "Death_Rate",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-trophic-state",
      "name": "Trophic_State_Index",
      "equation": "10 * (6 + (LN(Water_Phosphorus * 1000) / LN(2)))",
      "position": {
        "x": 450,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Water_Phosphorus",
      "to_element": "Sedimentation"
    },
    {
      "id": "conn-2",
      "from_element": "Sediment_Phosphorus",
      "to_element": "Internal_Recycling"
    },
    {
      "id": "conn-3",
      "from_element": "Water_Phosphorus",
      "to_element": "Algae_Growth"
    },
    {
      "id": "conn-4",
      "from_element": "Algae_Biomass",
      "to_element": "Algae_Growth"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
