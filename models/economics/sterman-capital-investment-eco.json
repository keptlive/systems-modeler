{
  "id": "sterman-capital-investment-eco",
  "name": "Sterman Capital Investment Ch17",
  "description": "Capital investment and capacity acquisition model from Sterman (2000) Business Dynamics Chapter 17. Shows capital stock adjustment, investment decisions, and capacity utilization dynamics. Reference: Sterman, J. D. (2000). Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill. Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Capital_Stock",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Capital_Under_Construction",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Orders_Backlog",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Capital_Orders",
      "equation": "MAX(0, Desired_Capital_Orders)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Capital_Delivery",
      "equation": "Capital_Under_Construction / Construction_Time",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 225,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Depreciation",
      "equation": "Capital_Stock / Capital_Lifetime",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "New_Orders",
      "equation": "Order_Rate",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Shipments",
      "equation": "MIN(Production_Capacity, Orders_Backlog / Minimum_Delivery_Time)",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Production_Capacity",
      "equation": "Capital_Stock * Output_Per_Unit_Capital",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Output_Per_Unit_Capital",
      "equation": "1",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v3",
      "name": "Capacity_Utilization",
      "equation": "Shipments / MAX(1, Production_Capacity)",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Desired_Capacity",
      "equation": "Order_Rate / Target_Utilization",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Target_Utilization",
      "equation": "0.85",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "v6",
      "name": "Capacity_Gap",
      "equation": "Desired_Capacity - Capital_Stock - Capital_Under_Construction",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Desired_Capital_Orders",
      "equation": "Capacity_Gap / Capital_Adjustment_Time + Depreciation",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Capital_Adjustment_Time",
      "equation": "12",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Construction_Time",
      "equation": "24",
      "position": {
        "x": 225,
        "y": 300
      }
    },
    {
      "id": "v10",
      "name": "Capital_Lifetime",
      "equation": "120",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v11",
      "name": "Order_Rate",
      "equation": "100 + 20 * SIN(TIME / 20)",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "v12",
      "name": "Minimum_Delivery_Time",
      "equation": "4",
      "position": {
        "x": 600,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Desired_Capital_Orders",
      "to_element": "Capital_Orders"
    },
    {
      "id": "conn-2",
      "from_element": "Capital_Under_Construction",
      "to_element": "Capital_Delivery"
    },
    {
      "id": "conn-3",
      "from_element": "Construction_Time",
      "to_element": "Capital_Delivery"
    },
    {
      "id": "conn-4",
      "from_element": "Capital_Stock",
      "to_element": "Depreciation"
    },
    {
      "id": "conn-5",
      "from_element": "Capital_Lifetime",
      "to_element": "Depreciation"
    },
    {
      "id": "conn-6",
      "from_element": "Order_Rate",
      "to_element": "New_Orders"
    },
    {
      "id": "conn-7",
      "from_element": "Production_Capacity",
      "to_element": "Shipments"
    },
    {
      "id": "conn-8",
      "from_element": "Minimum_Delivery_Time",
      "to_element": "Shipments"
    },
    {
      "id": "conn-9",
      "from_element": "Orders_Backlog",
      "to_element": "Shipments"
    },
    {
      "id": "conn-10",
      "from_element": "Capital_Stock",
      "to_element": "Production_Capacity"
    },
    {
      "id": "conn-11",
      "from_element": "Output_Per_Unit_Capital",
      "to_element": "Production_Capacity"
    },
    {
      "id": "conn-12",
      "from_element": "Production_Capacity",
      "to_element": "Capacity_Utilization"
    },
    {
      "id": "conn-13",
      "from_element": "Shipments",
      "to_element": "Capacity_Utilization"
    },
    {
      "id": "conn-14",
      "from_element": "Target_Utilization",
      "to_element": "Desired_Capacity"
    },
    {
      "id": "conn-15",
      "from_element": "Order_Rate",
      "to_element": "Desired_Capacity"
    },
    {
      "id": "conn-16",
