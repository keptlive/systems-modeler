{
  "id": "keeling-whaling-eco",
  "name": "Whale Population Harvesting Model",
  "description": "Classic renewable resource harvesting model applied to whale populations, demonstrating optimal yield concepts and stock collapse dynamics. Based on models used by International Whaling Commission for quota setting. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "stock-whale-population",
      "name": "Whale Population",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-net-growth",
      "name": "Natural Growth",
      "equation": "Intrinsic_Growth_Rate * Whale_Population * (1 - Whale_Population / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-whale-population",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-harvest",
      "name": "Harvest",
      "equation": "Harvest_Effort * Catchability * Whale_Population",
      "from_stock": "stock-whale-population",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-intrinsic-growth",
      "name": "Intrinsic Growth Rate",
      "equation": "0.05",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-carrying-capacity",
      "name": "Carrying Capacity",
      "equation": "150000",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-harvest-effort",
      "name": "Harvest Effort",
      "equation": "100",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-catchability",
      "name": "Catchability",
      "equation": "0.00001",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "var-msy",
      "name": "Maximum Sustainable Yield",
      "equation": "Intrinsic_Growth_Rate * Carrying_Capacity / 4",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-msy-population",
      "name": "MSY Population Level",
      "equation": "Carrying_Capacity / 2",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-current-yield",
      "name": "Current Yield",
      "equation": "Harvest",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-sustainable",
      "name": "Is Sustainable",
      "equation": "IF Harvest < Natural_Growth THEN 1 ELSE 0",
      "position": {
        "x": 350,
        "y": 400
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Whale Population",
      "to_element": "Natural Growth"
    },
    {
      "id": "conn-2",
      "from_element": "Whale Population",
      "to_element": "Harvest"
    },
    {
      "id": "conn-3",
      "from_element": "Harvest Effort",
      "to_element": "Harvest"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T01:30:00.000Z",
  "updated_at": "2026-01-12T01:30:00.000Z",
  "source": "https://doi.org/10.1126/science.205.4403.267",
  "reference": "Clark CW. Mathematical Bioeconomics: The Optimal Management of Renewable Resources. Wiley, 1976. IWC Scientific Committee reports."
}