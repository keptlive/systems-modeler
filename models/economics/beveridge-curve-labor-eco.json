{
  "id": "beveridge-curve-labor-eco",
  "name": "Beveridge Curve Labor Market Model",
  "description": "Relationship between unemployment and job vacancies, showing labor market tightness and matching efficiency. Reference: BLS Employment Situation. Source: https://www.bls.gov/",
  "stocks": [
    {
      "id": "s1",
      "name": "Unemployed",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Vacancies",
      "initial_value": 4000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Employed",
      "initial_value": 95000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Separations",
      "equation": "Separation_Rate * Employed",
      "from_stock": "s3",
      "to_stock": "s1",
      "position": {
        "x": 150,
        "y": 225
      }
    },
    {
      "id": "f2",
      "name": "Hires",
      "equation": "Matching_Function",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 250,
        "y": 225
      }
    },
    {
      "id": "f3",
      "name": "Vacancy_Filling",
      "equation": "Matching_Function",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 225
      }
    },
    {
      "id": "f4",
      "name": "Vacancy_Creation",
      "equation": "Vacancy_Rate * Labor_Force - Vacancies",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 450,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Matching_Function",
      "equation": "Matching_Efficiency * (Unemployed ^ Alpha_M) * (Vacancies ^ (1 - Alpha_M))",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Matching_Efficiency",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Alpha_M",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Separation_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "v5",
      "name": "Vacancy_Rate",
      "equation": "0.04",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "v6",
      "name": "Labor_Force",
      "equation": "Employed + Unemployed",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Unemployment_Rate",
      "equation": "Unemployed / Labor_Force",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Vacancy_Rate_Actual",
      "equation": "Vacancies / Labor_Force",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:20:56.316302+00:00",
  "updated_at": "2026-01-12T11:20:56.316302+00:00",
  "source": "https://doi.org/10.2307/2534320",
  "reference": "Blanchard OJ, Diamond P. The Beveridge Curve. Brookings Papers on Economic Activity. 1989;1:1-76. Based on Beveridge WH (1944)."
}