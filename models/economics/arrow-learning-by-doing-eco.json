{
  "id": "arrow-learning-by-doing-eco",
  "name": "Arrow Learning by Doing Model",
  "description": "Kenneth Arrow's (1962) seminal model of endogenous technological progress through learning by doing. Productivity improves as cumulative production increases, creating increasing returns and path dependence. Arrow received the 1972 Nobel Prize.",
  "stocks": [
    {"id": "stock-cumulative-output", "name": "Cumulative Output", "initial_value": 100, "equation": "", "position": {"x": 300, "y": 200}},
    {"id": "stock-capital", "name": "Capital", "initial_value": 50, "equation": "", "position": {"x": 500, "y": 200}}
  ],
  "flows": [
    {"id": "flow-output-flow", "name": "Output Flow", "equation": "Output", "from_stock": null, "to_stock": "stock-cumulative-output", "position": {"x": 200, "y": 200}},
    {"id": "flow-investment", "name": "Investment", "equation": "Investment_Rate * Output", "from_stock": null, "to_stock": "stock-capital", "position": {"x": 400, "y": 200}},
    {"id": "flow-depreciation", "name": "Depreciation", "equation": "Depreciation_Rate * Capital", "from_stock": "stock-capital", "to_stock": null, "position": {"x": 600, "y": 200}}
  ],
  "variables": [
    {"id": "var-learning-index", "name": "Learning Index", "equation": "Cumulative_Output ^ Learning_Elasticity", "position": {"x": 200, "y": 100}},
    {"id": "var-learning-elasticity", "name": "Learning Elasticity", "equation": "0.3", "position": {"x": 350, "y": 100}},
    {"id": "var-output", "name": "Output", "equation": "Learning_Index * Capital ^ Capital_Elasticity * Labor ^ Labor_Elasticity", "position": {"x": 500, "y": 100}},
    {"id": "var-capital-elasticity", "name": "Capital Elasticity", "equation": "0.4", "position": {"x": 650, "y": 100}},
    {"id": "var-labor-elasticity", "name": "Labor Elasticity", "equation": "0.3", "position": {"x": 200, "y": 300}},
    {"id": "var-labor", "name": "Labor", "equation": "100", "position": {"x": 350, "y": 300}},
    {"id": "var-investment-rate", "name": "Investment Rate", "equation": "0.25", "position": {"x": 500, "y": 300}},
    {"id": "var-depreciation-rate", "name": "Depreciation Rate", "equation": "0.05", "position": {"x": 650, "y": 300}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 100, "dt": 0.25},
  "source": "https://doi.org/10.2307/2295952",
  "reference": "Arrow KJ. The Economic Implications of Learning by Doing. Review of Economic Studies. 1962;29(3):155-173."
}
