{
  "id": "kaldor-business-cycle-model-eco",
  "name": "Kaldor Business Cycle Model",
  "description": "A nonlinear business cycle model where investment depends on both output level and capital stock. The model generates endogenous cycles through the interaction of investment and savings, capturing boom-bust dynamics in the economy. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-output",
      "name": "Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-capital-stock",
      "name": "Capital Stock",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-output-change",
      "name": "Output Change",
      "equation": "Alpha * (Investment - Savings)",
      "from_stock": null,
      "to_stock": "stock-output",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-investment",
      "name": "Investment",
      "equation": "Investment_Function",
      "from_stock": null,
      "to_stock": "stock-capital-stock",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-depreciation",
      "name": "Depreciation",
      "equation": "Delta * \"Capital Stock\"",
      "from_stock": "stock-capital-stock",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-savings",
      "name": "Savings",
      "equation": "s * Output",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-investment-function",
      "name": "Investment Function",
      "equation": "I0 + I1 * Output - I2 * \"Capital Stock\" + I3 * Output^2 / (1 + Output^2 / K^2)",
