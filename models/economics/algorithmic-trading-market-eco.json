{
  "id": "algorithmic-trading-market-eco",
  "name": "Algorithmic Trading Market Dynamics Model",
  "description": "Model of high-frequency trading impacts on market dynamics showing price discovery, liquidity, and flash crash potential. Based on Kirilenko et al. (2017). Reference: Hendershott, T., et al. (2011). Does Algorithmic Trading Improve Liquidity? Journal of Finance. Source: https://doi.org/10.1111/j.1540-6261.2010.01624.x",
  "stocks": [
    {
      "id": "s1",
      "name": "Market Price",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Order Book Depth",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "HFT Inventory",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Price Change",
      "equation": "(Order_Imbalance / Order_Book_Depth) * Price_Impact",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Liquidity Provision",
      "equation": "HFT_Market_Making * (1 - Volatility_Effect)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Liquidity Withdrawal",
      "equation": "Order_Book_Depth * Withdrawal_Rate * Stress_Indicator",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "HFT Trading",
      "equation": "Momentum_Signal * HFT_Aggressiveness",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "f5",
      "name": "HFT Unwinding",
      "equation": "HFT_Inventory / Holding_Time",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Order Imbalance",
      "equation": "Buy_Orders - Sell_Orders",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Buy Orders",
      "equation": "500 + 50 * SIN(TIME)",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v3",
      "name": "Sell Orders",
      "equation": "500 - 50 * SIN(TIME)",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "v4",
      "name": "Price Impact",
      "equation": "0.01",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "HFT Market Making",
      "equation": "100",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Volatility Effect",
      "equation": "MIN(1, ABS(Price_Change) / 5)",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Withdrawal Rate",
      "equation": "0.1",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Stress Indicator",
      "equation": "IF(ABS(Price_Change) > 2, 3, 1)",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "v9",
      "name": "Momentum Signal",
      "equation": "DELAY(Price_Change, 0.01)",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "HFT Aggressiveness",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "v11",
      "name": "Holding Time",
      "equation": "0.001",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Order Book Depth",
      "to_element": "Price Change"
    },
    {
      "id": "c2",
      "from_element": "Market Price",
      "to_element": "Volatility Effect"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 1,
    "dt": 0.0001
  },
  "created_at": "2026-01-12T01:45:26.877440+00:00",
  "updated_at": "2026-01-12T01:45:26.877443+00:00",
  "source": "https://doi.org/10.1111/jofi.12498",
  "reference": "Kirilenko A, Kyle AS, Samadi M, Tuzun T. The Flash Crash: High-Frequency Trading in an Electronic Market. Journal of Finance. 2017;72(3):967-998."
}