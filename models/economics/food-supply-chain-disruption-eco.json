{
  "id": "food-supply-chain-disruption-eco",
  "name": "Food Supply Chain Disruption Model",
  "description": "Model of food supply chain vulnerabilities showing production, distribution, retail, and consumer stockpiling. Based on COVID-19 supply chain experiences. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "s1",
      "name": "Farm Production",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Processing Inventory",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Distribution Centers",
      "initial_value": 150,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Retail Inventory",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s5",
      "name": "Consumer Stockpiles",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Harvesting",
      "equation": "Harvest_Rate * (1 - Labor_Disruption)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "To Processing",
      "equation": "Farm_Production / Farm_Time * (1 - Transport_Disruption)",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "To Distribution",
      "equation": "Processing_Inventory / Process_Time * (1 - Processing_Disruption)",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "To Retail",
      "equation": "Distribution_Centers / Dist_Time",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Consumer Purchase",
      "equation": "Retail_Inventory / Retail_Time * (1 + Panic_Buying_Factor)",
      "from_stock": "s4",
      "to_stock": "s5",
      "position": {
        "x": 625,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Consumption",
      "equation": "Normal_Consumption",
      "from_stock": "s5",
      "to_stock": null,
      "position": {
        "x": 750,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Harvest Rate",
      "equation": "100",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
