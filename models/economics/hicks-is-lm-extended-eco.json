{
  "id": "hicks-is-lm-extended-eco",
  "name": "Hicks IS-LM Model Extended",
  "description": "Extended IS-LM model showing interaction between goods and money markets with dynamic adjustment. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Interest_Rate",
      "initial_value": 0.05,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Price_Level",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Output_Adjustment",
      "equation": "(IS_Equilibrium - Output) / Goods_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Interest_Adjustment",
      "equation": "(LM_Equilibrium - Interest_Rate) / Money_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Price_Adjustment",
      "equation": "Inflation_Rate * Price_Level",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 150,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "IS_Equilibrium",
      "equation": "(Autonomous_Demand - Investment_Sensitivity * Interest_Rate) / (1 - MPC_IS)",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "LM_Equilibrium",
      "equation": "(Money_Supply / Price_Level - Money_Demand_Intercept + Output_Sensitivity * Output) / Interest_Sensitivity",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Autonomous_Demand",
      "equation": "50",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "MPC_IS",
      "equation": "0.75",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Investment_Sensitivity",
      "equation": "500",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Money_Supply",
      "equation": "100",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Money_Demand_Intercept",
      "equation": "50",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Output_Sensitivity",
      "equation": "0.2",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "v9",
      "name": "Interest_Sensitivity",
      "equation": "1000",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "v10",
      "name": "Goods_Adjustment_Time",
      "equation": "1",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "v11",
      "name": "Money_Adjustment_Time",
      "equation": "0.25",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "v12",
      "name": "Inflation_Rate",
      "equation": "0.02 * (Output - Potential_Output) / Potential_Output",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v13",
      "name": "Potential_Output",
      "equation": "100",
      "position": {
        "x": 450,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25,
    "integration_method": "euler"
  },
