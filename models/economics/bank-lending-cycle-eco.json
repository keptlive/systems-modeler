{
  "id": "bank-lending-cycle-eco",
  "name": "Bank Lending Cycle Model",
  "description": "Model of bank credit cycles showing how lending standards, loan losses, and capital requirements create procyclical lending behavior. Based on Adrian & Shin (2010). Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Bank Capital",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Outstanding Loans",
      "initial_value": 800,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Non Performing Loans",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "New Lending",
      "equation": "MAX(0, (Lending_Capacity - Outstanding_Loans) / Lending_Adjustment_Time)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Loan Repayments",
      "equation": "Outstanding_Loans / Average_Loan_Term",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Default Rate",
      "equation": "Outstanding_Loans * Default_Probability",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Loan Write Offs",
      "equation": "Non_Performing_Loans / Write_Off_Time",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Capital Losses",
      "equation": "Loan_Write_Offs",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "f6",
      "name": "Retained Earnings",
      "equation": "Interest_Income - Operating_Costs - Provisions",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Capital Ratio Requirement",
      "equation": "0.08",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Lending Capacity",
      "equation": "Bank_Capital / Capital_Ratio_Requirement",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Lending Adjustment Time",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Average Loan Term",
      "equation": "5",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Default Probability",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Write Off Time",
      "equation": "1",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Interest Rate",
      "equation": "0.05",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Interest Income",
      "equation": "Outstanding_Loans * Interest_Rate",
      "position": {
        "x": 50,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Operating Costs",
      "equation": "Outstanding_Loans * 0.01",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Provisions",
      "equation": "Default_Rate * 0.5",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Bank Capital",
      "to_element": "Lending Capacity"
    },
    {
      "id": "c2",
      "from_element": "Outstanding Loans",
      "to_element": "New Lending"
    },
    {
      "id": "c3",
      "from_element": "Outstanding Loans",
      "to_element": "Default Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.125
  },
