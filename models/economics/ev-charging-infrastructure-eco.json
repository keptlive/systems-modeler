{
  "id": "ev-charging-infrastructure-eco",
  "name": "Electric Vehicle Charging Infrastructure Model",
  "description": "Model of EV charging station deployment showing chicken-and-egg dynamics between EV adoption and charging infrastructure. Based on Sperling & Kurani (2020). Reference: ASCE (2021). Infrastructure Report Card. American Society of Civil Engineers. Source: https://infrastructurereportcard.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Electric Vehicles",
      "initial_value": 2000000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Charging Stations",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Grid Capacity for EVs",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "EV Adoption",
      "equation": "Potential_EV_Buyers * Adoption_Rate * Charging_Availability_Effect",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Station Deployment",
      "equation": "Station_Investment / Cost_per_Station",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Station Retirement",
      "equation": "Charging_Stations / Station_Lifetime",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Grid Expansion",
      "equation": "Grid_Investment_Rate",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Potential EV Buyers",
      "equation": "5000000",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Adoption Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Vehicles per Station",
      "equation": "Electric_Vehicles / MAX(1, Charging_Stations)",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Optimal Ratio",
      "equation": "20",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "v5",
      "name": "Charging Availability Effect",
      "equation": "MIN(1, Optimal_Ratio / Vehicles_per_Station)",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "v6",
      "name": "Station Investment",
      "equation": "Electric_Vehicles * 50 + Government_Subsidy",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Government Subsidy",
      "equation": "100000000",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v8",
      "name": "Cost per Station",
      "equation": "50000",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v9",
      "name": "Station Lifetime",
      "equation": "15",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Grid Investment Rate",
      "equation": "5",
      "position": {
        "x": 500,
        "y": 100
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Electric Vehicles",
      "to_element": "Vehicles per Station"
    },
    {
      "id": "c2",
      "from_element": "Charging Stations",
      "to_element": "Vehicles per Station"
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2050,
    "dt": 0.25
  },
  "created_at": "2026-01-12T01:45:26.877338+00:00",
  "updated_at": "2026-01-12T01:45:26.877341+00:00",
  "source": "https://doi.org/10.1016/j.enpol.2017.04.001",
  "reference": "Sperling D, Kurani KS. The dynamics of EV adoption. Annual Review of Environment and Resources. 2020."
}