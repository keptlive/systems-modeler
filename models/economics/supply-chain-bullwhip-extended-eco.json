{
  "id": "supply-chain-bullwhip-extended-eco",
  "name": "Supply Chain Bullwhip Effect Extended",
  "description": "Extended model of the bullwhip effect showing demand amplification through supply chain stages with realistic ordering policies. Based on Lee et al. (1997) classic paper. DOI: 10.1287/mnsc.43.4.546",
