  "flows": [
    {
      "id": "flow-customer-demand",
      "name": "Customer_Demand",
      "equation": "Base_Demand * (1 + Demand_Variation * SIN(2 * 3.14159 * Time / Demand_Period))",
      "from_stock": "stock-retail-inv",
      "to_stock": null,
      "position": {
        "x": 25,
        "y": 200
      }
    },
    {
      "id": "flow-retail-order",
      "name": "Retail_Order",
      "equation": "MAX(0, Expected_Demand + (Desired_Retail_Inv - Retail_Inventory) / Inv_Adj_Time)",
      "from_stock": "stock-wholesale-inv",
      "to_stock": "stock-retail-inv",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-wholesale-order",
      "name": "Wholesale_Order",
      "equation": "MAX(0, Retail_Order + (Desired_Wholesale_Inv - Wholesale_Inventory) / Inv_Adj_Time)",
      "from_stock": "stock-mfg-inv",
      "to_stock": "stock-wholesale-inv",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-production",
      "name": "Production",
      "equation": "DELAY(Wholesale_Order, Production_Lead_Time)",
      "from_stock": null,
      "to_stock": "stock-mfg-inv",
      "position": {
        "x": 575,
        "y": 200
      }
    }
  ],
