{
  "id": "pharma-supply-chain-covid-eco",
  "name": "Pharmaceutical Supply Chain COVID-19 Resilience Model",
  "description": "System dynamics model of pharmaceutical supply chain during COVID-19 pandemic. Examines disruption propagation and resilience strategies. Source: Hamzehlou (2024), PLoS ONE. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "stocks": [
    {
      "id": "stock-raw",
      "name": "Raw_Materials",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-wip",
      "name": "Work_In_Progress",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-finished",
      "name": "Finished_Goods",
      "initial_value": 800,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-disruption",
      "name": "Disruption_Level",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-procure",
      "name": "Procurement",
      "equation": "MAX(0, Target_Raw - Raw_Materials) * Procurement_Rate * (1 - Disruption_Level)",
      "from_stock": null,
      "to_stock": "stock-raw",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-prod-start",
      "name": "Production_Start",
      "equation": "MIN(Raw_Materials, Production_Capacity * (1 - Disruption_Level * 0.5)) / Production_Time",
      "from_stock": "stock-raw",
      "to_stock": "stock-wip",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-prod-complete",
      "name": "Production_Complete",
      "equation": "Work_In_Progress / WIP_Time",
      "from_stock": "stock-wip",
      "to_stock": "stock-finished",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-ship",
      "name": "Shipments",
      "equation": "MIN(Finished_Goods, Demand) / Shipment_Time",
      "from_stock": "stock-finished",
      "to_stock": null,
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-disrupt-inc",
      "name": "Disruption_Increase",
      "equation": "Shock_Rate",
      "from_stock": null,
      "to_stock": "stock-disruption",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-disrupt-dec",
      "name": "Recovery",
      "equation": "Disruption_Level * Recovery_Rate",
      "from_stock": "stock-disruption",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-target",
      "name": "Target_Raw",
      "equation": "2000",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-procrate",
      "name": "Procurement_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-cap",
      "name": "Production_Capacity",
      "equation": "200",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-prodtime",
      "name": "Production_Time",
      "equation": "2",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "var-wiptime",
      "name": "WIP_Time",
      "equation": "5",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-demand",
      "name": "Demand",
      "equation": "150 + 50 * IF(TIME > 30 AND TIME < 90, 1, 0)",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-shiptime",
      "name": "Shipment_Time",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "var-shock",
      "name": "Shock_Rate",
      "equation": "IF(TIME > 30 AND TIME < 35, 0.1, 0)",
      "position": {
        "x": 150,
        "y": 400
      }
    },
    {
      "id": "var-recrate",
      "name": "Recovery_Rate",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 180,
    "dt": 0.5
  },
  "created_at": "2026-01-12T12:41:31.049152+00:00",
  "updated_at": "2026-01-12T12:41:31.049152+00:00",
  "source": "https://doi.org/10.1038/s41586-020-2012-7",
  "reference": "WHO. COVID-19 Weekly Epidemiological Update. World Health Organization; 2020-2024."
}