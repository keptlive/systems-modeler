{
  "id": "bass-diffusion-extended-eco",
  "name": "Bass Diffusion Model Extended",
  "description": "Frank Bass's 1969 model of new product adoption, extended with market potential dynamics. Shows how innovations spread through a combination of external influence (advertising) and internal influence (word-of-mouth). Foundational for marketing science. Reference: Bass, F. M. (1969). A new product growth for model consumer durables. Management Science, 15(5), 215-227. DOI: https://doi.org/10.1287/mnsc.15.5.215",
  "stocks": [
    {
      "id": "stock-potential-adopters",
      "name": "Potential Adopters",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-adopters",
      "name": "Adopters",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-adoption",
      "name": "Adoption Rate",
      "equation": "Potential_Adopters * (Innovation_Coefficient + Imitation_Coefficient * Adopters / Total_Market)",
      "from_stock": "stock-potential-adopters",
      "to_stock": "stock-adopters",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-innovation-coeff",
      "name": "Innovation Coefficient",
      "equation": "0.03",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-imitation-coeff",
      "name": "Imitation Coefficient",
      "equation": "0.38",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-total-market",
      "name": "Total Market",
      "equation": "Potential_Adopters + Adopters",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-market-penetration",
      "name": "Market Penetration",
      "equation": "Adopters / Total_Market",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "var-peak-time",
      "name": "Peak Adoption Time",
      "equation": "(1 / (Innovation_Coefficient + Imitation_Coefficient)) * LN(Imitation_Coefficient / Innovation_Coefficient)",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-peak-adoption-rate",
      "name": "Peak Adoption Rate",
      "equation": "Total_Market * (Innovation_Coefficient + Imitation_Coefficient)^2 / (4 * Imitation_Coefficient)",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-internal-influence",
      "name": "Internal Influence",
      "equation": "Imitation_Coefficient * Adopters / Total_Market",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-external-influence",
      "name": "External Influence",
      "equation": "Innovation_Coefficient",
      "position": {
        "x": 150,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Potential Adopters",
      "to_element": "Adoption Rate"
    },
    {
      "id": "conn-2",
      "from_element": "Adopters",
      "to_element": "Adoption Rate"
    },
    {
      "id": "conn-3",
      "from_element": "Innovation Coefficient",
      "to_element": "Adoption Rate"
    },
    {
      "id": "conn-4",
      "from_element": "Imitation Coefficient",
      "to_element": "Adoption Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.25
  },
  "created_at": "2026-01-12T01:30:00.000Z",
  "updated_at": "2026-01-12T01:30:00.000Z",
  "source": "https://doi.org/10.1287/mnsc.15.5.215",
  "reference": "Bass FM. A New Product Growth for Model Consumer Durables. Management Science. 1969;15(5):215-227."
}