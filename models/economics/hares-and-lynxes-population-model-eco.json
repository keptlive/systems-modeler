{
  "id": "hares-and-lynxes-population-model-eco",
  "name": "Hares and Lynxes Population Model",
  "description": "Source-backed scalar flattening of Bobby Powers's modular Stella hares/lynxes teaching example. Restores the two original clamped graphical functions; the preserved Euler default matches the original 25-row canonical output. The original nonnegative stock/flow constraints are not represented by this scalar engine, so arbitrary scenarios are not a complete semantic reproduction. Not field-calibrated ecological prediction.",
  "stocks": [
    {
      "id": "stock-hares",
      "name": "Hares",
      "initial_value": 50000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-lynxes",
      "name": "Lynxes",
      "initial_value": 1250,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-hare-births",
      "name": "Hare Births",
      "equation": "Hares * \"Birth Fraction (Hares)\"",
      "from_stock": null,
      "to_stock": "stock-hares",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-hare-deaths",
      "name": "Hare Deaths",
      "equation": "lynxes * hares_killed_per_lynx",
      "from_stock": "stock-hares",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-lynx-births",
      "name": "Lynx Births",
      "equation": "Lynxes * \"Birth Fraction (Lynxes)\"",
      "from_stock": null,
      "to_stock": "stock-lynxes",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-lynx-deaths",
      "name": "Lynx Deaths",
      "equation": "\"Death Fraction (Lynxes)\" * Lynxes",
      "from_stock": "stock-lynxes",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-lynx-harvest",
      "name": "Lynx Harvest",
      "equation": "PULSE(\"Size of One-Time Lynx Harvest\", 4, 0)",
      "from_stock": "stock-lynxes",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-area",
      "name": "Area",
