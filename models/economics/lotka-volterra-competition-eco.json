{
  "id": "lotka-volterra-competition-eco",
  "name": "Lotka-Volterra Competition Model",
  "description": "The Lotka-Volterra model of interspecific competition (1920s-1930s) showing how two species compete for the same limited resource. Demonstrates competitive exclusion principle, coexistence conditions, and the role of niche differentiation. Reference: Lotka, A. J. (1920). Analytical note on certain rhythmic relations in organic systems. PNAS, 6(7), 410-415. DOI: https://doi.org/10.1073/pnas.6.7.410",
  "stocks": [
    {
      "id": "stock-species1",
      "name": "Species 1 Population",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-species2",
      "name": "Species 2 Population",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-species1-growth",
      "name": "Species 1 Net Growth",
      "equation": "r1 * Species_1_Population * (1 - (Species_1_Population + Alpha12 * Species_2_Population) / K1)",
      "from_stock": null,
      "to_stock": "stock-species1",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-species2-growth",
      "name": "Species 2 Net Growth",
      "equation": "r2 * Species_2_Population * (1 - (Species_2_Population + Alpha21 * Species_1_Population) / K2)",
      "from_stock": null,
      "to_stock": "stock-species2",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-r1",
      "name": "r1",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-r2",
      "name": "r2",
      "equation": "0.08",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "var-k1",
      "name": "K1",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "var-k2",
      "name": "K2",
      "equation": "80",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "var-alpha12",
      "name": "Alpha12",
      "equation": "0.8",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-alpha21",
      "name": "Alpha21",
      "equation": "0.6",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-total-pop",
      "name": "Total Population",
      "equation": "Species_1_Population + Species_2_Population",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-species1-fraction",
      "name": "Species 1 Fraction",
      "equation": "Species_1_Population / Total_Population",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "var-coexistence-condition",
      "name": "Coexistence Possible",
      "equation": "IF (K1/K2 > Alpha12 AND K2/K1 > Alpha21) THEN 1 ELSE 0",
      "position": {
        "x": 350,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Species 1 Population",
      "to_element": "Species 1 Net Growth"
    },
    {
      "id": "conn-2",
      "from_element": "Species 2 Population",
      "to_element": "Species 1 Net Growth"
    },
    {
      "id": "conn-3",
      "from_element": "Species 2 Population",
      "to_element": "Species 2 Net Growth"
    },
    {
      "id": "conn-4",
      "from_element": "Species 1 Population",
      "to_element": "Species 2 Net Growth"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.5
  },
  "created_at": "2026-01-12T01:30:00.000Z",
  "updated_at": "2026-01-12T01:30:00.000Z",
  "source": "https://doi.org/10.1073/pnas.16.6.410",
  "reference": "Volterra V. Fluctuations in the Abundance of a Species considered Mathematically. Nature. 1926;118:558-560. Lotka AJ. Elements of Physical Biology. Williams and Wilkins, 1925."
}