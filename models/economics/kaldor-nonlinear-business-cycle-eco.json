{
  "id": "kaldor-nonlinear-business-cycle-eco",
  "name": "Kaldor Nonlinear Business Cycle",
  "description": "Endogenous business cycle model with nonlinear investment function. Source: Kaldor (1940), Economic Journal. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Capital_Stock",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Output_Change",
      "equation": "alpha * (Investment - Savings)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Capital_Accumulation",
      "equation": "Investment - delta * Capital_Stock",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "alpha",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "delta",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "s",
      "equation": "0.2",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Investment",
      "equation": "50 + 30 * TANH((Output - 100) / 20) - 10 * Capital_Stock / Output",
