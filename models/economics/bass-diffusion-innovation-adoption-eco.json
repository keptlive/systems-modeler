{
  "id": "bass-diffusion-innovation-adoption-eco",
  "name": "Bass Diffusion Innovation Adoption Model",
  "description": "Classic model of new product/innovation adoption through advertising and word-of-mouth. Bass 1969. Reference: Bass, F. M. (1969). A new product growth for model consumer durables. Management Science, 15(5), 215-227. DOI: https://doi.org/10.1287/mnsc.15.5.215",
  "stocks": [
    {
      "id": "s1",
      "name": "Potential Adopters",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Adopters",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Adoption from Advertising",
      "equation": "Potential_Adopters * Innovation_Coefficient",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 225,
        "y": 100
      }
    },
    {
      "id": "f2",
      "name": "Adoption from Word of Mouth",
      "equation": "Potential_Adopters * Imitation_Coefficient * Adopters / Total_Market",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 225,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Innovation Coefficient",
      "equation": "0.03",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Imitation Coefficient",
      "equation": "0.38",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Total Market",
      "equation": "Potential_Adopters + Adopters",
      "position": {
        "x": 225,
        "y": 250
      }
    },
    {
      "id": "v4",
      "name": "Total Adoption Rate",
      "equation": "Adoption_from_Advertising + Adoption_from_Word_of_Mouth",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "v5",
      "name": "Market Penetration",
      "equation": "Adopters / Total_Market",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Peak Time Estimate",
      "equation": "LOG((Imitation_Coefficient / Innovation_Coefficient)) / (Innovation_Coefficient + Imitation_Coefficient)",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "v7",
      "name": "Peak Adoption Rate",
      "equation": "Total_Market * (Innovation_Coefficient + Imitation_Coefficient)^2 / (4 * Imitation_Coefficient)",
      "position": {
        "x": 450,
        "y": 150
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Potential Adopters",
      "to_element": "Adoption from Advertising"
    },
    {
      "id": "c2",
      "from_element": "Adopters",
      "to_element": "Adoption from Word of Mouth"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.1
  },
  "created_at": "2026-01-15T14:24:00.397223",
  "updated_at": "2026-01-15T14:24:00.397232",
  "source": "https://doi.org/10.1287/mnsc.15.5.215",
  "reference": "Bass FM. A New Product Growth for Model Consumer Durables. Management Science. 1969;15(5):215-227."
}