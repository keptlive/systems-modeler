{
  "id": "goodwin-growth-cycle-eco",
  "name": "Goodwin Growth Cycle Model",
  "description": "Richard Goodwin's growth cycle model (1967) describes the dynamics of employment and wage share in a capitalist economy. The model produces a predator-prey like oscillation between labor and capital. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1017/CBO9780511559747.009",
  "reference": "Goodwin RM. A Growth Cycle. In: Feinstein CH, ed. Socialism, Capitalism and Economic Growth. Cambridge University Press, 1967.",
  "stocks": [
    {
      "id": "stock-u",
      "name": "Employment Rate",
      "initial_value": 0.9,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-v",
      "name": "Wage Share",
      "initial_value": 0.85,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-du",
      "name": "Employment Change",
      "equation": "Employment_Rate * (1 / sigma - alpha - beta - n - Wage_Share / sigma)",
      "from_stock": null,
      "to_stock": "stock-u",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-dv",
      "name": "Wage Share Change",
      "equation": "Wage_Share * (phillips_a + phillips_b * Employment_Rate / (1 - Employment_Rate) - alpha)",
      "from_stock": null,
      "to_stock": "stock-v",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-sigma",
      "name": "sigma",
      "equation": "3",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-alpha",
      "name": "alpha",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-beta",
      "name": "beta",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-n",
      "name": "n",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-phillips-a",
      "name": "phillips_a",
      "equation": "-0.04",
