{
  "id": "capital-constrained-supply-chain-eco",
  "name": "Purchase_Rate",
  "description": "System dynamics model of supply chain robustness under capital constraints and disruption. Models financial stress, inventory policies, and recovery dynamics. Based on Zhang et al. (2023) Industrial Management & Data Systems. Reference: Based on System Dynamics supply chain models (Sterman, 2000). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Working_Capital",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Inventory_Level",
      "initial_value": 50000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Order_Backlog",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Supplier_Reliability",
      "initial_value": 0.9,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "s5",
      "name": "Financial_Stress",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Revenue_Inflow",
      "equation": "Sales_Rate * Unit_Price",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Cost_Outflow",
      "equation": "Purchase_Rate * Unit_Cost + Operating_Costs",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Purchase_Rate",
      "equation": "MIN(Desired_Purchase * Supplier_Reliability, Working_Capital / Unit_Cost * Purchase_Budget_Fraction)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Sales_Rate",
      "equation": "MIN(Inventory_Level * Sales_Fraction, Customer_Demand)",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "New_Orders",
      "equation": "Customer_Demand",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Order_Fulfillment",
      "equation": "Sales_Rate",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "f7",
      "name": "Reliability_Recovery",
      "equation": "(Normal_Reliability - Supplier_Reliability) / Recovery_Time * (1 - Disruption_Active)",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "f8",
      "name": "Reliability_Shock",
      "equation": "Disruption_Impact * Disruption_Active",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 750,
        "y": 200
      }
    },
    {
      "id": "f9",
      "name": "Stress_Change",
      "equation": "(Target_Stress - Financial_Stress) / Stress_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s5",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Unit_Price",
      "equation": "100",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Unit_Cost",
      "equation": "70",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Operating_Costs",
      "equation": "20000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Customer_Demand",
      "equation": "5000 + 1000 * SIN(TIME / 30)",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Desired_Purchase",
      "equation": "Customer_Demand * 1.1 + (Target_Inventory - Inventory_Level) / Inventory_Adjustment_Time",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Purchase_Budget_Fraction",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Sales_Fraction",
      "equation": "0.2",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Target_Inventory",
      "equation": "60000",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "Inventory_Adjustment_Time",
      "equation": "10",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v10",
      "name": "Normal_Reliability",
      "equation": "0.95",
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "id": "v11",
      "name": "Recovery_Time",
      "equation": "60",
      "position": {
        "x": 650,
        "y": 300
      }
    },
    {
      "id": "v12",
      "name": "Disruption_Active",
      "equation": "PULSE(100, 30)",
      "position": {
        "x": 750,
        "y": 300
      }
    },
    {
      "id": "v13",
      "name": "Disruption_Impact",
      "equation": "0.02",
      "position": {
        "x": 800,
        "y": 200
      }
    },
    {
      "id": "v14",
      "name": "Target_Stress",
      "equation": "MAX(0, 1 - Working_Capital / 500000) + Order_Backlog / 50000",
      "position": {
        "x": 400,
        "y": 500
      }
    },
    {
      "id": "v15",
      "name": "Stress_Adjustment_Time",
      "equation": "7",
      "position": {
        "x": 500,
        "y": 500
      }
    }
  ],
