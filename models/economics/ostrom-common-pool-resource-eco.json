{
  "id": "ostrom-common-pool-resource-eco",
  "name": "Ostrom Common Pool Resource",
  "description": "Self-governance of common pool resources. Users can invest in monitoring and sanctioning to prevent overexploitation. Shows how communities solve tragedy of commons. Nobel Prize 2009. Reference: Ostrom, E. (1990). Governing the Commons: The Evolution of Institutions for Collective Action. Cambridge University Press. Source: https://doi.org/10.1017/CBO9780511807763",
  "stocks": [
    {
      "id": "stock-resource",
      "name": "Resource Stock",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-monitoring",
      "name": "Monitoring Level",
      "initial_value": 0.3,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-regeneration",
      "name": "Regeneration",
      "equation": "Growth_Rate * Resource_Stock * (1 - Resource_Stock / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-resource",
      "position": {
        "x": 80,
        "y": 150
      }
    },
    {
      "id": "flow-harvest",
      "name": "Harvest",
      "equation": "Extraction_Effort * Resource_Stock",
      "from_stock": "stock-resource",
      "to_stock": null,
      "position": {
        "x": 80,
        "y": 250
      }
    },
    {
      "id": "flow-monitoring-change",
      "name": "Monitoring Change",
      "equation": "Monitoring_Adjustment * (Optimal_Monitoring - Monitoring_Level)",
      "from_stock": null,
      "to_stock": "stock-monitoring",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-growth",
      "name": "Growth Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-carrying",
      "name": "Carrying Capacity",
      "equation": "200",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-extraction",
      "name": "Extraction Effort",
      "equation": "Base_Extraction * (1 - Detection_Probability * Sanction_Severity)",
      "position": {
        "x": 450,
        "y": 80
      }
    },
    {
      "id": "var-base-extract",
      "name": "Base Extraction",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-detection",
      "name": "Detection Probability",
      "equation": "0.8 * Monitoring_Level",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-sanction",
      "name": "Sanction Severity",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-monitoring-cost",
      "name": "Monitoring Cost",
      "equation": "Cost_Per_Monitor * Monitoring_Level",
      "position": {
        "x": 100,
        "y": 420
      }
    },
    {
      "id": "var-cost-per",
      "name": "Cost Per Monitor",
      "equation": "10",
      "position": {
        "x": 300,
        "y": 420
      }
    },
    {
      "id": "var-optimal",
      "name": "Optimal Monitoring",
      "equation": "MIN(1, (Base_Extraction * Resource_Stock * Sanction_Severity * 0.8 - Cost_Per_Monitor) / (Base_Extraction * Resource_Stock * Sanction_Severity * 0.8 + 0.001))",
      "position": {
        "x": 500,
        "y": 420
      }
    },
    {
      "id": "var-adjust",
      "name": "Monitoring Adjustment",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 490
      }
    },
    {
      "id": "var-sustainable",
      "name": "Sustainable Yield",
      "equation": "Growth_Rate * Carrying_Capacity / 4",
      "position": {
        "x": 500,
        "y": 490
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Resource Stock",
      "to_element": "Regeneration"
    },
    {
      "id": "conn-2",
      "from_element": "Resource Stock",
      "to_element": "Harvest"
    },
    {
      "id": "conn-3",
      "from_element": "Monitoring Level",
      "to_element": "Detection Probability"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-12T07:43:15.876010+00:00",
  "updated_at": "2026-01-12T07:43:15.876013+00:00",
  "source": "https://doi.org/10.1017/CBO9780511807763",
  "reference": "Ostrom E. Governing the Commons: The Evolution of Institutions for Collective Action. Cambridge University Press. 1990. Nobel Prize 2009."
}