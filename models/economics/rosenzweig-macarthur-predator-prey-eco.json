{
  "id": "rosenzweig-macarthur-predator-prey-eco",
  "name": "Rosenzweig-MacArthur Predator-Prey Model",
  "description": "Predator-prey model with saturating functional response showing paradox of enrichment. Source: Rosenzweig & MacArthur (1963), Am Naturalist.",
  "stocks": [
    {
      "id": "s1",
      "name": "Prey",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Predator",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Prey_Growth",
      "equation": "r * Prey * (1 - Prey/K) - a * Prey * Predator / (1 + a * h * Prey)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Predator_Growth",
      "equation": "e * a * Prey * Predator / (1 + a * h * Prey) - m * Predator",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "r",
