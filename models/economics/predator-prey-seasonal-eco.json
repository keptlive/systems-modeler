{
  "id": "predator-prey-seasonal-eco",
  "name": "Predator-Prey with Seasonal Forcing Model",
  "description": "Extended Lotka-Volterra model with seasonal variation in prey birth rate showing complex dynamics including chaos. Based on Rinaldi et al. (1993). Reference: Lotka, A. J. (1920). Analytical note on certain rhythmic relations in organic systems. PNAS, 6(7), 410-415. DOI: https://doi.org/10.1073/pnas.6.7.410",
  "stocks": [
    {
      "id": "s1",
      "name": "Prey",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Predator",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Prey Birth",
      "equation": "Prey * r * (1 + Seasonal_Amplitude * SIN(2 * 3.14159 * TIME / Season_Period))",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Predation",
      "equation": "a * Prey * Predator",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Predator Birth",
      "equation": "b * Prey * Predator",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Predator Death",
      "equation": "m * Predator",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "r",
      "equation": "1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Seasonal Amplitude",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v3",
      "name": "Season Period",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "a",
      "equation": "0.01",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "b",
      "equation": "0.002",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "m",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Prey Equilibrium",
      "equation": "m / b",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Predator Equilibrium",
      "equation": "r / a",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Prey",
      "to_element": "Prey Birth"
    },
    {
      "id": "c2",
      "from_element": "Prey",
      "to_element": "Predation"
    },
    {
      "id": "c3",
      "from_element": "Predator",
      "to_element": "Predation"
    },
    {
      "id": "c4",
      "from_element": "Predator",
      "to_element": "Predator Death"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.01
  },
  "created_at": "2026-01-12T01:53:04.261341+00:00",
  "updated_at": "2026-01-12T01:53:04.261344+00:00",
  "source": "https://doi.org/10.1016/0022-5193(93)90224-K",
  "reference": "Rinaldi S, Muratori S, Kuznetsov Y. Multiple attractors, catastrophes and chaos in seasonally perturbed predator-prey communities. Bull Math Biol. 1993;55(1):15-35."
}