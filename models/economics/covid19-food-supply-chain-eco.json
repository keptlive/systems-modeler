{
  "id": "covid19-food-supply-chain-eco",
  "name": "COVID-19 Food Supply Chain Impact Model",
  "description": "System dynamics model assessing COVID-19 impact on food supply chains in Eastern Africa. Integrates food/nutrition, COVID-19 contagion, and human health components with feedback loops. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "source": "https://doi.org/10.3390/su15064717",
  "reference": "Klassen et al. (2023). System Dynamics Modeling for Assessing the Impact of COVID-19 on Food Supply Chains: Kenya and Rwanda. Sustainability, 15(6), 4717.",
  "stocks": [
    {
      "id": "stock-food-production",
      "name": "Food Production",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-food-inventory",
      "name": "Food Inventory",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-healthy-workers",
      "name": "Healthy Workers",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "stock-sick-workers",
      "name": "Sick Workers",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "stock-nutrition-level",
      "name": "Population Nutrition Level",
      "initial_value": 0.8,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-food-waste",
      "name": "Food Waste",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-production",
      "name": "Production Rate",
      "equation": "Production_Capacity * (Healthy_Workers / Total_Workers) * Input_Availability",
      "from_stock": null,
      "to_stock": "stock-food-production",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-harvest",
      "name": "Harvest Rate",
      "equation": "Food_Production / Harvest_Time",
      "from_stock": "stock-food-production",
      "to_stock": "stock-food-inventory",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-consumption",
      "name": "Consumption Rate",
      "equation": "MIN(Food_Inventory / Consumption_Time, Demand)",
      "from_stock": "stock-food-inventory",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-infection",
      "name": "Worker Infection",
      "equation": "Infection_Rate * Healthy_Workers * Sick_Workers / Total_Workers",
      "from_stock": "stock-healthy-workers",
      "to_stock": "stock-sick-workers",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "flow-recovery",
      "name": "Worker Recovery",
      "equation": "Sick_Workers / Recovery_Time",
      "from_stock": "stock-sick-workers",
      "to_stock": "stock-healthy-workers",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-waste",
      "name": "Wastage Rate",
      "equation": "Food_Inventory * Spoilage_Rate * (1 + Disruption_Factor)",
      "from_stock": "stock-food-inventory",
      "to_stock": "stock-food-waste",
      "position": {
        "x": 300,
        "y": 275
      }
    },
    {
      "id": "flow-nutrition-change",
      "name": "Nutrition Change",
      "equation": "(Target_Nutrition - Population_Nutrition_Level) / Nutrition_Adjustment_Time",
      "from_stock": null,
      "to_stock": "stock-nutrition-level",
      "position": {
        "x": 500,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-capacity",
      "name": "Production Capacity",
      "equation": "1200",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-total-workers",
      "name": "Total Workers",
      "equation": "Healthy_Workers + Sick_Workers",
      "position": {
        "x": 300,
        "y": 0
      }
    },
    {
      "id": "var-input-avail",
      "name": "Input Availability",
      "equation": "0.9 - 0.3 * Lockdown_Intensity",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-harvest-time",
      "name": "Harvest Time",
      "equation": "7",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "var-consumption-time",
      "name": "Consumption Time",
      "equation": "14",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-demand",
      "name": "Demand",
      "equation": "100",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "var-infection-rate",
      "name": "Infection Rate",
      "equation": "0.0005",
      "position": {
        "x": 200,
        "y": 0
      }
    },
    {
      "id": "var-recovery-time",
      "name": "Recovery Time",
      "equation": "14",
      "position": {
        "x": 400,
        "y": 0
      }
    },
    {
      "id": "var-spoilage",
      "name": "Spoilage Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-disruption",
      "name": "Disruption Factor",
      "equation": "Sick_Workers / Total_Workers",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-lockdown",
      "name": "Lockdown Intensity",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "var-target-nutrition",
      "name": "Target Nutrition",
      "equation": "Food_Inventory / (Demand * Consumption_Time)",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-nutrition-adj",
      "name": "Nutrition Adjustment Time",
      "equation": "30",
      "position": {
        "x": 550,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.5
  },
  "created_at": "2026-01-12T03:11:09.889239+00:00",
  "updated_at": "2026-01-12T03:11:09.889239+00:00"
}