{
  "id": "goodwin-growth-cycle-detailed-eco",
  "name": "Goodwin Growth Cycle Model (Detailed)",
  "description": "Richard Goodwin's classic model of capitalist economic cycles showing predator-prey dynamics between wages and employment. Source: Goodwin (1967), A Growth Cycle. DOI: 10.1017/CBO9780511559747.013",
  "stocks": [
    {
      "id": "stock-k",
      "name": "Capital",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-emp",
      "name": "Employment",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-w",
      "name": "Wage_Share",
      "initial_value": 0.6,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-invest",
      "name": "Investment",
      "equation": "(1 - Wage_Share) * Output",
      "from_stock": null,
      "to_stock": "stock-k",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-deprec",
      "name": "Depreciation",
      "equation": "Depreciation_Rate * Capital",
      "from_stock": "stock-k",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "flow-hire",
      "name": "Employment_Growth",
      "equation": "Employment * (Output_Growth - Productivity_Growth)",
      "from_stock": null,
      "to_stock": "stock-emp",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-wage-growth",
      "name": "Wage_Growth",
      "equation": "Wage_Share * Phillips_Curve",
      "from_stock": null,
      "to_stock": "stock-w",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-out",
      "name": "Output",
      "equation": "Capital / Capital_Output_Ratio",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-cor",
      "name": "Capital_Output_Ratio",
      "equation": "3",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-dep",
      "name": "Depreciation_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-phillips",
      "name": "Phillips_Curve",
      "equation": "-Gamma + Rho * Employment_Rate",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-emprate",
      "name": "Employment_Rate",
      "equation": "Employment / Labor_Force",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-labor",
      "name": "Labor_Force",
      "equation": "100",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-gamma",
      "name": "Gamma",
      "equation": "0.04",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "var-rho",
      "name": "Rho",
      "equation": "0.05",
      "position": {
        "x": 600,
        "y": 50
      }
    },
    {
      "id": "var-outgrow",
      "name": "Output_Growth",
      "equation": "(1 - Wage_Share) / Capital_Output_Ratio - Depreciation_Rate",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-prodgrow",
      "name": "Productivity_Growth",
      "equation": "0.02",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Wage_Share",
      "to_element": "Investment"
    },
    {
      "id": "conn-2",
      "from_element": "Employment_Rate",
      "to_element": "Phillips_Curve"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.1
  },
  "created_at": "2026-01-11T22:11:19.086424Z",
  "updated_at": "2026-01-11T22:11:19.086432Z",
  "source": "https://doi.org/10.1017/CBO9780511559747.013",
  "reference": "Goodwin, R.M. (1967). A Growth Cycle. In: Socialism, Capitalism and Economic Growth."
}