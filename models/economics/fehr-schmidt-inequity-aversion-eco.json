{
  "id": "fehr-schmidt-inequity-aversion-eco",
  "name": "Fehr-Schmidt Inequity Aversion Model",
  "description": "Model of fairness in economic decisions showing how agents dislike both advantageous and disadvantageous inequality. Reference: Fehr, E. & Schmidt, K.M. (1999). A Theory of Fairness.",
  "stocks": [
    {
      "id": "s1",
      "name": "Agent_A_Payoff",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Agent_B_Payoff",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Total_Welfare",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "A_Income",
      "equation": "Base_Income + Allocation * Pool",
      "from_stock": null,
      "to_stock": "Agent_A_Payoff",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "B_Income",
      "equation": "Base_Income + (1 - Allocation) * Pool",
      "from_stock": null,
      "to_stock": "Agent_B_Payoff",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Welfare_Change",
      "equation": "A_Utility + B_Utility",
      "from_stock": null,
      "to_stock": "Total_Welfare",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Base_Income",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Pool",
      "equation": "20",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Allocation",
      "equation": "0.5 + 0.2 * SIN(time / 10)",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Alpha_A",
      "equation": "0.5",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Beta_A",
      "equation": "0.25",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Payoff_Diff",
      "equation": "Agent_A_Payoff - Agent_B_Payoff",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "A_Disadvantage",
      "equation": "Alpha_A * MAX(0, -Payoff_Diff)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "A_Advantage",
      "equation": "Beta_A * MAX(0, Payoff_Diff)",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "A_Utility",
      "equation": "Agent_A_Payoff - A_Disadvantage - A_Advantage",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v10",
      "name": "B_Utility",
      "equation": "Agent_B_Payoff - 0.5 * MAX(0, Payoff_Diff) - 0.25 * MAX(0, -Payoff_Diff)",
      "position": {
        "x": 250,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1162/003355399556151",
  "reference": "Fehr, E. & Schmidt, K.M. (1999). A Theory of Fairness, Competition, and Cooperation. Quarterly Journal of Economics, 114(3), 817-868.",
