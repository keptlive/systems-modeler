{
  "id": "ramsey-cass-koopmans-growth-model-eco",
  "name": "Ramsey-Cass-Koopmans Growth Model",
  "description": "An optimal growth model where household savings decisions are endogenously determined by intertemporal optimization. Unlike the Solow model with a fixed savings rate, consumption and savings emerge from maximizing utility over time. A cornerstone of modern macroeconomics and neoclassical growth theory. Reference: Solow, R. M. (1956). A contribution to the theory of economic growth. Quarterly Journal of Economics, 70(1), 65-94. DOI: https://doi.org/10.2307/1884513",
  "stocks": [
    {
      "id": "stock-capital-per-capita",
      "name": "Capital per Capita",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-consumption-per-capita",
      "name": "Consumption per Capita",
      "initial_value": 2,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-net-investment-per-capita",
      "name": "Net Investment per Capita",
      "equation": "Output_per_Capita - Consumption_per_Capita - (n + delta) * Capital_per_Capita",
      "from_stock": null,
      "to_stock": "stock-capital-per-capita",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-consumption-change",
      "name": "Consumption Change",
      "equation": "Consumption_per_Capita * (Marginal_Product_of_Capital - Rho - delta) / Theta",
      "from_stock": null,
      "to_stock": "stock-consumption-per-capita",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-output-per-capita",
      "name": "Output per Capita",
      "equation": "A * Capital_per_Capita^Alpha",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-marginal-product-of-capital",
      "name": "Marginal Product of Capital",
      "equation": "Alpha * A * Capital_per_Capita^(Alpha - 1)",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-a",
      "name": "A",
      "equation": "1",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-alpha",
      "name": "Alpha",
      "equation": "0.33",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-n",
      "name": "n",
      "equation": "0.01",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-delta",
      "name": "Delta",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-rho",
      "name": "Rho",
      "equation": "0.02",
      "position": {
        "x": 250,
        "y": 160
      }
    },
    {
      "id": "var-theta",
      "name": "Theta",
      "equation": "2",
      "position": {
        "x": 400,
        "y": 160
      }
    },
    {
      "id": "var-savings-rate",
      "name": "Savings Rate",
      "equation": "(Output_per_Capita - Consumption_per_Capita) / Output_per_Capita",
      "position": {
        "x": 550,
        "y": 160
      }
    }
  ],
  "connectors": [
