{
  "id": "cournot-duopoly-competition-eco",
  "name": "Cournot Duopoly Competition",
  "description": "Dynamic Cournot duopoly model showing quantity competition between two firms. Firms adjust output based on expected competitor response. Source: Cournot (1838), Researches into the Mathematical Principles of the Theory of Wealth.",
  "stocks": [
    {
      "id": "stock-q1",
      "name": "Firm1_Output",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-q2",
      "name": "Firm2_Output",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-q1-change",
      "name": "Firm1_Output_Change",
      "equation": "Adjustment_Speed * (Best_Response_1 - Firm1_Output)",
      "from_stock": null,
      "to_stock": "stock-q1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-q2-change",
      "name": "Firm2_Output_Change",
      "equation": "Adjustment_Speed * (Best_Response_2 - Firm2_Output)",
      "from_stock": null,
      "to_stock": "stock-q2",
      "position": {
        "x": 100,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-market-demand",
      "name": "Market_Demand_Intercept",
      "equation": "100",
      "position": {
        "x": 350,
        "y": 80
      }
    },
    {
      "id": "var-price-sensitivity",
      "name": "Price_Sensitivity",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-marginal-cost",
      "name": "Marginal_Cost",
      "equation": "10",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-total-output",
      "name": "Total_Output",
      "equation": "Firm1_Output + Firm2_Output",
      "position": {
        "x": 350,
        "y": 225
      }
    },
    {
      "id": "var-market-price",
      "name": "Market_Price",
      "equation": "MAX(0, Market_Demand_Intercept - Price_Sensitivity * Total_Output)",
      "position": {
        "x": 500,
        "y": 225
      }
    },
    {
      "id": "var-best-response-1",
      "name": "Best_Response_1",
      "equation": "(Market_Demand_Intercept - Marginal_Cost - Price_Sensitivity * Firm2_Output) / (2 * Price_Sensitivity)",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-best-response-2",
      "name": "Best_Response_2",
      "equation": "(Market_Demand_Intercept - Marginal_Cost - Price_Sensitivity * Firm1_Output) / (2 * Price_Sensitivity)",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "var-adjustment-speed",
      "name": "Adjustment_Speed",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 225
      }
    },
    {
      "id": "var-firm1-profit",
      "name": "Firm1_Profit",
      "equation": "(Market_Price - Marginal_Cost) * Firm1_Output",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "var-firm2-profit",
      "name": "Firm2_Profit",
      "equation": "(Market_Price - Marginal_Cost) * Firm2_Output",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Firm1_Output",
      "to_element": "Best_Response_2"
    },
    {
      "id": "conn-2",
      "from_element": "Firm2_Output",
      "to_element": "Best_Response_1"
    },
    {
      "id": "conn-3",
      "from_element": "Total_Output",
      "to_element": "Market_Price"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-11T20:57:03.373823+00:00",
  "updated_at": "2026-01-11T20:57:03.373823+00:00",
  "source": "https://github.com/SDXorg/test-models",
  "reference": "SDXorg Test Models Repository"
}