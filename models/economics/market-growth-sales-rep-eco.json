{
  "id": "market-growth-sales-rep-eco",
  "name": "Rep_Turnover_Rate",
  "description": "Model of market growth where sales representatives are fundamental to achieving expansion. Shows how sales force expansion and customer acquisition create reinforcing growth dynamics. From Vensim sample models. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Customers",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Sales_Representatives",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Revenue_Pool",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Customer_Acquisition",
      "equation": "Potential_Customers * Contact_Rate * Conversion_Rate",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Customer_Loss",
      "equation": "Customers * Churn_Rate",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Hiring_Sales_Reps",
      "equation": "(Desired_Sales_Reps - Sales_Representatives) / Rep_Hiring_Time",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Sales_Rep_Turnover",
      "equation": "Sales_Representatives * Rep_Turnover_Rate",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Revenue_Inflow",
      "equation": "Customers * Revenue_Per_Customer",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Expenses",
      "equation": "Fixed_Costs + Sales_Representatives * Cost_Per_Rep",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 750,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Market_Size",
      "equation": "10000",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Potential_Customers",
      "equation": "Market_Size - Customers",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Contact_Rate",
      "equation": "Sales_Representatives * Contacts_Per_Rep / Market_Size",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Contacts_Per_Rep",
      "equation": "50",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Conversion_Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Churn_Rate",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Desired_Sales_Reps",
      "equation": "Customers / Customers_Per_Rep",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Customers_Per_Rep",
      "equation": "20",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "Rep_Hiring_Time",
      "equation": "8",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Rep_Turnover_Rate",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "v11",
      "name": "Revenue_Per_Customer",
      "equation": "1000",
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "id": "v12",
      "name": "Fixed_Costs",
      "equation": "50000",
      "position": {
        "x": 700,
        "y": 300
      }
    },
    {
      "id": "v13",
      "name": "Cost_Per_Rep",
      "equation": "5000",
      "position": {
        "x": 750,
        "y": 350
      }
    }
  ],
