{
  "id": "ai-automation-impact-eco",
  "name": "AI Automation Impact on Labor Model",
  "description": "Model showing how AI automation affects different skill levels of workers, wages, and productivity. Reference: Acemoglu, D., & Restrepo, P. (2019). Automation and New Tasks. Journal of Economic Perspectives. Source: https://doi.org/10.1257/jep.33.2.3",
  "stocks": [
    {
      "id": "stock-routine",
      "name": "Routine_Workers",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-skilled",
      "name": "Skilled_Workers",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-augmented",
      "name": "AI_Augmented_Workers",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-ai",
      "name": "AI_Capability",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-displacement",
      "name": "Routine_Displacement",
      "equation": "Routine_Workers * AI_Capability / 100 * Displacement_Rate",
      "from_stock": "stock-routine",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "flow-upskilling",
      "name": "Upskilling",
      "equation": "Routine_Workers * Training_Rate * Training_Investment",
      "from_stock": "stock-routine",
      "to_stock": "stock-skilled",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-augmentation",
      "name": "Worker_Augmentation",
      "equation": "Skilled_Workers * Augmentation_Rate * AI_Capability / 100",
      "from_stock": "stock-skilled",
      "to_stock": "stock-augmented",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-ai-growth",
      "name": "AI_Development",
      "equation": "AI_Capability * AI_Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-ai",
      "position": {
        "x": 350,
        "y": 450
      }
    }
  ],
  "variables": [
    {
      "id": "var-disp-rate",
      "name": "Displacement_Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-train-rate",
      "name": "Training_Rate",
      "equation": "0.03",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-train-invest",
      "name": "Training_Investment",
      "equation": "1.0",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "var-aug-rate",
      "name": "Augmentation_Rate",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-ai-growth",
      "name": "AI_Growth_Rate",
      "equation": "0.15",
      "position": {
        "x": 450,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Routine_Workers",
      "to_element": "Routine_Displacement"
    },
    {
      "id": "c2",
      "from_element": "AI_Capability",
      "to_element": "Routine_Displacement"
    },
    {
      "id": "c3",
      "from_element": "Displacement_Rate",
      "to_element": "Routine_Displacement"
    },
    {
      "id": "c4",
      "from_element": "Routine_Workers",
      "to_element": "Upskilling"
    },
    {
      "id": "c5",
      "from_element": "Training_Rate",
      "to_element": "Upskilling"
    },
    {
      "id": "c6",
      "from_element": "Training_Investment",
      "to_element": "Upskilling"
    },
    {
      "id": "c7",
      "from_element": "Skilled_Workers",
      "to_element": "Worker_Augmentation"
    },
    {
      "id": "c8",
      "from_element": "Augmentation_Rate",
      "to_element": "Worker_Augmentation"
    },
    {
      "id": "c9",
      "from_element": "AI_Capability",
      "to_element": "Worker_Augmentation"
    },
    {
      "id": "c10",
      "from_element": "AI_Capability",
      "to_element": "AI_Development"
    },
    {
      "id": "c11",
      "from_element": "AI_Growth_Rate",
      "to_element": "AI_Development"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.5
  },
  "created_at": "2026-01-12T11:47:36.907864Z",
  "updated_at": "2026-01-12T11:47:36.907867Z",
  "source": "https://doi.org/10.1257/jel.20191293",
  "reference": "Acemoglu D, Restrepo P. Robots and Jobs: Evidence from US Labor Markets. Journal of Political Economy. 2020;128(6):2188-2244."
}