{
  "id": "marine-protected-area-eco",
  "name": "Marine Protected Area Effectiveness Model",
  "description": "Models fish population recovery in marine protected areas with spillover effects. Based on Roberts et al. (2001). DOI: 10.1126/science.1057238",
  "stocks": [
    {
      "id": "stock-inside",
      "name": "Fish_Inside_MPA",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-outside",
      "name": "Fish_Outside_MPA",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "stock-biomass",
      "name": "Total_Biomass",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-insidegrowth",
      "name": "Growth_Inside",
      "equation": "Fish_Inside_MPA * Intrinsic_Growth * (1 - Fish_Inside_MPA / MPA_Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-inside",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "flow-spillover",
      "name": "Spillover",
      "equation": "Fish_Inside_MPA * Spillover_Rate * (Fish_Inside_MPA / MPA_Carrying_Capacity)",
      "from_stock": "stock-inside",
      "to_stock": "stock-outside",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-outsidegrowth",
      "name": "Growth_Outside",
      "equation": "Fish_Outside_MPA * Intrinsic_Growth * (1 - Fish_Outside_MPA / Outside_Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-outside",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "flow-harvest",
      "name": "Fishing_Harvest",
      "equation": "Fish_Outside_MPA * Fishing_Pressure",
      "from_stock": "stock-outside",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "flow-biomassupdate",
      "name": "Biomass_Update",
      "equation": "Fish_Inside_MPA + Fish_Outside_MPA",
      "from_stock": null,
      "to_stock": "stock-biomass",
      "position": {
        "x": 300,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-growth",
      "name": "Intrinsic_Growth",
      "equation": "0.3",
      "position": {
        "x": 150,
        "y": 175
      }
    },
    {
      "id": "var-mpacap",
      "name": "MPA_Carrying_Capacity",
      "equation": "500",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-outsidecap",
      "name": "Outside_Carrying_Capacity",
      "equation": "300",
      "position": {
        "x": 500,
        "y": 175
      }
    },
    {
      "id": "var-spillrate",
      "name": "Spillover_Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-fishpress",
      "name": "Fishing_Pressure",
      "equation": "0.2",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-mpaeff",
      "name": "MPA_Effectiveness",
      "equation": "Fish_Inside_MPA / (Fish_Inside_MPA + Fish_Outside_MPA)",
      "position": {
        "x": 250,
        "y": 175
      }
    },
    {
      "id": "var-recovery",
      "name": "Recovery_Index",
      "equation": "Total_Biomass / 800",
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Fish_Inside_MPA",
      "to_element": "Spillover"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:55:29.073889+00:00",
  "updated_at": "2026-01-12T02:55:29.073969+00:00",
  "source": "https://doi.org/10.1126/science.1057238",
  "reference": "Roberts CM, et al. (2001). Effects of Marine Reserves on Adjacent Fisheries. Science."
}