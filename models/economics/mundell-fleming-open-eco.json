{
  "id": "mundell-fleming-open-eco",
  "name": "Mundell-Fleming Open Economy",
  "description": "IS-LM extended to open economy with capital mobility. Shows how fiscal/monetary policy effectiveness depends on exchange rate regime. Nobel Prize 1999 (Mundell). Reference: Mundell, R. A. (1963). Capital mobility and stabilization policy under fixed and flexible exchange rates. Canadian Journal of Economics, 29(4), 475-485. Source: https://doi.org/10.2307/139336",
  "stocks": [
    {
      "id": "stock-output",
      "name": "Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-exchange-rate",
      "name": "Exchange Rate",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-output-change",
      "name": "Output Adjustment",
      "equation": "Adjustment_Speed * (Aggregate_Demand - Output)",
      "from_stock": null,
      "to_stock": "stock-output",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "flow-exchange-change",
      "name": "Exchange Rate Change",
      "equation": "IF(Fixed_Exchange_Rate = 1, 0, Capital_Flow_Sensitivity * Interest_Differential)",
