{
  "id": "ramsey-cass-koopmans-growth-eco",
  "name": "Ramsey-Cass-Koopmans Optimal Growth",
  "description": "Optimal saving and consumption with infinitely-lived households. Foundation of modern growth theory. Source: Ramsey (1928) and Cass-Koopmans (1965). DOI: 10.2307/2296570",
  "stocks": [
    {
      "id": "stock-k",
      "name": "Capital_Per_Worker",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-c",
      "name": "Consumption_Per_Worker",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 200,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-kgrow",
      "name": "Capital_Accumulation",
      "equation": "Output_Per_Worker - Consumption_Per_Worker - (Depreciation + Pop_Growth) * Capital_Per_Worker",
      "from_stock": null,
      "to_stock": "stock-k",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "flow-cgrow",
      "name": "Consumption_Growth",
      "equation": "Consumption_Per_Worker * (Marginal_Product_K - Depreciation - Rho) / Sigma",
      "from_stock": null,
      "to_stock": "stock-c",
      "position": {
        "x": 100,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-alpha",
      "name": "Alpha",
      "equation": "0.35",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-dep",
      "name": "Depreciation",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-popgrow",
      "name": "Pop_Growth",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-rho",
      "name": "Rho",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 175
      }
    },
    {
      "id": "var-sigma",
      "name": "Sigma",
      "equation": "2",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "var-output",
      "name": "Output_Per_Worker",
      "equation": "Capital_Per_Worker ^ Alpha",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-mpk",
      "name": "Marginal_Product_K",
      "equation": "Alpha * Capital_Per_Worker ^ (Alpha - 1)",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-savings",
      "name": "Savings_Rate",
      "equation": "1 - Consumption_Per_Worker / Output_Per_Worker",
      "position": {
        "x": 200,
        "y": 325
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Capital_Per_Worker",
      "to_element": "Capital_Accumulation"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 1
  },
  "created_at": "2026-01-12T02:09:47.460850+00:00",
  "updated_at": "2026-01-12T02:09:47.460853+00:00",
  "source": "https://doi.org/10.2307/2296570",
  "reference": "Cass, D. (1965). Optimum Growth in an Aggregative Model of Capital Accumulation. Review of Economic Studies."
}