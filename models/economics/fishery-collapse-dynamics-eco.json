{
  "id": "fishery-collapse-dynamics-eco",
  "name": "Fishery Collapse Dynamics",
  "description": "Fishery dynamics model showing how overfishing can lead to stock collapse. Models fish population growth with harvesting pressure and fishing effort adjustments. Based on bioeconomic fishery models. Source: Clark (1990), Mathematical Bioeconomics, Wiley. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "stock-fish",
      "name": "Fish_Population",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-boats",
      "name": "Fishing_Boats",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-growth",
      "name": "Fish_Growth",
      "equation": "Fish_Population * Growth_Rate * (1 - Fish_Population / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-fish",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-harvest",
      "name": "Harvest",
      "equation": "Catchability * Fishing_Boats * Fish_Population",
      "from_stock": "stock-fish",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-boat-entry",
      "name": "Boat_Entry",
      "equation": "MAX(0, Profit * Entry_Rate)",
      "from_stock": null,
      "to_stock": "stock-boats",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-boat-exit",
      "name": "Boat_Exit",
      "equation": "Fishing_Boats * Exit_Rate + MAX(0, -Profit * Exit_Rate)",
      "from_stock": "stock-boats",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-growth-rate",
      "name": "Growth_Rate",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-carrying-capacity",
      "name": "Carrying_Capacity",
      "equation": "200000",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-catchability",
      "name": "Catchability",
      "equation": "0.0001",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-fish-price",
      "name": "Fish_Price",
      "equation": "2",
      "position": {
        "x": 350,
        "y": 80
      }
    },
    {
      "id": "var-cost-per-boat",
      "name": "Cost_Per_Boat",
      "equation": "10000",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-revenue",
      "name": "Revenue",
      "equation": "Harvest * Fish_Price",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-profit",
      "name": "Profit",
      "equation": "Revenue - Fishing_Boats * Cost_Per_Boat",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-entry-rate",
      "name": "Entry_Rate",
      "equation": "0.0001",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "var-exit-rate",
      "name": "Exit_Rate",
      "equation": "0.05",
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Fish_Population",
      "to_element": "Fish_Growth"
    },
    {
      "id": "conn-2",
      "from_element": "Carrying_Capacity",
      "to_element": "Fish_Growth"
    },
    {
      "id": "conn-3",
      "from_element": "Fish_Population",
      "to_element": "Harvest"
    },
    {
      "id": "conn-4",
      "from_element": "Fishing_Boats",
      "to_element": "Harvest"
    },
    {
      "id": "conn-5",
      "from_element": "Profit",
      "to_element": "Boat_Entry"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-11T20:47:58.495603Z",
  "updated_at": "2026-01-11T20:47:58.495603Z",
  "source": "https://github.com/SDXorg/test-models",
  "reference": "SDXorg Test Models Repository"
}