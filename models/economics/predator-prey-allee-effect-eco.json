{
  "id": "predator-prey-allee-effect-eco",
  "name": "Predator-Prey with Allee Effect",
  "description": "Illustrative predator-prey model with a weak Allee factor N/(A+N) and saturating predation. The factor reduces per-capita prey growth at low density but does not create an intrinsic positive extinction threshold. Courchamp et al. (1999) is conceptual review background; the local equations and parameters are not an exact reproduction.",
  "source": "https://doi.org/10.1016/S0169-5347(99)01683-3",
  "reference": "Courchamp, F., Clutton-Brock, T. and Grenfell, B. (1999). Inverse density dependence and the Allee effect. Trends in Ecology & Evolution 14(10):405-410. doi:10.1016/S0169-5347(99)01683-3.",
  "stocks": [
    {
      "id": "stock-prey",
      "name": "Prey Population",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-predator",
      "name": "Predator Population",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-prey-birth",
      "name": "Prey Birth",
      "equation": "r * Prey_Population * Allee_Factor * (1 - Prey_Population / K)",
      "from_stock": null,
      "to_stock": "stock-prey",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-predation",
      "name": "Predation",
      "equation": "a * Prey_Population * Predator_Population / (1 + a * h * Prey_Population)",
      "from_stock": "stock-prey",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-predator-birth",
      "name": "Predator Birth",
      "equation": "e * Predation",
      "from_stock": null,
      "to_stock": "stock-predator",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-predator-death",
      "name": "Predator Death",
      "equation": "m * Predator_Population",
      "from_stock": "stock-predator",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-allee",
      "name": "Allee Factor",
      "equation": "Prey_Population / (A + Prey_Population)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
