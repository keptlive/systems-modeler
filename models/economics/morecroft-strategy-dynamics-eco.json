{
  "id": "morecroft-strategy-dynamics-eco",
  "name": "Morecroft Strategy Dynamics Model",
  "description": "Strategic management model showing the dynamics of firm performance including resource accumulation, market positioning, and competitive dynamics. Based on Morecroft's work in Strategic Modelling and Business Dynamics that demonstrates how system dynamics captures strategic complexity.",
  "stocks": [
    {
      "id": "s1",
      "name": "Market_Share",
      "initial_value": 0.2,
      "equation": "",
      "position": {"x": 200, "y": 200}
    },
    {
      "id": "s2",
      "name": "Brand_Equity",
      "initial_value": 50,
      "equation": "",
      "position": {"x": 400, "y": 200}
    },
    {
      "id": "s3",
      "name": "Organizational_Capability",
      "initial_value": 100,
      "equation": "",
      "position": {"x": 300, "y": 350}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Share_Change",
      "equation": "(Target_Share - Market_Share) * Adjustment_Speed * Brand_Effect",
      "from_stock": null,
      "to_stock": "Market_Share",
      "position": {"x": 100, "y": 200}
    },
    {
      "id": "f2",
      "name": "Brand_Building",
      "equation": "Marketing_Spend * Marketing_Effectiveness",
      "from_stock": null,
      "to_stock": "Brand_Equity",
      "position": {"x": 500, "y": 150}
    },
    {
      "id": "f3",
      "name": "Brand_Erosion",
      "equation": "Brand_Equity * Erosion_Rate",
      "from_stock": "Brand_Equity",
      "to_stock": null,
      "position": {"x": 500, "y": 250}
    },
    {
      "id": "f4",
      "name": "Capability_Growth",
      "equation": "Investment_in_Capability * Learning_Rate",
      "from_stock": null,
      "to_stock": "Organizational_Capability",
      "position": {"x": 200, "y": 350}
    },
    {
      "id": "f5",
      "name": "Capability_Depreciation",
      "equation": "Organizational_Capability * Depreciation_Rate",
      "from_stock": "Organizational_Capability",
      "to_stock": null,
      "position": {"x": 400, "y": 350}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Target_Share",
      "equation": "0.3",
      "position": {"x": 100, "y": 100}
    },
    {
      "id": "v2",
      "name": "Adjustment_Speed",
      "equation": "0.2",
      "position": {"x": 200, "y": 100}
    },
    {
      "id": "v3",
      "name": "Brand_Effect",
      "equation": "Brand_Equity / 100",
      "position": {"x": 300, "y": 100}
    },
    {
      "id": "v4",
      "name": "Marketing_Spend",
      "equation": "10",
      "position": {"x": 400, "y": 100}
    },
    {
      "id": "v5",
      "name": "Marketing_Effectiveness",
      "equation": "0.5",
      "position": {"x": 500, "y": 100}
    },
    {
      "id": "v6",
      "name": "Erosion_Rate",
      "equation": "0.1",
      "position": {"x": 600, "y": 100}
    },
    {
      "id": "v7",
      "name": "Investment_in_Capability",
      "equation": "Revenue * Investment_Fraction",
      "position": {"x": 100, "y": 400}
    },
    {
      "id": "v8",
      "name": "Learning_Rate",
      "equation": "0.3",
      "position": {"x": 200, "y": 400}
    },
    {
      "id": "v9",
      "name": "Depreciation_Rate",
      "equation": "0.05",
      "position": {"x": 300, "y": 400}
    },
    {
      "id": "v10",
      "name": "Revenue",
      "equation": "Market_Share * Market_Size * Price",
      "position": {"x": 400, "y": 400}
    },
    {
      "id": "v11",
      "name": "Market_Size",
      "equation": "1000000",
      "position": {"x": 500, "y": 400}
    },
    {
      "id": "v12",
      "name": "Price",
      "equation": "100",
      "position": {"x": 600, "y": 400}
    },
    {
      "id": "v13",
      "name": "Investment_Fraction",
      "equation": "0.05",
      "position": {"x": 100, "y": 450}
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1002/9781118762745",
  "reference": "Morecroft JDW. Strategic Modelling and Business Dynamics: A Feedback Systems Approach. 2nd ed. Wiley; 2015. ISBN: 978-1-118-76274-5",
