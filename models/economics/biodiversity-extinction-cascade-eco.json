{
  "id": "biodiversity-extinction-cascade-eco",
  "name": "Biodiversity Extinction Cascade Model",
  "description": "Models the dynamics of biodiversity loss including species interdependencies, trophic cascades, ecosystem services decline, and the risk of extinction cascades. Based on IPBES Global Assessment and ecological network research.",
  "source": "https://doi.org/10.1038/s41586-019-1684-5",
  "reference": "IPBES Global Assessment Report on Biodiversity and Ecosystem Services. 2019. Tilman D, et al. Future threats to biodiversity and pathways to their prevention. Nature. 2017.",
  "stocks": [
    {"id": "stock-species-count", "name": "Species Count", "initial_value": 8700000, "equation": "", "position": {"x": 100, "y": 150}},
    {"id": "stock-threatened", "name": "Threatened Species", "initial_value": 1000000, "equation": "", "position": {"x": 300, "y": 150}},
    {"id": "stock-extinct", "name": "Extinct Species", "initial_value": 10000, "equation": "", "position": {"x": 500, "y": 150}},
    {"id": "stock-ecosystem-health", "name": "Ecosystem Health Index", "initial_value": 100, "equation": "", "position": {"x": 300, "y": 300}},
    {"id": "stock-protected-areas", "name": "Protected Areas", "initial_value": 15, "equation": "", "position": {"x": 100, "y": 300}}
  ],
  "flows": [
    {"id": "flow-to-threatened", "name": "Becoming Threatened", "equation": "Species_Count * Threat_Rate * Pressure_Factor", "from_stock": "stock-species-count", "to_stock": "stock-threatened", "position": {"x": 200, "y": 150}},
    {"id": "flow-extinction", "name": "Extinction", "equation": "Threatened_Species * Extinction_Rate * (1 + Cascade_Effect)", "from_stock": "stock-threatened", "to_stock": "stock-extinct", "position": {"x": 400, "y": 150}},
    {"id": "flow-recovery", "name": "Recovery", "equation": "Threatened_Species * Recovery_Rate * Protected_Effect", "from_stock": "stock-threatened", "to_stock": "stock-species-count", "position": {"x": 200, "y": 100}},
    {"id": "flow-ecosystem-decline", "name": "Ecosystem Decline", "equation": "Ecosystem_Health_Index * Decline_Rate * Biodiversity_Loss_Effect", "from_stock": "stock-ecosystem-health", "to_stock": null, "position": {"x": 300, "y": 350}},
    {"id": "flow-protection-increase", "name": "Protection Increase", "equation": "Conservation_Investment * Protection_Rate", "from_stock": null, "to_stock": "stock-protected-areas", "position": {"x": 100, "y": 250}}
  ],
  "variables": [
    {"id": "var-threat-rate", "name": "Threat_Rate", "equation": "0.0001", "position": {"x": 150, "y": 100}},
    {"id": "var-pressure", "name": "Pressure_Factor", "equation": "1 + 0.02 * TIME / 12", "position": {"x": 250, "y": 100}},
    {"id": "var-extinction", "name": "Extinction_Rate", "equation": "0.001", "position": {"x": 450, "y": 100}},
    {"id": "var-cascade", "name": "Cascade_Effect", "equation": "Extinct_Species / 100000", "position": {"x": 400, "y": 200}},
    {"id": "var-recovery", "name": "Recovery_Rate", "equation": "0.0001", "position": {"x": 150, "y": 200}},
    {"id": "var-protected-effect", "name": "Protected_Effect", "equation": "Protected_Areas / 30", "position": {"x": 50, "y": 200}},
    {"id": "var-decline", "name": "Decline_Rate", "equation": "0.001", "position": {"x": 400, "y": 300}},
    {"id": "var-biodiv-loss", "name": "Biodiversity_Loss_Effect", "equation": "(8700000 - Species_Count) / 8700000", "position": {"x": 200, "y": 350}},
    {"id": "var-conservation", "name": "Conservation_Investment", "equation": "1", "position": {"x": 50, "y": 250}},
    {"id": "var-protection-rate", "name": "Protection_Rate", "equation": "0.5", "position": {"x": 50, "y": 350}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 1200, "dt": 1},
  "created_at": "2026-01-15T21:00:00.000000+00:00",
  "updated_at": "2026-01-15T21:00:00.000000+00:00"
}
