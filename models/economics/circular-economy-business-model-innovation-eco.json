{
  "id": "circular-economy-business-model-innovation-eco",
  "name": "Circular Economy Business Model Innovation Model",
  "description": "System dynamics model analyzing systemic effects of combining product design and business model strategies for slowing and closing resource loops. Based on Geissdoerfer et al. (2020) showing leverage points in regulations, policies, and product/service design. Reference: Geissdoerfer, M., et al. (2020). A system dynamics approach to product design and business model strategies for the circular economy. Journal of Cleaner Production, 254, 120013. Source: https://doi.org/10.1016/j.jclepro.2019.120013",
  "stocks": [
    {
      "id": "s1",
      "name": "Products in Use",
      "initial_value": 1000,
      "equation": "",
      "position": {"x": 200, "y": 150}
    },
    {
      "id": "s2",
      "name": "Products at End of Life",
      "initial_value": 100,
      "equation": "",
      "position": {"x": 400, "y": 150}
    },
    {
      "id": "s3",
      "name": "Recovered Materials",
      "initial_value": 50,
      "equation": "",
      "position": {"x": 550, "y": 150}
    },
    {
      "id": "s4",
      "name": "Business Model Circularity",
      "initial_value": 0.2,
      "equation": "",
      "position": {"x": 150, "y": 300}
    },
    {
      "id": "s5",
      "name": "Product Design Circularity",
      "initial_value": 0.3,
      "equation": "",
      "position": {"x": 350, "y": 300}
    },
    {
      "id": "s6",
      "name": "Economic Value Retained",
      "initial_value": 100,
      "equation": "",
      "position": {"x": 500, "y": 300}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "New Production",
      "equation": "Production_Rate * (1 - Recovered_Materials / Max_Recovery * Closed_Loop_Factor)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {"x": 100, "y": 150}
    },
    {
      "id": "f2",
      "name": "Product Disposal",
      "equation": "Products_in_Use * (Base_Disposal_Rate / (1 + Product_Design_Circularity * Durability_Effect))",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {"x": 300, "y": 150}
    },
    {
      "id": "f3",
      "name": "Material Recovery",
      "equation": "Products_at_End_of_Life * Recovery_Rate * Product_Design_Circularity * Business_Model_Circularity",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {"x": 475, "y": 150}
    },
    {
      "id": "f4",
      "name": "Waste Disposal",
      "equation": "Products_at_End_of_Life * (1 - Recovery_Rate * Product_Design_Circularity)",
      "from_stock": "s2",
      "to_stock": null,
      "position": {"x": 400, "y": 200}
    },
    {
      "id": "f5",
      "name": "BM Innovation",
      "equation": "Innovation_Investment * BM_Priority * (1 - Business_Model_Circularity) * Policy_Incentive",
      "from_stock": null,
      "to_stock": "s4",
      "position": {"x": 100, "y": 300}
    },
    {
      "id": "f6",
      "name": "PD Innovation",
      "equation": "Innovation_Investment * (1 - BM_Priority) * (1 - Product_Design_Circularity) * Regulation_Effect",
      "from_stock": null,
      "to_stock": "s5",
      "position": {"x": 300, "y": 350}
    },
    {
      "id": "f7",
      "name": "Value Retention",
      "equation": "Material_Recovery * Value_Per_Unit * (Business_Model_Circularity + Product_Design_Circularity) / 2",
      "from_stock": null,
      "to_stock": "s6",
      "position": {"x": 550, "y": 350}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Production Rate",
      "equation": "50",
      "position": {"x": 50, "y": 100}
    },
    {
      "id": "v2",
      "name": "Max Recovery",
      "equation": "200",
      "position": {"x": 100, "y": 200}
    },
    {
      "id": "v3",
      "name": "Closed Loop Factor",
      "equation": "0.8",
      "position": {"x": 150, "y": 100}
    },
    {
      "id": "v4",
      "name": "Base Disposal Rate",
      "equation": "0.1",
      "position": {"x": 250, "y": 100}
    },
    {
      "id": "v5",
      "name": "Durability Effect",
      "equation": "2",
      "position": {"x": 350, "y": 100}
    },
    {
      "id": "v6",
      "name": "Recovery Rate",
      "equation": "0.6",
      "position": {"x": 450, "y": 100}
    },
    {
      "id": "v7",
      "name": "Innovation Investment",
      "equation": "0.05",
      "position": {"x": 50, "y": 350}
    },
    {
      "id": "v8",
      "name": "BM Priority",
      "equation": "0.5",
      "position": {"x": 150, "y": 400}
    },
    {
      "id": "v9",
      "name": "Policy Incentive",
      "equation": "1.2",
      "position": {"x": 100, "y": 250}
    },
    {
      "id": "v10",
      "name": "Regulation Effect",
      "equation": "1.3",
      "position": {"x": 400, "y": 400}
    },
    {
      "id": "v11",
      "name": "Value Per Unit",
      "equation": "10",
      "position": {"x": 550, "y": 250}
    },
    {
      "id": "v12",
      "name": "Circularity Index",
      "equation": "(Business_Model_Circularity + Product_Design_Circularity) / 2",
      "position": {"x": 250, "y": 400}
    },
    {
      "id": "v13",
      "name": "Environmental Impact Reduction",
      "equation": "Circularity_Index * 0.5 + (Recovered_Materials / Max_Recovery) * 0.5",
      "position": {"x": 450, "y": 400}
    }
  ],
