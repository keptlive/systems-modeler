{
  "id": "cybersecurity-breach-dynamics-eco",
  "name": "Cybersecurity Breach Dynamics Model",
  "description": "Model of cybersecurity showing vulnerability discovery, patching, and exploitation dynamics. Based on Rescorla (2005) and Verizon DBIR. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Unknown Vulnerabilities",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Known Unpatched",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Patched Systems",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Compromised Systems",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Vulnerability Discovery",
      "equation": "Unknown_Vulnerabilities * Discovery_Rate",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Patching Rate",
      "equation": "Known_Unpatched * Patch_Rate",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Exploitation",
      "equation": "Known_Unpatched * Exploit_Rate * Attacker_Capability",
      "from_stock": "s2",
      "to_stock": "s4",
      "position": {
        "x": 300,
        "y": 275
      }
    },
    {
      "id": "f4",
      "name": "Zero Day Attack",
      "equation": "Unknown_Vulnerabilities * Zero_Day_Rate",
      "from_stock": "s1",
      "to_stock": "s4",
      "position": {
        "x": 200,
        "y": 275
      }
    },
    {
      "id": "f5",
      "name": "Recovery",
      "equation": "Compromised_Systems / Recovery_Time",
      "from_stock": "s4",
      "to_stock": "s3",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "f6",
      "name": "New Vulnerabilities",
      "equation": "New_Software_Rate * Vuln_per_Software",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Discovery Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Patch Rate",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Exploit Rate",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v4",
      "name": "Attacker Capability",
      "equation": "1.2",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "v5",
      "name": "Zero Day Rate",
      "equation": "0.001",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Recovery Time",
      "equation": "14",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "v7",
      "name": "New Software Rate",
      "equation": "10",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Vuln per Software",
      "equation": "5",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "v9",
      "name": "Breach Cost",
      "equation": "Compromised_Systems * 4000000",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Unknown Vulnerabilities",
      "to_element": "Vulnerability Discovery"
    },
    {
      "id": "c2",
      "from_element": "Known Unpatched",
      "to_element": "Exploitation"
    },
    {
      "id": "c3",
      "from_element": "Compromised Systems",
      "to_element": "Recovery"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 52,
    "dt": 0.25
  },
  "created_at": "2026-01-12T01:45:26.877572+00:00",
  "updated_at": "2026-01-12T01:45:26.877579+00:00",
  "source": "https://www.verizon.com/business/resources/reports/dbir/",
  "reference": "Verizon. 2023 Data Breach Investigations Report. Verizon Enterprise Solutions, 2023."
}