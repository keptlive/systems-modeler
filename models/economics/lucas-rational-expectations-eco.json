{
  "id": "lucas-rational-expectations-eco",
  "name": "Lucas Rational Expectations Model",
  "description": "Robert Lucas's Nobel Prize rational expectations model showing how anticipated policy changes are ineffective. Reference: Lucas, R.E. (1972). Expectations and the Neutrality of Money.",
  "stocks": [
    {
      "id": "s1",
      "name": "Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Price_Level",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Expected_Price",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Output_Change",
      "equation": "Alpha * (Actual_Inflation - Expected_Inflation)",
      "from_stock": null,
      "to_stock": "Output",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Price_Change",
      "equation": "Price_Level * Actual_Inflation",
      "from_stock": null,
      "to_stock": "Price_Level",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Expectation_Adjustment",
      "equation": "(Price_Level - Expected_Price) * Learning_Speed",
      "from_stock": null,
      "to_stock": "Expected_Price",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Money_Growth",
      "equation": "0.05 + 0.02 * SIN(time / 10)",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Actual_Inflation",
      "equation": "Money_Growth",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Expected_Inflation",
      "equation": "(Expected_Price - Price_Level) / MAX(0.01, Expected_Price)",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Surprise_Inflation",
      "equation": "Actual_Inflation - Expected_Inflation",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Alpha",
      "equation": "2.0",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Learning_Speed",
      "equation": "0.5",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Output_Gap",
      "equation": "Output - 100",
      "position": {
        "x": 400,
        "y": 100
      }
    }
  ],
