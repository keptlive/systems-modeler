{
  "id": "pandemic-supply-chain-disruption-eco",
  "name": "Pandemic Supply Chain Disruption Dynamics",
  "description": "Model of how pandemics disrupt global supply chains, showing cascading effects of lockdowns, transportation bottlenecks, and demand shifts. Reference: Based on System Dynamics supply chain models (Sterman, 2000). Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1016/j.tre.2020.102014",
  "reference": "Ivanov D. Predicting the impacts of epidemic outbreaks on global supply chains: A simulation-based analysis on the coronavirus outbreak. Transportation Research Part E. 2020;136:101922.",
  "stocks": [
    {
      "id": "stock-inventory",
      "name": "Inventory_Level",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-production",
      "name": "Production_Capacity",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-transport",
      "name": "Transport_Capacity",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "stock-backlog",
      "name": "Order_Backlog",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-produce",
      "name": "Production",
      "equation": "Production_Capacity * production_rate * (1 - lockdown_severity)",
      "from_stock": null,
      "to_stock": "stock-inventory",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-ship",
      "name": "Shipments",
      "equation": "min(Inventory_Level, Transport_Capacity) * shipping_rate",
      "from_stock": "stock-inventory",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-prod-disrupt",
      "name": "Production_Disruption",
      "equation": "Production_Capacity * disruption_rate * pandemic_intensity",
      "from_stock": "stock-production",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "flow-prod-recover",
      "name": "Production_Recovery",
      "equation": "(100 - Production_Capacity) * recovery_rate * (1 - pandemic_intensity)",
      "from_stock": null,
      "to_stock": "stock-production",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "flow-trans-disrupt",
      "name": "Transport_Disruption",
      "equation": "Transport_Capacity * transport_disruption_rate * pandemic_intensity",
      "from_stock": "stock-transport",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "flow-order-add",
      "name": "New_Orders",
      "equation": "base_demand * (1 + panic_buying * pandemic_intensity)",
      "from_stock": null,
      "to_stock": "stock-backlog",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "flow-order-fill",
      "name": "Order_Fulfillment",
      "equation": "min(Order_Backlog, min(Inventory_Level, Transport_Capacity) * shipping_rate)",
      "from_stock": "stock-backlog",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-prod-rate",
      "name": "production_rate",
      "equation": "0.8",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "var-lockdown",
      "name": "lockdown_severity",
      "equation": "0.3",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "var-ship",
      "name": "shipping_rate",
      "equation": "0.9",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-disrupt",
      "name": "disruption_rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-pandemic",
      "name": "pandemic_intensity",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-recover",
      "name": "recovery_rate",
      "equation": "0.05",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "var-trans-dis",
      "name": "transport_disruption_rate",
      "equation": "0.05",
      "position": {
        "x": 50,
        "y": 350
      }
    },
    {
      "id": "var-demand",
      "name": "base_demand",
      "equation": "50",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "var-panic",
      "name": "panic_buying",
      "equation": "0.3",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "var-fill-rate",
      "name": "Fill_Rate",
      "equation": "1 - (Order_Backlog / (base_demand * 10))",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 52,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T12:00:00.000000+00:00",
  "updated_at": "2026-01-12T12:00:00.000000+00:00"
}