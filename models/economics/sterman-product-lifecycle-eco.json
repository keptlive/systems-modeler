{
  "id": "sterman-product-lifecycle-eco",
  "name": "Total_Population",
  "description": "Product lifecycle model from Sterman (2000) Business Dynamics Chapter 9. Shows introduction, growth, maturity, and decline phases with market saturation and word-of-mouth dynamics. Reference: Sterman, J. D. (2000). Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill. Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Potential_Adopters",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Adopters",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Discarders",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Adoption",
      "equation": "Adoption_from_Advertising + Adoption_from_Word_of_Mouth",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Discard",
      "equation": "Adopters * Discard_Rate",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Total_Population",
      "equation": "100000",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Adoption_from_Advertising",
      "equation": "Advertising_Effectiveness * Potential_Adopters",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Advertising_Effectiveness",
      "equation": "0.01",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "v4",
      "name": "Adoption_from_Word_of_Mouth",
      "equation": "Contact_Rate * Adoption_Fraction * Potential_Adopters * Adopters / Total_Population",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Contact_Rate",
      "equation": "10",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "v6",
      "name": "Adoption_Fraction",
      "equation": "0.015",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Discard_Rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Market_Saturation",
      "equation": "Adopters / Total_Population",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "Net_Growth_Rate",
      "equation": "(Adoption - Discard) / MAX(1, Adopters)",
      "position": {
        "x": 550,
        "y": 100
      }
    }
  ],
  "connectors": [
