{
  "id": "ecology-biodiversity-extinction-debt-eco",
  "name": "Biodiversity Extinction Debt",
  "description": "Models delayed species extinctions following habitat loss. Based on Tilman et al. (1994) and IPBES Global Assessment. Reference: IPBES (2019). Global Assessment Report on Biodiversity. Source: https://ipbes.net/global-assessment",
  "category": "ecology",
  "stocks": [
    {
      "id": "stock-habitat",
      "name": "Habitat_Area_MHa",
      "initial_value": 4000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-species",
      "name": "Extant_Species_Thousand",
      "initial_value": 8700,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-debt",
      "name": "Extinction_Debt_Species",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-extinct",
      "name": "Extinct_Species",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-habitat-loss",
      "name": "Habitat_Loss",
      "equation": "Habitat_Area_MHa * Deforestation_Rate",
      "from_stock": "stock-habitat",
      "to_stock": null,
      "position": {
        "x": 25,
        "y": 200
      }
    },
    {
      "id": "flow-restoration",
      "name": "Habitat_Restoration",
      "equation": "Restoration_Effort",
      "from_stock": null,
      "to_stock": "stock-habitat",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-debt-accum",
      "name": "Debt_Accumulation",
      "equation": "Extant_Species_Thousand * Z_Value * Habitat_Loss / Habitat_Area_MHa",
      "from_stock": "stock-species",
      "to_stock": "stock-debt",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-extinction",
      "name": "Realized_Extinction",
      "equation": "Extinction_Debt_Species / Relaxation_Time",
      "from_stock": "stock-debt",
      "to_stock": "stock-extinct",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "flow-background",
      "name": "Background_Extinction",
      "equation": "Extant_Species_Thousand * Background_Rate",
      "from_stock": "stock-species",
      "to_stock": "stock-extinct",
      "position": {
        "x": 500,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "var-deforestation",
      "name": "Deforestation_Rate",
      "equation": "0.005",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-restoration",
      "name": "Restoration_Effort",
      "equation": "5",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-z",
      "name": "Z_Value",
      "equation": "0.25",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-relaxation",
      "name": "Relaxation_Time",
      "equation": "100",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-background",
      "name": "Background_Rate",
      "equation": "0.0001",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-sar",
      "name": "Species_Area_Relationship",
      "equation": "(Habitat_Area_MHa / 4000) ^ Z_Value",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-equilibrium",
      "name": "Equilibrium_Species",
      "equation": "8700 * Species_Area_Relationship",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2120,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/371065a0",
  "reference": "Tilman D et al. (1994) Habitat destruction and the extinction debt. Nature.",
  "connectors": [],
  "created_at": "2026-01-12T06:15:34.770009+00:00",
  "updated_at": "2026-01-12T06:15:34.770009+00:00"
}