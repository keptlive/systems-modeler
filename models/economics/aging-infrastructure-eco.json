      "equation": "10",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "v6",
      "name": "Maintenance Effect",
      "equation": "MIN(0.5, Maintenance_Spending / Required_Maintenance)",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "v7",
      "name": "Maintenance Spending",
      "equation": "50",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
