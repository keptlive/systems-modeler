    {
      "id": "v10",
      "name": "Repair Funding",
      "equation": "0.5",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v11",
      "name": "Infrastructure Grade",
      "equation": "(Good_Condition * 4 + Fair_Condition * 3 + Poor_Condition * 2 + Failed * 1) / (Good_Condition + Fair_Condition + Poor_Condition + Failed)",
      "position": {
        "x": 450,
        "y": 300
      }
    }
  ],
  "connectors": [
