{
  "id": "verhulst-logistic-growth-eco",
  "name": "Verhulst Logistic Growth Model",
  "description": "Pierre Fran\u00e7ois Verhulst's 1838 logistic equation, one of the earliest and most fundamental population models. Shows how populations grow exponentially at first then slow as they approach carrying capacity, producing the characteristic S-curve. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "stock-population",
      "name": "Population",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-net-growth",
      "name": "Net Growth",
      "equation": "Intrinsic_Growth_Rate * Population * (1 - Population / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-population",
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-intrinsic-growth-rate",
      "name": "Intrinsic Growth Rate",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-carrying-capacity",
      "name": "Carrying Capacity",
      "equation": "1000",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-per-capita-growth-rate",
      "name": "Per Capita Growth Rate",
      "equation": "Intrinsic_Growth_Rate * (1 - Population / Carrying_Capacity)",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-inflection-point",
      "name": "Inflection Point",
      "equation": "Carrying_Capacity / 2",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-doubling-time-initial",
      "name": "Initial Doubling Time",
      "equation": "LN(2) / Intrinsic_Growth_Rate",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "var-fraction-of-k",
      "name": "Fraction of Carrying Capacity",
      "equation": "Population / Carrying_Capacity",
      "position": {
        "x": 350,
        "y": 100
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Population",
      "to_element": "Net Growth"
    },
    {
      "id": "conn-2",
      "from_element": "Intrinsic Growth Rate",
      "to_element": "Net Growth"
    },
    {
      "id": "conn-3",
      "from_element": "Carrying Capacity",
      "to_element": "Net Growth"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T01:30:00.000Z",
  "updated_at": "2026-01-12T01:30:00.000Z",
  "source": "https://www.biodiversitylibrary.org/item/44839",
  "reference": "Verhulst PF. Notice sur la loi que la population suit dans son accroissement. Correspondance math\u00e9matique et physique. 1838;10:113-121."
}