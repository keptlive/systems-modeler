{
  "id": "mm1-queue-dynamics-eco",
  "name": "M/M/1 Queue Dynamics",
  "description": "Single-server queue with Poisson arrivals and exponential service. Captures waiting line dynamics and utilization. Source: Kendall (1953) and Little's Law. DOI: 10.1214/aoms/1177728975",
  "stocks": [
    {
      "id": "stock-queue",
      "name": "Queue_Length",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-served",
      "name": "Cumulative_Served",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-arrive",
      "name": "Arrivals",
      "equation": "Arrival_Rate",
      "from_stock": null,
      "to_stock": "stock-queue",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-serve",
      "name": "Service",
      "equation": "IF(Queue_Length > 0, Service_Rate, 0)",
      "from_stock": "stock-queue",
      "to_stock": "stock-served",
      "position": {
        "x": 300,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-arr",
      "name": "Arrival_Rate",
      "equation": "8",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-srv",
      "name": "Service_Rate",
      "equation": "10",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-util",
      "name": "Utilization",
      "equation": "Arrival_Rate / Service_Rate",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "var-wait",
      "name": "Avg_Wait_Time",
      "equation": "Queue_Length / Arrival_Rate",
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Queue_Length",
      "to_element": "Service"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.1
  },
  "created_at": "2026-01-12T02:02:23.926932Z",
  "updated_at": "2026-01-12T02:02:23.926938Z",
  "source": "https://doi.org/10.1214/aoms/1177728975",
  "reference": "Kendall, D.G. (1953). Stochastic Processes Occurring in the Theory of Queues. The Annals of Mathematical Statistics."
}