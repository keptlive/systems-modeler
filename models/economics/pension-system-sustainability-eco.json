{
  "id": "pension-system-sustainability-eco",
  "name": "Pension System Sustainability Model",
  "description": "Models pension fund dynamics with demographic shifts. Based on OECD pension sustainability analysis. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-pension-fund",
      "name": "Pension_Fund_Assets",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "stock-active-contributors",
      "name": "Active_Contributors",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "stock-retirees",
      "name": "Retirees",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "stock-system-deficit",
      "name": "System_Deficit",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "flows": [
    {
      "id": "flow-contributions",
      "name": "Contributions",
      "equation": "Active_Contributors * Average_Wage * Contribution_Rate",
      "from_stock": null,
      "to_stock": "stock-pension-fund",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-investment-returns",
      "name": "Investment_Returns",
      "equation": "Pension_Fund_Assets * Investment_Return_Rate",
      "from_stock": null,
      "to_stock": "stock-pension-fund",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "flow-benefit-payments",
      "name": "Benefit_Payments",
      "equation": "Retirees * Average_Benefit",
      "from_stock": "stock-pension-fund",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-new-workers",
      "name": "New_Workers",
      "equation": "Labor_Force_Entry_Rate * Working_Age_Population",
      "from_stock": null,
      "to_stock": "stock-active-contributors",
      "position": {
        "x": 75,
        "y": 300
      }
    },
    {
      "id": "flow-retirements",
      "name": "Retirements",
      "equation": "Active_Contributors * Retirement_Rate",
      "from_stock": "stock-active-contributors",
      "to_stock": "stock-retirees",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "flow-retiree-mortality",
      "name": "Retiree_Mortality",
      "equation": "Retirees * Mortality_Rate",
      "from_stock": "stock-retirees",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "flow-deficit-accumulation",
      "name": "Deficit_Accumulation",
      "equation": "MAX(0, Benefit_Payments - Contributions - Investment_Returns)",
      "from_stock": null,
      "to_stock": "stock-system-deficit",
      "position": {
        "x": 200,
        "y": 450
      }
    }
  ],
  "variables": [
    {
      "id": "var-average-wage",
      "name": "Average_Wage",
      "equation": "50000 * (1 + 0.02 * TIME)",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-contribution-rate",
      "name": "Contribution_Rate",
      "equation": "0.1",
      "position": {
        "x": 260,
        "y": 80
      }
    },
    {
      "id": "var-investment-return-rate",
      "name": "Investment_Return_Rate",
      "equation": "0.05",
      "position": {
        "x": 420,
        "y": 80
      }
    },
    {
      "id": "var-average-benefit",
      "name": "Average_Benefit",
      "equation": "Average_Wage * Replacement_Rate",
      "position": {
        "x": 580,
        "y": 80
      }
    },
    {
      "id": "var-replacement-rate",
      "name": "Replacement_Rate",
      "equation": "0.6",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-labor-force-entry-rate",
      "name": "Labor_Force_Entry_Rate",
      "equation": "0.02",
      "position": {
        "x": 280,
        "y": 400
      }
    },
    {
      "id": "var-working-age-population",
      "name": "Working_Age_Population",
      "equation": "100000 * (1 - 0.005 * TIME)",
      "position": {
        "x": 480,
        "y": 400
      }
    },
    {
      "id": "var-retirement-rate",
      "name": "Retirement_Rate",
      "equation": "0.03",
      "position": {
        "x": 100,
        "y": 440
      }
    },
    {
      "id": "var-mortality-rate",
      "name": "Mortality_Rate",
      "equation": "0.05",
      "position": {
        "x": 280,
        "y": 440
      }
    },
    {
      "id": "var-dependency-ratio",
      "name": "Dependency_Ratio",
      "equation": "Retirees / (Active_Contributors + 1)",
      "position": {
        "x": 480,
        "y": 440
      }
    },
    {
      "id": "var-sustainability-index",
      "name": "Sustainability_Index",
      "equation": "(Contributions + Investment_Returns) / (Benefit_Payments + 1)",
      "position": {
        "x": 300,
        "y": 500
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T01:19:34.569629+00:00",
  "updated_at": "2026-01-12T01:19:34.569642+00:00",
  "source": "https://doi.org/10.1787/pension_glance-2021-en",
  "reference": "OECD. Pensions at a Glance 2021: OECD and G20 Indicators. OECD Publishing. 2021."
}