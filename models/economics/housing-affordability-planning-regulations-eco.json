{
  "id": "housing-affordability-planning-regulations-eco",
  "name": "Housing Affordability and Planning Regulations Model",
  "description": "System dynamics model of how urban planning regulations (maximum building density, minimum lot size, urban growth boundary) affect housing and land prices. Shows restrictive regulations increase prices. Reference: Herath, S., et al. (2022). Effects of planning regulations on housing and land markets: A system dynamics modeling approach. Cities, 127, 103767. Source: https://doi.org/10.1016/j.cities.2022.103767",
  "stocks": [
    {
      "id": "s1",
      "name": "Housing Stock",
      "initial_value": 1000,
      "equation": "",
      "position": {"x": 200, "y": 150}
    },
    {
      "id": "s2",
      "name": "Land Available",
      "initial_value": 500,
      "equation": "",
      "position": {"x": 400, "y": 150}
    },
    {
      "id": "s3",
      "name": "Housing Price Index",
      "initial_value": 100,
      "equation": "",
      "position": {"x": 200, "y": 300}
    },
    {
      "id": "s4",
      "name": "Land Price Index",
      "initial_value": 100,
      "equation": "",
      "position": {"x": 400, "y": 300}
    },
    {
      "id": "s5",
      "name": "Housing Demand",
      "initial_value": 1050,
      "equation": "",
      "position": {"x": 100, "y": 450}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "New Housing Construction",
      "equation": "Construction_Rate * Land_Available * Density_Limit * Profitability_Signal",
      "from_stock": null,
      "to_stock": "s1",
      "position": {"x": 100, "y": 150}
    },
    {
      "id": "f2",
      "name": "Housing Depreciation",
      "equation": "Housing_Stock * Depreciation_Rate",
      "from_stock": "s1",
      "to_stock": null,
      "position": {"x": 300, "y": 150}
    },
    {
      "id": "f3",
      "name": "Land Development",
      "equation": "Land_Release_Rate * (1 - UGB_Restriction)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {"x": 500, "y": 150}
    },
    {
      "id": "f4",
      "name": "Land Used for Housing",
      "equation": "New_Housing_Construction / (Density_Limit * Units_Per_Acre)",
      "from_stock": "s2",
      "to_stock": null,
      "position": {"x": 350, "y": 100}
    },
    {
      "id": "f5",
      "name": "Housing Price Change",
      "equation": "(Supply_Demand_Gap / Housing_Stock) * Price_Adjustment_Speed * Housing_Price_Index",
      "from_stock": null,
      "to_stock": "s3",
      "position": {"x": 200, "y": 350}
    },
    {
      "id": "f6",
      "name": "Land Price Change",
      "equation": "(Land_Scarcity_Index - 1) * Land_Price_Adjustment * Land_Price_Index",
      "from_stock": null,
      "to_stock": "s4",
      "position": {"x": 400, "y": 350}
    },
    {
      "id": "f7",
      "name": "Demand Growth",
      "equation": "Population_Growth_Rate * Housing_Demand - Price_Elasticity * (Housing_Price_Index - 100) * 0.01 * Housing_Demand",
      "from_stock": null,
      "to_stock": "s5",
      "position": {"x": 100, "y": 500}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Construction Rate",
      "equation": "0.05",
      "position": {"x": 50, "y": 100}
    },
    {
      "id": "v2",
      "name": "Density Limit",
      "equation": "0.8",
      "position": {"x": 150, "y": 100}
    },
    {
      "id": "v3",
      "name": "Profitability Signal",
      "equation": "MAX(0, (Housing_Price_Index - Construction_Cost_Index) / Housing_Price_Index)",
      "position": {"x": 100, "y": 200}
    },
    {
      "id": "v4",
      "name": "Construction Cost Index",
      "equation": "80 + Land_Price_Index * 0.2",
      "position": {"x": 300, "y": 200}
    },
    {
      "id": "v5",
      "name": "Depreciation Rate",
      "equation": "0.01",
      "position": {"x": 250, "y": 100}
    },
    {
      "id": "v6",
      "name": "Land Release Rate",
      "equation": "10",
      "position": {"x": 500, "y": 100}
    },
    {
      "id": "v7",
      "name": "UGB Restriction",
      "equation": "0.3",
      "position": {"x": 550, "y": 200}
    },
    {
      "id": "v8",
      "name": "Units Per Acre",
      "equation": "10",
      "position": {"x": 450, "y": 100}
    },
    {
      "id": "v9",
      "name": "Supply Demand Gap",
      "equation": "Housing_Demand - Housing_Stock",
      "position": {"x": 150, "y": 400}
    },
    {
      "id": "v10",
      "name": "Price Adjustment Speed",
      "equation": "0.1",
      "position": {"x": 250, "y": 400}
    },
    {
      "id": "v11",
      "name": "Land Scarcity Index",
      "equation": "1 + (1 - Land_Available / 500) * 2",
      "position": {"x": 450, "y": 400}
    },
    {
      "id": "v12",
      "name": "Land Price Adjustment",
      "equation": "0.05",
      "position": {"x": 500, "y": 400}
    },
    {
      "id": "v13",
      "name": "Population Growth Rate",
      "equation": "0.02",
      "position": {"x": 50, "y": 450}
    },
    {
      "id": "v14",
      "name": "Price Elasticity",
      "equation": "0.5",
      "position": {"x": 200, "y": 500}
    },
    {
      "id": "v15",
      "name": "Affordability Ratio",
      "equation": "Housing_Price_Index / 100",
      "position": {"x": 300, "y": 450}
    }
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 120, "dt": 1},
  "created_at": "2026-01-15T16:00:00.000000",
  "updated_at": "2026-01-15T16:00:00.000000",
  "source": "https://doi.org/10.1016/j.cities.2022.103767",
  "reference": "Herath, S., et al. (2022). Effects of planning regulations on housing and land markets: A system dynamics modeling approach. Cities, 127, 103767."
}
