{
  "id": "holling-type-ii-functional-response-eco",
  "name": "Holling Type II Disc Equation",
  "description": "Functional response model showing predator handling time limits consumption. Source: Holling (1959), Canadian Entomologist. Reference: Holling, C. S. (1973). Resilience and stability of ecological systems. Annual Review of Ecology and Systematics, 4, 1-23. DOI: https://doi.org/10.1146/annurev.es.04.110173.000245",
  "stocks": [
    {
      "id": "s1",
      "name": "Prey_Population",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Predator_Satiation",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Prey_Dynamics",
      "equation": "r * Prey_Population * (1 - Prey_Population / K) - Consumption_Rate * Predator_Count",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Satiation_Change",
      "equation": "Consumption_Rate - Digestion_Rate * Predator_Satiation",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "r",
      "equation": "0.5",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "K",
      "equation": "200",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "a",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "h",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Predator_Count",
      "equation": "10",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Digestion_Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Consumption_Rate",
      "equation": "a * Prey_Population / (1 + a * h * Prey_Population)",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Prey_Population",
      "to_element": "Consumption_Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.1
  },
  "created_at": "2026-01-15T14:38:02.262100+00:00",
  "updated_at": "2026-01-15T14:38:02.262103+00:00",
  "source": "https://doi.org/10.4039/Ent91293-5",
  "reference": "Holling, C.S. (1959). The components of predation as revealed by a study of small-mammal predation of the European Pine Sawfly. Canadian Entomologist 91:293-320."
}