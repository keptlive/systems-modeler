{
  "id": "housing-supply-demand-equilibrium-eco",
  "name": "Housing Market Supply-Demand Equilibrium",
  "description": "Model of housing market dynamics showing how zoning, construction costs, and demand growth affect housing prices and affordability over time. Reference: NSIDC Arctic Sea Ice News. Source: https://nsidc.org/arcticseaicenews/",
  "source": "https://doi.org/10.1257/jep.32.1.3",
  "reference": "Glaeser EL, Gyourko J. The Economic Implications of Housing Supply. Journal of Economic Perspectives. 2018;32(1):3-30.",
  "stocks": [
    {
      "id": "stock-supply",
      "name": "Housing_Stock",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "stock-demand",
      "name": "Housing_Demand",
      "initial_value": 105000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "stock-price",
      "name": "Housing_Price_Index",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 500,
        "y": 225
      }
    }
  ],
  "flows": [
    {
      "id": "flow-construct",
      "name": "New_Construction",
      "equation": "construction_rate * Price_Signal * (1 - regulatory_friction)",
      "from_stock": null,
      "to_stock": "stock-supply",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-demolish",
      "name": "Demolition",
      "equation": "Housing_Stock * depreciation_rate",
      "from_stock": "stock-supply",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-demand-grow",
      "name": "Demand_Growth",
      "equation": "Housing_Demand * (population_growth + income_effect)",
      "from_stock": null,
      "to_stock": "stock-demand",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-price-adj",
      "name": "Price_Adjustment",
      "equation": "price_sensitivity * (Housing_Demand - Housing_Stock) / Housing_Stock * Housing_Price_Index",
      "from_stock": null,
      "to_stock": "stock-price",
      "position": {
        "x": 500,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-construct",
      "name": "construction_rate",
      "equation": "500",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "var-reg",
      "name": "regulatory_friction",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "var-deprec",
      "name": "depreciation_rate",
      "equation": "0.005",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-pop-gr",
      "name": "population_growth",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-income",
      "name": "income_effect",
      "equation": "0.005",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-sense",
      "name": "price_sensitivity",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-signal",
      "name": "Price_Signal",
      "equation": "max(0.5, Housing_Price_Index / 100)",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-shortage",
      "name": "Housing_Shortage",
      "equation": "max(0, Housing_Demand - Housing_Stock)",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-afford",
      "name": "Affordability_Index",
      "equation": "100 / Housing_Price_Index",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T12:00:00.000000+00:00",
  "updated_at": "2026-01-12T12:00:00.000000+00:00"
}