{
  "id": "okuns-law-output-unemployment-eco",
  "name": "Okun's Law Output-Unemployment Model",
  "description": "Empirical relationship between changes in unemployment and GDP growth, fundamental to macroeconomic forecasting. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "GDP",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Unemployment_Rate",
      "initial_value": 0.05,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "GDP_Growth",
      "equation": "Trend_Growth * GDP + Demand_Impulse",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Unemployment_Change",
      "equation": "-Okun_Coefficient * (GDP_Growth_Rate - Trend_Growth)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 100,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Trend_Growth",
      "equation": "0.02",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "v2",
      "name": "Okun_Coefficient",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v3",
      "name": "Natural_Unemployment",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v4",
      "name": "Demand_Impulse",
      "equation": "0",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "GDP_Growth_Rate",
      "equation": "GDP_Growth / GDP",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:20:56.316287+00:00",
  "updated_at": "2026-01-12T11:20:56.316287+00:00",
  "source": "https://doi.org/10.2307/2534088",
  "reference": "Okun AM. Potential GNP: Its measurement and significance. Proceedings of the Business and Economic Statistics Section. American Statistical Association. 1962:98-104."
}