{
  "id": "goodwin-minsky-cycle-eco",
  "name": "Goodwin-Minsky Growth Cycle Model",
  "description": "Combined Goodwin predator-prey business cycle with Minsky financial instability showing wage share, employment, and debt dynamics. Based on Keen (2013). Reference: Minsky, H. P. (1992). The financial instability hypothesis. Levy Economics Institute Working Paper No. 74. DOI: https://doi.org/10.1080/05775132.1992.11471543",
  "stocks": [
    {
      "id": "s1",
      "name": "Wage Share",
      "initial_value": 0.75,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Employment Rate",
      "initial_value": 0.9,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Debt Ratio",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Wage Change",
      "equation": "Wage_Share * Phillips_Curve",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Employment Change",
      "equation": "(Investment_Rate - Alpha - Beta - Depreciation) * Employment_Rate",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Debt Change",
      "equation": "Investment_Rate - Profit_Rate + Interest_Rate * Debt_Ratio",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Phillips Curve",
      "equation": "(-0.04 + 0.04 / (1 - Employment_Rate))",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Profit Share",
      "equation": "1 - Wage_Share",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Profit Rate",
      "equation": "Profit_Share - Interest_Rate * Debt_Ratio",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "v4",
      "name": "Investment Rate",
      "equation": "Profit_Rate * Investment_Sensitivity",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "v5",
      "name": "Investment Sensitivity",
      "equation": "5",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Alpha",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Beta",
      "equation": "0.01",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Depreciation",
      "equation": "0.05",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "Interest Rate",
      "equation": "0.03",
      "position": {
        "x": 550,
        "y": 100
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Employment Rate",
      "to_element": "Phillips Curve"
    },
    {
      "id": "c2",
      "from_element": "Wage Share",
      "to_element": "Profit Share"
    },
    {
      "id": "c3",
      "from_element": "Debt Ratio",
      "to_element": "Profit Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.1
  },
  "created_at": "2026-01-12T01:55:42.037456+00:00",
  "updated_at": "2026-01-12T01:55:42.037537+00:00",
  "source": "https://doi.org/10.1016/j.jebo.2013.01.013",
  "reference": "Keen S. A monetary Minsky model of the Great Moderation and the Great Recession. J Econ Behav Organ. 2013;86:221-235."
}