{
  "id": "cournot-oligopoly-competition-eco",
  "name": "Cournot Oligopoly Competition Model",
  "description": "Classic quantity competition between firms with market feedback. Source: Cournot (1838) and Tirole (1988). DOI: 10.7551/mitpress/3086.001.0001",
  "stocks": [
    {
      "id": "stock-q1",
      "name": "Firm1_Quantity",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-q2",
      "name": "Firm2_Quantity",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-profit1",
      "name": "Firm1_Profit",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "stock-profit2",
      "name": "Firm2_Profit",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-adj1",
      "name": "Firm1_Adjustment",
      "equation": "(Best_Response_1 - Firm1_Quantity) * Adjustment_Speed",
      "from_stock": null,
      "to_stock": "stock-q1",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-adj2",
      "name": "Firm2_Adjustment",
      "equation": "(Best_Response_2 - Firm2_Quantity) * Adjustment_Speed",
      "from_stock": null,
      "to_stock": "stock-q2",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "flow-profit1",
      "name": "Profit1_Flow",
      "equation": "Firm1_Quantity * (Market_Price - Marginal_Cost_1)",
      "from_stock": null,
      "to_stock": "stock-profit1",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-profit2",
      "name": "Profit2_Flow",
      "equation": "Firm2_Quantity * (Market_Price - Marginal_Cost_2)",
      "from_stock": null,
      "to_stock": "stock-profit2",
      "position": {
        "x": 250,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-a",
      "name": "Demand_Intercept",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-b",
      "name": "Demand_Slope",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-mc1",
      "name": "Marginal_Cost_1",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-mc2",
      "name": "Marginal_Cost_2",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-price",
      "name": "Market_Price",
      "equation": "Demand_Intercept - Demand_Slope * (Firm1_Quantity + Firm2_Quantity)",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "var-br1",
      "name": "Best_Response_1",
      "equation": "(Demand_Intercept - Marginal_Cost_1 - Demand_Slope * Firm2_Quantity) / (2 * Demand_Slope)",
      "position": {
        "x": 150,
        "y": 175
      }
    },
    {
      "id": "var-br2",
      "name": "Best_Response_2",
      "equation": "(Demand_Intercept - Marginal_Cost_2 - Demand_Slope * Firm1_Quantity) / (2 * Demand_Slope)",
      "position": {
        "x": 150,
        "y": 325
      }
    },
    {
      "id": "var-adjspeed",
      "name": "Adjustment_Speed",
      "equation": "0.2",
      "position": {
        "x": 50,
        "y": 175
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Firm1_Quantity",
      "to_element": "Best_Response_2"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:09:47.460702+00:00",
  "updated_at": "2026-01-12T02:09:47.460706+00:00",
  "source": "https://doi.org/10.7551/mitpress/3086.001.0001",
  "reference": "Tirole, J. (1988). The Theory of Industrial Organization. MIT Press."
}