{
  "id": "galor-zeira-inequality-growth-eco",
  "name": "Galor-Zeira Inequality and Growth Model",
  "description": "Shows how credit market imperfections create persistent inequality through education investment. Reference: Juran, J. M. (1999). Juran's Quality Handbook. McGraw-Hill. Source: https://www.mheducation.com/",
  "stocks": [
    {
      "id": "s1",
      "name": "Skilled_Workers",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Unskilled_Workers",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Aggregate_Wealth",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Education_Investment",
      "equation": "Education_Rate * Unskilled_Workers",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Births_Skilled",
      "equation": "Birth_Rate_GZ * Skilled_Workers",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Births_Unskilled",
      "equation": "Birth_Rate_GZ * Unskilled_Workers",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Wealth_Accumulation",
      "equation": "Savings_Rate_GZ * Total_Income - Depreciation_GZ * Aggregate_Wealth",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 150,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Skilled_Wage",
      "equation": "2 * Productivity_Factor",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Unskilled_Wage",
      "equation": "Productivity_Factor",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Education_Cost",
      "equation": "5",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Education_Rate",
      "equation": "IF(Avg_Unskilled_Wealth > Education_Cost / (1 - Interest_Rate_GZ), 0.1, 0.02)",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Interest_Rate_GZ",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Productivity_Factor",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Total_Income",
      "equation": "Skilled_Wage * Skilled_Workers + Unskilled_Wage * Unskilled_Workers",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "v8",
      "name": "Avg_Unskilled_Wealth",
      "equation": "0.3 * Aggregate_Wealth / Unskilled_Workers",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "v9",
      "name": "Savings_Rate_GZ",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Depreciation_GZ",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v11",
      "name": "Birth_Rate_GZ",
      "equation": "0.02",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v12",
      "name": "Gini_Coefficient",
      "equation": "ABS(Skilled_Workers - Unskilled_Workers) / (Skilled_Workers + Unskilled_Workers)",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:20:56.327966+00:00",
  "updated_at": "2026-01-12T11:20:56.327966+00:00",
  "source": "https://doi.org/10.2307/2297811",
  "reference": "Galor O, Zeira J. Income distribution and macroeconomics. The Review of Economic Studies. 1993;60(1):35-52."
}