{
  "id": "predator-prey-carrying-capacity-eco",
  "name": "Predator-Prey with Carrying Capacity",
  "description": "Extended Lotka-Volterra predator-prey model with carrying capacity for prey and functional response for predator. More realistic than basic model. Source: Rosenzweig & MacArthur (1963), American Naturalist. DOI: 10.1086/282272",
  "stocks": [
    {
      "id": "stock-prey",
      "name": "Prey",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-predator",
      "name": "Predator",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-prey-birth",
      "name": "Prey_Birth",
      "equation": "Prey_Growth_Rate * Prey * (1 - Prey / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-prey",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-predation",
      "name": "Predation",
      "equation": "Attack_Rate * Prey * Predator / (1 + Handling_Time * Attack_Rate * Prey)",
      "from_stock": "stock-prey",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-predator-birth",
      "name": "Predator_Birth",
      "equation": "Conversion_Efficiency * Predation",
      "from_stock": null,
      "to_stock": "stock-predator",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-predator-death",
      "name": "Predator_Death",
      "equation": "Predator_Death_Rate * Predator",
      "from_stock": "stock-predator",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-prey-growth",
      "name": "Prey_Growth_Rate",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-carrying-capacity",
      "name": "Carrying_Capacity",
      "equation": "200",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-attack-rate",
      "name": "Attack_Rate",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-handling-time",
      "name": "Handling_Time",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-conversion",
      "name": "Conversion_Efficiency",
      "equation": "0.3",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-predator-death",
      "name": "Predator_Death_Rate",
      "equation": "0.2",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-functional-response",
      "name": "Functional_Response",
      "equation": "Attack_Rate * Prey / (1 + Handling_Time * Attack_Rate * Prey)",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Prey",
      "to_element": "Prey_Birth"
    },
    {
      "id": "conn-2",
      "from_element": "Prey",
      "to_element": "Predation"
    },
    {
      "id": "conn-3",
      "from_element": "Predator",
      "to_element": "Predation"
    },
    {
      "id": "conn-4",
      "from_element": "Predator",
      "to_element": "Predator_Death"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.1
  },
  "created_at": "2026-01-11T20:52:52.274738+00:00",
  "updated_at": "2026-01-11T20:52:52.274738+00:00",
  "source": "https://doi.org/10.1073/pnas.6.7.410",
  "reference": "Lotka AJ. Elements of Physical Biology. Williams & Wilkins, 1925."
}