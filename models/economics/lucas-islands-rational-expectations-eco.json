{
  "id": "lucas-islands-rational-expectations-eco",
  "name": "Lucas Islands Rational Expectations Model",
  "description": "Nobel Prize model of monetary non-neutrality arising from imperfect information about aggregate conditions. Reference: Lucas, R. E. (1988). On the mechanics of economic development. Journal of Monetary Economics, 22(1), 3-42. DOI: https://doi.org/10.1016/0304-3932(88)90168-7",
  "stocks": [
    {
      "id": "s1",
      "name": "Expected_Price_Level",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Expectation_Update",
      "equation": "(Actual_Price_Level - Expected_Price_Level) * Learning_Rate",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Output_Change",
      "equation": "(Desired_Output - Output) / Output_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Money_Supply",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Money_Velocity",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Actual_Price_Level",
      "equation": "Money_Supply * Money_Velocity / Output",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Surprise_Component",
      "equation": "Actual_Price_Level / Expected_Price_Level - 1",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "v5",
      "name": "Natural_Output",
      "equation": "100",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Signal_Extraction_Ratio",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "v7",
      "name": "Desired_Output",
      "equation": "Natural_Output * (1 + Signal_Extraction_Ratio * Surprise_Component)",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "v8",
      "name": "Learning_Rate",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "v9",
      "name": "Output_Adjustment_Time",
      "equation": "2",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:26:32.201977+00:00",
  "updated_at": "2026-01-12T11:26:32.201977+00:00",
  "source": "https://doi.org/10.1016/0022-0531(72)90142-1",
  "reference": "Lucas RE Jr. Expectations and the neutrality of money. Journal of Economic Theory. 1972;4(2):103-124. Nobel Prize 1995."
}