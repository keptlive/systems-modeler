{
  "id": "rosenzweig-macarthur-paradox-eco",
  "name": "Paradox of Enrichment Model",
  "description": "Increasing carrying capacity destabilizes predator-prey dynamics. Enrichment causes oscillations with larger amplitude, eventually leading to extinction. Important for ecosystem management. Reference: Cachon, G., & Terwiesch, C. (2012). Matching Supply with Demand. McGraw-Hill. Source: https://www.mheducation.com/",
  "stocks": [
    {
      "id": "stock-prey",
      "name": "Prey",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-predator",
      "name": "Predator",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-prey-growth",
      "name": "Prey Growth",
      "equation": "Prey_Growth_Rate * Prey * (1 - Prey / Carrying_Capacity) - Predation",
      "from_stock": null,
      "to_stock": "stock-prey",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "flow-predator-growth",
      "name": "Predator Growth",
      "equation": "Conversion * Predation - Predator_Death_Rate * Predator",
      "from_stock": null,
      "to_stock": "stock-predator",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-r",
      "name": "Prey Growth Rate",
      "equation": "1.0",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-k",
      "name": "Carrying Capacity",
      "equation": "200",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-predation",
      "name": "Predation",
      "equation": "Attack_Rate * Prey * Predator / (1 + Attack_Rate * Handling_Time * Prey)",
      "position": {
        "x": 450,
        "y": 80
      }
    },
    {
      "id": "var-attack",
      "name": "Attack Rate",
      "equation": "0.1",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-handling",
      "name": "Handling Time",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-conversion",
      "name": "Conversion",
      "equation": "0.5",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-death",
      "name": "Predator Death Rate",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-stability",
      "name": "Stability Condition",
      "equation": "Carrying_Capacity * Attack_Rate * Handling_Time",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Prey",
      "to_element": "Predation"
    },
    {
      "id": "conn-2",
      "from_element": "Predator",
      "to_element": "Predation"
    },
    {
      "id": "conn-3",
      "from_element": "Predation",
      "to_element": "Predator Growth"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.1
  },
  "created_at": "2026-01-12T07:39:15.417959+00:00",
  "updated_at": "2026-01-12T07:39:15.417970+00:00",
  "source": "https://doi.org/10.1126/science.171.3969.385",
  "reference": "Rosenzweig ML. Paradox of Enrichment: Destabilization of Exploitation Ecosystems in Ecological Time. Science. 1971;171(3969):385-387."
}