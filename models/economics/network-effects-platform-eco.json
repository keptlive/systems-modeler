{
  "id": "network-effects-platform-eco",
  "name": "Network Effects Platform Model",
  "description": "A model of platform growth with network effects, showing how positive feedback can lead to winner-take-all dynamics or multi-homing equilibria. Reference: Katz, M. L., & Shapiro, C. (1985). Network externalities, competition, and compatibility. AER. Source: https://doi.org/10.2307/1814809",
  "source": "https://doi.org/10.1111/j.1756-2171.2006.tb00036.x",
  "reference": "Rochet JC, Tirole J. Platform Competition in Two-Sided Markets. Journal of the European Economic Association. 2003;1(4):990-1029.",
  "stocks": [
    {
      "id": "stock-users-a",
      "name": "Platform A Users",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-users-b",
      "name": "Platform B Users",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-growth-a",
      "name": "Platform A Growth",
      "equation": "Potential_Users * Adoption_Rate_A * Network_Value_A / (Network_Value_A + Network_Value_B + 1)",
      "from_stock": null,
      "to_stock": "stock-users-a",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-churn-a",
      "name": "Platform A Churn",
      "equation": "Platform_A_Users * Base_Churn * (1 - Network_Value_A / (Network_Value_A + 100))",
      "from_stock": "stock-users-a",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-growth-b",
      "name": "Platform B Growth",
      "equation": "Potential_Users * Adoption_Rate_B * Network_Value_B / (Network_Value_A + Network_Value_B + 1)",
      "from_stock": null,
      "to_stock": "stock-users-b",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-churn-b",
      "name": "Platform B Churn",
      "equation": "Platform_B_Users * Base_Churn * (1 - Network_Value_B / (Network_Value_B + 100))",
      "from_stock": "stock-users-b",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-potential",
      "name": "Potential Users",
      "equation": "Total_Market - Platform_A_Users - Platform_B_Users",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-net-a",
      "name": "Network Value A",
      "equation": "Platform_A_Users^Network_Exponent * Quality_A",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "var-net-b",
      "name": "Network Value B",
      "equation": "Platform_B_Users^Network_Exponent * Quality_B",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "var-total",
      "name": "Total Market",
      "equation": "10000",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-adopt-a",
      "name": "Adoption Rate A",
      "equation": "0.01",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-adopt-b",
      "name": "Adoption Rate B",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-churn",
      "name": "Base Churn",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-exp",
      "name": "Network Exponent",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-q-a",
      "name": "Quality A",
      "equation": "1",
      "position": {
        "x": 150,
        "y": 400
      }
    },
    {
      "id": "var-q-b",
      "name": "Quality B",
      "equation": "1.2",
      "position": {
        "x": 350,
        "y": 400
      }
    }
  ],
