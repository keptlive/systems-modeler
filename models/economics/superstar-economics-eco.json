{
  "id": "superstar-economics-eco",
  "name": "Superstar Economics Model",
  "description": "Models extreme earnings inequality from small talent differences. Source: Rosen (1981), AER. DOI: 10.2307/1803469",
  "stocks": [
    {
      "id": "stock-superstars",
      "name": "Superstars",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-regular",
      "name": "Regular_Performers",
      "initial_value": 990,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-audience",
      "name": "Total_Audience",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-promote",
      "name": "Promotion_To_Superstar",
      "equation": "Regular_Performers * Promotion_Rate * Talent_Discovery",
      "from_stock": "stock-regular",
      "to_stock": "stock-superstars",
      "position": {
        "x": 150,
        "y": 175
      }
    },
    {
      "id": "flow-demote",
      "name": "Demotion",
      "equation": "Superstars * Demotion_Rate",
      "from_stock": "stock-superstars",
      "to_stock": "stock-regular",
      "position": {
        "x": 50,
        "y": 175
      }
    },
    {
      "id": "flow-audiencegrow",
      "name": "Audience_Growth",
      "equation": "Total_Audience * (Tech_Growth - Audience_Churn)",
      "from_stock": null,
      "to_stock": "stock-audience",
      "position": {
        "x": 250,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-promote",
      "name": "Promotion_Rate",
      "equation": "0.001",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-talent",
      "name": "Talent_Discovery",
      "equation": "1 + Tech_Growth * 10",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-demote",
      "name": "Demotion_Rate",
      "equation": "0.02",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-techgrow",
      "name": "Tech_Growth",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-churn",
      "name": "Audience_Churn",
      "equation": "0.01",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "var-superincome",
      "name": "Superstar_Income",
      "equation": "Total_Audience / Superstars * Price_Per_Unit * Superstar_Share",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "var-regincome",
      "name": "Regular_Income",
      "equation": "Total_Audience / Regular_Performers * Price_Per_Unit * (1 - Superstar_Share)",
      "position": {
        "x": 150,
        "y": 325
      }
    },
    {
      "id": "var-price",
      "name": "Price_Per_Unit",
      "equation": "10",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-supershare",
      "name": "Superstar_Share",
      "equation": "0.8",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "var-inequality",
      "name": "Income_Ratio",
      "equation": "Superstar_Income / Regular_Income",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Total_Audience",
      "to_element": "Superstar_Income"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:23:02.238370+00:00",
  "updated_at": "2026-01-12T02:23:02.238373+00:00",
  "source": "https://doi.org/10.2307/1803469",
  "reference": "Rosen, S. (1981). The Economics of Superstars. American Economic Review."
}