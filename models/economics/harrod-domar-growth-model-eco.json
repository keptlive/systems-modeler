{
  "id": "harrod-domar-growth-model-eco",
  "name": "Harrod-Domar Growth Model",
  "description": "Post-Keynesian growth model relating savings, capital-output ratio, and growth. Source: Harrod (1939), Economic Journal; Domar (1946), Econometrica. Reference: Keynes, J. M. (1936). The General Theory of Employment, Interest and Money. London: Macmillan.",
  "stocks": [
    {
      "id": "s1",
      "name": "Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Capital",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Output_Growth",
      "equation": "Capital / v - Output",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Net_Investment",
      "equation": "s * Output - delta * Capital",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "s",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "v",
      "equation": "3",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "delta",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Warranted_Growth_Rate",
      "equation": "s / v",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Actual_Growth_Rate",
      "equation": "(Output_Growth) / Output",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
