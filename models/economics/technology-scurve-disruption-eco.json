{
  "id": "technology-scurve-disruption-eco",
  "name": "Technology S-Curve with Disruptive Innovation",
  "description": "Technology performance follows S-curve until disrupted by new technology. Foundation of innovation dynamics. Source: Christensen (1997) and Foster (1986). DOI: 10.1002/smj.4250120702",
  "stocks": [
    {
      "id": "stock-perf1",
      "name": "Incumbent_Performance",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-perf2",
      "name": "Disruptor_Performance",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "stock-market1",
      "name": "Incumbent_Market",
      "initial_value": 95,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "stock-market2",
      "name": "Disruptor_Market",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-imp1",
      "name": "Incumbent_Improvement",
      "equation": "R1 * Incumbent_Performance * (1 - Incumbent_Performance / K1)",
      "from_stock": null,
      "to_stock": "stock-perf1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "flow-imp2",
      "name": "Disruptor_Improvement",
      "equation": "R2 * Disruptor_Performance * (1 - Disruptor_Performance / K2)",
      "from_stock": null,
      "to_stock": "stock-perf2",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "flow-mktshift",
      "name": "Market_Shift",
      "equation": "Incumbent_Market * Shift_Rate * IF(Disruptor_Performance > Incumbent_Performance, 1, 0)",
      "from_stock": "stock-market1",
      "to_stock": "stock-market2",
      "position": {
        "x": 300,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-r1",
      "name": "R1",
      "equation": "0.1",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-r2",
      "name": "R2",
      "equation": "0.15",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "var-k1",
      "name": "K1",
      "equation": "100",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "var-k2",
      "name": "K2",
      "equation": "200",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "var-shift",
      "name": "Shift_Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Incumbent_Performance",
      "to_element": "Market_Shift"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:02:23.927281Z",
  "updated_at": "2026-01-12T02:02:23.927285Z",
  "source": "https://doi.org/10.1002/smj.4250120702",
  "reference": "Christensen, C.M. (1997). The Innovator's Dilemma. Harvard Business School Press."
}