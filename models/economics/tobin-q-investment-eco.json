{
  "id": "tobin-q-investment-eco",
  "name": "Tobin's Q Investment Model",
  "description": "James Tobin's Q theory of investment (1969 Nobel Prize work). Investment depends on the ratio of market value of capital to replacement cost. When Q > 1, firms should invest; when Q < 1, they should divest. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-capital",
      "name": "Capital Stock",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-market-value",
      "name": "Market Value",
      "initial_value": 120,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-investment",
      "name": "Investment",
      "equation": "Investment_Function",
      "from_stock": null,
      "to_stock": "stock-capital",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-depreciation",
      "name": "Depreciation",
      "equation": "Capital_Stock * Depreciation_Rate",
      "from_stock": "stock-capital",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-value-change",
      "name": "Value Change",
      "equation": "(Expected_Return * Capital_Stock - Market_Value) * Adjustment_Speed",
      "from_stock": null,
      "to_stock": "stock-market-value",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-tobins-q",
      "name": "Tobins Q",
      "equation": "Market_Value / (Capital_Stock * Replacement_Cost)",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-replacement-cost",
      "name": "Replacement Cost",
      "equation": "1",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-investment-function",
      "name": "Investment Function",
      "equation": "Base_Investment * (1 + Investment_Sensitivity * (Tobins_Q - 1))",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-base-investment",
      "name": "Base Investment",
      "equation": "10",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-investment-sensitivity",
      "name": "Investment Sensitivity",
      "equation": "0.5",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-depreciation-rate",
      "name": "Depreciation Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-expected-return",
      "name": "Expected Return",
      "equation": "1.2",
      "position": {
        "x": 250,
        "y": 160
      }
    },
    {
      "id": "var-adjustment-speed",
      "name": "Adjustment Speed",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 160
      }
    }
  ],
  "connectors": [],
