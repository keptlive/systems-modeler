{
  "id": "forest-fire-spread-eco",
  "name": "Forest Fire Spread Dynamics",
  "description": "Model of wildfire spread and containment. Captures the interplay of fuel load, weather conditions, and firefighting resources. Based on fire ecology and wildland fire management research. Reference: NIFC National Interagency Fire Center. Source: https://www.nifc.gov/",
  "stocks": [
    {
      "id": "s1",
      "name": "Unburned_Area",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Actively_Burning",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Burned_Area",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Firefighting_Resources",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Fire_Spread",
      "equation": "Actively_Burning * Spread_Rate * Weather_Factor * Fuel_Load",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Burnout",
      "equation": "Actively_Burning / Burn_Duration",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Suppression",
      "equation": "MIN(Actively_Burning, Firefighting_Resources * Suppression_Effectiveness)",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 270
      }
    },
    {
      "id": "f4",
      "name": "Resource_Deployment",
      "equation": "(Target_Resources - Firefighting_Resources) / Mobilization_Time",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Spread_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "v2",
      "name": "Burn_Duration",
      "equation": "2",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "v3",
      "name": "Weather_Factor",
      "equation": "1.5",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "v4",
      "name": "Fuel_Load",
      "equation": "1.2",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "v5",
      "name": "Suppression_Effectiveness",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "Target_Resources",
      "equation": "Actively_Burning * 0.8",
      "position": {
        "x": 300,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Mobilization_Time",
      "equation": "3",
      "position": {
        "x": 500,
        "y": 130
      }
    },
    {
      "id": "v8",
      "name": "Containment_Ratio",
      "equation": "Suppression / MAX(Fire_Spread, 1)",
      "position": {
        "x": 300,
        "y": 180
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1073/pnas.1617394114",
  "reference": "Abatzoglou JT, Williams AP (2016) Impact of anthropogenic climate change on wildfire across western US forests. PNAS.",
  "created_at": "2026-01-12T07:00:37.510230+00:00",
  "updated_at": "2026-01-12T07:00:37.510230+00:00"
}