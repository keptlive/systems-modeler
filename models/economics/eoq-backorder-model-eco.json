{
  "id": "eoq-backorder-model-eco",
  "name": "Economic Order Quantity with Backorders",
  "description": "Extended EOQ model allowing backorders. Classic inventory management foundation. Source: Wilson (1934) and Hadley & Whitin (1963). DOI: 10.1287/mnsc.1.2.89",
  "stocks": [
    {
      "id": "stock-inv",
      "name": "Inventory_Position",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "stock-backlog",
      "name": "Backlog",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-order",
      "name": "Order_Arrival",
      "equation": "IF(MOD(TIME, Reorder_Cycle) < DT, Order_Quantity / DT, 0)",
      "from_stock": null,
      "to_stock": "stock-inv",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-demand",
      "name": "Demand_Fulfillment",
      "equation": "MIN(MAX(0, Inventory_Position), Demand_Rate + Backlog_Fill)",
      "from_stock": "stock-inv",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-backlog-create",
      "name": "Backlog_Creation",
      "equation": "MAX(0, Demand_Rate - Inventory_Position)",
      "from_stock": null,
      "to_stock": "stock-backlog",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "flow-backlog-fill",
      "name": "Backlog_Fill",
      "equation": "MIN(Backlog, MAX(0, Inventory_Position - Demand_Rate))",
      "from_stock": "stock-backlog",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-demand",
      "name": "Demand_Rate",
      "equation": "20",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-orderq",
      "name": "Order_Quantity",
      "equation": "200",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-cycle",
      "name": "Reorder_Cycle",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "var-holding",
      "name": "Holding_Cost",
      "equation": "1",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-backorder",
      "name": "Backorder_Cost",
      "equation": "5",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Inventory_Position",
      "to_element": "Demand_Fulfillment"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:02:23.926894Z",
  "updated_at": "2026-01-12T02:02:23.926912Z",
  "source": "https://doi.org/10.1287/mnsc.1.2.89",
  "reference": "Hadley, G. & Whitin, T.M. (1963). Analysis of Inventory Systems. Prentice-Hall."
}