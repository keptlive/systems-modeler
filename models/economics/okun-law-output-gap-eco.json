{
  "id": "okun-law-output-gap-eco",
  "name": "Okun's Law Output Gap Model",
  "description": "Arthur Okun's empirical relationship (1962) between unemployment and output gap. For every 1% increase in unemployment above natural rate, GDP falls about 2% below potential. A fundamental macroeconomic relationship. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "stock-gdp",
      "name": "GDP",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-unemployment",
      "name": "Unemployment",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-gdp-growth",
      "name": "GDP Growth",
      "equation": "GDP * (Potential_Growth_Rate - Okun_Coefficient * (Unemployment - Natural_Rate) / 100)",
      "from_stock": null,
      "to_stock": "stock-gdp",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-unemployment-change",
      "name": "Unemployment Change",
      "equation": "(Natural_Rate - Unemployment) * Adjustment_Speed + Labor_Force_Shock",
      "from_stock": null,
      "to_stock": "stock-unemployment",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
