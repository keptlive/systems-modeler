{
  "id": "sterman-commodity-cycles-ch20-eco",
  "name": "Sterman Commodity Cycles Ch20",
  "description": "Commodity market cycles model from Sterman (2000) Business Dynamics Chapter 20. Shows how production capacity adjustments, inventory, and price dynamics create boom-bust commodity cycles. Reference: Sterman, J. D. (2000). Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill. Source: https://systemdynamics.org/\n\nVersion 1.8 analytically eliminates the existing Demand-Market_Price algebraic loop. With D0=100, C=Inventory_Coverage, J=MAX(1,Inventory), and e=Price_Elasticity_Demand, the two authored relations imply D=D0*(J/(C*D0))^(e/(1+e)). This preserves both equations for positive C,J and e>-1; it does not establish reproduction of Sterman chapter 20 or empirical calibration.",
  "stocks": [
    {
      "id": "s1",
      "name": "Production_Capacity",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Inventory",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Capacity_Under_Construction",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "s4",
      "name": "Expected_Price",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 600,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Capacity_Expansion",
      "equation": "Capacity_Under_Construction / Construction_Time",
      "from_stock": "s3",
      "to_stock": "s1",
      "position": {
        "x": 200,
        "y": 275
      }
    },
    {
      "id": "f2",
      "name": "Capacity_Retirement",
      "equation": "Production_Capacity * Depreciation_Rate",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "New_Construction",
      "equation": "Desired_New_Capacity",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "f4",
      "name": "Production",
      "equation": "MIN(Production_Capacity * Capacity_Utilization, MAX(0, Inventory_Gap / Adjustment_Time + Demand))",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Shipments",
      "equation": "Demand",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Price_Adjustment",
      "equation": "(Market_Price - Expected_Price) / Price_Expectation_Time",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 600,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Construction_Time",
      "equation": "24",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "v2",
      "name": "Depreciation_Rate",
      "equation": "0.04",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Desired_New_Capacity",
      "equation": "MAX(0, (Desired_Capacity - Production_Capacity - Capacity_Under_Construction) / Construction_Time)",
      "position": {
        "x": 50,
        "y": 400
      }
    },
    {
      "id": "v4",
      "name": "Desired_Capacity",
      "equation": "100 * (Expected_Price / Reference_Price)^Price_Elasticity_Supply",
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "v5",
      "name": "Capacity_Utilization",
      "equation": "0.9",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Demand",
      "equation": "100 * (MAX(1, Inventory) / (100 * Inventory_Coverage))^(Price_Elasticity_Demand / (1 + Price_Elasticity_Demand))",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Reference_Price",
      "equation": "50",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Price_Elasticity_Demand",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "Price_Elasticity_Supply",
      "equation": "0.8",
      "position": {
        "x": 200,
        "y": 500
      }
    },
    {
      "id": "v10",
      "name": "Inventory_Gap",
      "equation": "Desired_Inventory - Inventory",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v11",
      "name": "Desired_Inventory",
      "equation": "Demand * Inventory_Coverage",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v12",
      "name": "Inventory_Coverage",
      "equation": "2",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v13",
      "name": "Adjustment_Time",
      "equation": "4",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v14",
      "name": "Market_Price",
      "equation": "Reference_Price * (Desired_Inventory / MAX(1, Inventory))",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "v15",
      "name": "Price_Expectation_Time",
      "equation": "12",
      "position": {
        "x": 700,
        "y": 350
      }
    }
  ],
