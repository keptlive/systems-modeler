    },
    {
      "id": "conn-2",
      "from_element": "Pollution Level",
      "to_element": "Victim Marginal Damage"
    },
    {
      "id": "conn-3",
      "from_element": "Transaction Costs",
      "to_element": "Bargaining Speed"
    }
  ],
