{
  "id": "blanchard-quah-decomposition-eco",
  "name": "Blanchard-Quah VAR Decomposition Model",
  "description": "Structural VAR model decomposing output fluctuations into supply and demand shocks. Reference: Blanchard, O.J. & Quah, D. (1989). The Dynamic Effects of Aggregate Demand and Supply Disturbances.",
  "stocks": [
    {
      "id": "s1",
      "name": "Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Unemployment",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Potential_Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Supply_Effect",
      "equation": "Supply_Shock * Potential_Output * 0.1",
      "from_stock": null,
      "to_stock": "Output",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Demand_Effect",
      "equation": "Demand_Shock * 5 - Output_Gap * 0.2",
      "from_stock": null,
      "to_stock": "Output",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Okun_Law",
      "equation": "-(Output - Potential_Output) * Okun_Coefficient / 100",
      "from_stock": null,
      "to_stock": "Unemployment",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Potential_Growth",
      "equation": "Supply_Shock * 0.5 + Trend_Growth",
      "from_stock": null,
      "to_stock": "Potential_Output",
      "position": {
        "x": 550,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Supply_Shock",
      "equation": "0.01 * SIN(time / 20)",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Demand_Shock",
      "equation": "0.02 * SIN(time / 8)",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Output_Gap",
      "equation": "Output - Potential_Output",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Okun_Coefficient",
      "equation": "2",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Trend_Growth",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "NAIRU",
      "equation": "5",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Cyclical_Unemployment",
      "equation": "Unemployment - NAIRU",
      "position": {
        "x": 400,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1257/aer.79.4.655",
  "reference": "Blanchard, O.J. & Quah, D. (1989). The Dynamic Effects of Aggregate Demand and Supply Disturbances. American Economic Review, 79(4), 655-673.",
