      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Adopters Product B",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
