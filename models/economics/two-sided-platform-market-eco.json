{
  "id": "two-sided-platform-market-eco",
  "name": "Two-Sided Platform Market Model",
  "description": "Model of platform economics with network effects between two user groups (e.g., buyers and sellers, riders and drivers). Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "stock-users",
      "name": "Platform_Users",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-providers",
      "name": "Service_Providers",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-user-growth",
      "name": "User_Growth",
      "equation": "Platform_Users * (Base_User_Growth + Cross_Network_Effect * Service_Providers / 1000)",
      "from_stock": null,
      "to_stock": "stock-users",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "flow-provider-growth",
      "name": "Provider_Growth",
      "equation": "Service_Providers * (Base_Provider_Growth + Cross_Network_Effect * Platform_Users / 10000)",
      "from_stock": null,
      "to_stock": "stock-providers",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "flow-user-churn",
      "name": "User_Churn",
      "equation": "Platform_Users * User_Churn_Rate",
      "from_stock": "stock-users",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "flow-provider-churn",
      "name": "Provider_Churn",
      "equation": "Service_Providers * Provider_Churn_Rate",
      "from_stock": "stock-providers",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-user-base",
      "name": "Base_User_Growth",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-provider-base",
      "name": "Base_Provider_Growth",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-cross",
      "name": "Cross_Network_Effect",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "var-user-churn",
      "name": "User_Churn_Rate",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-provider-churn",
      "name": "Provider_Churn_Rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [
