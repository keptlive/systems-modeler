{
  "id": "circular-economy-transition-eco",
  "name": "Circular Economy Transition Model",
  "description": "Model of transition from linear to circular economy. Shows material flows, recycling loops, and the dynamics of shifting business models toward product-as-service and material recovery. Based on Ellen MacArthur Foundation frameworks.",
  "stocks": [
    {
      "id": "s1",
      "name": "Virgin_Material_Use",
      "initial_value": 100,
      "equation": "",
      "position": {"x": 150, "y": 200}
    },
    {
      "id": "s2",
      "name": "Recycled_Material_Use",
      "initial_value": 10,
      "equation": "",
      "position": {"x": 400, "y": 200}
    },
    {
      "id": "s3",
      "name": "Waste_Stock",
      "initial_value": 500,
      "equation": "",
      "position": {"x": 275, "y": 350}
    },
    {
      "id": "s4",
      "name": "Circular_Infrastructure",
      "initial_value": 20,
      "equation": "",
      "position": {"x": 500, "y": 350}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Virgin_Extraction",
      "equation": "MAX(0, Total_Demand - Recycled_Material_Use) * (1 - Substitution_Effect)",
      "from_stock": null,
      "to_stock": "Virgin_Material_Use",
      "position": {"x": 50, "y": 200}
    },
    {
      "id": "f2",
      "name": "Virgin_to_Waste",
      "equation": "Virgin_Material_Use * Linear_Fraction",
      "from_stock": "Virgin_Material_Use",
      "to_stock": "Waste_Stock",
      "position": {"x": 150, "y": 275}
    },
    {
      "id": "f3",
      "name": "Recovery",
      "equation": "Waste_Stock * Recovery_Rate * Circular_Infrastructure / 100",
      "from_stock": "Waste_Stock",
      "to_stock": "Recycled_Material_Use",
      "position": {"x": 350, "y": 275}
    },
    {
      "id": "f4",
      "name": "Landfill",
      "equation": "Waste_Stock * Landfill_Rate * (1 - Circular_Infrastructure / 100)",
      "from_stock": "Waste_Stock",
      "to_stock": null,
      "position": {"x": 175, "y": 350}
    },
    {
      "id": "f5",
      "name": "Infrastructure_Investment",
      "equation": "(Target_Infrastructure - Circular_Infrastructure) / Investment_Time * Policy_Support",
      "from_stock": null,
      "to_stock": "Circular_Infrastructure",
      "position": {"x": 600, "y": 350}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Total_Demand",
      "equation": "100",
      "position": {"x": 100, "y": 80}
    },
    {
      "id": "v2",
      "name": "Substitution_Effect",
      "equation": "MIN(0.5, Recycled_Material_Use / Total_Demand)",
      "position": {"x": 250, "y": 80}
    },
    {
      "id": "v3",
      "name": "Linear_Fraction",
      "equation": "MAX(0.3, 1 - Circular_Infrastructure / 100)",
      "position": {"x": 100, "y": 450}
    },
    {
      "id": "v4",
      "name": "Recovery_Rate",
      "equation": "0.1",
      "position": {"x": 350, "y": 450}
    },
    {
      "id": "v5",
      "name": "Landfill_Rate",
      "equation": "0.05",
      "position": {"x": 175, "y": 450}
    },
    {
      "id": "v6",
      "name": "Target_Infrastructure",
      "equation": "80",
      "position": {"x": 500, "y": 450}
    },
    {
      "id": "v7",
      "name": "Investment_Time",
      "equation": "20",
      "position": {"x": 600, "y": 450}
    },
    {
      "id": "v8",
      "name": "Policy_Support",
      "equation": "1",
      "position": {"x": 700, "y": 350}
    },
    {
      "id": "v9",
      "name": "Circularity_Rate",
      "equation": "Recycled_Material_Use / (Virgin_Material_Use + Recycled_Material_Use)",
      "position": {"x": 400, "y": 80}
    },
    {
      "id": "v10",
      "name": "Resource_Productivity",
      "equation": "Total_Demand / Virgin_Material_Use",
      "position": {"x": 550, "y": 80}
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2060,
    "dt": 1
  },
  "source": "https://doi.org/10.1016/j.resconrec.2017.09.005",
  "reference": "Ellen MacArthur Foundation (2019). Completing the Picture: How the Circular Economy Tackles Climate Change. Also: Geissdoerfer M, et al. (2017). The Circular Economy – A new sustainability paradigm? Journal of Cleaner Production, 143, 757-768.",
  "created_at": "2026-01-15T20:30:00.000000Z",
  "updated_at": "2026-01-15T20:30:00.000000Z"
}
