      "from_element": "Matching Efficiency",
      "to_element": "Matching Function"
    },
    {
      "id": "conn-4",
      "from_element": "Employed Workers",
      "to_element": "Job Separations"
    },
    {
      "id": "conn-5",
      "from_element": "Separation Rate",
      "to_element": "Job Separations"
    },
    {
      "id": "conn-6",
      "from_element": "Labor Market Tightness",
      "to_element": "Wage Pressure"
    }
  ],
