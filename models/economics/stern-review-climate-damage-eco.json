{
  "id": "stern-review-climate-damage-eco",
  "name": "Stern Review Climate Damage",
  "description": "Nicholas Stern's 2006 review modeling economic damages from climate change. Shows damages of 5-20% GDP without action vs 1% GDP cost of mitigation. Reference: IPCC Climate Assessment Reports. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "stock-co2",
      "name": "Atmospheric_CO2",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "stock-temp",
      "name": "Temperature_Anomaly",
      "initial_value": 1.0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "stock-gdp",
      "name": "GDP",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-emissions",
      "name": "Net_Emissions",
      "equation": "emission_rate * (1 - mitigation_effort)",
      "from_stock": null,
      "to_stock": "stock-co2",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "flow-warming",
      "name": "Warming",
      "equation": "(climate_sensitivity * ln(Atmospheric_CO2 / 280) / ln(2) - Temperature_Anomaly) * 0.05",
      "from_stock": null,
      "to_stock": "stock-temp",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-growth",
      "name": "Economic_Growth",
      "equation": "GDP * (base_growth_rate - Damage_Rate)",
      "from_stock": null,
      "to_stock": "stock-gdp",
      "position": {
        "x": 350,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-emission-rate",
      "name": "emission_rate",
      "equation": "3",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-mitigation",
      "name": "mitigation_effort",
      "equation": "0.2",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-sensitivity",
      "name": "climate_sensitivity",
      "equation": "3",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-damage",
      "name": "Damage_Rate",
      "equation": "damage_coefficient * Temperature_Anomaly^2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "var-damage-coef",
      "name": "damage_coefficient",
      "equation": "0.0028",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "var-base-growth",
      "name": "base_growth_rate",
      "equation": "0.02",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-mitigation-cost",
      "name": "Mitigation_Cost",
      "equation": "GDP * 0.01 * mitigation_effort",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-net-benefit",
      "name": "Net_Benefit_Mitigation",
      "equation": "GDP * Damage_Rate - Mitigation_Cost",
      "position": {
        "x": 200,
        "y": 380
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Atmospheric_CO2",
      "to_element": "Warming"
    },
    {
      "id": "conn-2",
      "from_element": "Temperature_Anomaly",
      "to_element": "Damage_Rate"
    },
    {
      "id": "conn-3",
      "from_element": "Damage_Rate",
      "to_element": "Economic_Growth"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "source": "https://webarchive.nationalarchives.gov.uk/ukgwa/20100407172811/https://www.hm-treasury.gov.uk/stern_review_report.htm",
  "reference": "Stern N. The Economics of Climate Change: The Stern Review. Cambridge University Press; 2007."
}