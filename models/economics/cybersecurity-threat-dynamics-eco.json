      "to_element": "Infection"
    },
    {
      "id": "conn-5",
      "from_element": "Infected Systems",
      "to_element": "Remediation"
    },
    {
      "id": "conn-6",
      "from_element": "Remediation Rate",
      "to_element": "Remediation"
    },
    {
      "id": "conn-7",
      "from_element": "Security Effectiveness",
      "to_element": "Remediation"
    },
    {
      "id": "conn-8",
      "from_element": "Vulnerable Systems",
      "to_element": "Proactive Patching"
    },
    {
      "id": "conn-9",
      "from_element": "Patching Rate",
      "to_element": "Proactive Patching"
    },
    {
      "id": "conn-10",
      "from_element": "Security Effectiveness",
      "to_element": "Proactive Patching"
    },
    {
      "id": "conn-11",
      "from_element": "Security Budget",
      "to_element": "Security Effectiveness"
    },
    {
      "id": "conn-12",
