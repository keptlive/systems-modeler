{
  "id": "tobins-q-investment-eco",
  "name": "Tobin's Q Investment Model",
  "description": "Models investment decisions based on market valuation vs replacement cost. Nobel Prize work. DOI: 10.1016/0304-405X(95)00868-F",
  "stocks": [
    {
      "id": "stock-capital",
      "name": "Capital_Stock",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-marketval",
      "name": "Market_Value",
      "initial_value": 120,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "stock-output",
      "name": "Output",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-invest",
      "name": "Investment",
      "equation": "MAX(0, (Tobins_Q - 1) * Investment_Sensitivity) * Capital_Stock",
      "from_stock": null,
      "to_stock": "stock-capital",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-deprec",
      "name": "Depreciation",
      "equation": "Capital_Stock * Depreciation_Rate",
      "from_stock": "stock-capital",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-valchg",
      "name": "Value_Change",
      "equation": "Market_Value * (Expected_Return - Discount_Rate + Dividend_Yield)",
      "from_stock": null,
      "to_stock": "stock-marketval",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "flow-prodflow",
      "name": "Production",
      "equation": "Capital_Stock^Alpha * Labor^(1 - Alpha)",
      "from_stock": null,
      "to_stock": "stock-output",
      "position": {
        "x": 400,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-tobinsq",
      "name": "Tobins_Q",
      "equation": "Market_Value / Replacement_Cost",
      "position": {
        "x": 150,
        "y": 175
      }
    },
    {
      "id": "var-replcost",
      "name": "Replacement_Cost",
      "equation": "Capital_Stock * Capital_Price",
      "position": {
        "x": 250,
        "y": 175
      }
    },
    {
      "id": "var-capprice",
      "name": "Capital_Price",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 175
      }
    },
    {
      "id": "var-investsens",
      "name": "Investment_Sensitivity",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-deprate",
      "name": "Depreciation_Rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-expret",
      "name": "Expected_Return",
      "equation": "0.08 + 0.02 * SIN(TIME / 10)",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "var-discount",
      "name": "Discount_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 325
      }
    },
    {
      "id": "var-divyield",
      "name": "Dividend_Yield",
      "equation": "0.02",
      "position": {
        "x": 350,
        "y": 325
      }
    },
    {
      "id": "var-alpha",
      "name": "Alpha",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "var-labor",
      "name": "Labor",
      "equation": "100",
      "position": {
        "x": 500,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Capital_Stock",
      "to_element": "Replacement_Cost"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T02:49:51.600229+00:00",
  "updated_at": "2026-01-12T02:49:51.600236+00:00",
  "source": "https://doi.org/10.1016/0304-405X(95)00868-F",
  "reference": "Tobin J (1969). A General Equilibrium Approach to Monetary Theory. JMCB. Nobel Prize 1981."
}