{
  "id": "ecosystem-resilience-stability-eco",
  "name": "Ecosystem Resilience and Alternative States",
  "description": "Models ecosystem stability with tipping points to alternative states. Source: Scheffer et al. (2001), Nature. DOI: 10.1038/35098000",
  "stocks": [
    {
      "id": "stock-eco",
      "name": "Ecosystem_State",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-press",
      "name": "Cumulative_Pressure",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-recover",
      "name": "Recovery",
      "equation": "Recovery_Rate * Ecosystem_State * (1 - Ecosystem_State / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-eco",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-degrade",
      "name": "Degradation",
      "equation": "Degradation_Rate * Ecosystem_State * Stress_Factor",
      "from_stock": "stock-eco",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-pressure",
      "name": "Pressure_Accumulation",
      "equation": "External_Stress - Pressure_Relief",
      "from_stock": null,
      "to_stock": "stock-press",
      "position": {
        "x": 300,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-recrate",
      "name": "Recovery_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-degrate",
      "name": "Degradation_Rate",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-carrycap",
      "name": "Carrying_Capacity",
      "equation": "100",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-stress",
      "name": "External_Stress",
      "equation": "0.5 + 0.01 * TIME",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-relief",
      "name": "Pressure_Relief",
      "equation": "Cumulative_Pressure * 0.1",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "var-stressfactor",
      "name": "Stress_Factor",
      "equation": "1 + Cumulative_Pressure / 50",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-tipping",
      "name": "Tipping_Point",
      "equation": "IF(Ecosystem_State < 30, 1, 0)",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "var-resilience",
      "name": "Resilience",
      "equation": "Ecosystem_State / (1 + Cumulative_Pressure / 100)",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Cumulative_Pressure",
      "to_element": "Degradation"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 1
  },
  "created_at": "2026-01-12T02:09:47.460601+00:00",
  "updated_at": "2026-01-12T02:09:47.460605+00:00",
  "source": "https://doi.org/10.1038/35098000",
  "reference": "Scheffer, M. et al. (2001). Catastrophic shifts in ecosystems. Nature."
}