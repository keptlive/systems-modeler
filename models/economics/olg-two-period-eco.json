{
  "id": "olg-two-period-eco",
  "name": "Overlapping Generations Model",
  "description": "Young and old generations coexist, young save for retirement. Shows how demographics affect capital accumulation and interest rates. Foundation for pension analysis. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-capital",
      "name": "Capital Stock",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-young-pop",
      "name": "Young Population",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-old-pop",
      "name": "Old Population",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-saving",
      "name": "Net Saving",
      "equation": "Savings - Dissaving",
      "from_stock": null,
      "to_stock": "stock-capital",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "flow-aging",
      "name": "Aging",
      "equation": "Young_Population",
      "from_stock": "stock-young-pop",
      "to_stock": "stock-old-pop",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-births",
      "name": "Births",
      "equation": "Fertility_Rate * Young_Population",
      "from_stock": null,
      "to_stock": "stock-young-pop",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-deaths",
      "name": "Deaths",
      "equation": "Old_Population",
      "from_stock": "stock-old-pop",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-wage",
      "name": "Wage",
      "equation": "(1 - Alpha) * (Capital_Stock / Young_Population)^Alpha",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-interest",
      "name": "Interest Rate",
      "equation": "Alpha * (Young_Population / Capital_Stock)^(1 - Alpha)",
      "position": {
        "x": 350,
        "y": 80
      }
    },
    {
      "id": "var-savings",
      "name": "Savings",
      "equation": "Young_Population * Wage * Saving_Rate",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-dissaving",
      "name": "Dissaving",
      "equation": "Old_Population * Consumption_Old",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-saving-rate",
      "name": "Saving Rate",
      "equation": "1 / (2 + Interest_Rate)",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-consumption-old",
      "name": "Consumption Old",
      "equation": "Capital_Stock / Old_Population * (1 + Interest_Rate)",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "var-alpha",
      "name": "Alpha",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 420
      }
    },
    {
      "id": "var-fertility",
      "name": "Fertility Rate",
      "equation": "1.1",
      "position": {
        "x": 300,
        "y": 420
      }
    },
    {
      "id": "var-dependency",
      "name": "Dependency Ratio",
      "equation": "Old_Population / Young_Population",
      "position": {
        "x": 500,
        "y": 420
      }
    },
    {
      "id": "var-capital-labor",
      "name": "Capital per Worker",
      "equation": "Capital_Stock / Young_Population",
      "position": {
        "x": 350,
        "y": 490
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Capital Stock",
      "to_element": "Wage"
    },
    {
      "id": "conn-2",
      "from_element": "Young Population",
      "to_element": "Wage"
    },
    {
      "id": "conn-3",
      "from_element": "Wage",
      "to_element": "Savings"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 1
  },
  "created_at": "2026-01-12T07:48:28.113825+00:00",
  "updated_at": "2026-01-12T07:48:28.113829+00:00",
  "source": "https://doi.org/10.2307/1884513",
  "reference": "Diamond PA. National Debt in a Neoclassical Growth Model. American Economic Review. 1965;55(5):1126-1150."
}