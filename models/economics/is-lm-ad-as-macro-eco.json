{
  "id": "is-lm-ad-as-macro-eco",
  "name": "IS-LM-AD-AS Macroeconomic Model",
  "description": "Combined IS-LM and AD-AS framework from Hicks (1937) and later extensions. Shows equilibrium in goods market (IS), money market (LM), aggregate demand (AD), and aggregate supply (AS). Fundamental for understanding monetary and fiscal policy. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "stock-output",
      "name": "Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-price-level",
      "name": "Price Level",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-interest-rate",
      "name": "Interest Rate",
      "initial_value": 0.05,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-output-adjustment",
      "name": "Output Adjustment",
      "equation": "(Aggregate_Demand - Output) * Output_Adjustment_Speed",
      "from_stock": null,
      "to_stock": "stock-output",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-price-adjustment",
      "name": "Price Adjustment",
      "equation": "Price_Level * Inflation_Rate",
      "from_stock": null,
      "to_stock": "stock-price-level",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-interest-adjustment",
      "name": "Interest Adjustment",
      "equation": "(LM_Rate - Interest_Rate) * Interest_Adjustment_Speed",
      "from_stock": null,
      "to_stock": "stock-interest-rate",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-aggregate-demand",
      "name": "Aggregate Demand",
      "equation": "Autonomous_Spending + MPC * Output - Interest_Sensitivity_IS * Interest_Rate",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-lm-rate",
      "name": "LM Rate",
      "equation": "(Money_Demand_Income * Output / Price_Level - Money_Supply) / Money_Demand_Interest",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-inflation-rate",
      "name": "Inflation Rate",
      "equation": "Expected_Inflation + Phillips_Slope * (Output - Potential_Output) / Potential_Output",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-autonomous-spending",
      "name": "Autonomous Spending",
      "equation": "40",
