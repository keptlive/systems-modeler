{
  "id": "supply-chain-resilience-disruption-eco",
  "name": "Supply Chain Resilience and Disruption Model",
  "description": "Model of supply chain resilience during disruptions like COVID-19 pandemic. Shows how inventory buffers, supplier diversification, and demand fluctuations interact to create supply shortages and recovery patterns. Based on pandemic-era supply chain research.",
  "stocks": [
    {
      "id": "s1",
      "name": "Raw_Material_Inventory",
      "initial_value": 1000,
      "equation": "",
      "position": {"x": 150, "y": 200}
    },
    {
      "id": "s2",
      "name": "Finished_Goods_Inventory",
      "initial_value": 500,
      "equation": "",
      "position": {"x": 400, "y": 200}
    },
    {
      "id": "s3",
      "name": "Backlog",
      "initial_value": 50,
      "equation": "",
      "position": {"x": 600, "y": 200}
    },
    {
      "id": "s4",
      "name": "Supplier_Capacity",
      "initial_value": 100,
      "equation": "",
      "position": {"x": 150, "y": 380}
    },
    {
      "id": "s5",
      "name": "Production_Capacity",
      "initial_value": 80,
      "equation": "",
      "position": {"x": 400, "y": 380}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Material_Receipts",
      "equation": "Supplier_Capacity * Disruption_Factor",
      "from_stock": null,
      "to_stock": "Raw_Material_Inventory",
      "position": {"x": 50, "y": 200}
    },
    {
      "id": "f2",
      "name": "Production",
      "equation": "MIN(Production_Capacity * Disruption_Factor, Raw_Material_Inventory / Material_Per_Unit)",
      "from_stock": "Raw_Material_Inventory",
      "to_stock": "Finished_Goods_Inventory",
      "position": {"x": 275, "y": 200}
    },
    {
      "id": "f3",
      "name": "Shipments",
      "equation": "MIN(Finished_Goods_Inventory, Customer_Demand + Backlog / Backlog_Clearance_Time)",
      "from_stock": "Finished_Goods_Inventory",
      "to_stock": null,
      "position": {"x": 500, "y": 150}
    },
    {
      "id": "f4",
      "name": "Order_Receipt",
      "equation": "Customer_Demand",
      "from_stock": null,
      "to_stock": "Backlog",
      "position": {"x": 700, "y": 200}
    },
    {
      "id": "f5",
      "name": "Order_Fulfillment",
      "equation": "Shipments",
      "from_stock": "Backlog",
      "to_stock": null,
      "position": {"x": 600, "y": 280}
    },
    {
      "id": "f6",
      "name": "Capacity_Recovery",
      "equation": "(Normal_Supplier_Capacity - Supplier_Capacity) / Capacity_Recovery_Time",
      "from_stock": null,
      "to_stock": "Supplier_Capacity",
      "position": {"x": 50, "y": 380}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Disruption_Factor",
      "equation": "MAX(0.2, 1 - Disruption_Severity)",
      "position": {"x": 100, "y": 80}
    },
    {
      "id": "v2",
      "name": "Disruption_Severity",
      "equation": "0.5",
      "position": {"x": 225, "y": 80}
    },
    {
      "id": "v3",
      "name": "Material_Per_Unit",
      "equation": "10",
      "position": {"x": 350, "y": 80}
    },
    {
      "id": "v4",
      "name": "Customer_Demand",
      "equation": "60 * Demand_Surge_Factor",
      "position": {"x": 500, "y": 80}
    },
    {
      "id": "v5",
      "name": "Demand_Surge_Factor",
      "equation": "1.3",
      "position": {"x": 650, "y": 80}
    },
    {
      "id": "v6",
      "name": "Backlog_Clearance_Time",
      "equation": "4",
      "position": {"x": 650, "y": 200}
    },
    {
      "id": "v7",
      "name": "Normal_Supplier_Capacity",
      "equation": "100",
      "position": {"x": 100, "y": 480}
    },
    {
      "id": "v8",
      "name": "Capacity_Recovery_Time",
      "equation": "12",
      "position": {"x": 250, "y": 480}
    },
    {
      "id": "v9",
      "name": "Service_Level",
      "equation": "1 - Backlog / MAX(1, Customer_Demand * 10)",
      "position": {"x": 500, "y": 480}
    },
    {
      "id": "v10",
      "name": "Inventory_Days",
      "equation": "Finished_Goods_Inventory / MAX(1, Customer_Demand)",
      "position": {"x": 650, "y": 480}
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 52,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1016/j.jom.2020.104687",
  "reference": "Ivanov D. (2020). Predicting the impacts of epidemic outbreaks on global supply chains: A simulation-based analysis on the coronavirus outbreak (COVID-19/SARS-CoV-2) case. Transportation Research Part E: Logistics and Transportation Review, 136, 101922. DOI: 10.1016/j.tre.2020.101922",
  "created_at": "2026-01-15T20:30:00.000000Z",
  "updated_at": "2026-01-15T20:30:00.000000Z"
}
