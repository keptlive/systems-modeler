{
  "id": "ai-adoption-labor-transformation-eco",
  "name": "AI Adoption and Labor Market Transformation",
  "description": "Model of AI/automation adoption in workforce showing job displacement, creation, and skill transitions. Based on Acemoglu & Restrepo 2020. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Traditional Jobs",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "AI Augmented Jobs",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "New AI Jobs",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "s4",
      "name": "Displaced Workers",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "s5",
      "name": "AI Capability Level",
      "initial_value": 0.3,
      "equation": "",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Job Automation",
      "equation": "Traditional_Jobs * Automation_Rate * AI_Capability_Level",
      "from_stock": "s1",
      "to_stock": "s4",
      "position": {
        "x": 150,
        "y": 225
      }
    },
    {
      "id": "f2",
      "name": "Job Augmentation",
      "equation": "Traditional_Jobs * Augmentation_Rate * (1 - AI_Capability_Level)",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "New Job Creation",
      "equation": "AI_Capability_Level * Job_Creation_Rate * 10",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "f4",
      "name": "Reskilling Success",
      "equation": "Displaced_Workers * Reskilling_Rate * Training_Investment",
      "from_stock": "s4",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 225
      }
    },
    {
      "id": "f5",
      "name": "AI Advancement",
      "equation": "(1 - AI_Capability_Level) * AI_Progress_Rate",
      "from_stock": null,
      "to_stock": "s5",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "f6",
      "name": "Displacement to New Jobs",
      "equation": "Displaced_Workers * Tech_Skill_Rate * AI_Capability_Level",
      "from_stock": "s4",
      "to_stock": "s3",
      "position": {
        "x": 400,
        "y": 225
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Automation Rate",
      "equation": "0.03",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "v2",
      "name": "Augmentation Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Job Creation Rate",
      "equation": "0.5",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Reskilling Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "v5",
      "name": "Training Investment",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v6",
      "name": "Tech Skill Rate",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "AI Progress Rate",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "v8",
      "name": "Total Employment",
      "equation": "Traditional_Jobs + AI_Augmented_Jobs + New_AI_Jobs",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v9",
      "name": "Unemployment Rate",
      "equation": "Displaced_Workers / (Total_Employment + Displaced_Workers + 0.01)",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Productivity Index",
      "equation": "1 + AI_Augmented_Jobs * 0.3 + New_AI_Jobs * 0.5",
      "position": {
        "x": 450,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "AI Capability Level",
      "to_element": "Job Automation"
    },
    {
      "id": "c2",
      "from_element": "Displaced Workers",
      "to_element": "Reskilling Success"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 1
  },
  "created_at": "2026-01-15T14:20:13.055523",
  "updated_at": "2026-01-15T14:20:13.055529",
  "source": "https://doi.org/10.1257/jel.20191203",
  "reference": "Acemoglu D, Restrepo P. Robots and Jobs: Evidence from US Labor Markets. Journal of Political Economy. 2020;128(6):2188-2244."
}