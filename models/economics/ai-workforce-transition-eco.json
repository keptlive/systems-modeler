{
  "id": "ai-workforce-transition-eco",
  "name": "AI Workforce Transition Dynamics Model",
  "description": "System dynamics model of labor market adjustment to AI automation, including job displacement and creation. Source: Acemoglu & Restrepo (2020), JEL. DOI: 10.1257/jel.20191241",
  "stocks": [
    {
      "id": "stock-human",
      "name": "Human_Employment",
      "initial_value": 150,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-ai",
      "name": "AI_Task_Share",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "stock-newjobs",
      "name": "New_Job_Categories",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 400,
        "y": 175
      }
    },
    {
      "id": "stock-skills",
      "name": "Workforce_Skills",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-displace",
      "name": "Job_Displacement",
      "equation": "Human_Employment * Automation_Rate * AI_Capability / 100",
      "from_stock": "stock-human",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "flow-newjobhire",
      "name": "New_Job_Hiring",
      "equation": "New_Job_Categories * Job_Creation_Rate * Workforce_Skills / 100",
      "from_stock": null,
      "to_stock": "stock-human",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-aiexpand",
      "name": "AI_Expansion",
      "equation": "AI_Investment * (100 - AI_Task_Share) / 100",
      "from_stock": null,
      "to_stock": "stock-ai",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "flow-newjobcreate",
      "name": "Job_Creation",
      "equation": "Innovation_Rate * AI_Task_Share / 50",
      "from_stock": null,
      "to_stock": "stock-newjobs",
      "position": {
        "x": 350,
        "y": 175
      }
    },
    {
      "id": "flow-skillinc",
      "name": "Skill_Development",
      "equation": "Training_Investment * (100 - Workforce_Skills) / 100",
      "from_stock": null,
      "to_stock": "stock-skills",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "flow-skilldec",
      "name": "Skill_Obsolescence",
      "equation": "Workforce_Skills * Obsolescence_Rate * AI_Task_Share / 50",
      "from_stock": "stock-skills",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-autorate",
      "name": "Automation_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-aicap",
      "name": "AI_Capability",
      "equation": "30 + 0.5 * TIME",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-jobcreate",
      "name": "Job_Creation_Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-aiinvest",
      "name": "AI_Investment",
      "equation": "2",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-innov",
      "name": "Innovation_Rate",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-train",
      "name": "Training_Investment",
      "equation": "1.5",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-obsol",
      "name": "Obsolescence_Rate",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T12:41:31.049456+00:00",
  "updated_at": "2026-01-12T12:41:31.049456+00:00",
  "source": "https://systemdynamics.org/resources/",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}