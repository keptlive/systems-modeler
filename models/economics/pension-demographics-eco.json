{
  "id": "pension-demographics-eco",
  "name": "Pension System Demographics Model",
  "description": "Model of pension system sustainability under demographic change showing worker-retiree ratio, fund balance, and benefit levels. Based on OECD pension analysis. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Working Population",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Retired Population",
      "initial_value": 25,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Pension Fund Balance",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "New Workers",
      "equation": "Birth_Cohort_Size * Labor_Participation",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Retirement",
      "equation": "Working_Population / Working_Years",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Mortality",
      "equation": "Retired_Population / Retirement_Years",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Contributions",
      "equation": "Working_Population * Average_Wage * Contribution_Rate",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "f5",
      "name": "Benefits Paid",
      "equation": "Retired_Population * Benefit_Level",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Investment Returns",
      "equation": "Pension_Fund_Balance * Investment_Return",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Birth Cohort Size",
      "equation": "2.5",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Labor Participation",
      "equation": "0.7",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "v3",
      "name": "Working Years",
      "equation": "40",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Retirement Years",
      "equation": "20",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Average Wage",
      "equation": "50",
      "position": {
        "x": 600,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Contribution Rate",
      "equation": "0.15",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v7",
      "name": "Benefit Level",
      "equation": "Average_Wage * Replacement_Rate",
      "position": {
        "x": 650,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Replacement Rate",
      "equation": "0.6",
      "position": {
        "x": 700,
        "y": 50
      }
    },
    {
      "id": "v9",
      "name": "Investment Return",
      "equation": "0.04",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v10",
      "name": "Dependency Ratio",
      "equation": "Retired_Population / Working_Population",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "v11",
      "name": "Fund Sustainability Years",
      "equation": "Pension_Fund_Balance / (Benefits_Paid - Contributions - Investment_Returns)",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "v12",
      "name": "System Balance",
      "equation": "Contributions + Investment_Returns - Benefits_Paid",
      "position": {
        "x": 450,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Working Population",
      "to_element": "Retirement"
    },
    {
      "id": "c2",
      "from_element": "Retired Population",
      "to_element": "Benefits Paid"
    },
    {
      "id": "c3",
      "from_element": "Pension Fund Balance",
      "to_element": "Investment Returns"
    }
  ],
  "time_settings": {
    "start": 2024,
    "end": 2074,
    "dt": 1
  },
  "created_at": "2026-01-12T01:53:04.263218+00:00",
  "updated_at": "2026-01-12T01:53:04.263221+00:00",
  "source": "https://www.oecd.org/pensions/oecd-pensions-at-a-glance-19991363.htm",
  "reference": "OECD. Pensions at a Glance 2021: OECD and G20 Indicators. OECD Publishing, Paris. 2021."
}