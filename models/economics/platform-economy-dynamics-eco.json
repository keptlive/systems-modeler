{
  "id": "platform-economy-dynamics-eco",
  "name": "Platform Economy Network Effects Model",
  "description": "Two-sided platform model with network effects between users and service providers. Reference: NSIDC Arctic Sea Ice News. Source: https://nsidc.org/arcticseaicenews/",
  "stocks": [
    {
      "id": "s1",
      "name": "Users",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Providers",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Platform_Value",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "User_Acquisition",
      "equation": "User_Growth_Rate * Users * Provider_Attraction",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "User_Churn",
      "equation": "User_Churn_Rate * Users",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "f3",
      "name": "Provider_Acquisition",
      "equation": "Provider_Growth_Rate * Providers * User_Attraction",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Provider_Churn",
      "equation": "Provider_Churn_Rate * Providers",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "f5",
      "name": "Value_Growth",
      "equation": "Network_Effect_Strength * Users * Providers / 1000",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 150,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "User_Growth_Rate",
      "equation": "0.1",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "User_Churn_Rate",
      "equation": "0.05",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Provider_Growth_Rate",
      "equation": "0.08",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Provider_Churn_Rate",
      "equation": "0.03",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Provider_Attraction",
      "equation": "Providers / (Providers + Provider_Threshold)",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "v6",
      "name": "User_Attraction",
      "equation": "Users / (Users + User_Threshold)",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "v7",
      "name": "Provider_Threshold",
      "equation": "50",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "v8",
      "name": "User_Threshold",
      "equation": "500",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "v9",
      "name": "Network_Effect_Strength",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:23:21.190152+00:00",
  "updated_at": "2026-01-12T11:23:21.190152+00:00",
  "source": "https://doi.org/10.1111/1756-2171.12006",
  "reference": "Rochet JC, Tirole J. Platform competition in two-sided markets. Journal of the European Economic Association. 2003;1(4):990-1029."
}