{
  "id": "harrod-domar-growth-eco",
  "name": "Harrod-Domar Economic Growth Model",
  "description": "Post-Keynesian growth model relating economic growth to savings rate and capital productivity. Foundation for development economics. Reference: Keynes, J. M. (1936). The General Theory of Employment, Interest and Money. London: Macmillan.",
  "stocks": [
    {
      "id": "s1",
      "name": "Capital",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Output",
      "initial_value": 333,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Investment",
      "equation": "Savings_Rate * Output",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Depreciation",
      "equation": "Depreciation_Rate * Capital",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "f3",
      "name": "Output_Change",
      "equation": "(Capital / Capital_Output_Ratio - Output) / Output_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Savings_Rate",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "v2",
      "name": "Capital_Output_Ratio",
      "equation": "3",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v3",
      "name": "Depreciation_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "v4",
      "name": "Output_Adjustment_Time",
      "equation": "1",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v5",
      "name": "Warranted_Growth_Rate",
      "equation": "Savings_Rate / Capital_Output_Ratio",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
