{
  "id": "modigliani-life-cycle-consumption-eco",
  "name": "Modigliani Life Cycle Consumption Model",
  "description": "Nobel Prize model of consumption smoothing over the life cycle with saving for retirement.",
  "stocks": [
    {"id": "s1", "name": "Wealth", "initial_value": 10000, "equation": "", "position": {"x": 200, "y": 150}},
    {"id": "s2", "name": "Age", "initial_value": 25, "equation": "", "position": {"x": 400, "y": 150}}
  ],
  "flows": [
    {"id": "f1", "name": "Saving", "equation": "Income - Consumption", "from_stock": null, "to_stock": "s1", "position": {"x": 100, "y": 150}},
    {"id": "f2", "name": "Interest", "equation": "0.04 * Wealth", "from_stock": null, "to_stock": "s1", "position": {"x": 200, "y": 50}},
    {"id": "f3", "name": "Aging", "equation": "1", "from_stock": null, "to_stock": "s2", "position": {"x": 500, "y": 150}}
  ],
  "variables": [
    {"id": "v1", "name": "Remaining_Life", "equation": "MAX(1, 85 - Age)", "position": {"x": 100, "y": 100}},
    {"id": "v2", "name": "Working_Years", "equation": "MAX(0, 65 - Age)", "position": {"x": 200, "y": 100}},
    {"id": "v3", "name": "Income", "equation": "IF(Age < 65, 50000, 0)", "position": {"x": 300, "y": 100}},
    {"id": "v4", "name": "Human_Wealth", "equation": "Income * Working_Years", "position": {"x": 400, "y": 100}},
    {"id": "v5", "name": "Total_Resources", "equation": "Wealth + Human_Wealth", "position": {"x": 500, "y": 100}},
    {"id": "v6", "name": "Consumption", "equation": "Total_Resources / Remaining_Life", "position": {"x": 300, "y": 200}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 55, "dt": 1},
  "source": "https://doi.org/10.2307/2296058",
  "reference": "Modigliani F, Brumberg R. Utility analysis and the consumption function. Nobel Prize 1985."
}
