{
  "id": "akerlof-market-for-lemons-eco",
  "name": "Akerlof Market for Lemons Model",
  "description": "George Akerlof's (1970) seminal model of adverse selection in used car markets. Information asymmetry between buyers and sellers leads to market collapse as high-quality goods exit. Akerlof received the 2001 Nobel Prize.",
  "stocks": [
    {"id": "stock-high-quality-cars", "name": "High Quality Cars", "initial_value": 500, "equation": "", "position": {"x": 200, "y": 150}},
    {"id": "stock-low-quality-cars", "name": "Low Quality Cars", "initial_value": 500, "equation": "", "position": {"x": 200, "y": 300}},
    {"id": "stock-market-price", "name": "Market Price", "initial_value": 7500, "equation": "", "position": {"x": 450, "y": 225}}
  ],
  "flows": [
    {"id": "flow-hq-entry", "name": "HQ Entry", "equation": "IF Market_Price >= High_Quality_Value - Sellers_Reserve THEN HQ_Entry_Rate ELSE 0", "from_stock": null, "to_stock": "stock-high-quality-cars", "position": {"x": 100, "y": 150}},
    {"id": "flow-hq-exit", "name": "HQ Exit", "equation": "IF Market_Price < High_Quality_Value - Sellers_Reserve THEN High_Quality_Cars * Exit_Rate ELSE 0", "from_stock": "stock-high-quality-cars", "to_stock": null, "position": {"x": 300, "y": 150}},
    {"id": "flow-lq-entry", "name": "LQ Entry", "equation": "IF Market_Price >= Low_Quality_Value THEN LQ_Entry_Rate ELSE 0", "from_stock": null, "to_stock": "stock-low-quality-cars", "position": {"x": 100, "y": 300}},
    {"id": "flow-lq-exit", "name": "LQ Exit", "equation": "IF Market_Price < Low_Quality_Value THEN Low_Quality_Cars * Exit_Rate ELSE 0", "from_stock": "stock-low-quality-cars", "to_stock": null, "position": {"x": 300, "y": 300}},
    {"id": "flow-price-adjustment", "name": "Price Adjustment", "equation": "(Expected_Quality - Market_Price) / Price_Adjustment_Time", "from_stock": null, "to_stock": "stock-market-price", "position": {"x": 350, "y": 225}}
  ],
  "variables": [
    {"id": "var-high-quality-value", "name": "High Quality Value", "equation": "10000", "position": {"x": 400, "y": 100}},
    {"id": "var-low-quality-value", "name": "Low Quality Value", "equation": "5000", "position": {"x": 550, "y": 100}},
    {"id": "var-sellers-reserve", "name": "Sellers Reserve", "equation": "1000", "position": {"x": 400, "y": 380}},
    {"id": "var-total-cars", "name": "Total Cars", "equation": "High_Quality_Cars + Low_Quality_Cars", "position": {"x": 550, "y": 180}},
    {"id": "var-quality-fraction", "name": "Quality Fraction", "equation": "IF Total_Cars > 0 THEN High_Quality_Cars / Total_Cars ELSE 0.5", "position": {"x": 550, "y": 260}},
    {"id": "var-expected-quality", "name": "Expected Quality", "equation": "Quality_Fraction * High_Quality_Value + (1 - Quality_Fraction) * Low_Quality_Value", "position": {"x": 550, "y": 340}},
    {"id": "var-exit-rate", "name": "Exit Rate", "equation": "0.2", "position": {"x": 200, "y": 380}},
    {"id": "var-hq-entry-rate", "name": "HQ Entry Rate", "equation": "50", "position": {"x": 100, "y": 80}},
    {"id": "var-lq-entry-rate", "name": "LQ Entry Rate", "equation": "50", "position": {"x": 100, "y": 380}},
    {"id": "var-price-adjustment-time", "name": "Price Adjustment Time", "equation": "4", "position": {"x": 350, "y": 380}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 50, "dt": 0.25},
  "source": "https://doi.org/10.2307/1879431",
  "reference": "Akerlof GA. The Market for 'Lemons': Quality Uncertainty and the Market Mechanism. Quarterly Journal of Economics. 1970;84(3):488-500."
}
