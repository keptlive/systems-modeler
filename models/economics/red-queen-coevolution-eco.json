{
  "id": "red-queen-coevolution-eco",
  "name": "Red Queen Coevolutionary Dynamics",
  "description": "Models host-parasite or prey-predator coevolution arms race. Source: Van Valen (1973) and Dieckmann et al. (1995). DOI: 10.1038/377441a0",
  "stocks": [
    {
      "id": "stock-host",
      "name": "Host_Adaptation",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-parasite",
      "name": "Parasite_Adaptation",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "stock-hostpop",
      "name": "Host_Population",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-parapop",
      "name": "Parasite_Population",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-hostadapt",
      "name": "Host_Evolution",
      "equation": "Host_Population / 1000 * Host_Evol_Rate * (Max_Adaptation - Host_Adaptation) / Max_Adaptation",
      "from_stock": null,
      "to_stock": "stock-host",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-paraadapt",
      "name": "Parasite_Evolution",
      "equation": "Parasite_Population / 1000 * Para_Evol_Rate * (Host_Adaptation - Parasite_Adaptation + 20) / 100",
      "from_stock": null,
      "to_stock": "stock-parasite",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-hostgrow",
      "name": "Host_Growth",
      "equation": "Host_Population * (Host_Growth_Rate * (Host_Adaptation - Parasite_Adaptation + 50) / 100 - Carrying_Effect)",
      "from_stock": null,
      "to_stock": "stock-hostpop",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "flow-paragrow",
      "name": "Parasite_Growth",
      "equation": "Parasite_Population * (Para_Growth_Rate * Host_Population / 1000 * Match_Effect - Para_Death_Rate)",
      "from_stock": null,
      "to_stock": "stock-parapop",
      "position": {
        "x": 250,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-hostrate",
      "name": "Host_Evol_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-pararate",
      "name": "Para_Evol_Rate",
      "equation": "0.15",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-maxadapt",
      "name": "Max_Adaptation",
      "equation": "100",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-hostgrow",
      "name": "Host_Growth_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-carry",
      "name": "Carrying_Effect",
      "equation": "Host_Population / 10000",
      "position": {
        "x": 200,
        "y": 325
      }
    },
    {
      "id": "var-paragrow",
      "name": "Para_Growth_Rate",
      "equation": "0.2",
      "position": {
        "x": 400,
        "y": 325
      }
    },
    {
      "id": "var-match",
      "name": "Match_Effect",
      "equation": "Parasite_Adaptation / (Host_Adaptation + 1)",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "var-paradeath",
      "name": "Para_Death_Rate",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Host_Adaptation",
      "to_element": "Parasite_Evolution"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:17:16.214217+00:00",
  "updated_at": "2026-01-12T02:17:16.214220+00:00",
  "source": "https://doi.org/10.1038/377441a0",
  "reference": "Dieckmann, U. et al. (1995). Evolutionary cycling in predator-prey interactions. Nature."
}