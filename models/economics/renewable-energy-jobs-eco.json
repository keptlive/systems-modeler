{
  "id": "renewable-energy-jobs-eco",
  "name": "Renewable Energy Jobs Transition Model",
  "description": "Model of workforce transition from fossil fuels to renewable energy showing job creation, retraining, and displacement. Based on ILO World Employment Report. Reference: IEA World Energy Outlook. Source: https://www.iea.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Fossil Fuel Workers",
      "initial_value": 5000000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "In Retraining",
      "initial_value": 200000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Renewable Energy Workers",
      "initial_value": 3000000,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Unemployed Displaced",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Fossil Job Loss",
      "equation": "Fossil_Fuel_Workers * Decline_Rate",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Retraining Entry",
      "equation": "Fossil_Fuel_Workers * Retraining_Rate",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Retraining Complete",
      "equation": "In_Retraining / Retraining_Duration * Success_Rate",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Retraining Dropout",
      "equation": "In_Retraining / Retraining_Duration * (1 - Success_Rate)",
      "from_stock": "s2",
      "to_stock": "s4",
      "position": {
        "x": 350,
        "y": 275
      }
    },
    {
      "id": "f5",
      "name": "Direct Displacement",
      "equation": "Fossil_Fuel_Workers * Direct_Displacement_Rate",
      "from_stock": "s1",
      "to_stock": "s4",
      "position": {
        "x": 250,
        "y": 275
      }
    },
    {
      "id": "f6",
      "name": "New Renewable Jobs",
      "equation": "Renewable_Investment * Jobs_per_Investment",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "f7",
      "name": "Reemployment",
      "equation": "Unemployed_Displaced * Reemployment_Rate",
      "from_stock": "s4",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Decline Rate",
      "equation": "0.03",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Retraining Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Retraining Duration",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Success Rate",
      "equation": "0.7",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Direct Displacement Rate",
      "equation": "0.02",
      "position": {
        "x": 250,
        "y": 325
      }
    },
    {
      "id": "v6",
      "name": "Renewable Investment",
      "equation": "500",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Jobs per Investment",
      "equation": "1000",
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Reemployment Rate",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 400
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Fossil Fuel Workers",
      "to_element": "Retraining Entry"
    },
    {
      "id": "c2",
      "from_element": "In Retraining",
      "to_element": "Retraining Complete"
    },
    {
      "id": "c3",
      "from_element": "Unemployed Displaced",
      "to_element": "Reemployment"
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2050,
    "dt": 0.25
  },
  "created_at": "2026-01-12T01:45:26.877530+00:00",
  "updated_at": "2026-01-12T01:45:26.877540+00:00",
  "source": "https://www.ilo.org/global/research/global-reports/weso/2018/lang--en/index.htm",
  "reference": "ILO. World Employment and Social Outlook 2018: Greening with Jobs. International Labour Organization, 2018."
}