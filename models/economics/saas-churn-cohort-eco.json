{
  "id": "saas-churn-cohort-eco",
  "name": "SaaS Customer Churn Cohort Model",
  "description": "Model of SaaS subscription business with cohort-based churn dynamics. Captures customer acquisition, monthly recurring revenue, and cohort aging effects. Based on SaaS metrics and unit economics frameworks. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "New_Customers",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Established_Customers",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Loyal_Customers",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Monthly_Recurring_Revenue",
      "initial_value": 40000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "s5",
      "name": "Churned_Total",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Acquisition",
      "equation": "Marketing_Spend / Customer_Acquisition_Cost",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "New_Churn",
      "equation": "New_Customers * New_Customer_Churn_Rate",
      "from_stock": "s1",
      "to_stock": "s5",
      "position": {
        "x": 100,
        "y": 280
      }
    },
    {
      "id": "f3",
      "name": "Maturation",
      "equation": "New_Customers / Maturation_Time",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Established_Churn",
      "equation": "Established_Customers * Established_Churn_Rate",
      "from_stock": "s2",
      "to_stock": "s5",
      "position": {
        "x": 300,
        "y": 280
      }
    },
    {
      "id": "f5",
      "name": "Loyalty_Development",
      "equation": "Established_Customers / Loyalty_Time",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Loyal_Churn",
      "equation": "Loyal_Customers * Loyal_Churn_Rate",
      "from_stock": "s3",
      "to_stock": "s5",
      "position": {
        "x": 500,
        "y": 280
      }
    },
    {
      "id": "f7",
      "name": "MRR_Change",
      "equation": "(Total_Customers * ARPU - Monthly_Recurring_Revenue) / Revenue_Lag",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 300,
        "y": 430
      }
    }
  ],
