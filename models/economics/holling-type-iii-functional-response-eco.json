{
  "id": "holling-type-iii-functional-response-eco",
  "name": "Holling Type III Functional Response",
  "description": "C.S. Holling's Type III functional response model (1959) describing predator-prey dynamics with prey switching behavior. Predation rate increases sigmoidally with prey density, providing prey refuge at low densities. Reference: Holling, C. S. (1973). Resilience and stability of ecological systems. Annual Review of Ecology and Systematics, 4, 1-23. DOI: https://doi.org/10.1146/annurev.es.04.110173.000245",
  "source": "https://doi.org/10.4039/Ent91293-5",
  "reference": "Holling CS. The Components of Predation as Revealed by a Study of Small-Mammal Predation of the European Pine Sawfly. Canadian Entomologist. 1959;91(5):293-320.",
  "stocks": [
    {
      "id": "stock-prey",
      "name": "Prey",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-predator",
      "name": "Predator",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-prey-growth",
      "name": "Prey Growth",
      "equation": "r * Prey * (1 - Prey / K)",
      "from_stock": null,
      "to_stock": "stock-prey",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-predation",
      "name": "Predation",
      "equation": "Functional_Response * Predator",
      "from_stock": "stock-prey",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-predator-growth",
      "name": "Predator Growth",
      "equation": "e * Functional_Response * Predator",
      "from_stock": null,
      "to_stock": "stock-predator",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-predator-death",
      "name": "Predator Death",
      "equation": "m * Predator",
      "from_stock": "stock-predator",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-functional",
      "name": "Functional Response",
      "equation": "a * Prey^2 / (b^2 + Prey^2)",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-r",
      "name": "r",
