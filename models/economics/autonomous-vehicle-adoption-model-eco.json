{
  "id": "autonomous-vehicle-adoption-model-eco",
  "name": "Autonomous Vehicle Adoption Model",
  "description": "Model of autonomous vehicle adoption including technology maturity, infrastructure, and consumer acceptance. Source: Bansal & Kockelman (2017), Transportation Research Part C. DOI: 10.1016/j.trc.2016.10.013",
  "stocks": [
    {
      "id": "stock-conventional",
      "name": "Conventional_Vehicles",
      "initial_value": 250000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-l2",
      "name": "Level_2_ADAS",
      "initial_value": 10000000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-l3",
      "name": "Level_3_Conditional",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-l4",
      "name": "Level_4_High",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-l5",
      "name": "Level_5_Full",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "stock-infra",
      "name": "AV_Infrastructure",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-adopt-l2",
      "name": "Adopt_L2",
      "equation": "Conventional_Vehicles * L2_Adoption_Rate * Consumer_Acceptance",
      "from_stock": "stock-conventional",
      "to_stock": "stock-l2",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-upgrade-l3",
      "name": "Upgrade_L3",
      "equation": "Level_2_ADAS * L3_Upgrade_Rate * Tech_Maturity",
      "from_stock": "stock-l2",
      "to_stock": "stock-l3",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-upgrade-l4",
      "name": "Upgrade_L4",
      "equation": "Level_3_Conditional * L4_Upgrade_Rate * Tech_Maturity * Regulatory_Approval",
      "from_stock": "stock-l3",
      "to_stock": "stock-l4",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-upgrade-l5",
      "name": "Upgrade_L5",
      "equation": "Level_4_High * L5_Upgrade_Rate * (AV_Infrastructure / 100)",
      "from_stock": "stock-l4",
      "to_stock": "stock-l5",
      "position": {
        "x": 625,
        "y": 200
      }
    },
    {
      "id": "flow-infra-build",
      "name": "Infrastructure_Build",
      "equation": "(Level_3_Conditional + Level_4_High + Level_5_Full) * Infra_Investment / 1000000",
      "from_stock": null,
      "to_stock": "stock-infra",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "flow-retire",
      "name": "Vehicle_Retirement",
      "equation": "(Conventional_Vehicles + Level_2_ADAS) * Retirement_Rate",
      "from_stock": "stock-conventional",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-l2-rate",
      "name": "L2_Adoption_Rate",
      "equation": "0.05",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "var-l3-rate",
      "name": "L3_Upgrade_Rate",
      "equation": "0.02",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "var-l4-rate",
      "name": "L4_Upgrade_Rate",
      "equation": "0.01",
      "position": {
        "x": 475,
        "y": 100
      }
    },
    {
      "id": "var-l5-rate",
      "name": "L5_Upgrade_Rate",
      "equation": "0.005",
      "position": {
        "x": 625,
        "y": 100
      }
    },
    {
      "id": "var-accept",
      "name": "Consumer_Acceptance",
      "equation": "0.5 + 0.4 * (Level_2_ADAS + Level_3_Conditional) / 50000000",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-tech",
      "name": "Tech_Maturity",
      "equation": "MIN(1, 0.3 + TIME * 0.02)",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-reg",
      "name": "Regulatory_Approval",
      "equation": "MIN(1, 0.2 + TIME * 0.03)",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "var-infra-inv",
      "name": "Infra_Investment",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-retire",
      "name": "Retirement_Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Consumer_Acceptance",
      "to_element": "Adopt_L2"
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2060,
    "dt": 1
  },
  "created_at": "2026-01-11T22:15:10.906296+00:00",
  "updated_at": "2026-01-11T22:15:10.906296+00:00",
  "source": "https://doi.org/10.1016/j.trc.2016.10.013",
  "reference": "Bansal, P. & Kockelman, K.M. (2017). Forecasting Americans' long-term adoption of connected and autonomous vehicle technologies."
}