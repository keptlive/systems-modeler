{
  "id": "beverton-holt-fishery-eco",
  "name": "Beverton-Holt Stock-Recruitment",
  "description": "Classic fishery model with density-dependent recruitment. Maximum sustainable yield occurs at intermediate stock levels. Foundation for fisheries management and quota setting. Reference: FAO State of World Fisheries. Source: https://www.fao.org/fishery/",
  "stocks": [
    {
      "id": "stock-fish",
      "name": "Fish Stock",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-recruitment",
      "name": "Recruitment",
      "equation": "Max_Recruitment * Fish_Stock / (Half_Saturation + Fish_Stock)",
      "from_stock": null,
      "to_stock": "stock-fish",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-natural-mort",
      "name": "Natural Mortality",
      "equation": "Natural_Mortality_Rate * Fish_Stock",
      "from_stock": "stock-fish",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "flow-harvest",
      "name": "Harvest",
      "equation": "Harvest_Rate * Fish_Stock",
      "from_stock": "stock-fish",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-max-rec",
      "name": "Max Recruitment",
      "equation": "500",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-half-sat",
      "name": "Half Saturation",
      "equation": "500",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-nat-mort",
      "name": "Natural Mortality Rate",
      "equation": "0.2",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-harvest",
      "name": "Harvest Rate",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-total-mort",
      "name": "Total Mortality",
      "equation": "Natural_Mortality_Rate + Harvest_Rate",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-yield",
      "name": "Yield",
      "equation": "Harvest_Rate * Fish_Stock",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-msy",
      "name": "MSY Stock",
      "equation": "Half_Saturation * SQRT(Max_Recruitment / (Half_Saturation * Total_Mortality)) - Half_Saturation",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-biomass-msy",
      "name": "Biomass at MSY",
      "equation": "IF(MSY_Stock > 0, MSY_Stock, 0)",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Fish Stock",
      "to_element": "Recruitment"
    },
    {
      "id": "conn-2",
      "from_element": "Fish Stock",
      "to_element": "Natural Mortality"
    },
    {
      "id": "conn-3",
      "from_element": "Fish Stock",
      "to_element": "Harvest"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-12T07:39:15.417901+00:00",
  "updated_at": "2026-01-12T07:39:15.417910+00:00",
  "source": "https://doi.org/10.2307/1440619",
  "reference": "Beverton RJH, Holt SJ. On the Dynamics of Exploited Fish Populations. Fisheries Investigation Series II. 1957;19:1-533."
}