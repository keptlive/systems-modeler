{
  "id": "lake-eutrophication-model-eco",
  "name": "Lake Eutrophication Model",
  "description": "Models the process of lake eutrophication, where nutrient enrichment (especially phosphorus) leads to algal blooms, oxygen depletion, and ecological degradation. Features hysteresis: once eutrophic, lakes are difficult to restore even when nutrient inputs are reduced due to internal phosphorus recycling from sediments. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-phosphorus-in-water",
      "name": "Phosphorus in Water",
      "initial_value": 0.01,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-phosphorus-in-sediment",
      "name": "Phosphorus in Sediment",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-nutrient-loading",
      "name": "Nutrient Loading",
      "equation": "External_Loading",
      "from_stock": null,
      "to_stock": "stock-phosphorus-in-water",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-sedimentation",
      "name": "Sedimentation",
      "equation": "Sedimentation_Rate * Phosphorus_Water",
      "from_stock": "stock-phosphorus-in-water",
      "to_stock": "stock-phosphorus-in-sediment",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-sediment-release",
      "name": "Sediment Release",
      "equation": "Internal_Loading_Function * Phosphorus_Sediment",
      "from_stock": "stock-phosphorus-in-sediment",
      "to_stock": "stock-phosphorus-in-water",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-outflow",
      "name": "Outflow",
      "equation": "Flushing_Rate * Phosphorus_Water",
      "from_stock": "stock-phosphorus-in-water",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-burial",
      "name": "Burial",
      "equation": "Burial_Rate * Phosphorus_Sediment",
      "from_stock": "stock-phosphorus-in-sediment",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-external-loading",
      "name": "External Loading",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-sedimentation-rate",
      "name": "Sedimentation Rate",
      "equation": "0.5",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-internal-loading-function",
      "name": "Internal Loading Function",
      "equation": "Base_Release * (1 + Anoxia_Factor * Anoxia_Index)",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-base-release",
      "name": "Base Release",
      "equation": "0.01",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-anoxia-factor",
      "name": "Anoxia Factor",
      "equation": "10",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-anoxia-index",
      "name": "Anoxia Index",
      "equation": "MIN(1, MAX(0, (Algal_Biomass - Anoxia_Threshold) / Anoxia_Range))",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-algal-biomass",
      "name": "Algal Biomass",
      "equation": "Algal_Growth_Factor * Phosphorus_Water^2 / (Half_Saturation^2 + Phosphorus_Water^2)",
      "position": {
        "x": 250,
        "y": 160
      }
    },
    {
      "id": "var-algal-growth-factor",
      "name": "Algal Growth Factor",
      "equation": "100",
      "position": {
        "x": 400,
        "y": 160
      }
    },
    {
      "id": "var-half-saturation",
      "name": "Half Saturation",
      "equation": "0.03",
      "position": {
        "x": 550,
        "y": 160
      }
    },
    {
      "id": "var-anoxia-threshold",
      "name": "Anoxia Threshold",
      "equation": "40",
      "position": {
        "x": 700,
        "y": 160
      }
    },
    {
      "id": "var-anoxia-range",
      "name": "Anoxia Range",
      "equation": "20",
      "position": {
        "x": 100,
        "y": 240
      }
    },
    {
      "id": "var-flushing-rate",
      "name": "Flushing Rate",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 240
      }
    },
    {
      "id": "var-burial-rate",
      "name": "Burial Rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 240
      }
    },
    {
      "id": "var-trophic-state",
      "name": "Trophic State",
      "equation": "IF Algal_Biomass < 10 THEN 1 ELSE IF Algal_Biomass < 30 THEN 2 ELSE 3",
      "position": {
        "x": 550,
        "y": 240
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "External Loading",
      "to_element": "Nutrient Loading"
    },
    {
      "id": "conn-2",
      "from_element": "Phosphorus in Water",
      "to_element": "Sedimentation"
    },
    {
      "id": "conn-3",
      "from_element": "Phosphorus in Sediment",
      "to_element": "Sediment Release"
    },
    {
      "id": "conn-4",
      "from_element": "Anoxia Index",
      "to_element": "Internal Loading Function"
    },
    {
      "id": "conn-5",
      "from_element": "Phosphorus in Water",
      "to_element": "Algal Biomass"
    },
    {
      "id": "conn-6",
      "from_element": "Algal Biomass",
      "to_element": "Anoxia Index"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.125
  },
  "created_at": "2026-01-11T20:04:50.738367Z",
  "updated_at": "2026-01-11T20:04:50.738367Z",
  "source": "https://github.com/SDXorg/test-models",
  "reference": "SDXorg Test Models Repository"
}