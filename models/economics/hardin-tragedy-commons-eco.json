{
  "id": "hardin-tragedy-commons-eco",
  "name": "Tragedy of the Commons Model",
  "description": "Garrett Hardin's 1968 model showing how rational individual behavior leads to collective resource depletion. Each herder adds cattle for individual gain while sharing degradation costs, leading to overgrazing. Foundational for environmental economics and common pool resource management. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "stock-common-resource",
      "name": "Common Pasture Quality",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "stock-total-cattle",
      "name": "Total Cattle",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-resource-regeneration",
      "name": "Resource Regeneration",
      "equation": "Regeneration_Rate * Common_Pasture_Quality * (1 - Common_Pasture_Quality / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-common-resource",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-resource-depletion",
      "name": "Resource Depletion",
      "equation": "Grazing_Rate * Total_Cattle",
      "from_stock": "stock-common-resource",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "flow-cattle-addition",
      "name": "Cattle Addition",
      "equation": "IF Perceived_Profit > 0 THEN Addition_Rate * Number_of_Herders ELSE 0",
      "from_stock": null,
      "to_stock": "stock-total-cattle",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-cattle-death",
      "name": "Cattle Death",
      "equation": "Total_Cattle * Natural_Death_Rate * (1 + Starvation_Factor)",
      "from_stock": "stock-total-cattle",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-carrying-capacity",
      "name": "Carrying Capacity",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-regeneration-rate",
      "name": "Regeneration Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "var-grazing-rate",
      "name": "Grazing Rate",
      "equation": "0.02",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "var-number-herders",
      "name": "Number of Herders",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-addition-rate",
      "name": "Addition Rate",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-natural-death-rate",
      "name": "Natural Death Rate",
      "equation": "0.05",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "var-starvation-factor",
      "name": "Starvation Factor",
      "equation": "MAX(0, (Total_Cattle - Common_Pasture_Quality) / Common_Pasture_Quality)",
      "position": {
        "x": 600,
        "y": 400
      }
    },
    {
      "id": "var-perceived-profit",
      "name": "Perceived Profit",
      "equation": "Price_Per_Cattle - (Grazing_Rate / Number_of_Herders)",
      "position": {
        "x": 350,
        "y": 450
      }
    },
    {
      "id": "var-price-per-cattle",
      "name": "Price Per Cattle",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Total Cattle",
      "to_element": "Resource Depletion"
    },
    {
      "id": "conn-2",
      "from_element": "Common Pasture Quality",
      "to_element": "Starvation Factor"
    },
    {
      "id": "conn-3",
      "from_element": "Perceived Profit",
      "to_element": "Cattle Addition"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T01:30:00.000Z",
  "updated_at": "2026-01-12T01:30:00.000Z",
  "source": "https://doi.org/10.1126/science.162.3859.1243",
  "reference": "Hardin G. The Tragedy of the Commons. Science. 1968;162(3859):1243-1248."
}