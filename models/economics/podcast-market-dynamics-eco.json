{
  "id": "podcast-market-dynamics-eco",
  "name": "Podcast Market Dynamics",
  "description": "Model of podcast industry growth. Source: Edison Research; IAB Podcast Revenue Study.",
  "stocks": [
    {
      "id": "stock-shows",
      "name": "Active_Shows",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-listen",
      "name": "Monthly_Listeners",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-revenue",
      "name": "Ad_Revenue",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-launch",
      "name": "Show_Launch",
      "equation": "Launch_Rate * Creator_Incentive",
      "from_stock": null,
      "to_stock": "stock-shows",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-podfade",
      "name": "Podfade",
      "equation": "Active_Shows * Podfade_Rate * (1 - Monetization_Success)",
      "from_stock": "stock-shows",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-adopt",
      "name": "Listener_Growth",
      "equation": "Active_Shows * Content_Quality * Discovery_Rate",
      "from_stock": null,
      "to_stock": "stock-listen",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-churn",
      "name": "Listener_Churn",
      "equation": "Monthly_Listeners * Listener_Churn_Rate",
      "from_stock": "stock-listen",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-adrev",
      "name": "Revenue_Growth",
      "equation": "Monthly_Listeners * CPM / 1000",
      "from_stock": null,
      "to_stock": "stock-revenue",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-launch",
      "name": "Launch_Rate",
      "equation": "50",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-incent",
      "name": "Creator_Incentive",
      "equation": "1 + Ad_Revenue / 100",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-fade",
      "name": "Podfade_Rate",
      "equation": "0.3",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-monet",
      "name": "Monetization_Success",
      "equation": "Ad_Revenue / Active_Shows / 10",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "var-quality",
      "name": "Content_Quality",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-discover",
      "name": "Discovery_Rate",
      "equation": "0.01",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "var-lischurn",
      "name": "Listener_Churn_Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-cpm",
      "name": "CPM",
      "equation": "25",
      "position": {
        "x": 450,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 20,
    "dt": 0.25
  },
  "created_at": "2026-01-12T12:55:38.761146+00:00",
  "updated_at": "2026-01-12T12:55:38.761146+00:00",
  "source": "https://doi.org/10.1016/j.techfore.2020.120192",
  "reference": "Edison Research. The Infinite Dial 2023. Edison Research; 2023."
}