{
  "id": "holling-predation-eco",
  "name": "Holling Type II Functional Response Model",
  "description": "C.S. Holling's 1959 functional response model describing how predator attack rate changes with prey density. The Type II response shows saturation due to handling time, creating stabilizing or destabilizing effects in predator-prey dynamics. Reference: Holling, C. S. (1973). Resilience and stability of ecological systems. Annual Review of Ecology and Systematics, 4, 1-23. DOI: https://doi.org/10.1146/annurev.es.04.110173.000245",
  "stocks": [
    {
      "id": "stock-prey",
      "name": "Prey Population",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-predator",
      "name": "Predator Population",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-prey-birth",
      "name": "Prey Birth",
      "equation": "Prey_Growth_Rate * Prey_Population * (1 - Prey_Population / Prey_Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "stock-prey",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-predation",
      "name": "Predation",
      "equation": "Functional_Response * Predator_Population",
      "from_stock": "stock-prey",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-predator-birth",
      "name": "Predator Birth",
      "equation": "Conversion_Efficiency * Predation",
      "from_stock": null,
      "to_stock": "stock-predator",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "flow-predator-death",
      "name": "Predator Death",
      "equation": "Predator_Death_Rate * Predator_Population",
      "from_stock": "stock-predator",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-attack-rate",
      "name": "Attack Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-handling-time",
      "name": "Handling Time",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-functional-response",
      "name": "Functional Response",
      "equation": "(Attack_Rate * Prey_Population) / (1 + Attack_Rate * Handling_Time * Prey_Population)",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-prey-growth-rate",
      "name": "Prey Growth Rate",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-prey-carrying-capacity",
      "name": "Prey Carrying Capacity",
      "equation": "200",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "var-conversion-efficiency",
      "name": "Conversion Efficiency",
      "equation": "0.1",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "var-predator-death-rate",
      "name": "Predator Death Rate",
      "equation": "0.2",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "var-max-consumption-rate",
      "name": "Maximum Consumption Rate",
      "equation": "1 / Handling_Time",
      "position": {
        "x": 500,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Prey Population",
      "to_element": "Functional Response"
    },
    {
      "id": "conn-2",
      "from_element": "Functional Response",
      "to_element": "Predation"
    },
    {
      "id": "conn-3",
      "from_element": "Predator Population",
      "to_element": "Predation"
    },
    {
      "id": "conn-4",
      "from_element": "Predation",
      "to_element": "Predator Birth"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.1
  },
  "created_at": "2026-01-12T01:30:00.000Z",
  "updated_at": "2026-01-12T01:30:00.000Z",
  "source": "https://doi.org/10.4039/Ent91385-7",
  "reference": "Holling CS. The Components of Predation as Revealed by a Study of Small-Mammal Predation of the European Pine Sawfly. The Canadian Entomologist. 1959;91(5):293-320."
}