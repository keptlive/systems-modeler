{
  "id": "gordon-schaefer-fishery-eco",
  "name": "Gordon-Schaefer Fishery Model",
  "description": "Combined Gordon (1954) and Schaefer (1957) model of open-access fishery leading to biological and economic overfishing. Foundation of fishery economics. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "stock-fish",
      "name": "Fish_Population",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-effort",
      "name": "Fishing_Effort",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-growth",
      "name": "Natural_Growth",
      "equation": "intrinsic_growth * Fish_Population * (1 - Fish_Population / carrying_capacity)",
      "from_stock": null,
      "to_stock": "stock-fish",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-harvest",
      "name": "Harvest",
      "equation": "catchability * Fishing_Effort * Fish_Population",
      "from_stock": "stock-fish",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-effort-change",
      "name": "Effort_Change",
      "equation": "effort_response * (Profit / Fishing_Effort)",
      "from_stock": null,
      "to_stock": "stock-effort",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-r",
      "name": "intrinsic_growth",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-k",
      "name": "carrying_capacity",
      "equation": "2000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-q",
      "name": "catchability",
      "equation": "0.001",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-price",
      "name": "fish_price",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-cost",
      "name": "cost_per_effort",
      "equation": "5",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-revenue",
      "name": "Revenue",
      "equation": "fish_price * Harvest",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-cost-total",
      "name": "Total_Cost",
      "equation": "cost_per_effort * Fishing_Effort",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-profit",
      "name": "Profit",
      "equation": "MAX(0, Revenue - Total_Cost)",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "var-response",
      "name": "effort_response",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Fish_Population",
      "to_element": "Natural_Growth"
    },
    {
      "id": "conn-2",
      "from_element": "Fish_Population",
      "to_element": "Harvest"
    },
    {
      "id": "conn-3",
      "from_element": "Fishing_Effort",
      "to_element": "Harvest"
    },
    {
      "id": "conn-4",
      "from_element": "Profit",
      "to_element": "Effort_Change"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1086/257497",
  "reference": "Gordon HS. The Economic Theory of a Common-Property Resource: The Fishery. Journal of Political Economy. 1954;62(2):124-142."
}