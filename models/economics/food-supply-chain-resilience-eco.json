{
  "id": "food-supply-chain-resilience-eco",
  "name": "Food Supply Chain Resilience",
  "description": "Models food system resilience to disruptions including production, distribution, and waste. Based on Tendall et al. (2015) and COVID-19 food system impacts. Reference: CDC COVID-19 Data and Resources. Source: https://www.cdc.gov/coronavirus/",
  "category": "economics",
  "stocks": [
    {
      "id": "stock-production",
      "name": "Food_Production_Mt",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-processing",
      "name": "Processing_Inventory",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-retail",
      "name": "Retail_Inventory",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-waste",
      "name": "Food_Waste_Mt",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "stock-consumed",
      "name": "Food_Consumed_Mt",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-harvest",
      "name": "Harvest",
      "equation": "Production_Capacity * (1 - Disruption_Factor)",
      "from_stock": null,
      "to_stock": "stock-production",
      "position": {
        "x": 25,
        "y": 200
      }
    },
    {
      "id": "flow-to-processing",
      "name": "To_Processing",
      "equation": "Food_Production_Mt / Farm_To_Processor_Time",
      "from_stock": "stock-production",
      "to_stock": "stock-processing",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-to-retail",
      "name": "To_Retail",
      "equation": "Processing_Inventory / Processor_To_Retail_Time",
      "from_stock": "stock-processing",
      "to_stock": "stock-retail",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-consumption",
      "name": "Consumption",
      "equation": "MIN(Retail_Inventory / Retail_Time, Demand)",
      "from_stock": "stock-retail",
      "to_stock": "stock-consumed",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "flow-farm-waste",
      "name": "Farm_Waste",
      "equation": "Food_Production_Mt * Farm_Waste_Rate",
      "from_stock": "stock-production",
      "to_stock": "stock-waste",
      "position": {
        "x": 150,
        "y": 275
      }
    },
    {
      "id": "flow-processing-waste",
      "name": "Processing_Waste",
      "equation": "Processing_Inventory * Processing_Waste_Rate",
      "from_stock": "stock-processing",
      "to_stock": "stock-waste",
      "position": {
        "x": 300,
        "y": 275
      }
    },
    {
      "id": "flow-retail-waste",
      "name": "Retail_Waste",
      "equation": "Retail_Inventory * Retail_Waste_Rate",
      "from_stock": "stock-retail",
      "to_stock": "stock-waste",
      "position": {
        "x": 450,
        "y": 275
      }
    }
  ],
