{
  "id": "gig-platform-matching-eco",
  "name": "Gig Economy Platform Matching Dynamics",
  "description": "Model of two-sided platform matching between gig workers and customers. Captures network effects, matching frictions, and surge pricing dynamics. Based on labor economics literature on platform economies and matching theory. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Active_Workers",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Waiting_Customers",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Completed_Jobs",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Platform_Revenue",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Worker_Entry",
      "equation": "Base_Worker_Entry * Wage_Attractiveness",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Worker_Exit",
      "equation": "Active_Workers * Exit_Rate / Wage_Attractiveness",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 280
      }
    },
    {
      "id": "f3",
      "name": "Customer_Arrivals",
      "equation": "Base_Demand * Price_Sensitivity",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Matches",
      "equation": "Matching_Function",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Revenue_Flow",
      "equation": "Matches * Surge_Price * Commission_Rate",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Base_Demand",
      "equation": "200",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "v2",
      "name": "Base_Worker_Entry",
      "equation": "50",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "v3",
      "name": "Base_Price",
      "equation": "15",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "v4",
      "name": "Commission_Rate",
      "equation": "0.25",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "v5",
      "name": "Market_Tightness",
      "equation": "Waiting_Customers / MAX(Active_Workers, 1)",
      "position": {
        "x": 150,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "Surge_Multiplier",
      "equation": "1 + 0.5 * MAX(0, Market_Tightness - 1)",
      "position": {
        "x": 350,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Surge_Price",
      "equation": "Base_Price * Surge_Multiplier",
      "position": {
        "x": 500,
        "y": 130
      }
    },
    {
      "id": "v8",
      "name": "Matching_Function",
      "equation": "MIN(Active_Workers, Waiting_Customers) * Matching_Efficiency",
      "position": {
        "x": 250,
        "y": 180
      }
    },
    {
      "id": "v9",
      "name": "Matching_Efficiency",
      "equation": "0.8",
      "position": {
        "x": 450,
        "y": 180
      }
    },
    {
      "id": "v10",
      "name": "Exit_Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 180
      }
    },
    {
      "id": "v11",
      "name": "Wage_Attractiveness",
      "equation": "Surge_Price / Base_Price",
      "position": {
        "x": 550,
        "y": 180
      }
    },
    {
      "id": "v12",
      "name": "Price_Sensitivity",
      "equation": "1 / Surge_Multiplier",
      "position": {
        "x": 350,
        "y": 230
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1093/qje/qjz014",
  "reference": "Hall JV, Krueger AB (2018) An Analysis of the Labor Market for Uber's Driver-Partners. ILR Review. Also: Chen MK, Sheldon M (2016) AER.",
