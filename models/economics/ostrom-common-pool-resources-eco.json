{
  "id": "ostrom-common-pool-resources-eco",
  "name": "Ostrom Common Pool Resource Governance Model",
  "description": "Nobel Prize model of sustainable common pool resource management through community governance. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Resource_Stock",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Harvesting_Effort",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Rule_Compliance",
      "initial_value": 0.7,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Resource_Growth",
      "equation": "Growth_Rate * Resource_Stock * (1 - Resource_Stock / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Harvest",
      "equation": "Catchability * Harvesting_Effort * Resource_Stock",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "f3",
      "name": "Effort_Change",
      "equation": "(Target_Effort - Harvesting_Effort) / Effort_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Compliance_Change",
      "equation": "(Target_Compliance - Rule_Compliance) / Compliance_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Growth_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Carrying_Capacity",
      "equation": "2000",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "v3",
      "name": "Catchability",
      "equation": "0.001",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Sustainable_Yield",
      "equation": "Growth_Rate * Resource_Stock * (1 - Resource_Stock / Carrying_Capacity)",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Target_Effort",
      "equation": "IF(Rule_Compliance > 0.5, Sustainable_Yield / (Catchability * Resource_Stock + 0.01), 100)",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Monitoring_Level",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Sanction_Strength",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Target_Compliance",
      "equation": "MIN(1, Monitoring_Level + Sanction_Strength + 0.3 * (Resource_Stock / Carrying_Capacity))",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Effort_Adjustment_Time",
      "equation": "4",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "v10",
      "name": "Compliance_Adjustment_Time",
      "equation": "8",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:26:32.201938+00:00",
  "updated_at": "2026-01-12T11:26:32.201938+00:00",
  "source": "https://doi.org/10.1017/CBO9780511807763",
  "reference": "Ostrom E. Governing the Commons: The Evolution of Institutions for Collective Action. Cambridge University Press; 1990. Nobel Prize 2009."
}