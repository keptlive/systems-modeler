{
  "id": "workforce-model-eco",
  "name": "Workforce Model",
  "description": "A workforce management model with rookies maturing into experts. Features task completion dynamics where experts can supervise rookies, and hiring responds to task backlog pressure. Demonstrates co-flow and experience-based productivity dynamics. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-rookies",
      "name": "Rookies",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-experts",
      "name": "Experts",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-task-backlog",
      "name": "Task Backlog",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-hiring",
      "name": "Hiring",
      "equation": "Effect_of_Pressure_on_Hiring(Pressure_to_Hire)",
      "from_stock": null,
      "to_stock": "stock-rookies",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-maturation",
      "name": "Maturation",
      "equation": "Rookies / Maturation_Time",
      "from_stock": "stock-rookies",
      "to_stock": "stock-experts",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-departure",
      "name": "Departure",
      "equation": "Experts / Average_Tenure",
      "from_stock": "stock-experts",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-task-arrival",
      "name": "Task Arrival",
      "equation": "230",
      "from_stock": null,
      "to_stock": "stock-task-backlog",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-task-completion",
      "name": "Task Completion",
      "equation": "MIN(Expert_Task_Completion + Rookie_Task_Completion, Task_Backlog)",
      "from_stock": "stock-task-backlog",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-maturation-time",
      "name": "Maturation Time",
      "equation": "15",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-average-tenure",
      "name": "Average Tenure",
      "equation": "35",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-expert-workweek",
      "name": "Expert Workweek",
      "equation": "40",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-rookie-workweek",
      "name": "Rookie Workweek",
      "equation": "40",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-expert-time-per-task",
      "name": "Expert Time per Task",
      "equation": "10",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-rookie-time-per-task",
      "name": "Rookie Time per Task",
      "equation": "30",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-hours-of-supervision-required-per-rookie-per-week",
      "name": "Hours of Supervision Required per Rookie Per Week",
      "equation": "20",
      "position": {
        "x": 250,
        "y": 160
      }
    },
    {
      "id": "var-target-backlog",
      "name": "Target Backlog",
      "equation": "500",
      "position": {
        "x": 400,
        "y": 160
      }
    },
    {
      "id": "var-pressure-to-hire",
      "name": "Pressure to Hire",
      "equation": "(Task_Backlog - Target_Backlog) / Target_Backlog",
      "position": {
        "x": 550,
        "y": 160
      }
    },
    {
      "id": "var-expert-hours-worked-per-week",
      "name": "Expert-Hours Worked per Week",
      "equation": "Experts * Expert_Workweek",
      "position": {
        "x": 700,
        "y": 160
      }
    },
    {
      "id": "var-rookie-hours-worked-per-week",
      "name": "Rookie-Hours Worked per Week",
      "equation": "Rookie_Workweek * Rookies",
      "position": {
        "x": 100,
        "y": 240
      }
    },
    {
      "id": "var-expert-hours-spent-on-rookie-supervision-per-week",
      "name": "Expert-Hours Spent on Rookie Supervision per Week",
      "equation": "Hours_of_Supervision_Required_per_Rookie_Per_Week * Rookies",
      "position": {
        "x": 250,
        "y": 240
      }
    },
    {
      "id": "var-expert-hours-on-task-per-week",
      "name": "Expert-Hours on Task per Week",
      "equation": "Expert_Hours_Worked_per_Week - Expert_Hours_Spent_on_Rookie_Supervision_per_Week",
      "position": {
        "x": 400,
        "y": 240
      }
    },
    {
      "id": "var-rookie-hours-on-task-per-week",
      "name": "Rookie-Hours on Task per Week",
      "equation": "Rookie_Hours_Worked_per_Week",
      "position": {
        "x": 550,
        "y": 240
      }
    },
    {
      "id": "var-expert-task-completion",
      "name": "Expert Task Completion",
      "equation": "Expert_Hours_on_Task_per_Week / Expert_Time_per_Task",
      "position": {
        "x": 700,
        "y": 240
      }
    },
    {
      "id": "var-rookie-task-completion",
      "name": "Rookie Task Completion",
      "equation": "Rookie_Hours_on_Task_per_Week / Rookie_Time_per_Task",
      "position": {
        "x": 100,
        "y": 320
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Rookies",
      "to_element": "Maturation"
    },
    {
      "id": "conn-2",
      "from_element": "Maturation Time",
      "to_element": "Maturation"
    },
    {
      "id": "conn-3",
      "from_element": "Experts",
      "to_element": "Departure"
    },
    {
      "id": "conn-4",
      "from_element": "Average Tenure",
      "to_element": "Departure"
    },
    {
      "id": "conn-5",
      "from_element": "Pressure to Hire",
      "to_element": "Hiring"
    },
    {
      "id": "conn-6",
      "from_element": "Task Backlog",
      "to_element": "Pressure to Hire"
    },
    {
      "id": "conn-7",
      "from_element": "Target Backlog",
      "to_element": "Pressure to Hire"
    },
    {
      "id": "conn-8",
      "from_element": "Expert Task Completion",
      "to_element": "Task Completion"
    },
    {
      "id": "conn-9",
      "from_element": "Rookie Task Completion",
      "to_element": "Task Completion"
    },
    {
      "id": "conn-10",
      "from_element": "Task Backlog",
      "to_element": "Task Completion"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 150,
    "dt": 0.03125
  },
