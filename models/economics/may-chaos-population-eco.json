{
  "id": "may-chaos-population-eco",
  "name": "May Logistic Map Chaos Model",
  "description": "Robert May's 1976 demonstration that simple population models can exhibit chaotic dynamics. Shows how the discrete logistic equation transitions from stable equilibrium to periodic cycles to chaos as growth rate increases. Foundational for chaos theory in ecology. Reference: May, R. M. (1976). Simple mathematical models with very complicated dynamics. Nature, 261(5560), 459-467. DOI: https://doi.org/10.1038/261459a0",
  "stocks": [
    {
      "id": "stock-population",
      "name": "Population",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-population-change",
      "name": "Population Change",
      "equation": "r * Population * (1 - Population) - Population",
      "from_stock": null,
      "to_stock": "stock-population",
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-r",
      "name": "r",
      "equation": "3.9",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-next-generation",
      "name": "Next Generation Value",
      "equation": "r * Population * (1 - Population)",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-equilibrium",
      "name": "Theoretical Equilibrium",
      "equation": "(r - 1) / r",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-lyapunov",
      "name": "Lyapunov Exponent Estimate",
      "equation": "LN(ABS(r - 2 * r * Population))",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-regime",
      "name": "Dynamic Regime",
      "equation": "IF r < 1 THEN 0 ELSE IF r < 3 THEN 1 ELSE IF r < 3.449 THEN 2 ELSE IF r < 3.57 THEN 4 ELSE 99",
      "position": {
        "x": 350,
        "y": 450
      }
    }
  ],
  "connectors": [
