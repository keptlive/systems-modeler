{
  "id": "minsky-financial-instability-eco",
  "name": "Minsky Financial Instability",
  "description": "Model based on Minsky's Financial Instability Hypothesis showing how stability breeds instability. Debt accumulation during good times leads to financial fragility. Source: Minsky (1992), The Financial Instability Hypothesis, Levy Economics Institute. Reference: Minsky, H. P. (1992). The financial instability hypothesis. Levy Economics Institute Working Paper No. 74. DOI: https://doi.org/10.1080/05775132.1992.11471543",
  "stocks": [
    {
      "id": "stock-output",
      "name": "Output",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "stock-debt",
      "name": "Firm_Debt",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-profit-expectations",
      "name": "Profit_Expectations",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 275,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-output-change",
      "name": "Output_Change",
      "equation": "Output * Investment_Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-output",
      "position": {
        "x": 75,
        "y": 150
      }
    },
    {
      "id": "flow-borrowing",
      "name": "Net_Borrowing",
      "equation": "Investment - Internal_Funds",
      "from_stock": null,
      "to_stock": "stock-debt",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "flow-expectations-change",
      "name": "Expectations_Change",
      "equation": "(Actual_Profits - Profit_Expectations) / Expectations_Adjustment_Time",
      "from_stock": null,
      "to_stock": "stock-profit-expectations",
      "position": {
        "x": 150,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-investment",
      "name": "Investment",
      "equation": "Profit_Expectations * Investment_Multiplier * (1 - Debt_Service_Burden)",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-internal-funds",
      "name": "Internal_Funds",
      "equation": "Actual_Profits * Retention_Rate",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-actual-profits",
      "name": "Actual_Profits",
      "equation": "Output * Profit_Rate - Interest_Payments",
      "position": {
        "x": 150,
        "y": 220
      }
    },
    {
      "id": "var-interest-payments",
      "name": "Interest_Payments",
      "equation": "Firm_Debt * Interest_Rate",
      "position": {
        "x": 400,
        "y": 220
      }
    },
    {
      "id": "var-interest-rate",
      "name": "Interest_Rate",
      "equation": "0.05",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-profit-rate",
      "name": "Profit_Rate",
      "equation": "0.15",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-debt-service",
      "name": "Debt_Service_Burden",
      "equation": "Interest_Payments / (Output * Profit_Rate + 1)",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-retention-rate",
      "name": "Retention_Rate",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-investment-mult",
      "name": "Investment_Multiplier",
      "equation": "2",
      "position": {
        "x": 350,
        "y": 380
      }
    },
    {
      "id": "var-investment-growth",
      "name": "Investment_Growth_Rate",
      "equation": "(Investment - Depreciation_Output) / Output",
      "position": {
        "x": 75,
        "y": 220
      }
    },
    {
      "id": "var-depreciation-output",
      "name": "Depreciation_Output",
      "equation": "Output * 0.1",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "var-expectations-time",
      "name": "Expectations_Adjustment_Time",
      "equation": "5",
      "position": {
        "x": 150,
        "y": 380
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Output",
      "to_element": "Actual_Profits"
    },
    {
      "id": "conn-2",
      "from_element": "Firm_Debt",
      "to_element": "Interest_Payments"
    },
    {
      "id": "conn-3",
      "from_element": "Profit_Expectations",
      "to_element": "Investment"
    },
    {
      "id": "conn-4",
      "from_element": "Debt_Service_Burden",
      "to_element": "Investment"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-11T20:57:03.373756+00:00",
  "updated_at": "2026-01-11T20:57:03.373756+00:00",
  "source": "https://github.com/SDXorg/test-models",
  "reference": "SDXorg Test Models Repository"
}