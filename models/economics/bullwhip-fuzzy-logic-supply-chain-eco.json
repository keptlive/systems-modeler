{
  "id": "bullwhip-fuzzy-logic-supply-chain-eco",
  "name": "Bullwhip Effect with Fuzzy Logic",
  "description": "System dynamics model with fuzzy logic application to mitigate bullwhip effect in three-echelon supply chain. Uses Vensim-MATLAB hybrid simulation for decision-making under uncertainty. Reference: Based on System Dynamics supply chain models (Sterman, 2000). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-retailer-inv",
      "name": "Retailer Inventory",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-distributor-inv",
      "name": "Distributor Inventory",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-manufacturer-inv",
      "name": "Manufacturer Inventory",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-retailer-backlog",
      "name": "Retailer Backlog",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "stock-distributor-backlog",
      "name": "Distributor Backlog",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-retail-sales",
      "name": "Retail Sales",
      "equation": "MIN(Customer_Demand, Retailer_Inventory)",
      "from_stock": "stock-retailer-inv",
      "to_stock": null,
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-retail-replenish",
      "name": "Retail Replenishment",
      "equation": "MIN(Retailer_Order, Distributor_Inventory)",
      "from_stock": "stock-distributor-inv",
      "to_stock": "stock-retailer-inv",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-dist-replenish",
      "name": "Distributor Replenishment",
      "equation": "MIN(Distributor_Order, Manufacturer_Inventory)",
      "from_stock": "stock-manufacturer-inv",
      "to_stock": "stock-distributor-inv",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-production",
      "name": "Production",
      "equation": "Production_Rate",
      "from_stock": null,
      "to_stock": "stock-manufacturer-inv",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-customer-demand",
      "name": "Customer Demand",
      "equation": "100 + 20 * SIN(Time * 0.5) + RANDOM(-10, 10)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-retailer-order",
      "name": "Retailer Order",
      "equation": "Customer_Demand + Fuzzy_Adjustment_R * (Target_Retail_Inv - Retailer_Inventory)",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-distributor-order",
      "name": "Distributor Order",
      "equation": "Retail_Replenishment + Fuzzy_Adjustment_D * (Target_Dist_Inv - Distributor_Inventory)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-production-rate",
      "name": "Production Rate",
      "equation": "Dist_Replenishment + (Target_Mfg_Inv - Manufacturer_Inventory) / Production_Adj_Time",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-target-retail",
      "name": "Target Retail Inv",
      "equation": "200",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-target-dist",
      "name": "Target Dist Inv",
      "equation": "400",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "var-target-mfg",
      "name": "Target Mfg Inv",
      "equation": "600",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-fuzzy-r",
      "name": "Fuzzy Adjustment R",
      "equation": "0.25",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "var-fuzzy-d",
      "name": "Fuzzy Adjustment D",
      "equation": "0.20",
      "position": {
        "x": 100,
        "y": 450
      }
    },
    {
      "id": "var-prod-adj-time",
      "name": "Production Adj Time",
      "equation": "4",
      "position": {
        "x": 250,
        "y": 450
      }
    },
    {
      "id": "var-bullwhip-ratio",
      "name": "Bullwhip Ratio",
      "equation": "Production_Rate / Customer_Demand",
      "position": {
        "x": 400,
        "y": 450
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 52,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1108/jm2-04-2018-0045",
  "reference": "System dynamics modeling with fuzzy logic application to mitigate the bullwhip effect in supply chains. Journal of Modelling in Management (2019).",
  "created_at": "2026-01-12T08:08:22.081275Z",
  "updated_at": "2026-01-12T08:08:22.081275Z"
}