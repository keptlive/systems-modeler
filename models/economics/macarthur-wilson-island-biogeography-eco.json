{
  "id": "macarthur-wilson-island-biogeography-eco",
  "name": "MacArthur-Wilson Island Biogeography Model",
  "description": "Robert MacArthur and E.O. Wilson's (1963, 1967) foundational theory of island biogeography. Species richness equilibrium determined by balance between immigration (decreasing with species count) and extinction (increasing with species count). Foundation of conservation biology.",
  "stocks": [
    {"id": "stock-species-richness", "name": "Species Richness", "initial_value": 10, "equation": "", "position": {"x": 300, "y": 200}}
  ],
  "flows": [
    {"id": "flow-immigration", "name": "Immigration", "equation": "Immigration_Rate * (Pool_Size - Species_Richness) / Pool_Size", "from_stock": null, "to_stock": "stock-species-richness", "position": {"x": 200, "y": 200}},
    {"id": "flow-extinction", "name": "Extinction", "equation": "Extinction_Rate * Species_Richness / Pool_Size", "from_stock": "stock-species-richness", "to_stock": null, "position": {"x": 400, "y": 200}}
  ],
  "variables": [
    {"id": "var-pool-size", "name": "Pool Size", "equation": "100", "position": {"x": 200, "y": 100}},
    {"id": "var-immigration-rate", "name": "Immigration Rate", "equation": "10 / Distance_Effect", "position": {"x": 350, "y": 100}},
    {"id": "var-extinction-rate", "name": "Extinction Rate", "equation": "5 / Area_Effect", "position": {"x": 500, "y": 100}},
    {"id": "var-distance-effect", "name": "Distance Effect", "equation": "1", "position": {"x": 200, "y": 300}},
    {"id": "var-area-effect", "name": "Area Effect", "equation": "1", "position": {"x": 350, "y": 300}},
    {"id": "var-equilibrium-richness", "name": "Equilibrium Richness", "equation": "Pool_Size * Immigration_Rate / (Immigration_Rate + Extinction_Rate)", "position": {"x": 500, "y": 300}},
    {"id": "var-turnover-rate", "name": "Turnover Rate", "equation": "Immigration + Extinction", "position": {"x": 350, "y": 400}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 100, "dt": 0.5},
  "source": "https://doi.org/10.2307/1934916",
  "reference": "MacArthur RH, Wilson EO. An Equilibrium Theory of Insular Zoogeography. Evolution. 1963;17(4):373-387."
}
