{
  "id": "real-business-cycle-basic-eco",
  "name": "Real Business Cycle Model (Basic)",
  "description": "Models economic fluctuations driven by technology shocks. Nobel Prize work by Kydland & Prescott. DOI: 10.2307/1913386",
  "stocks": [
    {
      "id": "stock-capital",
      "name": "Capital",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-output",
      "name": "Output",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "stock-tech",
      "name": "Technology",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "stock-consumption",
      "name": "Consumption",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-invest",
      "name": "Investment",
      "equation": "Output * Savings_Rate",
      "from_stock": null,
      "to_stock": "stock-capital",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "flow-deprec",
      "name": "Depreciation",
      "equation": "Capital * Delta",
      "from_stock": "stock-capital",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "flow-produce",
      "name": "Production",
      "equation": "Technology * Capital^Alpha * Labor^(1 - Alpha)",
      "from_stock": null,
      "to_stock": "stock-output",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-techshock",
      "name": "Technology_Shock",
      "equation": "Technology * (Rho * (LN(Technology) - LN(Technology_SS)) + Epsilon)",
      "from_stock": null,
      "to_stock": "stock-tech",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "flow-consume",
      "name": "Consume",
      "equation": "Output * (1 - Savings_Rate)",
      "from_stock": null,
      "to_stock": "stock-consumption",
      "position": {
        "x": 350,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-alpha",
      "name": "Alpha",
      "equation": "0.36",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-delta",
      "name": "Delta",
      "equation": "0.025",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-labor",
      "name": "Labor",
      "equation": "100",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-savrate",
      "name": "Savings_Rate",
      "equation": "0.2",
      "position": {
        "x": 150,
        "y": 175
      }
    },
    {
      "id": "var-rho",
      "name": "Rho",
      "equation": "0.95",
      "position": {
        "x": 100,
        "y": 175
      }
    },
    {
      "id": "var-techss",
      "name": "Technology_SS",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 175
      }
    },
    {
      "id": "var-epsilon",
      "name": "Epsilon",
      "equation": "0.01 * SIN(TIME / 5)",
      "position": {
        "x": 150,
        "y": 325
      }
    },
    {
      "id": "var-realwage",
      "name": "Real_Wage",
      "equation": "(1 - Alpha) * Output / Labor",
      "position": {
        "x": 500,
        "y": 175
      }
    },
    {
      "id": "var-realreturn",
      "name": "Real_Return",
      "equation": "Alpha * Output / Capital - Delta",
      "position": {
        "x": 300,
        "y": 175
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Capital",
      "to_element": "Production"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 1
  },
  "created_at": "2026-01-12T02:49:51.600303+00:00",
  "updated_at": "2026-01-12T02:49:51.600310+00:00",
  "source": "https://doi.org/10.2307/1913386",
  "reference": "Kydland FE, Prescott EC (1982). Time to Build and Aggregate Fluctuations. Econometrica. Nobel Prize 2004."
}