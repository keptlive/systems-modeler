{
  "id": "real-business-cycle-basic-eco",
  "name": "Fixed-saving Discrete Growth with AR(1) Technology",
  "description": "Illustrative fixed-saving discrete growth experiment with AR(1) log technology. It is not a solution or replication of the optimizing Kydland-Prescott or Dynare RBC equilibrium. The one-period difference contract is explicit: Euler step exactly 1 is required. Log technology satisfies log(A_next/A_ss)=rho*log(A/A_ss)+epsilon, implemented as the next level minus the current level; rho .95 is persistence rather than a positive continuous growth coefficient. Investment, current consumption, wages and return use current Production instead of accumulated output. The original stock IDs, all flows, connectors and geometry are preserved; the two accumulation stocks are explicitly named Cumulative Output and Cumulative Consumption, while Output and Consumption remain visible as current-rate outputs. Existing alpha .36, delta .025, fixed labor 100, savings .2 and sinusoidal epsilon are retained. No shock calibration or optimal savings/labor policy is claimed.",
  "stocks": [
    {
      "id": "stock-capital",
      "name": "Capital",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "stock-output",
      "name": "Cumulative Output",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "stock-tech",
      "name": "Technology",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "stock-consumption",
      "name": "Cumulative Consumption",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-invest",
      "name": "Investment",
      "equation": "Production * Savings_Rate",
      "from_stock": null,
      "to_stock": "stock-capital",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "flow-deprec",
      "name": "Depreciation",
      "equation": "Capital * Delta",
      "from_stock": "stock-capital",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "flow-produce",
      "name": "Production",
      "equation": "Technology * Capital^Alpha * Labor^(1 - Alpha)",
      "from_stock": null,
      "to_stock": "stock-output",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-techshock",
      "name": "Technology_Shock",
      "equation": "Technology_SS * EXP(Rho * LN(Technology / Technology_SS) + Epsilon) - Technology",
      "from_stock": null,
      "to_stock": "stock-tech",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "flow-consume",
      "name": "Consume",
      "equation": "Production * (1 - Savings_Rate)",
      "from_stock": null,
      "to_stock": "stock-consumption",
      "position": {
        "x": 350,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-alpha",
      "name": "Alpha",
      "equation": "0.36",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-delta",
      "name": "Delta",
      "equation": "0.025",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-labor",
      "name": "Labor",
      "equation": "100",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-savrate",
      "name": "Savings_Rate",
      "equation": "0.2",
      "position": {
        "x": 150,
        "y": 175
      }
    },
    {
      "id": "var-rho",
      "name": "Rho",
      "equation": "0.95",
      "position": {
        "x": 100,
        "y": 175
      }
    },
    {
      "id": "var-techss",
      "name": "Technology_SS",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 175
      }
    },
    {
      "id": "var-epsilon",
      "name": "Epsilon",
      "equation": "0.01 * SIN(TIME / 5)",
      "position": {
        "x": 150,
        "y": 325
      }
    },
    {
      "id": "var-realwage",
      "name": "Real_Wage",
      "equation": "(1 - Alpha) * Production / Labor",
      "position": {
        "x": 500,
        "y": 175
      }
    },
    {
      "id": "var-realreturn",
      "name": "Real_Return",
      "equation": "Alpha * Production / Capital - Delta",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "var-current-output",
      "name": "Output",
      "units": "goods / period",
      "equation": "Production",
      "position": {
        "x": 700,
        "y": 420
      }
    },
    {
      "id": "var-current-consumption",
      "name": "Consumption",
      "units": "goods / period",
      "equation": "Consume",
      "position": {
        "x": 850,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Capital",
      "to_element": "Production"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 1,
    "integration_method": "euler",
    "discrete_period": 1
  },
  "created_at": "2026-01-12T02:49:51.600303+00:00",
  "updated_at": "2026-01-12T02:49:51.600310+00:00",
  "source": "https://git.dynare.org/Dynare/dynare/-/blob/416626c98e83917b58282a9533c76cc77bf06db7/examples/stochastic_simulations/collard_2001_theoretical_moments.mod",
  "reference": "Official Dynare Collard (2001) example, commit 416626c98e83917b58282a9533c76cc77bf06db7, model block: log technology is an AR process, production is a per-period flow, and capital depreciates once per period. The local fixed savings fraction, labor level and sinusoidal innovation are illustrative scenario assumptions."
}
