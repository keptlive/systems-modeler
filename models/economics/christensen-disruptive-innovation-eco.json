{
  "id": "christensen-disruptive-innovation-eco",
  "name": "Christensen Disruptive Innovation Model",
  "description": "Clayton Christensen's disruptive innovation model showing how low-end disruption can overtake incumbents. Disruptors start with inferior products serving non-consumers, then improve until they meet mainstream needs while incumbents overshoot.",
  "stocks": [
    {"id": "stock-incumbent-performance", "name": "Incumbent Performance", "initial_value": 80, "equation": "", "position": {"x": 200, "y": 150}},
    {"id": "stock-disruptor-performance", "name": "Disruptor Performance", "initial_value": 30, "equation": "", "position": {"x": 200, "y": 300}},
    {"id": "stock-incumbent-market-share", "name": "Incumbent Market Share", "initial_value": 95, "equation": "", "position": {"x": 500, "y": 150}},
    {"id": "stock-disruptor-market-share", "name": "Disruptor Market Share", "initial_value": 5, "equation": "", "position": {"x": 500, "y": 300}}
  ],
  "flows": [
    {"id": "flow-incumbent-improvement", "name": "Incumbent Improvement", "equation": "Incumbent_R_D_Rate", "from_stock": null, "to_stock": "stock-incumbent-performance", "position": {"x": 100, "y": 150}},
    {"id": "flow-disruptor-improvement", "name": "Disruptor Improvement", "equation": "Disruptor_R_D_Rate", "from_stock": null, "to_stock": "stock-disruptor-performance", "position": {"x": 100, "y": 300}},
    {"id": "flow-share-shift-to-disruptor", "name": "Share Shift to Disruptor", "equation": "IF Disruption_Zone > 0 THEN Incumbent_Market_Share * Switching_Rate ELSE 0", "from_stock": "stock-incumbent-market-share", "to_stock": "stock-disruptor-market-share", "position": {"x": 350, "y": 225}}
  ],
  "variables": [
    {"id": "var-mainstream-needs", "name": "Mainstream Needs", "equation": "50 + 0.5 * Time", "position": {"x": 350, "y": 80}},
    {"id": "var-high-end-needs", "name": "High End Needs", "equation": "100 + 0.3 * Time", "position": {"x": 550, "y": 80}},
    {"id": "var-incumbent-r-d-rate", "name": "Incumbent R D Rate", "equation": "3", "position": {"x": 150, "y": 80}},
    {"id": "var-disruptor-r-d-rate", "name": "Disruptor R D Rate", "equation": "5", "position": {"x": 150, "y": 380}},
    {"id": "var-incumbent-overshoot", "name": "Incumbent Overshoot", "equation": "MAX(0, Incumbent_Performance - Mainstream_Needs)", "position": {"x": 350, "y": 150}},
    {"id": "var-disruptor-good-enough", "name": "Disruptor Good Enough", "equation": "IF Disruptor_Performance >= Mainstream_Needs THEN 1 ELSE 0", "position": {"x": 350, "y": 300}},
    {"id": "var-disruption-zone", "name": "Disruption Zone", "equation": "Disruptor_Good_Enough * Incumbent_Overshoot", "position": {"x": 600, "y": 225}},
    {"id": "var-price-advantage", "name": "Price Advantage", "equation": "MAX(0, Incumbent_Price - Disruptor_Price)", "position": {"x": 200, "y": 450}},
    {"id": "var-incumbent-price", "name": "Incumbent Price", "equation": "100", "position": {"x": 350, "y": 380}},
    {"id": "var-disruptor-price", "name": "Disruptor Price", "equation": "40", "position": {"x": 550, "y": 380}},
    {"id": "var-switching-rate", "name": "Switching Rate", "equation": "0.05 * (1 + Price_Advantage / 100)", "position": {"x": 400, "y": 450}},
    {"id": "var-years-to-disruption", "name": "Years to Disruption", "equation": "IF Disruptor_Good_Enough = 0 THEN (Mainstream_Needs - Disruptor_Performance) / Disruptor_R_D_Rate ELSE 0", "position": {"x": 600, "y": 450}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 30, "dt": 0.25},
  "source": "https://doi.org/10.1002/smj.4250160916",
  "reference": "Christensen CM. The Innovator's Dilemma: When New Technologies Cause Great Firms to Fail. Harvard Business School Press. 1997."
}
