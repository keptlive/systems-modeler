{
  "id": "ai-job-automation-impact-eco",
  "name": "AI Job Automation and Labor Market Impact",
  "description": "Model of AI-driven automation effects on the labor market, showing job displacement, new job creation, and skills transition dynamics. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1257/pandp.20201063",
  "reference": "Acemoglu D, Restrepo P. Robots and Jobs: Evidence from US Labor Markets. Journal of Political Economy. 2020;128(6):2188-2244.",
  "stocks": [
    {
      "id": "stock-employed",
      "name": "Employed_Workers",
      "initial_value": 150000000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "stock-displaced",
      "name": "Displaced_Workers",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "stock-ai-capable",
      "name": "AI_Capable_Jobs",
      "initial_value": 10000000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "stock-skills",
      "name": "Workforce_Skills",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 100,
        "y": 225
      }
    }
  ],
  "flows": [
    {
      "id": "flow-automate",
      "name": "Automation_Displacement",
      "equation": "Employed_Workers * automation_rate * AI_Progress",
      "from_stock": "stock-employed",
      "to_stock": "stock-displaced",
      "position": {
        "x": 300,
        "y": 225
      }
    },
    {
      "id": "flow-retrain",
      "name": "Retraining",
      "equation": "Displaced_Workers * retraining_rate * Workforce_Skills / 100",
      "from_stock": "stock-displaced",
      "to_stock": "stock-employed",
      "position": {
        "x": 200,
        "y": 225
      }
    },
    {
      "id": "flow-new-jobs",
      "name": "New_AI_Jobs",
      "equation": "new_job_creation_rate * AI_Progress * economic_growth",
      "from_stock": null,
      "to_stock": "stock-ai-capable",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "flow-fill-ai",
      "name": "Fill_AI_Jobs",
      "equation": "min(AI_Capable_Jobs, Displaced_Workers * ai_job_match_rate * Workforce_Skills / 100)",
      "from_stock": "stock-displaced",
      "to_stock": "stock-employed",
      "position": {
        "x": 400,
        "y": 225
      }
    },
    {
      "id": "flow-skill-up",
      "name": "Skill_Improvement",
      "equation": "skill_investment * (100 - Workforce_Skills) / 100",
      "from_stock": null,
      "to_stock": "stock-skills",
      "position": {
        "x": 50,
        "y": 225
      }
    }
  ],
  "variables": [
    {
      "id": "var-auto",
      "name": "automation_rate",
      "equation": "0.0001",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-ai-prog",
      "name": "AI_Progress",
      "equation": "1 + 0.1 * TIME / 10",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-retrain",
      "name": "retraining_rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-new-job",
      "name": "new_job_creation_rate",
      "equation": "500000",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "var-econ",
      "name": "economic_growth",
      "equation": "1.02",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "var-match",
      "name": "ai_job_match_rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-skill",
      "name": "skill_investment",
      "equation": "2",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "var-unemp",
      "name": "Unemployment_Rate",
      "equation": "Displaced_Workers / (Employed_Workers + Displaced_Workers)",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-wage-pressure",
      "name": "Wage_Pressure",
      "equation": "1 - Unemployment_Rate * 2",
      "position": {
        "x": 450,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T12:00:00.000000+00:00",
  "updated_at": "2026-01-12T12:00:00.000000+00:00"
}