{
  "id": "brand-loyalty-dynamics-eco",
  "name": "Brand Loyalty Dynamics",
  "description": "Model of consumer brand loyalty. Source: Keller (1993), Journal of Marketing.",
  "stocks": [
    {
      "id": "stock-aware",
      "name": "Brand_Awareness",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-trial",
      "name": "Trial_Users",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-loyal",
      "name": "Loyal_Customers",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-aware",
      "name": "Awareness_Building",
      "equation": "Marketing_Spend * Awareness_Efficiency * (100 - Brand_Awareness) / 100",
      "from_stock": null,
      "to_stock": "stock-aware",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-trial",
      "name": "Trial_Conversion",
      "equation": "Brand_Awareness * Trial_Rate",
      "from_stock": null,
      "to_stock": "stock-trial",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-loyal",
      "name": "Loyalty_Building",
      "equation": "Trial_Users * Satisfaction_Rate * Loyalty_Rate",
      "from_stock": "stock-trial",
      "to_stock": "stock-loyal",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-churn",
      "name": "Churn",
      "equation": "Loyal_Customers * Churn_Rate * (1 - Brand_Equity / 100)",
      "from_stock": "stock-loyal",
      "to_stock": "stock-trial",
      "position": {
        "x": 325,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-mktg",
      "name": "Marketing_Spend",
      "equation": "10",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-effic",
      "name": "Awareness_Efficiency",
      "equation": "0.5",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-trial",
      "name": "Trial_Rate",
      "equation": "0.1",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "var-satisfy",
      "name": "Satisfaction_Rate",
      "equation": "0.7",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "var-loyrate",
      "name": "Loyalty_Rate",
      "equation": "0.3",
      "position": {
        "x": 375,
        "y": 100
      }
    },
    {
      "id": "var-churn",
      "name": "Churn_Rate",
      "equation": "0.1",
      "position": {
        "x": 325,
        "y": 300
      }
    },
    {
      "id": "var-equity",
      "name": "Brand_Equity",
      "equation": "Loyal_Customers * 2",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T12:55:38.760895+00:00",
  "updated_at": "2026-01-12T12:55:38.760895+00:00",
  "source": "https://systemdynamics.org/resources/",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}