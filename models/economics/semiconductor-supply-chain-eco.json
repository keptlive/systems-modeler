{
  "id": "semiconductor-supply-chain-eco",
  "name": "Semiconductor Supply Chain Model",
  "description": "Model of semiconductor industry supply chain dynamics showing fab capacity, lead times, and demand cycles. Based on semiconductor shortage analyses (2020-2022) and industry dynamics research. Reference: Based on System Dynamics supply chain models (Sterman, 2000). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-fab-capacity",
      "name": "Fab Production Capacity",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-wip",
      "name": "Work in Process",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-finished-inventory",
      "name": "Finished Goods Inventory",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "stock-capacity-under-construction",
      "name": "Capacity Under Construction",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-wafer-starts",
      "name": "Wafer Starts",
      "equation": "MIN(Fab_Production_Capacity * Utilization_Rate, Order_Backlog / Target_Lead_Time)",
      "from_stock": null,
      "to_stock": "stock-wip",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-wafer-completion",
      "name": "Wafer Completion",
      "equation": "Work_in_Process / Production_Cycle_Time",
      "from_stock": "stock-wip",
      "to_stock": "stock-finished-inventory",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "flow-shipments",
      "name": "Shipments",
      "equation": "MIN(Finished_Goods_Inventory, Customer_Demand)",
      "from_stock": "stock-finished-inventory",
      "to_stock": null,
      "position": {
        "x": 700,
        "y": 150
      }
    },
    {
      "id": "flow-capacity-investment",
      "name": "Capacity Investment",
      "equation": "IF Capacity_Gap > 0 THEN Capacity_Gap / Investment_Response_Time ELSE 0",
      "from_stock": null,
      "to_stock": "stock-capacity-under-construction",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "flow-capacity-completion",
      "name": "Capacity Completion",
      "equation": "Capacity_Under_Construction / Fab_Construction_Time",
      "from_stock": "stock-capacity-under-construction",
      "to_stock": "stock-fab-capacity",
      "position": {
        "x": 200,
        "y": 225
      }
    }
  ],
  "variables": [
    {
      "id": "var-customer-demand",
      "name": "Customer Demand",
      "equation": "80 + 20 * SIN(2 * 3.14159 * Time / 4) + Demand_Shock",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-demand-shock",
      "name": "Demand Shock",
      "equation": "IF Time > 10 AND Time < 15 THEN 50 ELSE 0",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-order-backlog",
      "name": "Order Backlog",
      "equation": "Customer_Demand * Order_Backlog_Factor",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-order-backlog-factor",
      "name": "Order Backlog Factor",
      "equation": "2",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-target-lead-time",
      "name": "Target Lead Time",
      "equation": "0.5",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-production-cycle-time",
      "name": "Production Cycle Time",
      "equation": "3",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-utilization-rate",
      "name": "Utilization Rate",
      "equation": "MIN(1, Order_Backlog / (Fab_Production_Capacity * Production_Cycle_Time))",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-capacity-gap",
      "name": "Capacity Gap",
      "equation": "Customer_Demand - Fab_Production_Capacity",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-fab-construction-time",
      "name": "Fab Construction Time",
      "equation": "3",
      "position": {
        "x": 700,
        "y": 350
      }
    },
    {
      "id": "var-investment-response-time",
      "name": "Investment Response Time",
      "equation": "1",
      "position": {
        "x": 100,
        "y": 420
      }
    },
    {
      "id": "var-fill-rate",
      "name": "Fill Rate",
      "equation": "Shipments / (Customer_Demand + 0.001)",
      "position": {
        "x": 300,
        "y": 420
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.25
  },
  "created_at": "2026-01-11T21:16:29.727679+00:00",
  "updated_at": "2026-01-11T21:16:29.727679+00:00",
  "source": "https://github.com/SDXorg/test-models",
  "reference": "SDXorg Test Models Repository"
}