{
  "id": "kahneman-prospect-theory-eco",
  "name": "Kahneman-Tversky Prospect Theory Model",
  "description": "Nobel Prize model of decision-making under uncertainty showing loss aversion, reference dependence, and probability weighting. Reference: Kahneman, D. & Tversky, A. (1979). Prospect Theory.",
  "stocks": [
    {
      "id": "s1",
      "name": "Reference_Point",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Wealth",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Cumulative_Value",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Gain_Flow",
      "equation": "IF Outcome > Reference_Point THEN Value_Function_Gain ELSE 0",
      "from_stock": null,
      "to_stock": "Wealth",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Loss_Flow",
      "equation": "IF Outcome < Reference_Point THEN Value_Function_Loss ELSE 0",
      "from_stock": "Wealth",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Value_Accumulation",
      "equation": "Prospect_Value",
      "from_stock": null,
      "to_stock": "Cumulative_Value",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Reference_Adjustment",
      "equation": "(Wealth - Reference_Point) * Adaptation_Rate",
      "from_stock": null,
      "to_stock": "Reference_Point",
      "position": {
        "x": 550,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Outcome",
      "equation": "100 + 20 * SIN(time / 5)",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Deviation",
      "equation": "Outcome - Reference_Point",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Alpha",
      "equation": "0.88",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Lambda",
      "equation": "2.25",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Value_Function_Gain",
      "equation": "IF Deviation > 0 THEN Deviation^Alpha ELSE 0",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Value_Function_Loss",
      "equation": "IF Deviation < 0 THEN Lambda * (ABS(Deviation))^Alpha ELSE 0",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Prospect_Value",
      "equation": "Value_Function_Gain - Value_Function_Loss",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Adaptation_Rate",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "source": "https://doi.org/10.2307/1914185",
  "reference": "Kahneman, D. & Tversky, A. (1979). Prospect Theory: An Analysis of Decision under Risk. Econometrica, 47(2), 263-291.",
