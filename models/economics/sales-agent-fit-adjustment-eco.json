{
  "id": "sales-agent-fit-adjustment-eco",
  "name": "Sales Agent Fit Adjustment",
  "description": "Models sales agent performance adjustment to market fit, exploring how sales agents adapt their approach based on market feedback and success rates. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-market-fit",
      "name": "Market Fit",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-cumulative-sales",
      "name": "Cumulative Sales",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-fit-improvement",
      "name": "Fit Improvement",
      "equation": "(Target_Fit - Market_Fit) / Adjustment_Time",
      "from_stock": null,
      "to_stock": "stock-market-fit",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-sales-rate",
      "name": "Sales Rate",
      "equation": "Potential_Sales * Market_Fit",
      "from_stock": null,
      "to_stock": "stock-cumulative-sales",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-target-fit",
      "name": "Target Fit",
      "equation": "0.95",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-adjustment-time",
      "name": "Adjustment Time",
      "equation": "6",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-potential-sales",
      "name": "Potential Sales",
      "equation": "100",
      "position": {
        "x": 400,
        "y": 80
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.125
  },
