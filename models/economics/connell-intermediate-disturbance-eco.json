{
  "id": "connell-intermediate-disturbance-eco",
  "name": "Connell Intermediate Disturbance Model",
  "description": "Intermediate Disturbance Hypothesis showing maximum diversity at intermediate disturbance frequencies. Reference: Connell, J.H. (1978). Diversity in Tropical Rain Forests and Coral Reefs.",
  "stocks": [
    {
      "id": "s1",
      "name": "Early_Successional",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Mid_Successional",
      "initial_value": 40,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Late_Successional",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Disturbed_Patches",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 750,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Early_Colonization",
      "equation": "Disturbed_Patches * Colonization_Rate_Early",
      "from_stock": "Disturbed_Patches",
      "to_stock": "Early_Successional",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Early_To_Mid",
      "equation": "Early_Successional * Succession_Rate_1",
      "from_stock": "Early_Successional",
      "to_stock": "Mid_Successional",
      "position": {
        "x": 220,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Mid_To_Late",
      "equation": "Mid_Successional * Succession_Rate_2",
      "from_stock": "Mid_Successional",
      "to_stock": "Late_Successional",
      "position": {
        "x": 340,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Disturbance_Early",
      "equation": "Early_Successional * Disturbance_Rate * 0.5",
      "from_stock": "Early_Successional",
      "to_stock": "Disturbed_Patches",
      "position": {
        "x": 460,
        "y": 300
      }
    },
    {
      "id": "f5",
      "name": "Disturbance_Mid",
      "equation": "Mid_Successional * Disturbance_Rate * 0.3",
      "from_stock": "Mid_Successional",
      "to_stock": "Disturbed_Patches",
      "position": {
        "x": 580,
        "y": 300
      }
    },
    {
      "id": "f6",
      "name": "Disturbance_Late",
      "equation": "Late_Successional * Disturbance_Rate * 0.2",
      "from_stock": "Late_Successional",
      "to_stock": "Disturbed_Patches",
      "position": {
        "x": 700,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Disturbance_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Colonization_Rate_Early",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Succession_Rate_1",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Succession_Rate_2",
      "equation": "0.05",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Species_Early",
      "equation": "5",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Species_Mid",
      "equation": "15",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Species_Late",
      "equation": "8",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Total_Cover",
      "equation": "Early_Successional + Mid_Successional + Late_Successional",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Weighted_Diversity",
      "equation": "(Early_Successional * Species_Early + Mid_Successional * Species_Mid + Late_Successional * Species_Late) / MAX(1, Total_Cover)",
      "position": {
        "x": 100,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1126/science.199.4335.1302",
  "reference": "Connell, J.H. (1978). Diversity in Tropical Rain Forests and Coral Reefs. Science, 199(4335), 1302-1310.",
