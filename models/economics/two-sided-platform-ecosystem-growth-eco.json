{
  "id": "two-sided-platform-ecosystem-growth-eco",
  "name": "Two-Sided Platform Ecosystem Growth Model",
  "description": "Model of platform growth dynamics with network effects between users and providers. Based on Rochet & Tirole 2003 platform economics. Reference: Tirole, J. (1988). The Theory of Industrial Organization. MIT Press. DOI: https://doi.org/10.2307/2555496",
  "stocks": [
    {
      "id": "s1",
      "name": "Platform Users",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Service Providers",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Platform Revenue",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "s4",
      "name": "Platform Trust",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 450,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "User Acquisition",
      "equation": "Potential_Users * User_Conversion_Rate * Provider_Density_Effect * Trust_Effect",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "User Churn",
      "equation": "Platform_Users * User_Churn_Rate / Quality_Effect",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "f3",
      "name": "Provider Onboarding",
      "equation": "Potential_Providers * Provider_Conversion_Rate * User_Density_Effect",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Provider Exit",
      "equation": "Service_Providers * Provider_Churn_Rate / Revenue_Per_Provider_Effect",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "f5",
      "name": "Revenue Generation",
      "equation": "(Platform_Users * User_Fee + Service_Providers * Provider_Fee) * Transaction_Rate",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "f6",
      "name": "Trust Building",
      "equation": "(1 - Platform_Trust) * Trust_Growth_Rate * Quality_Effect",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "f7",
      "name": "Trust Decay",
      "equation": "Platform_Trust * Trust_Decay_Rate * Incident_Rate",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Potential Users",
      "equation": "1000000",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Potential Providers",
      "equation": "10000",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "User Conversion Rate",
      "equation": "0.001",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "v4",
      "name": "Provider Conversion Rate",
      "equation": "0.01",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "v5",
      "name": "User Churn Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Provider Churn Rate",
      "equation": "0.03",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v7",
      "name": "Provider Density Effect",
      "equation": "Service_Providers / (Service_Providers + 50)",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "User Density Effect",
      "equation": "Platform_Users / (Platform_Users + 5000)",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "v9",
      "name": "Quality Effect",
      "equation": "1 + Platform_Trust",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v10",
      "name": "Trust Effect",
      "equation": "0.5 + Platform_Trust",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "v11",
      "name": "User Fee",
      "equation": "0.1",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v12",
      "name": "Provider Fee",
      "equation": "10",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "v13",
      "name": "Transaction Rate",
      "equation": "Platform_Users * Service_Providers / 100000",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "v14",
      "name": "Revenue Per Provider Effect",
      "equation": "Platform_Revenue / (Service_Providers + 1) / 100",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "v15",
      "name": "Trust Growth Rate",
      "equation": "0.01",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v16",
      "name": "Trust Decay Rate",
      "equation": "0.001",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "v17",
      "name": "Incident Rate",
      "equation": "1",
      "position": {
        "x": 550,
        "y": 300
      }
    }
  ],
