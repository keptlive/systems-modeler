{
  "id": "tragedy-of-commons-resource-depletion-eco",
  "name": "Tragedy of the Commons Resource Depletion Model",
  "description": "Classic model of common pool resource overexploitation. Based on Hardin 1968 and Ostrom's Nobel Prize work. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Common Resource",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Number of Users",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Cumulative Extraction",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Resource Regeneration",
      "equation": "Common_Resource * Regeneration_Rate * (1 - Common_Resource / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Extraction",
      "equation": "Number_of_Users * Extraction_per_User * Resource_Availability",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 250,
        "y": 225
      }
    },
    {
      "id": "f3",
      "name": "User Entry",
      "equation": "(Profit_per_User - Entry_Cost) * Entry_Rate * (Max_Users - Number_of_Users) / Max_Users",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "f4",
      "name": "User Exit",
      "equation": "Number_of_Users * Exit_Rate / (Profit_per_User + 0.1)",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Regeneration Rate",
      "equation": "0.1",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Carrying Capacity",
      "equation": "1500",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "v3",
      "name": "Extraction per User",
      "equation": "10",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "v4",
      "name": "Resource Availability",
      "equation": "Common_Resource / Carrying_Capacity",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "v5",
      "name": "Resource Price",
      "equation": "1 / (Resource_Availability + 0.1)",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Profit per User",
      "equation": "Resource_Price * Extraction_per_User * Resource_Availability - Extraction_Cost",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "v7",
      "name": "Extraction Cost",
      "equation": "5",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "v8",
      "name": "Entry Cost",
      "equation": "2",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Entry Rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "v10",
      "name": "Exit Rate",
      "equation": "0.05",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "v11",
      "name": "Max Users",
      "equation": "50",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v12",
      "name": "Sustainable Yield",
      "equation": "Regeneration_Rate * Carrying_Capacity / 4",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "v13",
      "name": "Overexploitation Index",
      "equation": "Extraction / (Sustainable_Yield + 0.1)",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Common Resource",
      "to_element": "Resource Regeneration"
    },
    {
      "id": "c2",
      "from_element": "Number of Users",
      "to_element": "Extraction"
    },
    {
      "id": "c3",
      "from_element": "Profit per User",
      "to_element": "User Entry"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-15T14:24:00.398613",
  "updated_at": "2026-01-15T14:24:00.398621",
  "source": "https://doi.org/10.1126/science.162.3859.1243",
  "reference": "Hardin G. The Tragedy of the Commons. Science. 1968;162(3859):1243-1248. See also Ostrom E (2009) Nobel Prize."
}