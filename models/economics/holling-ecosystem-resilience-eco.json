{
  "id": "holling-ecosystem-resilience-eco",
  "name": "Holling Ecosystem Resilience Model",
  "description": "Model of ecosystem resilience and alternate stable states, showing how perturbations can cause regime shifts. Reference: Holling, C. S. (1973). Resilience and stability of ecological systems. Annual Review of Ecology and Systematics, 4, 1-23. DOI: https://doi.org/10.1146/annurev.es.04.110173.000245",
  "stocks": [
    {
      "id": "s1",
      "name": "Vegetation",
      "initial_value": 0.8,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Growth",
      "equation": "Growth_Rate * Vegetation * (1 - Vegetation / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Grazing",
      "equation": "Max_Grazing * Vegetation ^ 2 / (Half_Saturation ^ 2 + Vegetation ^ 2)",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Growth_Rate",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Carrying_Capacity",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Max_Grazing",
      "equation": "0.3",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Half_Saturation",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Net_Growth",
      "equation": "Growth - Grazing",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.1,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:20:56.316163+00:00",
  "updated_at": "2026-01-12T11:20:56.316163+00:00",
  "source": "https://doi.org/10.1146/annurev.es.04.110173.000245",
  "reference": "Holling CS. Resilience and stability of ecological systems. Annual Review of Ecology and Systematics. 1973;4:1-23."
}