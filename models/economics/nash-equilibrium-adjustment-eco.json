        "x": 590,
        "y": 300
      }
    },
    {
      "id": "var-best-1",
      "name": "Best Response 1",
      "equation": "IF((a - c) * Player_2_Strategy + (b - d) * (1 - Player_2_Strategy) > 0, 1, 0)",
