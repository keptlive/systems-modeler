        "x": 150,
        "y": 380
      }
    },
    {
      "id": "var-best-2",
      "name": "Best Response 2",
      "equation": "IF((e - f) * Player_1_Strategy + (g - h) * (1 - Player_1_Strategy) > 0, 1, 0)",
