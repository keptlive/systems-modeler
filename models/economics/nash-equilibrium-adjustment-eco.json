{
  "id": "nash-equilibrium-adjustment-eco",
  "name": "Nash Equilibrium Learning Dynamics",
  "description": "Players adjust strategies toward best responses over time. Shows how Nash equilibrium can emerge from learning. Foundation for evolutionary game theory. Reference: Fisher, R. A. (1930). The Genetical Theory of Natural Selection. Oxford University Press. Source: https://doi.org/10.5962/bhl.title.27468",
  "stocks": [
    {
      "id": "stock-player1-strategy",
      "name": "Player 1 Strategy",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-player2-strategy",
      "name": "Player 2 Strategy",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-p1-adjustment",
      "name": "P1 Adjustment",
      "equation": "Learning_Rate * (Best_Response_1 - Player_1_Strategy)",
      "from_stock": null,
      "to_stock": "stock-player1-strategy",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "flow-p2-adjustment",
      "name": "P2 Adjustment",
      "equation": "Learning_Rate * (Best_Response_2 - Player_2_Strategy)",
      "from_stock": null,
      "to_stock": "stock-player2-strategy",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-payoff-1",
      "name": "Payoff 1",
      "equation": "a * Player_1_Strategy * Player_2_Strategy + b * Player_1_Strategy * (1 - Player_2_Strategy) + c * (1 - Player_1_Strategy) * Player_2_Strategy + d * (1 - Player_1_Strategy) * (1 - Player_2_Strategy)",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-payoff-2",
      "name": "Payoff 2",
      "equation": "e * Player_1_Strategy * Player_2_Strategy + f * Player_1_Strategy * (1 - Player_2_Strategy) + g * (1 - Player_1_Strategy) * Player_2_Strategy + h * (1 - Player_1_Strategy) * (1 - Player_2_Strategy)",
      "position": {
        "x": 450,
        "y": 80
      }
    },
    {
      "id": "var-a",
      "name": "a",
      "equation": "3",
      "position": {
