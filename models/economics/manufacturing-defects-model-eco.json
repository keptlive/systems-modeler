{
  "id": "manufacturing-defects-model-eco",
  "name": "Manufacturing Defects Model",
  "description": "A quality control model demonstrating how work pressure affects defect rates in manufacturing. The model shows feedback loops where increased backlog leads to longer workdays and faster (but lower quality) work, creating a reinforcing cycle of defects. Based on standard operations management principles. Reference: Juran, J. M. (1999). Juran's Quality Handbook. McGraw-Hill. Source: https://www.mheducation.com/",
  "stocks": [
    {
      "id": "stock-backlog",
      "name": "Backlog",
      "initial_value": 11.7,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-arrival-rate",
      "name": "Arrival Rate",
      "equation": "10 + 12 * PULSE(20, 10)",
      "from_stock": null,
      "to_stock": "stock-backlog",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-fulfillment-rate",
      "name": "Fulfillment Rate",
      "equation": "Number_of_Employees * Length_of_Workday / Time_Allocated_per_Unit * (1 - Defect_Rate)",
      "from_stock": "stock-backlog",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-number-of-employees",
      "name": "Number of Employees",
      "equation": "2",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-length-of-workday",
      "name": "Length of Workday",
      "equation": "Influence_of_Backlog_on_Workday(Backlog)",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-time-allocated-per-unit",
      "name": "Time Allocated per Unit",
      "equation": "Influence_of_Backlog_on_Speed(Backlog)",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-defect-rate",
      "name": "Defect Rate",
      "equation": "0.01 * Length_of_Workday / Time_Allocated_per_Unit",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-influence-of-backlog-on-speed",
      "name": "Influence of Backlog on Speed",
      "equation": "LOOKUP(Backlog, [[0,0.1],[5,0.1],[10,0.09],[15,0.05],[20,0.04],[80,0.04]])",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-influence-of-backlog-on-workday",
      "name": "Influence of Backlog on Workday",
      "equation": "LOOKUP(Backlog, [[0,0.1],[2.77,0.13],[5.54,0.19],[10.35,0.35],[13.12,0.42],[16.54,0.45],[20.53,0.47],[60,0.5]])",
      "position": {
        "x": 100,
        "y": 160
      }
    }
  ],
  "connectors": [
    {
