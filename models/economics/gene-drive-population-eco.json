{
  "id": "gene-drive-population-eco",
  "name": "Gene Drive Population Dynamics Model",
  "description": "Model of gene drive technology spreading through populations, such as for malaria mosquito control. Based on Deredec et al. (2011). Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Wild Type",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Gene Drive Carriers",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Resistant Mutants",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Wild Type Birth",
      "equation": "Wild_Type * Birth_Rate * (1 - Total_Population / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Wild Type Death",
      "equation": "Wild_Type * Death_Rate",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Conversion",
      "equation": "Wild_Type * Gene_Drive_Carriers * Conversion_Rate / Total_Population",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Drive Birth",
      "equation": "Gene_Drive_Carriers * Birth_Rate * Fitness_Cost * (1 - Total_Population / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "f5",
      "name": "Drive Death",
      "equation": "Gene_Drive_Carriers * Death_Rate",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "f6",
      "name": "Resistance Emergence",
      "equation": "Gene_Drive_Carriers * Mutation_Rate",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f7",
      "name": "Resistant Birth",
      "equation": "Resistant_Mutants * Birth_Rate * (1 - Total_Population / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "f8",
      "name": "Resistant Death",
      "equation": "Resistant_Mutants * Death_Rate",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Birth Rate",
      "equation": "0.1",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Death Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "v3",
      "name": "Conversion Rate",
      "equation": "0.9",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Fitness Cost",
      "equation": "0.9",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Mutation Rate",
      "equation": "0.001",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Carrying Capacity",
      "equation": "15000",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Total Population",
      "equation": "Wild_Type + Gene_Drive_Carriers + Resistant_Mutants",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Drive Frequency",
      "equation": "Gene_Drive_Carriers / Total_Population",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Suppression Achieved",
      "equation": "IF(Total_Population < 1000, 1, 0)",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Wild Type",
      "to_element": "Conversion"
    },
    {
      "id": "c2",
      "from_element": "Gene Drive Carriers",
      "to_element": "Conversion"
    },
    {
      "id": "c3",
      "from_element": "Total Population",
      "to_element": "Wild Type Birth"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.1
  },
  "created_at": "2026-01-12T01:55:42.037750+00:00",
  "updated_at": "2026-01-12T01:55:42.037757+00:00",
  "source": "https://doi.org/10.1038/nbt.1917",
  "reference": "Deredec A, Godfray HCJ, Burt A. Requirements for effective malaria control with homing endonuclease genes. PNAS. 2011;108(43):E874-E880."
}