      "to_element": "Tree Growth"
    },
    {
      "id": "conn-3",
      "from_element": "Tree Cover",
      "to_element": "Tree Mortality"
    },
    {
      "id": "conn-4",
      "from_element": "Fire Tree Mortality",
      "to_element": "Tree Mortality"
    },
    {
      "id": "conn-5",
      "from_element": "Tree Cover",
      "to_element": "Grass Growth"
    },
    {
      "id": "conn-6",
      "from_element": "Grass Biomass",
