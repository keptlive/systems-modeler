{
  "id": "speciation-allopatric-evo",
  "name": "Allopatric Speciation Dynamics",
  "description": "Model of allopatric speciation showing how geographic isolation leads to reproductive isolation and eventual species divergence. Based on classic evolutionary biology. Reference: Fisher, R. A. (1930). The Genetical Theory of Natural Selection. Oxford University Press. Source: https://doi.org/10.5962/bhl.title.27468",
  "source": "https://doi.org/10.1126/science.1060521",
  "reference": "Coyne JA, Orr HA. Speciation. Sinauer Associates. 2004.",
  "stocks": [
    {
      "id": "stock-pop1",
      "name": "Population_1",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-pop2",
      "name": "Population_2",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "stock-divergence",
      "name": "Genetic_Divergence",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-growth1",
      "name": "Growth_1",
      "equation": "Population_1 * growth_rate_1 * (1 - Population_1 / K1)",
      "from_stock": null,
      "to_stock": "stock-pop1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-growth2",
      "name": "Growth_2",
      "equation": "Population_2 * growth_rate_2 * (1 - Population_2 / K2)",
      "from_stock": null,
      "to_stock": "stock-pop2",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "flow-diverge",
      "name": "Divergence_Rate",
      "equation": "mutation_rate * (1 - Genetic_Divergence / max_divergence) * isolation_factor",
      "from_stock": null,
      "to_stock": "stock-divergence",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-gene-flow",
      "name": "Gene_Flow_Reduction",
      "equation": "Genetic_Divergence * gene_flow_decay",
      "from_stock": "stock-divergence",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-gr1",
      "name": "growth_rate_1",
      "equation": "0.1",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-gr2",
      "name": "growth_rate_2",
      "equation": "0.12",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-K1",
      "name": "K1",
      "equation": "10000",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-K2",
      "name": "K2",
      "equation": "8000",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-mut",
      "name": "mutation_rate",
      "equation": "0.01",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-max",
      "name": "max_divergence",
      "equation": "100",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-iso",
      "name": "isolation_factor",
      "equation": "0.9",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-decay",
      "name": "gene_flow_decay",
      "equation": "0.001",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-repro",
      "name": "Reproductive_Isolation",
      "equation": "Genetic_Divergence / max_divergence",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 1000,
    "dt": 1,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T12:00:00.000000+00:00",
  "updated_at": "2026-01-12T12:00:00.000000+00:00"
}