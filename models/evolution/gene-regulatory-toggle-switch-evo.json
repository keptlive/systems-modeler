{
  "id": "gene-regulatory-toggle-switch-evo",
  "name": "Genetic Toggle Switch Model",
  "description": "Synthetic biology model of a genetic toggle switch - two mutually repressing genes that create bistable memory. Foundational work in synthetic biology. Source: Gardner et al. (2000). Nature. DOI: 10.1038/35002131",
  "stocks": [
    {"id": "stock-protein1", "name": "Repressor_1", "initial_value": 0.5, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-protein2", "name": "Repressor_2", "initial_value": 1.5, "equation": "", "position": {"x": 400, "y": 200}}
  ],
  "flows": [
    {"id": "flow-prod1", "name": "Repressor_1_Production", "equation": "Alpha_1 / (1 + Repressor_2^Beta) + Inducer_1 - Degradation_Rate * Repressor_1", "from_stock": null, "to_stock": "stock-protein1", "position": {"x": 100, "y": 200}},
    {"id": "flow-prod2", "name": "Repressor_2_Production", "equation": "Alpha_2 / (1 + Repressor_1^Gamma) + Inducer_2 - Degradation_Rate * Repressor_2", "from_stock": null, "to_stock": "stock-protein2", "position": {"x": 500, "y": 200}}
  ],
  "variables": [
    {"id": "var-alpha1", "name": "Alpha_1", "equation": "3", "position": {"x": 150, "y": 100}},
    {"id": "var-alpha2", "name": "Alpha_2", "equation": "3", "position": {"x": 450, "y": 100}},
    {"id": "var-beta", "name": "Beta", "equation": "2.5", "position": {"x": 300, "y": 100}},
    {"id": "var-gamma", "name": "Gamma", "equation": "2.5", "position": {"x": 350, "y": 300}},
    {"id": "var-degradation", "name": "Degradation_Rate", "equation": "1", "position": {"x": 300, "y": 350}},
    {"id": "var-inducer1", "name": "Inducer_1", "equation": "IF(TIME > 50 AND TIME < 60, 2, 0)", "position": {"x": 100, "y": 300}},
    {"id": "var-inducer2", "name": "Inducer_2", "equation": "IF(TIME > 100 AND TIME < 110, 2, 0)", "position": {"x": 500, "y": 300}},
    {"id": "var-state", "name": "Toggle_State", "equation": "IF(Repressor_1 > Repressor_2, 1, 2)", "position": {"x": 300, "y": 400}},
    {"id": "var-bistable", "name": "Bistability_Index", "equation": "ABS(Repressor_1 - Repressor_2) / (Repressor_1 + Repressor_2)", "position": {"x": 400, "y": 400}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 150, "dt": 0.1},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1038/35002131",
  "reference": "Gardner, T.S., Cantor, C.R. & Collins, J.J. (2000). Construction of a genetic toggle switch in Escherichia coli. Nature, 403, 339-342."
}
