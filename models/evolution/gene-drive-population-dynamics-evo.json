{
  "id": "gene-drive-population-dynamics-evo",
  "name": "Gene Drive Population Dynamics Model",
  "description": "Model of gene drive spread in wild populations for disease vector control. Based on Deredec et al. 2011 PNAS. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Wild Type Population",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Heterozygous",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Homozygous Drive",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "s4",
      "name": "Resistance Allele",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Wild Type Birth",
      "equation": "Wild_Type_Population * Birth_Rate * (1 - Total_Pop / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Conversion to Het",
      "equation": "Wild_Type_Population * Heterozygous / Total_Pop * Mating_Rate * Conversion_Rate",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Het to Homo",
      "equation": "Heterozygous * (Heterozygous + Homozygous_Drive) / Total_Pop * Mating_Rate * Conversion_Rate",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Wild Death",
      "equation": "Wild_Type_Population * Death_Rate",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "f5",
      "name": "Het Death",
      "equation": "Heterozygous * Death_Rate * (1 + Fitness_Cost_Het)",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "f6",
      "name": "Homo Death",
      "equation": "Homozygous_Drive * Death_Rate * (1 + Fitness_Cost_Homo)",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "f7",
      "name": "Resistance Emergence",
      "equation": "Heterozygous * Resistance_Rate",
      "from_stock": "s2",
      "to_stock": "s4",
      "position": {
        "x": 300,
        "y": 225
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Birth Rate",
      "equation": "0.5",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Death Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Carrying Capacity",
      "equation": "15000",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "v4",
      "name": "Mating Rate",
      "equation": "0.8",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Conversion Rate",
      "equation": "0.95",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Fitness Cost Het",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Fitness Cost Homo",
      "equation": "0.3",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Resistance Rate",
      "equation": "0.001",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "v9",
      "name": "Total Pop",
      "equation": "Wild_Type_Population + Heterozygous + Homozygous_Drive + Resistance_Allele",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v10",
      "name": "Drive Frequency",
      "equation": "(Heterozygous * 0.5 + Homozygous_Drive) / (Total_Pop + 0.01)",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "v11",
      "name": "Suppression Level",
      "equation": "1 - Total_Pop / Carrying_Capacity",
      "position": {
        "x": 150,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Wild Type Population",
      "to_element": "Conversion to Het"
    },
    {
      "id": "c2",
      "from_element": "Heterozygous",
      "to_element": "Het to Homo"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-15T14:20:13.057169",
  "updated_at": "2026-01-15T14:20:13.057175",
  "source": "https://doi.org/10.1073/pnas.1110717108",
  "reference": "Deredec A, Burt A, Godfray HCJ. The population genetics of using homing endonuclease genes in vector and pest management. Genetics. 2008;179(4):2013-2026."
}