{
  "id": "adaptive-evolution-resistance-evo",
  "name": "Adaptive Evolution of Resistance",
  "description": "Model of evolutionary adaptation showing how resistance evolves in response to selection pressure. Applicable to antibiotic resistance, pesticide resistance, and herbicide resistance evolution. Reference: Fisher, R. A. (1930). The Genetical Theory of Natural Selection. Oxford University Press. Source: https://doi.org/10.5962/bhl.title.27468",
  "source": "https://doi.org/10.1038/nrmicro1464",
  "reference": "Andersson DI, Hughes D. Antibiotic resistance and its cost: is it possible to reverse resistance? Nature Reviews Microbiology. 2010;8:260-271.",
  "stocks": [
    {
      "id": "stock-susceptible",
      "name": "Susceptible_Population",
      "initial_value": 9900,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-resistant",
      "name": "Resistant_Population",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-selection",
      "name": "Selection_Pressure",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-s-birth",
      "name": "Susceptible_Birth",
      "equation": "Susceptible_Population * birth_rate * (1 - Total_Population / carrying_capacity)",
      "from_stock": null,
      "to_stock": "stock-susceptible",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-r-birth",
      "name": "Resistant_Birth",
      "equation": "Resistant_Population * birth_rate * (1 - fitness_cost) * (1 - Total_Population / carrying_capacity)",
      "from_stock": null,
      "to_stock": "stock-resistant",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "flow-s-death",
      "name": "Susceptible_Death",
      "equation": "Susceptible_Population * (death_rate + Selection_Pressure)",
      "from_stock": "stock-susceptible",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "flow-r-death",
      "name": "Resistant_Death",
      "equation": "Resistant_Population * death_rate",
      "from_stock": "stock-resistant",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "flow-mutation",
      "name": "Mutation",
      "equation": "Susceptible_Population * mutation_rate",
      "from_stock": "stock-susceptible",
      "to_stock": "stock-resistant",
      "position": {
        "x": 300,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-birth",
      "name": "birth_rate",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-death",
      "name": "death_rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "var-fitness",
      "name": "fitness_cost",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-mutation",
      "name": "mutation_rate",
      "equation": "0.0001",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-capacity",
      "name": "carrying_capacity",
      "equation": "100000",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-total",
      "name": "Total_Population",
      "equation": "Susceptible_Population + Resistant_Population",
      "position": {
        "x": 300,
        "y": 50
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T12:00:00.000000+00:00",
  "updated_at": "2026-01-12T12:00:00.000000+00:00"
}