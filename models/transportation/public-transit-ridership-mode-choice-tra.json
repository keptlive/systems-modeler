{
  "id": "public-transit-ridership-mode-choice-tra",
  "name": "Public Transit Ridership Model",
  "description": "Model of transit ridership with service quality feedback. Source: Taylor et al. (2009), Transportation Research A.",
  "stocks": [
    {
      "id": "s1",
      "name": "Transit_Riders",
      "initial_value": 50000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Service_Miles",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Fare_Box_Revenue",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Ridership_Change",
      "equation": "Service_Attraction - Mode_Shift_Away",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Service_Adjustment",
      "equation": "Budget_Constraint * Farebox_Recovery_Target",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Revenue",
      "equation": "Transit_Riders * Fare",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Fare",
      "equation": "2.5",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Gas_Price",
      "equation": "4",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Parking_Cost",
      "equation": "10",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Population",
      "equation": "1000000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Service_Frequency",
      "equation": "Service_Miles / 1000",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Auto_Cost",
      "equation": "Gas_Price * 5 + Parking_Cost",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Transit_Cost",
      "equation": "Fare + 30 / Service_Frequency",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Mode_Share",
      "equation": "EXP(-Transit_Cost / 10) / (EXP(-Transit_Cost / 10) + EXP(-Auto_Cost / 10))",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Service_Attraction",
      "equation": "1000 * (Mode_Share * Population - Transit_Riders) / 365",
      "position": {
        "x": 450,
        "y": 420
      }
    },
    {
      "id": "v10",
      "name": "Mode_Shift_Away",
      "equation": "Transit_Riders * 0.001",
      "position": {
        "x": 300,
        "y": 480
      }
    },
    {
      "id": "v11",
      "name": "Budget_Constraint",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 540
      }
    },
    {
      "id": "v12",
      "name": "Farebox_Recovery_Target",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 540
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Service_Miles",
      "to_element": "Service_Frequency"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "created_at": "2026-01-15T14:49:43.657837+00:00",
  "updated_at": "2026-01-15T14:49:43.657841+00:00",
  "source": "https://doi.org/10.1016/j.tra.2008.11.002",
  "reference": "Taylor, B.D. et al. (2009). Nature and/or nurture? Analyzing the determinants of transit ridership. Transportation Research A 43:60-77."
}