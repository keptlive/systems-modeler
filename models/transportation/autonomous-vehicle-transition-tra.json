{
  "id": "autonomous-vehicle-transition-tra",
  "name": "Autonomous Vehicle Market Transition Model",
  "description": "Model of autonomous vehicle adoption showing technology levels, safety, and market penetration. Reference: IEA Global EV Outlook. Source: https://www.iea.org/reports/global-ev-outlook-2021",
  "stocks": [
    {
      "id": "s1",
      "name": "Conventional_Vehicles",
      "initial_value": 280,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Partial_Automation",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Full_Automation",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "s4",
      "name": "AV_Technology_Level",
      "initial_value": 3,
      "equation": "",
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Partial_Adoption",
      "equation": "Conventional_Vehicles * Partial_Adoption_Rate",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Full_Adoption",
      "equation": "Partial_Automation * Full_Adoption_Rate * Regulation_Factor",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Technology_Progress",
      "equation": "R_D_Investment * (5 - AV_Technology_Level) / 5",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Partial_Adoption_Rate",
      "equation": "0.05 * AV_Technology_Level / 5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Full_Adoption_Rate",
      "equation": "0.02 * (AV_Technology_Level - 3) / 2",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Regulation_Factor",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "R_D_Investment",
      "equation": "0.1",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Safety_Improvement",
      "equation": "1 + 0.2 * (AV_Technology_Level - 3)",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "v6",
      "name": "AV_Market_Share",
      "equation": "(Partial_Automation + Full_Automation) / (Conventional_Vehicles + Partial_Automation + Full_Automation)",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Total_Fleet",
      "equation": "Conventional_Vehicles + Partial_Automation + Full_Automation",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:32:16.976806+00:00",
  "updated_at": "2026-01-12T11:32:16.976806+00:00",
  "source": "https://doi.org/10.1016/j.tra.2016.09.014",
  "reference": "Bansal P, Kockelman KM. Forecasting Americans' long-term adoption of connected and autonomous vehicle technologies. Transportation Research Part A. 2017;95:49-63."
}