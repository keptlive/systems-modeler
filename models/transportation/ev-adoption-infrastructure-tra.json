{
  "id": "ev-adoption-infrastructure-tra",
  "name": "EV Adoption and Charging Infrastructure Model",
  "description": "Model of electric vehicle adoption with charging infrastructure feedback. More EVs drive charger deployment, which enables more EV adoption. Based on IEA Global EV Outlook and BloombergNEF projections.",
  "stocks": [
    {"id": "stock-ev-fleet", "name": "EV Fleet", "initial_value": 10, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-ice-fleet", "name": "ICE Fleet", "initial_value": 1000, "equation": "", "position": {"x": 200, "y": 350}},
    {"id": "stock-public-chargers", "name": "Public Chargers", "initial_value": 5, "equation": "", "position": {"x": 500, "y": 200}},
    {"id": "stock-home-chargers", "name": "Home Chargers", "initial_value": 8, "equation": "", "position": {"x": 500, "y": 350}}
  ],
  "flows": [
    {"id": "flow-ev-sales", "name": "EV Sales", "equation": "Total_Vehicle_Sales * EV_Market_Share", "from_stock": null, "to_stock": "stock-ev-fleet", "position": {"x": 100, "y": 200}},
    {"id": "flow-ev-retirements", "name": "EV Retirements", "equation": "EV_Fleet / Vehicle_Lifetime", "from_stock": "stock-ev-fleet", "to_stock": null, "position": {"x": 300, "y": 200}},
    {"id": "flow-ice-sales", "name": "ICE Sales", "equation": "Total_Vehicle_Sales * (1 - EV_Market_Share)", "from_stock": null, "to_stock": "stock-ice-fleet", "position": {"x": 100, "y": 350}},
    {"id": "flow-ice-retirements", "name": "ICE Retirements", "equation": "ICE_Fleet / Vehicle_Lifetime", "from_stock": "stock-ice-fleet", "to_stock": null, "position": {"x": 300, "y": 350}},
    {"id": "flow-public-charger-deployment", "name": "Public Charger Deployment", "equation": "(Desired_Public_Chargers - Public_Chargers) / Charger_Build_Time", "from_stock": null, "to_stock": "stock-public-chargers", "position": {"x": 400, "y": 200}},
    {"id": "flow-home-charger-installation", "name": "Home Charger Installation", "equation": "EV_Sales * Home_Charger_Rate", "from_stock": null, "to_stock": "stock-home-chargers", "position": {"x": 400, "y": 350}}
  ],
  "variables": [
    {"id": "var-total-vehicle-sales", "name": "Total Vehicle Sales", "equation": "100", "position": {"x": 150, "y": 100}},
    {"id": "var-vehicle-lifetime", "name": "Vehicle Lifetime", "equation": "15", "position": {"x": 350, "y": 100}},
    {"id": "var-ev-price-premium", "name": "EV Price Premium", "equation": "MAX(0, 10000 - 500 * Time)", "position": {"x": 550, "y": 100}},
    {"id": "var-charging-coverage", "name": "Charging Coverage", "equation": "(Public_Chargers + Home_Chargers) / EV_Fleet", "position": {"x": 350, "y": 450}},
    {"id": "var-ev-attractiveness", "name": "EV Attractiveness", "equation": "MIN(1, Charging_Coverage / Desired_Coverage) * MAX(0, 1 - EV_Price_Premium / 20000)", "position": {"x": 550, "y": 450}},
    {"id": "var-ev-market-share", "name": "EV Market Share", "equation": "MAX(0.01, MIN(0.95, 0.1 + 0.8 * EV_Attractiveness))", "position": {"x": 150, "y": 450}},
    {"id": "var-desired-coverage", "name": "Desired Coverage", "equation": "1.5", "position": {"x": 650, "y": 200}},
    {"id": "var-desired-public-chargers", "name": "Desired Public Chargers", "equation": "EV_Fleet / EVs_Per_Public_Charger", "position": {"x": 650, "y": 280}},
    {"id": "var-evs-per-public-charger", "name": "EVs Per Public Charger", "equation": "10", "position": {"x": 650, "y": 360}},
    {"id": "var-charger-build-time", "name": "Charger Build Time", "equation": "1", "position": {"x": 650, "y": 440}},
    {"id": "var-home-charger-rate", "name": "Home Charger Rate", "equation": "0.7", "position": {"x": 350, "y": 520}},
    {"id": "var-ev-share-of-fleet", "name": "EV Share of Fleet", "equation": "EV_Fleet / (EV_Fleet + ICE_Fleet)", "position": {"x": 150, "y": 520}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 30, "dt": 0.25},
  "source": "https://doi.org/10.1038/s41560-021-00888-1",
  "reference": "IEA. Global EV Outlook 2023. International Energy Agency. 2023."
}
