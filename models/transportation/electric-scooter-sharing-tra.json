{
  "id": "electric-scooter-sharing-tra",
  "name": "Electric Scooter Sharing System Dynamics",
  "description": "Model of electric scooter sharing systems (e.g., Lime, Bird) showing fleet utilization, battery management, and user adoption dynamics. Reference: BloombergNEF Battery Price Survey. Source: https://about.bnef.com/",
  "source": "https://doi.org/10.1016/j.trd.2020.102482",
  "reference": "Reck DJ, Axhausen KW. Free-floating shared electric scooter usage and mode choice. Transportation Research Part D. 2021;93:102762.",
  "stocks": [
    {
      "id": "stock-fleet",
      "name": "Active_Fleet",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-charging",
      "name": "Charging_Scooters",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-users",
      "name": "Registered_Users",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-deplete",
      "name": "Battery_Depletion",
      "equation": "Active_Fleet * usage_rate * depletion_rate",
      "from_stock": "stock-fleet",
      "to_stock": "stock-charging",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-recharge",
      "name": "Recharging",
      "equation": "Charging_Scooters * recharge_rate",
      "from_stock": "stock-charging",
      "to_stock": "stock-fleet",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "flow-add-fleet",
      "name": "Fleet_Expansion",
      "equation": "expansion_rate * user_demand_gap",
      "from_stock": null,
      "to_stock": "stock-fleet",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-retire",
      "name": "Fleet_Retirement",
      "equation": "(Active_Fleet + Charging_Scooters) * retirement_rate",
      "from_stock": "stock-fleet",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-signup",
      "name": "User_Signup",
      "equation": "signup_rate * Availability * marketing_effect",
      "from_stock": null,
      "to_stock": "stock-users",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-churn",
      "name": "User_Churn",
      "equation": "Registered_Users * churn_rate * (1 - Availability)",
      "from_stock": "stock-users",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-usage",
      "name": "usage_rate",
      "equation": "5",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-deplete",
      "name": "depletion_rate",
      "equation": "0.2",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-recharge",
      "name": "recharge_rate",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "var-expand",
      "name": "expansion_rate",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-retire",
      "name": "retirement_rate",
      "equation": "0.005",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "var-signup",
      "name": "signup_rate",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-mktg",
      "name": "marketing_effect",
      "equation": "1.2",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-churn",
      "name": "churn_rate",
      "equation": "0.02",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-avail",
      "name": "Availability",
      "equation": "Active_Fleet / (Registered_Users * target_ratio)",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-target",
      "name": "target_ratio",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "var-gap",
      "name": "user_demand_gap",
      "equation": "max(0, Registered_Users * target_ratio - Active_Fleet) / 100",
      "position": {
        "x": 100,
        "y": 250
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 52,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T12:00:00.000000+00:00",
  "updated_at": "2026-01-12T12:00:00.000000+00:00"
}