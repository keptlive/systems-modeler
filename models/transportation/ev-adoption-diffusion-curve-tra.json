{
  "id": "ev-adoption-diffusion-curve-tra",
  "name": "Electric Vehicle Adoption Model",
  "description": "S-curve diffusion model for EV adoption with infrastructure feedback. Source: IEA Global EV Outlook.",
  "stocks": [
    {
      "id": "s1",
      "name": "EV_Stock",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Charging_Infrastructure",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "EV_Sales",
      "equation": "Bass_Adoption * (Market_Potential - EV_Stock)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Charger_Installation",
      "equation": "Infrastructure_Investment * EV_Stock / 10",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Market_Potential",
      "equation": "100",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "p_innovation",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "q_imitation",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Infrastructure_Investment",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Range_Anxiety_Factor",
      "equation": "1 - EXP(-Charging_Infrastructure / EV_Stock)",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Bass_Adoption",
      "equation": "(p_innovation + q_imitation * EV_Stock / Market_Potential) * Range_Anxiety_Factor",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "EV_Share",
      "equation": "EV_Stock / Market_Potential",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "EV_Stock",
      "to_element": "Bass_Adoption"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.5
  },
  "created_at": "2026-01-15T14:44:54.461044+00:00",
  "updated_at": "2026-01-15T14:44:54.461047+00:00",
  "source": "https://www.iea.org/reports/global-ev-outlook-2023",
  "reference": "IEA (2023). Global EV Outlook 2023. International Energy Agency."
}