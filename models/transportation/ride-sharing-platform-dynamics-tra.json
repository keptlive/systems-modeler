{
  "id": "ride-sharing-platform-dynamics-tra",
  "name": "Ride-Sharing Platform Dynamics Model",
  "description": "Model of ride-sharing market with two-sided network effects. Source: Cachon et al. (2017), Management Science.",
  "stocks": [
    {
      "id": "s1",
      "name": "Active_Drivers",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Active_Riders",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Completed_Rides",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Driver_Net_Change",
      "equation": "Driver_Join_Rate - Driver_Churn",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Rider_Net_Change",
      "equation": "Rider_Join_Rate - Rider_Churn",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Ride_Matching",
      "equation": "Match_Rate * Active_Riders",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Base_Fare",
      "equation": "10",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Commission_Rate",
      "equation": "0.25",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Surge_Multiplier",
      "equation": "MAX(1, Active_Riders / (Active_Drivers * 5 + 1))",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Wait_Time",
      "equation": "5 + 20 / (Active_Drivers + 1)",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Driver_Earnings",
      "equation": "Base_Fare * Surge_Multiplier * (1 - Commission_Rate)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Rider_Price",
      "equation": "Base_Fare * Surge_Multiplier",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Driver_Join_Rate",
      "equation": "10 * Driver_Earnings / 10",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Driver_Churn",
      "equation": "0.05 * Active_Drivers",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Rider_Join_Rate",
      "equation": "50 * 10 / (Wait_Time + Rider_Price)",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "v10",
      "name": "Rider_Churn",
      "equation": "0.1 * Active_Riders * (Wait_Time / 10)",
      "position": {
        "x": 300,
        "y": 480
      }
    },
    {
      "id": "v11",
      "name": "Match_Rate",
      "equation": "MIN(Active_Drivers / (Active_Riders + 1) * 5, 1) * 0.1",
      "position": {
        "x": 500,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Active_Drivers",
      "to_element": "Wait_Time"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-15T14:49:43.657796+00:00",
  "updated_at": "2026-01-15T14:49:43.657799+00:00",
  "source": "https://doi.org/10.1287/mnsc.2016.2561",
  "reference": "Cachon, G.P. et al. (2017). The role of surge pricing on a service platform with self-scheduling capacity. Management Science 63:1705-1724."
}