{
  "id": "greenshields-traffic-flow-model-tra",
  "name": "Greenshields Traffic Flow Model",
  "description": "Illustrative traffic stock-flow model using the Greenshields linear speed-density relation. Capacity is the maximum of the parabolic flow-density relation. Arrival forcing and queue equations are local illustrative additions, not a reproduction of the 1935 empirical study. Explicit RK4 DT 0.02 resolves the fast density relaxation on the full 24-unit horizon; default/half/quarter grids fit the work budget. Against independent handwritten equations, maximum density error is below 0.05% of the reference maximum and falls below 0.00012% at quarter DT. For the original inputs the invariant density interval [0,50] stays below the unchanged queue trigger 120, so queue remains zero. Parameter calibration and altered-scenario queue validity remain unverified.",
  "stocks": [
    {
      "id": "s1",
      "name": "Vehicle_Density",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Queue_Length",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Density_Change",
      "equation": "(Arrival_Rate - Departure_Rate) / Road_Length",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Queue_Growth",
      "equation": "IF(Vehicle_Density > Jam_Density * 0.8, Arrival_Rate - Capacity, 0)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Free_Flow_Speed",
      "equation": "60",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Jam_Density",
      "equation": "150",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Road_Length",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Arrival_Rate",
      "equation": "1500 + 500 * SIN(TIME * 0.5)",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Speed",
      "equation": "Free_Flow_Speed * (1 - Vehicle_Density / Jam_Density)",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v6",
      "name": "Flow",
      "equation": "Vehicle_Density * Speed",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Capacity",
      "equation": "Free_Flow_Speed * Jam_Density / 4",
      "position": {
        "x": 300,
        "y": 420
      }
    },
    {
      "id": "v8",
      "name": "Departure_Rate",
      "equation": "MIN(Flow, Capacity)",
      "position": {
        "x": 500,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Level_of_Service",
      "equation": "IF(Vehicle_Density < Jam_Density * 0.3, 1, IF(Vehicle_Density < Jam_Density * 0.6, 2, 3))",
      "position": {
        "x": 300,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Vehicle_Density",
      "to_element": "Speed"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 24,
    "dt": 0.02,
    "integration_method": "rk4"
  },
  "created_at": "2026-01-15T14:49:43.657712+00:00",
  "updated_at": "2026-01-15T14:49:43.657721+00:00",
  "source": "https://onlinepubs.trb.org/Onlinepubs/hrbproceedings/14/14P1-023.pdf",
  "reference": "Greenshields, B.D. (1935). A Study of Traffic Capacity. Highway Research Board Proceedings 14, Part I:448-477 (including discussion)."
}
