{
  "id": "greenshields-traffic-flow-model-tra",
  "name": "Greenshields Traffic Flow Model",
  "description": "Fundamental traffic flow model relating speed, density, and flow. Source: Greenshields (1935), Highway Research Board.",
  "stocks": [
    {
      "id": "s1",
      "name": "Vehicle_Density",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Queue_Length",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Density_Change",
      "equation": "(Arrival_Rate - Departure_Rate) / Road_Length",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Queue_Growth",
      "equation": "IF(Vehicle_Density > Jam_Density * 0.8, Arrival_Rate - Capacity, 0)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Free_Flow_Speed",
      "equation": "60",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Jam_Density",
      "equation": "150",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Road_Length",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Arrival_Rate",
      "equation": "1500 + 500 * SIN(TIME * 0.5)",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Speed",
      "equation": "Free_Flow_Speed * (1 - Vehicle_Density / Jam_Density)",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v6",
      "name": "Flow",
      "equation": "Vehicle_Density * Speed",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Capacity",
      "equation": "Free_Flow_Speed * Jam_Density / 4",
      "position": {
        "x": 300,
        "y": 420
      }
    },
    {
      "id": "v8",
      "name": "Departure_Rate",
      "equation": "MIN(Flow, Capacity)",
      "position": {
        "x": 500,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Level_of_Service",
      "equation": "IF(Vehicle_Density < Jam_Density * 0.3, 1, IF(Vehicle_Density < Jam_Density * 0.6, 2, 3))",
      "position": {
        "x": 300,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Vehicle_Density",
      "to_element": "Speed"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 24,
    "dt": 0.1
  },
  "created_at": "2026-01-15T14:49:43.657712+00:00",
  "updated_at": "2026-01-15T14:49:43.657721+00:00",
  "source": "https://doi.org/10.17226/22229",
  "reference": "Greenshields, B.D. (1935). A Study of Traffic Capacity. Highway Research Board Proceedings 14:448-477."
}