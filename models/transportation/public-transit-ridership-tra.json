{
  "id": "public-transit-ridership-tra",
  "name": "Public Transit Ridership Dynamics Model",
  "description": "Model of public transit ridership showing service quality, frequency, and mode choice dynamics. Reference: NSIDC Arctic Sea Ice News. Source: https://nsidc.org/arcticseaicenews/",
  "stocks": [
    {
      "id": "s1",
      "name": "Transit_Riders",
      "initial_value": 100000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Car_Commuters",
      "initial_value": 400000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Service_Quality",
      "initial_value": 0.6,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Mode_Shift_to_Transit",
      "equation": "Car_Commuters * Shift_Rate * Attractiveness",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Mode_Shift_to_Car",
      "equation": "Transit_Riders * Abandonment_Rate * (1 - Service_Quality)",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Quality_Improvement",
      "equation": "Investment_Effect - Crowding_Effect",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Shift_Rate",
      "equation": "0.01",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Attractiveness",
      "equation": "Service_Quality * Frequency_Factor * Cost_Savings",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Abandonment_Rate",
      "equation": "0.02",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "v4",
      "name": "Investment_Effect",
      "equation": "0.01 * Fare_Revenue / 1000000",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Crowding_Effect",
      "equation": "0.001 * Transit_Riders / 100000",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v6",
      "name": "Frequency_Factor",
      "equation": "1.2",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Cost_Savings",
      "equation": "1.5",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "v8",
      "name": "Fare_Revenue",
      "equation": "Transit_Riders * 2.5",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "v9",
      "name": "Mode_Share",
      "equation": "Transit_Riders / (Transit_Riders + Car_Commuters)",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:32:16.976721+00:00",
  "updated_at": "2026-01-12T11:32:16.976721+00:00",
  "source": "https://doi.org/10.1016/j.tra.2007.06.004",
  "reference": "Currie G. The demand performance of bus rapid transit. Journal of Public Transportation. 2005;8(1):41-55."
}