      "equation": "3.5",
      "position": {
        "x": 580,
        "y": 80
      }
    },
    {
      "id": "var-coral-growth-rate",
      "name": "Coral_Growth_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 420
      }
    },
    {
      "id": "var-shellfish-growth-rate",
      "name": "Shellfish_Growth_Rate",
      "equation": "0.2",
      "position": {
        "x": 220,
        "y": 420
      }
    },
    {
      "id": "var-fish-growth-rate",
