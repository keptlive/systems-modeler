      "equation": "0.15",
      "position": {
        "x": 340,
        "y": 420
      }
    },
    {
      "id": "var-base-mortality",
      "name": "Base_Mortality",
      "equation": "0.05",
      "position": {
        "x": 460,
        "y": 420
      }
    },
    {
      "id": "var-acidification-stress",
      "name": "Acidification_Stress",
      "equation": "0.5",
      "position": {
        "x": 580,
        "y": 420
      }
    },
    {
      "id": "var-fish-mortality-rate",
      "name": "Fish_Mortality_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 460
      }
    },
    {
      "id": "var-reference-coral",
      "name": "Reference_Coral",
      "equation": "100",
      "position": {
        "x": 220,
        "y": 460
      }
    },
    {
      "id": "var-reference-shellfish",
