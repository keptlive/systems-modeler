{
  "id": "nuclear-power-lifecycle-cli",
  "name": "Nuclear Power Plant Lifecycle Model",
  "description": "Model of nuclear power plant fleet dynamics including construction, operation, and decommissioning. Based on Davis & Hausman (2016) and World Nuclear Association data on reactor lifecycles. Reference: IAEA Nuclear Energy Data. Source: https://www.iaea.org/",
  "stocks": [
    {
      "id": "stock-under-construction",
      "name": "Plants Under Construction",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-operating",
      "name": "Operating Plants",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-decommissioning",
      "name": "Plants Decommissioning",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-waste-inventory",
      "name": "Nuclear Waste Inventory",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-construction-start",
      "name": "Construction Starts",
      "equation": "New_Plant_Orders",
      "from_stock": null,
      "to_stock": "stock-under-construction",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-completion",
      "name": "Plant Completions",
      "equation": "Plants_Under_Construction / Construction_Time",
      "from_stock": "stock-under-construction",
      "to_stock": "stock-operating",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-retirement",
      "name": "Plant Retirements",
      "equation": "Operating_Plants * Retirement_Rate + Early_Closures",
      "from_stock": "stock-operating",
      "to_stock": "stock-decommissioning",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-decommission-complete",
      "name": "Decommissioning Complete",
      "equation": "Plants_Decommissioning / Decommission_Time",
      "from_stock": "stock-decommissioning",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-waste-generation",
      "name": "Waste Generation",
      "equation": "Operating_Plants * Waste_per_Plant_Year",
      "from_stock": null,
      "to_stock": "stock-waste-inventory",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-waste-disposal",
      "name": "Waste Disposal",
      "equation": "Disposal_Rate",
      "from_stock": "stock-waste-inventory",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-electricity-demand",
      "name": "Electricity Demand",
      "equation": "1000 + 10 * Time",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-nuclear-share-target",
      "name": "Nuclear Share Target",
      "equation": "0.2",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-desired-capacity",
      "name": "Desired Nuclear Capacity",
      "equation": "Electricity_Demand * Nuclear_Share_Target",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-current-capacity",
      "name": "Current Nuclear Capacity",
      "equation": "Operating_Plants * Capacity_per_Plant",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-capacity-gap",
      "name": "Capacity Gap",
      "equation": "Desired_Capacity - Current_Capacity - Plants_Under_Construction * Capacity_per_Plant",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-new-plant-orders",
      "name": "New Plant Orders",
      "equation": "MAX(0, Capacity_Gap / Capacity_per_Plant / Order_Response_Time)",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-capacity-per-plant",
      "name": "Capacity per Plant",
      "equation": "1",
      "position": {
        "x": 250,
        "y": 400
      }
    },
    {
      "id": "var-construction-time",
      "name": "Construction Time",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "var-retirement-rate",
      "name": "Retirement Rate",
      "equation": "1 / Plant_Lifetime",
      "position": {
        "x": 550,
        "y": 400
      }
    },
    {
      "id": "var-plant-lifetime",
      "name": "Plant Lifetime",
      "equation": "40",
      "position": {
        "x": 700,
        "y": 400
      }
    },
    {
      "id": "var-early-closures",
      "name": "Early Closures",
      "equation": "IF Electricity_Price < Operating_Cost THEN Operating_Plants * 0.02 ELSE 0",
      "position": {
        "x": 100,
        "y": 470
      }
    },
    {
      "id": "var-electricity-price",
      "name": "Electricity Price",
      "equation": "50",
      "position": {
        "x": 300,
        "y": 470
      }
    },
    {
      "id": "var-operating-cost",
      "name": "Operating Cost",
      "equation": "30",
      "position": {
        "x": 450,
        "y": 470
      }
    },
    {
      "id": "var-decommission-time",
      "name": "Decommission Time",
      "equation": "20",
      "position": {
        "x": 600,
        "y": 470
      }
    },
    {
      "id": "var-waste-per-plant-year",
      "name": "Waste per Plant Year",
      "equation": "20",
      "position": {
        "x": 100,
        "y": 540
      }
    },
    {
      "id": "var-disposal-rate",
      "name": "Disposal Rate",
      "equation": "50",
      "position": {
        "x": 250,
        "y": 540
      }
    },
    {
      "id": "var-order-response-time",
      "name": "Order Response Time",
      "equation": "3",
      "position": {
        "x": 400,
        "y": 540
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-11T21:16:29.727464+00:00",
  "updated_at": "2026-01-11T21:16:29.727464+00:00",
  "source": "https://github.com/SDXorg/PySD-Cookbook",
  "reference": "SDXorg System Dynamics Model Repository"
}