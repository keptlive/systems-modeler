{
  "id": "climate-system-dynamics-projections-cli",
  "name": "Climate Change Projections System Dynamics Integration",
  "description": "Framework for implementing climate change projections in system dynamics models. Integrates biophysical and socioeconomic variables. Source: Martinez-Valderrama et al. (2023), MethodsX. DOI: 10.1016/j.mex.2023.102154",
  "stocks": [
    {
      "id": "stock-land",
      "name": "Productive_Land",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-deg",
      "name": "Degraded_Land",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-water",
      "name": "Water_Resources",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-pop",
      "name": "Population",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-degrade",
      "name": "Land_Degradation",
      "equation": "Productive_Land * (Climate_Stress + Overuse_Factor * Population / Carrying_Capacity)",
      "from_stock": "stock-land",
      "to_stock": "stock-deg",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-restore",
      "name": "Land_Restoration",
      "equation": "Degraded_Land * Restoration_Rate * Water_Resources / Water_Threshold",
      "from_stock": "stock-deg",
      "to_stock": "stock-land",
      "position": {
        "x": 175,
        "y": 250
      }
    },
    {
      "id": "flow-precip",
      "name": "Precipitation",
      "equation": "Base_Precip * (1 - Climate_Drying)",
      "from_stock": null,
      "to_stock": "stock-water",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "flow-evap",
      "name": "Evapotranspiration",
      "equation": "Water_Resources * (Evap_Rate + Climate_Warming * 0.01)",
      "from_stock": "stock-water",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-pop",
      "name": "Population_Change",
      "equation": "Population * Growth_Rate * MIN(1, Productive_Land / Land_Requirement)",
      "from_stock": null,
      "to_stock": "stock-pop",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-stress",
      "name": "Climate_Stress",
      "equation": "0.005 + 0.0002 * TIME",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-overuse",
      "name": "Overuse_Factor",
      "equation": "0.01",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-carry",
      "name": "Carrying_Capacity",
      "equation": "50000",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-restore",
      "name": "Restoration_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-waterthresh",
      "name": "Water_Threshold",
      "equation": "300",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-precip",
      "name": "Base_Precip",
      "equation": "50",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-dry",
      "name": "Climate_Drying",
      "equation": "0.002 * TIME",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-evap",
      "name": "Evap_Rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-warm",
      "name": "Climate_Warming",
      "equation": "0.02 * TIME",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "var-growth",
      "name": "Growth_Rate",
      "equation": "0.02",
      "position": {
        "x": 150,
        "y": 400
      }
    },
    {
      "id": "var-req",
      "name": "Land_Requirement",
      "equation": "100",
      "position": {
        "x": 250,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T12:41:31.049102+00:00",
  "updated_at": "2026-01-12T12:41:31.049102+00:00",
  "source": "https://doi.org/10.1017/9781009157896",
  "reference": "IPCC. Climate Change 2023: Synthesis Report. Cambridge University Press; 2023."
}