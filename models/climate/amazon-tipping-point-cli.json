{
  "id": "amazon-tipping-point-cli",
  "name": "Amazon Forest Dieback Tipping Point",
  "description": "Model of Amazon rainforest dieback as a climate tipping point. Deforestation and climate change can push the Amazon past a threshold where forest-rainfall feedbacks cause large-scale conversion to savanna. Critical threshold estimated at 20-25% deforestation. Reference: IPCC Climate Assessment Reports. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "s1",
      "name": "Forest_Cover",
      "initial_value": 0.85,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Savanna_Area",
      "initial_value": 0.15,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Regional_Precipitation",
      "initial_value": 2000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Deforestation",
      "equation": "Forest_Cover * Deforestation_Rate",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Forest_Regrowth",
      "equation": "Savanna_Area * Regrowth_Rate * Precipitation_Effect",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 250,
        "y": 270
      }
    },
    {
      "id": "f3",
      "name": "Precipitation_Change",
      "equation": "(Equilibrium_Precipitation - Regional_Precipitation) / Adjustment_Time",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Deforestation_Rate",
      "equation": "0.012",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "v2",
      "name": "Regrowth_Rate",
      "equation": "0.005",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "v3",
      "name": "Tipping_Threshold",
      "equation": "0.6",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "v4",
      "name": "Precipitation_Effect",
      "equation": "IF Regional_Precipitation > 1500 THEN 1 ELSE Regional_Precipitation / 1500",
      "position": {
        "x": 150,
        "y": 130
      }
    },
    {
      "id": "v5",
      "name": "Equilibrium_Precipitation",
      "equation": "1200 + 1000 * Forest_Cover",
      "position": {
        "x": 350,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "Adjustment_Time",
      "equation": "5",
      "position": {
        "x": 500,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Distance_to_Tipping",
      "equation": "Forest_Cover - Tipping_Threshold",
      "position": {
        "x": 250,
        "y": 430
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/s41586-020-2035-0",
  "reference": "Lovejoy TE, Nobre C (2018) Amazon Tipping Point. Science Advances. Also: Staal A et al. (2020) Nature Communications.",
  "created_at": "2026-01-12T06:54:12.140274+00:00",
  "updated_at": "2026-01-12T06:54:12.140274+00:00"
}