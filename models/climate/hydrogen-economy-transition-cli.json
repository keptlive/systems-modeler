{
  "id": "hydrogen-economy-transition-cli",
  "name": "Hydrogen Economy Transition Model",
  "description": "Models green hydrogen production and adoption pathways. Source: IEA (2019), The Future of Hydrogen. DOI: 10.1787/1e0514c4-en",
  "stocks": [
    {
      "id": "stock-greenh",
      "name": "Green_H2_Production",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-greyh",
      "name": "Grey_H2_Production",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-h2demand",
      "name": "H2_Demand",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 350,
        "y": 175
      }
    },
    {
      "id": "stock-electcap",
      "name": "Electrolyzer_Capacity",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 50
      }
    }
  ],
  "flows": [
    {
      "id": "flow-greengrow",
      "name": "Green_H2_Growth",
      "equation": "Electrolyzer_Capacity * Capacity_Factor * Electrolyzer_Growth",
      "from_stock": null,
      "to_stock": "stock-greenh",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-greydecline",
      "name": "Grey_H2_Decline",
      "equation": "Grey_H2_Production * Substitution_Rate * (Green_H2_Production / (Green_H2_Production + Grey_H2_Production))",
      "from_stock": "stock-greyh",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "flow-demandgrow",
      "name": "Demand_Growth",
      "equation": "H2_Demand * H2_Demand_Growth",
      "from_stock": null,
      "to_stock": "stock-h2demand",
      "position": {
        "x": 250,
        "y": 175
      }
    },
    {
      "id": "flow-electgrow",
      "name": "Electrolyzer_Build",
      "equation": "Electrolyzer_Capacity * Electrolyzer_Growth",
      "from_stock": null,
      "to_stock": "stock-electcap",
      "position": {
        "x": 250,
        "y": 50
      }
    }
  ],
  "variables": [
    {
      "id": "var-capfactor",
      "name": "Capacity_Factor",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-electgrow",
      "name": "Electrolyzer_Growth",
      "equation": "0.15",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-substrate",
      "name": "Substitution_Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-demandgrow",
      "name": "H2_Demand_Growth",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 175
      }
    },
    {
      "id": "var-greenshare",
      "name": "Green_H2_Share",
      "equation": "Green_H2_Production / (Green_H2_Production + Grey_H2_Production) * 100",
      "position": {
        "x": 250,
        "y": 325
      }
    },
    {
      "id": "var-emissions",
      "name": "H2_Sector_Emissions",
      "equation": "Grey_H2_Production * 10",
      "position": {
        "x": 350,
        "y": 325
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Electrolyzer_Capacity",
      "to_element": "Green_H2_Growth"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:09:47.460641+00:00",
  "updated_at": "2026-01-12T02:09:47.460644+00:00",
  "source": "https://doi.org/10.1787/1e0514c4-en",
  "reference": "IEA (2019). The Future of Hydrogen. International Energy Agency."
}