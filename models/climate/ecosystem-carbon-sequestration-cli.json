{
  "id": "ecosystem-carbon-sequestration-cli",
  "name": "Ecosystem Carbon Sequestration Model",
  "description": "Model of carbon sequestration in terrestrial ecosystems showing forest, soil, and atmospheric carbon dynamics. Reference: IPCC (2021). Climate Change 2021: The Physical Science Basis. Source: https://www.ipcc.ch/report/ar6/wg1/",
  "stocks": [
    {
      "id": "stock-atm",
      "name": "Atmospheric_Carbon",
      "initial_value": 850,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-veg",
      "name": "Vegetation_Carbon",
      "initial_value": 550,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-soil",
      "name": "Soil_Carbon",
      "initial_value": 1500,
      "equation": "",
      "position": {
        "x": 450,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-photosynthesis",
      "name": "Photosynthesis",
      "equation": "Vegetation_Carbon * GPP_Rate * CO2_Fertilization",
      "from_stock": "stock-atm",
      "to_stock": "stock-veg",
      "position": {
        "x": 220,
        "y": 175
      }
    },
    {
      "id": "flow-respiration",
      "name": "Plant_Respiration",
      "equation": "Vegetation_Carbon * Respiration_Rate",
      "from_stock": "stock-veg",
      "to_stock": "stock-atm",
      "position": {
        "x": 230,
        "y": 175
      }
    },
    {
      "id": "flow-litterfall",
      "name": "Litterfall",
      "equation": "Vegetation_Carbon * Litterfall_Rate",
      "from_stock": "stock-veg",
      "to_stock": "stock-soil",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "flow-decomposition",
      "name": "Soil_Decomposition",
      "equation": "Soil_Carbon * Decomposition_Rate * Temperature_Effect",
      "from_stock": "stock-soil",
      "to_stock": "stock-atm",
      "position": {
        "x": 380,
        "y": 175
      }
    },
    {
      "id": "flow-emissions",
      "name": "Anthropogenic_Emissions",
      "equation": "Annual_Emissions",
      "from_stock": null,
      "to_stock": "stock-atm",
      "position": {
        "x": 300,
        "y": 50
      }
    }
  ],
  "variables": [
    {
      "id": "var-gpp",
      "name": "GPP_Rate",
      "equation": "0.12",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-co2-fert",
      "name": "CO2_Fertilization",
      "equation": "1 + 0.1 * (Atmospheric_Carbon - 280) / 280",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-resp",
      "name": "Respiration_Rate",
      "equation": "0.06",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-litter",
      "name": "Litterfall_Rate",
      "equation": "0.04",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-decomp",
      "name": "Decomposition_Rate",
      "equation": "0.02",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-temp",
      "name": "Temperature_Effect",
      "equation": "1.0",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "var-emissions",
      "name": "Annual_Emissions",
      "equation": "10",
      "position": {
        "x": 450,
        "y": 50
      }
    }
  ],
