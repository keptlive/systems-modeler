{
  "id": "ipcc-renewable-energy-transition-cli",
  "name": "IPCC Renewable Energy Transition Model",
  "description": "Model of renewable energy transition based on IPCC scenarios. Explores pathways to decarbonization through solar, wind, and storage deployment. Source: IPCC (2022), AR6 WGIII Chapter 6. DOI: 10.1017/9781009157926.008",
  "stocks": [
    {
      "id": "stock-fossil",
      "name": "Fossil_Capacity",
      "initial_value": 4000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "stock-solar",
      "name": "Solar_Capacity",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-wind",
      "name": "Wind_Capacity",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "stock-storage",
      "name": "Storage_Capacity",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "stock-emissions",
      "name": "Cumulative_CO2",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-fossil-ret",
      "name": "Fossil_Retirement",
      "equation": "Fossil_Capacity / Fossil_Lifetime + Carbon_Price * Fossil_Capacity * 0.001",
      "from_stock": "stock-fossil",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-solar-add",
      "name": "Solar_Addition",
      "equation": "Solar_Investment / Solar_Cost",
      "from_stock": null,
      "to_stock": "stock-solar",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-solar-ret",
      "name": "Solar_Retirement",
      "equation": "Solar_Capacity / Solar_Lifetime",
      "from_stock": "stock-solar",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-wind-add",
      "name": "Wind_Addition",
      "equation": "Wind_Investment / Wind_Cost",
      "from_stock": null,
      "to_stock": "stock-wind",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "flow-wind-ret",
      "name": "Wind_Retirement",
      "equation": "Wind_Capacity / Wind_Lifetime",
      "from_stock": "stock-wind",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "flow-storage-add",
      "name": "Storage_Addition",
      "equation": "Storage_Investment / Storage_Cost",
      "from_stock": null,
      "to_stock": "stock-storage",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "flow-emit",
      "name": "Annual_Emissions",
      "equation": "Fossil_Capacity * Fossil_Intensity",
      "from_stock": null,
      "to_stock": "stock-emissions",
      "position": {
        "x": 450,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-fossil-life",
      "name": "Fossil_Lifetime",
      "equation": "40",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-solar-life",
      "name": "Solar_Lifetime",
      "equation": "25",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-wind-life",
      "name": "Wind_Lifetime",
      "equation": "25",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-solar-cost",
      "name": "Solar_Cost",
      "equation": "1.0",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "var-wind-cost",
      "name": "Wind_Cost",
      "equation": "1.5",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "var-storage-cost",
      "name": "Storage_Cost",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "var-solar-inv",
      "name": "Solar_Investment",
      "equation": "200",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "var-wind-inv",
      "name": "Wind_Investment",
      "equation": "150",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "var-storage-inv",
      "name": "Storage_Investment",
      "equation": "50",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-carbon",
      "name": "Carbon_Price",
      "equation": "50",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "var-intensity",
      "name": "Fossil_Intensity",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Fossil_Capacity",
      "to_element": "Annual_Emissions"
    },
    {
      "id": "conn-2",
      "from_element": "Carbon_Price",
      "to_element": "Fossil_Retirement"
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "created_at": "2026-01-11T22:11:19.086312Z",
  "updated_at": "2026-01-11T22:11:19.086323Z",
  "source": "https://doi.org/10.1017/9781009157926.008",
  "reference": "IPCC (2022). Climate Change 2022: Mitigation of Climate Change. Chapter 6: Energy Systems."
}