{
  "id": "urban-heat-island-cli",
  "name": "Urban Heat Island Effect Model",
  "description": "Model of urban heat island dynamics showing how urbanization, vegetation loss, and building density affect local temperatures. Based on Oke (1982). Reference: NASA GISS Surface Temperature Analysis. Source: https://data.giss.nasa.gov/gistemp/",
  "stocks": [
    {
      "id": "s1",
      "name": "Urban Temperature",
      "initial_value": 25,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Urban Area",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Green Space",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Urban Heating",
      "equation": "(Anthropogenic_Heat + Solar_Absorption - Evaporative_Cooling - Radiative_Loss) / Heat_Capacity",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Urban Expansion",
      "equation": "Urban_Growth_Rate",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Green Space Loss",
      "equation": "Green_Space * Conversion_Rate",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Green Restoration",
      "equation": "Greening_Investment",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Rural Temperature",
      "equation": "20",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "UHI Intensity",
      "equation": "Urban_Temperature - Rural_Temperature",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Building Density",
      "equation": "Urban_Area / 1000",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Anthropogenic Heat",
      "equation": "Building_Density * 50 + Population_Density * 10",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v5",
      "name": "Population Density",
      "equation": "Urban_Area * 10",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "v6",
      "name": "Solar Absorption",
      "equation": "(1 - Albedo) * 200",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Albedo",
      "equation": "0.2 + Green_Space / Urban_Area * 0.1",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Evaporative Cooling",
      "equation": "Green_Space * 0.5",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "Radiative Loss",
      "equation": "(Urban_Temperature - Rural_Temperature) * 10",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "v10",
      "name": "Heat Capacity",
      "equation": "100",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "v11",
      "name": "Urban Growth Rate",
      "equation": "5",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v12",
      "name": "Conversion Rate",
      "equation": "0.02",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v13",
      "name": "Greening Investment",
      "equation": "2",
      "position": {
        "x": 450,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Urban Area",
      "to_element": "Anthropogenic Heat"
    },
    {
      "id": "c2",
      "from_element": "Green Space",
      "to_element": "Evaporative Cooling"
    },
    {
      "id": "c3",
      "from_element": "Urban Temperature",
      "to_element": "UHI Intensity"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T01:53:04.261381+00:00",
  "updated_at": "2026-01-12T01:53:04.261384+00:00",
  "source": "https://doi.org/10.1002/qj.49710845502",
  "reference": "Oke TR. The energetic basis of the urban heat island. Q J R Meteorol Soc. 1982;108(455):1-24."
}