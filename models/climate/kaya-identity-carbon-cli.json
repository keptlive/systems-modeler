{
  "id": "kaya-identity-carbon-cli",
  "name": "Kaya Identity Carbon Emissions Model",
  "description": "The Kaya Identity decomposes CO2 emissions into population, GDP per capita, energy intensity, and carbon intensity factors. Fundamental framework for analyzing emissions drivers and decarbonization pathways used by IPCC. Reference: IPCC (2021). Climate Change 2021: The Physical Science Basis. Cambridge University Press. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "stock-cumulative-emissions",
      "name": "Cumulative CO2 Emissions",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-annual-emissions",
      "name": "Annual CO2 Emissions",
      "equation": "Population * GDP_Per_Capita * Energy_Intensity * Carbon_Intensity",
      "from_stock": null,
      "to_stock": "stock-cumulative-emissions",
      "position": {
        "x": 350,
        "y": 450
      }
    }
  ],
  "variables": [
    {
      "id": "var-population",
      "name": "Population",
      "equation": "7.8 * EXP(Population_Growth_Rate * Time)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-population-growth",
      "name": "Population Growth Rate",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-gdp-per-capita",
      "name": "GDP Per Capita",
      "equation": "10000 * EXP(GDP_Growth_Rate * Time)",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-gdp-growth",
      "name": "GDP Growth Rate",
      "equation": "0.02",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-energy-intensity",
      "name": "Energy Intensity",
      "equation": "0.0001 * EXP(-Energy_Efficiency_Improvement * Time)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-energy-efficiency",
      "name": "Energy Efficiency Improvement",
      "equation": "0.015",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-carbon-intensity",
      "name": "Carbon Intensity",
      "equation": "0.5 * EXP(-Decarbonization_Rate * Time)",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-decarbonization",
      "name": "Decarbonization Rate",
      "equation": "0.02",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "var-total-gdp",
      "name": "Total GDP",
      "equation": "Population * GDP_Per_Capita",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "var-total-energy",
      "name": "Total Energy Use",
      "equation": "Total_GDP * Energy_Intensity",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "var-emissions-growth-rate",
      "name": "Net Emissions Growth Rate",
      "equation": "Population_Growth_Rate + GDP_Growth_Rate - Energy_Efficiency_Improvement - Decarbonization_Rate",
      "position": {
        "x": 500,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Population",
      "to_element": "Annual CO2 Emissions"
    },
    {
      "id": "conn-2",
      "from_element": "GDP Per Capita",
      "to_element": "Annual CO2 Emissions"
    },
    {
      "id": "conn-3",
      "from_element": "Energy Intensity",
      "to_element": "Annual CO2 Emissions"
    },
    {
      "id": "conn-4",
      "from_element": "Carbon Intensity",
      "to_element": "Annual CO2 Emissions"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 80,
    "dt": 1
  },
  "created_at": "2026-01-12T01:30:00.000Z",
  "updated_at": "2026-01-12T01:30:00.000Z",
  "source": "https://doi.org/10.1016/0301-4215(90)90148-W",
  "reference": "Kaya Y. Impact of Carbon Dioxide Emission Control on GNP Growth: Interpretation of Proposed Scenarios. IPCC Energy and Industry Subgroup, Response Strategies Working Group, 1990."
}