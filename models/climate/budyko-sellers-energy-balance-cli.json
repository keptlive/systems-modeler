{
  "id": "budyko-sellers-energy-balance-cli",
  "name": "Budyko-Sellers Energy Balance Climate Model",
  "description": "Zero-dimensional energy balance model with ice-albedo feedback. Source: Budyko (1969), Tellus; Sellers (1969), J Applied Meteorology. Reference: IPCC Climate Assessment Reports. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "s1",
      "name": "Global_Temperature",
      "initial_value": 288,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Ice_Coverage",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Temp_Change",
      "equation": "(Absorbed_Solar - Outgoing_IR) / C_heat",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Ice_Change",
      "equation": "IF(Global_Temperature < T_freeze, Ice_Growth_Rate * (1 - Ice_Coverage), -Ice_Melt_Rate * Ice_Coverage)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "S0",
      "equation": "1361",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "alpha_ice",
      "equation": "0.62",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "alpha_water",
      "equation": "0.3",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "A_IR",
      "equation": "203.3",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "B_IR",
      "equation": "2.09",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "C_heat",
      "equation": "5e8",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "T_freeze",
      "equation": "273",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Ice_Growth_Rate",
      "equation": "0.01",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Ice_Melt_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Planet_Albedo",
      "equation": "alpha_ice * Ice_Coverage + alpha_water * (1 - Ice_Coverage)",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v11",
      "name": "Absorbed_Solar",
      "equation": "S0 * (1 - Planet_Albedo) / 4",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "v12",
      "name": "Outgoing_IR",
      "equation": "A_IR + B_IR * (Global_Temperature - 273)",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Global_Temperature",
      "to_element": "Temp_Change"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 1000,
    "dt": 1
  },
  "created_at": "2026-01-15T14:38:02.261965+00:00",
  "updated_at": "2026-01-15T14:38:02.261969+00:00",
  "source": "https://doi.org/10.1111/j.2153-3490.1969.tb00466.x",
  "reference": "Budyko, M.I. (1969). The effect of solar radiation variations on the climate of the earth. Tellus 21:611-619."
}