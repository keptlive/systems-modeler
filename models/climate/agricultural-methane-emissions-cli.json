{
  "id": "agricultural-methane-emissions-cli",
  "name": "Agricultural Methane Emissions Model",
  "description": "Models methane emissions from livestock and rice cultivation. Source: Saunois et al. (2020), Earth System Science Data. DOI: 10.5194/essd-12-1561-2020",
  "stocks": [
    {
      "id": "stock-livestock",
      "name": "Livestock_Methane",
      "initial_value": 90,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-rice",
      "name": "Rice_Methane",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-atmch4",
      "name": "Atmospheric_Methane",
      "initial_value": 1900,
      "equation": "",
      "position": {
        "x": 350,
        "y": 175
      }
    }
  ],
  "flows": [
    {
      "id": "flow-livestock",
      "name": "Livestock_Emission",
      "equation": "Livestock_Population * Emission_Factor_Cattle * (1 - Mitigation_Adoption)",
      "from_stock": null,
      "to_stock": "stock-livestock",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-rice",
      "name": "Rice_Emission",
      "equation": "Rice_Area * Emission_Factor_Rice",
      "from_stock": null,
      "to_stock": "stock-rice",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "flow-toatm",
      "name": "To_Atmosphere",
      "equation": "Livestock_Methane + Rice_Methane",
      "from_stock": null,
      "to_stock": "stock-atmch4",
      "position": {
        "x": 250,
        "y": 175
      }
    },
    {
      "id": "flow-decay",
      "name": "Atmospheric_Decay",
      "equation": "Atmospheric_Methane / Methane_Lifetime",
      "from_stock": "stock-atmch4",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 175
      }
    }
  ],
  "variables": [
    {
      "id": "var-livepop",
      "name": "Livestock_Population",
      "equation": "1.5 * (1 + 0.01 * TIME)",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-efcattle",
      "name": "Emission_Factor_Cattle",
      "equation": "70",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-mitig",
      "name": "Mitigation_Adoption",
      "equation": "0.1 + 0.01 * TIME",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-ricearea",
      "name": "Rice_Area",
      "equation": "160",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-efrice",
      "name": "Emission_Factor_Rice",
      "equation": "0.2",
      "position": {
        "x": 250,
        "y": 325
      }
    },
    {
      "id": "var-lifetime",
      "name": "Methane_Lifetime",
      "equation": "12",
      "position": {
        "x": 450,
        "y": 275
      }
    },
    {
      "id": "var-gwp",
      "name": "CO2_Equivalent",
      "equation": "Atmospheric_Methane * 28",
      "position": {
        "x": 400,
        "y": 325
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Livestock_Methane",
      "to_element": "To_Atmosphere"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 1
  },
  "created_at": "2026-01-12T02:06:16.308020+00:00",
  "updated_at": "2026-01-12T02:06:16.308024+00:00",
  "source": "https://doi.org/10.5194/essd-12-1561-2020",
  "reference": "Saunois, M. et al. (2020). The Global Methane Budget 2000-2017. Earth System Science Data."
}