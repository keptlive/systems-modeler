{
  "id": "wildfire-suppression-paradox-cli",
  "name": "Wildfire Suppression Paradox Model",
  "description": "Model of how fire suppression leads to fuel accumulation and more severe fires later - the suppression paradox. Based on western US forest dynamics. Source: Stephens et al. (2014). Science. DOI: 10.1126/science.1248817",
  "stocks": [
    {"id": "stock-fuel", "name": "Forest_Fuel_Load", "initial_value": 50, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-burned", "name": "Area_Burned", "initial_value": 0, "equation": "", "position": {"x": 400, "y": 200}},
    {"id": "stock-suppression", "name": "Suppression_Capacity", "initial_value": 100, "equation": "", "position": {"x": 300, "y": 350}}
  ],
  "flows": [
    {"id": "flow-growth", "name": "Fuel_Accumulation", "equation": "Growth_Rate * (1 - Forest_Fuel_Load / Carrying_Capacity)", "from_stock": null, "to_stock": "stock-fuel", "position": {"x": 100, "y": 200}},
    {"id": "flow-burn", "name": "Fire_Consumption", "equation": "Ignition_Rate * Forest_Fuel_Load * Fire_Spread_Factor * (1 - Suppression_Effectiveness)", "from_stock": "stock-fuel", "to_stock": "stock-burned", "position": {"x": 300, "y": 200}},
    {"id": "flow-invest", "name": "Capacity_Investment", "equation": "IF(Area_Burned > Alarm_Threshold, Investment_Rate, -Depreciation_Rate * Suppression_Capacity)", "from_stock": null, "to_stock": "stock-suppression", "position": {"x": 200, "y": 350}}
  ],
  "variables": [
    {"id": "var-growth", "name": "Growth_Rate", "equation": "3", "position": {"x": 100, "y": 100}},
    {"id": "var-carrying", "name": "Carrying_Capacity", "equation": "200", "position": {"x": 200, "y": 100}},
    {"id": "var-ignition", "name": "Ignition_Rate", "equation": "0.01 * (1 + Climate_Factor)", "position": {"x": 350, "y": 100}},
    {"id": "var-climate", "name": "Climate_Factor", "equation": "0.02 * TIME", "position": {"x": 450, "y": 100}},
    {"id": "var-spread", "name": "Fire_Spread_Factor", "equation": "1 + Forest_Fuel_Load / 50", "position": {"x": 300, "y": 100}},
    {"id": "var-suppression-eff", "name": "Suppression_Effectiveness", "equation": "MIN(0.95, Suppression_Capacity / (100 + Forest_Fuel_Load))", "position": {"x": 400, "y": 350}},
    {"id": "var-alarm", "name": "Alarm_Threshold", "equation": "10", "position": {"x": 200, "y": 400}},
    {"id": "var-investment", "name": "Investment_Rate", "equation": "20", "position": {"x": 100, "y": 350}},
    {"id": "var-depreciation", "name": "Depreciation_Rate", "equation": "0.05", "position": {"x": 100, "y": 400}},
    {"id": "var-paradox", "name": "Paradox_Index", "equation": "Forest_Fuel_Load / 50 * (1 - Suppression_Effectiveness)", "position": {"x": 450, "y": 300}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 100, "dt": 0.5},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1126/science.1248817",
  "reference": "Stephens, S.L. et al. (2014). Temperate and boreal forest mega-fires: Characteristics and challenges. Frontiers in Ecology and the Environment, 12, 115-122."
}
