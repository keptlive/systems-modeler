{
  "id": "water-food-energy-nexus-cli",
  "name": "Water-Food-Energy Nexus Model",
  "description": "Model of interconnections between water, food, and energy systems showing trade-offs and synergies. Based on UN-Water nexus framework. Reference: IEA World Energy Outlook. Source: https://www.iea.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Water Availability",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Food Production",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Energy Production",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Water Recharge",
      "equation": "Precipitation - Evaporation",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Irrigation Use",
      "equation": "MIN(Water_Availability * 0.7, Food_Water_Demand)",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Energy Water Use",
      "equation": "MIN(Water_Availability * 0.2, Energy_Water_Demand)",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "f4",
      "name": "Crop Production",
      "equation": "Agricultural_Land * Yield_per_Hectare * Water_Sufficiency",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Food Consumption",
      "equation": "Food_Demand",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Power Generation",
      "equation": "Generation_Capacity * Water_Cooling_Availability",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "f7",
      "name": "Energy Demand",
      "equation": "Population * Per_Capita_Energy",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 700,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Precipitation",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Evaporation",
      "equation": "30",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "v3",
      "name": "Food Water Demand",
      "equation": "Food_Production * 2",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v4",
      "name": "Energy Water Demand",
      "equation": "Energy_Production * 1",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v5",
      "name": "Agricultural Land",
      "equation": "500",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Yield per Hectare",
      "equation": "2",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Water Sufficiency",
      "equation": "MIN(1, Irrigation_Use / Food_Water_Demand)",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "v8",
      "name": "Food Demand",
      "equation": "450",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Generation Capacity",
      "equation": "350",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v10",
      "name": "Water Cooling Availability",
      "equation": "MIN(1, Energy_Water_Use / Energy_Water_Demand)",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "v11",
      "name": "Population",
      "equation": "10",
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "id": "v12",
      "name": "Per Capita Energy",
      "equation": "30",
      "position": {
        "x": 700,
        "y": 150
      }
    },
    {
      "id": "v13",
      "name": "Nexus Stress Index",
      "equation": "(Food_Water_Demand + Energy_Water_Demand) / Water_Availability",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Water Availability",
      "to_element": "Irrigation Use"
    },
    {
      "id": "c2",
      "from_element": "Food Production",
      "to_element": "Food Water Demand"
    },
    {
      "id": "c3",
      "from_element": "Energy Production",
      "to_element": "Energy Water Demand"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T01:53:04.261403+00:00",
  "updated_at": "2026-01-12T01:53:04.261406+00:00",
  "source": "https://www.unwater.org/water-facts/water-food-and-energy/",
  "reference": "UN-Water. The United Nations World Water Development Report 2014: Water and Energy. UNESCO, 2014."
}