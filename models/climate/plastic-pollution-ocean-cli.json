{
  "id": "plastic-pollution-ocean-cli",
  "name": "Plastic Pollution Ocean Model",
  "description": "Models plastic pollution accumulation in oceans. Based on Jambeck et al. (2015) Science paper on ocean plastic. Reference: NOAA Ocean Climate. Source: https://www.climate.gov/news-features/understanding-climate/climate-change-ocean-heat-content",
  "stocks": [
    {
      "id": "stock-land-plastic",
      "name": "Land_Plastic_Waste",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "stock-coastal-plastic",
      "name": "Coastal_Plastic",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "stock-ocean-surface",
      "name": "Ocean_Surface_Plastic",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "stock-deep-ocean",
      "name": "Deep_Ocean_Plastic",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "stock-microplastics",
      "name": "Microplastics",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 650,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-plastic-production",
      "name": "Plastic_Production",
      "equation": "Production_Rate * (1 + Production_Growth)",
      "from_stock": null,
      "to_stock": "stock-land-plastic",
      "position": {
        "x": 75,
        "y": 150
      }
    },
    {
      "id": "flow-recycling",
      "name": "Recycling",
      "equation": "Land_Plastic_Waste * Recycling_Rate",
      "from_stock": "stock-land-plastic",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 80
      }
    },
    {
      "id": "flow-proper-disposal",
      "name": "Proper_Disposal",
      "equation": "Land_Plastic_Waste * Proper_Disposal_Rate",
      "from_stock": "stock-land-plastic",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 220
      }
    },
    {
      "id": "flow-leakage",
      "name": "Coastal_Leakage",
      "equation": "Land_Plastic_Waste * Leakage_Rate * Coastal_Population_Factor",
      "from_stock": "stock-land-plastic",
      "to_stock": "stock-coastal-plastic",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-ocean-entry",
      "name": "Ocean_Entry",
      "equation": "Coastal_Plastic * Ocean_Entry_Rate",
      "from_stock": "stock-coastal-plastic",
      "to_stock": "stock-ocean-surface",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "flow-sinking",
      "name": "Plastic_Sinking",
      "equation": "Ocean_Surface_Plastic * Sinking_Rate",
      "from_stock": "stock-ocean-surface",
      "to_stock": "stock-deep-ocean",
      "position": {
        "x": 500,
        "y": 225
      }
    },
    {
      "id": "flow-fragmentation",
      "name": "Fragmentation",
      "equation": "Ocean_Surface_Plastic * Fragmentation_Rate",
      "from_stock": "stock-ocean-surface",
      "to_stock": "stock-microplastics",
      "position": {
        "x": 600,
        "y": 225
      }
    }
  ],
  "variables": [
    {
      "id": "var-production-rate",
      "name": "Production_Rate",
      "equation": "400",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-production-growth",
      "name": "Production_Growth",
      "equation": "0.03",
      "position": {
        "x": 240,
        "y": 80
      }
    },
    {
      "id": "var-recycling-rate",
      "name": "Recycling_Rate",
      "equation": "0.09 + 0.005 * TIME",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-proper-disposal-rate",
      "name": "Proper_Disposal_Rate",
      "equation": "0.6",
      "position": {
        "x": 560,
        "y": 80
      }
    },
    {
      "id": "var-leakage-rate",
      "name": "Leakage_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-coastal-population-factor",
      "name": "Coastal_Population_Factor",
      "equation": "1.5",
      "position": {
        "x": 280,
        "y": 400
      }
    },
    {
      "id": "var-ocean-entry-rate",
      "name": "Ocean_Entry_Rate",
      "equation": "0.15",
      "position": {
        "x": 460,
        "y": 400
      }
    },
    {
      "id": "var-sinking-rate",
      "name": "Sinking_Rate",
      "equation": "0.05",
      "position": {
        "x": 620,
        "y": 400
      }
    },
    {
      "id": "var-fragmentation-rate",
      "name": "Fragmentation_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 440
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T01:22:14.816842+00:00",
  "updated_at": "2026-01-12T01:22:14.816853+00:00",
  "source": "https://doi.org/10.1126/science.1260352",
  "reference": "Jambeck JR, et al. Plastic waste inputs from land into the ocean. Science. 2015;347(6223):768-771."
}