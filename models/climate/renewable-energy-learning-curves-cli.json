{
  "id": "renewable-energy-learning-curves-cli",
  "name": "Renewable Energy Learning Curves Model",
  "description": "Models cost reduction through learning-by-doing in solar and wind. Source: Rubin et al. (2015), Energy Policy. DOI: 10.1016/j.enpol.2015.06.011",
  "stocks": [
    {
      "id": "stock-solarcap",
      "name": "Solar_Capacity",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-windcap",
      "name": "Wind_Capacity",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-solarcost",
      "name": "Solar_Cost",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "stock-windcost",
      "name": "Wind_Cost",
      "initial_value": 800,
      "equation": "",
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-solargrow",
      "name": "Solar_Growth",
      "equation": "Solar_Capacity * Solar_Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-solarcap",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-windgrow",
      "name": "Wind_Growth",
      "equation": "Wind_Capacity * Wind_Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-windcap",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "flow-solarlearn",
      "name": "Solar_Cost_Reduction",
      "equation": "-Solar_Cost * Learning_Rate_Solar * Solar_Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-solarcost",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "flow-windlearn",
      "name": "Wind_Cost_Reduction",
      "equation": "-Wind_Cost * Learning_Rate_Wind * Wind_Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-windcost",
      "position": {
        "x": 250,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-solargrow",
      "name": "Solar_Growth_Rate",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-windgrow",
      "name": "Wind_Growth_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 325
      }
    },
    {
      "id": "var-lrsolar",
      "name": "Learning_Rate_Solar",
      "equation": "0.2",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-lrwind",
      "name": "Learning_Rate_Wind",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 325
      }
    },
    {
      "id": "var-solarcompete",
      "name": "Solar_Competitive",
      "equation": "IF(Solar_Cost < 100, 1, 0)",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-windcompete",
      "name": "Wind_Competitive",
      "equation": "IF(Wind_Cost < 100, 1, 0)",
      "position": {
        "x": 450,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Solar_Capacity",
      "to_element": "Solar_Cost_Reduction"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:06:16.308037+00:00",
  "updated_at": "2026-01-12T02:06:16.308040+00:00",
  "source": "https://doi.org/10.1016/j.enpol.2015.06.011",
  "reference": "Rubin, E.S. et al. (2015). A review of learning rates for electricity supply technologies. Energy Policy."
}