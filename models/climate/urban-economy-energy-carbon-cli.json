{
  "id": "urban-economy-energy-carbon-cli",
  "name": "Urban Economy-Energy-Carbon System",
  "description": "System dynamics model for coordinated development of urban economy, energy consumption, and carbon emissions. Based on Chengdu-Chongqing economic circle using SD-NSGAIII optimization. Reference: IEA World Energy Outlook. Source: https://www.iea.org/",
  "stocks": [
    {
      "id": "stock-gdp",
      "name": "GDP",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-energy-consumption",
      "name": "Energy Consumption",
      "initial_value": 2000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-carbon-stock",
      "name": "Cumulative Carbon",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-tech-level",
      "name": "Technology Level",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-gdp-growth",
      "name": "GDP Growth",
      "equation": "GDP * Economic_Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-gdp",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-energy-increase",
      "name": "Energy Increase",
      "equation": "GDP * Energy_Intensity / Technology_Level",
      "from_stock": null,
      "to_stock": "stock-energy-consumption",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-carbon-emission",
      "name": "Carbon Emission",
      "equation": "Energy_Consumption * Carbon_Factor * (1 - Clean_Energy_Share)",
      "from_stock": null,
      "to_stock": "stock-carbon-stock",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-tech-progress",
      "name": "Tech Progress",
      "equation": "R_and_D_Investment * Tech_Efficiency",
      "from_stock": null,
      "to_stock": "stock-tech-level",
      "position": {
        "x": 250,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-growth-rate",
      "name": "Economic Growth Rate",
      "equation": "0.06",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-energy-int",
      "name": "Energy Intensity",
      "equation": "0.4 / Technology_Level",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-carbon-factor",
      "name": "Carbon Factor",
      "equation": "2.5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-clean-share",
      "name": "Clean Energy Share",
      "equation": "MIN(0.6, 0.1 + 0.02 * Time)",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-rd-invest",
      "name": "R and D Investment",
      "equation": "GDP * 0.02",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-tech-eff",
      "name": "Tech Efficiency",
      "equation": "0.001",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "var-annual-emission",
      "name": "Annual Emission",
      "equation": "Energy_Consumption * Carbon_Factor * (1 - Clean_Energy_Share)",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.25
  },
  "source": "https://doi.org/10.1016/j.apenergy.2024.123710",
  "reference": "System dynamics-multiple objective optimization model for coordinated development of urban economy-energy-carbon system. Applied Energy (2024).",
  "created_at": "2026-01-12T08:08:22.081275Z",
  "updated_at": "2026-01-12T08:08:22.081275Z"
}