{
  "id": "groundwater-depletion-model-cli",
  "name": "Groundwater Depletion Model",
  "description": "A model of groundwater aquifer dynamics including recharge, extraction, and depletion. Based on hydrogeological research on sustainable water management. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1038/nature12584",
  "reference": "Wada Y, et al. Global depletion of groundwater resources. Geophysical Research Letters. 2010;37(20):L20402.",
  "stocks": [
    {
      "id": "stock-aquifer",
      "name": "Aquifer Storage",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-recharge",
      "name": "Recharge",
      "equation": "Precipitation * Recharge_Fraction * Catchment_Area",
      "from_stock": null,
      "to_stock": "stock-aquifer",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-extraction",
      "name": "Extraction",
      "equation": "MIN(Pumping_Capacity * Demand_Factor, Aquifer_Storage * Max_Extraction_Fraction)",
      "from_stock": "stock-aquifer",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-baseflow",
      "name": "Natural Discharge",
      "equation": "Aquifer_Storage * Baseflow_Coefficient",
      "from_stock": "stock-aquifer",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-water-table",
      "name": "Water Table Depth",
      "equation": "Initial_Depth + (Initial_Storage - Aquifer_Storage) / Storage_Coefficient / Area",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-sustainability",
      "name": "Sustainability Index",
      "equation": "Recharge / (Extraction + Natural_Discharge)",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-precipitation",
      "name": "Precipitation",
      "equation": "800",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-recharge-frac",
      "name": "Recharge Fraction",
      "equation": "0.15",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-catchment",
      "name": "Catchment Area",
      "equation": "100",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-pumping",
      "name": "Pumping Capacity",
      "equation": "2000",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-demand",
      "name": "Demand Factor",
      "equation": "1 + 0.02 * TIME",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-max-extract",
      "name": "Max Extraction Fraction",
      "equation": "0.1",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "var-baseflow",
      "name": "Baseflow Coefficient",
      "equation": "0.01",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "var-storage-coef",
      "name": "Storage Coefficient",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-area",
      "name": "Area",
      "equation": "1000",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-init-depth",
      "name": "Initial Depth",
      "equation": "50",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-init-storage",
      "name": "Initial Storage",
      "equation": "10000",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
