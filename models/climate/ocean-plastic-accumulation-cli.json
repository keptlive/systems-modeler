{
  "id": "ocean-plastic-accumulation-cli",
  "name": "Ocean Plastic Accumulation Model",
  "description": "Model of plastic pollution in oceans showing accumulation in gyres, fragmentation to microplastics, and ecosystem effects. Reference: NOAA Ocean Climate. Source: https://www.climate.gov/news-features/understanding-climate/climate-change-ocean-heat-content",
  "stocks": [
    {
      "id": "stock-coastal",
      "name": "Coastal_Plastic",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-ocean",
      "name": "Ocean_Plastic",
      "initial_value": 150,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-micro",
      "name": "Microplastic",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-input",
      "name": "Plastic_Input",
      "equation": "Annual_Plastic_Production * Mismanaged_Fraction * Coastal_Leakage",
      "from_stock": null,
      "to_stock": "stock-coastal",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "flow-transport",
      "name": "Ocean_Transport",
      "equation": "Coastal_Plastic * Transport_Rate",
      "from_stock": "stock-coastal",
      "to_stock": "stock-ocean",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-fragment",
      "name": "Fragmentation",
      "equation": "Ocean_Plastic * Degradation_Rate",
      "from_stock": "stock-ocean",
      "to_stock": "stock-micro",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-cleanup",
      "name": "Cleanup_Efforts",
      "equation": "Ocean_Plastic * Cleanup_Rate",
      "from_stock": "stock-ocean",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-production",
      "name": "Annual_Plastic_Production",
      "equation": "400",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-mismanaged",
      "name": "Mismanaged_Fraction",
      "equation": "0.2",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "var-leakage",
      "name": "Coastal_Leakage",
      "equation": "0.02",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-transport",
      "name": "Transport_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-degradation",
      "name": "Degradation_Rate",
      "equation": "0.005",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-cleanup",
      "name": "Cleanup_Rate",
      "equation": "0.001",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Annual_Plastic_Production",
      "to_element": "Plastic_Input"
    },
    {
      "id": "c2",
      "from_element": "Mismanaged_Fraction",
      "to_element": "Plastic_Input"
    },
    {
      "id": "c3",
      "from_element": "Coastal_Leakage",
      "to_element": "Plastic_Input"
    },
    {
      "id": "c4",
      "from_element": "Coastal_Plastic",
      "to_element": "Ocean_Transport"
    },
    {
      "id": "c5",
      "from_element": "Transport_Rate",
      "to_element": "Ocean_Transport"
    },
    {
      "id": "c6",
      "from_element": "Ocean_Plastic",
      "to_element": "Fragmentation"
    },
    {
      "id": "c7",
      "from_element": "Degradation_Rate",
      "to_element": "Fragmentation"
    },
    {
      "id": "c8",
      "from_element": "Ocean_Plastic",
      "to_element": "Cleanup_Efforts"
    },
    {
      "id": "c9",
      "from_element": "Cleanup_Rate",
      "to_element": "Cleanup_Efforts"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-12T11:47:36.907817Z",
  "updated_at": "2026-01-12T11:47:36.907825Z",
  "source": "https://doi.org/10.1126/science.1260352",
  "reference": "Jambeck JR, et al. Plastic waste inputs from land into the ocean. Science. 2015;347(6223):768-771."
}