{
  "id": "circular-economy-plastics-cli",
  "name": "Circular Economy for Plastics Model",
  "description": "Model of plastic lifecycle including production, use, recycling, and pollution. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Virgin_Plastic_Stock",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "In_Use_Plastic",
      "initial_value": 3000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Waste_Plastic",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "s4",
      "name": "Recycled_Plastic",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Virgin_Production",
      "equation": "Production_Rate * (1 - Recycled_Content_Rate)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "f2",
      "name": "To_Use",
      "equation": "Virgin_Plastic_Stock / Stock_Turnover + Recycled_Plastic * Recycled_Use_Rate",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "To_Waste",
      "equation": "In_Use_Plastic / Product_Lifetime",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Recycling",
      "equation": "Waste_Plastic * Recycling_Rate / Recycling_Time",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 400,
        "y": 225
      }
    },
    {
      "id": "f5",
      "name": "Landfill",
      "equation": "Waste_Plastic * Landfill_Rate / Disposal_Time",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "f6",
      "name": "Ocean_Leakage",
      "equation": "Waste_Plastic * Leakage_Rate",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Production_Rate",
      "equation": "400",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Recycled_Content_Rate",
      "equation": "0.1",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Stock_Turnover",
      "equation": "2",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Product_Lifetime",
      "equation": "5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Recycling_Rate",
      "equation": "0.15",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "v6",
      "name": "Recycling_Time",
      "equation": "1",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "v7",
      "name": "Landfill_Rate",
      "equation": "0.7",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Disposal_Time",
      "equation": "1",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Leakage_Rate",
      "equation": "0.02",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v10",
      "name": "Recycled_Use_Rate",
      "equation": "0.8",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "v11",
      "name": "Circularity_Index",
      "equation": "Recycled_Plastic / (In_Use_Plastic + 0.01)",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5,
    "integration_method": "euler"
  },
