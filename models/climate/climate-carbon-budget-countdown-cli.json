{
  "id": "climate-carbon-budget-countdown-cli",
  "name": "Global Carbon Budget Countdown",
  "description": "Model tracking the remaining carbon budget for 1.5\u00b0C and 2\u00b0C temperature targets, showing how current emission rates deplete the remaining budget. Based on IPCC AR6 carbon budget estimates. Reference: IPCC (2021). Climate Change 2021: The Physical Science Basis. Cambridge University Press. Source: https://www.ipcc.ch/",
  "source": "https://doi.org/10.1017/9781009157896",
  "reference": "IPCC. Climate Change 2021: The Physical Science Basis. Cambridge University Press. 2021.",
  "stocks": [
    {
      "id": "stock-budget",
      "name": "Remaining_Carbon_Budget",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-cumulative",
      "name": "Cumulative_Emissions",
      "initial_value": 2500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "stock-temp",
      "name": "Temperature_Anomaly",
      "initial_value": 1.1,
      "equation": "",
      "position": {
        "x": 500,
        "y": 275
      }
    }
  ],
  "flows": [
    {
      "id": "flow-emit",
      "name": "Annual_Emissions",
      "equation": "current_emissions * (1 - reduction_rate)^(TIME/10)",
      "from_stock": "stock-budget",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-accumulate",
      "name": "Emission_Accumulation",
      "equation": "current_emissions * (1 - reduction_rate)^(TIME/10)",
      "from_stock": null,
      "to_stock": "stock-cumulative",
      "position": {
        "x": 300,
        "y": 450
      }
    },
    {
      "id": "flow-warm",
      "name": "Warming",
      "equation": "TCRE * current_emissions * (1 - reduction_rate)^(TIME/10) / 1000",
      "from_stock": null,
      "to_stock": "stock-temp",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-emit",
      "name": "current_emissions",
      "equation": "40",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-reduce",
      "name": "reduction_rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-tcre",
      "name": "TCRE",
      "equation": "0.45",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "var-years",
      "name": "Years_Remaining",
      "equation": "max(0, Remaining_Carbon_Budget / (current_emissions * (1 - reduction_rate)^(TIME/10)))",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-target",
      "name": "Temperature_Target",
      "equation": "1.5",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "var-gap",
      "name": "Temperature_Gap",
      "equation": "Temperature_Target - Temperature_Anomaly",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 80,
    "dt": 1,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T12:00:00.000000+00:00",
  "updated_at": "2026-01-12T12:00:00.000000+00:00"
}