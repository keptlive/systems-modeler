{
  "id": "climate-permafrost-carbon-feedback-cli",
  "name": "Permafrost Carbon Feedback Loop",
  "description": "Models the positive feedback loop where warming temperatures thaw permafrost, releasing stored carbon, which causes more warming. Based on Schuur et al. (2015) Nature paper on permafrost carbon. DOI: 10.1038/nature14338",
  "category": "climate",
  "stocks": [
    {
      "id": "stock-atm-co2",
      "name": "Atmospheric_CO2",
      "initial_value": 410,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-permafrost-c",
      "name": "Permafrost_Carbon",
      "initial_value": 1500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-active-layer-c",
      "name": "Active_Layer_Carbon",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-temp-anom",
      "name": "Temperature_Anomaly",
      "initial_value": 1.1,
      "equation": "",
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-thaw",
      "name": "Permafrost_Thaw",
      "equation": "Permafrost_Carbon * Thaw_Rate * MAX(0, Temperature_Anomaly - Thaw_Threshold)",
      "from_stock": "stock-permafrost-c",
      "to_stock": "stock-active-layer-c",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-emission",
      "name": "Carbon_Emission",
      "equation": "Active_Layer_Carbon * Decomposition_Rate",
      "from_stock": "stock-active-layer-c",
      "to_stock": "stock-atm-co2",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "flow-warming",
      "name": "Radiative_Warming",
      "equation": "Climate_Sensitivity * LOG(Atmospheric_CO2 / 280) / LOG(2)",
      "from_stock": null,
      "to_stock": "stock-temp-anom",
      "position": {
        "x": 100,
        "y": 275
      }
    }
  ],
  "variables": [
    {
      "id": "var-thaw-rate",
      "name": "Thaw_Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-thaw-threshold",
      "name": "Thaw_Threshold",
      "equation": "1.5",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-decomp-rate",
      "name": "Decomposition_Rate",
      "equation": "0.03",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-climate-sens",
      "name": "Climate_Sensitivity",
      "equation": "3.0",
      "position": {
        "x": 100,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/nature14338",
  "reference": "Schuur EAG et al. (2015) Climate change and the permafrost carbon feedback. Nature.",
  "connectors": [],
  "created_at": "2026-01-12T06:07:51.751623Z",
  "updated_at": "2026-01-12T06:07:51.751623Z"
}