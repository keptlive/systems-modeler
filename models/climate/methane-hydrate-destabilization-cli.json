{
  "id": "methane-hydrate-destabilization-cli",
  "name": "Methane Hydrate Destabilization Model",
  "description": "Model of methane clathrate destabilization from ocean warming. Vast methane stores on continental shelves could release with warming, triggering rapid climate change. Source: Archer (2007). Biogeosciences. DOI: 10.5194/bg-4-521-2007",
  "stocks": [
    {"id": "stock-hydrate", "name": "Methane_Hydrate_Store", "initial_value": 10000, "equation": "", "position": {"x": 150, "y": 200}},
    {"id": "stock-dissolved", "name": "Dissolved_Methane", "initial_value": 10, "equation": "", "position": {"x": 350, "y": 200}},
    {"id": "stock-atm-ch4", "name": "Atmospheric_Methane", "initial_value": 1900, "equation": "", "position": {"x": 550, "y": 200}}
  ],
  "flows": [
    {"id": "flow-dissociation", "name": "Hydrate_Dissociation", "equation": "Methane_Hydrate_Store * Dissociation_Rate * Temperature_Forcing", "from_stock": "stock-hydrate", "to_stock": "stock-dissolved", "position": {"x": 250, "y": 200}},
    {"id": "flow-release", "name": "Methane_Release", "equation": "Dissolved_Methane * Bubble_Fraction * Escape_Rate", "from_stock": "stock-dissolved", "to_stock": "stock-atm-ch4", "position": {"x": 450, "y": 200}},
    {"id": "flow-oxidation", "name": "Methane_Oxidation", "equation": "Atmospheric_Methane * Oxidation_Rate", "from_stock": "stock-atm-ch4", "to_stock": null, "position": {"x": 550, "y": 100}},
    {"id": "flow-dissolved-ox", "name": "Dissolved_Oxidation", "equation": "Dissolved_Methane * (1 - Bubble_Fraction) * Microbial_Oxidation", "from_stock": "stock-dissolved", "to_stock": null, "position": {"x": 350, "y": 100}}
  ],
  "variables": [
    {"id": "var-dissoc-rate", "name": "Dissociation_Rate", "equation": "0.0001", "position": {"x": 200, "y": 100}},
    {"id": "var-temp-forcing", "name": "Temperature_Forcing", "equation": "1 + 0.5 * MAX(0, Bottom_Water_Warming - Stability_Threshold)", "position": {"x": 150, "y": 300}},
    {"id": "var-bottom-warm", "name": "Bottom_Water_Warming", "equation": "0.5 + 0.03 * TIME", "position": {"x": 100, "y": 350}},
    {"id": "var-stability", "name": "Stability_Threshold", "equation": "1.0", "position": {"x": 250, "y": 350}},
    {"id": "var-bubble", "name": "Bubble_Fraction", "equation": "0.1", "position": {"x": 400, "y": 100}},
    {"id": "var-escape", "name": "Escape_Rate", "equation": "0.5", "position": {"x": 450, "y": 300}},
    {"id": "var-oxidation", "name": "Oxidation_Rate", "equation": "0.08", "position": {"x": 500, "y": 100}},
    {"id": "var-microbial", "name": "Microbial_Oxidation", "equation": "0.3", "position": {"x": 300, "y": 100}},
    {"id": "var-radiative", "name": "Radiative_Forcing", "equation": "(Atmospheric_Methane - 1750) * 0.00036", "position": {"x": 550, "y": 350}},
    {"id": "var-tipping", "name": "Runaway_Risk", "equation": "IF(Bottom_Water_Warming > 2, 1, 0)", "position": {"x": 200, "y": 400}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 200, "dt": 1},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.5194/bg-4-521-2007",
  "reference": "Archer, D. (2007). Methane hydrate stability and anthropogenic climate change. Biogeosciences, 4, 521-544."
}
