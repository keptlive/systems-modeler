{
  "id": "carbon-emissions-driven-climate-cli",
  "name": "Carbon Emissions-Driven Climate Model",
  "description": "Simplified representation of carbon-emissions-driven climate projections for CMIP7. Addresses carbon cycle uncertainty as dominant source of uncertainty in meeting Paris Agreement goals. Reference: IPCC Climate Assessment Reports. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "stock-atm-co2",
      "name": "Atmospheric CO2",
      "initial_value": 420,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-ocean-carbon",
      "name": "Ocean Carbon",
      "initial_value": 38000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "stock-land-carbon",
      "name": "Land Carbon",
      "initial_value": 2500,
      "equation": "",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "stock-temperature-anomaly",
      "name": "Temperature Anomaly",
      "initial_value": 1.2,
      "equation": "",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "flows": [
    {
      "id": "flow-emissions",
      "name": "Anthropogenic Emissions",
      "equation": "Emission_Scenario",
      "from_stock": null,
      "to_stock": "stock-atm-co2",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-ocean-uptake",
      "name": "Ocean CO2 Uptake",
      "equation": "Ocean_Sink_Rate * (Atmospheric_CO2 - CO2_Preindustrial) / 280",
      "from_stock": "stock-atm-co2",
      "to_stock": "stock-ocean-carbon",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "flow-land-uptake",
      "name": "Land CO2 Uptake",
      "equation": "Land_Sink_Rate * (1 + CO2_Fertilization * (Atmospheric_CO2 / 280 - 1))",
      "from_stock": "stock-atm-co2",
      "to_stock": "stock-land-carbon",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "flow-warming",
      "name": "Warming Rate",
      "equation": "(Equilibrium_Temp - Temperature_Anomaly) / Climate_Response_Time",
      "from_stock": null,
      "to_stock": "stock-temperature-anomaly",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-emission-scenario",
      "name": "Emission Scenario",
      "equation": "10 * EXP(-0.03 * Time)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-ocean-sink",
      "name": "Ocean Sink Rate",
      "equation": "2.5",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-land-sink",
      "name": "Land Sink Rate",
      "equation": "1.5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-co2-fert",
      "name": "CO2 Fertilization",
      "equation": "0.6",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-preindustrial",
      "name": "CO2 Preindustrial",
      "equation": "280",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-climate-sens",
      "name": "Climate Sensitivity",
      "equation": "3",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-eq-temp",
      "name": "Equilibrium Temp",
      "equation": "Climate_Sensitivity * LN(Atmospheric_CO2 / CO2_Preindustrial) / LN(2)",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-response-time",
      "name": "Climate Response Time",
      "equation": "30",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "source": "https://doi.org/10.5194/gmd-17-8141-2024",
  "reference": "Sanderson et al. The need for carbon-emissions-driven climate projections in CMIP7. Geoscientific Model Development (2024).",
  "created_at": "2026-01-12T08:08:22.081275Z",
  "updated_at": "2026-01-12T08:08:22.081275Z"
}