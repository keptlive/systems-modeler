{
  "id": "ocean-heat-content-dynamics-cli",
  "name": "Ocean Heat Content Dynamics Model",
  "description": "Three-layer ocean heat-content model rebuilt from the deterministic FaIR2.1.0 energy-balance operator and its documented HadGEM2-ES/Cummins2020 calibration: capacities3.62,9.47,98.66 W year/m2/K; feedback/exchange0.54,2.39,0.63 W/m2/K; deep efficacy1.59. Existing linear forcing scenario0.93*(0.5+0.01*t) is retained as an illustrative experiment, not historical observations. Layer heat contents are anomalies; Sea_Surface_Temperature exactly tracks surface heat/capacity. The efficacy feedback is an explicit external energy flux. Legacy Equilibrium_Temp and Thermal_Lag controls remain visible but are not parameters of the restored operator. IDs, geometry and100-year horizon remain.",
  "stocks": [
    {
      "id": "stock-surface-heat",
      "name": "Surface_Layer_Heat",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      },
      "units": "W year/m2"
    },
    {
      "id": "stock-intermediate-heat",
      "name": "Intermediate_Layer_Heat",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      },
      "units": "W year/m2"
    },
    {
      "id": "stock-deep-heat",
      "name": "Deep_Ocean_Heat",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 600,
        "y": 150
      },
      "units": "W year/m2"
    },
    {
      "id": "stock-surface-temp",
      "name": "Sea_Surface_Temperature",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      },
      "units": "K anomaly"
    }
  ],
  "flows": [
    {
      "id": "flow-radiative-forcing",
      "name": "Radiative_Forcing_Uptake",
      "equation": "Radiative_Imbalance * Ocean_Fraction",
      "from_stock": null,
      "to_stock": "stock-surface-heat",
      "position": {
        "x": 100,
        "y": 150
      },
      "units": "W/m2"
    },
    {
      "id": "flow-surface-to-intermediate",
      "name": "Surface_Intermediate_Transfer",
      "equation": "Mixing_Rate_1 * (Surface_Layer_Heat / Heat_Capacity_1 - Intermediate_Layer_Heat / Heat_Capacity_2)",
      "from_stock": "stock-surface-heat",
      "to_stock": "stock-intermediate-heat",
      "position": {
        "x": 300,
        "y": 150
      },
      "units": "W/m2"
    },
    {
      "id": "flow-intermediate-to-deep",
      "name": "Intermediate_Deep_Transfer",
      "equation": "Mixing_Rate_2 * (Intermediate_Layer_Heat / Heat_Capacity_2 - Deep_Ocean_Heat / Deep_Heat_Capacity)",
      "from_stock": "stock-intermediate-heat",
      "to_stock": "stock-deep-heat",
      "position": {
        "x": 500,
        "y": 150
      },
      "units": "W/m2"
    },
    {
      "id": "flow-heat-release",
      "name": "Ocean_Heat_Release",
      "equation": "Heat_Release_Rate * Surface_Layer_Heat / Heat_Capacity_1",
      "from_stock": "stock-surface-heat",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 220
      },
      "units": "W/m2"
    },
    {
      "id": "flow-sst-change",
      "name": "SST_Change",
      "equation": "(Radiative_Forcing_Uptake - Surface_Intermediate_Transfer - Ocean_Heat_Release) / Heat_Capacity_1",
      "from_stock": null,
      "to_stock": "stock-surface-temp",
      "position": {
        "x": 200,
        "y": 250
      },
      "units": "K/year"
    },
    {
      "id": "v19-efficacy-feedback",
      "name": "Efficacy Feedback",
      "position": {
        "x": 900,
        "y": 600
      },
      "equation": "(Deep_Ocean_Efficacy - 1) * Intermediate_Deep_Transfer",
      "from_stock": "stock-intermediate-heat",
      "to_stock": null,
      "units": "W/m2"
    }
  ],
  "variables": [
    {
      "id": "var-radiative-imbalance",
      "name": "Radiative_Imbalance",
      "equation": "0.5 + 0.01 * TIME",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-ocean-fraction",
      "name": "Ocean_Fraction",
      "equation": "0.93",
      "position": {
        "x": 220,
        "y": 80
      }
    },
    {
      "id": "var-mixing-rate-1",
      "name": "Mixing_Rate_1",
      "equation": "2.39",
      "position": {
        "x": 340,
        "y": 80
      },
      "units": "W/m2/K"
    },
    {
      "id": "var-mixing-rate-2",
      "name": "Mixing_Rate_2",
      "equation": "0.63",
      "position": {
        "x": 460,
        "y": 80
      },
      "units": "W/m2/K"
    },
    {
      "id": "var-heat-capacity-1",
      "name": "Heat_Capacity_1",
      "equation": "3.62",
      "position": {
        "x": 580,
        "y": 80
      },
      "units": "W year/m2/K"
    },
    {
      "id": "var-heat-capacity-2",
      "name": "Heat_Capacity_2",
      "equation": "9.47",
      "position": {
        "x": 100,
        "y": 380
      },
      "units": "W year/m2/K"
    },
    {
      "id": "var-heat-release-rate",
      "name": "Heat_Release_Rate",
      "equation": "0.54",
      "position": {
        "x": 220,
        "y": 380
      },
      "units": "W/m2/K"
    },
    {
      "id": "var-equilibrium-temp",
      "name": "Equilibrium_Temp",
      "equation": "0",
      "position": {
        "x": 340,
        "y": 380
      }
    },
    {
      "id": "var-thermal-lag",
      "name": "Thermal_Lag",
      "equation": "5",
      "position": {
        "x": 460,
        "y": 380
      }
    },
    {
      "id": "v19-deep-capacity",
      "name": "Deep Heat Capacity",
      "position": {
        "x": 420,
