{
  "id": "ocean-heat-content-dynamics-cli",
  "name": "Ocean Heat Content Dynamics Model",
  "description": "Models ocean heat uptake across different depth layers. Based on Cheng et al. (2019) analysis of ocean warming acceleration. Reference: NOAA Ocean Climate. Source: https://www.climate.gov/news-features/understanding-climate/climate-change-ocean-heat-content",
  "stocks": [
    {
      "id": "stock-surface-heat",
      "name": "Surface_Layer_Heat",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-intermediate-heat",
      "name": "Intermediate_Layer_Heat",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-deep-heat",
      "name": "Deep_Ocean_Heat",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "stock-surface-temp",
      "name": "Sea_Surface_Temperature",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-radiative-forcing",
      "name": "Radiative_Forcing_Uptake",
      "equation": "Radiative_Imbalance * Ocean_Fraction",
      "from_stock": null,
      "to_stock": "stock-surface-heat",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-surface-to-intermediate",
      "name": "Surface_Intermediate_Transfer",
      "equation": "Surface_Layer_Heat * Mixing_Rate_1 * (1 - Surface_Layer_Heat / Heat_Capacity_1)",
      "from_stock": "stock-surface-heat",
      "to_stock": "stock-intermediate-heat",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-intermediate-to-deep",
      "name": "Intermediate_Deep_Transfer",
      "equation": "Intermediate_Layer_Heat * Mixing_Rate_2 * (1 - Intermediate_Layer_Heat / Heat_Capacity_2)",
      "from_stock": "stock-intermediate-heat",
      "to_stock": "stock-deep-heat",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "flow-heat-release",
      "name": "Ocean_Heat_Release",
      "equation": "Surface_Layer_Heat * Heat_Release_Rate * (Sea_Surface_Temperature - Equilibrium_Temp)",
      "from_stock": "stock-surface-heat",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 220
      }
    },
    {
      "id": "flow-sst-change",
      "name": "SST_Change",
      "equation": "(Surface_Layer_Heat / Heat_Capacity_1 - Sea_Surface_Temperature) / Thermal_Lag",
      "from_stock": null,
      "to_stock": "stock-surface-temp",
      "position": {
        "x": 200,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-radiative-imbalance",
      "name": "Radiative_Imbalance",
      "equation": "0.5 + 0.01 * TIME",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-ocean-fraction",
      "name": "Ocean_Fraction",
      "equation": "0.93",
      "position": {
        "x": 220,
        "y": 80
      }
    },
    {
      "id": "var-mixing-rate-1",
      "name": "Mixing_Rate_1",
      "equation": "0.05",
      "position": {
        "x": 340,
        "y": 80
      }
    },
    {
      "id": "var-mixing-rate-2",
      "name": "Mixing_Rate_2",
      "equation": "0.01",
      "position": {
        "x": 460,
        "y": 80
      }
    },
    {
      "id": "var-heat-capacity-1",
      "name": "Heat_Capacity_1",
      "equation": "100",
      "position": {
        "x": 580,
        "y": 80
      }
    },
    {
      "id": "var-heat-capacity-2",
      "name": "Heat_Capacity_2",
      "equation": "500",
      "position": {
        "x": 100,
        "y": 380
      }
    },
    {
      "id": "var-heat-release-rate",
      "name": "Heat_Release_Rate",
      "equation": "0.02",
      "position": {
        "x": 220,
        "y": 380
      }
    },
    {
      "id": "var-equilibrium-temp",
      "name": "Equilibrium_Temp",
      "equation": "15",
      "position": {
        "x": 340,
        "y": 380
      }
    },
    {
      "id": "var-thermal-lag",
      "name": "Thermal_Lag",
      "equation": "5",
      "position": {
        "x": 460,
        "y": 380
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T01:15:55.417201+00:00",
  "updated_at": "2026-01-12T01:15:55.417242+00:00",
  "source": "https://doi.org/10.1126/science.aav7619",
  "reference": "Cheng L, et al. How fast are the oceans warming? Science. 2019;363(6423):128-129."
}