{
  "id": "climate-tipping-cascade-interactions-cli",
  "name": "Climate Tipping Points Cascade Interactions",
  "description": "Model of interactions between major climate tipping elements including ice sheets, permafrost, AMOC, and Amazon. Based on Lenton et al. Nature 2019. Reference: IPCC Climate Assessment Reports. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "s1",
      "name": "Greenland Ice Mass",
      "initial_value": 2900,
      "equation": "",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "s2",
      "name": "Antarctic Ice Mass",
      "initial_value": 26500,
      "equation": "",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "s3",
      "name": "Permafrost Carbon",
      "initial_value": 1500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "s4",
      "name": "Amazon Forest Cover",
      "initial_value": 0.85,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "s5",
      "name": "AMOC Strength",
      "initial_value": 18,
      "equation": "",
      "position": {
        "x": 500,
        "y": 175
      }
    },
    {
      "id": "s6",
      "name": "Global Temperature Anomaly",
      "initial_value": 1.2,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Greenland Melt",
      "equation": "Greenland_Ice_Mass * Melt_Rate_GIS * (1 + Temperature_Sensitivity * Global_Temperature_Anomaly)",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "f2",
      "name": "Antarctic Melt",
      "equation": "Antarctic_Ice_Mass * Melt_Rate_AIS * (1 + AMOC_Feedback * (18 - AMOC_Strength) / 18)",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "f3",
      "name": "Permafrost Release",
      "equation": "Permafrost_Carbon * Thaw_Rate * Global_Temperature_Anomaly / 2",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "f4",
      "name": "Amazon Dieback",
      "equation": "Amazon_Forest_Cover * Dieback_Rate * (1 + Drought_Stress)",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "f5",
      "name": "AMOC Weakening",
      "equation": "AMOC_Strength * Freshwater_Effect * (2900 - Greenland_Ice_Mass) / 1000",
      "from_stock": "s5",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 175
      }
    },
    {
      "id": "f6",
      "name": "Warming Rate",
      "equation": "CO2_Forcing + Permafrost_Feedback + Albedo_Feedback",
      "from_stock": null,
      "to_stock": "s6",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Melt Rate GIS",
      "equation": "0.002",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Melt Rate AIS",
      "equation": "0.0005",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "v3",
      "name": "Temperature Sensitivity",
      "equation": "0.5",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Thaw Rate",
      "equation": "0.005",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Dieback Rate",
      "equation": "0.002",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "v6",
      "name": "Drought Stress",
      "equation": "(1.5 - Amazon_Forest_Cover) * Global_Temperature_Anomaly / 2",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "v7",
      "name": "Freshwater Effect",
      "equation": "0.0001",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "CO2 Forcing",
      "equation": "0.02",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "v9",
      "name": "Permafrost Feedback",
      "equation": "(1500 - Permafrost_Carbon) * 0.0001",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "v10",
      "name": "Albedo Feedback",
      "equation": "((2900 - Greenland_Ice_Mass) / 2900) * 0.01",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "v11",
      "name": "AMOC Feedback",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Global Temperature Anomaly",
      "to_element": "Greenland Melt"
    },
    {
      "id": "c2",
      "from_element": "Greenland Ice Mass",
      "to_element": "AMOC Weakening"
    },
    {
      "id": "c3",
      "from_element": "Permafrost Carbon",
      "to_element": "Permafrost Feedback"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 1
  },
  "created_at": "2026-01-15T14:14:19.553126",
  "updated_at": "2026-01-15T14:14:19.553134",
  "source": "https://doi.org/10.1038/d41586-019-03595-0",
  "reference": "Lenton TM, et al. Climate tipping points - too risky to bet against. Nature. 2019;575:592-595."
}