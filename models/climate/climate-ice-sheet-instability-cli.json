{
  "id": "climate-ice-sheet-instability-cli",
  "name": "Marine Ice Sheet Instability",
  "description": "Models the potential instability of marine-based ice sheets like West Antarctica, where retreat can become self-sustaining. Based on DeConto & Pollard (2016) Nature paper. DOI: 10.1038/nature17145",
  "category": "climate",
  "stocks": [
    {
      "id": "stock-ice-vol",
      "name": "Ice_Volume",
      "initial_value": 25.4,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-sea-level",
      "name": "Sea_Level_Rise",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-grounding-line",
      "name": "Grounding_Line_Position",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-calving",
      "name": "Ice_Calving",
      "equation": "Ice_Volume * Calving_Rate * Cliff_Collapse_Factor",
      "from_stock": "stock-ice-vol",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-melt",
      "name": "Basal_Melt",
      "equation": "Ice_Volume * Ocean_Temp_Anom * Melt_Sensitivity",
      "from_stock": "stock-ice-vol",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-slr",
      "name": "Sea_Level_Contribution",
      "equation": "(Ice_Calving + Basal_Melt) / Ice_to_SLR_Factor",
      "from_stock": null,
      "to_stock": "stock-sea-level",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-retreat",
      "name": "Grounding_Line_Retreat",
      "equation": "Retreat_Rate * (1 + MISI_Amplification * MAX(0, Grounding_Line_Position - Critical_Position))",
      "from_stock": "stock-grounding-line",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-calving-rate",
      "name": "Calving_Rate",
      "equation": "0.001",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-cliff-factor",
      "name": "Cliff_Collapse_Factor",
      "equation": "1.5",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-ocean-temp",
      "name": "Ocean_Temp_Anom",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-melt-sens",
      "name": "Melt_Sensitivity",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-ice-slr",
      "name": "Ice_to_SLR_Factor",
      "equation": "362",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-retreat-rate",
      "name": "Retreat_Rate",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 450
      }
    },
    {
      "id": "var-misi",
      "name": "MISI_Amplification",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "var-critical",
      "name": "Critical_Position",
      "equation": "50",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2200,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/nature17145",
  "reference": "DeConto RM & Pollard D (2016) Contribution of Antarctica to past and future sea-level rise. Nature.",
  "connectors": [],
  "created_at": "2026-01-12T06:07:51.752084Z",
  "updated_at": "2026-01-12T06:07:51.752084Z"
}