{
  "id": "coral-reef-bleaching-thermal-cli",
  "name": "Coral Reef Thermal Bleaching Model",
  "description": "Model of coral bleaching under thermal stress. When sea surface temperature exceeds threshold, corals expel symbiotic zooxanthellae. Degree Heating Weeks (DHW) predicts bleaching severity. Source: Hughes et al. (2017). Nature. DOI: 10.1038/nature21707",
  "stocks": [
    {"id": "stock-healthy", "name": "Healthy_Coral_Cover", "initial_value": 80, "equation": "", "position": {"x": 150, "y": 200}},
    {"id": "stock-bleached", "name": "Bleached_Coral", "initial_value": 0, "equation": "", "position": {"x": 350, "y": 200}},
    {"id": "stock-dead", "name": "Dead_Coral", "initial_value": 10, "equation": "", "position": {"x": 550, "y": 200}},
    {"id": "stock-dhw", "name": "Degree_Heating_Weeks", "initial_value": 0, "equation": "", "position": {"x": 350, "y": 350}}
  ],
  "flows": [
    {"id": "flow-bleaching", "name": "Bleaching_Rate", "equation": "Healthy_Coral_Cover * Bleaching_Probability", "from_stock": "stock-healthy", "to_stock": "stock-bleached", "position": {"x": 250, "y": 200}},
    {"id": "flow-mortality", "name": "Mortality_Rate", "equation": "Bleached_Coral * Mortality_Probability", "from_stock": "stock-bleached", "to_stock": "stock-dead", "position": {"x": 450, "y": 200}},
    {"id": "flow-recovery", "name": "Recovery_Rate", "equation": "Bleached_Coral * Recovery_Probability * (1 - Ongoing_Stress)", "from_stock": "stock-bleached", "to_stock": "stock-healthy", "position": {"x": 250, "y": 150}},
    {"id": "flow-dhw-accumulation", "name": "DHW_Accumulation", "equation": "MAX(0, Current_SST - Bleaching_Threshold)", "from_stock": null, "to_stock": "stock-dhw", "position": {"x": 250, "y": 350}},
    {"id": "flow-dhw-decay", "name": "DHW_Decay", "equation": "Degree_Heating_Weeks / 12", "from_stock": "stock-dhw", "to_stock": null, "position": {"x": 450, "y": 350}}
  ],
  "variables": [
    {"id": "var-sst", "name": "Current_SST", "equation": "27 + 2 * SIN(TIME * 6.28 / 52) + 0.02 * TIME", "position": {"x": 150, "y": 100}},
    {"id": "var-threshold", "name": "Bleaching_Threshold", "equation": "29", "position": {"x": 300, "y": 100}},
    {"id": "var-stress", "name": "Thermal_Stress", "equation": "MAX(0, Current_SST - Bleaching_Threshold)", "position": {"x": 450, "y": 100}},
    {"id": "var-bleach-prob", "name": "Bleaching_Probability", "equation": "MIN(1, 0.1 * Degree_Heating_Weeks / 4)", "position": {"x": 200, "y": 300}},
    {"id": "var-mort-prob", "name": "Mortality_Probability", "equation": "IF(Degree_Heating_Weeks > 8, 0.5, IF(Degree_Heating_Weeks > 4, 0.2, 0.05))", "position": {"x": 450, "y": 300}},
    {"id": "var-recov-prob", "name": "Recovery_Probability", "equation": "0.05", "position": {"x": 150, "y": 350}},
    {"id": "var-ongoing", "name": "Ongoing_Stress", "equation": "IF(Thermal_Stress > 0, 1, 0)", "position": {"x": 300, "y": 400}},
    {"id": "var-reef-health", "name": "Reef_Health_Index", "equation": "Healthy_Coral_Cover / (Healthy_Coral_Cover + Bleached_Coral + Dead_Coral)", "position": {"x": 550, "y": 100}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 520, "dt": 1},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1038/nature21707",
  "reference": "Hughes, T.P. et al. (2017). Global warming and recurrent mass bleaching of corals. Nature, 543, 373-377."
}
