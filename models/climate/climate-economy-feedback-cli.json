{
  "id": "climate-economy-feedback-cli",
  "name": "Climate-Economy Feedback Model",
  "description": "A system dynamics model of climate-economy interactions based on extensions to Nordhaus DICE model. Models the feedback between economic production, CO2 emissions, temperature change, and climate damages affecting economic output. Reference: Nordhaus, W. D. (2008). A question of balance. Yale University Press. DOI: https://doi.org/10.1093/reep/ren023",
  "stocks": [
    {
      "id": "stock-capital",
      "name": "Capital Stock",
      "initial_value": 223,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "stock-atmospheric-co2",
      "name": "Atmospheric CO2",
