      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-upper-ocean-co2",
      "name": "Upper Ocean CO2",
      "initial_value": 460,
      "equation": "",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "stock-deep-ocean-co2",
      "name": "Deep Ocean CO2",
      "initial_value": 1740,
      "equation": "",
      "position": {
        "x": 400,
        "y": 450
      }
    },
    {
      "id": "stock-atmospheric-temp",
      "name": "Atmospheric Temperature",
      "initial_value": 0.85,
      "equation": "",
      "position": {
        "x": 650,
        "y": 150
      }
    },
    {
      "id": "stock-ocean-temp",
      "name": "Ocean Temperature",
      "initial_value": 0.0068,
      "equation": "",
      "position": {
        "x": 650,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-investment",
      "name": "Investment",
      "equation": "Savings_Rate * Output",
      "from_stock": null,
      "to_stock": "stock-capital",
      "position": {
        "x": 75,
        "y": 150
      }
    },
    {
      "id": "flow-depreciation",
      "name": "Depreciation",
      "equation": "Capital_Stock * Depreciation_Rate",
      "from_stock": "stock-capital",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-emissions",
      "name": "CO2 Emissions",
      "equation": "Emission_Intensity * Output * (1 - Abatement_Rate)",
      "from_stock": null,
      "to_stock": "stock-atmospheric-co2",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-atm-to-ocean",
      "name": "Atmosphere to Ocean",
      "equation": "Carbon_Transfer_Rate_1 * (Atmospheric_CO2 - Upper_Ocean_CO2 * Atmosphere_Ocean_Ratio)",
      "from_stock": "stock-atmospheric-co2",
      "to_stock": "stock-upper-ocean-co2",
      "position": {
        "x": 400,
        "y": 225
      }
    },
    {
      "id": "flow-ocean-to-deep",
      "name": "Ocean to Deep",
      "equation": "Carbon_Transfer_Rate_2 * (Upper_Ocean_CO2 - Deep_Ocean_CO2 * Ocean_Deep_Ratio)",
      "from_stock": "stock-upper-ocean-co2",
      "to_stock": "stock-deep-ocean-co2",
      "position": {
        "x": 400,
        "y": 375
      }
    },
    {
      "id": "flow-forcing-warming",
      "name": "Atmospheric Warming",
      "equation": "(Radiative_Forcing - Heat_Loss_Coefficient * Atmospheric_Temperature - Heat_Exchange * (Atmospheric_Temperature - Ocean_Temperature)) / Climate_Sensitivity",
      "from_stock": null,
      "to_stock": "stock-atmospheric-temp",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "flow-ocean-warming",
      "name": "Ocean Warming",
      "equation": "Heat_Exchange * (Atmospheric_Temperature - Ocean_Temperature) / Ocean_Heat_Capacity",
      "from_stock": null,
      "to_stock": "stock-ocean-temp",
      "position": {
        "x": 550,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-output",
      "name": "Output",
      "equation": "TFP * (Capital_Stock ^ Capital_Share) * (Labor ^ (1 - Capital_Share)) * Damage_Multiplier",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-tfp",
      "name": "TFP",
      "equation": "5.115 * (1 + TFP_Growth) ^ (TIME / 5)",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-tfp-growth",
      "name": "TFP Growth",
      "equation": "0.005",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-labor",
      "name": "Labor",
      "equation": "7.4 * (1 + Population_Growth) ^ (TIME / 5)",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-population-growth",
