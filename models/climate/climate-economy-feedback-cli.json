      "equation": "0.03",
      "position": {
        "x": 300,
        "y": 500
      }
    },
    {
      "id": "var-radiative-forcing",
      "name": "Radiative Forcing",
      "equation": "Forcing_Coefficient * LN(Atmospheric_CO2 / Preindustrial_CO2) / LN(2) + External_Forcing",
