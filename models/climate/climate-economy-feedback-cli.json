        "x": 100,
        "y": 500
      }
    },
    {
      "id": "var-emission-intensity",
      "name": "Emission Intensity",
      "equation": "0.35 * (0.99 ^ TIME)",
      "position": {
        "x": 200,
        "y": 500
      }
    },
    {
      "id": "var-abatement-rate",
