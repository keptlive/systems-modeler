{
  "id": "greenland-ice-sheet-mass-balance-model-cli",
  "name": "Greenland Ice Sheet Mass Balance Model",
  "description": "Model for Greenland ice sheet dynamics including surface mass balance, calving, and basal melting. Predicts contribution to sea level rise. Reference: IPCC (2019). Ocean and Cryosphere in a Changing Climate. Source: https://www.ipcc.ch/srocc/",
  "stocks": [
    {
      "id": "stock-ice-volume",
      "name": "Ice_Volume",
      "initial_value": 2900000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-ice-area",
      "name": "Ice_Area",
      "initial_value": 1700000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-snowfall",
      "name": "snowfall",
      "equation": "P0 * (1 + 0.05 * T_anomaly)",
      "from_stock": null,
      "to_stock": "stock-ice-volume",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-surface-melt",
      "name": "surface_melt",
      "equation": "melt_factor * max(0, T - T_threshold) * Ice_Area",
      "from_stock": "stock-ice-volume",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-calving",
      "name": "calving",
      "equation": "calving_rate * Ice_Volume",
      "from_stock": "stock-ice-volume",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-basal-melt",
      "name": "basal_melt",
      "equation": "0",
      "from_stock": "stock-ice-volume",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-p0",
      "name": "P0",
      "equation": "500",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-melt-factor",
      "name": "melt_factor",
      "equation": "5",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-t-threshold",
      "name": "T_threshold",
      "equation": "-5",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-calving-rate",
      "name": "calving_rate",
      "equation": "0.001",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-albedo-ice",
      "name": "albedo_ice",
      "equation": "0.8",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-albedo-tundra",
      "name": "albedo_tundra",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 160
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "P0",
      "to_element": "snowfall"
    },
    {
      "id": "conn-2",
      "from_element": "Ice_Area",
      "to_element": "surface_melt"
    },
    {
      "id": "conn-3",
      "from_element": "melt_factor",
      "to_element": "surface_melt"
    },
    {
      "id": "conn-4",
      "from_element": "T_threshold",
      "to_element": "surface_melt"
    },
    {
      "id": "conn-5",
      "from_element": "Ice_Volume",
      "to_element": "calving"
    },
    {
      "id": "conn-6",
      "from_element": "calving_rate",
      "to_element": "calving"
    }
  ],
  "time_settings": {
    "start": 2000,
    "end": 2300,
    "dt": 1
  },
  "created_at": "2026-01-11T20:04:50.711160Z",
  "updated_at": "2026-01-11T20:04:50.711160Z",
  "source": "https://github.com/SDXorg/PySD-Cookbook",
  "reference": "SDXorg System Dynamics Model Repository"
}