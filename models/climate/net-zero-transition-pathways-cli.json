{
  "id": "net-zero-transition-pathways-cli",
  "name": "Net Zero Transition Pathways Model",
  "description": "Models pathways to net zero emissions with technology adoption. Source: IEA Net Zero by 2050 (2021). DOI: 10.1787/c8328405-en",
  "stocks": [
    {
      "id": "stock-emissions",
      "name": "Annual_Emissions",
      "initial_value": 40,
      "equation": "",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "stock-renewable",
      "name": "Renewable_Capacity",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-ev",
      "name": "EV_Share",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-ccs",
      "name": "CCS_Capacity",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-cumco2",
      "name": "Cumulative_CO2",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    }
  ],
  "flows": [
    {
      "id": "flow-emit",
      "name": "Emission_Change",
      "equation": "-Annual_Emissions * (Renewable_Growth_Effect + EV_Growth_Effect + CCS_Effect) / 100",
      "from_stock": null,
      "to_stock": "stock-emissions",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "flow-rengrow",
      "name": "Renewable_Growth",
      "equation": "Renewable_Capacity * Renewable_Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-renewable",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-evgrow",
      "name": "EV_Adoption",
      "equation": "EV_Share * EV_Growth_Rate * (1 - EV_Share / 100)",
      "from_stock": null,
      "to_stock": "stock-ev",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-ccsgrow",
      "name": "CCS_Deployment",
      "equation": "CCS_Capacity * CCS_Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-ccs",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-cumulate",
      "name": "CO2_Accumulation",
      "equation": "Annual_Emissions",
      "from_stock": null,
      "to_stock": "stock-cumco2",
      "position": {
        "x": 325,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "var-rengrow",
      "name": "Renewable_Growth_Rate",
      "equation": "0.15",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-evgrow",
      "name": "EV_Growth_Rate",
      "equation": "0.25",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-ccsgrow",
      "name": "CCS_Growth_Rate",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-reneff",
      "name": "Renewable_Growth_Effect",
      "equation": "Renewable_Capacity * 0.5",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-eveff",
      "name": "EV_Growth_Effect",
      "equation": "EV_Share * 0.3",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "var-ccseff",
      "name": "CCS_Effect",
      "equation": "CCS_Capacity * 2",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-netzero",
      "name": "Years_To_Net_Zero",
      "equation": "IF(Annual_Emissions > 0, Annual_Emissions / (Renewable_Growth_Effect + EV_Growth_Effect + CCS_Effect + 0.1), 0)",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Renewable_Capacity",
      "to_element": "Emission_Change"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:06:16.307994+00:00",
  "updated_at": "2026-01-12T02:06:16.307997+00:00",
  "source": "https://doi.org/10.1787/c8328405-en",
  "reference": "IEA (2021). Net Zero by 2050: A Roadmap for the Global Energy Sector."
}