{
  "id": "ipcc-climate-sensitivity-cli",
  "name": "IPCC Climate Sensitivity Model",
  "description": "Simplified model of equilibrium climate sensitivity (ECS) based on IPCC AR6 assessment. Shows the relationship between CO2 doubling and long-term temperature change, including feedback processes and uncertainty ranges. Reference: IPCC (2021). Climate Change 2021: The Physical Science Basis. Cambridge University Press. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "stock-atmospheric-co2",
      "name": "Atmospheric CO2",
      "initial_value": 280,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-global-temp-anomaly",
      "name": "Global Temperature Anomaly",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-emissions",
      "name": "Net CO2 Emissions",
      "equation": "Anthropogenic_Emissions - Natural_Sinks",
      "from_stock": null,
      "to_stock": "stock-atmospheric-co2",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-warming",
      "name": "Temperature Change",
      "equation": "(Equilibrium_Temperature - Global_Temperature_Anomaly) / Climate_Response_Time",
      "from_stock": null,
      "to_stock": "stock-global-temp-anomaly",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-preindustrial-co2",
      "name": "Preindustrial CO2",
      "equation": "280",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-radiative-forcing",
      "name": "Radiative Forcing",
      "equation": "5.35 * LN(Atmospheric_CO2 / Preindustrial_CO2)",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-climate-sensitivity",
      "name": "Climate Sensitivity ECS",
      "equation": "3.0",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-equilibrium-temp",
      "name": "Equilibrium Temperature",
      "equation": "Climate_Sensitivity_ECS * Radiative_Forcing / 3.7",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "var-anthropogenic-emissions",
      "name": "Anthropogenic Emissions",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-natural-sinks",
      "name": "Natural Sinks",
      "equation": "0.3 * (Atmospheric_CO2 - Preindustrial_CO2)",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-climate-response-time",
      "name": "Climate Response Time",
      "equation": "30",
      "position": {
        "x": 650,
        "y": 300
      }
    },
    {
      "id": "var-co2-doubling-time",
      "name": "CO2 Doubling Level",
      "equation": "560",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-tcr",
      "name": "Transient Climate Response",
      "equation": "Climate_Sensitivity_ECS * 0.6",
      "position": {
        "x": 650,
        "y": 100
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Atmospheric CO2",
      "to_element": "Radiative Forcing"
    },
    {
      "id": "conn-2",
      "from_element": "Radiative Forcing",
      "to_element": "Equilibrium Temperature"
    },
    {
      "id": "conn-3",
      "from_element": "Equilibrium Temperature",
      "to_element": "Temperature Change"
    },
    {
      "id": "conn-4",
      "from_element": "Global Temperature Anomaly",
      "to_element": "Temperature Change"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 1
  },
  "created_at": "2026-01-12T01:30:00.000Z",
  "updated_at": "2026-01-12T01:30:00.000Z",
  "source": "https://doi.org/10.1017/9781009157896",
  "reference": "IPCC. Climate Change 2021: The Physical Science Basis. AR6 Working Group I Report. Cambridge University Press, 2021."
}