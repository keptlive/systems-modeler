{
  "id": "electric-grid-resilience-model-cli",
  "name": "Electric Grid Resilience Model",
  "description": "Model of electric grid resilience under extreme weather and increasing renewable integration. Source: Panteli & Mancarella (2015), IEEE Trans Power Systems. DOI: 10.1109/TPWRS.2015.2397599",
  "stocks": [
    {
      "id": "stock-gen-cap",
      "name": "Generation_Capacity",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-trans",
      "name": "Transmission_Lines",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-storage",
      "name": "Storage_Capacity",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-damaged",
      "name": "Damaged_Infrastructure",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "stock-outage",
      "name": "Outage_Hours",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-gen-add",
      "name": "Capacity_Addition",
      "equation": "Investment_Rate * Gen_Cost_Factor",
      "from_stock": null,
      "to_stock": "stock-gen-cap",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-gen-retire",
      "name": "Retirement",
      "equation": "Generation_Capacity * Retirement_Rate",
      "from_stock": "stock-gen-cap",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "flow-trans-add",
      "name": "Grid_Upgrade",
      "equation": "Grid_Investment",
      "from_stock": null,
      "to_stock": "stock-trans",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-storage-add",
      "name": "Storage_Addition",
      "equation": "Storage_Investment",
      "from_stock": null,
      "to_stock": "stock-storage",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-damage",
      "name": "Weather_Damage",
      "equation": "(Generation_Capacity + Transmission_Lines) * Weather_Intensity * Vulnerability / 1000",
      "from_stock": null,
      "to_stock": "stock-damaged",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "flow-repair",
      "name": "Repair",
      "equation": "Damaged_Infrastructure * Repair_Rate",
      "from_stock": "stock-damaged",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 450
      }
    },
    {
      "id": "flow-outage-gen",
      "name": "Outage_Generation",
      "equation": "Damaged_Infrastructure * Outage_Factor * (1 - Storage_Capacity / (Generation_Capacity + 1))",
      "from_stock": null,
      "to_stock": "stock-outage",
      "position": {
        "x": 450,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-invest",
      "name": "Investment_Rate",
      "equation": "20",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-gen-cost",
      "name": "Gen_Cost_Factor",
      "equation": "1",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-retire",
      "name": "Retirement_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-grid-inv",
      "name": "Grid_Investment",
      "equation": "10",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-storage-inv",
      "name": "Storage_Investment",
      "equation": "5",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-weather",
      "name": "Weather_Intensity",
      "equation": "1 + 0.02 * TIME",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-vuln",
      "name": "Vulnerability",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-repair",
      "name": "Repair_Rate",
      "equation": "0.5",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-outage",
      "name": "Outage_Factor",
      "equation": "10",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Storage_Capacity",
      "to_element": "Outage_Generation"
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "created_at": "2026-01-11T22:18:53.216833+00:00",
  "updated_at": "2026-01-11T22:18:53.216833+00:00",
  "source": "https://doi.org/10.1109/TPWRS.2015.2397599",
  "reference": "Panteli, M. & Mancarella, P. (2015). The Grid: Stronger, Bigger, Smarter?"
}