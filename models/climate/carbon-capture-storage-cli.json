{
  "id": "carbon-capture-storage-cli",
  "name": "Carbon Capture and Storage Model",
  "description": "Models deployment of carbon capture technologies and geological storage capacity. Based on Global CCS Institute (2020) and IPCC SR1.5. Reference: IPCC (2021). Climate Change 2021: The Physical Science Basis. Cambridge University Press. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "stock-capacity",
      "name": "CCS_Capacity",
      "initial_value": 40,
      "equation": "",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "stock-stored",
      "name": "CO2_Stored",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "stock-atmosco2",
      "name": "Atmospheric_CO2",
      "initial_value": 415,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-invest",
      "name": "Investment",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-buildcap",
      "name": "Capacity_Build",
      "equation": "Investment * Build_Efficiency * Learning_Effect",
      "from_stock": null,
      "to_stock": "stock-capacity",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "flow-capture",
      "name": "CO2_Capture",
      "equation": "CCS_Capacity * Utilization_Rate",
      "from_stock": "stock-atmosco2",
      "to_stock": "stock-stored",
      "position": {
        "x": 425,
        "y": 150
      }
    },
    {
      "id": "flow-emissions",
      "name": "Emissions",
      "equation": "Annual_Emissions",
      "from_stock": null,
      "to_stock": "stock-atmosco2",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "flow-invest",
      "name": "Investment_Growth",
      "equation": "Investment * Investment_Growth_Rate * Carbon_Price_Signal",
      "from_stock": null,
      "to_stock": "stock-invest",
      "position": {
        "x": 50,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-buildeff",
      "name": "Build_Efficiency",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-learning",
      "name": "Learning_Effect",
      "equation": "1 + 0.1 * LN(CCS_Capacity / 40 + 1)",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-utilrate",
      "name": "Utilization_Rate",
      "equation": "0.85",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-emissions",
      "name": "Annual_Emissions",
      "equation": "36",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-investgrowth",
      "name": "Investment_Growth_Rate",
      "equation": "0.15",
      "position": {
        "x": 100,
        "y": 175
      }
    },
    {
      "id": "var-carbonprice",
      "name": "Carbon_Price_Signal",
      "equation": "1 + 0.02 * TIME",
      "position": {
        "x": 250,
        "y": 175
      }
    },
    {
      "id": "var-netcapture",
      "name": "Net_Capture",
      "equation": "CCS_Capacity * Utilization_Rate - Annual_Emissions",
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "CCS_Capacity",
      "to_element": "CO2_Capture"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 80,
    "dt": 1
  },
