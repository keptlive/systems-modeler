{
  "id": "deforestation-biodiversity-cli",
  "name": "Deforestation and Biodiversity Loss",
  "description": "Model of tropical deforestation and its impact on species biodiversity. Captures land conversion, habitat fragmentation, and extinction debt. Based on conservation biology and landscape ecology research. Reference: IPBES (2019). Global Assessment Report on Biodiversity. Source: https://ipbes.net/global-assessment",
  "stocks": [
    {
      "id": "s1",
      "name": "Forest_Area",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Agricultural_Land",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Species_Richness",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Extinction_Debt",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Deforestation",
      "equation": "Forest_Area * Deforestation_Rate * Economic_Pressure",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Forest_Regrowth",
      "equation": "Agricultural_Land * Abandonment_Rate * Regrowth_Potential",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 250,
        "y": 270
      }
    },
    {
      "id": "f3",
      "name": "Immediate_Extinction",
      "equation": "Species_Richness * Deforestation / Forest_Area * Direct_Loss_Factor",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 280
      }
    },
    {
      "id": "f4",
      "name": "Debt_Accumulation",
      "equation": "Deforestation * Species_Area_Coefficient",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "f5",
      "name": "Debt_Realization",
      "equation": "Extinction_Debt * Debt_Decay_Rate",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 430
      }
    },
    {
      "id": "f6",
      "name": "Delayed_Extinction",
      "equation": "Debt_Realization * Species_Richness / 500",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Deforestation_Rate",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "v2",
      "name": "Economic_Pressure",
      "equation": "1.2",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "v3",
      "name": "Abandonment_Rate",
      "equation": "0.005",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "v4",
      "name": "Regrowth_Potential",
      "equation": "0.8",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "v5",
      "name": "Direct_Loss_Factor",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "Species_Area_Coefficient",
      "equation": "0.25",
      "position": {
        "x": 300,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Debt_Decay_Rate",
      "equation": "0.02",
      "position": {
        "x": 500,
        "y": 130
      }
    },
    {
      "id": "v8",
      "name": "Habitat_Connectivity",
      "equation": "Forest_Area / 1000",
      "position": {
        "x": 150,
        "y": 180
      }
    },
    {
      "id": "v9",
      "name": "Fragmentation_Index",
      "equation": "1 - Habitat_Connectivity",
      "position": {
        "x": 350,
        "y": 180
      }
    },
    {
      "id": "v10",
      "name": "Species_Remaining_Percent",
      "equation": "Species_Richness / 500 * 100",
      "position": {
        "x": 550,
        "y": 180
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2120,
    "dt": 1
  },
  "source": "https://doi.org/10.1038/35002501",
  "reference": "Tilman D et al. (1994) Habitat destruction and the extinction debt. Nature. Brooks TM et al. (2002) Nature.",
  "created_at": "2026-01-12T07:04:13.444157+00:00",
  "updated_at": "2026-01-12T07:04:13.444157+00:00"
}