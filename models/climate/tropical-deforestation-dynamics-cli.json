{
  "id": "tropical-deforestation-dynamics-cli",
  "name": "Tropical Deforestation Dynamics Model",
  "description": "Model of tropical deforestation drivers including agriculture, logging, and infrastructure. Source: Curtis et al. (2018), Science. DOI: 10.1126/science.aau3445",
  "stocks": [
    {
      "id": "stock-forest",
      "name": "Primary_Forest",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-degraded",
      "name": "Degraded_Forest",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-agri",
      "name": "Agriculture",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-secondary",
      "name": "Secondary_Growth",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "stock-carbon",
      "name": "Stored_Carbon",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 100,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-degrade",
      "name": "Degradation",
      "equation": "Primary_Forest * Logging_Rate",
      "from_stock": "stock-forest",
      "to_stock": "stock-degraded",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-clear",
      "name": "Clearing",
      "equation": "(Primary_Forest + Degraded_Forest) * Clearing_Rate * Commodity_Price / 100",
      "from_stock": "stock-degraded",
      "to_stock": "stock-agri",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-abandon",
      "name": "Abandonment",
      "equation": "Agriculture * Abandonment_Rate",
      "from_stock": "stock-agri",
      "to_stock": "stock-secondary",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "flow-regrow",
      "name": "Regrowth",
      "equation": "Secondary_Growth * Regrowth_Rate",
      "from_stock": "stock-secondary",
      "to_stock": "stock-degraded",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "flow-carbon-loss",
      "name": "Carbon_Emission",
      "equation": "(Degradation + Clearing) * Carbon_Density",
      "from_stock": "stock-carbon",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "flow-carbon-gain",
      "name": "Carbon_Sequestration",
      "equation": "(Secondary_Growth + Degraded_Forest) * Sequestration_Rate",
      "from_stock": null,
      "to_stock": "stock-carbon",
      "position": {
        "x": 200,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-log",
      "name": "Logging_Rate",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-clear",
      "name": "Clearing_Rate",
      "equation": "0.03",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-commodity",
      "name": "Commodity_Price",
      "equation": "100",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-abandon",
      "name": "Abandonment_Rate",
      "equation": "0.05",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-regrow",
      "name": "Regrowth_Rate",
      "equation": "0.02",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-carbon-d",
      "name": "Carbon_Density",
      "equation": "200",
      "position": {
        "x": 50,
        "y": 300
      }
    },
    {
      "id": "var-sequest",
      "name": "Sequestration_Rate",
      "equation": "5",
      "position": {
        "x": 200,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Primary_Forest",
      "to_element": "Degradation"
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "created_at": "2026-01-11T22:18:53.216814+00:00",
  "updated_at": "2026-01-11T22:18:53.216814+00:00",
  "source": "https://doi.org/10.1126/science.aau3445",
  "reference": "Curtis, P.G. et al. (2018). Classifying drivers of global forest loss."
}