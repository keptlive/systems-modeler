{
  "id": "ocean-plastic-pollution-cli",
  "name": "Ocean Plastic Pollution Model",
  "description": "Model of plastic pollution in oceans showing production, waste, leakage to ocean, and degradation dynamics. Based on Jambeck et al. (2015). Reference: NOAA Ocean Climate. Source: https://www.climate.gov/news-features/understanding-climate/climate-change-ocean-heat-content",
  "stocks": [
    {
      "id": "s1",
      "name": "Plastic in Use",
      "initial_value": 4000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Managed Waste",
      "initial_value": 2000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Mismanaged Waste",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "s4",
      "name": "Ocean Plastic",
      "initial_value": 150,
      "equation": "",
      "position": {
        "x": 550,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Plastic Production",
      "equation": "Production_Rate * (1 + Production_Growth)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Proper Disposal",
      "equation": "Plastic_in_Use / Use_Lifetime * Proper_Disposal_Rate",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Improper Disposal",
      "equation": "Plastic_in_Use / Use_Lifetime * (1 - Proper_Disposal_Rate)",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "f4",
      "name": "Ocean Leakage",
      "equation": "Mismanaged_Waste * Leakage_Rate",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 450,
        "y": 275
      }
    },
    {
      "id": "f5",
      "name": "Managed Processing",
      "equation": "Managed_Waste / Processing_Time",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "f6",
      "name": "Ocean Degradation",
      "equation": "Ocean_Plastic / Degradation_Time",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Production Rate",
      "equation": "350",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Production Growth",
      "equation": "0.04",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "v3",
      "name": "Use Lifetime",
      "equation": "5",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Proper Disposal Rate",
      "equation": "0.75",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Leakage Rate",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 325
      }
    },
    {
      "id": "v6",
      "name": "Processing Time",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Degradation Time",
      "equation": "450",
      "position": {
        "x": 650,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Plastic in Use",
      "to_element": "Proper Disposal"
    },
    {
      "id": "c2",
      "from_element": "Mismanaged Waste",
      "to_element": "Ocean Leakage"
    },
    {
      "id": "c3",
      "from_element": "Ocean Plastic",
      "to_element": "Ocean Degradation"
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
