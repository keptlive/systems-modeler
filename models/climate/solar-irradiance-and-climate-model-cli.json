        "y": 200
      }
    },
    {
      "id": "stock-ocean-heat",
      "name": "Ocean_Heat",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-solar-forcing",
