{
  "id": "solar-irradiance-and-climate-model-cli",
  "name": "Solar Irradiance and Climate Model",
  "description": "Solar-only two-layer climate response, rebuilt with actual NRLTSI2 annual TSI (LASP/NOAA CDR,1849-2021 data subset) and the deterministic FaIR2.1.0 HadGEM2-ES two-layer operator (capacities7.73/89.29 W year/m2/K,feedback0.63,exchange0.52 W/m2/K,efficacy1.52). Annual values are aligned to their calendar year and linearly interpolated; no amplitude/period sinusoid is fabricated. Original1361 W/m2 reference and287.5K initial reference temperature retained as explicit experiment conventions. Absorbed solar anomaly is(1-albedo)*deltaTSI/4 and all temperature fluxes divide by mixed-layer heat capacity. Existing CO2 forcing remains0 for this solar-only experiment. Legacy amplitude,period and sensitivity controls remain visible but do not alter the measured series or calibrated feedback.",
  "stocks": [
    {
      "id": "stock-temperature",
      "name": "Temperature",
      "initial_value": 287.5,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      },
      "units": "K"
    },
    {
      "id": "stock-ocean-heat",
      "name": "Ocean_Heat",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      },
      "units": "W year/m2"
    }
  ],
  "flows": [
    {
      "id": "flow-solar-forcing",
      "name": "solar_forcing",
      "equation": "(TSI - TSI_mean) * (1 - Planetary_Albedo) / 4 / ocean_heat_capacity",
      "from_stock": null,
      "to_stock": "stock-temperature",
      "position": {
        "x": 250,
        "y": 200
      },
      "units": "K/year"
    },
    {
      "id": "flow-co2-forcing",
      "name": "co2_forcing",
      "equation": "0",
      "from_stock": null,
      "to_stock": "stock-temperature",
      "position": {
        "x": 450,
        "y": 200
      },
      "units": "K/year"
    },
    {
      "id": "flow-outgoing-longwave",
      "name": "outgoing_longwave",
      "equation": "Climate_Feedback * (Temperature - Reference_Temperature) / ocean_heat_capacity",
      "from_stock": "stock-temperature",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      },
      "units": "K/year"
    },
    {
      "id": "flow-ocean-uptake",
      "name": "ocean_uptake",
      "equation": "Ocean_Efficacy * Ocean_Heat_Flux / ocean_heat_capacity",
      "from_stock": "stock-temperature",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 350
      },
      "units": "K/year"
    },
    {
      "id": "v19-solar-deep-uptake",
      "name": "Deep Ocean Heat Uptake",
      "position": {
        "x": 740,
        "y": 600
      },
      "equation": "Ocean_Heat_Flux",
      "from_stock": null,
      "to_stock": "stock-ocean-heat",
      "units": "W/m2"
    }
  ],
  "variables": [
    {
      "id": "var-tsi-mean",
      "name": "TSI_mean",
      "equation": "1361",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-tsi-amplitude",
      "name": "TSI_amplitude",
      "equation": "1.1",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-cycle-period",
      "name": "cycle_period",
      "equation": "11",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-climate-sensitivity",
      "name": "climate_sensitivity",
      "equation": "3.0",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-ocean-heat-capacity",
      "name": "ocean_heat_capacity",
      "equation": "7.73",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "v19-tsi",
      "name": "TSI",
      "position": {
        "x": 900,
        "y": 600
      },
      "equation": "Annual_TSI(Time)",
      "units": "W/m2"
    },
    {
      "id": "v19-solar-albedo",
      "name": "Planetary Albedo",
      "position": {
        "x": 1060,
        "y": 600
      },
      "equation": "0.3",
      "units": "dimensionless"
    },
    {
      "id": "v19-temperature-baseline",
      "name": "Reference Temperature",
      "position": {
        "x": 100,
        "y": 700
      },
      "equation": "287.5",
      "units": "K"
    },
    {
      "id": "v19-deep-solar-capacity",
      "name": "Deep Ocean Capacity",
      "position": {
        "x": 260,
        "y": 700
      },
      "equation": "89.29",
      "units": "W year/m2/K"
    },
    {
      "id": "v19-solar-exchange",
      "name": "Ocean Heat Exchange",
      "position": {
        "x": 420,
        "y": 700
      },
      "equation": "0.52",
      "units": "W/m2/K"
    },
    {
      "id": "v19-solar-efficacy",
      "name": "Ocean Efficacy",
      "position": {
        "x": 580,
        "y": 700
      },
      "equation": "1.52",
      "units": "dimensionless"
    },
    {
      "id": "v19-solar-feedback",
      "name": "Climate Feedback",
      "position": {
        "x": 740,
        "y": 700
      },
      "equation": "0.63",
      "units": "W/m2/K"
    },
    {
      "id": "v19-solar-deep-temperature",
      "name": "Deep Temperature",
      "position": {
        "x": 900,
        "y": 700
      },
      "equation": "Ocean_Heat / Deep_Ocean_Capacity",
      "units": "K anomaly"
    },
    {
      "id": "v19-solar-heatflux",
      "name": "Ocean Heat Flux",
      "position": {
        "x": 1060,
        "y": 700
      },
      "equation": "Ocean_Heat_Exchange * (Temperature - Reference_Temperature - Deep_Temperature)",
      "units": "W/m2"
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "TSI_mean",
      "to_element": "solar_forcing"
    }
  ],
