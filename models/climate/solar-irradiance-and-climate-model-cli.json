{
  "id": "solar-irradiance-and-climate-model-cli",
  "name": "Solar Irradiance and Climate Model",
  "description": "Model of solar variability effects on Earth's climate including 11-year solar cycle and longer-term variations. Reference: IPCC Climate Assessment Reports. Source: https://www.ipcc.ch/",
  "stocks": [
    {
