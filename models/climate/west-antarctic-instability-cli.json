{
  "id": "west-antarctic-instability-cli",
  "name": "West Antarctic Ice Sheet Instability Model",
  "description": "Model of marine ice sheet instability (MISI) in West Antarctica. Retrograde bed slopes can trigger irreversible retreat. Contains ~3.3m sea level equivalent. Source: Joughin et al. (2014). Science. DOI: 10.1126/science.1249055",
  "stocks": [
    {"id": "stock-grounding-line", "name": "Grounding_Line_Position", "initial_value": 100, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-ice-volume", "name": "Ice_Volume", "initial_value": 3300000, "equation": "", "position": {"x": 400, "y": 200}},
    {"id": "stock-ocean-heat", "name": "Ocean_Heat_Content", "initial_value": 0, "equation": "", "position": {"x": 400, "y": 350}}
  ],
  "flows": [
    {"id": "flow-retreat", "name": "Grounding_Line_Retreat", "equation": "IF(On_Retrograde_Slope = 1, Base_Retreat * MISI_Amplification, Base_Retreat)", "from_stock": "stock-grounding-line", "to_stock": null, "position": {"x": 100, "y": 200}},
    {"id": "flow-ice-loss", "name": "Ice_Discharge", "equation": "Base_Discharge * (1 + Ocean_Heat_Effect * Ocean_Heat_Content / 100)", "from_stock": "stock-ice-volume", "to_stock": null, "position": {"x": 300, "y": 200}},
    {"id": "flow-heat-uptake", "name": "Ocean_Heat_Uptake", "equation": "Heat_Forcing * (1 + 0.03 * TIME)", "from_stock": null, "to_stock": "stock-ocean-heat", "position": {"x": 500, "y": 350}}
  ],
  "variables": [
    {"id": "var-base-retreat", "name": "Base_Retreat", "equation": "0.1", "position": {"x": 100, "y": 100}},
    {"id": "var-retrograde", "name": "On_Retrograde_Slope", "equation": "IF(Grounding_Line_Position < 80, 1, 0)", "position": {"x": 200, "y": 100}},
    {"id": "var-misi", "name": "MISI_Amplification", "equation": "3.0", "position": {"x": 100, "y": 300}},
    {"id": "var-base-discharge", "name": "Base_Discharge", "equation": "100", "position": {"x": 300, "y": 100}},
    {"id": "var-heat-effect", "name": "Ocean_Heat_Effect", "equation": "0.5", "position": {"x": 400, "y": 100}},
    {"id": "var-heat-forcing", "name": "Heat_Forcing", "equation": "5", "position": {"x": 500, "y": 250}},
    {"id": "var-sea-level", "name": "Sea_Level_Contribution", "equation": "(3300000 - Ice_Volume) / 361000000 * 1000", "position": {"x": 500, "y": 150}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 200, "dt": 1},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1126/science.1249055",
  "reference": "Joughin, I., Smith, B.E. & Medley, B. (2014). Marine ice sheet collapse potentially under way for the Thwaites Glacier Basin, West Antarctica. Science, 344(6185), 735-738."
}
