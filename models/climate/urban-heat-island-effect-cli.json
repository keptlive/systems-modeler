{
  "id": "urban-heat-island-effect-cli",
  "name": "Urban Heat Island Effect",
  "description": "Cities are warmer than surrounding rural areas due to reduced vegetation, increased impervious surfaces, waste heat, and altered air flow. Important for urban planning and health. Reference: Oke, T. R. (1982). The energetic basis of the urban heat island. Quarterly Journal of the Royal Meteorological Society, 108(455), 1-24. Source: https://doi.org/10.1002/qj.49710845502",
  "stocks": [
    {
      "id": "stock-urban-temp",
      "name": "Urban Temperature",
      "initial_value": 25,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-rural-temp",
      "name": "Rural Temperature",
      "initial_value": 22,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-urban-heating",
      "name": "Urban Heating",
      "equation": "(Solar_Absorption + Anthropogenic_Heat - Urban_Cooling) / Urban_Heat_Capacity",
      "from_stock": null,
      "to_stock": "stock-urban-temp",
      "position": {
        "x": 80,
        "y": 200
      }
    },
    {
      "id": "flow-rural-heating",
      "name": "Rural Heating",
      "equation": "(Rural_Solar_Absorption - Rural_Cooling) / Rural_Heat_Capacity",
      "from_stock": null,
      "to_stock": "stock-rural-temp",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-uhi-intensity",
      "name": "UHI Intensity",
      "equation": "Urban_Temperature - Rural_Temperature",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-solar",
      "name": "Solar Absorption",
      "equation": "Solar_Radiation * Urban_Albedo",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-anthropogenic",
      "name": "Anthropogenic Heat",
      "equation": "Population_Density * Heat_Per_Capita",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-urban-cooling",
      "name": "Urban Cooling",
      "equation": "Convection_Coeff * (Urban_Temperature - Air_Temperature) + Radiative_Cooling",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-rural-cooling",
      "name": "Rural Cooling",
      "equation": "Evapotranspiration + Convection_Coeff * (Rural_Temperature - Air_Temperature) + Radiative_Cooling",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-solar-rad",
      "name": "Solar Radiation",
      "equation": "500",
      "position": {
        "x": 100,
        "y": 420
      }
    },
    {
      "id": "var-urban-albedo",
      "name": "Urban Albedo",
      "equation": "0.8",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "var-rural-albedo",
      "name": "Rural Solar Absorption",
      "equation": "Solar_Radiation * 0.6",
      "position": {
        "x": 350,
        "y": 420
      }
    },
    {
      "id": "var-pop-density",
      "name": "Population Density",
      "equation": "5000",
      "position": {
        "x": 500,
        "y": 420
      }
    },
    {
      "id": "var-heat-capita",
      "name": "Heat Per Capita",
      "equation": "0.01",
      "position": {
        "x": 600,
        "y": 420
      }
    },
    {
      "id": "var-convection",
      "name": "Convection Coeff",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 490
      }
    },
    {
      "id": "var-air-temp",
      "name": "Air Temperature",
      "equation": "20",
      "position": {
        "x": 200,
        "y": 490
      }
    },
    {
      "id": "var-radiative",
      "name": "Radiative Cooling",
      "equation": "50",
      "position": {
        "x": 350,
        "y": 490
      }
    },
    {
      "id": "var-evap",
      "name": "Evapotranspiration",
      "equation": "100",
      "position": {
        "x": 500,
        "y": 490
      }
    },
    {
      "id": "var-urban-capacity",
      "name": "Urban Heat Capacity",
      "equation": "2000",
      "position": {
        "x": 100,
        "y": 550
      }
    },
    {
      "id": "var-rural-capacity",
      "name": "Rural Heat Capacity",
      "equation": "1500",
      "position": {
        "x": 300,
        "y": 550
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Urban Temperature",
      "to_element": "Urban Cooling"
    },
    {
      "id": "conn-2",
      "from_element": "Rural Temperature",
      "to_element": "Rural Cooling"
    },
    {
      "id": "conn-3",
      "from_element": "Urban Temperature",
      "to_element": "UHI Intensity"
    }
  ],
