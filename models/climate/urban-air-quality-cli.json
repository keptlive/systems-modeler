{
  "id": "urban-air-quality-cli",
  "name": "Urban Air Quality Model",
  "description": "Models urban air pollution from vehicles and industry with health effects. Based on WHO Air Quality Guidelines. Reference: WHO (2021). Air Quality Guidelines. Source: https://www.who.int/publications/i/item/9789240034228",
  "stocks": [
    {
      "id": "stock-pm25",
      "name": "PM25_Concentration",
      "initial_value": 35,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-nox",
      "name": "NOx_Concentration",
      "initial_value": 40,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-vehicles",
      "name": "Vehicle_Fleet",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "stock-health",
      "name": "Health_Impact_Index",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 500,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-pmemissions",
      "name": "PM25_Emissions",
      "equation": "Vehicle_Fleet * Vehicle_PM_Rate + Industrial_PM + Construction_PM",
      "from_stock": null,
      "to_stock": "stock-pm25",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-pmclear",
      "name": "PM25_Clearing",
      "equation": "PM25_Concentration * (Atmospheric_Dispersion + Precipitation_Washout)",
      "from_stock": "stock-pm25",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-noxemissions",
      "name": "NOx_Emissions",
      "equation": "Vehicle_Fleet * Vehicle_NOx_Rate + Industrial_NOx",
      "from_stock": null,
      "to_stock": "stock-nox",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-noxclear",
      "name": "NOx_Clearing",
      "equation": "NOx_Concentration * (Atmospheric_Dispersion + Photochemical_Decay)",
      "from_stock": "stock-nox",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-fleetgrowth",
      "name": "Fleet_Growth",
      "equation": "Vehicle_Fleet * Fleet_Growth_Rate * (1 - EV_Adoption)",
      "from_stock": null,
      "to_stock": "stock-vehicles",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "flow-fleetretire",
      "name": "Fleet_Retirement",
      "equation": "Vehicle_Fleet * Retirement_Rate",
      "from_stock": "stock-vehicles",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "flow-healthimpact",
      "name": "Health_Degradation",
      "equation": "PM25_Concentration * PM_Health_Factor + NOx_Concentration * NOx_Health_Factor",
      "from_stock": null,
      "to_stock": "stock-health",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "flow-healthrecov",
      "name": "Health_Recovery",
      "equation": "Health_Impact_Index * Recovery_Rate * IF(PM25_Concentration < WHO_Guideline, 1.5, 0.5)",
      "from_stock": "stock-health",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-vehpmrate",
      "name": "Vehicle_PM_Rate",
      "equation": "0.01 * (1 - Emission_Standard)",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-indpm",
      "name": "Industrial_PM",
      "equation": "10",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-constrpm",
      "name": "Construction_PM",
      "equation": "5 * (1 + 0.2 * SIN(TIME / 6))",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-atmosdisp",
      "name": "Atmospheric_Dispersion",
      "equation": "0.1 + Wind_Speed * 0.02",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-precwash",
      "name": "Precipitation_Washout",
      "equation": "0.05 * Rainfall",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-vehnoxrate",
      "name": "Vehicle_NOx_Rate",
      "equation": "0.02 * (1 - Emission_Standard)",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "var-indnox",
      "name": "Industrial_NOx",
      "equation": "15",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "var-photodecay",
      "name": "Photochemical_Decay",
      "equation": "0.08 * Sunlight_Factor",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "var-fleetgrowthrate",
      "name": "Fleet_Growth_Rate",
      "equation": "0.02",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-evadopt",
      "name": "EV_Adoption",
      "equation": "0.1 + 0.02 * TIME / 50",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "var-retirerate",
      "name": "Retirement_Rate",
      "equation": "0.08",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-emissstand",
      "name": "Emission_Standard",
      "equation": "0.3 + 0.01 * TIME",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "var-pmhealthfac",
      "name": "PM_Health_Factor",
      "equation": "0.5",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-noxhealthfac",
      "name": "NOx_Health_Factor",
      "equation": "0.3",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "var-recovrate",
      "name": "Recovery_Rate",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "var-whoguide",
      "name": "WHO_Guideline",
      "equation": "15",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "var-windspeed",
      "name": "Wind_Speed",
      "equation": "3",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "var-rainfall",
      "name": "Rainfall",
      "equation": "0.5 * (1 + SIN(TIME / 12))",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "var-sunlight",
      "name": "Sunlight_Factor",
      "equation": "0.7 + 0.3 * COS(TIME / 6)",
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Vehicle_Fleet",
      "to_element": "PM25_Emissions"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 48,
    "dt": 0.25
  },
  "created_at": "2026-01-12T02:59:36.700517+00:00",
  "updated_at": "2026-01-12T02:59:36.700523+00:00",
  "source": "https://www.who.int/publications/i/item/9789240034228",
  "reference": "WHO (2021). WHO Global Air Quality Guidelines."
}