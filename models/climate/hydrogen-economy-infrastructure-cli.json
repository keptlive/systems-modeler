  "flows": [
    {
      "id": "flow-electrolyzer-investment",
      "name": "Electrolyzer_Investment",
      "equation": "Investment_Budget * Electrolyzer_Share / Electrolyzer_Cost",
      "from_stock": null,
      "to_stock": "stock-electrolyzer-capacity",
      "position": {
        "x": 75,
        "y": 150
      }
    },
    {
      "id": "flow-electrolyzer-retirement",
      "name": "Electrolyzer_Retirement",
      "equation": "Electrolyzer_Capacity / Electrolyzer_Lifetime",
      "from_stock": "stock-electrolyzer-capacity",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 220
      }
    },
    {
      "id": "flow-hydrogen-production",
      "name": "Hydrogen_Production",
      "equation": "Electrolyzer_Capacity * Capacity_Factor * Renewable_Availability",
      "from_stock": null,
      "to_stock": "stock-hydrogen-storage",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-hydrogen-delivery",
      "name": "Hydrogen_Delivery",
      "equation": "MIN(Hydrogen_Storage / DT, Hydrogen_Demand, Distribution_Network * Network_Throughput)",
      "from_stock": "stock-hydrogen-storage",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "flow-network-expansion",
      "name": "Network_Expansion",
      "equation": "Investment_Budget * Network_Share / Network_Cost",
      "from_stock": null,
      "to_stock": "stock-distribution-network",
      "position": {
        "x": 475,
        "y": 150
      }
    },
    {
      "id": "flow-demand-growth",
      "name": "Demand_Growth",
      "equation": "Hydrogen_Demand * Demand_Growth_Rate + Policy_Stimulus",
      "from_stock": null,
      "to_stock": "stock-hydrogen-demand",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "flow-learning",
      "name": "Learning_Progress",
      "equation": "Electrolyzer_Capacity * Learning_Rate",
      "from_stock": null,
      "to_stock": "stock-cost-reduction",
      "position": {
        "x": 75,
        "y": 300
      }
    }
  ],
