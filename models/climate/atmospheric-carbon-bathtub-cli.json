{
  "id": "atmospheric-carbon-bathtub-cli",
  "name": "Atmospheric Carbon Bathtub",
  "description": "A simple 'bathtub' model of atmospheric carbon accumulation. Demonstrates the stock-and-flow dynamics of carbon accumulation in the atmosphere. Emissions fill the 'bathtub' while natural removal processes drain it. The model illustrates why atmospheric CO2 continues to rise even when emissions are reduced but not eliminated - a key insight for understanding climate policy. Reference: IPCC Climate Assessment Reports. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "stock-excess-atmospheric-carbon",
      "name": "Excess Atmospheric Carbon",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-emissions",
      "name": "Emissions",
      "equation": "emissions_rate",
      "from_stock": null,
      "to_stock": "stock-excess-atmospheric-carbon",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-natural-removal",
      "name": "Natural Removal",
      "equation": "excess_atmospheric_carbon * removal_constant",
      "from_stock": "stock-excess-atmospheric-carbon",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-emissions-rate",
      "name": "Emissions Rate",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-removal-constant",
      "name": "Removal Constant",
      "equation": "0.01",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-residence-time",
      "name": "Residence Time",
      "equation": "1 / removal_constant",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-equilibrium-carbon-level",
      "name": "Equilibrium Carbon Level",
      "equation": "emissions_rate / removal_constant",
      "position": {
        "x": 550,
        "y": 80
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Emissions Rate",
      "to_element": "Emissions"
    },
    {
      "id": "conn-2",
      "from_element": "Excess Atmospheric Carbon",
      "to_element": "Natural Removal"
    },
    {
      "id": "conn-3",
      "from_element": "Removal Constant",
      "to_element": "Natural Removal"
    },
    {
      "id": "conn-4",
      "from_element": "Removal Constant",
      "to_element": "Residence Time"
    },
    {
      "id": "conn-5",
      "from_element": "Emissions Rate",
      "to_element": "Equilibrium Carbon Level"
    },
    {
      "id": "conn-6",
      "from_element": "Removal Constant",
      "to_element": "Equilibrium Carbon Level"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-11T20:04:50.700113Z",
  "updated_at": "2026-01-11T20:04:50.700113Z",
  "source": "https://github.com/SDXorg/PySD-Cookbook",
  "reference": "SDXorg System Dynamics Model Repository"
}