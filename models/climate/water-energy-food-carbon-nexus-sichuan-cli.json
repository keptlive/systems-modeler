{
  "id": "water-energy-food-carbon-nexus-sichuan-cli",
  "name": "Water-Energy-Food-Carbon Nexus Model (Sichuan)",
  "description": "Dynamic model of the WEFC nexus addressing supply-demand imbalances under socioeconomic development and climate change for Sichuan Province, China 2007-2035. Reference: Wang, Z., et al. (2025). Dynamic modeling of the water-energy-food-carbon nexus: Scenario analysis and security assessment in Sichuan Province, China. Journal of Cleaner Production, 450, 142076. Source: https://doi.org/10.1016/j.jclepro.2025.142076",
  "stocks": [
    {
      "id": "s1",
      "name": "Water Resources",
      "initial_value": 300,
      "equation": "",
      "position": {"x": 100, "y": 100}
    },
    {
      "id": "s2",
      "name": "Energy Production",
      "initial_value": 200,
      "equation": "",
      "position": {"x": 300, "y": 100}
    },
    {
      "id": "s3",
      "name": "Food Production",
      "initial_value": 150,
      "equation": "",
      "position": {"x": 500, "y": 100}
    },
    {
      "id": "s4",
      "name": "Carbon Emissions",
      "initial_value": 100,
      "equation": "",
      "position": {"x": 300, "y": 250}
    },
    {
      "id": "s5",
      "name": "Economic Output",
      "initial_value": 500,
      "equation": "",
      "position": {"x": 100, "y": 250}
    },
    {
      "id": "s6",
      "name": "Population",
      "initial_value": 83,
      "equation": "",
      "position": {"x": 500, "y": 250}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Water Supply Change",
      "equation": "Natural_Recharge - Water_Demand - Climate_Reduction",
      "from_stock": null,
      "to_stock": "s1",
      "position": {"x": 100, "y": 150}
    },
    {
      "id": "f2",
      "name": "Energy Expansion",
      "equation": "Investment_Rate * Economic_Output * 0.001 - Energy_Depreciation",
      "from_stock": null,
      "to_stock": "s2",
      "position": {"x": 300, "y": 50}
    },
    {
      "id": "f3",
      "name": "Food Production Change",
      "equation": "Agricultural_Productivity * Water_For_Agriculture - Food_Loss",
      "from_stock": null,
      "to_stock": "s3",
      "position": {"x": 500, "y": 50}
    },
    {
      "id": "f4",
      "name": "Emissions Change",
      "equation": "Energy_Emissions + Agricultural_Emissions - Carbon_Sink - Mitigation_Effort",
      "from_stock": null,
      "to_stock": "s4",
      "position": {"x": 300, "y": 300}
    },
    {
      "id": "f5",
      "name": "Economic Growth",
      "equation": "GDP_Growth_Rate * Economic_Output * (1 - Resource_Constraint)",
      "from_stock": null,
      "to_stock": "s5",
      "position": {"x": 100, "y": 300}
    },
    {
      "id": "f6",
      "name": "Population Change",
      "equation": "Population * Population_Growth_Rate",
      "from_stock": null,
      "to_stock": "s6",
      "position": {"x": 500, "y": 300}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Natural Recharge",
      "equation": "15",
      "position": {"x": 50, "y": 50}
    },
    {
      "id": "v2",
      "name": "Water Demand",
      "equation": "Population * Per_Capita_Water + Energy_Production * Water_Energy_Ratio + Food_Production * Water_Food_Ratio",
      "position": {"x": 200, "y": 150}
    },
    {
      "id": "v3",
      "name": "Climate Reduction",
      "equation": "0.5 + 0.1 * TIME / 30",
      "position": {"x": 100, "y": 200}
    },
    {
      "id": "v4",
      "name": "Investment Rate",
      "equation": "0.03",
      "position": {"x": 250, "y": 50}
    },
    {
      "id": "v5",
      "name": "Energy Depreciation",
      "equation": "Energy_Production * 0.02",
      "position": {"x": 350, "y": 150}
    },
    {
      "id": "v6",
      "name": "Agricultural Productivity",
      "equation": "0.05",
      "position": {"x": 450, "y": 50}
    },
    {
      "id": "v7",
      "name": "Water For Agriculture",
      "equation": "Water_Resources * 0.4",
      "position": {"x": 550, "y": 50}
    },
    {
      "id": "v8",
      "name": "Food Loss",
      "equation": "Food_Production * 0.03",
      "position": {"x": 550, "y": 150}
    },
    {
      "id": "v9",
      "name": "Energy Emissions",
      "equation": "Energy_Production * Emission_Factor_Energy",
      "position": {"x": 200, "y": 300}
    },
    {
      "id": "v10",
      "name": "Agricultural Emissions",
      "equation": "Food_Production * Emission_Factor_Agri",
      "position": {"x": 400, "y": 350}
    },
    {
      "id": "v11",
      "name": "Carbon Sink",
      "equation": "5",
      "position": {"x": 350, "y": 350}
    },
    {
      "id": "v12",
      "name": "Mitigation Effort",
      "equation": "Carbon_Emissions * 0.01",
      "position": {"x": 250, "y": 350}
    },
    {
      "id": "v13",
      "name": "GDP Growth Rate",
      "equation": "0.06",
      "position": {"x": 50, "y": 300}
    },
    {
      "id": "v14",
      "name": "Resource Constraint",
      "equation": "MAX(0, (Water_Demand - Water_Resources) / Water_Demand)",
      "position": {"x": 150, "y": 350}
    },
    {
      "id": "v15",
      "name": "Per Capita Water",
      "equation": "0.3",
      "position": {"x": 50, "y": 150}
    },
    {
      "id": "v16",
      "name": "Water Energy Ratio",
      "equation": "0.1",
      "position": {"x": 150, "y": 100}
    },
    {
      "id": "v17",
      "name": "Water Food Ratio",
      "equation": "0.5",
      "position": {"x": 450, "y": 150}
    },
    {
      "id": "v18",
      "name": "Emission Factor Energy",
      "equation": "0.3",
      "position": {"x": 200, "y": 200}
    },
    {
      "id": "v19",
      "name": "Emission Factor Agri",
      "equation": "0.1",
      "position": {"x": 450, "y": 300}
    },
    {
      "id": "v20",
      "name": "Population Growth Rate",
      "equation": "0.003",
      "position": {"x": 550, "y": 350}
    },
    {
      "id": "v21",
      "name": "Nexus Security Index",
      "equation": "(MIN(1, Water_Resources / Water_Demand) + MIN(1, Energy_Production / (Population * 2.5)) + MIN(1, Food_Production / (Population * 2))) / 3",
      "position": {"x": 300, "y": 400}
    }
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 30, "dt": 1},
  "created_at": "2026-01-15T16:00:00.000000",
  "updated_at": "2026-01-15T16:00:00.000000",
  "source": "https://doi.org/10.1016/j.jclepro.2025.142076",
  "reference": "Wang, Z., et al. (2025). Dynamic modeling of the water-energy-food-carbon nexus: Scenario analysis and security assessment in Sichuan Province, China. Journal of Cleaner Production, 450, 142076."
}
