{
  "id": "climate-carbon-capture-storage-cli",
  "name": "Carbon Capture and Storage Deployment",
  "description": "Models the deployment dynamics of CCS technology including learning curves, capacity building, and costs. Based on IEA and IPCC assessments of CCS potential. Reference: IPCC (2021). Climate Change 2021: The Physical Science Basis. Cambridge University Press. Source: https://www.ipcc.ch/",
  "category": "climate",
  "stocks": [
    {
      "id": "stock-ccs-capacity",
      "name": "CCS_Capacity_GtCO2",
      "initial_value": 0.04,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-cum-captured",
      "name": "Cumulative_CO2_Captured",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-storage-used",
      "name": "Storage_Used",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "stock-cost",
      "name": "Unit_Cost",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-capacity-add",
      "name": "Capacity_Addition",
      "equation": "Investment / Unit_Cost * Capacity_Per_Dollar",
      "from_stock": null,
      "to_stock": "stock-ccs-capacity",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-capture",
      "name": "CO2_Capture",
      "equation": "CCS_Capacity_GtCO2 * Utilization_Rate",
      "from_stock": null,
      "to_stock": "stock-cum-captured",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-storage",
      "name": "CO2_Storage",
      "equation": "CO2_Capture",
      "from_stock": null,
      "to_stock": "stock-storage-used",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "flow-learning",
      "name": "Cost_Reduction",
      "equation": "Unit_Cost * Learning_Rate * Capacity_Addition / CCS_Capacity_GtCO2",
      "from_stock": "stock-cost",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-investment",
      "name": "Investment",
      "equation": "50e9",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-cap-per-dollar",
      "name": "Capacity_Per_Dollar",
      "equation": "1e-11",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-utilization",
      "name": "Utilization_Rate",
      "equation": "0.85",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-learning",
      "name": "Learning_Rate",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-storage-cap",
      "name": "Total_Storage_Capacity",
      "equation": "2000",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-remaining",
      "name": "Remaining_Storage",
      "equation": "Total_Storage_Capacity - Storage_Used",
      "position": {
        "x": 600,
        "y": 350
      }
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "source": "https://doi.org/10.1017/9781009157896",
  "reference": "IPCC (2022) Climate Change 2022: Mitigation of Climate Change. Chapter 12 - Cross-sectoral perspectives.",
  "connectors": [],
