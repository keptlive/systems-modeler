{
  "id": "amoc-atlantic-circulation-cli",
  "name": "Atlantic Meridional Overturning Circulation Model",
  "description": "Model of AMOC dynamics showing potential tipping point behavior under climate change. Reference: IPCC Climate Assessment Reports. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "s1",
      "name": "AMOC_Strength",
      "initial_value": 18,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "North_Atlantic_Salinity",
      "initial_value": 35,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "s3",
      "name": "Greenland_Ice_Mass",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "AMOC_Change",
      "equation": "(Density_Driven_Flow - AMOC_Strength) / AMOC_Response_Time",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Salinity_Change",
      "equation": "(Base_Salinity - North_Atlantic_Salinity + Evaporation_Effect - Freshwater_Input) / Salinity_Response_Time",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Ice_Melt",
      "equation": "Melt_Rate * Greenland_Ice_Mass * Temperature_Anomaly",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Density_Driven_Flow",
      "equation": "Max_AMOC * (North_Atlantic_Salinity - Salinity_Threshold) / (North_Atlantic_Salinity - Salinity_Threshold + 0.1)",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Freshwater_Input",
      "equation": "Ice_Melt_Contribution * (100 - Greenland_Ice_Mass) / 100",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "v3",
      "name": "Max_AMOC",
      "equation": "20",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Salinity_Threshold",
      "equation": "34",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Base_Salinity",
      "equation": "35.5",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Evaporation_Effect",
      "equation": "0.5",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Ice_Melt_Contribution",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "AMOC_Response_Time",
      "equation": "50",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "v9",
      "name": "Salinity_Response_Time",
      "equation": "20",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Melt_Rate",
      "equation": "0.001",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "v11",
      "name": "Temperature_Anomaly",
      "equation": "1.5",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2000,
    "end": 2200,
    "dt": 1,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:23:21.189843+00:00",
  "updated_at": "2026-01-12T11:23:21.189843+00:00",
  "source": "https://doi.org/10.1038/s41586-018-0006-5",
  "reference": "Caesar L, et al. Observed fingerprint of a weakening Atlantic Ocean overturning circulation. Nature. 2018;556:191-196."
}