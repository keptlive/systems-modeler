{
  "id": "plastic-pollution-lifecycle-cli",
  "name": "Plastic Pollution Lifecycle Model",
  "description": "Models plastic production, use, and environmental accumulation. Based on Geyer et al. (2017). DOI: 10.1126/sciadv.1700782",
  "stocks": [
    {
      "id": "stock-production",
      "name": "Annual_Production",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "stock-inuse",
      "name": "Plastic_In_Use",
      "initial_value": 3500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-landfill",
      "name": "Landfill_Accumulated",
      "initial_value": 4000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "stock-ocean",
      "name": "Ocean_Plastic",
      "initial_value": 150,
      "equation": "",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "stock-recycled",
      "name": "Recycled_Stock",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-produce",
      "name": "New_Production",
      "equation": "Annual_Production * (1 + Production_Growth)",
      "from_stock": null,
      "to_stock": "stock-inuse",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-tolandfill",
      "name": "To_Landfill",
      "equation": "Plastic_In_Use * Disposal_Rate * (1 - Recycling_Rate - Mismanaged_Rate)",
      "from_stock": "stock-inuse",
      "to_stock": "stock-landfill",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-toocean",
      "name": "Ocean_Leakage",
      "equation": "Plastic_In_Use * Disposal_Rate * Mismanaged_Rate * Ocean_Entry_Rate",
      "from_stock": "stock-inuse",
      "to_stock": "stock-ocean",
      "position": {
        "x": 400,
        "y": 175
      }
    },
    {
      "id": "flow-recycle",
      "name": "Recycling",
      "equation": "Plastic_In_Use * Disposal_Rate * Recycling_Rate",
      "from_stock": "stock-inuse",
      "to_stock": "stock-recycled",
      "position": {
        "x": 300,
        "y": 175
      }
    },
    {
      "id": "flow-reuserecyc",
      "name": "Recycled_Reuse",
      "equation": "Recycled_Stock * Reuse_Rate",
      "from_stock": "stock-recycled",
      "to_stock": "stock-inuse",
      "position": {
        "x": 200,
        "y": 175
      }
    },
    {
      "id": "flow-degradeland",
      "name": "Landfill_Degradation",
      "equation": "Landfill_Accumulated * Degradation_Rate_Land",
      "from_stock": "stock-landfill",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "flow-degradeocean",
      "name": "Ocean_Degradation",
      "equation": "Ocean_Plastic * Degradation_Rate_Ocean",
      "from_stock": "stock-ocean",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-prodgrowth",
      "name": "Production_Growth",
      "equation": "0.03 * (1 - Policy_Effect)",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-disposalrate",
      "name": "Disposal_Rate",
      "equation": "0.4",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-recyclerate",
      "name": "Recycling_Rate",
      "equation": "0.09 + 0.02 * TIME / 50",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "var-mismanaged",
      "name": "Mismanaged_Rate",
      "equation": "0.22 - 0.01 * TIME / 50",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-oceanentry",
      "name": "Ocean_Entry_Rate",
      "equation": "0.3",
      "position": {
        "x": 450,
        "y": 175
      }
    },
    {
      "id": "var-reuserate",
      "name": "Reuse_Rate",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-degradeland",
      "name": "Degradation_Rate_Land",
      "equation": "0.001",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-degradeocean",
      "name": "Degradation_Rate_Ocean",
      "equation": "0.005",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "var-policyeff",
      "name": "Policy_Effect",
      "equation": "0.1 * TIME / 50",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "var-totaccum",
      "name": "Total_Accumulated",
      "equation": "Landfill_Accumulated + Ocean_Plastic + Recycled_Stock",
      "position": {
        "x": 400,
        "y": 325
      }
    },
    {
      "id": "var-circularindex",
      "name": "Circular_Economy_Index",
      "equation": "Recycled_Stock / (Plastic_In_Use + Landfill_Accumulated + 1)",
      "position": {
        "x": 150,
        "y": 325
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Plastic_In_Use",
      "to_element": "To_Landfill"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:59:36.700474+00:00",
  "updated_at": "2026-01-12T02:59:36.700477+00:00",
  "source": "https://doi.org/10.1126/sciadv.1700782",
  "reference": "Geyer R, Jambeck JR, Law KL (2017). Production, use, and fate of all plastics ever made. Science Advances."
}