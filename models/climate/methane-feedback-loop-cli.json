{
  "id": "methane-feedback-loop-cli",
  "name": "Methane Feedback Loop Model",
  "description": "Models methane emissions from wetlands and permafrost as temperature increases. Based on Saunois et al. (2020). DOI: 10.5194/essd-12-1561-2020",
  "stocks": [
    {
      "id": "stock-atmosch4",
      "name": "Atmospheric_Methane",
      "initial_value": 1875,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-wetlandpool",
      "name": "Wetland_Carbon",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-permapool",
      "name": "Permafrost_Methane",
      "initial_value": 1500,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-temp",
      "name": "Temperature_Anomaly",
      "initial_value": 1.1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-wetlandemit",
      "name": "Wetland_Emission",
      "equation": "Wetland_Carbon * Wetland_Rate * (1 + Temperature_Sensitivity * Temperature_Anomaly)",
      "from_stock": "stock-wetlandpool",
      "to_stock": "stock-atmosch4",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-permaemit",
      "name": "Permafrost_Emission",
      "equation": "Permafrost_Methane * Permafrost_Rate * IF(Temperature_Anomaly > 1.5, 2, 1)",
      "from_stock": "stock-permapool",
      "to_stock": "stock-atmosch4",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-oxidation",
      "name": "Atmospheric_Oxidation",
      "equation": "Atmospheric_Methane / Methane_Lifetime",
      "from_stock": "stock-atmosch4",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "flow-anthro",
      "name": "Anthropogenic_Emissions",
      "equation": "Anthropogenic_Rate",
      "from_stock": null,
      "to_stock": "stock-atmosch4",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "flow-warming",
      "name": "Methane_Warming",
      "equation": "(Atmospheric_Methane - 750) * Methane_Forcing",
      "from_stock": null,
      "to_stock": "stock-temp",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-wetrate",
      "name": "Wetland_Rate",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-permarate",
      "name": "Permafrost_Rate",
      "equation": "0.001",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-tempsens",
      "name": "Temperature_Sensitivity",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "var-lifetime",
      "name": "Methane_Lifetime",
      "equation": "12",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-anthro",
      "name": "Anthropogenic_Rate",
      "equation": "600",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "var-forcing",
      "name": "Methane_Forcing",
      "equation": "0.0003",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Temperature_Anomaly",
      "to_element": "Wetland_Emission"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-12T02:45:00.574955+00:00",
  "updated_at": "2026-01-12T02:45:00.574958+00:00",
  "source": "https://doi.org/10.5194/essd-12-1561-2020",
  "reference": "Saunois M, et al. (2020). The Global Methane Budget 2000\u20132017. Earth System Science Data."
}