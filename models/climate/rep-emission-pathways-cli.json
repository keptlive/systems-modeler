{
  "id": "rep-emission-pathways-cli",
  "name": "Representative Emission Pathways (REP) Climate Model",
  "description": "Next generation climate scenario model for Earth system modeling. Evolution from RCPs and SSPs towards representative emission pathways. Source: GMD (2024), CMIP7 framework. Reference: IPCC Climate Assessment Reports. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "stock-emit",
      "name": "Cumulative_Emissions",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-conc",
      "name": "CO2_Concentration",
      "initial_value": 420,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-temp",
      "name": "Global_Temperature",
      "initial_value": 1.2,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-budget",
      "name": "Carbon_Budget_Remaining",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-emit",
      "name": "Annual_Emissions",
      "equation": "Emission_Trajectory",
      "from_stock": null,
      "to_stock": "stock-emit",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-budget",
      "name": "Budget_Depletion",
      "equation": "Emission_Trajectory",
      "from_stock": "stock-budget",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "flow-conc",
      "name": "Concentration_Change",
      "equation": "Emission_Trajectory * Airborne_Fraction - Sink_Rate * (CO2_Concentration - 280)",
      "from_stock": null,
      "to_stock": "stock-conc",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-temp",
      "name": "Temperature_Response",
      "equation": "TCR * LOG(CO2_Concentration / 280) / LOG(2) - Global_Temperature",
      "from_stock": null,
      "to_stock": "stock-temp",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-traj",
      "name": "Emission_Trajectory",
      "equation": "40 * EXP(-0.03 * TIME)",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-af",
      "name": "Airborne_Fraction",
      "equation": "0.44",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-sink",
      "name": "Sink_Rate",
      "equation": "0.015",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-tcr",
      "name": "TCR",
      "equation": "1.8",
      "position": {
        "x": 400,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 80,
    "dt": 1
  },
  "created_at": "2026-01-12T12:41:31.049070+00:00",
  "updated_at": "2026-01-12T12:41:31.049070+00:00",
  "source": "https://doi.org/10.1017/9781009157896",
  "reference": "IPCC. Climate Change 2023: Synthesis Report. Cambridge University Press; 2023."
}