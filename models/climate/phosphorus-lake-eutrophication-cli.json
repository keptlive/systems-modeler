{
  "id": "phosphorus-lake-eutrophication-cli",
  "name": "Phosphorus Lake Eutrophication Model",
  "description": "A model of phosphorus dynamics in lakes demonstrating eutrophication processes. Based on the pioneering work of Vollenweider (1968) on lake nutrient loading and trophic state. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1007/BF00167960",
  "reference": "Vollenweider RA. Scientific fundamentals of the eutrophication of lakes and flowing waters. OECD Technical Report, 1968.",
  "stocks": [
    {
      "id": "stock-p-water",
      "name": "Phosphorus in Water",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-p-sediment",
      "name": "Phosphorus in Sediment",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-algae",
      "name": "Algae Biomass",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-loading",
      "name": "External Loading",
      "equation": "External_P_Load",
      "from_stock": null,
      "to_stock": "stock-p-water",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-outflow",
      "name": "P Outflow",
      "equation": "Phosphorus_in_Water / Residence_Time",
      "from_stock": "stock-p-water",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-sedimentation",
      "name": "Sedimentation",
      "equation": "Sedimentation_Rate * Phosphorus_in_Water",
      "from_stock": "stock-p-water",
      "to_stock": "stock-p-sediment",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-release",
      "name": "Sediment Release",
      "equation": "Release_Rate * Phosphorus_in_Sediment * Anoxia_Factor",
      "from_stock": "stock-p-sediment",
      "to_stock": "stock-p-water",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "flow-algae-growth",
      "name": "Algae Growth",
      "equation": "Growth_Rate * Algae_Biomass * Phosphorus_in_Water / (Half_Saturation + Phosphorus_in_Water)",
      "from_stock": null,
      "to_stock": "stock-algae",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "flow-algae-death",
      "name": "Algae Death",
      "equation": "Mortality_Rate * Algae_Biomass",
      "from_stock": "stock-algae",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-anoxia",
      "name": "Anoxia Factor",
      "equation": "1 + 2 * MAX(0, (Algae_Biomass - Anoxia_Threshold) / Anoxia_Threshold)",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-external-load",
      "name": "External P Load",
      "equation": "1",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-residence",
      "name": "Residence Time",
      "equation": "365",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-sed-rate",
      "name": "Sedimentation Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-release-rate",
      "name": "Release Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-growth-rate",
      "name": "Growth Rate",
      "equation": "0.3",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-half-sat",
      "name": "Half Saturation",
      "equation": "5",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "var-mortality",
      "name": "Mortality Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-anoxia-thresh",
      "name": "Anoxia Threshold",
      "equation": "20",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 3650,
    "dt": 1
  },
