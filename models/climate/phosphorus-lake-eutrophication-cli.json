{
  "id": "phosphorus-lake-eutrophication-cli",
  "name": "Phosphorus Lake Eutrophication Model",
  "description": "Illustrative phosphorus-water, sediment and algae model with restored nutrient accounting from the original MyLake1.2 phosphorus-phytoplankton code: algal growth removes dissolved phosphorus and loss returns it using Y_cp=1mgChl/mgP (published Vansjo parameter workbook,row35). Biomass is chlorophyll-equivalent concentration; sediment content is expressed per water volume. TotalP=water+sediment+algae/Y_cp changes only by external loading minus outflow. Original local rates, initial states, sediment/anoxia law, geometry and3650-day horizon are retained and remain uncalibrated; this is a reduced nutrient-accounting adaptation, not full MyLake or a verified Vollenweider model. Radau is explicitly selected for the increasingly stiff sediment release, without positivity clamps or dt-dependent flux caps.",
  "source": "https://raw.githubusercontent.com/biogeochemistry/MyLake_public/d882070870bd0bd541376ee8b627282d3ae8d329/v12/v12/solvemodel_v12.m",
  "reference": "Saloranta & Andersen (2007), MyLake1.2, Ecological Modelling207:45-60, doi:10.1016/j.ecolmodel.2007.03.018. Native solvemodel_v12.m growth/P coupling lines454-461 and VAN_para_v12.xls lake!B35 Y_cp=1; commit d882070870bd0bd541376ee8b627282d3ae8d329. Vollenweider1968 is loading-model background only.",
  "stocks": [
    {
      "id": "stock-p-water",
      "name": "Phosphorus in Water",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      },
      "units": "mg P/m3 water-volume equivalent"
    },
    {
      "id": "stock-p-sediment",
      "name": "Phosphorus in Sediment",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      },
      "units": "mg P/m3 water-volume equivalent"
    },
    {
      "id": "stock-algae",
      "name": "Algae Biomass",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      },
      "units": "mg chlorophyll a/m3"
    }
  ],
  "flows": [
    {
      "id": "flow-loading",
      "name": "External Loading",
      "equation": "External_P_Load",
      "from_stock": null,
      "to_stock": "stock-p-water",
      "position": {
        "x": 100,
        "y": 200
      },
      "units": "mg P/m3/day"
    },
    {
      "id": "flow-outflow",
      "name": "P Outflow",
      "equation": "Phosphorus_in_Water / Residence_Time",
      "from_stock": "stock-p-water",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 200
      },
      "units": "mg P/m3/day"
    },
    {
      "id": "flow-sedimentation",
      "name": "Sedimentation",
      "equation": "Sedimentation_Rate * Phosphorus_in_Water",
      "from_stock": "stock-p-water",
      "to_stock": "stock-p-sediment",
      "position": {
        "x": 250,
        "y": 200
      },
      "units": "mg P/m3/day"
    },
    {
      "id": "flow-release",
      "name": "Sediment Release",
      "equation": "Release_Rate * Phosphorus_in_Sediment * Anoxia_Factor",
      "from_stock": "stock-p-sediment",
      "to_stock": "stock-p-water",
      "position": {
        "x": 250,
        "y": 250
      },
      "units": "mg P/m3/day"
    },
    {
      "id": "flow-algae-growth",
      "name": "Algae Growth",
      "equation": "Growth_Rate * Algae_Biomass * Phosphorus_in_Water / (Half_Saturation + Phosphorus_in_Water)",
      "from_stock": null,
      "to_stock": "stock-algae",
      "position": {
        "x": 500,
        "y": 200
      },
      "units": "mg chlorophyll a/m3/day"
    },
    {
      "id": "flow-algae-death",
      "name": "Algae Death",
      "equation": "Mortality_Rate * Algae_Biomass",
      "from_stock": "stock-algae",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      },
      "units": "mg chlorophyll a/m3/day"
    },
    {
      "id": "v19-phosphorus-uptake",
      "name": "Algal Phosphorus Uptake",
      "position": {
        "x": 1060,
        "y": 600
      },
      "equation": "Algae_Growth / Algal_Chlorophyll_Phosphorus_Ratio",
      "from_stock": "stock-p-water",
      "to_stock": null,
      "units": "mg P/m3/day"
    },
    {
      "id": "v19-phosphorus-recycling",
      "name": "Algal Phosphorus Recycling",
      "position": {
        "x": 100,
        "y": 700
      },
      "equation": "Algae_Death / Algal_Chlorophyll_Phosphorus_Ratio",
      "from_stock": null,
      "to_stock": "stock-p-water",
      "units": "mg P/m3/day"
    }
  ],
  "variables": [
    {
      "id": "var-anoxia",
      "name": "Anoxia Factor",
      "equation": "1 + 2 * MAX(0, (Algae_Biomass - Anoxia_Threshold) / Anoxia_Threshold)",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-external-load",
      "name": "External P Load",
      "equation": "1",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-residence",
      "name": "Residence Time",
      "equation": "365",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-sed-rate",
      "name": "Sedimentation Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-release-rate",
      "name": "Release Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-growth-rate",
      "name": "Growth Rate",
      "equation": "0.3",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-half-sat",
      "name": "Half Saturation",
      "equation": "5",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "var-mortality",
      "name": "Mortality Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-anoxia-thresh",
      "name": "Anoxia Threshold",
      "equation": "20",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "v19-phosphorus-yield",
      "name": "Algal Chlorophyll Phosphorus Ratio",
      "position": {
        "x": 420,
        "y": 700
      },
      "equation": "1",
      "units": "mg chlorophyll a/mg P"
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 3650,
    "dt": 1,
    "integration_method": "radau",
    "rtol": 1e-08,
    "atol": 1e-10
  },
  "created_at": "2026-01-11T21:34:33.049370+00:00",
  "updated_at": "2026-01-11T21:34:33.049370+00:00"
}
