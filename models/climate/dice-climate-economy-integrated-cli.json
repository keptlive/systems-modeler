{
  "id": "dice-climate-economy-integrated-cli",
  "name": "DICE Climate-Economy Integrated Model",
  "description": "A simplified version of William Nordhaus's Dynamic Integrated Climate-Economy (DICE) model. This Nobel Prize-winning model integrates economic growth with climate change impacts and mitigation costs. Reference: Nordhaus, W. D. (2008). A question of balance. Yale University Press. DOI: https://doi.org/10.1093/reep/ren023",
  "source": "https://doi.org/10.1073/pnas.1609244114",
  "reference": "Nordhaus WD. Revisiting the social cost of carbon. PNAS. 2017;114(7):1518-1523. Nobel Prize in Economics 2018.",
  "stocks": [
