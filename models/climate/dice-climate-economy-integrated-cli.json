      "name": "Capital Stock",
      "initial_value": 137,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "stock-co2",
      "name": "Atmospheric CO2",
      "initial_value": 851,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "stock-temperature",
      "name": "Temperature Anomaly",
      "initial_value": 0.85,
      "equation": "",
      "position": {
        "x": 550,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-investment",
      "name": "Investment",
      "equation": "Savings_Rate * Output",
      "from_stock": null,
      "to_stock": "stock-capital",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-depreciation",
      "name": "Depreciation",
      "equation": "Capital_Stock * Depreciation_Rate",
      "from_stock": "stock-capital",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-emissions",
      "name": "Emissions",
      "equation": "Emissions_Intensity * Output * (1 - Abatement)",
      "from_stock": null,
      "to_stock": "stock-co2",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-co2-decay",
      "name": "CO2 Decay",
      "equation": "Atmospheric_CO2 * CO2_Decay_Rate",
      "from_stock": "stock-co2",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-warming",
      "name": "Warming",
      "equation": "(Climate_Sensitivity * LOG(Atmospheric_CO2 / 280, 2) - Temperature_Anomaly) / Temperature_Adjustment_Time",
      "from_stock": null,
      "to_stock": "stock-temperature",
      "position": {
        "x": 500,
        "y": 150
      }
    }
  ],
  "variables": [
