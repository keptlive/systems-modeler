{
  "id": "ev-market-transition-cli",
  "name": "Electric Vehicle Market Transition Model",
  "description": "Model of electric vehicle market penetration showing adoption dynamics, charging infrastructure co-evolution, and battery cost learning curves. Based on Linn & Vaishnav (2021) and BloombergNEF projections. Reference: Based on project dynamics models (Lyneis & Ford, 2007). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-ice-vehicles",
      "name": "ICE Vehicles",
      "initial_value": 95,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-ev-vehicles",
      "name": "EV Vehicles",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-charging-stations",
      "name": "Charging Stations",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-cumulative-ev-sales",
      "name": "Cumulative EV Sales",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-ice-sales",
      "name": "ICE Vehicle Sales",
      "equation": "Total_Vehicle_Sales * (1 - EV_Market_Share)",
      "from_stock": null,
      "to_stock": "stock-ice-vehicles",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-ice-retirement",
      "name": "ICE Retirement",
      "equation": "ICE_Vehicles / Vehicle_Lifetime",
      "from_stock": "stock-ice-vehicles",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-ev-sales",
      "name": "EV Vehicle Sales",
      "equation": "Total_Vehicle_Sales * EV_Market_Share",
      "from_stock": null,
      "to_stock": "stock-ev-vehicles",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-ev-retirement",
      "name": "EV Retirement",
      "equation": "EV_Vehicles / EV_Lifetime",
      "from_stock": "stock-ev-vehicles",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-charger-buildout",
      "name": "Charger Buildout",
      "equation": "Charger_Investment_Rate",
      "from_stock": null,
      "to_stock": "stock-charging-stations",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "flow-cumulative-sales",
      "name": "Cumulative Sales",
      "equation": "EV_Vehicle_Sales",
      "from_stock": null,
      "to_stock": "stock-cumulative-ev-sales",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-total-vehicle-sales",
      "name": "Total Vehicle Sales",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-vehicle-lifetime",
      "name": "ICE Vehicle Lifetime",
      "equation": "15",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-ev-lifetime",
      "name": "EV Lifetime",
      "equation": "12",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-battery-cost",
      "name": "Battery Cost per kWh",
      "equation": "200 * (Cumulative_EV_Sales / 5) ^ (-0.2)",
      "position": {
        "x": 450,
        "y": 80
      }
    },
    {
      "id": "var-ev-price",
      "name": "EV Price",
      "equation": "30000 + Battery_Cost * Battery_Size",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-battery-size",
      "name": "Battery Size kWh",
      "equation": "60",
      "position": {
        "x": 750,
        "y": 80
      }
    },
    {
      "id": "var-ice-price",
      "name": "ICE Price",
      "equation": "35000",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-price-ratio",
      "name": "Price Ratio",
      "equation": "EV_Price / ICE_Price",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "var-charger-availability",
      "name": "Charger Availability",
      "equation": "Charging_Stations / (EV_Vehicles + 1)",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "var-range-anxiety-factor",
      "name": "Range Anxiety Factor",
      "equation": "MIN(1, Charger_Availability * 10)",
      "position": {
        "x": 500,
        "y": 400
      }
    },
    {
      "id": "var-policy-support",
      "name": "Policy Support",
      "equation": "1.2",
      "position": {
        "x": 650,
        "y": 400
      }
    },
    {
      "id": "var-ev-market-share",
      "name": "EV Market Share",
      "equation": "MIN(0.95, 0.05 + 0.9 * (1 / (1 + EXP(2 * (Price_Ratio - 1)))) * Range_Anxiety_Factor * Policy_Support)",
      "position": {
        "x": 100,
        "y": 470
      }
    },
    {
      "id": "var-charger-investment-rate",
      "name": "Charger Investment Rate",
      "equation": "MAX(0, (EV_Vehicles * Target_Charger_Ratio - Charging_Stations) / Charger_Build_Time)",
      "position": {
        "x": 400,
        "y": 470
      }
    },
    {
      "id": "var-target-charger-ratio",
      "name": "Target Charger Ratio",
      "equation": "0.1",
      "position": {
        "x": 650,
        "y": 470
      }
    },
    {
      "id": "var-charger-build-time",
      "name": "Charger Build Time",
      "equation": "2",
      "position": {
        "x": 750,
        "y": 470
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.25
  },
  "created_at": "2026-01-11T21:16:29.727483+00:00",
  "updated_at": "2026-01-11T21:16:29.727483+00:00",
  "source": "https://github.com/SDXorg/PySD-Cookbook",
  "reference": "SDXorg System Dynamics Model Repository"
}