{
  "id": "sellers-climate-zones-cli",
  "name": "Sellers Latitudinal Climate Model",
  "description": "William Sellers' (1969) zonal energy balance model showing how solar radiation, albedo, and heat transport determine latitudinal temperature distributions. Foundational for understanding climate zonation and sensitivity.",
  "stocks": [
    {"id": "stock-tropical-temp", "name": "Tropical Temperature", "initial_value": 27, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-temperate-temp", "name": "Temperate Temperature", "initial_value": 15, "equation": "", "position": {"x": 400, "y": 200}},
    {"id": "stock-polar-temp", "name": "Polar Temperature", "initial_value": -10, "equation": "", "position": {"x": 600, "y": 200}}
  ],
  "flows": [
    {"id": "flow-tropical-heating", "name": "Tropical Heating", "equation": "(Tropical_Absorbed - Tropical_OLR - Heat_Transport_Out) / Heat_Capacity", "from_stock": null, "to_stock": "stock-tropical-temp", "position": {"x": 100, "y": 200}},
    {"id": "flow-temperate-heating", "name": "Temperate Heating", "equation": "(Temperate_Absorbed - Temperate_OLR + Heat_Transport_In_Temp - Heat_Transport_Out_Temp) / Heat_Capacity", "from_stock": null, "to_stock": "stock-temperate-temp", "position": {"x": 300, "y": 200}},
    {"id": "flow-polar-heating", "name": "Polar Heating", "equation": "(Polar_Absorbed - Polar_OLR + Heat_Transport_In_Polar) / Heat_Capacity", "from_stock": null, "to_stock": "stock-polar-temp", "position": {"x": 500, "y": 200}}
  ],
  "variables": [
    {"id": "var-tropical-insolation", "name": "Tropical Insolation", "equation": "420", "position": {"x": 150, "y": 100}},
    {"id": "var-temperate-insolation", "name": "Temperate Insolation", "equation": "320", "position": {"x": 350, "y": 100}},
    {"id": "var-polar-insolation", "name": "Polar Insolation", "equation": "180", "position": {"x": 550, "y": 100}},
    {"id": "var-tropical-albedo", "name": "Tropical Albedo", "equation": "0.25", "position": {"x": 150, "y": 300}},
    {"id": "var-temperate-albedo", "name": "Temperate Albedo", "equation": "0.35", "position": {"x": 350, "y": 300}},
    {"id": "var-polar-albedo", "name": "Polar Albedo", "equation": "IF Polar_Temperature < -10 THEN 0.7 ELSE 0.5", "position": {"x": 550, "y": 300}},
    {"id": "var-tropical-absorbed", "name": "Tropical Absorbed", "equation": "Tropical_Insolation * (1 - Tropical_Albedo)", "position": {"x": 150, "y": 400}},
    {"id": "var-temperate-absorbed", "name": "Temperate Absorbed", "equation": "Temperate_Insolation * (1 - Temperate_Albedo)", "position": {"x": 350, "y": 400}},
    {"id": "var-polar-absorbed", "name": "Polar Absorbed", "equation": "Polar_Insolation * (1 - Polar_Albedo)", "position": {"x": 550, "y": 400}},
    {"id": "var-tropical-olr", "name": "Tropical OLR", "equation": "A + B * Tropical_Temperature", "position": {"x": 150, "y": 500}},
    {"id": "var-temperate-olr", "name": "Temperate OLR", "equation": "A + B * Temperate_Temperature", "position": {"x": 350, "y": 500}},
    {"id": "var-polar-olr", "name": "Polar OLR", "equation": "A + B * Polar_Temperature", "position": {"x": 550, "y": 500}},
    {"id": "var-a", "name": "A", "equation": "204", "position": {"x": 200, "y": 600}},
    {"id": "var-b", "name": "B", "equation": "2.17", "position": {"x": 350, "y": 600}},
    {"id": "var-heat-transport-out", "name": "Heat Transport Out", "equation": "Transport_Coeff * (Tropical_Temperature - Temperate_Temperature)", "position": {"x": 200, "y": 700}},
    {"id": "var-heat-transport-in-temp", "name": "Heat Transport In Temp", "equation": "Heat_Transport_Out", "position": {"x": 350, "y": 700}},
    {"id": "var-heat-transport-out-temp", "name": "Heat Transport Out Temp", "equation": "Transport_Coeff * (Temperate_Temperature - Polar_Temperature)", "position": {"x": 500, "y": 700}},
    {"id": "var-heat-transport-in-polar", "name": "Heat Transport In Polar", "equation": "Heat_Transport_Out_Temp", "position": {"x": 650, "y": 700}},
    {"id": "var-transport-coeff", "name": "Transport Coeff", "equation": "3.5", "position": {"x": 300, "y": 800}},
    {"id": "var-heat-capacity", "name": "Heat Capacity", "equation": "10", "position": {"x": 500, "y": 800}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 100, "dt": 0.25},
  "source": "https://doi.org/10.1175/1520-0450(1969)008<0392:AGCMBO>2.0.CO;2",
  "reference": "Sellers WD. A Global Climatic Model Based on the Energy Balance of the Earth-Atmosphere System. Journal of Applied Meteorology. 1969;8(3):392-400."
}
