      "from_element": "Base_Spread",
      "to_element": "Spread_Rate"
    },
    {
      "id": "conn-10",
      "from_element": "Humidity_Factor",
      "to_element": "Spread_Rate"
    },
    {
      "id": "conn-11",
      "from_element": "Wind_Factor",
      "to_element": "Spread_Rate"
    },
    {
