{
  "id": "forest-fire-spread-cli",
  "name": "Humidity",
  "description": "Illustrative forest fire stock-flow model with heuristic wind, fuel and humidity multipliers. Rothermel (1972) is background on surface fire spread; this file does not implement the published reaction-intensity, propagating-flux and heat-sink formulation. Area, perimeter and fuel units, depletion and calibration require review.",
  "stocks": [
    {
      "id": "s1",
      "name": "Unburned_Forest_Ha",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Active_Fire_Ha",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Burned_Forest_Ha",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Fuel_Load",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Fire_Spread",
      "equation": "Spread_Rate * Perimeter_Length",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Burnout",
      "equation": "Active_Fire_Ha / Residence_Time",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Fuel_Consumption",
      "equation": "Active_Fire_Ha * Consumption_Rate",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "f4",
      "name": "Fuel_Accumulation",
      "equation": "Burned_Forest_Ha * Regrowth_Rate",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Wind_Speed",
      "equation": "10 + 5 * SIN(TIME / 24)",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Humidity",
      "equation": "30 - 10 * SIN(TIME / 24)",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Spread_Rate",
      "equation": "Base_Spread * Wind_Factor * Fuel_Factor * Humidity_Factor",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Base_Spread",
      "equation": "0.5",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Wind_Factor",
      "equation": "1 + Wind_Speed / 20",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Fuel_Factor",
      "equation": "Fuel_Load / 20",
      "position": {
        "x": 400,
        "y": 450
      }
    },
    {
      "id": "v7",
      "name": "Humidity_Factor",
      "equation": "MAX(0.1, 1 - Humidity / 100)",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Perimeter_Length",
      "equation": "2 * 3.14159 * SQRT(Active_Fire_Ha / 3.14159)",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "v9",
      "name": "Residence_Time",
      "equation": "2 / Spread_Rate",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "v10",
      "name": "Consumption_Rate",
      "equation": "0.5",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "v11",
      "name": "Regrowth_Rate",
      "equation": "0.001",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "v12",
      "name": "Fire_Intensity",
      "equation": "Spread_Rate * Fuel_Load * 300",
      "position": {
        "x": 600,
        "y": 100
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Perimeter_Length",
      "to_element": "Fire_Spread"
    },
    {
      "id": "conn-2",
      "from_element": "Spread_Rate",
      "to_element": "Fire_Spread"
    },
    {
      "id": "conn-3",
