{
  "id": "urban-air-quality-model-cli",
  "name": "Urban Air Quality Dynamics Model",
  "description": "A system dynamics model of urban air pollution based on the EPA AERMOD dispersion model concepts and Zhang et al. (2012) 'System dynamics modeling of urban air quality management' (doi:10.1016/j.envsoft.2012.01.011). Models emission sources, atmospheric dispersion, and health impacts. Reference: WHO (2021). Air Quality Guidelines. Source: https://www.who.int/publications/i/item/9789240034228",
  "stocks": [
    {
      "id": "stock-pm25-concentration",
      "name": "PM2.5 Concentration",
      "initial_value": 35,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-nox-concentration",
      "name": "NOx Concentration",
      "initial_value": 40,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "stock-ozone-concentration",
      "name": "Ozone Concentration",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "stock-vehicle-fleet",
      "name": "Vehicle Fleet",
      "initial_value": 2000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "stock-industrial-output",
      "name": "Industrial Output",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "stock-respiratory-cases",
      "name": "Respiratory Health Cases",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 550,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-pm25-emissions",
      "name": "PM2.5 Emissions",
      "equation": "Vehicle_Emissions_PM25 + Industrial_Emissions_PM25 + Background_PM25",
      "from_stock": null,
      "to_stock": "stock-pm25-concentration",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-pm25-dispersion",
      "name": "PM2.5 Dispersion",
      "equation": "PM2_5_Concentration * Dispersion_Rate * Wind_Speed_Factor",
      "from_stock": "stock-pm25-concentration",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-nox-emissions",
      "name": "NOx Emissions",
      "equation": "Vehicle_Emissions_NOx + Industrial_Emissions_NOx",
      "from_stock": null,
      "to_stock": "stock-nox-concentration",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-nox-dispersion",
      "name": "NOx Dispersion",
      "equation": "NOx_Concentration * Dispersion_Rate * Wind_Speed_Factor",
      "from_stock": "stock-nox-concentration",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "flow-ozone-formation",
      "name": "Ozone Formation",
      "equation": "NOx_Concentration * VOC_Level * Solar_Radiation * Ozone_Formation_Rate",
      "from_stock": null,
      "to_stock": "stock-ozone-concentration",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "flow-ozone-decay",
      "name": "Ozone Decay",
      "equation": "Ozone_Concentration * Ozone_Decay_Rate",
      "from_stock": "stock-ozone-concentration",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "flow-health-impact",
      "name": "Health Impact",
      "equation": "Population * (PM2_5_Concentration / 100 + Ozone_Concentration / 150) * Health_Sensitivity",
      "from_stock": null,
      "to_stock": "stock-respiratory-cases",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "flow-health-recovery",
      "name": "Health Recovery",
      "equation": "Respiratory_Health_Cases * Recovery_Rate",
      "from_stock": "stock-respiratory-cases",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 400
      }
    },
    {
      "id": "flow-fleet-growth",
      "name": "Fleet Growth",
      "equation": "Vehicle_Fleet * Fleet_Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-vehicle-fleet",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "flow-industrial-growth",
      "name": "Industrial Growth",
      "equation": "Industrial_Output * Industrial_Growth_Rate",
      "from_stock": null,
      "to_stock": "stock-industrial-output",
      "position": {
        "x": 50,
        "y": 350
      }
    }
  ],
  "variables": [
