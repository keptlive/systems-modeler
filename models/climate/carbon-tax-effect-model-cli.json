{
  "id": "carbon-tax-effect-model-cli",
  "name": "Carbon Tax Economic Effect Model",
  "description": "Model of carbon tax effects on emissions, economic output, and technological change. Explores revenue recycling and competitiveness impacts. Source: Goulder & Hafstead (2018), Confronting the Climate Challenge. DOI: 10.7916/d8-zh9c-yr12",
  "stocks": [
    {
      "id": "stock-emit",
      "name": "Annual_Emissions",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-gdp",
      "name": "GDP",
      "initial_value": 20000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-green-k",
      "name": "Green_Capital",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-revenue",
      "name": "Tax_Revenue",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-emit-reduce",
      "name": "Emission_Reduction",
      "equation": "Annual_Emissions * Carbon_Tax * Elasticity / 100",
      "from_stock": "stock-emit",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "flow-gdp-grow",
      "name": "GDP_Growth",
      "equation": "GDP * (Base_Growth - Carbon_Tax * GDP_Impact / 1000)",
      "from_stock": null,
      "to_stock": "stock-gdp",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-gdp-decline",
      "name": "Economic_Cost",
      "equation": "GDP * Carbon_Tax * 0.0001",
      "from_stock": "stock-gdp",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "flow-green-invest",
      "name": "Green_Investment",
      "equation": "Carbon_Tax * Tax_Revenue * Green_Inv_Share / 100",
      "from_stock": null,
      "to_stock": "stock-green-k",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-tax-collect",
      "name": "Tax_Collection",
      "equation": "Annual_Emissions * Carbon_Tax",
      "from_stock": null,
      "to_stock": "stock-revenue",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "flow-tax-spend",
      "name": "Revenue_Recycling",
      "equation": "Tax_Revenue * Recycling_Rate",
      "from_stock": "stock-revenue",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-tax",
      "name": "Carbon_Tax",
      "equation": "50",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-elast",
      "name": "Elasticity",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-base",
      "name": "Base_Growth",
      "equation": "0.02",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-impact",
      "name": "GDP_Impact",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-green",
      "name": "Green_Inv_Share",
      "equation": "0.3",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-recycle",
      "name": "Recycling_Rate",
      "equation": "0.9",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Carbon_Tax",
      "to_element": "Emission_Reduction"
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "created_at": "2026-01-11T22:15:10.906216+00:00",
  "updated_at": "2026-01-11T22:15:10.906216+00:00",
  "source": "https://doi.org/10.7916/d8-zh9c-yr12",
  "reference": "Goulder, L.H. & Hafstead, M.A.C. (2018). Confronting the Climate Challenge."
}