{
  "id": "hanpp-human-npp-appropriation-cli",
  "name": "Human Appropriation of Net Primary Production",
  "description": "Measures human impact on terrestrial ecosystems through NPP appropriation. Key sustainability indicator. Source: Haberl et al. (2007), PNAS. DOI: 10.1073/pnas.0704243104",
  "stocks": [
    {
      "id": "stock-npp",
      "name": "Available_NPP",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-hanpp",
      "name": "Human_Appropriated_NPP",
      "initial_value": 25,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-prod",
      "name": "NPP_Production",
      "equation": "Potential_NPP * (1 - Land_Conversion_Loss)",
      "from_stock": null,
      "to_stock": "stock-npp",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-approp",
      "name": "Appropriation_Rate",
      "equation": "Available_NPP * Harvest_Fraction",
      "from_stock": "stock-npp",
      "to_stock": "stock-hanpp",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-return",
      "name": "NPP_Return",
      "equation": "Human_Appropriated_NPP * Decomposition_Rate",
      "from_stock": "stock-hanpp",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-pnpp",
      "name": "Potential_NPP",
      "equation": "150",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-landconv",
      "name": "Land_Conversion_Loss",
      "equation": "0.2 + 0.002 * TIME",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-harvest",
      "name": "Harvest_Fraction",
      "equation": "0.3",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-decomp",
      "name": "Decomposition_Rate",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "var-hanpppct",
      "name": "HANPP_Percent",
      "equation": "(Human_Appropriated_NPP / (Available_NPP + Human_Appropriated_NPP)) * 100",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Available_NPP",
      "to_element": "Appropriation_Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-12T02:02:23.927197Z",
  "updated_at": "2026-01-12T02:02:23.927201Z",
  "source": "https://doi.org/10.1073/pnas.0704243104",
  "reference": "Haberl, H. et al. (2007). Quantifying and mapping the human appropriation of net primary production. PNAS."
}