{
  "id": "ice-albedo-feedback-cli",
  "name": "Ice-Albedo Feedback",
  "description": "Arctic ice-albedo feedback model showing how melting ice reduces reflectivity, causing more warming. A key positive feedback in climate system. Source: Based on Curry et al. (1995), Journal of Climate. DOI: 10.1175/1520-0442(1995)008<0240:SIAFAT>2.0.CO;2",
  "stocks": [
    {
      "id": "stock-ice-area",
      "name": "Ice_Area",
      "initial_value": 7.0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-temperature",
      "name": "Arctic_Temperature_Anomaly",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-ice-loss",
      "name": "Ice_Loss",
      "equation": "Ice_Area * Melt_Rate * MAX(0, Arctic_Temperature_Anomaly)",
      "from_stock": "stock-ice-area",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-ice-formation",
      "name": "Ice_Formation",
      "equation": "Base_Ice_Formation * MAX(0, -Arctic_Temperature_Anomaly + 1)",
      "from_stock": null,
      "to_stock": "stock-ice-area",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-warming",
      "name": "Warming",
      "equation": "Radiative_Forcing + Albedo_Feedback_Strength * (7 - Ice_Area)",
      "from_stock": null,
      "to_stock": "stock-temperature",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-cooling",
      "name": "Heat_Loss",
      "equation": "Arctic_Temperature_Anomaly * Heat_Loss_Rate",
      "from_stock": "stock-temperature",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-melt-rate",
      "name": "Melt_Rate",
      "equation": "0.15",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-base-formation",
      "name": "Base_Ice_Formation",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-radiative-forcing",
      "name": "Radiative_Forcing",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 80
      }
    },
    {
      "id": "var-albedo-feedback",
      "name": "Albedo_Feedback_Strength",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 80
      }
    },
    {
      "id": "var-heat-loss-rate",
      "name": "Heat_Loss_Rate",
      "equation": "0.2",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-albedo",
      "name": "Surface_Albedo",
      "equation": "0.3 + 0.4 * (Ice_Area / 7)",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Ice_Area",
      "to_element": "Ice_Loss"
    },
    {
      "id": "conn-2",
      "from_element": "Arctic_Temperature_Anomaly",
      "to_element": "Ice_Loss"
    },
    {
      "id": "conn-3",
      "from_element": "Ice_Area",
      "to_element": "Warming"
    },
    {
      "id": "conn-4",
      "from_element": "Arctic_Temperature_Anomaly",
      "to_element": "Heat_Loss"
    }
  ],
  "time_settings": {
    "start": 2000,
    "end": 2100,
    "dt": 0.5
  },
  "created_at": "2026-01-11T20:47:58.495554Z",
  "updated_at": "2026-01-11T20:47:58.495554Z",
  "source": "https://github.com/SDXorg/PySD-Cookbook",
  "reference": "SDXorg System Dynamics Model Repository"
}