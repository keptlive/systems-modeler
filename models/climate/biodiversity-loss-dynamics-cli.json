{
  "id": "biodiversity-loss-dynamics-cli",
  "name": "Biodiversity Loss Dynamics Model",
  "description": "Model of biodiversity loss including habitat destruction, climate change, and conservation efforts. Source: IPBES (2019), Global Assessment Report. DOI: 10.5281/zenodo.3831673",
  "stocks": [
    {
      "id": "stock-species",
      "name": "Species_Count",
      "initial_value": 8000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-habitat",
      "name": "Intact_Habitat",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-protected",
      "name": "Protected_Areas",
      "initial_value": 150,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-extinct",
      "name": "Extinct_Species",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "stock-threatened",
      "name": "Threatened_Species",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-extinction",
      "name": "Extinction",
      "equation": "Species_Count * Extinction_Rate * (1 - Intact_Habitat / 1000) * Climate_Stress",
      "from_stock": "stock-species",
      "to_stock": "stock-extinct",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "flow-threaten",
      "name": "Become_Threatened",
      "equation": "Species_Count * Threat_Rate * (1 - Protected_Areas / 500)",
      "from_stock": "stock-species",
      "to_stock": "stock-threatened",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "flow-habitat-loss",
      "name": "Habitat_Loss",
      "equation": "Intact_Habitat * Habitat_Destruction_Rate",
      "from_stock": "stock-habitat",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "flow-protect",
      "name": "Protection",
      "equation": "Intact_Habitat * Protection_Rate * Conservation_Investment",
      "from_stock": "stock-habitat",
      "to_stock": "stock-protected",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-recover",
      "name": "Recovery",
      "equation": "Threatened_Species * Recovery_Rate * Protected_Areas / 150",
      "from_stock": "stock-threatened",
      "to_stock": "stock-species",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "flow-threat-extinct",
      "name": "Threatened_Extinction",
      "equation": "Threatened_Species * Extinction_Rate * 5",
      "from_stock": "stock-threatened",
      "to_stock": "stock-extinct",
      "position": {
        "x": 200,
        "y": 450
      }
    }
  ],
  "variables": [
    {
      "id": "var-extinct",
      "name": "Extinction_Rate",
      "equation": "0.0001",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-threat",
      "name": "Threat_Rate",
      "equation": "0.001",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-habitat-d",
      "name": "Habitat_Destruction_Rate",
      "equation": "0.01",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-protect-r",
      "name": "Protection_Rate",
      "equation": "0.005",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-conserve",
      "name": "Conservation_Investment",
      "equation": "1",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-climate",
      "name": "Climate_Stress",
      "equation": "1 + 0.01 * TIME",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-recover",
      "name": "Recovery_Rate",
      "equation": "0.001",
      "position": {
        "x": 350,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Intact_Habitat",
      "to_element": "Extinction"
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "created_at": "2026-01-11T22:18:53.216849+00:00",
  "updated_at": "2026-01-11T22:18:53.216849+00:00",
  "source": "https://doi.org/10.5281/zenodo.3831673",
  "reference": "IPBES (2019). Global Assessment Report on Biodiversity and Ecosystem Services."
}