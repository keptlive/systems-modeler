{
  "id": "carbon-pricing-policy-cli",
  "name": "Carbon Pricing Policy Model",
  "description": "System dynamics model of carbon pricing mechanisms showing effects on emissions, economic activity, and technological innovation. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "stock-emissions",
      "name": "Annual_Emissions",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-cumulative",
      "name": "Cumulative_Emissions",
      "initial_value": 2000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-clean-tech",
      "name": "Clean_Technology_Stock",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-emitting",
      "name": "Emission_Rate",
      "equation": "Annual_Emissions * (1 - Carbon_Price_Effect) * Economic_Activity",
      "from_stock": null,
      "to_stock": "stock-cumulative",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-reduction",
      "name": "Emission_Reduction",
      "equation": "Annual_Emissions * Carbon_Price * Price_Elasticity / 100",
      "from_stock": "stock-emissions",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-innovation",
      "name": "Clean_Tech_Investment",
      "equation": "Carbon_Revenue * Innovation_Share",
      "from_stock": null,
      "to_stock": "stock-clean-tech",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-price",
      "name": "Carbon_Price",
      "equation": "50",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-elasticity",
      "name": "Price_Elasticity",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-activity",
      "name": "Economic_Activity",
      "equation": "1.0",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-revenue",
      "name": "Carbon_Revenue",
      "equation": "Annual_Emissions * Carbon_Price",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-share",
      "name": "Innovation_Share",
      "equation": "0.25",
      "position": {
        "x": 100,
        "y": 430
      }
    },
    {
      "id": "var-effect",
      "name": "Carbon_Price_Effect",
      "equation": "0.02 * Carbon_Price / 100",
      "position": {
        "x": 350,
        "y": 100
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Annual_Emissions",
      "to_element": "Emission_Rate"
    },
    {
      "id": "c2",
      "from_element": "Carbon_Price_Effect",
      "to_element": "Emission_Rate"
    },
    {
      "id": "c3",
      "from_element": "Economic_Activity",
      "to_element": "Emission_Rate"
    },
    {
      "id": "c4",
      "from_element": "Annual_Emissions",
      "to_element": "Emission_Reduction"
    },
    {
      "id": "c5",
      "from_element": "Carbon_Price",
      "to_element": "Emission_Reduction"
    },
    {
      "id": "c6",
      "from_element": "Price_Elasticity",
      "to_element": "Emission_Reduction"
    },
    {
      "id": "c7",
      "from_element": "Carbon_Revenue",
      "to_element": "Clean_Tech_Investment"
    },
    {
      "id": "c8",
      "from_element": "Innovation_Share",
      "to_element": "Clean_Tech_Investment"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 1
  },
  "created_at": "2026-01-12T11:47:36.905373Z",
  "updated_at": "2026-01-12T11:47:36.905377Z",
  "source": "https://doi.org/10.1073/pnas.1609244114",
  "reference": "Nordhaus WD. Revisiting the social cost of carbon. PNAS. 2017;114(7):1518-1523. Nobel Prize in Economics 2018."
}