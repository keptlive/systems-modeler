{
  "id": "circular-economy-materials-cli",
  "name": "Circular Economy Materials Model",
  "description": "A model of material flows in a circular economy, showing how recycling and reuse can reduce virgin resource extraction and waste. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1038/s41560-019-0462-6",
  "reference": "Ellen MacArthur Foundation. Towards the Circular Economy. 2013.",
  "stocks": [
    {
      "id": "stock-virgin",
      "name": "Virgin Resources",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-products",
      "name": "Products in Use",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-waste",
      "name": "Waste",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-recycled",
      "name": "Recycled Materials",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-extraction",
      "name": "Extraction",
      "equation": "Production_Demand * (1 - Recycled_Share)",
      "from_stock": "stock-virgin",
      "to_stock": "stock-products",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-recycled-use",
      "name": "Recycled Input",
      "equation": "Production_Demand * Recycled_Share",
      "from_stock": "stock-recycled",
      "to_stock": "stock-products",
      "position": {
        "x": 250,
        "y": 275
      }
    },
    {
      "id": "flow-disposal",
      "name": "Disposal",
      "equation": "Products_in_Use / Product_Lifetime * (1 - Collection_Rate)",
      "from_stock": "stock-products",
      "to_stock": "stock-waste",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-collection",
      "name": "Collection",
      "equation": "Products_in_Use / Product_Lifetime * Collection_Rate",
      "from_stock": "stock-products",
      "to_stock": "stock-recycled",
      "position": {
        "x": 300,
        "y": 275
      }
    },
    {
      "id": "flow-landfill",
      "name": "Landfill",
      "equation": "Waste * Landfill_Rate",
      "from_stock": "stock-waste",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "flow-recycling-loss",
      "name": "Recycling Loss",
      "equation": "Recycled_Materials * (1 - Recycling_Efficiency) / Recycling_Time",
      "from_stock": "stock-recycled",
      "to_stock": "stock-waste",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-demand",
      "name": "Production Demand",
      "equation": "500 * (1 + Growth_Rate * TIME)",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-recycled-share",
      "name": "Recycled Share",
      "equation": "MIN(0.8, Recycled_Materials / (Recycled_Materials + Virgin_Resources + 1))",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-circularity",
      "name": "Circularity Index",
      "equation": "Recycled_Input / (Extraction + Recycled_Input)",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-lifetime",
      "name": "Product Lifetime",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-collection",
      "name": "Collection Rate",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-recycling-eff",
      "name": "Recycling Efficiency",
      "equation": "0.8",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-recycling-time",
      "name": "Recycling Time",
      "equation": "1",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-landfill",
      "name": "Landfill Rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-growth",
      "name": "Growth Rate",
      "equation": "0.02",
      "position": {
        "x": 600,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-11T21:51:23.907018+00:00",
  "updated_at": "2026-01-11T21:51:23.907018+00:00"
}