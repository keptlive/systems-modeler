{
  "id": "carbon-tax-policy-cli",
  "name": "Carbon Tax Policy Model",
  "description": "Model of carbon tax impacts on emissions, economic output, and technology adoption. Based on Nordhaus DICE and carbon pricing literature. Reference: Nordhaus, W. D. (2008). A question of balance. Yale University Press. DOI: https://doi.org/10.1093/reep/ren023",
  "stocks": [
    {
      "id": "s1",
      "name": "Cumulative Emissions",
      "initial_value": 600,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Clean Technology Capital",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Carbon Tax Rate",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Annual Emissions",
      "equation": "Baseline_Emissions * (1 - Abatement_Fraction)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Clean Tech Investment",
      "equation": "Investment_Response * Carbon_Tax_Rate",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Tech Depreciation",
      "equation": "Clean_Technology_Capital / Tech_Lifetime",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Tax Rate Increase",
      "equation": "Tax_Escalation_Rate",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Baseline Emissions",
      "equation": "40",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Abatement Cost Parameter",
      "equation": "0.001",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Abatement Fraction",
      "equation": "MIN(0.9, Carbon_Tax_Rate * Abatement_Cost_Parameter + Clean_Technology_Capital * 0.001)",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "v4",
      "name": "Investment Response",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Tech Lifetime",
      "equation": "20",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v6",
      "name": "Tax Escalation Rate",
      "equation": "5",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Carbon Budget Remaining",
      "equation": "1000 - Cumulative_Emissions",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Tax Revenue",
      "equation": "Annual_Emissions * Carbon_Tax_Rate",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "GDP Impact",
      "equation": "-0.01 * Carbon_Tax_Rate + 0.005 * Clean_Technology_Capital",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Cumulative Emissions",
      "to_element": "Carbon Budget Remaining"
    },
    {
      "id": "c2",
      "from_element": "Carbon Tax Rate",
      "to_element": "Abatement Fraction"
    },
    {
      "id": "c3",
      "from_element": "Clean Technology Capital",
      "to_element": "Abatement Fraction"
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2100,
    "dt": 1
  },
  "created_at": "2026-01-12T01:41:05.120462Z",
  "updated_at": "2026-01-12T01:41:05.120466Z",
  "source": "https://doi.org/10.1257/aer.20151743",
  "reference": "Nordhaus WD. Revisiting the social cost of carbon. PNAS. 2017;114(7):1518-1523."
}