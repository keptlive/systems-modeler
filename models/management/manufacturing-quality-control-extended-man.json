{
  "id": "manufacturing-quality-control-extended-man",
  "name": "Manufacturing Quality Control Extended Model",
  "description": "An extended system dynamics model of manufacturing quality control. Models the feedback loops between production rate, defect rates, inspection, rework, worker skill development, and the effects of quality on customer satisfaction and orders. Reference: Juran, J. M. (1999). Juran's Quality Handbook. McGraw-Hill. Source: https://www.mheducation.com/",
  "stocks": [
    {
      "id": "stock-wip",
      "name": "Work in Progress",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-finished-good",
      "name": "Finished Good Inventory",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-defective",
      "name": "Defective Units",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "stock-rework-queue",
      "name": "Rework Queue",
      "initial_value": 30,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "stock-worker-skill",
      "name": "Average Worker Skill",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 100,
        "y": 450
      }
    },
    {
      "id": "stock-customer-satisfaction",
      "name": "Customer Satisfaction",
      "initial_value": 85,
      "equation": "",
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "stock-order-backlog",
      "name": "Order Backlog",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 600,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-production-start",
      "name": "Production Start",
      "equation": "Desired_Production_Rate",
      "from_stock": null,
      "to_stock": "stock-wip",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-production-complete",
      "name": "Production Complete",
      "equation": "Work_in_Progress / Production_Time",
      "from_stock": "stock-wip",
      "to_stock": "stock-finished-good",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-inspection-pass",
      "name": "Inspection Pass",
      "equation": "Production_Complete * (1 - Defect_Rate)",
      "from_stock": null,
      "to_stock": "stock-finished-good",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "flow-inspection-fail",
      "name": "Inspection Fail",
      "equation": "Production_Complete * Defect_Rate * (1 - Escape_Rate)",
      "from_stock": null,
      "to_stock": "stock-defective",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "flow-escaped-defects",
      "name": "Escaped Defects",
      "equation": "Production_Complete * Defect_Rate * Escape_Rate",
      "from_stock": null,
      "to_stock": "stock-finished-good",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "flow-to-rework",
      "name": "To Rework",
      "equation": "Defective_Units * Rework_Fraction / Decision_Time",
      "from_stock": "stock-defective",
      "to_stock": "stock-rework-queue",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "flow-scrap",
      "name": "Scrap",
      "equation": "Defective_Units * (1 - Rework_Fraction) / Decision_Time",
      "from_stock": "stock-defective",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "flow-rework-complete",
      "name": "Rework Complete",
      "equation": "Rework_Queue / Rework_Time",
      "from_stock": "stock-rework-queue",
      "to_stock": "stock-wip",
      "position": {
        "x": 200,
        "y": 225
      }
    },
    {
      "id": "flow-shipments",
      "name": "Shipments",
      "equation": "MIN(Finished_Good_Inventory / Shipping_Time, Order_Backlog / Fulfillment_Time)",
      "from_stock": "stock-finished-good",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "flow-skill-development",
      "name": "Skill Development",
      "equation": "(Skill_Ceiling - Average_Worker_Skill) * Learning_Rate",
      "from_stock": null,
      "to_stock": "stock-worker-skill",
      "position": {
        "x": 100,
        "y": 520
      }
    },
    {
      "id": "flow-skill-decay",
      "name": "Skill Decay",
      "equation": "Average_Worker_Skill * Turnover_Effect",
      "from_stock": "stock-worker-skill",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "flow-satisfaction-change",
      "name": "Satisfaction Change",
      "equation": "(Quality_Performance - Customer_Satisfaction) / Satisfaction_Adjustment",
      "from_stock": null,
      "to_stock": "stock-customer-satisfaction",
      "position": {
        "x": 600,
        "y": 50
      }
    },
    {
      "id": "flow-orders-in",
      "name": "Incoming Orders",
      "equation": "Base_Orders * Satisfaction_Effect",
      "from_stock": null,
      "to_stock": "stock-order-backlog",
      "position": {
        "x": 700,
        "y": 300
      }
    },
    {
      "id": "flow-orders-filled",
      "name": "Orders Filled",
      "equation": "Shipments",
      "from_stock": "stock-order-backlog",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-desired-production",
      "name": "Desired Production Rate",
      "equation": "Order_Backlog / Target_Lead_Time + (Target_Inventory - Finished_Good_Inventory) / Inventory_Adjustment",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-target-lead-time",
      "name": "Target Lead Time",
      "equation": "5",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-target-inventory",
      "name": "Target Inventory",
      "equation": "1000",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-inventory-adjustment",
      "name": "Inventory Adjustment",
      "equation": "10",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "var-production-time",
      "name": "Production Time",
      "equation": "2",
      "position": {
        "x": 700,
        "y": 50
      }
    },
    {
      "id": "var-defect-rate",
      "name": "Defect Rate",
      "equation": "Base_Defect_Rate * (100 / Average_Worker_Skill) * Pressure_Effect",
      "position": {
        "x": 100,
        "y": 550
      }
    },
    {
      "id": "var-base-defect",
      "name": "Base Defect Rate",
      "equation": "0.05",
      "position": {
        "x": 250,
        "y": 550
      }
    },
    {
      "id": "var-pressure-effect",
      "name": "Pressure Effect",
      "equation": "1 + MAX(0, (Order_Backlog / 500 - 1) * 0.5)",
      "position": {
        "x": 400,
        "y": 550
      }
    },
    {
      "id": "var-escape-rate",
      "name": "Escape Rate",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 550
      }
    },
    {
      "id": "var-rework-fraction",
      "name": "Rework Fraction",
      "equation": "0.7",
      "position": {
        "x": 700,
        "y": 550
      }
    },
    {
      "id": "var-decision-time",
      "name": "Decision Time",
      "equation": "1",
      "position": {
        "x": 100,
        "y": 650
      }
    },
    {
      "id": "var-rework-time",
      "name": "Rework Time",
      "equation": "3",
      "position": {
        "x": 250,
        "y": 650
      }
    },
    {
      "id": "var-shipping-time",
      "name": "Shipping Time",
      "equation": "1",
      "position": {
        "x": 400,
        "y": 650
      }
    },
    {
      "id": "var-fulfillment-time",
      "name": "Fulfillment Time",
      "equation": "2",
      "position": {
        "x": 550,
        "y": 650
      }
    },
    {
      "id": "var-skill-ceiling",
      "name": "Skill Ceiling",
      "equation": "100",
      "position": {
        "x": 700,
        "y": 650
      }
    },
    {
      "id": "var-learning-rate",
      "name": "Learning Rate",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 750
      }
    },
    {
      "id": "var-turnover-effect",
      "name": "Turnover Effect",
      "equation": "0.005",
      "position": {
        "x": 250,
        "y": 750
      }
    },
    {
      "id": "var-quality-performance",
      "name": "Quality Performance",
      "equation": "100 * (1 - Defect_Rate * Escape_Rate)",
      "position": {
        "x": 400,
        "y": 750
      }
    },
    {
      "id": "var-satisfaction-adjustment",
      "name": "Satisfaction Adjustment",
      "equation": "20",
      "position": {
        "x": 550,
        "y": 750
      }
    },
    {
      "id": "var-base-orders",
      "name": "Base Orders",
      "equation": "100",
      "position": {
        "x": 700,
        "y": 750
      }
    },
    {
      "id": "var-satisfaction-effect",
      "name": "Satisfaction Effect",
      "equation": "Customer_Satisfaction / 85",
      "position": {
        "x": 100,
        "y": 850
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Work in Progress",
      "to_element": "Production Complete"
    },
    {
      "id": "conn-2",
      "from_element": "Defect Rate",
      "to_element": "Inspection Fail"
    },
    {
      "id": "conn-3",
      "from_element": "Average Worker Skill",
      "to_element": "Defect Rate"
    },
    {
      "id": "conn-4",
      "from_element": "Pressure Effect",
      "to_element": "Defect Rate"
    },
    {
      "id": "conn-5",
      "from_element": "Defective Units",
      "to_element": "To Rework"
    },
    {
      "id": "conn-6",
      "from_element": "Rework Queue",
      "to_element": "Rework Complete"
    },
    {
      "id": "conn-7",
      "from_element": "Quality Performance",
      "to_element": "Satisfaction Change"
    },
    {
      "id": "conn-8",
      "from_element": "Customer Satisfaction",
      "to_element": "Satisfaction Effect"
    },
    {
      "id": "conn-9",
      "from_element": "Satisfaction Effect",
      "to_element": "Incoming Orders"
    },
    {
      "id": "conn-10",
      "from_element": "Order Backlog",
      "to_element": "Desired Production Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-11T21:00:00.000000Z",
  "updated_at": "2026-01-11T21:00:00.000000Z",
  "source": "https://doi.org/10.1287/mnsc.35.3.321",
  "reference": "Sterman JD. Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill, 2000."
}