      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Order_Rate",
      "equation": "15",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Throughput",
      "equation": "Bottleneck_Output",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Total_WIP",
      "equation": "WIP_Station_A + WIP_Bottleneck + WIP_Station_C",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Cycle_Time",
      "equation": "Total_WIP / MAX(1, Throughput)",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Bottleneck_Utilization",
      "equation": "Bottleneck_Output / Bottleneck_Capacity",
