      "to_stock": "WIP_Bottleneck",
      "position": {
        "x": 220,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Bottleneck_Output",
      "equation": "MIN(WIP_Bottleneck, Bottleneck_Capacity)",
      "from_stock": "WIP_Bottleneck",
      "to_stock": "WIP_Station_C",
      "position": {
        "x": 340,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Station_C_Output",
      "equation": "MIN(WIP_Station_C, Station_C_Capacity)",
      "from_stock": "WIP_Station_C",
      "to_stock": "Finished_Goods",
      "position": {
        "x": 460,
        "y": 300
      }
    },
    {
      "id": "f5",
      "name": "Material_Arrival",
      "equation": "Order_Rate",
      "from_stock": null,
      "to_stock": "Raw_Materials",
      "position": {
        "x": 580,
        "y": 300
      }
    }
  ],
  "variables": [
