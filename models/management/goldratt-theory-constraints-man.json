      }
    },
    {
      "id": "s2",
      "name": "WIP_Station_A",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "WIP_Bottleneck",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "WIP_Station_C",
