  "flows": [
    {
      "id": "f1",
      "name": "Material_Release",
      "equation": "MIN(Raw_Materials, Drum_Rate)",
      "from_stock": "Raw_Materials",
      "to_stock": "WIP_Station_A",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Station_A_Output",
      "equation": "MIN(WIP_Station_A, Station_A_Capacity)",
