        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Bottleneck_Capacity",
      "equation": "10",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Station_C_Capacity",
      "equation": "25",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Drum_Rate",
