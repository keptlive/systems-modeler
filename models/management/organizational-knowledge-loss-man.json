{
  "id": "organizational-knowledge-loss-man",
  "name": "Organizational Knowledge Loss Model",
  "description": "Model of knowledge loss from employee turnover. Source: Hom et al. (2017), J Applied Psychology.",
  "stocks": [
    {
      "id": "stock-expert",
      "name": "Expert_Knowledge",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-org",
      "name": "Organizational_Knowledge",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-learn",
      "name": "Knowledge_Creation",
      "equation": "Expert_Knowledge * Creation_Rate",
      "from_stock": null,
      "to_stock": "stock-org",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-transfer",
      "name": "Knowledge_Transfer",
      "equation": "Organizational_Knowledge * Transfer_Rate * Expert_Knowledge / 100",
      "from_stock": null,
      "to_stock": "stock-expert",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "flow-turnover",
      "name": "Knowledge_Loss",
      "equation": "Expert_Knowledge * Turnover_Rate",
      "from_stock": "stock-expert",
      "to_stock": null,
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-deprec",
      "name": "Knowledge_Depreciation",
      "equation": "Organizational_Knowledge * Depreciation_Rate",
      "from_stock": "stock-org",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-create",
      "name": "Creation_Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-transfer",
      "name": "Transfer_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-turnover",
      "name": "Turnover_Rate",
      "equation": "0.15",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-deprec",
      "name": "Depreciation_Rate",
      "equation": "0.02",
      "position": {
        "x": 350,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T12:53:13.193380+00:00",
  "updated_at": "2026-01-12T12:53:13.193380+00:00",
  "source": "https://doi.org/10.1002/hrm.21899",
  "reference": "Hom PW, et al. One hundred years of employee turnover theory and research. Journal of Applied Psychology. 2017;102(3):530-545."
}