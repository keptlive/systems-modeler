{
  "id": "workforce-overtime-morale-man",
  "name": "Workforce, Overtime and Morale \u2014 Vensim INTRO",
  "description": "Source reconstruction of Vensim INTRO.mdl (downloaded 2026-10-20). Workforce and average worker hours follow the original integrators, sales step and two graphical functions. Morale is a graphical auxiliary, not an invented stock; The unsupported backlog accumulator, quit-rate and target-backlog hybrid are archived in the repair receipt rather than presented as source equations. All source parameters are the native INTRO defaults. The saved 0\u2013200 month horizon and 0.5 month Euler grid are retained; INTRO uses end100, integration0.125, SAVEPER1. This is an educational model, not workforce forecasting.",
  "stocks": [
    {
      "id": "s1",
      "name": "Workforce",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-average-worker-hours",
      "name": "Average_Worker_Hours",
      "initial_value": 40,
      "equation": "Normal_Hours",
      "position": {
        "x": 400,
        "y": 200
      },
      "units": "hours/month"
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Hiring",
      "equation": "(Desired_Workforce - Workforce) / Hiring_Time",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Change_in_Hours_Worked",
      "equation": "(Hours_Worked - Average_Worker_Hours) / Overtime_Adjustment_Time",
      "from_stock": null,
      "to_stock": "stock-average-worker-hours",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Desired_Workforce",
      "equation": "Work_Arrival_Rate / Productivity",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Hiring_Time",
      "equation": "6",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "v4",
      "name": "Target_Morale",
      "equation": "Morale",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Overtime_Adjustment_Time",
      "equation": "3",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Work_Arrival_Rate",
      "equation": "IF(TIME > 20, 120, 100)",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Productivity",
      "equation": "Normal_Productivity * LOOKUP(Productivity_Response, Morale)",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "v8",
      "name": "Hours_Worked",
      "equation": "Work_Arrival_Rate / (Workforce * Productivity) * Normal_Hours",
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Normal_Hours",
      "equation": "40",
      "position": {
        "x": 750,
        "y": 300
      }
    },
    {
      "id": "v10",
      "name": "Overtime_Fraction",
      "equation": "Average_Worker_Hours / Normal_Hours - 1",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "s2",
      "name": "Morale",
      "position": {
        "x": 400,
        "y": 200
      },
      "equation": "LOOKUP(Morale_Response, Average_Worker_Hours / Normal_Hours)"
    },
    {
      "id": "f4",
      "name": "Work_Arrival",
      "position": {
        "x": 500,
        "y": 200
      },
      "equation": "Work_Arrival_Rate"
    },
    {
      "id": "f5",
      "name": "Work_Completion",
      "position": {
        "x": 700,
        "y": 200
      },
      "equation": "Workforce * Hours_Worked * Productivity / Normal_Hours"
    },
    {
      "id": "var-normal-productivity-source",
      "name": "Normal_Productivity",
      "equation": "1",
      "position": {
        "x": 650,
        "y": 400
      },
      "units": "widgets/(month*person)"
    }
  ],
  "connectors": [
