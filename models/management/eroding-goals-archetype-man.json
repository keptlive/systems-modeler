{
  "id": "eroding-goals-archetype-man",
  "name": "Eroding Goals Archetype",
  "description": "The 'Eroding Goals' or 'Drifting Goals' archetype demonstrates how performance targets gradually decline. When there's a gap between actual performance and goals, the response is often to lower the goal rather than improve performance. Over time, standards erode, expectations diminish, and what was once unacceptable becomes the new normal. Reference: Senge, P. M. (1990). The Fifth Discipline: Eroding Goals Archetype. Doubleday. Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-goal",
      "name": "Goal",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-actual-performance",
      "name": "Actual Performance",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-goal-erosion",
      "name": "Goal Erosion",
      "equation": "IF Gap > 0 THEN Goal_Erosion_Rate * Gap ELSE 0",
      "from_stock": "stock-goal",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-performance-improvement",
      "name": "Performance Improvement",
      "equation": "IF Gap > 0 THEN Improvement_Rate * Gap ELSE 0",
      "from_stock": null,
      "to_stock": "stock-actual-performance",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-performance-decline",
      "name": "Performance Decline",
      "equation": "External_Pressure + Natural_Decay",
      "from_stock": "stock-actual-performance",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-gap",
      "name": "Gap",
      "equation": "Goal - Actual_Performance",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-goal-erosion-rate",
      "name": "Goal Erosion Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-improvement-rate",
      "name": "Improvement Rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-external-pressure",
      "name": "External Pressure",
      "equation": "1",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-natural-decay",
      "name": "Natural Decay",
      "equation": "0.01 * Actual_Performance",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-relative-goal",
      "name": "Relative Goal",
      "equation": "Goal / 100",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "var-performance-gap-ratio",
      "name": "Performance Gap Ratio",
      "equation": "IF Goal > 0 THEN Gap / Goal ELSE 0",
      "position": {
        "x": 250,
        "y": 160
      }
    },
    {
      "id": "var-equilibrium-performance",
      "name": "Equilibrium Performance",
      "equation": "External_Pressure / Natural_Decay * 100",
      "position": {
        "x": 400,
        "y": 160
      }
    },
    {
      "id": "var-goals-vs-improvement",
      "name": "Goals vs Improvement",
      "equation": "Goal_Erosion_Rate / (Goal_Erosion_Rate + Improvement_Rate)",
      "position": {
        "x": 550,
        "y": 160
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Gap",
      "to_element": "Goal Erosion"
    },
    {
      "id": "conn-2",
      "from_element": "Goal Erosion Rate",
      "to_element": "Goal Erosion"
    },
    {
      "id": "conn-3",
      "from_element": "Gap",
      "to_element": "Performance Improvement"
    },
    {
      "id": "conn-4",
      "from_element": "Improvement Rate",
      "to_element": "Performance Improvement"
    },
    {
      "id": "conn-5",
      "from_element": "External Pressure",
      "to_element": "Performance Decline"
    },
    {
      "id": "conn-6",
      "from_element": "Actual Performance",
      "to_element": "Natural Decay"
    },
    {
      "id": "conn-7",
      "from_element": "Goal",
      "to_element": "Gap"
    },
    {
      "id": "conn-8",
      "from_element": "Actual Performance",
      "to_element": "Gap"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-11T20:04:50.823833Z",
  "updated_at": "2026-01-11T20:04:50.823833Z",
  "source": "https://doi.org/10.1287/mnsc.35.3.321",
  "reference": "Sterman JD. Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill, 2000."
}