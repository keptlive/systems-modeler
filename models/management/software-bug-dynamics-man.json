{
  "id": "software-bug-dynamics-man",
  "name": "Software Bug Dynamics Model",
  "description": "A model of software defect introduction, detection, and fixing during development. Based on software engineering research on quality dynamics. Reference: Juran, J. M. (1999). Juran's Quality Handbook. McGraw-Hill. Source: https://www.mheducation.com/",
  "source": "https://doi.org/10.1109/TSE.2003.1191795",
  "reference": "Boehm BW. Software Engineering Economics. Prentice Hall, 1981.",
  "stocks": [
    {
      "id": "stock-latent",
      "name": "Latent Bugs",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-detected",
      "name": "Detected Bugs",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-fixed",
      "name": "Fixed Bugs",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-introduction",
      "name": "Bug Introduction",
      "equation": "Development_Rate * Bug_Injection_Rate * (1 - Quality_Factor)",
      "from_stock": null,
      "to_stock": "stock-latent",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-detection",
      "name": "Bug Detection",
      "equation": "Latent_Bugs * Detection_Rate * Testing_Effort",
      "from_stock": "stock-latent",
      "to_stock": "stock-detected",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-fixing",
      "name": "Bug Fixing",
      "equation": "Detected_Bugs * Fixing_Rate * Developer_Availability",
      "from_stock": "stock-detected",
      "to_stock": "stock-fixed",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-regression",
      "name": "Regression Bugs",
      "equation": "Bug_Fixing * Regression_Rate",
      "from_stock": null,
      "to_stock": "stock-latent",
      "position": {
        "x": 350,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-total-bugs",
      "name": "Total Open Bugs",
      "equation": "Latent_Bugs + Detected_Bugs",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-dev-rate",
      "name": "Development Rate",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-injection",
      "name": "Bug Injection Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-quality",
      "name": "Quality Factor",
      "equation": "0.3",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-detection",
      "name": "Detection Rate",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-testing",
      "name": "Testing Effort",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-fixing",
      "name": "Fixing Rate",
      "equation": "0.2",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "var-dev-avail",
      "name": "Developer Availability",
      "equation": "0.8",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-regression",
      "name": "Regression Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
