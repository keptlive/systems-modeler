{
  "id": "industrial-dynamics-production-man",
  "name": "Industrial Dynamics Production Model",
  "description": "A model of production and inventory dynamics from Jay Forrester's pioneering work Industrial Dynamics (1961). Shows how production delays and inventory policies create oscillations in manufacturing systems. Reference: Forrester, J. W. (1961). Industrial Dynamics. MIT Press. Source: https://systemdynamics.org/",
  "source": "https://doi.org/10.1002/sdr.4260160107",
  "reference": "Forrester JW. Industrial Dynamics. MIT Press, 1961.",
  "stocks": [
    {
      "id": "stock-inventory",
      "name": "Inventory",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-wip",
      "name": "Work in Progress",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-orders",
      "name": "Backlog",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-production-start",
      "name": "Production Start",
      "equation": "Desired_Production",
      "from_stock": null,
      "to_stock": "stock-wip",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-production-completion",
      "name": "Production Completion",
      "equation": "Work_in_Progress / Production_Delay",
      "from_stock": "stock-wip",
      "to_stock": "stock-inventory",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-shipments",
      "name": "Shipments",
      "equation": "MIN(Backlog / Shipment_Delay, Inventory / Shipment_Delay)",
      "from_stock": "stock-inventory",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-incoming-orders",
      "name": "Incoming Orders",
      "equation": "Order_Rate",
      "from_stock": null,
      "to_stock": "stock-orders",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "flow-order-fulfillment",
      "name": "Order Fulfillment",
      "equation": "Shipments",
      "from_stock": "stock-orders",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-desired-prod",
      "name": "Desired Production",
      "equation": "Expected_Orders + (Desired_Inventory - Inventory) / Inventory_Adj_Time + (Desired_WIP - Work_in_Progress) / WIP_Adj_Time",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-expected-orders",
      "name": "Expected Orders",
      "equation": "Order_Rate * Smoothing_Factor",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-order-rate",
      "name": "Order Rate",
      "equation": "100 + 20 * STEP(1, 10)",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-prod-delay",
      "name": "Production Delay",
      "equation": "5",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-ship-delay",
      "name": "Shipment Delay",
      "equation": "1",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-desired-inv",
      "name": "Desired Inventory",
      "equation": "Expected_Orders * Inventory_Coverage",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-inv-coverage",
      "name": "Inventory Coverage",
      "equation": "10",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-inv-adj",
      "name": "Inventory Adj Time",
      "equation": "8",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "var-desired-wip",
      "name": "Desired WIP",
      "equation": "Expected_Orders * Production_Delay",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "var-wip-adj",
      "name": "WIP Adj Time",
      "equation": "4",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-smooth",
      "name": "Smoothing Factor",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-11T21:45:15.056726+00:00",
  "updated_at": "2026-01-11T21:45:15.056726+00:00"
}