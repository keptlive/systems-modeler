{
  "id": "software-project-dynamics-man",
  "name": "Software Project Dynamics",
  "description": "Software project management model showing schedule pressure, quality, and rework dynamics. Based on models by Cooper (1980) and Sterman (2000). Demonstrates how schedule pressure leads to quality shortcuts that increase rework. Source: Cooper, K.G. (1980), Naval Research Logistics. DOI: 10.1002/nav.3800270409",
  "stocks": [
    {
      "id": "stock-tasks-todo",
      "name": "Tasks_To_Do",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "stock-tasks-done",
      "name": "Tasks_Completed",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "stock-undiscovered-rework",
      "name": "Undiscovered_Rework",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "stock-known-rework",
      "name": "Known_Rework",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-task-completion",
      "name": "Task_Completion",
      "equation": "Workforce * Productivity * (1 - Fraction_Reworking)",
      "from_stock": "stock-tasks-todo",
      "to_stock": "stock-tasks-done",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-error-generation",
      "name": "Error_Generation",
      "equation": "Task_Completion * Error_Rate",
      "from_stock": null,
      "to_stock": "stock-undiscovered-rework",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "flow-error-discovery",
      "name": "Error_Discovery",
      "equation": "Undiscovered_Rework / Error_Discovery_Time",
      "from_stock": "stock-undiscovered-rework",
      "to_stock": "stock-known-rework",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "flow-rework-completion",
      "name": "Rework_Completion",
      "equation": "Known_Rework * Workforce * Productivity * Fraction_Reworking / Tasks_To_Do",
      "from_stock": "stock-known-rework",
      "to_stock": "stock-tasks-done",
      "position": {
        "x": 150,
        "y": 225
      }
    }
  ],
  "variables": [
    {
      "id": "var-workforce",
      "name": "Workforce",
      "equation": "50",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-productivity",
      "name": "Productivity",
      "equation": "1 - 0.5 * Schedule_Pressure",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-schedule-pressure",
      "name": "Schedule_Pressure",
      "equation": "MAX(0, MIN(1, (Tasks_To_Do + Known_Rework - Workforce * 20) / 500))",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-error-rate",
      "name": "Error_Rate",
      "equation": "0.1 + 0.3 * Schedule_Pressure",
      "position": {
        "x": 500,
        "y": 230
      }
    },
    {
      "id": "var-discovery-time",
      "name": "Error_Discovery_Time",
      "equation": "10",
      "position": {
        "x": 350,
        "y": 380
      }
    },
    {
      "id": "var-fraction-reworking",
      "name": "Fraction_Reworking",
      "equation": "MIN(0.5, Known_Rework / (Tasks_To_Do + Known_Rework + 1))",
      "position": {
        "x": 100,
        "y": 380
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Workforce",
      "to_element": "Task_Completion"
    },
    {
      "id": "conn-2",
      "from_element": "Productivity",
      "to_element": "Task_Completion"
    },
    {
      "id": "conn-3",
      "from_element": "Schedule_Pressure",
      "to_element": "Productivity"
    },
    {
      "id": "conn-4",
      "from_element": "Schedule_Pressure",
      "to_element": "Error_Rate"
    },
    {
      "id": "conn-5",
      "from_element": "Tasks_To_Do",
      "to_element": "Schedule_Pressure"
    },
    {
      "id": "conn-6",
      "from_element": "Known_Rework",
      "to_element": "Schedule_Pressure"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-11T20:47:58.493353Z",
  "updated_at": "2026-01-11T20:47:58.493353Z",
  "source": "https://doi.org/10.1287/mnsc.35.3.321",
  "reference": "Sterman JD. Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill, 2000."
}