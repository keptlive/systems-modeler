{
  "id": "deming-quality-management-man",
  "name": "Deming Quality Management Model",
  "description": "W. Edwards Deming's model of continuous quality improvement and the PDCA cycle. Reference: Deming, W.E. (1986). Out of the Crisis.",
  "stocks": [
    {
      "id": "s1",
      "name": "Process_Quality",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Defects",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Knowledge",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Customer_Satisfaction",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Quality_Improvement",
      "equation": "Knowledge * Learning_Rate * (100 - Process_Quality) / 100",
      "from_stock": null,
      "to_stock": "Process_Quality",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Defect_Reduction",
      "equation": "Process_Quality * Improvement_Effect - New_Defects",
      "from_stock": "Defects",
      "to_stock": null,
      "position": {
        "x": 220,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Learning",
      "equation": "Training_Investment + Defects * Feedback_Learning",
      "from_stock": null,
      "to_stock": "Knowledge",
      "position": {
        "x": 340,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Satisfaction_Change",
      "equation": "(Process_Quality - Defects - Customer_Satisfaction) * Response_Rate",
      "from_stock": null,
      "to_stock": "Customer_Satisfaction",
      "position": {
        "x": 460,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Learning_Rate",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Improvement_Effect",
      "equation": "0.05",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "New_Defects",
      "equation": "(100 - Process_Quality) * 0.1",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Training_Investment",
      "equation": "1",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Feedback_Learning",
      "equation": "0.02",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Response_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Sigma_Level",
      "equation": "Process_Quality / 20",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Cost_Of_Quality",
      "equation": "Defects * 100",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "PDCA_Cycle",
      "equation": "1 + SIN(time / 5)",
      "position": {
        "x": 100,
        "y": 150
      }
    }
  ],
  "connectors": [],
