{
  "id": "hiring-chain-pipeline-man",
  "name": "Hiring Chain Pipeline",
  "description": "Employee hiring pipeline model showing recruitment, training, and productivity ramp-up. Models delays between hiring decision and productive output. Source: Based on workforce models in Sterman's Business Dynamics. Reference: Sterman, J. D. (2000). Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill. Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-recruiting",
      "name": "Candidates_In_Pipeline",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-training",
      "name": "Employees_In_Training",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-productive",
      "name": "Productive_Employees",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-recruiting",
      "name": "Recruiting",
      "equation": "Desired_Hiring_Rate",
      "from_stock": null,
      "to_stock": "stock-recruiting",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-hiring",
      "name": "Hiring",
      "equation": "Candidates_In_Pipeline / Recruiting_Time",
      "from_stock": "stock-recruiting",
      "to_stock": "stock-training",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-training-complete",
      "name": "Training_Completion",
      "equation": "Employees_In_Training / Training_Time",
      "from_stock": "stock-training",
      "to_stock": "stock-productive",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-attrition",
      "name": "Attrition",
      "equation": "Productive_Employees * Attrition_Rate",
      "from_stock": "stock-productive",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-desired-workforce",
      "name": "Desired_Workforce",
      "equation": "150",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-workforce-gap",
      "name": "Workforce_Gap",
      "equation": "Desired_Workforce - Productive_Employees - Employees_In_Training",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-desired-hiring",
      "name": "Desired_Hiring_Rate",
      "equation": "MAX(0, Workforce_Gap / Time_to_Fill_Gap + Expected_Attrition)",
      "position": {
        "x": 50,
        "y": 350
      }
    },
    {
      "id": "var-expected-attrition",
      "name": "Expected_Attrition",
      "equation": "Productive_Employees * Attrition_Rate",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-recruiting-time",
      "name": "Recruiting_Time",
      "equation": "4",
      "position": {
        "x": 150,
        "y": 280
      }
    },
    {
      "id": "var-training-time",
      "name": "Training_Time",
      "equation": "12",
      "position": {
        "x": 350,
        "y": 280
      }
    },
    {
      "id": "var-attrition-rate",
      "name": "Attrition_Rate",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-time-to-fill",
      "name": "Time_to_Fill_Gap",
      "equation": "8",
      "position": {
        "x": 100,
        "y": 280
      }
    },
    {
      "id": "var-total-workforce",
      "name": "Total_Workforce",
      "equation": "Candidates_In_Pipeline + Employees_In_Training + Productive_Employees",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Productive_Employees",
      "to_element": "Workforce_Gap"
    },
    {
      "id": "conn-2",
      "from_element": "Workforce_Gap",
      "to_element": "Desired_Hiring_Rate"
    },
    {
      "id": "conn-3",
      "from_element": "Candidates_In_Pipeline",
      "to_element": "Hiring"
    },
    {
      "id": "conn-4",
      "from_element": "Employees_In_Training",
      "to_element": "Training_Completion"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 60,
    "dt": 0.5
  },
  "created_at": "2026-01-11T20:57:03.373869+00:00",
  "updated_at": "2026-01-11T20:57:03.373869+00:00",
  "source": "https://doi.org/10.1287/mnsc.35.3.321",
  "reference": "Sterman JD. Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill, 2000."
}