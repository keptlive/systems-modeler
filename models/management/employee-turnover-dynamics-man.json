{
  "id": "employee-turnover-dynamics-man",
  "name": "Employee Turnover and Organizational Knowledge",
  "description": "Models employee retention, turnover costs, and organizational knowledge loss. Based on Hom et al. (2017) One Hundred Years of Employee Turnover Theory. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "category": "management",
  "stocks": [
    {
      "id": "stock-junior",
      "name": "Junior_Employees",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-senior",
      "name": "Senior_Employees",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-knowledge",
      "name": "Organizational_Knowledge",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-morale",
      "name": "Employee_Morale",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-hire",
      "name": "New_Hires",
      "equation": "Hiring_Rate * Hiring_Budget / Hiring_Cost",
      "from_stock": null,
      "to_stock": "stock-junior",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-promote",
      "name": "Promotions",
      "equation": "Junior_Employees / Development_Time * Promotion_Rate",
      "from_stock": "stock-junior",
      "to_stock": "stock-senior",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-junior-leave",
      "name": "Junior_Turnover",
      "equation": "Junior_Employees * Junior_Turnover_Rate * (100 - Employee_Morale)/100",
      "from_stock": "stock-junior",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 280
      }
    },
    {
      "id": "flow-senior-leave",
      "name": "Senior_Turnover",
      "equation": "Senior_Employees * Senior_Turnover_Rate * (100 - Employee_Morale)/100",
      "from_stock": "stock-senior",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-know-build",
      "name": "Knowledge_Building",
      "equation": "Senior_Employees * Knowledge_Creation_Rate + Junior_Employees * Knowledge_Creation_Rate * 0.3",
      "from_stock": null,
      "to_stock": "stock-knowledge",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "flow-know-loss",
      "name": "Knowledge_Loss",
      "equation": "Senior_Turnover * Knowledge_Per_Senior + Junior_Turnover * Knowledge_Per_Junior",
      "from_stock": "stock-knowledge",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-morale-up",
      "name": "Morale_Improvement",
      "equation": "(Target_Morale - Employee_Morale) / Morale_Adjust_Time",
      "from_stock": null,
      "to_stock": "stock-morale",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-morale-down",
      "name": "Morale_Erosion",
      "equation": "Employee_Morale * Turnover_Impact * (Junior_Turnover + Senior_Turnover) / Total_Employees",
      "from_stock": "stock-morale",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-hire-rate",
      "name": "Hiring_Rate",
      "equation": "1",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-budget",
      "name": "Hiring_Budget",
      "equation": "50",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-hire-cost",
      "name": "Hiring_Cost",
      "equation": "5",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-dev-time",
      "name": "Development_Time",
      "equation": "24",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-promo-rate",
      "name": "Promotion_Rate",
      "equation": "0.7",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-jr-turn",
      "name": "Junior_Turnover_Rate",
      "equation": "0.15",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-sr-turn",
      "name": "Senior_Turnover_Rate",
      "equation": "0.08",
      "position": {
        "x": 100,
        "y": 400
      }
    },
    {
      "id": "var-know-create",
      "name": "Knowledge_Creation_Rate",
      "equation": "2",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "var-know-sr",
      "name": "Knowledge_Per_Senior",
      "equation": "10",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-know-jr",
      "name": "Knowledge_Per_Junior",
      "equation": "2",
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "var-target-morale",
      "name": "Target_Morale",
      "equation": "75",
      "position": {
        "x": 500,
        "y": 400
      }
    },
    {
      "id": "var-morale-adj",
      "name": "Morale_Adjust_Time",
      "equation": "6",
      "position": {
        "x": 600,
        "y": 400
      }
    },
    {
      "id": "var-turn-impact",
      "name": "Turnover_Impact",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "var-total",
      "name": "Total_Employees",
      "equation": "Junior_Employees + Senior_Employees",
      "position": {
        "x": 400,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 60,
    "dt": 1
  },
  "source": "https://doi.org/10.1037/apl0000103",
  "reference": "Hom PW, Lee TW, Shaw JD, Hausknecht JP (2017) One Hundred Years of Employee Turnover Theory and Research. Journal of Applied Psychology 102(3):530-545.",
  "connectors": [],
