{
  "id": "bullwhip-supply-chain-man",
  "name": "Bullwhip Effect Supply Chain Model",
  "description": "Model of demand amplification through supply chain tiers. Reference: Lee, H.L. et al. (1997). The Bullwhip Effect in Supply Chains.",
  "stocks": [
    {
      "id": "s1",
      "name": "Retailer_Inventory",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Wholesaler_Inventory",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Distributor_Inventory",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Manufacturer_Inventory",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Consumer_Demand",
      "equation": "Base_Demand * (1 + Demand_Variability * SIN(time / 10))",
      "from_stock": "Retailer_Inventory",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Retailer_Order",
      "equation": "Consumer_Demand + (Target_Retailer - Retailer_Inventory) * Adjustment_Rate",
      "from_stock": "Wholesaler_Inventory",
      "to_stock": "Retailer_Inventory",
      "position": {
        "x": 220,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Wholesaler_Order",
      "equation": "Retailer_Order * Amplification + (Target_Wholesaler - Wholesaler_Inventory) * Adjustment_Rate",
      "from_stock": "Distributor_Inventory",
      "to_stock": "Wholesaler_Inventory",
      "position": {
        "x": 340,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Distributor_Order",
      "equation": "Wholesaler_Order * Amplification + (Target_Distributor - Distributor_Inventory) * Adjustment_Rate",
      "from_stock": "Manufacturer_Inventory",
      "to_stock": "Distributor_Inventory",
      "position": {
        "x": 460,
        "y": 300
      }
    },
    {
      "id": "f5",
      "name": "Manufacturing",
      "equation": "Distributor_Order * Amplification",
      "from_stock": null,
      "to_stock": "Manufacturer_Inventory",
      "position": {
        "x": 580,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Base_Demand",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Demand_Variability",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Amplification",
      "equation": "1.2",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Adjustment_Rate",
      "equation": "0.2",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Target_Retailer",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Target_Wholesaler",
      "equation": "200",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Target_Distributor",
      "equation": "300",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Bullwhip_Ratio",
      "equation": "Manufacturing / MAX(1, Consumer_Demand)",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Total_Inventory",
      "equation": "Retailer_Inventory + Wholesaler_Inventory + Distributor_Inventory + Manufacturer_Inventory",
      "position": {
        "x": 100,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1287/mnsc.43.4.546",
  "reference": "Lee, H.L., Padmanabhan, V., & Whang, S. (1997). The Bullwhip Effect in Supply Chains. MIT Sloan Management Review, 38(3), 93-102.",
