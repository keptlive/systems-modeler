{
  "id": "sterman-workforce-hiring-man",
  "name": "Employees_In_Training",
  "description": "Workforce hiring and adjustment model from Sterman (2000) Business Dynamics Chapter 11. Shows labor market dynamics, hiring delays, and workforce adjustment to demand changes. Reference: Sterman, J. D. (2000). Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill. Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Workforce",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Employees_In_Training",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Perceived_Demand",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Hiring",
      "equation": "MAX(0, Desired_Hiring)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Training_Completion",
      "equation": "Employees_In_Training / Training_Time",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 225,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Attrition",
      "equation": "Workforce * Attrition_Rate",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Layoffs",
      "equation": "MAX(0, (Workforce - Desired_Workforce) / Layoff_Time)",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "f5",
      "name": "Demand_Update",
      "equation": "(Actual_Demand - Perceived_Demand) / Demand_Perception_Time",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Desired_Workforce",
      "equation": "Perceived_Demand / Productivity",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "v2",
      "name": "Workforce_Gap",
      "equation": "Desired_Workforce - Workforce - Employees_In_Training",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Desired_Hiring",
      "equation": "MAX(0, Workforce_Gap / Workforce_Adjustment_Time + Expected_Attrition)",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Expected_Attrition",
      "equation": "Workforce * Attrition_Rate",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "v5",
      "name": "Training_Time",
      "equation": "4",
      "position": {
        "x": 225,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Attrition_Rate",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Workforce_Adjustment_Time",
      "equation": "8",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Layoff_Time",
      "equation": "2",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Productivity",
      "equation": "10",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "v10",
      "name": "Actual_Demand",
      "equation": "1000 + 200 * STEP(1, 50)",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "v11",
      "name": "Demand_Perception_Time",
      "equation": "4",
      "position": {
        "x": 500,
        "y": 450
      }
    }
  ],
