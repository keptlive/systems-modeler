{
  "id": "customer-churn-retention-man",
  "name": "Customer Churn and Retention Dynamics",
  "description": "Models customer acquisition, satisfaction, and churn in subscription businesses. Based on Reichheld (1996) The Loyalty Effect and Gupta et al. (2004) JMR. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "category": "management",
  "stocks": [
    {
      "id": "stock-prospects",
      "name": "Prospects",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-new",
      "name": "New_Customers",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-loyal",
      "name": "Loyal_Customers",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-sat",
      "name": "Customer_Satisfaction",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 325,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-acquire",
      "name": "Customer_Acquisition",
      "equation": "Prospects * Acquisition_Rate * Marketing_Effectiveness",
      "from_stock": "stock-prospects",
      "to_stock": "stock-new",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-mature",
      "name": "Customer_Maturation",
      "equation": "New_Customers / Maturation_Time * Customer_Satisfaction/100",
      "from_stock": "stock-new",
      "to_stock": "stock-loyal",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-churn-new",
      "name": "New_Customer_Churn",
      "equation": "New_Customers * New_Churn_Rate * (100 - Customer_Satisfaction)/100",
      "from_stock": "stock-new",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 280
      }
    },
    {
      "id": "flow-churn-loyal",
      "name": "Loyal_Customer_Churn",
      "equation": "Loyal_Customers * Loyal_Churn_Rate * (100 - Customer_Satisfaction)/100",
      "from_stock": "stock-loyal",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "flow-sat-up",
      "name": "Satisfaction_Increase",
      "equation": "(Service_Quality - Customer_Satisfaction) / Sat_Adjust_Time",
      "from_stock": null,
      "to_stock": "stock-sat",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-sat-down",
      "name": "Satisfaction_Erosion",
      "equation": "Customer_Satisfaction * Erosion_Rate",
      "from_stock": "stock-sat",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-acq-rate",
      "name": "Acquisition_Rate",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-mkt-eff",
      "name": "Marketing_Effectiveness",
      "equation": "1 + WOM_Effect * Loyal_Customers/1000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-wom",
      "name": "WOM_Effect",
      "equation": "0.5",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-mature-time",
      "name": "Maturation_Time",
      "equation": "6",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-new-churn",
      "name": "New_Churn_Rate",
      "equation": "0.15",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-loyal-churn",
      "name": "Loyal_Churn_Rate",
      "equation": "0.03",
      "position": {
        "x": 150,
        "y": 400
      }
    },
    {
      "id": "var-service",
      "name": "Service_Quality",
      "equation": "80",
      "position": {
        "x": 300,
        "y": 400
      }
    },
    {
      "id": "var-sat-adj",
      "name": "Sat_Adjust_Time",
      "equation": "3",
      "position": {
        "x": 450,
        "y": 400
      }
    },
    {
      "id": "var-erosion",
      "name": "Erosion_Rate",
      "equation": "0.01",
      "position": {
        "x": 550,
        "y": 400
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 60,
    "dt": 1
  },
  "source": "https://doi.org/10.1509/jmkr.41.1.7.25084",
  "reference": "Gupta S, Lehmann DR, Stuart JA (2004) Valuing Customers. Journal of Marketing Research 41(1):7-18.",
  "connectors": [],
  "created_at": "2026-01-12T06:35:24.695681+00:00",
  "updated_at": "2026-01-12T06:35:24.695681+00:00"
}