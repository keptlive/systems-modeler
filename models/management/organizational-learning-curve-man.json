{
  "id": "organizational-learning-curve-man",
  "name": "Organizational Learning Curve",
  "description": "Organizational learning model showing how experience accumulates and improves productivity. Models learning curves with forgetting. Source: Based on Argote & Epple (1990), Learning Curves in Manufacturing, Science.",
  "stocks": [
    {
      "id": "stock-experience",
      "name": "Cumulative_Experience",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-knowledge",
      "name": "Organizational_Knowledge",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-production",
      "name": "Production",
      "equation": "Productivity * Workforce",
      "from_stock": null,
      "to_stock": "stock-experience",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-learning",
      "name": "Learning",
      "equation": "Production * Knowledge_Acquisition_Rate",
      "from_stock": null,
      "to_stock": "stock-knowledge",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "flow-forgetting",
      "name": "Forgetting",
      "equation": "Organizational_Knowledge * Forgetting_Rate",
      "from_stock": "stock-knowledge",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-workforce",
      "name": "Workforce",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-base-productivity",
      "name": "Base_Productivity",
      "equation": "1",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-learning-rate",
      "name": "Learning_Rate",
      "equation": "0.2",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-productivity",
      "name": "Productivity",
      "equation": "Base_Productivity * (Cumulative_Experience / 100) ^ Learning_Rate",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-knowledge-acq",
      "name": "Knowledge_Acquisition_Rate",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 380
      }
    },
    {
      "id": "var-forgetting-rate",
      "name": "Forgetting_Rate",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 380
      }
    },
    {
      "id": "var-effective-knowledge",
      "name": "Effective_Knowledge",
      "equation": "Organizational_Knowledge / (Organizational_Knowledge + 50)",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Workforce",
      "to_element": "Production"
    },
    {
      "id": "conn-2",
      "from_element": "Productivity",
      "to_element": "Production"
    },
    {
      "id": "conn-3",
      "from_element": "Cumulative_Experience",
      "to_element": "Productivity"
    },
    {
      "id": "conn-4",
      "from_element": "Organizational_Knowledge",
      "to_element": "Forgetting"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-11T20:57:03.373932+00:00",
  "updated_at": "2026-01-11T20:57:03.373932+00:00",
  "source": "https://doi.org/10.1287/mnsc.35.3.321",
  "reference": "Sterman JD. Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill, 2000."
}