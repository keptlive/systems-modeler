{
  "id": "food-waste-supply-chain-agr",
  "name": "Food Waste Supply Chain Model",
  "description": "Model of food loss across different supply chain stages. Source: FAO (2011), Global Food Losses and Food Waste. Reference: Based on System Dynamics supply chain models (Sterman, 2000). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Farm_Production",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Processing_Stage",
      "initial_value": 850,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Distribution",
      "initial_value": 765,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Retail",
      "initial_value": 688,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s5",
      "name": "Consumer",
      "initial_value": 620,
      "equation": "",
      "position": {
        "x": 325,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Harvest_Loss",
      "equation": "Farm_Production * Loss_Farm",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "f2",
      "name": "To_Processing",
      "equation": "Farm_Production * (1 - Loss_Farm)",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Processing_Loss",
      "equation": "Processing_Stage * Loss_Processing",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "f4",
      "name": "To_Distribution",
      "equation": "Processing_Stage * (1 - Loss_Processing)",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Distribution_Loss",
      "equation": "Distribution * Loss_Distribution",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "f6",
      "name": "To_Retail",
      "equation": "Distribution * (1 - Loss_Distribution)",
      "from_stock": "s3",
      "to_stock": "s4",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "f7",
      "name": "Retail_Waste",
      "equation": "Retail * Loss_Retail",
      "from_stock": "s4",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "f8",
      "name": "Consumer_Waste",
      "equation": "Consumer * Loss_Consumer",
      "from_stock": "s5",
      "to_stock": null,
      "position": {
        "x": 325,
        "y": 450
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Loss_Farm",
      "equation": "0.15",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Loss_Processing",
      "equation": "0.10",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Loss_Distribution",
      "equation": "0.10",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Loss_Retail",
      "equation": "0.10",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Loss_Consumer",
      "equation": "0.10",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Total_Loss_Rate",
      "equation": "1 - (1 - Loss_Farm) * (1 - Loss_Processing) * (1 - Loss_Distribution) * (1 - Loss_Retail) * (1 - Loss_Consumer)",
      "position": {
        "x": 300,
        "y": 500
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Loss_Farm",
      "to_element": "Harvest_Loss"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 1,
    "dt": 0.1
  },
  "created_at": "2026-01-15T14:47:15.681868+00:00",
  "updated_at": "2026-01-15T14:47:15.681871+00:00",
  "source": "https://www.fao.org/3/i2697e/i2697e.pdf",
  "reference": "FAO (2011). Global food losses and food waste. Food and Agriculture Organization of the United Nations."
}