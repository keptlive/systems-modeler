{
  "id": "food-waste-reduction-agr",
  "name": "Food Waste Reduction Model",
  "description": "Model of food waste dynamics across the supply chain showing intervention effectiveness at different stages. Reference: Based on System Dynamics supply chain models (Sterman, 2000). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-produced",
      "name": "Food_Produced",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-retail",
      "name": "Food_at_Retail",
      "initial_value": 700,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-consumed",
      "name": "Food_Consumed",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-waste",
      "name": "Food_Wasted",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-production",
      "name": "Production_Rate",
      "equation": "Production_Capacity",
      "from_stock": null,
      "to_stock": "stock-produced",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "flow-supply",
      "name": "Supply_Chain_Flow",
      "equation": "Food_Produced * (1 - Supply_Chain_Loss) * Supply_Rate",
      "from_stock": "stock-produced",
      "to_stock": "stock-retail",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-purchase",
      "name": "Consumer_Purchase",
      "equation": "Food_at_Retail * Purchase_Rate * (1 - Retail_Waste_Rate)",
      "from_stock": "stock-retail",
      "to_stock": "stock-consumed",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-retail-waste",
      "name": "Retail_Waste",
      "equation": "Food_at_Retail * Retail_Waste_Rate",
      "from_stock": "stock-retail",
      "to_stock": "stock-waste",
      "position": {
        "x": 200,
        "y": 280
      }
    },
    {
      "id": "flow-consumer-waste",
      "name": "Consumer_Waste",
      "equation": "Food_Consumed * Consumer_Waste_Rate",
      "from_stock": "stock-consumed",
      "to_stock": "stock-waste",
      "position": {
        "x": 400,
        "y": 280
      }
    }
  ],
  "variables": [
    {
      "id": "var-capacity",
      "name": "Production_Capacity",
      "equation": "100",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-sc-loss",
      "name": "Supply_Chain_Loss",
      "equation": "0.15",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-supply-rate",
      "name": "Supply_Rate",
      "equation": "0.2",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-purchase",
      "name": "Purchase_Rate",
      "equation": "0.15",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-retail-waste",
      "name": "Retail_Waste_Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-consumer-waste",
      "name": "Consumer_Waste_Rate",
      "equation": "0.2",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "connectors": [
