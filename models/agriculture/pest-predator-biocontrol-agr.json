{
  "id": "pest-predator-biocontrol-agr",
  "name": "Biological Pest Control Model",
  "description": "Model of pest management through natural enemy introduction. Source: van Lenteren (2012), Annual Review of Entomology.",
  "stocks": [
    {
      "id": "s1",
      "name": "Pest_Population",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Predator_Population",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Crop_Damage",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Pest_Dynamics",
      "equation": "r_pest * Pest_Population * (1 - Pest_Population / K_pest) - Predation",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Predator_Dynamics",
      "equation": "e * Predation - m_pred * Predator_Population + Release_Rate",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Damage_Accumulation",
      "equation": "Damage_Rate * Pest_Population",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "r_pest",
      "equation": "0.3",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "K_pest",
      "equation": "1000",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "a",
      "equation": "0.01",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "e",
      "equation": "0.3",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "m_pred",
      "equation": "0.1",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Release_Rate",
      "equation": "5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Damage_Rate",
      "equation": "0.001",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Predation",
      "equation": "a * Pest_Population * Predator_Population / (1 + a * 0.1 * Pest_Population)",
      "position": {
        "x": 300,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Economic_Threshold",
      "equation": "50",
      "position": {
        "x": 500,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Pest_Population",
      "to_element": "Predation"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-15T14:47:15.681849+00:00",
  "updated_at": "2026-01-15T14:47:15.681852+00:00",
  "source": "https://doi.org/10.1146/annurev-ento-120811-153615",
  "reference": "van Lenteren, J.C. (2012). The state of commercial augmentative biological control: plenty of natural enemies, but a frustrating lack of uptake. Annual Review of Entomology 57:107-126."
}