{
  "id": "food-waste-system-agr",
  "name": "Food Waste Reduction Model",
  "description": "Model of food waste in supply chain. Source: FAO (2011); Parfitt et al. (2010). Reference: Based on System Dynamics supply chain models (Sterman, 2000). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-food",
      "name": "Food_Available",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-waste",
      "name": "Waste",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-produce",
      "name": "Production",
      "equation": "Production_Rate",
      "from_stock": null,
      "to_stock": "stock-food",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-consume",
      "name": "Consumption",
      "equation": "Food_Available * Consumption_Rate",
      "from_stock": "stock-food",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "flow-waste",
      "name": "Waste_Flow",
      "equation": "Food_Available * Waste_Rate * (1 - Intervention)",
      "from_stock": "stock-food",
      "to_stock": "stock-waste",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-prod",
      "name": "Production_Rate",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-cons",
      "name": "Consumption_Rate",
      "equation": "0.7",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-waste",
      "name": "Waste_Rate",
      "equation": "0.3",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-interv",
      "name": "Intervention",
      "equation": "0.1 + 0.005 * TIME",
      "position": {
        "x": 400,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
