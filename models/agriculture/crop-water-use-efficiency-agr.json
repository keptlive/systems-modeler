{
  "id": "crop-water-use-efficiency-agr",
  "name": "Crop Water Use Efficiency Model",
  "description": "Model of crop yield response to water availability. Source: Steduto et al. (2009), Agronomy Journal - AquaCrop.",
  "stocks": [
    {
      "id": "s1",
      "name": "Soil_Water",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Crop_Biomass",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Water_Balance",
      "equation": "Precipitation + Irrigation - ET - Drainage",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Biomass_Production",
      "equation": "WP * Transpiration / 10",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Precipitation",
      "equation": "3",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Irrigation",
      "equation": "2",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "ET0",
      "equation": "5",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Kc",
      "equation": "1.0",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "WP",
      "equation": "15",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Field_Capacity",
      "equation": "200",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Wilting_Point",
      "equation": "50",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Water_Stress",
      "equation": "MAX(0, MIN(1, (Soil_Water - Wilting_Point) / (Field_Capacity - Wilting_Point)))",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "ET",
      "equation": "ET0 * Kc * Water_Stress",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Transpiration",
      "equation": "ET * 0.7",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v11",
      "name": "Drainage",
      "equation": "MAX(0, Soil_Water - Field_Capacity) * 0.1",
      "position": {
        "x": 300,
        "y": 420
      }
    },
    {
      "id": "v12",
      "name": "WUE",
      "equation": "Crop_Biomass / (Transpiration * TIME + 0.1)",
      "position": {
        "x": 500,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Soil_Water",
      "to_element": "Water_Stress"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 120,
    "dt": 1
  },
  "created_at": "2026-01-15T14:47:15.681832+00:00",
  "updated_at": "2026-01-15T14:47:15.681836+00:00",
  "source": "https://doi.org/10.2134/agronj2009.0279s",
  "reference": "Steduto, P. et al. (2009). AquaCrop\u2014The FAO Crop Model to Simulate Yield Response to Water. Agronomy Journal 101:426-437."
}