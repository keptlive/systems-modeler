{
  "id": "crop-growth-radiation-agr",
  "name": "Crop Growth Radiation Model",
  "description": "Light use efficiency model for crop biomass accumulation",
  "stocks": [
    {
      "id": "s1",
      "name": "Biomass",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Leaf_Area_Index",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [],
  "variables": [
    {
      "id": "v1",
      "name": "Radiation",
      "equation": "20.0",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Light_Extinction",
      "equation": "0.6",
      "position": {
        "x": 230,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Light_Use_Efficiency",
      "equation": "3.0",
      "position": {
        "x": 360,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Intercepted_Radiation",
      "equation": "Radiation*(1-2.718281828*2.718281828*2.718281828*(-Light_Extinction*Leaf_Area_Index))",
      "position": {
        "x": 490,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Growth_Rate",
      "equation": "Light_Use_Efficiency*Intercepted_Radiation",
      "position": {
        "x": 620,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Leaf_Area_Index",
      "to_element": "Intercepted_Radiation"
    },
    {
      "id": "c2",
      "from_element": "Radiation",
      "to_element": "Intercepted_Radiation"
    },
    {
      "id": "c3",
      "from_element": "Intercepted_Radiation",
      "to_element": "Growth_Rate"
    }
  ],
  "time_settings": {
    "start": 0.0,
    "end": 120.0,
    "dt": 1.0
  },
