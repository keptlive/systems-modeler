{
  "id": "agrifood-supply-robustness-agr",
  "name": "Agri-Food Supply Chain Robustness Model",
  "description": "System dynamics model analyzing robustness of agri-food supply chains under disruption. Source: Martinez et al. (2023), Operational Research. Reference: Based on System Dynamics supply chain models (Sterman, 2000). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-farm",
      "name": "Farm_Inventory",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-proc",
      "name": "Processor_Inventory",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-dist",
      "name": "Distributor_Inventory",
      "initial_value": 300,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-retail",
      "name": "Retail_Inventory",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-harvest",
      "name": "Harvest",
      "equation": "Harvest_Rate * Seasonality",
      "from_stock": null,
      "to_stock": "stock-farm",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-process",
      "name": "Processing",
      "equation": "MIN(Farm_Inventory, Processor_Capacity) / Processing_Time",
      "from_stock": "stock-farm",
      "to_stock": "stock-proc",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-dist",
      "name": "Distribution",
      "equation": "MIN(Processor_Inventory, Distribution_Capacity) / Distribution_Time",
      "from_stock": "stock-proc",
      "to_stock": "stock-dist",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-retail",
      "name": "Retail_Supply",
      "equation": "MIN(Distributor_Inventory, Retail_Order) / Retail_Time",
      "from_stock": "stock-dist",
      "to_stock": "stock-retail",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-sales",
      "name": "Consumer_Sales",
      "equation": "MIN(Retail_Inventory, Consumer_Demand)",
      "from_stock": "stock-retail",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "flow-spoil",
      "name": "Spoilage",
      "equation": "(Farm_Inventory + Processor_Inventory + Distributor_Inventory + Retail_Inventory) * Spoilage_Rate",
      "from_stock": null,
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-harvest",
      "name": "Harvest_Rate",
      "equation": "100",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-season",
      "name": "Seasonality",
      "equation": "1 + 0.3 * SIN(2 * 3.14159 * TIME / 52)",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-proccap",
      "name": "Processor_Capacity",
      "equation": "150",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "var-proctime",
      "name": "Processing_Time",
      "equation": "1",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "var-distcap",
      "name": "Distribution_Capacity",
      "equation": "200",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "var-disttime",
      "name": "Distribution_Time",
      "equation": "0.5",
      "position": {
        "x": 325,
        "y": 150
      }
    },
    {
      "id": "var-retorder",
      "name": "Retail_Order",
      "equation": "100",
      "position": {
        "x": 475,
        "y": 100
      }
    },
    {
      "id": "var-rettime",
      "name": "Retail_Time",
      "equation": "0.5",
      "position": {
        "x": 475,
        "y": 150
      }
    },
    {
      "id": "var-demand",
      "name": "Consumer_Demand",
      "equation": "80",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "var-spoil",
      "name": "Spoilage_Rate",
      "equation": "0.02",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 104,
    "dt": 0.25
  },
