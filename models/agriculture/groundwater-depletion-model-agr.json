{
  "id": "groundwater-depletion-model-agr",
  "name": "Groundwater Depletion Model",
  "description": "Models aquifer depletion from agricultural pumping exceeding recharge. Based on Famiglietti (2014). DOI: 10.1038/nclimate2425",
  "stocks": [
    {
      "id": "stock-aquifer",
      "name": "Aquifer_Storage",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "stock-irrigated",
      "name": "Irrigated_Area",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-wellcount",
      "name": "Active_Wells",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-recharge",
      "name": "Aquifer_Recharge",
      "equation": "Precipitation * Recharge_Fraction * Catchment_Area",
      "from_stock": null,
      "to_stock": "stock-aquifer",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "flow-pumping",
      "name": "Groundwater_Pumping",
      "equation": "Active_Wells * Pumping_Rate * IF(Aquifer_Storage > Min_Storage, 1, 0.1)",
      "from_stock": "stock-aquifer",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "flow-naturalflow",
      "name": "Natural_Discharge",
      "equation": "Aquifer_Storage * Natural_Discharge_Rate",
      "from_stock": "stock-aquifer",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "flow-areaexp",
      "name": "Area_Expansion",
      "equation": "Irrigated_Area * Expansion_Rate * Economic_Incentive",
      "from_stock": null,
      "to_stock": "stock-irrigated",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-abandon",
      "name": "Area_Abandonment",
      "equation": "Irrigated_Area * Abandonment_Rate * (1 - Water_Availability)",
      "from_stock": "stock-irrigated",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "flow-newwells",
      "name": "New_Well_Drilling",
      "equation": "Well_Drilling_Rate * IF(Water_Availability > 0.3, 1, 0.1)",
      "from_stock": null,
      "to_stock": "stock-wellcount",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-wellretire",
      "name": "Well_Retirement",
      "equation": "Active_Wells * Well_Retirement_Rate",
      "from_stock": "stock-wellcount",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-precip",
      "name": "Precipitation",
      "equation": "50 + 20 * SIN(TIME / 12)",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-rechfrac",
      "name": "Recharge_Fraction",
      "equation": "0.15",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-catcharea",
      "name": "Catchment_Area",
      "equation": "1000",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-pumprate",
      "name": "Pumping_Rate",
      "equation": "20",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "var-minstor",
      "name": "Min_Storage",
      "equation": "1000",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-natdisch",
      "name": "Natural_Discharge_Rate",
      "equation": "0.001",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-exprate",
      "name": "Expansion_Rate",
      "equation": "0.02",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-econinc",
      "name": "Economic_Incentive",
      "equation": "1.2",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "var-abndrate",
      "name": "Abandonment_Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-wateravail",
      "name": "Water_Availability",
      "equation": "Aquifer_Storage / 10000",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "var-drillrate",
      "name": "Well_Drilling_Rate",
      "equation": "5",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-retirerate",
      "name": "Well_Retirement_Rate",
      "equation": "0.03",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "var-sustindex",
      "name": "Sustainability_Index",
      "equation": "(Aquifer_Recharge) / (Groundwater_Pumping + 1)",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Aquifer_Storage",
      "to_element": "Water_Availability"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:55:29.074301+00:00",
  "updated_at": "2026-01-12T02:55:29.074307+00:00",
  "source": "https://doi.org/10.1038/nclimate2425",
  "reference": "Famiglietti JS (2014). The global groundwater crisis. Nature Climate Change."
}