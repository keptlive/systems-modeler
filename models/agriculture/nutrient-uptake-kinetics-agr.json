  "updated_at": "2026-01-15T20:51:57.247210+00:00",
  "source": "https://doi.org/10.1007/BF02374516",
  "reference": "Barber, S.A. (1995) Soil Nutrient Bioavailability: A Mechanistic Approach. Wiley"
