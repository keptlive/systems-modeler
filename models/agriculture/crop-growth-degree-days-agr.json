{
  "id": "crop-growth-degree-days-agr",
  "name": "Crop Growth Degree Days Model",
  "description": "Model of crop development based on thermal time accumulation. Source: McMaster & Wilhelm (1997), Agricultural and Forest Meteorology.",
  "stocks": [
    {
      "id": "s1",
      "name": "Growing_Degree_Days",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Biomass",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Grain_Yield",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Thermal_Accumulation",
      "equation": "Daily_GDD",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Biomass_Growth",
      "equation": "RUE * Intercepted_Radiation * Growth_Factor",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Grain_Fill",
      "equation": "IF(Growing_Degree_Days > GDD_Anthesis, Harvest_Index_Rate * Biomass, 0)",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "T_max",
      "equation": "25",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "T_min",
      "equation": "15",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "T_base",
      "equation": "10",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Daily_GDD",
      "equation": "MAX(0, (T_max + T_min) / 2 - T_base)",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "GDD_Maturity",
      "equation": "2000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "GDD_Anthesis",
      "equation": "1200",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "RUE",
      "equation": "1.5",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Radiation",
      "equation": "20",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "LAI",
      "equation": "MIN(6, Biomass * 0.02)",
      "position": {
        "x": 300,
        "y": 420
      }
    },
    {
      "id": "v10",
      "name": "Intercepted_Radiation",
      "equation": "Radiation * (1 - EXP(-0.5 * LAI))",
      "position": {
        "x": 450,
        "y": 420
      }
    },
    {
      "id": "v11",
      "name": "Growth_Factor",
      "equation": "MIN(1, Growing_Degree_Days / GDD_Maturity)",
      "position": {
        "x": 200,
        "y": 480
      }
    },
    {
      "id": "v12",
      "name": "Harvest_Index_Rate",
      "equation": "0.01",
      "position": {
        "x": 400,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "T_max",
      "to_element": "Daily_GDD"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 150,
    "dt": 1
  },
  "created_at": "2026-01-15T14:47:15.681714+00:00",
  "updated_at": "2026-01-15T14:47:15.681794+00:00",
  "source": "https://doi.org/10.1016/S0168-1923(97)00027-0",
  "reference": "McMaster, G.S. & Wilhelm, W.W. (1997). Growing degree-days: one equation, two interpretations. Agricultural and Forest Meteorology 87:291-300."
}