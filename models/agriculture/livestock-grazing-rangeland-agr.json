{
  "id": "livestock-grazing-rangeland-agr",
  "name": "Livestock Grazing and Rangeland Dynamics",
  "description": "Models the interaction between livestock grazing, grass biomass, and rangeland degradation. Based on Noy-Meir (1975) Stability of grazing systems, Journal of Ecology. Reference: FAO Livestock Statistics. Source: https://www.fao.org/faostat/en/#data/QCL",
  "category": "agriculture",
  "stocks": [
    {
      "id": "stock-grass",
      "name": "Grass_Biomass",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-cattle",
      "name": "Cattle_Population",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-soil",
      "name": "Soil_Quality",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-grow",
      "name": "Grass_Growth",
      "equation": "Grass_Biomass * Growth_Rate * (1 - Grass_Biomass/Carrying_Capacity) * Soil_Quality/100",
      "from_stock": null,
      "to_stock": "stock-grass",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-graze",
      "name": "Grazing_Consumption",
      "equation": "Cattle_Population * Intake_Rate * Grass_Biomass/(Grass_Biomass + Half_Saturation)",
      "from_stock": "stock-grass",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-birth",
      "name": "Cattle_Births",
      "equation": "Cattle_Population * Birth_Rate * Grass_Biomass/(Grass_Biomass + Half_Saturation)",
      "from_stock": null,
      "to_stock": "stock-cattle",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "flow-death",
      "name": "Cattle_Deaths",
      "equation": "Cattle_Population * Death_Rate",
      "from_stock": "stock-cattle",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "flow-degrade",
      "name": "Soil_Degradation",
      "equation": "IF(Grass_Biomass < 100, Degradation_Rate, 0)",
      "from_stock": "stock-soil",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-recover",
      "name": "Soil_Recovery",
      "equation": "IF(Grass_Biomass > 300, Recovery_Rate, 0)",
      "from_stock": null,
      "to_stock": "stock-soil",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-grow",
      "name": "Growth_Rate",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-carry",
      "name": "Carrying_Capacity",
      "equation": "1000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-intake",
      "name": "Intake_Rate",
      "equation": "2",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-half",
      "name": "Half_Saturation",
      "equation": "200",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-birth",
      "name": "Birth_Rate",
      "equation": "0.15",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-death",
      "name": "Death_Rate",
      "equation": "0.1",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "var-degrade",
      "name": "Degradation_Rate",
      "equation": "2",
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "var-recover",
      "name": "Recovery_Rate",
      "equation": "1",
      "position": {
        "x": 400,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "source": "https://doi.org/10.2307/2258730",
  "reference": "Noy-Meir I (1975) Stability of grazing systems: an application of predator-prey graphs. Journal of Ecology 63(2):459-481.",
  "connectors": [],
