{
  "id": "global-food-security-dynamics-agr",
  "name": "Global Food Security Dynamics Model",
  "description": "Model of global food security showing interactions between production, population, climate impacts, and distribution. Based on FAO food security frameworks and research on agricultural system resilience.",
  "stocks": [
    {
      "id": "s1",
      "name": "Global_Food_Stock",
      "initial_value": 500,
      "equation": "",
      "position": {"x": 300, "y": 200}
    },
    {
      "id": "s2",
      "name": "Agricultural_Land",
      "initial_value": 5000,
      "equation": "",
      "position": {"x": 150, "y": 350}
    },
    {
      "id": "s3",
      "name": "Food_Insecure_Population",
      "initial_value": 800,
      "equation": "",
      "position": {"x": 500, "y": 350}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Food_Production",
      "equation": "Agricultural_Land * Yield_Per_Ha * Climate_Effect",
      "from_stock": null,
      "to_stock": "Global_Food_Stock",
      "position": {"x": 150, "y": 200}
    },
    {
      "id": "f2",
      "name": "Food_Consumption",
      "equation": "Global_Population * Per_Capita_Consumption",
      "from_stock": "Global_Food_Stock",
      "to_stock": null,
      "position": {"x": 450, "y": 200}
    },
    {
      "id": "f3",
      "name": "Land_Degradation",
      "equation": "Agricultural_Land * Degradation_Rate",
      "from_stock": "Agricultural_Land",
      "to_stock": null,
      "position": {"x": 50, "y": 350}
    },
    {
      "id": "f4",
      "name": "Land_Restoration",
      "equation": "Restoration_Investment * Land_per_Investment",
      "from_stock": null,
      "to_stock": "Agricultural_Land",
      "position": {"x": 250, "y": 350}
    },
    {
      "id": "f5",
      "name": "Becoming_Food_Insecure",
      "equation": "MAX(0, (Global_Population * Food_Gap) / Gap_Time)",
      "from_stock": null,
      "to_stock": "Food_Insecure_Population",
      "position": {"x": 400, "y": 350}
    },
    {
      "id": "f6",
      "name": "Gaining_Food_Security",
      "equation": "Food_Insecure_Population * Security_Rate * Food_Availability",
      "from_stock": "Food_Insecure_Population",
      "to_stock": null,
      "position": {"x": 600, "y": 350}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Yield_Per_Ha",
      "equation": "3.5",
      "position": {"x": 100, "y": 80}
    },
    {
      "id": "v2",
      "name": "Climate_Effect",
      "equation": "MAX(0.5, 1 - Temperature_Anomaly * Climate_Sensitivity)",
      "position": {"x": 250, "y": 80}
    },
    {
      "id": "v3",
      "name": "Temperature_Anomaly",
      "equation": "1.2",
      "position": {"x": 400, "y": 80}
    },
    {
      "id": "v4",
      "name": "Climate_Sensitivity",
      "equation": "0.1",
      "position": {"x": 550, "y": 80}
    },
    {
      "id": "v5",
      "name": "Global_Population",
      "equation": "8000",
      "position": {"x": 300, "y": 450}
    },
    {
      "id": "v6",
      "name": "Per_Capita_Consumption",
      "equation": "0.25",
      "position": {"x": 450, "y": 450}
    },
    {
      "id": "v7",
      "name": "Degradation_Rate",
      "equation": "0.01",
      "position": {"x": 50, "y": 450}
    },
    {
      "id": "v8",
      "name": "Restoration_Investment",
      "equation": "50",
      "position": {"x": 150, "y": 450}
    },
    {
      "id": "v9",
      "name": "Land_per_Investment",
      "equation": "0.5",
      "position": {"x": 200, "y": 500}
    },
    {
      "id": "v10",
      "name": "Food_Gap",
      "equation": "MAX(0, 1 - Global_Food_Stock / (Global_Population * Per_Capita_Consumption * 30))",
      "position": {"x": 500, "y": 450}
    },
    {
      "id": "v11",
      "name": "Gap_Time",
      "equation": "12",
      "position": {"x": 350, "y": 500}
    },
    {
      "id": "v12",
      "name": "Security_Rate",
      "equation": "0.1",
      "position": {"x": 600, "y": 450}
    },
    {
      "id": "v13",
      "name": "Food_Availability",
      "equation": "MIN(1, Global_Food_Stock / (Global_Population * Per_Capita_Consumption * 10))",
      "position": {"x": 650, "y": 500}
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2050,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1016/j.gfs.2020.100360",
  "reference": "FAO (2020). The State of Food Security and Nutrition in the World 2020. FAO, IFAD, UNICEF, WFP and WHO. Also: Wheeler T, von Braun J. (2013). Climate change impacts on global food security. Science, 341(6145), 508-513. DOI: 10.1126/science.1239402",
  "created_at": "2026-01-15T20:30:00.000000Z",
  "updated_at": "2026-01-15T20:30:00.000000Z"
}
