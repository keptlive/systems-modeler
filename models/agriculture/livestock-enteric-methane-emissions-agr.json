{
  "id": "livestock-enteric-methane-emissions-agr",
  "name": "Livestock Enteric Methane Emissions Model",
  "description": "Model of methane production from cattle based on feed intake. Source: IPCC (2019), Refinement to 2006 Guidelines. Reference: IPCC (2021). Climate Change 2021: The Physical Science Basis. Cambridge University Press. Source: https://www.ipcc.ch/",
  "stocks": [
    {
      "id": "s1",
      "name": "Herd_Size",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Total_Methane",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Herd_Dynamics",
      "equation": "Birth_Rate * Herd_Size - Cull_Rate * Herd_Size",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Methane_Emission",
      "equation": "Daily_CH4 * Herd_Size",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Body_Weight",
      "equation": "500",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "DMI",
      "equation": "Body_Weight * 0.025",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "GE_per_kg_DM",
      "equation": "18.45",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Birth_Rate",
      "equation": "0.003",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Cull_Rate",
      "equation": "0.003",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "GE_Intake",
      "equation": "DMI * GE_per_kg_DM",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Ym",
      "equation": "0.065",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Daily_CH4",
      "equation": "GE_Intake * Ym / 55.65",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Annual_CH4_per_head",
      "equation": "Daily_CH4 * 365",
      "position": {
        "x": 300,
        "y": 420
      }
    },
    {
      "id": "v10",
      "name": "CO2_equivalent",
      "equation": "Total_Methane * 28",
      "position": {
        "x": 500,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "DMI",
      "to_element": "GE_Intake"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "created_at": "2026-01-15T14:47:15.681916+00:00",
  "updated_at": "2026-01-15T14:47:15.681920+00:00",
  "source": "https://www.ipcc-nggip.iges.or.jp/public/2019rf/index.html",
  "reference": "IPCC (2019). 2019 Refinement to the 2006 IPCC Guidelines for National Greenhouse Gas Inventories."
}