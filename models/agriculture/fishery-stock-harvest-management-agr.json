{
  "id": "fishery-stock-harvest-management-agr",
  "name": "Fishery Stock and Harvest Management Model",
  "description": "Model of fish population dynamics with harvesting and management quotas. Based on FAO fishery management principles. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Fish Stock",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Fishing Fleet",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Cumulative Catch",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Recruitment",
      "equation": "Fish_Stock * Growth_Rate * (1 - Fish_Stock / Carrying_Capacity)",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Harvest",
      "equation": "MIN(Fish_Stock * Catchability * Fishing_Fleet, Quota_Limit)",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 250,
        "y": 225
      }
    },
    {
      "id": "f3",
      "name": "Natural Mortality",
      "equation": "Fish_Stock * Natural_Death_Rate",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "f4",
      "name": "Fleet Entry",
      "equation": "Profitability * Entry_Rate * (Max_Fleet - Fishing_Fleet) / Max_Fleet",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "f5",
      "name": "Fleet Exit",
      "equation": "Fishing_Fleet * Exit_Rate / (Profitability + 0.1)",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Growth Rate",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Carrying Capacity",
      "equation": "20000",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "v3",
      "name": "Catchability",
      "equation": "0.0001",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Natural Death Rate",
      "equation": "0.1",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Quota Limit",
      "equation": "1000",
      "position": {
        "x": 350,
        "y": 225
      }
    },
    {
      "id": "v6",
      "name": "Fish Price",
      "equation": "10",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "v7",
      "name": "Fishing Cost",
      "equation": "5",
      "position": {
        "x": 450,
        "y": 250
      }
    },
    {
      "id": "v8",
      "name": "Revenue",
      "equation": "Harvest * Fish_Price",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Profitability",
      "equation": "MAX(0, (Fish_Price * Harvest / Fishing_Fleet - Fishing_Cost))",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v10",
      "name": "Entry Rate",
      "equation": "0.1",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v11",
      "name": "Exit Rate",
      "equation": "0.05",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "v12",
      "name": "Max Fleet",
      "equation": "200",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v13",
      "name": "MSY",
      "equation": "Growth_Rate * Carrying_Capacity / 4",
      "position": {
        "x": 200,
        "y": 250
      }
    },
    {
      "id": "v14",
      "name": "Stock Status",
      "equation": "Fish_Stock / Carrying_Capacity",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Fish Stock",
      "to_element": "Recruitment"
    },
    {
      "id": "c2",
      "from_element": "Fishing Fleet",
      "to_element": "Harvest"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
  "created_at": "2026-01-15T14:24:00.391749",
  "updated_at": "2026-01-15T14:24:00.391758",
  "source": "https://www.fao.org/fishery/code/en",
  "reference": "FAO. Code of Conduct for Responsible Fisheries. Food and Agriculture Organization. 1995."
}