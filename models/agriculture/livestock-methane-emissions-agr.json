{
  "id": "livestock-methane-emissions-agr",
  "name": "Livestock Methane Emissions Model",
  "description": "Gerber et al. (2013) FAO livestock emissions model. Tracks enteric fermentation, manure management, and mitigation strategies. Livestock responsible for ~14.5% of global GHG emissions. Reference: Saunois, M., et al. (2020). The Global Methane Budget. Earth System Science Data. Source: https://doi.org/10.5194/essd-12-1561-2020",
  "stocks": [
    {
      "id": "s1",
      "name": "Cattle_Population",
      "initial_value": 1000,
      "position": {
        "x": 200,
        "y": 150
      },
      "equation": ""
    },
    {
      "id": "s2",
      "name": "Atmospheric_Methane",
      "initial_value": 1800,
      "position": {
        "x": 400,
        "y": 150
      },
      "equation": ""
    },
    {
      "id": "s3",
      "name": "Manure_Storage",
      "initial_value": 100,
      "position": {
        "x": 300,
        "y": 300
      },
      "equation": ""
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "herd_growth",
      "to_stock": "s1",
      "equation": "Cattle_Population * (birth_rate - death_rate)",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "f2",
      "name": "enteric_emissions",
      "to_stock": "s2",
      "equation": "Cattle_Population * enteric_factor * (1 - mitigation_effect)",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "f3",
      "name": "manure_emissions",
      "from_stock": "s3",
      "to_stock": "s2",
      "equation": "Manure_Storage * decomposition_rate",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "f4",
      "name": "methane_decay",
      "from_stock": "s2",
      "equation": "Atmospheric_Methane / methane_lifetime",
      "position": {
        "x": 0,
        "y": 0
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "birth_rate",
      "equation": "0.25",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v2",
      "name": "death_rate",
      "equation": "0.2",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v3",
      "name": "enteric_factor",
      "equation": "0.05",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v4",
      "name": "decomposition_rate",
      "equation": "0.1",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v5",
      "name": "methane_lifetime",
      "equation": "12",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v6",
      "name": "mitigation_effect",
      "equation": "MIN(0.3, 0.01 * TIME)",
      "position": {
        "x": 0,
        "y": 0
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Cattle_Population",
      "to_element": "enteric_emissions"
    },
    {
      "id": "c2",
      "from_element": "mitigation_effect",
      "to_element": "enteric_emissions"
    }
  ],
  "time_settings": {
    "start": 0,
    "dt": 1,
    "end": 50
  },
  "created_at": "2026-01-12T02:25:30.586730+00:00",
  "updated_at": "2026-01-12T02:25:30.586734+00:00",
  "source": "https://www.fao.org/3/i3437e/i3437e.pdf",
  "reference": "Gerber, P. J., et al. (2013). Tackling climate change through livestock. FAO."
}