{
  "id": "food-loss-supply-chain-agr",
  "name": "Food Loss in Agricultural Supply Chains",
  "description": "Models post-harvest losses and food waste throughout the agricultural supply chain. Based on FAO (2011) Global Food Losses and Food Waste. Reference: Based on System Dynamics supply chain models (Sterman, 2000). Source: https://systemdynamics.org/",
  "category": "agriculture",
  "stocks": [
    {
      "id": "stock-harvest",
      "name": "Harvested_Crop",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-stored",
      "name": "Stored_Product",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-transport",
      "name": "In_Transport",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-retail",
      "name": "At_Retail",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "stock-consumed",
      "name": "Consumed",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "stock-waste",
      "name": "Total_Waste",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-store",
      "name": "To_Storage",
      "equation": "Harvested_Crop * Storage_Rate * (1 - Harvest_Loss_Frac)",
      "from_stock": "stock-harvest",
      "to_stock": "stock-stored",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-ship",
      "name": "To_Transport",
      "equation": "Stored_Product * Transport_Rate * (1 - Storage_Loss_Frac)",
      "from_stock": "stock-stored",
      "to_stock": "stock-transport",
      "position": {
        "x": 325,
        "y": 200
      }
    },
    {
      "id": "flow-deliver",
      "name": "To_Retail",
      "equation": "In_Transport * Delivery_Rate * (1 - Transport_Loss_Frac)",
      "from_stock": "stock-transport",
      "to_stock": "stock-retail",
      "position": {
        "x": 475,
        "y": 200
      }
    },
    {
      "id": "flow-consume",
      "name": "Consumption",
      "equation": "At_Retail * Consumption_Rate * (1 - Retail_Loss_Frac)",
      "from_stock": "stock-retail",
      "to_stock": "stock-consumed",
      "position": {
        "x": 625,
        "y": 200
      }
    },
    {
      "id": "flow-waste",
      "name": "Waste_Accumulation",
      "equation": "Harvested_Crop*Harvest_Loss_Frac*Storage_Rate + Stored_Product*Storage_Loss_Frac*Transport_Rate + In_Transport*Transport_Loss_Frac*Delivery_Rate + At_Retail*Retail_Loss_Frac*Consumption_Rate",
      "from_stock": null,
      "to_stock": "stock-waste",
      "position": {
        "x": 400,
        "y": 280
      }
    }
  ],
  "variables": [
    {
      "id": "var-harvest-loss",
      "name": "Harvest_Loss_Frac",
      "equation": "0.06",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-storage-loss",
      "name": "Storage_Loss_Frac",
      "equation": "0.08",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-transport-loss",
      "name": "Transport_Loss_Frac",
      "equation": "0.05",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-retail-loss",
      "name": "Retail_Loss_Frac",
      "equation": "0.12",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "var-store-rate",
      "name": "Storage_Rate",
      "equation": "0.3",
      "position": {
        "x": 175,
        "y": 400
      }
    },
    {
      "id": "var-trans-rate",
      "name": "Transport_Rate",
      "equation": "0.25",
      "position": {
        "x": 325,
        "y": 400
      }
    },
    {
      "id": "var-deliv-rate",
      "name": "Delivery_Rate",
      "equation": "0.2",
      "position": {
        "x": 475,
        "y": 400
      }
    },
    {
      "id": "var-cons-rate",
      "name": "Consumption_Rate",
      "equation": "0.15",
      "position": {
        "x": 625,
        "y": 400
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 1
  },
  "source": "https://www.fao.org/3/mb060e/mb060e00.htm",
  "reference": "FAO (2011) Global Food Losses and Food Waste. Food and Agriculture Organization of the United Nations.",
