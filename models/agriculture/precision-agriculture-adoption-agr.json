{
  "id": "precision-agriculture-adoption-agr",
  "name": "Precision Agriculture Technology Adoption Model",
  "description": "Model of precision agriculture technology adoption including GPS, sensors, and data analytics in farming. Reference: Rogers, E. M. (2003). Diffusion of Innovations. Free Press. Source: https://www.simonandschuster.com/",
  "stocks": [
    {
      "id": "s1",
      "name": "Traditional_Farms",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Adopting_Farms",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Full_Precision_Farms",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 550,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Initial_Adoption",
      "equation": "Traditional_Farms * Adoption_Rate * Word_of_Mouth",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Full_Implementation",
      "equation": "Adopting_Farms * Implementation_Rate * ROI_Factor",
      "from_stock": "s2",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Abandonment",
      "equation": "Adopting_Farms * Abandonment_Rate",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 250,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Adoption_Rate",
      "equation": "0.02",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Word_of_Mouth",
      "equation": "1 + 0.5 * Full_Precision_Farms / (Traditional_Farms + 1)",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Implementation_Rate",
      "equation": "0.15",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "ROI_Factor",
      "equation": "1.2",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Abandonment_Rate",
      "equation": "0.05",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Adoption_Fraction",
      "equation": "(Adopting_Farms + Full_Precision_Farms) / (Traditional_Farms + Adopting_Farms + Full_Precision_Farms)",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:32:16.976632+00:00",
  "updated_at": "2026-01-12T11:32:16.976632+00:00",
  "source": "https://doi.org/10.1016/j.compag.2017.06.004",
  "reference": "Cisternas I, et al. Systematic literature review of implementations of precision agriculture. Computers and Electronics in Agriculture. 2020;176:105626."
}