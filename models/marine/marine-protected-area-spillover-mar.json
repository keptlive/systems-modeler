{
  "id": "marine-protected-area-spillover-mar",
  "name": "Marine Protected Area Spillover Model",
  "description": "Fish population dynamics with MPA reserves. Source: Gaines et al. (2010), PNAS. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "MPA_Population",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Fished_Population",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Total_Catch",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "MPA_Growth",
      "equation": "r * MPA_Population * (1 - MPA_Population / K_mpa) - Emigration + Immigration_MPA",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Fished_Growth",
      "equation": "r * Fished_Population * (1 - Fished_Population / K_fished) + Spillover - Harvest - Immigration_Fished",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Catch_Rate",
      "equation": "Harvest",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "r",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "K_mpa",
      "equation": "2000",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "K_fished",
      "equation": "1000",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Emigration",
      "equation": "0.1 * MPA_Population",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Spillover",
      "equation": "Emigration * 0.8",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Immigration_MPA",
      "equation": "0.02 * Fished_Population",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Immigration_Fished",
      "equation": "0.05 * Fished_Population",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v8",
      "name": "Fishing_Mortality",
      "equation": "0.4",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Harvest",
      "equation": "Fishing_Mortality * Fished_Population",
      "position": {
        "x": 300,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "MPA_Population",
      "to_element": "Spillover"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-15T14:52:39.346905+00:00",
  "updated_at": "2026-01-15T14:52:39.346908+00:00",
  "source": "https://doi.org/10.1073/pnas.0908091107",
  "reference": "Gaines, S.D. et al. (2010). Designing marine reserve networks for both conservation and fisheries management. PNAS 107:18286-18293."
}