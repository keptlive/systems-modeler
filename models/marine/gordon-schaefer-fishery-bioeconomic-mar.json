{
  "id": "gordon-schaefer-fishery-bioeconomic-mar",
  "name": "Gordon-Schaefer Fishery Bioeconomic Model",
  "description": "Classic bioeconomic model of open-access fisheries. Source: Gordon (1954), Journal of Political Economy. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Fish_Stock",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Fishing_Effort",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Cumulative_Profit",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Net_Growth",
      "equation": "r * Fish_Stock * (1 - Fish_Stock / K) - Harvest",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Effort_Change",
      "equation": "phi * Profit",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Profit_Flow",
      "equation": "Profit",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "r",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "K",
      "equation": "2000",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "q",
      "equation": "0.001",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Harvest",
      "equation": "q * Fishing_Effort * Fish_Stock",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Price",
      "equation": "10",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Cost_Per_Effort",
      "equation": "5",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Revenue",
      "equation": "Price * Harvest",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v8",
      "name": "Total_Cost",
      "equation": "Cost_Per_Effort * Fishing_Effort",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Profit",
      "equation": "Revenue - Total_Cost",
      "position": {
        "x": 300,
        "y": 480
      }
    },
    {
      "id": "v10",
      "name": "phi",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Fish_Stock",
      "to_element": "Harvest"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-15T14:52:39.346724+00:00",
  "updated_at": "2026-01-15T14:52:39.346779+00:00",
  "source": "https://doi.org/10.1086/257497",
  "reference": "Gordon, H.S. (1954). The economic theory of a common-property resource: The fishery. Journal of Political Economy 62:124-142."
}