{
  "id": "beverton-holt-stock-recruitment-mar",
  "name": "Beverton-Holt Stock-Recruitment Model",
  "description": "Density-dependent recruitment model for fish populations. Source: Beverton & Holt (1957), Fish. Invest. Ser. 2. Reference: UN World Population Prospects. Source: https://population.un.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Spawning_Stock",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Recruits",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Total_Biomass",
      "initial_value": 600,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "SSB_Change",
      "equation": "Maturation - Natural_Mortality_Adult - Fishing_Mortality",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Recruitment",
      "equation": "alpha * Spawning_Stock / (1 + beta * Spawning_Stock) - Juvenile_Mortality",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Biomass_Change",
      "equation": "(Spawning_Stock + Recruits) - Total_Biomass",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "alpha",
      "equation": "4",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "beta",
      "equation": "0.002",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "M",
      "equation": "0.2",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "F",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Natural_Mortality_Adult",
      "equation": "M * Spawning_Stock",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Fishing_Mortality",
      "equation": "F * Spawning_Stock",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Juvenile_Mortality",
      "equation": "0.5 * Recruits",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v8",
      "name": "Maturation",
      "equation": "0.3 * Recruits",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Exploitation_Rate",
      "equation": "F / (F + M)",
      "position": {
        "x": 300,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Spawning_Stock",
      "to_element": "Recruitment"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-15T14:52:39.346798+00:00",
  "updated_at": "2026-01-15T14:52:39.346804+00:00",
  "source": "https://doi.org/10.2307/1942037",
  "reference": "Beverton, R.J.H. & Holt, S.J. (1957). On the dynamics of exploited fish populations. Fish. Invest. Ser. 2, Vol. 19."
}