{
  "id": "world3-nonrenewable-resources-cla",
  "name": "Base_Per_Capita",
  "description": "Nonrenewable resources sector from World3/Limits to Growth model. Models resource extraction, depletion, and the effect of scarcity on industrial output. Based on Meadows et al. (1972, 2004). Reference: Meadows, D. H., et al. (1972). The Limits to Growth. Universe Books. Source: https://www.clubofrome.org/publication/the-limits-to-growth/",
  "stocks": [
    {
      "id": "s1",
      "name": "Nonrenewable_Resources",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Resource_Usage",
      "equation": "Population * Resource_Per_Capita * Technology_Multiplier",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Population",
      "equation": "6000",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Resource_Per_Capita",
      "equation": "Base_Per_Capita * Industrial_Output_Multiplier",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Base_Per_Capita",
      "equation": "0.15",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Industrial_Output_Multiplier",
      "equation": "1 + 0.02 * (TIME - 1900)",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "v5",
      "name": "Technology_Multiplier",
      "equation": "1 - 0.003 * (TIME - 1900)",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v6",
      "name": "Resource_Fraction_Remaining",
      "equation": "Nonrenewable_Resources / Initial_Resources",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "v7",
      "name": "Initial_Resources",
      "equation": "1000000",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Resource_Extraction_Cost",
      "equation": "1 / (Resource_Fraction_Remaining)^0.5",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "Capital_Fraction_to_Resources",
      "equation": "0.05 * Resource_Extraction_Cost",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Resource_Technology_Development",
      "equation": "0.95^((TIME - 1970) / 10)",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Technology_Multiplier",
      "to_element": "Resource_Usage"
    },
    {
      "id": "conn-2",
      "from_element": "Resource_Per_Capita",
      "to_element": "Resource_Usage"
    },
    {
      "id": "conn-3",
      "from_element": "Population",
      "to_element": "Resource_Usage"
    },
    {
      "id": "conn-4",
      "from_element": "Industrial_Output_Multiplier",
      "to_element": "Resource_Per_Capita"
    },
    {
      "id": "conn-5",
      "from_element": "Base_Per_Capita",
      "to_element": "Resource_Per_Capita"
    },
    {
      "id": "conn-6",
      "from_element": "Initial_Resources",
      "to_element": "Resource_Fraction_Remaining"
    },
    {
      "id": "conn-7",
      "from_element": "Nonrenewable_Resources",
      "to_element": "Resource_Fraction_Remaining"
    },
    {
      "id": "conn-8",
      "from_element": "Resource_Fraction_Remaining",
      "to_element": "Resource_Extraction_Cost"
    },
    {
      "id": "conn-9",
      "from_element": "Resource_Extraction_Cost",
      "to_element": "Capital_Fraction_to_Resources"
    }
  ],
  "time_settings": {
    "start": 1900,
    "end": 2100,
    "dt": 1
  },
  "created_at": "2026-01-12T07:23:15.854436+00:00",
  "updated_at": "2026-01-12T07:23:15.854436+00:00",
  "source": "https://doi.org/10.1111/jiec.13442",
  "reference": "Meadows et al. (1972, 2004). Limits to Growth. Nebel et al. (2023) recalibration."
}