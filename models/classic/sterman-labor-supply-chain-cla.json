{
  "id": "sterman-labor-supply-chain-cla",
  "name": "Sterman Labor Supply Chain Model",
  "description": "Classic model of labor market dynamics showing oscillations due to delayed feedback. From Business Dynamics Ch. 11. Source: Sterman (2000), Business Dynamics: Systems Thinking and Modeling for a Complex World. Reference: Sterman, J. D. (2000). Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill. Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-labor",
      "name": "Labor_Force",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-order",
      "name": "Order_Backlog",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-hire",
      "name": "Hiring",
      "equation": "MAX(0, Desired_Hiring)",
      "from_stock": null,
      "to_stock": "stock-labor",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-quit",
      "name": "Quit_Layoff",
      "equation": "Labor_Force * Attrition_Rate + MAX(0, Labor_Force - Desired_Labor) / Layoff_Time",
      "from_stock": "stock-labor",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-orders",
      "name": "Incoming_Orders",
      "equation": "Order_Rate",
      "from_stock": null,
      "to_stock": "stock-order",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "flow-fulfill",
      "name": "Order_Fulfillment",
      "equation": "MIN(Order_Backlog, Labor_Force * Productivity)",
      "from_stock": "stock-order",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-desired-labor",
      "name": "Desired_Labor",
      "equation": "Order_Backlog / Target_Delivery_Time / Productivity",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-labor-gap",
      "name": "Labor_Gap",
      "equation": "Desired_Labor - Labor_Force",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-desired-hiring",
      "name": "Desired_Hiring",
      "equation": "Labor_Gap / Time_To_Adjust + Labor_Force * Attrition_Rate",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-attrition",
      "name": "Attrition_Rate",
      "equation": "0.05",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-layoff",
      "name": "Layoff_Time",
      "equation": "2",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-order-rate",
      "name": "Order_Rate",
      "equation": "100 + 20 * SIN(TIME * 0.1)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-prod",
      "name": "Productivity",
      "equation": "0.2",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "var-target",
      "name": "Target_Delivery_Time",
      "equation": "4",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "var-adjust",
      "name": "Time_To_Adjust",
      "equation": "8",
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 0.5
  },
  "created_at": "2026-01-12T12:45:39.561592+00:00",
  "updated_at": "2026-01-12T12:45:39.561592+00:00",
  "source": "https://doi.org/10.1016/j.tre.2020.101922",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}