      }
    },
    {
      "id": "v10",
      "name": "Input_Lifetime",
      "equation": "10",
      "position": {
        "x": 700,
        "y": 300
      }
    },
    {
      "id": "v11",
      "name": "Food_Production",
      "equation": "Arable_Land * Land_Fertility * Land_Yield_Multiplier",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
