{
  "id": "world3-food-agriculture-sector-cla",
  "name": "Arable_Land",
  "description": "Food and agriculture sector from World3/Limits to Growth model. Models arable land, agricultural inputs, land fertility, and food production dynamics. Based on Meadows et al. (1972, 2004). Reference: Meadows, D. H., et al. (1972). The Limits to Growth. Universe Books. Source: https://www.clubofrome.org/publication/the-limits-to-growth/",
  "stocks": [
    {
      "id": "s1",
      "name": "Arable_Land",
      "initial_value": 900,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Land_Fertility",
      "initial_value": 600,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Agricultural_Input",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Land_Development",
      "equation": "Development_Rate * Potential_Arable_Land / Land_Development_Time",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Land_Erosion",
      "equation": "Arable_Land * Land_Erosion_Rate",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Land_Urbanization",
      "equation": "Urban_Land_Needed",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "f4",
      "name": "Fertility_Regeneration",
      "equation": "(Inherent_Fertility - Land_Fertility) / Fertility_Regeneration_Time",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Fertility_Degradation",
      "equation": "Land_Fertility * Pollution_Effect * 0.01",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f6",
      "name": "Input_Investment",
      "equation": "Investment_in_Agriculture",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "f7",
      "name": "Input_Depreciation",
      "equation": "Agricultural_Input / Input_Lifetime",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 700,
        "y": 200
      }
    }
  ],
  "variables": [
