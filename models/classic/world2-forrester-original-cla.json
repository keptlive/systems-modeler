{
  "id": "world2-forrester-original-cla",
  "name": "World2 Forrester Original Model",
  "description": "Jay Forrester’s five-sector WORLD2 global dynamics model. Version 1.8 restores the 1970 primary D-1354 documentor (MIT archive PDF pp. 82–91), including its 22 piecewise-linear feedback tables, birth/death normals 0.045/0.025 and initial agricultural fraction 0.3. Existing element IDs and positions are preserved. Capital Generation Multiplier is the source CIPC table divided by the retained 0.05 normal, an algebraically identical rescaling. The documented baseline pre/post-1970 policy coefficients are equal. Explicit Radau integration preserves the 1900–2100 annual output grid. This historical scenario is not a contemporary population or climate calibration.",
  "source": "https://dome.mit.edu/bitstream/handle/1721.3/189645/39080024064039.pdf?isAllowed=y&sequence=1",
  "reference": "Forrester, J.W. (1970), WORLD2 D-1354 equation documentor, equations 1–43, MIT archive PDF pp. 82–91; explicitly the 1970 formulation, not the later 1973 book variant.",
  "stocks": [
    {
      "id": "stock-pop",
      "name": "Population",
      "initial_value": 1650000000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-capital",
      "name": "Capital Investment",
      "initial_value": 400000000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-resources",
      "name": "Natural Resources",
      "initial_value": 900000000000,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-pollution",
      "name": "Pollution",
      "initial_value": 200000000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "stock-agric-frac",
      "name": "Capital in Agriculture Fraction",
      "initial_value": 0.3,
      "equation": "",
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-births",
      "name": "Birth Rate",
      "equation": "Population * Birth_Rate_Normal * Birth_Rate_Multiplier",
      "from_stock": null,
      "to_stock": "stock-pop",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-deaths",
      "name": "Death Rate",
      "equation": "Population * Death_Rate_Normal * Death_Rate_Multiplier",
      "from_stock": "stock-pop",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-capital-gen",
      "name": "Capital Generation",
      "equation": "Population * Capital_Generation_Normal * Capital_Generation_Multiplier",
      "from_stock": null,
      "to_stock": "stock-capital",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-depreciation",
      "name": "Capital Depreciation",
      "equation": "Capital_Investment / Capital_Normal_Lifetime",
      "from_stock": "stock-capital",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-resource-use",
      "name": "Resource Usage",
      "equation": "Population * Resource_Usage_Normal * Resource_Usage_Multiplier",
      "from_stock": "stock-resources",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "flow-pollution-gen",
      "name": "Pollution Generation",
      "equation": "Population * Pollution_Normal * Pollution_Generation_Multiplier",
      "from_stock": null,
      "to_stock": "stock-pollution",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-pollution-absorb",
      "name": "Pollution Absorption",
      "equation": "Pollution / Pollution_Absorption_Time",
      "from_stock": "stock-pollution",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "flow-agric-adjust",
      "name": "Agriculture Adjustment",
      "equation": "(Desired_Agric_Fraction - Capital_in_Agriculture_Fraction) / Agric_Adjustment_Time",
      "from_stock": null,
      "to_stock": "stock-agric-frac",
      "position": {
        "x": 100,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-brn",
      "name": "Birth Rate Normal",
      "equation": "0.045",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "var-brm",
      "name": "Birth Rate Multiplier",
      "equation": "BRM_Material * BRM_Crowding * BRM_Food * BRM_Pollution",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-brm-mat",
      "name": "BRM Material",
      "equation": "World2_BRMM(Material_Standard_of_Living)",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-brm-crowd",
      "name": "BRM Crowding",
      "equation": "World2_BRCM(Crowding_Ratio)",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "var-brm-food",
      "name": "BRM Food",
      "equation": "World2_BRFM(Food_Ratio)",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-brm-poll",
      "name": "BRM Pollution",
      "equation": "World2_BRPM(Pollution_Ratio)",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "var-drn",
      "name": "Death Rate Normal",
      "equation": "0.025",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "var-drm",
      "name": "Death Rate Multiplier",
      "equation": "DRM_Material * DRM_Crowding * DRM_Food * DRM_Pollution",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-drm-mat",
      "name": "DRM Material",
      "equation": "World2_DRMM(Material_Standard_of_Living)",
      "position": {
        "x": 50,
        "y": 250
      }
    },
    {
      "id": "var-drm-crowd",
      "name": "DRM Crowding",
      "equation": "World2_DRCM(Crowding_Ratio)",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "var-drm-food",
      "name": "DRM Food",
      "equation": "World2_DRFM(Food_Ratio)",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "var-drm-poll",
      "name": "DRM Pollution",
      "equation": "World2_DRPM(Pollution_Ratio)",
      "position": {
        "x": 350,
        "y": 250
      }
    },
    {
      "id": "var-cgn",
      "name": "Capital Generation Normal",
      "equation": "0.05",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "var-cgm",
      "name": "Capital Generation Multiplier",
      "equation": "World2_CIM(Material_Standard_of_Living)",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-cnl",
      "name": "Capital Normal Lifetime",
      "equation": "40",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "var-run",
      "name": "Resource Usage Normal",
      "equation": "1",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "var-rum",
      "name": "Resource Usage Multiplier",
      "equation": "World2_NRMM(Material_Standard_of_Living)",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-pn",
      "name": "Pollution Normal",
      "equation": "1",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "var-pgm",
      "name": "Pollution Generation Multiplier",
      "equation": "World2_POLCM(Capital_Investment / Population)",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "var-pat",
      "name": "Pollution Absorption Time",
      "equation": "World2_POLAT(Pollution_Ratio)",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "var-msol",
      "name": "Material Standard of Living",
      "equation": "(Capital_Investment / Population) * (1 - Capital_in_Agriculture_Fraction) * World2_NREM(Resource_Ratio) / (1 - 0.3)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-food-ratio",
      "name": "Food Ratio",
      "equation": "World2_FPCI((Capital_Investment / Population) * Capital_in_Agriculture_Fraction / 0.3) * World2_FCM(Crowding_Ratio) * World2_FPM(Pollution_Ratio)",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "var-crowd",
      "name": "Crowding Ratio",
      "equation": "Population / (135000000 * 26.5)",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "var-poll-ratio",
      "name": "Pollution Ratio",
      "equation": "Pollution / 3600000000",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-res-ratio",
      "name": "Resource Ratio",
      "equation": "Natural_Resources / 900000000000",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "var-qol",
      "name": "Quality of Life",
      "equation": "World2_QLM(Material_Standard_of_Living) * World2_QLC(Crowding_Ratio) * World2_QLF(Food_Ratio) * World2_QLP(Pollution_Ratio)",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-desired-agric",
      "name": "Desired Agric Fraction",
      "equation": "World2_CFIFR(Food_Ratio) * World2_CIQR(World2_QLM(Material_Standard_of_Living) / World2_QLF(Food_Ratio))",
      "position": {
        "x": 50,
        "y": 400
      }
    },
    {
      "id": "var-agric-adj-time",
      "name": "Agric Adjustment Time",
      "equation": "15",
      "position": {
        "x": 150,
        "y": 400
      }
    }
  ],
