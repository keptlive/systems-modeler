{
  "id": "world3-non-renewable-resources-sector-cla",
  "name": "World3 Non-Renewable Resources Sector",
  "description": "World3 nonrenewable resource sector reconstructed from the executable PyWorld3 resource.py standalone-sector example (p.405 of Dynamics of Growth in a Finite World). Includes its industrial-capital feedback, exponential exogenous population and clamped PCRUM/FCAOR tables. This is the isolated-sector demonstration, not the fully coupled World3 standard run. Population and capital constants replace the generated fixed-population closure; horizon and existing element geometry are retained.",
  "stocks": [
    {
      "id": "stock-non-renewable-resources",
      "name": "Non-Renewable Resources",
      "initial_value": 1000000000000.0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      },
      "units": "resource units"
    },
    {
      "id": "v19-industrial-capital",
      "name": "Industrial Capital",
      "position": {
        "x": 260,
        "y": 600
      },
      "initial_value": 210000000000.0,
      "equation": "",
      "units": "dollars"
    }
  ],
  "flows": [
    {
      "id": "flow-resource-usage-rate",
      "name": "Resource Usage Rate",
      "equation": "Population * Per_Capita_Resource_Usage * Resource_Usage_Multiplier",
      "from_stock": "stock-non-renewable-resources",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 200
      },
      "units": "resource units/year"
    },
    {
      "id": "v19-capital-investment",
      "name": "Industrial Capital Investment",
      "position": {
        "x": 260,
        "y": 600
      },
      "equation": "Industrial_Output * (1 - 0.12 - 0.12 - 0.43)",
      "from_stock": null,
      "to_stock": "v19-industrial-capital",
      "units": "dollars/year"
    },
    {
      "id": "v19-capital-depreciation",
      "name": "Industrial Capital Depreciation",
      "position": {
        "x": 420,
        "y": 600
      },
      "equation": "Industrial_Capital / 14",
      "from_stock": "v19-industrial-capital",
      "to_stock": null,
      "units": "dollars/year"
    }
  ],
  "variables": [
    {
      "id": "var-population",
      "name": "Population",
      "equation": "1.65e9 * EXP(0.012 * (Time - 1900))",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-per-capita-resource-usage",
      "name": "Per Capita Resource Usage",
      "equation": "1",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-resource-usage-multiplier",
      "name": "Resource Usage Multiplier",
      "equation": "Resource_Usage_From_Industry(Industrial_Output_Per_Capita)",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-fraction-of-resources-remaining",
      "name": "Fraction of Resources Remaining",
      "equation": "\"Non-Renewable Resources\" / Initial_Resources",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-initial-resources",
      "name": "Initial Resources",
      "equation": "1e12",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-resource-extraction-capital-requirement",
      "name": "Resource Extraction Capital Requirement",
      "equation": "Resource_Extraction_Fraction(Fraction_of_Resources_Remaining)",
      "position": {
        "x": 100,
        "y": 160
      }
    },
    {
      "id": "v19-industrial-output",
      "name": "Industrial Output",
      "position": {
        "x": 1060,
        "y": 600
      },
      "equation": "Industrial_Capital * (1 - Resource_Extraction_Capital_Requirement) / 3",
      "units": "dollars/year"
    },
    {
      "id": "v19-iopc",
      "name": "Industrial Output Per Capita",
      "position": {
        "x": 100,
        "y": 700
      },
      "equation": "Industrial_Output / Population",
      "units": "dollars/person/year"
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 1900,
    "end": 2100,
    "dt": 1
  },
