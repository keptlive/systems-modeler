{
  "id": "world3-non-renewable-resources-sector-cla",
  "name": "World3 Non-Renewable Resources Sector",
  "description": "The non-renewable resource dynamics sector from the World3 model. Models resource extraction, depletion, and the effect of declining resource availability on the economy. Reference: IRENA Renewable Energy Statistics. Source: https://www.irena.org/",
  "stocks": [
    {
      "id": "stock-non-renewable-resources",
      "name": "Non-Renewable Resources",
      "initial_value": 1000000000000.0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-resource-usage-rate",
      "name": "Resource Usage Rate",
      "equation": "Population * Per_Capita_Resource_Usage * Resource_Usage_Multiplier",
      "from_stock": "stock-non-renewable-resources",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-population",
      "name": "Population",
      "equation": "3e9",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-per-capita-resource-usage",
      "name": "Per Capita Resource Usage",
      "equation": "1",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-resource-usage-multiplier",
      "name": "Resource Usage Multiplier",
      "equation": "Resource_Usage_From_Industry(Industrial_Output_Per_Capita)",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-fraction-of-resources-remaining",
      "name": "Fraction of Resources Remaining",
      "equation": "Nonrenewable_Resources / Initial_Resources",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-initial-resources",
      "name": "Initial Resources",
      "equation": "1e12",
      "position": {
        "x": 700,
        "y": 80
      }
    },
    {
      "id": "var-resource-extraction-capital-requirement",
      "name": "Resource Extraction Capital Requirement",
      "equation": "Resource_Extraction_Fraction(Fraction_of_Resources_Remaining)",
      "position": {
        "x": 100,
        "y": 160
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 1900,
    "end": 2100,
    "dt": 1
  },
  "created_at": "2026-01-11T20:04:50.697230Z",
  "updated_at": "2026-01-11T20:04:50.697230Z",
  "source": "https://doi.org/10.1016/B978-0-12-850754-3.50020-2",
  "reference": "Meadows DH, Meadows DL, Randers J, Behrens WW. The Limits to Growth. Universe Books, 1972."
}