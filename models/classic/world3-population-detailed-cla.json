      "from_stock": "stock-p15-44",
      "to_stock": "stock-p45-64",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "flow-m45-64",
      "name": "Maturation_45_64",
      "equation": "Pop_45_64 / 20 - Pop_45_64 * Mortality_45_64",
      "from_stock": "stock-p45-64",
      "to_stock": "stock-p65plus",
      "position": {
        "x": 475,
        "y": 100
      }
    },
    {
      "id": "flow-deaths",
      "name": "Deaths_65_Plus",
