{
  "id": "world3-service-capital-cla",
  "name": "World3 Service Capital Subsystem",
  "description": "Service sector capital subsystem from World3 model (Meadows et al. 1972). Shows how service capital affects health, education, and quality of life. From 'Limits to Growth'. Reference: Meadows, D. H., et al. (1972). The Limits to Growth. Universe Books. Source: https://www.clubofrome.org/publication/the-limits-to-growth/",
  "stocks": [
    {
      "id": "stock-service-capital",
      "name": "Service Capital",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-life-expectancy",
      "name": "Life Expectancy",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-service-investment",
      "name": "Service Investment",
      "equation": "Industrial_Output * Service_Capital_Investment_Rate",
      "from_stock": null,
      "to_stock": "stock-service-capital",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-service-depreciation",
      "name": "Service Depreciation",
      "equation": "Service_Capital / Service_Capital_Lifetime",
      "from_stock": "stock-service-capital",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-life-expectancy-change",
      "name": "Life Expectancy Change",
      "equation": "(Equilibrium_Life_Expectancy - Life_Expectancy) / Life_Expectancy_Adjustment_Time",
      "from_stock": null,
      "to_stock": "stock-life-expectancy",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-population",
      "name": "Population",
      "equation": "4000",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-industrial-output",
      "name": "Industrial Output",
      "equation": "200",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-service-capital-investment-rate",
      "name": "Service Capital Investment Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 80
      }
    },
    {
      "id": "var-service-capital-lifetime",
      "name": "Service Capital Lifetime",
      "equation": "20",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-service-output-per-capita",
      "name": "Service Output per Capita",
      "equation": "Service_Capital / Population * Service_Capital_Productivity",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-service-capital-productivity",
      "name": "Service Capital Productivity",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "var-health-services-effect",
      "name": "Health Services Effect",
      "equation": "1 + 0.5 * Service_Output_per_Capita / (Service_Output_per_Capita + 0.01)",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "var-equilibrium-life-expectancy",
      "name": "Equilibrium Life Expectancy",
      "equation": "40 * Health_Services_Effect * Food_Effect * Pollution_Effect",
      "position": {
        "x": 100,
        "y": 370
      }
    },
    {
      "id": "var-food-effect",
      "name": "Food Effect",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 370
      }
    },
    {
      "id": "var-pollution-effect-le",
      "name": "Pollution Effect",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 370
      }
    },
    {
      "id": "var-life-expectancy-adjustment-time",
      "name": "Life Expectancy Adjustment Time",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 440
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 200,
    "dt": 1
  },
  "created_at": "2026-01-11T21:20:15.296056+00:00",
  "updated_at": "2026-01-11T21:20:15.296056+00:00",
  "source": "https://doi.org/10.1016/B978-0-12-850754-3.50020-2",
  "reference": "Meadows DH, Meadows DL, Randers J, Behrens WW. The Limits to Growth. Universe Books, 1972."
}