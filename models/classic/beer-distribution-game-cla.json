  "flows": [
    {
      "id": "flow-customer-demand",
      "name": "Customer Demand",
      "equation": "IF Time < 5 THEN 4 ELSE 8",
      "from_stock": null,
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-retailer-orders",
      "name": "Retailer Orders",
      "equation": "MAX(0, Expected_Demand + Inventory_Adjustment_Retailer + Supply_Line_Adjustment_Retailer)",
      "from_stock": null,
      "to_stock": "stock-supply-line-retailer",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-wholesaler-orders",
      "name": "Wholesaler Orders",
      "equation": "MAX(0, Retailer_Orders + Inventory_Adjustment_Wholesaler + Supply_Line_Adjustment_Wholesaler)",
      "from_stock": null,
      "to_stock": "stock-supply-line-wholesaler",
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "flow-distributor-orders",
      "name": "Distributor Orders",
      "equation": "MAX(0, Wholesaler_Orders + Inventory_Adjustment_Distributor + Supply_Line_Adjustment_Distributor)",
      "from_stock": null,
      "to_stock": "stock-supply-line-distributor",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "flow-production",
      "name": "Production",
      "equation": "DELAY3(Production_Order, Production_Delay)",
      "from_stock": null,
      "to_stock": "stock-factory-inventory",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
