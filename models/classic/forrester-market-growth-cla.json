{
  "id": "forrester-market-growth-cla",
  "name": "Forrester Market Growth Model",
  "description": "Jay Forrester's market growth model from Industrial Dynamics (1961). Shows how production capacity, backlog, and delivery delay interact to create boom-bust cycles. Foundation of business dynamics modeling.",
  "stocks": [
    {"id": "stock-production-capacity", "name": "Production Capacity", "initial_value": 100, "equation": "", "position": {"x": 200, "y": 150}},
    {"id": "stock-backlog", "name": "Backlog", "initial_value": 50, "equation": "", "position": {"x": 400, "y": 150}},
    {"id": "stock-sales-force", "name": "Sales Force", "initial_value": 20, "equation": "", "position": {"x": 600, "y": 150}},
    {"id": "stock-market-share", "name": "Market Share", "initial_value": 0.1, "equation": "", "position": {"x": 400, "y": 300}}
  ],
  "flows": [
    {"id": "flow-capacity-expansion", "name": "Capacity Expansion", "equation": "Desired_Capacity_Change / Capacity_Adjustment_Time", "from_stock": null, "to_stock": "stock-production-capacity", "position": {"x": 100, "y": 150}},
    {"id": "flow-orders", "name": "Orders", "equation": "Market_Size * Market_Share * (1 - Delivery_Delay / Max_Acceptable_Delay)", "from_stock": null, "to_stock": "stock-backlog", "position": {"x": 300, "y": 150}},
    {"id": "flow-shipments", "name": "Shipments", "equation": "MIN(Production_Capacity, Backlog / MIN_Delivery_Time)", "from_stock": "stock-backlog", "to_stock": null, "position": {"x": 500, "y": 150}},
    {"id": "flow-hiring", "name": "Hiring", "equation": "(Desired_Sales_Force - Sales_Force) / Hiring_Time", "from_stock": null, "to_stock": "stock-sales-force", "position": {"x": 550, "y": 150}},
    {"id": "flow-share-change", "name": "Share Change", "equation": "Sales_Effectiveness * Sales_Force * (1 - Market_Share) - Competitive_Loss * Market_Share", "from_stock": null, "to_stock": "stock-market-share", "position": {"x": 300, "y": 300}}
  ],
  "variables": [
    {"id": "var-delivery-delay", "name": "Delivery Delay", "equation": "Backlog / Production_Capacity", "position": {"x": 200, "y": 80}},
    {"id": "var-max-acceptable-delay", "name": "Max Acceptable Delay", "equation": "4", "position": {"x": 400, "y": 80}},
    {"id": "var-market-size", "name": "Market Size", "equation": "1000", "position": {"x": 550, "y": 80}},
    {"id": "var-desired-capacity", "name": "Desired Capacity", "equation": "Orders * (1 + Safety_Stock_Coverage)", "position": {"x": 150, "y": 230}},
    {"id": "var-desired-capacity-change", "name": "Desired Capacity Change", "equation": "Desired_Capacity - Production_Capacity", "position": {"x": 350, "y": 230}},
    {"id": "var-capacity-adjustment-time", "name": "Capacity Adjustment Time", "equation": "12", "position": {"x": 550, "y": 230}},
    {"id": "var-safety-stock-coverage", "name": "Safety Stock Coverage", "equation": "0.2", "position": {"x": 150, "y": 380}},
    {"id": "var-desired-sales-force", "name": "Desired Sales Force", "equation": "Market_Size * Market_Share / Sales_Productivity", "position": {"x": 350, "y": 380}},
    {"id": "var-sales-productivity", "name": "Sales Productivity", "equation": "50", "position": {"x": 550, "y": 380}},
    {"id": "var-hiring-time", "name": "Hiring Time", "equation": "6", "position": {"x": 150, "y": 450}},
    {"id": "var-sales-effectiveness", "name": "Sales Effectiveness", "equation": "0.01", "position": {"x": 350, "y": 450}},
    {"id": "var-competitive-loss", "name": "Competitive Loss", "equation": "0.02", "position": {"x": 550, "y": 450}},
    {"id": "var-min-delivery-time", "name": "MIN Delivery Time", "equation": "1", "position": {"x": 350, "y": 520}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 120, "dt": 0.25},
  "source": "https://mitpress.mit.edu/9780262560115/",
  "reference": "Forrester JW. Industrial Dynamics. MIT Press. 1961."
}
