{
  "id": "forrester-inventory-dynamics-cla",
  "name": "Forrester Industrial Dynamics Inventory Model",
  "description": "Classic inventory management model from Forrester's Industrial Dynamics (1961). Shows oscillations and instabilities in production-inventory systems with information delays. Reference: Forrester, J. W. (1961). Industrial Dynamics. MIT Press. Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Inventory",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Backlog",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Production In Process",
      "initial_value": 400,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Production Start Rate",
      "equation": "Desired_Production_Start_Rate",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Production Completion Rate",
      "equation": "Production_In_Process / Production_Delay",
      "from_stock": "s3",
      "to_stock": "s1",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Order Rate",
      "equation": "Customer_Orders",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Shipment Rate",
      "equation": "MIN(Inventory / Shipment_Time, Backlog / Shipment_Time)",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Production Delay",
      "equation": "4",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Customer Orders",
      "equation": "100 + STEP(20, 10)",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Shipment Time",
      "equation": "1",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Desired Inventory",
      "equation": "1000",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Inventory Adjustment Time",
      "equation": "8",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "v6",
      "name": "Inventory Correction",
      "equation": "(Desired_Inventory - Inventory) / Inventory_Adjustment_Time",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v7",
      "name": "Desired Production Start Rate",
      "equation": "Customer_Orders + Inventory_Correction",
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Production In Process",
      "to_element": "Production Completion Rate"
    },
    {
      "id": "c2",
      "from_element": "Inventory",
      "to_element": "Shipment Rate"
    },
    {
      "id": "c3",
      "from_element": "Backlog",
      "to_element": "Shipment Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25
  },
  "created_at": "2026-01-12T01:41:05.117791Z",
  "updated_at": "2026-01-12T01:41:05.117796Z",
  "source": "https://mitpress.mit.edu/9780262560115/industrial-dynamics/",
  "reference": "Forrester JW. Industrial Dynamics. MIT Press, 1961."
}