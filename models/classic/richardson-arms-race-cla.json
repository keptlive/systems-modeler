{
  "id": "richardson-arms-race-cla",
  "name": "Richardson Arms Race Model",
  "description": "Lewis Fry Richardson's (1960) differential equation model of arms races. Two nations build armaments in response to each other's military spending, leading to either escalation or mutual disarmament depending on parameters. Foundation of conflict modeling.",
  "stocks": [
    {"id": "stock-nation-a-arms", "name": "Nation A Arms", "initial_value": 100, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-nation-b-arms", "name": "Nation B Arms", "initial_value": 100, "equation": "", "position": {"x": 450, "y": 200}}
  ],
  "flows": [
    {"id": "flow-a-buildup", "name": "A Buildup", "equation": "Threat_Response_A * Nation_B_Arms - Fatigue_A * Nation_A_Arms + Grievance_A", "from_stock": null, "to_stock": "stock-nation-a-arms", "position": {"x": 100, "y": 200}},
    {"id": "flow-b-buildup", "name": "B Buildup", "equation": "Threat_Response_B * Nation_A_Arms - Fatigue_B * Nation_B_Arms + Grievance_B", "from_stock": null, "to_stock": "stock-nation-b-arms", "position": {"x": 350, "y": 200}}
  ],
  "variables": [
    {"id": "var-threat-response-a", "name": "Threat Response A", "equation": "0.5", "position": {"x": 150, "y": 100}},
    {"id": "var-threat-response-b", "name": "Threat Response B", "equation": "0.4", "position": {"x": 350, "y": 100}},
    {"id": "var-fatigue-a", "name": "Fatigue A", "equation": "0.3", "position": {"x": 500, "y": 100}},
    {"id": "var-fatigue-b", "name": "Fatigue B", "equation": "0.35", "position": {"x": 650, "y": 100}},
    {"id": "var-grievance-a", "name": "Grievance A", "equation": "10", "position": {"x": 150, "y": 300}},
    {"id": "var-grievance-b", "name": "Grievance B", "equation": "8", "position": {"x": 350, "y": 300}},
    {"id": "var-arms-ratio", "name": "Arms Ratio", "equation": "Nation_A_Arms / Nation_B_Arms", "position": {"x": 500, "y": 300}},
    {"id": "var-total-arms", "name": "Total Arms", "equation": "Nation_A_Arms + Nation_B_Arms", "position": {"x": 650, "y": 300}},
    {"id": "var-stability-condition", "name": "Stability Condition", "equation": "Fatigue_A * Fatigue_B - Threat_Response_A * Threat_Response_B", "position": {"x": 350, "y": 400}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 50, "dt": 0.25},
  "source": "https://doi.org/10.1038/132642a0",
  "reference": "Richardson LF. Arms and Insecurity: A Mathematical Study of the Causes and Origins of War. Boxwood Press. 1960."
}
