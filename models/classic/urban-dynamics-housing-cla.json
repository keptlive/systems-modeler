{
  "id": "urban-dynamics-housing-cla",
  "name": "Urban Dynamics Housing Sector",
  "description": "Housing sector from Forrester's Urban Dynamics (1969). Models aging housing stock through premium, worker, and underemployed categories. Construction driven by demand, with housing filtering down through age classes over time. Source: Forrester, J.W. (1969), Urban Dynamics, MIT Press. Reference: Forrester, J. W. (1961). Industrial Dynamics. MIT Press. Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-premium-housing",
      "name": "Premium_Housing",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-worker-housing",
      "name": "Worker_Housing",
      "initial_value": 30000,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-underemployed-housing",
      "name": "Underemployed_Housing",
      "initial_value": 20000,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-ph-construction",
      "name": "PH_Construction",
      "equation": "Premium_Housing_Construction_Rate",
      "from_stock": null,
      "to_stock": "stock-premium-housing",
      "position": {
        "x": 75,
        "y": 200
      }
    },
    {
      "id": "flow-ph-obsolescence",
      "name": "PH_Obsolescence",
      "equation": "Premium_Housing / Premium_Housing_Lifetime",
      "from_stock": "stock-premium-housing",
      "to_stock": "stock-worker-housing",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-wh-obsolescence",
      "name": "WH_Obsolescence",
      "equation": "Worker_Housing / Worker_Housing_Lifetime",
      "from_stock": "stock-worker-housing",
      "to_stock": "stock-underemployed-housing",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-uh-demolition",
      "name": "UH_Demolition",
      "equation": "Underemployed_Housing / Underemployed_Housing_Lifetime",
      "from_stock": "stock-underemployed-housing",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-ph-construction-rate",
      "name": "Premium_Housing_Construction_Rate",
      "equation": "500 * Housing_Demand_Ratio",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-ph-lifetime",
      "name": "Premium_Housing_Lifetime",
      "equation": "20",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-wh-lifetime",
      "name": "Worker_Housing_Lifetime",
      "equation": "30",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-uh-lifetime",
      "name": "Underemployed_Housing_Lifetime",
      "equation": "25",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
      "id": "var-housing-demand",
      "name": "Housing_Demand_Ratio",
      "equation": "1.0",
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Premium_Housing",
      "to_element": "PH_Obsolescence"
    },
    {
      "id": "conn-2",
      "from_element": "Premium_Housing_Lifetime",
      "to_element": "PH_Obsolescence"
    },
    {
      "id": "conn-3",
      "from_element": "Worker_Housing",
      "to_element": "WH_Obsolescence"
    },
    {
      "id": "conn-4",
      "from_element": "Worker_Housing_Lifetime",
      "to_element": "WH_Obsolescence"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-11T20:47:58.493311Z",
  "updated_at": "2026-01-11T20:47:58.493311Z",
  "source": "https://doi.org/10.1287/mnsc.35.3.321",
  "reference": "Sterman JD. Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill, 2000."
}