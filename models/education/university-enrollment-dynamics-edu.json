{
  "id": "university-enrollment-dynamics-edu",
  "name": "University Enrollment Dynamics Model",
  "description": "A system dynamics model of university enrollment dynamics. Models the flow of students through application, enrollment, retention, and graduation with feedback from reputation, financial aid, and capacity constraints. Reference: Cachon, G., & Terwiesch, C. (2012). Matching Supply with Demand. McGraw-Hill. Source: https://www.mheducation.com/",
  "stocks": [
    {
      "id": "stock-applicant-pool",
      "name": "Applicant Pool",
      "initial_value": 20000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "stock-admitted",
      "name": "Admitted Students",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "stock-freshmen",
      "name": "Freshmen",
      "initial_value": 3000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-sophomores",
      "name": "Sophomores",
      "initial_value": 2700,
      "equation": "",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "stock-juniors",
      "name": "Juniors",
      "initial_value": 2500,
      "equation": "",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "stock-seniors",
      "name": "Seniors",
      "initial_value": 2300,
      "equation": "",
      "position": {
        "x": 550,
        "y": 300
      }
    },
    {
      "id": "stock-alumni",
      "name": "Alumni Base",
      "initial_value": 50000,
      "equation": "",
      "position": {
        "x": 700,
        "y": 300
      }
    },
    {
      "id": "stock-reputation",
      "name": "Institutional Reputation",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 250,
        "y": 450
      }
    },
    {
      "id": "stock-endowment",
      "name": "Endowment Fund",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 550,
        "y": 450
      }
    }
  ],
  "flows": [
    {
      "id": "flow-applications",
      "name": "Applications",
      "equation": "Potential_Students * Application_Rate * Reputation_Effect",
      "from_stock": null,
      "to_stock": "stock-applicant-pool",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "flow-admissions",
      "name": "Admissions",
      "equation": "Applicant_Pool * Admission_Rate",
      "from_stock": "stock-applicant-pool",
      "to_stock": "stock-admitted",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "flow-enrollment",
      "name": "Enrollment",
      "equation": "Admitted_Students * Yield_Rate * Financial_Aid_Effect",
      "from_stock": "stock-admitted",
      "to_stock": "stock-freshmen",
      "position": {
        "x": 325,
        "y": 150
      }
    },
    {
      "id": "flow-to-sophomore",
      "name": "To Sophomore",
      "equation": "Freshmen * Freshman_Retention",
      "from_stock": "stock-freshmen",
      "to_stock": "stock-sophomores",
      "position": {
        "x": 475,
        "y": 150
      }
    },
    {
      "id": "flow-to-junior",
      "name": "To Junior",
      "equation": "Sophomores * Sophomore_Retention",
      "from_stock": "stock-sophomores",
      "to_stock": "stock-juniors",
      "position": {
        "x": 475,
        "y": 225
      }
    },
    {
      "id": "flow-to-senior",
      "name": "To Senior",
      "equation": "Juniors * Junior_Retention",
      "from_stock": "stock-juniors",
      "to_stock": "stock-seniors",
      "position": {
        "x": 475,
        "y": 300
      }
    },
    {
      "id": "flow-graduation",
      "name": "Graduation",
      "equation": "Seniors * Graduation_Rate",
      "from_stock": "stock-seniors",
      "to_stock": "stock-alumni",
      "position": {
        "x": 625,
        "y": 300
      }
    },
    {
      "id": "flow-dropout-fresh",
      "name": "Freshman Dropout",
      "equation": "Freshmen * (1 - Freshman_Retention)",
      "from_stock": "stock-freshmen",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "flow-reputation-building",
      "name": "Reputation Building",
      "equation": "(Research_Output + Teaching_Quality + Alumni_Success - Institutional_Reputation) / Reputation_Adjustment_Time",
      "from_stock": null,
      "to_stock": "stock-reputation",
      "position": {
        "x": 150,
        "y": 450
      }
    },
    {
      "id": "flow-endowment-growth",
      "name": "Endowment Growth",
      "equation": "Endowment_Fund * Investment_Return + Alumni_Donations",
      "from_stock": null,
      "to_stock": "stock-endowment",
      "position": {
        "x": 450,
        "y": 450
      }
    },
    {
      "id": "flow-endowment-spending",
      "name": "Endowment Spending",
      "equation": "Endowment_Fund * Spending_Rate",
      "from_stock": "stock-endowment",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 450
      }
    }
  ],
  "variables": [
    {
      "id": "var-potential-students",
      "name": "Potential Students",
      "equation": "100000",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-application-rate",
      "name": "Application Rate",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-reputation-effect",
      "name": "Reputation Effect",
      "equation": "Institutional_Reputation / 70",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-admission-rate",
      "name": "Admission Rate",
      "equation": "MIN(Target_Class_Size / Applicant_Pool, 0.5)",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-target-class",
      "name": "Target Class Size",
      "equation": "3200",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "var-yield-rate",
      "name": "Yield Rate",
      "equation": "0.35",
      "position": {
        "x": 600,
        "y": 50
      }
    },
    {
      "id": "var-financial-aid-effect",
      "name": "Financial Aid Effect",
      "equation": "1 + (Financial_Aid_Budget / Admitted_Students) * Aid_Sensitivity",
      "position": {
        "x": 700,
        "y": 50
      }
    },
    {
      "id": "var-financial-aid-budget",
      "name": "Financial Aid Budget",
      "equation": "Endowment_Spending * Aid_Fraction",
      "position": {
        "x": 100,
        "y": 550
      }
    },
    {
      "id": "var-aid-fraction",
      "name": "Aid Fraction",
      "equation": "0.4",
      "position": {
        "x": 200,
        "y": 550
      }
    },
    {
      "id": "var-aid-sensitivity",
      "name": "Aid Sensitivity",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 550
      }
    },
    {
      "id": "var-freshman-retention",
      "name": "Freshman Retention",
      "equation": "0.9",
      "position": {
        "x": 400,
        "y": 550
      }
    },
    {
      "id": "var-sophomore-retention",
      "name": "Sophomore Retention",
      "equation": "0.95",
      "position": {
        "x": 500,
        "y": 550
      }
    },
    {
      "id": "var-junior-retention",
      "name": "Junior Retention",
      "equation": "0.96",
      "position": {
        "x": 600,
        "y": 550
      }
    },
    {
      "id": "var-graduation-rate",
      "name": "Graduation Rate",
      "equation": "0.98",
      "position": {
        "x": 700,
        "y": 550
      }
    },
    {
      "id": "var-total-enrollment",
      "name": "Total Enrollment",
      "equation": "Freshmen + Sophomores + Juniors + Seniors",
      "position": {
        "x": 100,
        "y": 650
      }
    },
    {
      "id": "var-research-output",
      "name": "Research Output",
      "equation": "70",
      "position": {
        "x": 200,
        "y": 650
      }
    },
    {
      "id": "var-teaching-quality",
      "name": "Teaching Quality",
      "equation": "75",
      "position": {
        "x": 300,
        "y": 650
      }
    },
    {
      "id": "var-alumni-success",
      "name": "Alumni Success",
      "equation": "65",
      "position": {
        "x": 400,
        "y": 650
      }
    },
    {
      "id": "var-reputation-adj-time",
      "name": "Reputation Adjustment Time",
      "equation": "5",
      "position": {
        "x": 500,
        "y": 650
      }
    },
    {
      "id": "var-investment-return",
      "name": "Investment Return",
      "equation": "0.07",
      "position": {
        "x": 600,
        "y": 650
      }
    },
    {
      "id": "var-alumni-donations",
      "name": "Alumni Donations",
      "equation": "Alumni_Base * Donation_Rate",
      "position": {
        "x": 700,
        "y": 650
      }
    },
    {
      "id": "var-donation-rate",
      "name": "Donation Rate",
      "equation": "0.001",
      "position": {
        "x": 100,
        "y": 750
      }
    },
    {
      "id": "var-spending-rate",
      "name": "Spending Rate",
      "equation": "0.05",
      "position": {
        "x": 200,
        "y": 750
      }
    },
    {
      "id": "var-endowment-spending",
      "name": "Endowment Spending Auxiliary",
      "equation": "Endowment_Fund * Spending_Rate",
      "position": {
        "x": 300,
        "y": 750
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Institutional Reputation",
      "to_element": "Reputation Effect"
    },
    {
      "id": "conn-2",
      "from_element": "Reputation Effect",
      "to_element": "Applications"
    },
    {
      "id": "conn-3",
      "from_element": "Applicant Pool",
      "to_element": "Admissions"
    },
    {
      "id": "conn-4",
      "from_element": "Financial Aid Effect",
      "to_element": "Enrollment"
    },
    {
      "id": "conn-5",
      "from_element": "Freshmen",
      "to_element": "To Sophomore"
    },
    {
      "id": "conn-6",
      "from_element": "Sophomores",
      "to_element": "To Junior"
    },
    {
      "id": "conn-7",
      "from_element": "Juniors",
      "to_element": "To Senior"
    },
    {
      "id": "conn-8",
      "from_element": "Seniors",
      "to_element": "Graduation"
    },
    {
      "id": "conn-9",
      "from_element": "Endowment Fund",
      "to_element": "Endowment Spending"
    },
    {
      "id": "conn-10",
      "from_element": "Alumni Base",
      "to_element": "Alumni Donations"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.25
  },
