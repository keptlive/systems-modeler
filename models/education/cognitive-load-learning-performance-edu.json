{
  "id": "cognitive-load-learning-performance-edu",
  "name": "Cognitive Load Theory Model",
  "description": "Model of learning efficiency based on cognitive load theory. Source: Sweller (1988), Cognitive Science.",
  "stocks": [
    {
      "id": "s1",
      "name": "Working_Memory_Load",
      "initial_value": 0.3,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Long_Term_Memory",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Schema_Formation",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Load_Change",
      "equation": "Intrinsic_Load + Extraneous_Load + Germane_Load - Decay_Rate * Working_Memory_Load",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Learning",
      "equation": "Learning_Rate * (1 - Working_Memory_Load) * Effort",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Schema_Building",
      "equation": "IF(Working_Memory_Load < Optimal_Load, Schema_Rate * Germane_Load, 0)",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Task_Complexity",
      "equation": "0.4",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Expertise",
      "equation": "Long_Term_Memory / 100",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Intrinsic_Load",
      "equation": "Task_Complexity * (1 - Expertise)",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Extraneous_Load",
      "equation": "0.2",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Germane_Load",
      "equation": "0.2",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Optimal_Load",
      "equation": "0.7",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Decay_Rate",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 450
      }
    },
    {
      "id": "v8",
      "name": "Learning_Rate",
      "equation": "0.1",
      "position": {
        "x": 350,
        "y": 450
      }
    },
    {
      "id": "v9",
      "name": "Schema_Rate",
      "equation": "0.05",
      "position": {
        "x": 500,
        "y": 450
      }
    },
    {
      "id": "v10",
      "name": "Effort",
      "equation": "1.0",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Long_Term_Memory",
      "to_element": "Expertise"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
