{
  "id": "escalation-archetype-edu",
  "name": "Escalation System Archetype",
  "description": "Two parties compete by escalating actions, leading to arms race dynamics. Source: Senge (1990), The Fifth Discipline. DOI: 10.1108/eb025496",
  "stocks": [
    {
      "id": "stock-a",
      "name": "Party_A_Actions",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "stock-b",
      "name": "Party_B_Actions",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-aesc",
      "name": "A_Escalation",
      "equation": "Party_A_Actions * Response_Rate_A * (Party_B_Actions / Party_A_Actions - 1)",
      "from_stock": null,
      "to_stock": "stock-a",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "flow-besc",
      "name": "B_Escalation",
      "equation": "Party_B_Actions * Response_Rate_B * (Party_A_Actions / Party_B_Actions - 1)",
      "from_stock": null,
      "to_stock": "stock-b",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-adecay",
      "name": "A_Decay",
      "equation": "Party_A_Actions * Natural_Decay",
      "from_stock": "stock-a",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "flow-bdecay",
      "name": "B_Decay",
      "equation": "Party_B_Actions * Natural_Decay",
      "from_stock": "stock-b",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-ratea",
      "name": "Response_Rate_A",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-rateb",
      "name": "Response_Rate_B",
      "equation": "0.25",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-decay",
      "name": "Natural_Decay",
      "equation": "0.02",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-total",
      "name": "Total_Escalation",
      "equation": "Party_A_Actions + Party_B_Actions",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-ratio",
      "name": "Power_Ratio",
      "equation": "Party_A_Actions / Party_B_Actions",
      "position": {
        "x": 400,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Party_B_Actions",
      "to_element": "A_Escalation"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5
  },
  "created_at": "2026-01-12T02:13:18.795701+00:00",
  "updated_at": "2026-01-12T02:13:18.795708+00:00",
  "source": "https://doi.org/10.1108/eb025496",
  "reference": "Senge, P.M. (1990). The Fifth Discipline: The Art and Practice of the Learning Organization."
}