{
  "id": "meadows-bathtub-dynamics-edu",
  "name": "Meadows Bathtub Dynamics Model",
  "description": "Classic bathtub demonstration model from Donella Meadows' Thinking in Systems showing how stocks accumulate and deplete based on inflows and outflows. This fundamental mental model demonstrates why stocks change slowly even when flows change quickly.",
  "stocks": [
    {
      "id": "s1",
      "name": "Water_in_Bathtub",
      "initial_value": 50,
      "equation": "",
      "position": {"x": 300, "y": 200}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Inflow",
      "equation": "Faucet_Setting",
      "from_stock": null,
      "to_stock": "Water_in_Bathtub",
      "position": {"x": 150, "y": 200}
    },
    {
      "id": "f2",
      "name": "Outflow",
      "equation": "Drain_Effectiveness * Water_in_Bathtub / Drain_Time",
      "from_stock": "Water_in_Bathtub",
      "to_stock": null,
      "position": {"x": 450, "y": 200}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Faucet_Setting",
      "equation": "10",
      "position": {"x": 150, "y": 100}
    },
    {
      "id": "v2",
      "name": "Drain_Effectiveness",
      "equation": "1",
      "position": {"x": 300, "y": 100}
    },
    {
      "id": "v3",
      "name": "Drain_Time",
      "equation": "5",
      "position": {"x": 450, "y": 100}
    },
    {
      "id": "v4",
      "name": "Net_Flow",
      "equation": "Inflow - Outflow",
      "position": {"x": 300, "y": 350}
    },
    {
      "id": "v5",
      "name": "Equilibrium_Level",
      "equation": "Faucet_Setting * Drain_Time / Drain_Effectiveness",
      "position": {"x": 500, "y": 350}
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "source": "https://www.chelseagreen.com/product/thinking-in-systems/",
  "reference": "Meadows DH. Thinking in Systems: A Primer. Chelsea Green Publishing; 2008. ISBN: 978-1-60358-055-7. Also: Meadows DH, Meadows DL, Randers J. Beyond the Limits. Chelsea Green; 1992.",
  "created_at": "2026-01-15T20:30:00.000000Z",
  "updated_at": "2026-01-15T20:30:00.000000Z"
}
