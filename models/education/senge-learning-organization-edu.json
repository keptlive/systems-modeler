      "name": "Systems_Thinking",
      "initial_value": 20,
      "equation": "",
      "position": {"x": 300, "y": 450}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Learning_Increase",
      "equation": "Learning_Rate * Shared_Vision * Personal_Mastery * Systems_Thinking / 10000",
      "from_stock": null,
      "to_stock": "Organizational_Learning",
      "position": {"x": 150, "y": 200}
    },
    {
      "id": "f2",
      "name": "Learning_Depreciation",
      "equation": "Organizational_Learning * Forgetting_Rate",
      "from_stock": "Organizational_Learning",
      "to_stock": null,
      "position": {"x": 450, "y": 200}
    },
    {
      "id": "f3",
      "name": "Vision_Building",
      "equation": "(Target_Vision - Shared_Vision) * Vision_Rate * Leadership_Effect",
      "from_stock": null,
      "to_stock": "Shared_Vision",
      "position": {"x": 50, "y": 350}
    },
    {
      "id": "f4",
      "name": "Mastery_Development",
      "equation": "Training_Investment * Mastery_Rate * (100 - Personal_Mastery) / 100",
      "from_stock": null,
      "to_stock": "Personal_Mastery",
      "position": {"x": 550, "y": 350}
    },
    {
      "id": "f5",
      "name": "Systems_Skill_Growth",
      "equation": "Systems_Training * (Organizational_Learning / 50) * (100 - Systems_Thinking) / 100",
      "from_stock": null,
      "to_stock": "Systems_Thinking",
      "position": {"x": 200, "y": 450}
    }
  ],
  "variables": [
