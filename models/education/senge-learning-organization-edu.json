{
  "id": "senge-learning-organization-edu",
  "name": "Senge Learning Organization Model",
  "description": "Model of organizational learning dynamics based on Peter Senge's Fifth Discipline. Shows how personal mastery, mental models, shared vision, team learning, and systems thinking combine to create learning organizations. Demonstrates reinforcing loops of capability building.",
  "stocks": [
    {
      "id": "s1",
