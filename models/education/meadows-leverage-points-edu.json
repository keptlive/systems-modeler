{
  "id": "meadows-leverage-points-edu",
  "name": "Meadows Leverage Points Model",
  "description": "Educational model demonstrating Donella Meadows' hierarchy of leverage points in systems - places to intervene ranging from parameters and buffers up through system goals and paradigms. Shows how different intervention levels have different effects.",
  "stocks": [
    {
      "id": "s1",
      "name": "System_State",
      "initial_value": 50,
      "equation": "",
      "position": {"x": 300, "y": 200}
    },
    {
      "id": "s2",
      "name": "System_Goal",
      "initial_value": 100,
      "equation": "",
      "position": {"x": 300, "y": 350}
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "State_Change",
      "equation": "Gain * (System_Goal - System_State) / Adjustment_Time",
      "from_stock": null,
      "to_stock": "System_State",
      "position": {"x": 150, "y": 200}
    },
    {
      "id": "f2",
      "name": "Disturbance",
      "equation": "Noise_Level * (Random_Factor - 0.5)",
      "from_stock": null,
      "to_stock": "System_State",
      "position": {"x": 450, "y": 200}
    },
    {
      "id": "f3",
      "name": "Goal_Shift",
      "equation": "(Paradigm_Level * Paradigm_Effect - System_Goal) / Goal_Change_Time",
      "from_stock": null,
      "to_stock": "System_Goal",
      "position": {"x": 150, "y": 350}
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Gain",
      "equation": "1",
      "position": {"x": 100, "y": 100}
    },
    {
      "id": "v2",
      "name": "Adjustment_Time",
      "equation": "5",
      "position": {"x": 200, "y": 100}
    },
    {
      "id": "v3",
      "name": "Noise_Level",
      "equation": "5",
      "position": {"x": 400, "y": 100}
    },
    {
      "id": "v4",
      "name": "Random_Factor",
      "equation": "0.5",
      "position": {"x": 500, "y": 100}
    },
    {
      "id": "v5",
      "name": "Paradigm_Level",
      "equation": "100",
      "position": {"x": 100, "y": 450}
    },
    {
      "id": "v6",
      "name": "Paradigm_Effect",
      "equation": "1",
      "position": {"x": 200, "y": 450}
    },
    {
      "id": "v7",
      "name": "Goal_Change_Time",
      "equation": "20",
      "position": {"x": 300, "y": 450}
    },
    {
      "id": "v8",
      "name": "Gap",
      "equation": "System_Goal - System_State",
      "position": {"x": 450, "y": 300}
    },
    {
      "id": "v9",
      "name": "Leverage_Level",
      "equation": "Gain / Adjustment_Time",
      "position": {"x": 550, "y": 300}
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "source": "https://donellameadows.org/archives/leverage-points-places-to-intervene-in-a-system/",
  "reference": "Meadows DH. Leverage Points: Places to Intervene in a System. The Sustainability Institute; 1999. Also published in Whole Earth, Winter 1997.",
  "created_at": "2026-01-15T20:30:00.000000Z",
  "updated_at": "2026-01-15T20:30:00.000000Z"
}
