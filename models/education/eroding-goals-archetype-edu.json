{
  "id": "eroding-goals-archetype-edu",
  "name": "Eroding Goals Archetype",
  "description": "Eroding goals system archetype from Sterman's Business Dynamics (2000), Chapter 5. Shows how persistent gaps between goals and performance can lead to goals being adjusted downward rather than performance being improved. Source: Sterman, J.D. (2000), Business Dynamics, McGraw-Hill. Reference: Sterman, J. D. (2000). Business Dynamics: Systems Thinking and Modeling for a Complex World. McGraw-Hill. Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-performance",
      "name": "Performance",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-goal",
      "name": "Goal",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-performance-change",
      "name": "Performance_Change",
      "equation": "Performance_Gap / Time_to_Improve_Performance",
      "from_stock": null,
      "to_stock": "stock-performance",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-goal-erosion",
      "name": "Goal_Erosion",
      "equation": "-Performance_Gap / Time_to_Erode_Goals",
      "from_stock": null,
      "to_stock": "stock-goal",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-performance-gap",
      "name": "Performance_Gap",
      "equation": "Goal - Performance",
      "position": {
        "x": 325,
        "y": 80
      }
    },
    {
      "id": "var-time-improve",
      "name": "Time_to_Improve_Performance",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-time-erode",
      "name": "Time_to_Erode_Goals",
      "equation": "20",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-relative-weight",
      "name": "Goal_Erosion_Weight",
      "equation": "Time_to_Improve_Performance / Time_to_Erode_Goals",
      "position": {
        "x": 325,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Performance",
      "to_element": "Performance_Gap"
    },
    {
      "id": "conn-2",
      "from_element": "Goal",
      "to_element": "Performance_Gap"
    },
    {
      "id": "conn-3",
      "from_element": "Performance_Gap",
      "to_element": "Performance_Change"
    },
    {
      "id": "conn-4",
      "from_element": "Performance_Gap",
      "to_element": "Goal_Erosion"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.5
  },
  "created_at": "2026-01-11T20:52:52.274683+00:00",
  "updated_at": "2026-01-11T20:52:52.274683+00:00",
  "source": "https://github.com/SDXorg/PySD-Cookbook",
  "reference": "System Dynamics Educational Models - PySD Cookbook"
}