{
  "id": "first-order-delay-edu",
  "name": "First Order Delay",
  "description": "A fundamental system dynamics structure demonstrating exponential (first-order) delay behavior. Material flowing into the delay buffer exits at a rate proportional to the buffer contents, creating an exponential smoothing effect. The output gradually approaches and tracks the input with a time lag. This is one of the most important building blocks in system dynamics modeling. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "stock-delay-buffer",
      "name": "Delay Buffer",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-input",
      "name": "Input",
      "equation": "Test_Input",
      "from_stock": null,
      "to_stock": "stock-delay-buffer",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-output",
      "name": "Output",
      "equation": "Delay_Buffer / Delay",
      "from_stock": "stock-delay-buffer",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-test-input",
      "name": "Test Input",
      "equation": "5",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-delay",
      "name": "Delay",
      "equation": "3",
      "position": {
        "x": 250,
        "y": 80
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Test Input",
      "to_element": "Input"
    },
    {
      "id": "conn-2",
      "from_element": "Delay Buffer",
      "to_element": "Output"
    },
    {
      "id": "conn-3",
      "from_element": "Delay",
      "to_element": "Output"
    },
    {
      "id": "conn-4",
      "from_element": "Delay",
      "to_element": "Delay Buffer"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 1
  },
