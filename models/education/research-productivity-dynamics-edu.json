{
  "id": "research-productivity-dynamics-edu",
  "name": "Research Productivity Dynamics",
  "description": "Academic research productivity model showing relationships between funding, personnel, publications, and citations. Models cumulative advantage in research. Source: Based on bibliometric studies of research productivity.",
  "stocks": [
    {
      "id": "stock-researchers",
      "name": "Active_Researchers",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "stock-publications",
      "name": "Cumulative_Publications",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "stock-citations",
      "name": "Total_Citations",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "stock-funding",
      "name": "Research_Funding",
      "initial_value": 1000000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-hiring",
      "name": "Researcher_Hiring",
      "equation": "Research_Funding * Hiring_Rate / Researcher_Cost",
      "from_stock": null,
      "to_stock": "stock-researchers",
      "position": {
        "x": 75,
        "y": 150
      }
    },
    {
      "id": "flow-departure",
      "name": "Researcher_Departure",
      "equation": "Active_Researchers * Departure_Rate",
      "from_stock": "stock-researchers",
      "to_stock": null,
      "position": {
        "x": 225,
        "y": 150
      }
    },
    {
      "id": "flow-publication",
      "name": "New_Publications",
      "equation": "Active_Researchers * Publication_Rate * (1 + Experience_Effect)",
      "from_stock": null,
      "to_stock": "stock-publications",
      "position": {
        "x": 325,
        "y": 150
      }
    },
    {
      "id": "flow-citations",
      "name": "New_Citations",
      "equation": "Cumulative_Publications * Citation_Rate * (1 + Visibility_Effect)",
      "from_stock": null,
      "to_stock": "stock-citations",
      "position": {
        "x": 325,
        "y": 300
      }
    },
    {
      "id": "flow-funding-gain",
      "name": "New_Funding",
      "equation": "Base_Funding + Citation_Funding_Effect * Total_Citations",
      "from_stock": null,
      "to_stock": "stock-funding",
      "position": {
        "x": 75,
        "y": 300
      }
    },
    {
      "id": "flow-funding-spend",
      "name": "Funding_Expenditure",
      "equation": "Research_Funding * Expenditure_Rate",
      "from_stock": "stock-funding",
      "to_stock": null,
      "position": {
        "x": 225,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-publication-rate",
      "name": "Publication_Rate",
      "equation": "2",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-citation-rate",
      "name": "Citation_Rate",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 80
      }
    },
    {
      "id": "var-hiring-rate",
      "name": "Hiring_Rate",
      "equation": "0.1",
      "position": {
        "x": 50,
        "y": 80
      }
    },
    {
      "id": "var-departure-rate",
      "name": "Departure_Rate",
      "equation": "0.1",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-researcher-cost",
      "name": "Researcher_Cost",
      "equation": "100000",
      "position": {
        "x": 100,
        "y": 220
      }
    },
    {
      "id": "var-experience-effect",
      "name": "Experience_Effect",
      "equation": "Cumulative_Publications / (Cumulative_Publications + 500)",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "var-visibility-effect",
      "name": "Visibility_Effect",
      "equation": "Total_Citations / (Total_Citations + 5000)",
      "position": {
        "x": 500,
        "y": 300
      }
    },
    {
      "id": "var-base-funding",
      "name": "Base_Funding",
      "equation": "50000",
      "position": {
        "x": 50,
        "y": 380
      }
    },
    {
      "id": "var-citation-funding",
      "name": "Citation_Funding_Effect",
      "equation": "10",
      "position": {
        "x": 150,
        "y": 380
      }
    },
    {
      "id": "var-expenditure-rate",
      "name": "Expenditure_Rate",
      "equation": "0.8",
      "position": {
        "x": 250,
        "y": 380
      }
    },
    {
      "id": "var-h-index",
      "name": "H_Index_Proxy",
      "equation": "SQRT(Total_Citations)",
      "position": {
        "x": 500,
        "y": 380
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Research_Funding",
      "to_element": "Researcher_Hiring"
    },
    {
      "id": "conn-2",
      "from_element": "Active_Researchers",
      "to_element": "New_Publications"
    },
    {
      "id": "conn-3",
      "from_element": "Cumulative_Publications",
      "to_element": "New_Citations"
    },
    {
      "id": "conn-4",
      "from_element": "Total_Citations",
      "to_element": "New_Funding"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 1
  },
  "created_at": "2026-01-11T20:57:03.374124+00:00",
  "updated_at": "2026-01-11T20:57:03.374124+00:00",
  "source": "https://github.com/SDXorg/PySD-Cookbook",
  "reference": "System Dynamics Educational Models - PySD Cookbook"
}