{
  "id": "limits-to-growth-archetype-edu",
  "name": "Limits to Growth System Archetype",
  "description": "Classic system archetype showing how reinforcing growth eventually encounters limiting factors. From Senge's 'The Fifth Discipline' (1990). Shows S-curve behavior and the importance of identifying constraints early. Reference: Senge, P. M. (1990). The Fifth Discipline. Doubleday/Currency. Source: https://mitsloan.mit.edu/",
  "stocks": [
    {
      "id": "stock-performance",
      "name": "Performance",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-growth",
      "name": "Growth",
      "equation": "Performance * Growth_Rate * Constraint_Effect",
      "from_stock": null,
      "to_stock": "stock-performance",
      "position": {
        "x": 200,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-growth-rate",
      "name": "Growth Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-constraint-limit",
      "name": "Constraint Limit",
      "equation": "100",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "var-constraint-effect",
      "name": "Constraint Effect",
      "equation": "1 - Performance / Constraint_Limit",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-gap-from-limit",
      "name": "Gap from Limit",
      "equation": "Constraint_Limit - Performance",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "var-percent-of-limit",
      "name": "Percent of Limit",
      "equation": "Performance / Constraint_Limit * 100",
      "position": {
        "x": 100,
        "y": 160
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-11T21:20:15.295781+00:00",
  "updated_at": "2026-01-11T21:20:15.295781+00:00",
  "source": "https://github.com/SDXorg/PySD-Cookbook",
  "reference": "System Dynamics Educational Models - PySD Cookbook"
}