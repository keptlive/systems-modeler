{
  "id": "teacher-retention-burnout-edu",
  "name": "Teacher Retention and Burnout Model",
  "description": "Models teacher workforce dynamics including recruitment, burnout, and retention. Based on Ingersoll (2001) analysis of teacher turnover. Reference: Darling-Hammond, L. (2017). Teacher education around the world. European Journal of Teacher Education. Source: https://doi.org/10.1080/02619768.2017.1315399",
  "stocks": [
    {
      "id": "stock-new-teachers",
      "name": "New_Teachers",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "stock-experienced-teachers",
      "name": "Experienced_Teachers",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "stock-burned-out",
      "name": "Burned_Out_Teachers",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 150
      }
    },
    {
      "id": "stock-left-profession",
      "name": "Left_Profession",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "stock-workload",
      "name": "Teacher_Workload",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "flow-recruitment",
      "name": "Teacher_Recruitment",
      "equation": "Recruitment_Budget / Training_Cost * (1 - Shortage_Effect)",
      "from_stock": null,
      "to_stock": "stock-new-teachers",
      "position": {
        "x": 75,
        "y": 150
      }
    },
    {
      "id": "flow-experience",
      "name": "Gaining_Experience",
      "equation": "New_Teachers / Experience_Time",
      "from_stock": "stock-new-teachers",
      "to_stock": "stock-experienced-teachers",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "flow-burnout",
      "name": "Burnout_Rate",
      "equation": "(New_Teachers + Experienced_Teachers) * Burnout_Probability * Teacher_Workload / Reference_Workload",
      "from_stock": "stock-experienced-teachers",
      "to_stock": "stock-burned-out",
      "position": {
        "x": 450,
        "y": 150
      }
    },
    {
      "id": "flow-leaving-new",
      "name": "New_Teacher_Leaving",
      "equation": "New_Teachers * Early_Leaving_Rate",
      "from_stock": "stock-new-teachers",
      "to_stock": "stock-left-profession",
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "flow-leaving-burnout",
      "name": "Burnout_Leaving",
      "equation": "Burned_Out_Teachers / Recovery_Time",
      "from_stock": "stock-burned-out",
      "to_stock": "stock-left-profession",
      "position": {
        "x": 500,
        "y": 250
      }
    },
    {
      "id": "flow-workload-change",
      "name": "Workload_Change",
      "equation": "Student_Population / (New_Teachers + Experienced_Teachers + 1) - Teacher_Workload",
      "from_stock": null,
      "to_stock": "stock-workload",
      "position": {
        "x": 100,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-recruitment-budget",
      "name": "Recruitment_Budget",
      "equation": "1000",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-training-cost",
      "name": "Training_Cost",
      "equation": "50",
      "position": {
        "x": 220,
        "y": 80
      }
    },
    {
      "id": "var-shortage-effect",
      "name": "Shortage_Effect",
      "equation": "MIN(0.5, Left_Profession / 1000)",
      "position": {
        "x": 360,
        "y": 80
      }
    },
    {
      "id": "var-experience-time",
      "name": "Experience_Time",
      "equation": "3",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-burnout-probability",
      "name": "Burnout_Probability",
      "equation": "0.1",
      "position": {
        "x": 620,
        "y": 80
      }
    },
    {
      "id": "var-reference-workload",
      "name": "Reference_Workload",
      "equation": "25",
      "position": {
        "x": 100,
        "y": 380
      }
    },
    {
      "id": "var-early-leaving-rate",
      "name": "Early_Leaving_Rate",
      "equation": "0.15",
      "position": {
        "x": 250,
        "y": 380
      }
    },
    {
      "id": "var-recovery-time",
      "name": "Recovery_Time",
      "equation": "2",
      "position": {
        "x": 400,
        "y": 380
      }
    },
    {
      "id": "var-student-population",
      "name": "Student_Population",
      "equation": "10000",
      "position": {
        "x": 550,
        "y": 380
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.25
  },
  "created_at": "2026-01-12T01:19:34.565478+00:00",
  "updated_at": "2026-01-12T01:19:34.565506+00:00",
  "source": "https://doi.org/10.3102/00028312038003499",
  "reference": "Ingersoll RM. Teacher Turnover and Teacher Shortages: An Organizational Analysis. American Educational Research Journal. 2001;38(3):499-534."
}