{
  "id": "peer-review-quality-edu",
  "name": "Academic Peer Review Quality Model",
  "description": "Models peer review system quality and publication bias. Source: Smith (2006), JRSM. DOI: 10.1177/014107680609900414",
  "stocks": [
    {
      "id": "stock-submitted",
      "name": "Submitted_Papers",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "stock-reviewing",
      "name": "Under_Review",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "stock-published",
      "name": "Published",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "stock-rejected",
      "name": "Rejected",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-submit",
      "name": "Submission_Rate",
      "equation": "Base_Submissions * (1 + Publication_Pressure)",
      "from_stock": null,
      "to_stock": "stock-submitted",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "flow-toreview",
      "name": "To_Review",
      "equation": "Submitted_Papers / Desk_Reject_Time * (1 - Desk_Reject_Rate)",
      "from_stock": "stock-submitted",
      "to_stock": "stock-reviewing",
      "position": {
        "x": 175,
        "y": 150
      }
    },
    {
      "id": "flow-deskreject",
      "name": "Desk_Reject",
      "equation": "Submitted_Papers / Desk_Reject_Time * Desk_Reject_Rate",
      "from_stock": "stock-submitted",
      "to_stock": "stock-rejected",
      "position": {
        "x": 175,
        "y": 225
      }
    },
    {
      "id": "flow-accept",
      "name": "Accept",
      "equation": "Under_Review / Review_Time * Acceptance_Rate",
      "from_stock": "stock-reviewing",
      "to_stock": "stock-published",
      "position": {
        "x": 325,
        "y": 100
      }
    },
    {
      "id": "flow-reject",
      "name": "Reject_After_Review",
      "equation": "Under_Review / Review_Time * (1 - Acceptance_Rate)",
      "from_stock": "stock-reviewing",
      "to_stock": "stock-rejected",
      "position": {
        "x": 325,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-basesub",
      "name": "Base_Submissions",
      "equation": "100",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-pubpress",
      "name": "Publication_Pressure",
      "equation": "0.05 * TIME / 100",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "var-desktime",
      "name": "Desk_Reject_Time",
      "equation": "5",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "var-deskreject",
      "name": "Desk_Reject_Rate",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "var-reviewtime",
      "name": "Review_Time",
      "equation": "60",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-accept",
      "name": "Acceptance_Rate",
      "equation": "0.25",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-quality",
      "name": "Average_Quality",
      "equation": "50 + 30 * Acceptance_Rate - 20 * Publication_Pressure",
      "position": {
        "x": 450,
        "y": 175
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Under_Review",
      "to_element": "Accept"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 1
  },
  "created_at": "2026-01-12T02:13:18.795897+00:00",
  "updated_at": "2026-01-12T02:13:18.795900+00:00",
  "source": "https://doi.org/10.1177/014107680609900414",
  "reference": "Smith, R. (2006). Peer review: a flawed process at the heart of science and journals. JRSM."
}