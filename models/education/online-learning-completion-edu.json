{
  "id": "online-learning-completion-edu",
  "name": "Online Learning Completion Model",
  "description": "Model of MOOC completion dynamics. Source: Reich & Ruiperez-Valiente (2019), Science.",
  "stocks": [
    {
      "id": "stock-enrolled",
      "name": "Enrolled",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-active",
      "name": "Active_Learners",
      "initial_value": 5000,
      "equation": "",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "stock-completed",
      "name": "Completed",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-engage",
      "name": "Initial_Engagement",
      "equation": "Enrolled * Engagement_Rate",
      "from_stock": "stock-enrolled",
      "to_stock": "stock-active",
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-dropout",
      "name": "Dropout",
      "equation": "Active_Learners * Dropout_Rate * Week_Difficulty",
      "from_stock": "stock-active",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 250
      }
    },
    {
      "id": "flow-complete",
      "name": "Completion",
      "equation": "Active_Learners * Completion_Rate",
      "from_stock": "stock-active",
      "to_stock": "stock-completed",
      "position": {
        "x": 325,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-engage",
      "name": "Engagement_Rate",
      "equation": "0.5",
      "position": {
        "x": 175,
        "y": 100
      }
    },
    {
      "id": "var-dropout",
      "name": "Dropout_Rate",
      "equation": "0.1",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "var-week",
      "name": "Week_Difficulty",
      "equation": "1 + 0.5 * TIME / 12",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-complete",
      "name": "Completion_Rate",
      "equation": "IF(TIME > 8, 0.3, 0.05)",
      "position": {
        "x": 325,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 12,
    "dt": 0.5
  },
  "created_at": "2026-01-12T12:53:13.193341+00:00",
  "updated_at": "2026-01-12T12:53:13.193341+00:00",
  "source": "https://systemdynamics.org/resources/",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}