      "to_stock": null,
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-b-improvement",
      "name": "B Improvement",
      "equation": "B_Effort * B_Effectiveness * Relationship_Boost",
      "from_stock": null,
      "to_stock": "stock-b-success",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "flow-b-decline",
      "name": "B Decline",
      "equation": "B_Success * Base_Decline + A_Side_Effect_on_B",
      "from_stock": "stock-b-success",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "flow-relationship-repair",
      "name": "Relationship Repair",
      "equation": "Joint_Success_Effect * (100 - Relationship_Quality) / 100",
