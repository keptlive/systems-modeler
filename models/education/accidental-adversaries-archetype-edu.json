{
  "id": "accidental-adversaries-archetype-edu",
  "name": "Accidental Adversaries System Archetype",
  "description": "System archetype showing how well-intentioned actors become adversaries through unintended effects of their actions. From Senge (1990). Common in partnerships, alliances, and organizational relationships. Reference: Senge, P. M. (1990). The Fifth Discipline. Doubleday/Currency. Source: https://mitsloan.mit.edu/",
  "stocks": [
