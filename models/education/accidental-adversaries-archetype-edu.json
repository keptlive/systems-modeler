      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-b-success",
      "name": "B Success",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "stock-relationship-quality",
      "name": "Relationship Quality",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-a-improvement",
      "name": "A Improvement",
      "equation": "A_Effort * A_Effectiveness * Relationship_Boost",
      "from_stock": null,
      "to_stock": "stock-a-success",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-a-decline",
      "name": "A Decline",
      "equation": "A_Success * Base_Decline + B_Side_Effect_on_A",
