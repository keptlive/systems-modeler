      "to_stock": "stock-relationship-quality",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "flow-relationship-damage",
      "name": "Relationship Damage",
      "equation": "Perceived_Harm * Relationship_Quality / 100",
      "from_stock": "stock-relationship-quality",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
