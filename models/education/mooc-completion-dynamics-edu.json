{
  "id": "mooc-completion-dynamics-edu",
  "name": "MOOC Completion and Dropout Dynamics",
  "description": "Model of student engagement and dropout in Massive Open Online Courses. Captures the high enrollment, low completion phenomenon with factors including course design, peer interaction, and motivation decay. Reference: National Center for Education Statistics (NCES). Source: https://nces.ed.gov/",
  "stocks": [
    {
      "id": "s1",
      "name": "Active_Learners",
      "initial_value": 10000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Disengaged_Learners",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Completers",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Dropouts",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Disengagement",
      "equation": "Active_Learners * Disengagement_Rate",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Re_engagement",
      "equation": "Disengaged_Learners * Re_engagement_Rate * Peer_Effect",
      "from_stock": "s2",
      "to_stock": "s1",
      "position": {
        "x": 250,
        "y": 270
      }
    },
    {
      "id": "f3",
      "name": "Completion",
      "equation": "Active_Learners * Completion_Rate * Course_Progress",
      "from_stock": "s1",
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Dropout",
      "equation": "Disengaged_Learners * Dropout_Rate",
      "from_stock": "s2",
      "to_stock": "s4",
      "position": {
        "x": 350,
        "y": 280
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Base_Disengagement_Rate",
      "equation": "0.15",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "v2",
      "name": "Re_engagement_Rate",
      "equation": "0.05",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "v3",
      "name": "Completion_Rate",
      "equation": "0.02",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "v4",
      "name": "Dropout_Rate",
      "equation": "0.2",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "v5",
      "name": "Course_Duration_Weeks",
      "equation": "10",
      "position": {
        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "Course_Progress",
      "equation": "Time / Course_Duration_Weeks",
      "position": {
        "x": 250,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Peer_Effect",
      "equation": "Active_Learners / (Active_Learners + Disengaged_Learners + 1)",
      "position": {
        "x": 400,
        "y": 130
      }
    },
    {
      "id": "v8",
      "name": "Motivation_Decay",
      "equation": "1 - Course_Progress * 0.5",
      "position": {
        "x": 550,
        "y": 130
      }
    },
    {
      "id": "v9",
      "name": "Disengagement_Rate",
      "equation": "Base_Disengagement_Rate / MAX(0.1, Motivation_Decay)",
      "position": {
        "x": 200,
        "y": 180
      }
    },
    {
      "id": "v10",
      "name": "Completion_Percentage",
      "equation": "Completers / 10000 * 100",
      "position": {
        "x": 450,
        "y": 180
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 15,
    "dt": 0.1
  },
  "source": "https://doi.org/10.1126/science.aav7958",
  "reference": "Reich J, Ruip\u00e9rez-Valiente JA (2019) The MOOC pivot. Science. Ho AD et al. (2015) HarvardX and MITx: Two Years of Open Online Courses.",
  "created_at": "2026-01-12T06:55:23.193507+00:00",
  "updated_at": "2026-01-12T06:55:23.193507+00:00"
}