{
  "id": "senge-shifting-burden-edu",
  "name": "Senge Shifting the Burden Archetype",
  "description": "Peter Senge's 'Shifting the Burden' system archetype from The Fifth Discipline. Shows how symptomatic solutions can undermine fundamental solutions, creating dependency. Common pattern in organizational, social, and personal problems. Reference: Senge, P. M. (1990). The Fifth Discipline. Doubleday/Currency. Source: https://mitsloan.mit.edu/",
  "stocks": [
    {
      "id": "stock-problem-symptom",
      "name": "Problem Symptom",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "stock-symptomatic-solution",
      "name": "Symptomatic Solution Capacity",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "stock-fundamental-solution",
      "name": "Fundamental Solution Capacity",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 550,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "flow-symptom-increase",
      "name": "Symptom Increase",
      "equation": "Base_Problem_Growth - Symptomatic_Relief - Fundamental_Relief",
      "from_stock": null,
      "to_stock": "stock-problem-symptom",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "flow-symptomatic-application",
      "name": "Symptomatic Application",
      "equation": "Problem_Symptom * Symptomatic_Response_Rate",
      "from_stock": null,
      "to_stock": "stock-symptomatic-solution",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "flow-symptomatic-decay",
      "name": "Symptomatic Decay",
      "equation": "Symptomatic_Solution_Capacity / Symptomatic_Duration",
      "from_stock": "stock-symptomatic-solution",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "flow-fundamental-investment",
      "name": "Fundamental Investment",
      "equation": "Problem_Symptom * Fundamental_Response_Rate * (1 - Addiction_Effect)",
      "from_stock": null,
      "to_stock": "stock-fundamental-solution",
      "position": {
        "x": 550,
        "y": 350
      }
    },
    {
      "id": "flow-fundamental-erosion",
      "name": "Fundamental Erosion",
      "equation": "Fundamental_Solution_Capacity * Side_Effect_Rate * Symptomatic_Solution_Capacity / 100",
      "from_stock": "stock-fundamental-solution",
      "to_stock": null,
      "position": {
        "x": 550,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-base-problem-growth",
      "name": "Base Problem Growth",
      "equation": "5",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-symptomatic-relief",
      "name": "Symptomatic Relief",
