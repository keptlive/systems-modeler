{
  "id": "skill-acquisition-power-law-edu",
  "name": "Power Law of Practice - Skill Acquisition",
  "description": "Learning follows power law with diminishing returns. Source: Newell & Rosenbloom (1981) and Anderson (1982). DOI: 10.1037/0033-295X.89.4.369",
  "stocks": [
    {
      "id": "stock-skill",
      "name": "Skill_Level",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-practice",
      "name": "Total_Practice",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-learn",
      "name": "Learning_Rate",
      "equation": "(Max_Skill - Skill_Level) * Learning_Constant / (Total_Practice ^ Learning_Exponent)",
      "from_stock": null,
      "to_stock": "stock-skill",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-practice",
      "name": "Practice_Rate",
      "equation": "Practice_Hours",
      "from_stock": null,
      "to_stock": "stock-practice",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-decay",
      "name": "Skill_Decay",
      "equation": "Skill_Level * Decay_Rate * (1 - Practice_Hours / Max_Practice)",
      "from_stock": "stock-skill",
      "to_stock": null,
      "position": {
        "x": 200,
        "y": 250
      }
    }
  ],
  "variables": [
    {
      "id": "var-maxskill",
      "name": "Max_Skill",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-lconst",
      "name": "Learning_Constant",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-lexp",
      "name": "Learning_Exponent",
      "equation": "0.3",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-practice",
      "name": "Practice_Hours",
      "equation": "1",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-decay",
      "name": "Decay_Rate",
      "equation": "0.01",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "var-maxprac",
      "name": "Max_Practice",
      "equation": "5",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "var-proficiency",
      "name": "Proficiency",
      "equation": "Skill_Level / Max_Skill",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Total_Practice",
      "to_element": "Learning_Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 1000,
    "dt": 1
  },
  "created_at": "2026-01-12T02:13:18.795796+00:00",
  "updated_at": "2026-01-12T02:13:18.795800+00:00",
  "source": "https://doi.org/10.1037/0033-295X.89.4.369",
  "reference": "Anderson, J.R. (1982). Acquisition of Cognitive Skill. Psychological Review."
}