{
  "id": "student-retention-higher-ed-edu",
  "name": "Student Retention Model",
  "description": "Higher education student retention model showing factors affecting persistence to graduation. Models academic and social integration. Source: Based on Tinto's model of student departure (1975).",
  "stocks": [
    {
      "id": "stock-year1",
      "name": "First_Year_Students",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-year2",
      "name": "Continuing_Students",
      "initial_value": 800,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-graduates",
      "name": "Graduates",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-dropouts",
      "name": "Dropouts",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-enrollment",
      "name": "New_Enrollment",
      "equation": "Annual_Enrollment",
      "from_stock": null,
      "to_stock": "stock-year1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-retention",
      "name": "Retention",
      "equation": "First_Year_Students * Retention_Rate",
      "from_stock": "stock-year1",
      "to_stock": "stock-year2",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-graduation",
      "name": "Graduation",
      "equation": "Continuing_Students * Graduation_Rate",
      "from_stock": "stock-year2",
      "to_stock": "stock-graduates",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "flow-dropout-y1",
      "name": "First_Year_Dropout",
      "equation": "First_Year_Students * (1 - Retention_Rate)",
      "from_stock": "stock-year1",
      "to_stock": "stock-dropouts",
      "position": {
        "x": 150,
        "y": 275
      }
    },
    {
      "id": "flow-dropout-y2",
      "name": "Later_Dropout",
      "equation": "Continuing_Students * (1 - Graduation_Rate) * Later_Dropout_Rate",
      "from_stock": "stock-year2",
      "to_stock": "stock-dropouts",
      "position": {
        "x": 350,
        "y": 275
      }
    }
  ],
  "variables": [
    {
      "id": "var-annual-enrollment",
      "name": "Annual_Enrollment",
      "equation": "1000",
      "position": {
        "x": 50,
        "y": 80
      }
    },
    {
      "id": "var-academic-integration",
      "name": "Academic_Integration",
      "equation": "0.7",
      "position": {
        "x": 150,
        "y": 80
      }
    },
    {
      "id": "var-social-integration",
      "name": "Social_Integration",
      "equation": "0.6",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-retention-rate",
      "name": "Retention_Rate",
      "equation": "Base_Retention * Academic_Integration * Social_Integration",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-base-retention",
      "name": "Base_Retention",
      "equation": "1.2",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-graduation-rate",
      "name": "Graduation_Rate",
      "equation": "0.25",
      "position": {
        "x": 450,
        "y": 80
      }
    },
    {
      "id": "var-later-dropout",
      "name": "Later_Dropout_Rate",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 350
      }
    },
    {
      "id": "var-total-enrolled",
      "name": "Total_Enrolled",
      "equation": "First_Year_Students + Continuing_Students",
      "position": {
        "x": 200,
        "y": 120
      }
    },
    {
      "id": "var-graduation-yield",
      "name": "Graduation_Yield",
      "equation": "Graduates / (Graduates + Dropouts + 1)",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "First_Year_Students",
      "to_element": "Retention"
    },
    {
      "id": "conn-2",
      "from_element": "Retention_Rate",
      "to_element": "Retention"
    },
    {
      "id": "conn-3",
      "from_element": "Continuing_Students",
      "to_element": "Graduation"
    },
    {
      "id": "conn-4",
      "from_element": "Academic_Integration",
      "to_element": "Retention_Rate"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 20,
    "dt": 1
  },
  "created_at": "2026-01-11T20:57:03.374090+00:00",
  "updated_at": "2026-01-11T20:57:03.374090+00:00",
  "source": "https://github.com/SDXorg/PySD-Cookbook",
  "reference": "System Dynamics Educational Models - PySD Cookbook"
}