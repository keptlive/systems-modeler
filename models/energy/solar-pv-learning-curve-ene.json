{
  "id": "solar-pv-learning-curve-ene",
  "name": "Solar PV Learning Curve Model",
  "description": "Model of solar photovoltaic cost reduction through learning-by-doing and scale economies. Historical learning rate of ~20% (costs drop 20% per doubling of cumulative capacity). Based on IRENA and IEA renewable energy data.",
  "stocks": [
    {"id": "stock-cumulative-capacity", "name": "Cumulative Capacity", "initial_value": 1000, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-annual-installations", "name": "Annual Installations", "initial_value": 200, "equation": "", "position": {"x": 450, "y": 200}},
    {"id": "stock-manufacturing-capacity", "name": "Manufacturing Capacity", "initial_value": 300, "equation": "", "position": {"x": 200, "y": 350}}
  ],
  "flows": [
    {"id": "flow-capacity-additions", "name": "Capacity Additions", "equation": "Annual_Installations", "from_stock": null, "to_stock": "stock-cumulative-capacity", "position": {"x": 100, "y": 200}},
    {"id": "flow-installation-growth", "name": "Installation Growth", "equation": "Annual_Installations * Growth_Rate_Installations", "from_stock": null, "to_stock": "stock-annual-installations", "position": {"x": 350, "y": 200}},
    {"id": "flow-manufacturing-expansion", "name": "Manufacturing Expansion", "equation": "(Desired_Manufacturing - Manufacturing_Capacity) / Expansion_Time", "from_stock": null, "to_stock": "stock-manufacturing-capacity", "position": {"x": 100, "y": 350}}
  ],
  "variables": [
    {"id": "var-learning-rate", "name": "Learning Rate", "equation": "0.2", "position": {"x": 350, "y": 100}},
    {"id": "var-initial-cost", "name": "Initial Cost", "equation": "300", "position": {"x": 500, "y": 100}},
    {"id": "var-reference-capacity", "name": "Reference Capacity", "equation": "1000", "position": {"x": 650, "y": 100}},
    {"id": "var-learning-exponent", "name": "Learning Exponent", "equation": "LN(1 - Learning_Rate) / LN(2)", "position": {"x": 200, "y": 100}},
    {"id": "var-module-cost", "name": "Module Cost", "equation": "Initial_Cost * (Cumulative_Capacity / Reference_Capacity) ^ Learning_Exponent", "position": {"x": 350, "y": 280}},
    {"id": "var-lcoe", "name": "LCOE", "equation": "Module_Cost * 0.1 + BOS_Cost + OM_Cost", "position": {"x": 550, "y": 280}},
    {"id": "var-bos-cost", "name": "BOS Cost", "equation": "20", "position": {"x": 450, "y": 350}},
    {"id": "var-om-cost", "name": "OM Cost", "equation": "5", "position": {"x": 600, "y": 350}},
    {"id": "var-growth-rate-installations", "name": "Growth Rate Installations", "equation": "MAX(0, 0.3 * (Grid_Parity_Gap / 10))", "position": {"x": 550, "y": 200}},
    {"id": "var-grid-parity-gap", "name": "Grid Parity Gap", "equation": "MAX(0, Grid_Price - LCOE)", "position": {"x": 400, "y": 420}},
    {"id": "var-grid-price", "name": "Grid Price", "equation": "50", "position": {"x": 550, "y": 420}},
    {"id": "var-desired-manufacturing", "name": "Desired Manufacturing", "equation": "Annual_Installations * 1.5", "position": {"x": 200, "y": 420}},
    {"id": "var-expansion-time", "name": "Expansion Time", "equation": "2", "position": {"x": 350, "y": 490}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 30, "dt": 0.25},
  "source": "https://doi.org/10.1016/j.joule.2020.09.001",
  "reference": "Way R et al. Empirically grounded technology forecasts and the energy transition. Joule. 2022;6(9):2057-2082."
}
