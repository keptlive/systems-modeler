{
  "id": "water-energy-nexus-ene",
  "name": "Water-Energy Nexus Model",
  "description": "Model of water-energy interdependencies. Source: UN-Water (2014). Reference: IEA World Energy Outlook. Source: https://www.iea.org/",
  "stocks": [
    {
      "id": "stock-water",
      "name": "Water",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-energy",
      "name": "Energy",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-water-in",
      "name": "Water_Supply",
      "equation": "Supply_Rate",
      "from_stock": null,
      "to_stock": "stock-water",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "flow-water-use",
      "name": "Water_Use",
      "equation": "MIN(Water, Demand + Energy * Water_Intensity)",
      "from_stock": "stock-water",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "flow-energy-gen",
      "name": "Generation",
      "equation": "Capacity * MIN(1, Water / Water_Need)",
      "from_stock": null,
      "to_stock": "stock-energy",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "flow-energy-use",
      "name": "Energy_Use",
      "equation": "Energy_Demand",
      "from_stock": "stock-energy",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "variables": [
    {
      "id": "var-supply",
      "name": "Supply_Rate",
      "equation": "100",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "var-demand",
      "name": "Demand",
      "equation": "80",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-wint",
      "name": "Water_Intensity",
      "equation": "0.5",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "var-cap",
      "name": "Capacity",
      "equation": "600",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "var-wneed",
      "name": "Water_Need",
      "equation": "200",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-edemand",
      "name": "Energy_Demand",
      "equation": "450",
      "position": {
        "x": 350,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.25
  },
  "created_at": "2026-01-12T12:50:58.059917+00:00",
  "updated_at": "2026-01-12T12:50:58.059917+00:00",
  "source": "https://doi.org/10.1038/s41560-021-00885-y",
  "reference": "System Dynamics Society. System Dynamics Review. Wiley; Various years."
}