        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Renewable_Energy",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Total_Emissions",
      "initial_value": 35,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Carbon_Captured",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 750,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Fossil_Decline",
      "equation": "Fossil_Energy * Phaseout_Rate",
      "from_stock": "Fossil_Energy",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Renewable_Growth",
      "equation": "Renewable_Energy * Renewable_Growth_Rate + Investment_Boost",
      "from_stock": null,
      "to_stock": "Renewable_Energy",
      "position": {
        "x": 250,
        "y": 300
      }
    },
    {
      "id": "f3",
      "name": "Emission_Reduction",
      "equation": "Fossil_Decline * Emission_Factor - Carbon_Capture_Rate",
      "from_stock": "Total_Emissions",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "f4",
      "name": "Carbon_Capture",
      "equation": "Carbon_Capture_Rate",
      "from_stock": null,
      "to_stock": "Carbon_Captured",
      "position": {
        "x": 550,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Phaseout_Rate",
      "equation": "0.04",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Renewable_Growth_Rate",
      "equation": "0.08",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Investment_Boost",
      "equation": "5",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Emission_Factor",
      "equation": "0.07",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Carbon_Capture_Rate",
      "equation": "0.5 + time * 0.1",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Total_Energy",
      "equation": "Fossil_Energy + Renewable_Energy",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Renewable_Share",
      "equation": "Renewable_Energy / Total_Energy",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Net_Emissions",
      "equation": "Total_Emissions - Carbon_Captured",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v9",
      "name": "Years_To_Net_Zero",
      "equation": "IF Net_Emissions > 0 THEN Net_Emissions / MAX(0.1, Emission_Reduction) ELSE 0",
      "position": {
        "x": 100,
        "y": 150
      }
    }
  ],
