{
  "id": "coal-phase-out-transition-ene",
  "name": "Coal Phase-Out and Just Transition",
  "description": "Models the decline of coal power and worker transition to clean energy jobs. Based on IEA (2021) Net Zero by 2050 and just transition literature. Reference: IEA World Energy Outlook. Source: https://www.iea.org/",
  "category": "energy",
  "stocks": [
    {
      "id": "stock-coal",
      "name": "Coal_Capacity_GW",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-workers",
      "name": "Coal_Workers_Thousands",
      "initial_value": 2000,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-retrained",
      "name": "Retrained_Workers",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "stock-unemployed",
      "name": "Unemployed_Workers",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-retire",
      "name": "Plant_Retirements",
      "equation": "Coal_Capacity_GW * Retirement_Rate",
      "from_stock": "stock-coal",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "flow-layoff",
      "name": "Layoffs",
      "equation": "Coal_Workers_Thousands * Retirement_Rate",
      "from_stock": "stock-workers",
      "to_stock": "stock-unemployed",
      "position": {
        "x": 300,
        "y": 270
      }
    },
    {
      "id": "flow-retrain",
      "name": "Retraining",
      "equation": "Unemployed_Workers * Retraining_Rate * Policy_Support",
      "from_stock": "stock-unemployed",
      "to_stock": "stock-retrained",
      "position": {
        "x": 500,
        "y": 270
      }
    },
    {
      "id": "flow-natural",
      "name": "Natural_Attrition",
      "equation": "Coal_Workers_Thousands * Attrition_Rate",
      "from_stock": "stock-workers",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-retire-rate",
      "name": "Retirement_Rate",
      "equation": "0.05",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-retrain-rate",
      "name": "Retraining_Rate",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-policy",
      "name": "Policy_Support",
      "equation": "1.5",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-attrition",
      "name": "Attrition_Rate",
      "equation": "0.03",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-emissions",
      "name": "Annual_Emissions_Mt",
      "equation": "Coal_Capacity_GW * Emission_Factor * Capacity_Factor * 8760 / 1000",
      "position": {
        "x": 200,
        "y": 400
      }
    },
    {
      "id": "var-emission-f",
      "name": "Emission_Factor",
      "equation": "0.9",
      "position": {
        "x": 350,
        "y": 400
      }
    },
    {
      "id": "var-cap-factor",
      "name": "Capacity_Factor",
      "equation": "0.6",
      "position": {
        "x": 500,
        "y": 400
      }
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 1
  },
  "source": "https://www.iea.org/reports/net-zero-by-2050",
  "reference": "IEA (2021) Net Zero by 2050: A Roadmap for the Global Energy Sector. International Energy Agency.",
  "connectors": [],
