      "to_stock": null,
      "position": {
        "x": 525,
        "y": 175
      }
    },
    {
      "id": "f6",
      "name": "Fossil Retirement",
      "equation": "Fossil_Capacity_GW / Fossil_Lifetime * Transition_Speed",
