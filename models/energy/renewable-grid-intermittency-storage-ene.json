      "to_stock": "s4",
      "position": {
        "x": 375,
        "y": 175
      }
    },
    {
      "id": "f5",
      "name": "Discharging",
      "equation": "MIN(Grid_Energy_Stored, Demand_Gap) * Discharge_Efficiency",
