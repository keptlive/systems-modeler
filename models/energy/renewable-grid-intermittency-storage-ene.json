      "id": "v7",
      "name": "Solar Capacity Factor",
      "equation": "0.25 * (1 + 0.2 * SIN(TIME * 3.14159 / 6))",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v8",
      "name": "Wind Capacity Factor",
      "equation": "0.35 * (1 + 0.3 * COS(TIME * 3.14159 / 8))",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "v9",
      "name": "Renewable Generation",
      "equation": "Solar_Capacity_GW * Solar_Capacity_Factor + Wind_Capacity_GW * Wind_Capacity_Factor",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "v10",
      "name": "Demand",
      "equation": "3000 * (1 + 0.1 * SIN(TIME * 3.14159 / 12))",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "v11",
      "name": "Renewable Surplus",
      "equation": "MAX(0, Renewable_Generation - Demand)",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "v12",
      "name": "Demand Gap",
      "equation": "MAX(0, Demand - Renewable_Generation)",
      "position": {
