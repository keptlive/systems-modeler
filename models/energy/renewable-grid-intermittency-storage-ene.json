      "position": {
        "x": 250,
        "y": 175
      }
    },
    {
      "id": "f4",
      "name": "Charging",
      "equation": "MIN(Renewable_Surplus, (Storage_Capacity_GWh - Grid_Energy_Stored) * Charging_Efficiency)",
