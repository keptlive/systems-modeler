{
  "id": "ev-charging-infrastructure-ene",
  "name": "Electric Vehicle Charging Infrastructure Co-evolution",
  "description": "Model of EV adoption and charging infrastructure showing chicken-and-egg dynamics. Source: IEA Global EV Outlook (2023).",
  "stocks": [
    {
      "id": "stock-ev",
      "name": "EV_Fleet",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "stock-charger",
      "name": "Charging_Stations",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 200,
        "y": 300
      }
    },
    {
      "id": "stock-ice",
      "name": "ICE_Fleet",
      "initial_value": 990,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    }
  ],
  "flows": [
    {
      "id": "flow-evbuy",
      "name": "EV_Purchases",
      "equation": "ICE_Fleet * Replacement_Rate * EV_Attractiveness",
      "from_stock": "stock-ice",
      "to_stock": "stock-ev",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "flow-evscrap",
      "name": "EV_Scrappage",
      "equation": "EV_Fleet / Vehicle_Life",
      "from_stock": "stock-ev",
      "to_stock": null,
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "flow-icebuy",
      "name": "ICE_Purchases",
      "equation": "Total_Fleet * Fleet_Growth * (1 - EV_Attractiveness)",
      "from_stock": null,
      "to_stock": "stock-ice",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "flow-icescrap",
      "name": "ICE_Scrappage",
      "equation": "ICE_Fleet / Vehicle_Life",
      "from_stock": "stock-ice",
      "to_stock": null,
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "flow-chargbuild",
      "name": "Charger_Installation",
      "equation": "Investment_Rate * EV_Fleet / Target_EV_Per_Charger",
      "from_stock": null,
      "to_stock": "stock-charger",
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "flow-chargretire",
      "name": "Charger_Retirement",
      "equation": "Charging_Stations / Charger_Life",
      "from_stock": "stock-charger",
      "to_stock": null,
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "var-replace",
      "name": "Replacement_Rate",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-attract",
      "name": "EV_Attractiveness",
      "equation": "Base_Attractiveness * Charger_Effect * Cost_Effect",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-baseatract",
      "name": "Base_Attractiveness",
      "equation": "0.1 + 0.005 * TIME",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-chargeff",
      "name": "Charger_Effect",
      "equation": "MIN(2, 1 + Charging_Stations / (EV_Fleet + 1))",
      "position": {
        "x": 150,
        "y": 250
      }
    },
    {
      "id": "var-costeff",
      "name": "Cost_Effect",
      "equation": "1 + 0.02 * TIME",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "var-vehlife",
      "name": "Vehicle_Life",
      "equation": "15",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-total",
      "name": "Total_Fleet",
      "equation": "EV_Fleet + ICE_Fleet",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "var-growth",
      "name": "Fleet_Growth",
      "equation": "0.02",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "var-invest",
      "name": "Investment_Rate",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-target",
      "name": "Target_EV_Per_Charger",
      "equation": "10",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-charglife",
      "name": "Charger_Life",
      "equation": "10",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.25
  },
  "created_at": "2026-01-12T12:45:39.561756+00:00",
  "updated_at": "2026-01-12T12:45:39.561756+00:00",
  "source": "https://doi.org/10.1038/s41560-021-00885-y",
  "reference": "IEA. Global EV Outlook 2023. International Energy Agency; 2023."
}