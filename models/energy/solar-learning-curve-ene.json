{
  "id": "solar-learning-curve-ene",
  "name": "Solar PV Learning Curve and Cost Reduction",
  "description": "Model of solar photovoltaic cost reduction through learning-by-doing. Captures the experience curve where costs decline as cumulative deployment increases. Based on energy economics and technology diffusion research. Reference: IEA World Energy Outlook. Source: https://www.iea.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Cumulative_Capacity_GW",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Module_Cost_Per_W",
      "initial_value": 0.3,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Market_Share",
      "initial_value": 0.03,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Grid_Parity_Reached",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 250,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Annual_Deployment",
      "equation": "Deployment_Rate * Economic_Attractiveness * Policy_Support",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Cost_Reduction",
      "equation": "(Expected_Cost - Module_Cost_Per_W) / Cost_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 350,
        "y": 280
      }
    },
    {
      "id": "f3",
      "name": "Market_Growth",
      "equation": "(Target_Share - Market_Share) / Market_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 280
      }
    },
    {
      "id": "f4",
      "name": "Parity_Achievement",
      "equation": "IF Module_Cost_Per_W < Grid_Parity_Threshold AND Grid_Parity_Reached = 0 THEN 1 ELSE 0",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 250,
        "y": 430
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Learning_Rate",
      "equation": "0.2",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "v2",
      "name": "Base_Cost",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 80
      }
    },
    {
      "id": "v3",
      "name": "Base_Capacity",
      "equation": "100",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "v4",
      "name": "Deployment_Rate",
      "equation": "50",
      "position": {
        "x": 550,
        "y": 80
      }
    },
    {
      "id": "v5",
      "name": "Learning_Exponent",
      "equation": "-LN(1 - Learning_Rate) / LN(2)",
      "position": {
        "x": 100,
        "y": 130
      }
    },
    {
      "id": "v6",
      "name": "Expected_Cost",
      "equation": "Base_Cost * (Cumulative_Capacity_GW / Base_Capacity)^(-Learning_Exponent)",
      "position": {
        "x": 300,
        "y": 130
      }
    },
    {
      "id": "v7",
      "name": "Grid_Parity_Threshold",
      "equation": "0.05",
      "position": {
        "x": 500,
        "y": 130
      }
    },
    {
      "id": "v8",
      "name": "Economic_Attractiveness",
      "equation": "IF Module_Cost_Per_W < Grid_Parity_Threshold THEN 2 ELSE Module_Cost_Per_W / Grid_Parity_Threshold",
      "position": {
        "x": 150,
        "y": 180
      }
    },
    {
      "id": "v9",
      "name": "Policy_Support",
      "equation": "1.5",
      "position": {
        "x": 400,
        "y": 180
      }
    },
    {
      "id": "v10",
      "name": "Target_Share",
      "equation": "MIN(0.5, Market_Share * Economic_Attractiveness)",
      "position": {
        "x": 550,
        "y": 180
      }
    },
    {
      "id": "v11",
      "name": "Cost_Adjustment_Time",
      "equation": "2",
      "position": {
        "x": 150,
        "y": 230
      }
    },
    {
      "id": "v12",
      "name": "Market_Adjustment_Time",
      "equation": "5",
      "position": {
        "x": 350,
        "y": 230
      }
    },
    {
      "id": "v13",
      "name": "LCOE",
      "equation": "Module_Cost_Per_W * 1000 / (25 * 1500 * 0.85)",
      "position": {
        "x": 550,
        "y": 230
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 2020,
    "end": 2050,
    "dt": 0.5
  },
  "source": "https://doi.org/10.1038/s41560-020-0695-4",
  "reference": "Rubin ES et al. (2015) A review of learning rates for electricity supply technologies. Energy Policy. IRENA (2020) Renewable Power Generation Costs.",
