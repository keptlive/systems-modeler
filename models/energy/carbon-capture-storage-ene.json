{
  "id": "carbon-capture-storage-ene",
  "name": "Carbon Capture and Storage Deployment Model",
  "description": "Model of CCS technology deployment, capacity building, and cost reduction through learning. Reference: IPCC (2021). Climate Change 2021: The Physical Science Basis. Source: https://www.ipcc.ch/report/ar6/wg1/",
  "stocks": [
    {
      "id": "s1",
      "name": "CCS_Capacity",
      "initial_value": 40,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Captured_CO2",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Technology_Experience",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Capacity_Addition",
      "equation": "Investment / Unit_Cost",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "CO2_Capture",
      "equation": "CCS_Capacity * Capacity_Factor",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Experience_Gain",
      "equation": "CO2_Capture / 100",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Investment",
      "equation": "5000",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Unit_Cost",
      "equation": "Base_Cost * (Technology_Experience / 1) ^ (-Learning_Rate)",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Base_Cost",
      "equation": "100",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "v4",
      "name": "Learning_Rate",
      "equation": "0.15",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "v5",
      "name": "Capacity_Factor",
      "equation": "0.85",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Carbon_Price",
      "equation": "50",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Economic_Viability",
      "equation": "Carbon_Price / Unit_Cost",
      "position": {
        "x": 400,
        "y": 250
      }
    },
    {
      "id": "v8",
      "name": "Cumulative_Reduction",
      "equation": "Captured_CO2 * 3.67",
      "position": {
        "x": 500,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 50,
    "dt": 0.5,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:32:16.976740+00:00",
  "updated_at": "2026-01-12T11:32:16.976740+00:00",
  "source": "https://doi.org/10.1016/j.ijggc.2017.03.020",
  "reference": "Global CCS Institute. Global Status of CCS 2021. Melbourne: Global CCS Institute; 2021."
}