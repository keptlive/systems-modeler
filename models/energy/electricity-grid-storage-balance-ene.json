{
  "id": "electricity-grid-storage-balance-ene",
  "name": "Electricity Grid Storage Balance Model",
  "description": "Model of electricity grid balancing with variable renewable energy and battery storage. Shows how storage requirements grow with renewable penetration to maintain grid stability. Based on NREL and IEA grid integration studies.",
  "stocks": [
    {"id": "stock-battery-charge", "name": "Battery Charge", "initial_value": 500, "equation": "", "position": {"x": 300, "y": 200}},
    {"id": "stock-renewable-capacity", "name": "Renewable Capacity", "initial_value": 1000, "equation": "", "position": {"x": 100, "y": 350}},
    {"id": "stock-storage-capacity", "name": "Storage Capacity", "initial_value": 1000, "equation": "", "position": {"x": 500, "y": 350}}
  ],
  "flows": [
    {"id": "flow-charging", "name": "Charging", "equation": "MAX(0, MIN(Surplus_Generation, (Storage_Capacity - Battery_Charge) / Charging_Time, Max_Charge_Rate * Storage_Capacity))", "from_stock": null, "to_stock": "stock-battery-charge", "position": {"x": 200, "y": 200}},
    {"id": "flow-discharging", "name": "Discharging", "equation": "MAX(0, MIN(-Surplus_Generation, Battery_Charge / Discharge_Time, Max_Discharge_Rate * Storage_Capacity))", "from_stock": "stock-battery-charge", "to_stock": null, "position": {"x": 400, "y": 200}},
    {"id": "flow-renewable-additions", "name": "Renewable Additions", "equation": "Renewable_Addition_Rate", "from_stock": null, "to_stock": "stock-renewable-capacity", "position": {"x": 100, "y": 280}},
    {"id": "flow-storage-additions", "name": "Storage Additions", "equation": "(Required_Storage - Storage_Capacity) / Storage_Build_Time", "from_stock": null, "to_stock": "stock-storage-capacity", "position": {"x": 500, "y": 280}}
  ],
  "variables": [
    {"id": "var-demand", "name": "Demand", "equation": "1000 * (1 + 0.2 * SIN(2 * 3.14159 * Time / 24))", "position": {"x": 200, "y": 100}},
    {"id": "var-renewable-generation", "name": "Renewable Generation", "equation": "Renewable_Capacity * Capacity_Factor * (1 + 0.5 * SIN(2 * 3.14159 * Time / 24 + 1.5))", "position": {"x": 450, "y": 100}},
    {"id": "var-capacity-factor", "name": "Capacity Factor", "equation": "0.3", "position": {"x": 650, "y": 100}},
    {"id": "var-baseload-generation", "name": "Baseload Generation", "equation": "MAX(0, Demand - Renewable_Generation - Discharging + Charging)", "position": {"x": 200, "y": 280}},
    {"id": "var-surplus-generation", "name": "Surplus Generation", "equation": "Renewable_Generation - Demand", "position": {"x": 350, "y": 280}},
    {"id": "var-renewable-penetration", "name": "Renewable Penetration", "equation": "Renewable_Generation / Demand", "position": {"x": 550, "y": 200}},
    {"id": "var-charging-time", "name": "Charging Time", "equation": "4", "position": {"x": 200, "y": 420}},
    {"id": "var-discharge-time", "name": "Discharge Time", "equation": "4", "position": {"x": 350, "y": 420}},
    {"id": "var-max-charge-rate", "name": "Max Charge Rate", "equation": "0.25", "position": {"x": 500, "y": 420}},
    {"id": "var-max-discharge-rate", "name": "Max Discharge Rate", "equation": "0.25", "position": {"x": 650, "y": 420}},
    {"id": "var-required-storage", "name": "Required Storage", "equation": "Renewable_Capacity * Storage_Hours_Per_MW", "position": {"x": 300, "y": 500}},
    {"id": "var-storage-hours-per-mw", "name": "Storage Hours Per MW", "equation": "2 + 4 * Renewable_Penetration", "position": {"x": 500, "y": 500}},
    {"id": "var-renewable-addition-rate", "name": "Renewable Addition Rate", "equation": "50", "position": {"x": 100, "y": 420}},
    {"id": "var-storage-build-time", "name": "Storage Build Time", "equation": "2", "position": {"x": 650, "y": 500}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 168, "dt": 1},
  "source": "https://doi.org/10.1016/j.joule.2019.06.006",
  "reference": "Sepulveda NA et al. The design space for long-duration energy storage in decarbonized power systems. Nature Energy. 2021;6:506-516."
}
