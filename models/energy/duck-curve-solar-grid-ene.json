{
  "id": "duck-curve-solar-grid-ene",
  "name": "Duck Curve Solar Grid Model",
  "description": "California ISO's duck curve phenomenon showing net load dynamics with high solar penetration. Models midday solar surplus and evening ramp challenge. Key for grid planning with variable renewables. Reference: IRENA Renewable Energy Statistics. Source: https://www.irena.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Solar_Generation",
      "initial_value": 0,
      "position": {
        "x": 200,
        "y": 150
      },
      "equation": ""
    },
    {
      "id": "s2",
      "name": "Dispatchable_Generation",
      "initial_value": 25000,
      "position": {
        "x": 400,
        "y": 150
      },
      "equation": ""
    },
    {
      "id": "s3",
      "name": "Storage_Charge",
      "initial_value": 5000,
      "position": {
        "x": 300,
        "y": 300
      },
      "equation": ""
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "solar_ramp",
      "to_stock": "s1",
      "equation": "solar_curve * solar_capacity",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "f2",
      "name": "dispatchable_adjustment",
      "to_stock": "s2",
      "equation": "(net_load - Dispatchable_Generation) / ramp_time",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "f3",
      "name": "charging",
      "to_stock": "s3",
      "equation": "IF(solar_surplus > 0, MIN(solar_surplus, charge_rate), -discharge_rate)",
      "position": {
        "x": 0,
        "y": 0
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "solar_capacity",
      "equation": "15000",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v2",
      "name": "solar_curve",
      "equation": "MAX(0, SIN((TIME MOD 24 - 6) * 3.14159 / 12))",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v3",
      "name": "total_demand",
      "equation": "25000 + 5000 * SIN((TIME MOD 24 - 14) * 3.14159 / 12)",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v4",
      "name": "net_load",
      "equation": "total_demand - Solar_Generation",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v5",
      "name": "solar_surplus",
      "equation": "Solar_Generation - total_demand",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v6",
      "name": "ramp_time",
      "equation": "0.5",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v7",
      "name": "charge_rate",
      "equation": "2000",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v8",
      "name": "discharge_rate",
      "equation": "1500",
      "position": {
        "x": 0,
        "y": 0
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "solar_curve",
      "to_element": "solar_ramp"
    },
    {
      "id": "c2",
      "from_element": "net_load",
      "to_element": "dispatchable_adjustment"
    },
    {
      "id": "c3",
      "from_element": "solar_surplus",
      "to_element": "charging"
    }
  ],
  "time_settings": {
    "start": 0,
    "dt": 0.25,
    "end": 72
  },
  "created_at": "2026-01-12T02:25:30.586684+00:00",
  "updated_at": "2026-01-12T02:25:30.586689+00:00",
  "source": "https://www.caiso.com/documents/flexibleresourceshelprenewables_fastfacts.pdf",
  "reference": "California ISO (2016). What the duck curve tells us about managing a green grid."
}