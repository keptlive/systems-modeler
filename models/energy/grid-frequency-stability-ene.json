{
  "id": "grid-frequency-stability-ene",
  "name": "Grid Frequency Stability Dynamics",
  "description": "Illustrative grid-frequency experiment with physically consistent rotating-energy balance. Power is MW, time seconds, frequency Hz and kinetic energy MW s. Initial stored energy is System Inertia (5 s) times Base Generation (1000 MW). Net Inertial Response is demand minus generation, permitting kinetic discharge and recharge. Frequency Change follows df/dt=(Pgen-Pload)*f/(2E), preserving E/(f/f0)^2=5000 MW s. Explicit RK4 at DT 0.04 s handles the illustrative reserve deadband without claiming adaptive event localization; full 60 s default, half and quarter grids fit the engine work budget. The frequency-energy invariant agrees with the independent reduced swing equation near floating-point precision; reserve relative error is below 1e-7 against an event-split reference. All original forcing, droop and reserve paths remain. Governor/droop/reserve dynamics are illustrative local assumptions; this is not a reproduction of the NREL virtual-synchronous-generator network.",
  "source": "https://docs.nlr.gov/docs/fy20osti/73872.pdf",
  "reference": "Yan et al. (2020), NREL/CP-5D00-73872, printed p.4 (PDF p.7), eq.(12): per-unit power imbalance equals 2 H omega times d omega/dt. SI mapping E=H*Sbase*(f/f0)^2 gives dE/dt=Pgen-Pload and df/dt=(Pgen-Pload)*f/(2E).",
  "stocks": [
    {
      "id": "stock-frequency",
      "name": "Grid Frequency",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      },
      "units": "Hz"
    },
    {
      "id": "stock-kinetic-energy",
      "name": "Stored Kinetic Energy",
      "initial_value": 100,
      "equation": "System_Inertia * Base_Generation",
      "position": {
        "x": 500,
        "y": 200
      },
      "units": "MW s"
    },
    {
      "id": "stock-reserve",
      "name": "Spinning Reserve",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 400
      },
      "units": "MW"
    }
  ],
  "flows": [
    {
      "id": "flow-frequency-change",
      "name": "Frequency Change",
      "equation": "(Total_Generation - Total_Demand) * Grid_Frequency / (2 * Stored_Kinetic_Energy)",
      "from_stock": null,
      "to_stock": "stock-frequency",
      "position": {
        "x": 200,
        "y": 200
      },
      "units": "Hz / s"
    },
    {
      "id": "flow-energy-injection",
      "name": "Inertial Response",
      "equation": "Total_Demand - Total_Generation",
      "from_stock": "stock-kinetic-energy",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 350
      },
      "units": "MW"
    },
    {
      "id": "flow-reserve-deployment",
      "name": "Reserve Deployment",
      "equation": "IF(ABS(Frequency_Deviation) > Deadband, Spinning_Reserve * Droop_Response * Frequency_Deviation / Nominal_Frequency, 0)",
      "from_stock": "stock-reserve",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 500
      }
    },
    {
      "id": "flow-reserve-restoration",
      "name": "Reserve Restoration",
      "equation": "(Max_Reserve - Spinning_Reserve) / Reserve_Restoration_Time",
      "from_stock": null,
      "to_stock": "stock-reserve",
      "position": {
        "x": 200,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-generation",
      "name": "Total Generation",
      "equation": "Base_Generation + Primary_Response + Secondary_Response",
      "position": {
        "x": 100,
        "y": 100
      },
      "units": "MW"
    },
    {
      "id": "var-demand",
