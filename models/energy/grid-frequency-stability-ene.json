{
  "id": "grid-frequency-stability-ene",
  "name": "Grid Frequency Stability Dynamics",
  "description": "A model of electrical grid frequency stability, capturing the balance between generation and demand, inertia from rotating machines, and frequency response mechanisms. Critical for renewable integration. Reference: IRENA Renewable Energy Statistics. Source: https://www.irena.org/",
  "source": "https://doi.org/10.1109/TPWRS.2018.2821757",
  "reference": "Milano F, et al. Foundations and Challenges of Low-Inertia Systems. Power Systems Computation Conference. 2018. See also Kundur P. Power System Stability and Control. 1994.",
  "stocks": [
    {
      "id": "stock-frequency",
      "name": "Grid Frequency",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-kinetic-energy",
      "name": "Stored Kinetic Energy",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-reserve",
      "name": "Spinning Reserve",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
  "flows": [
    {
      "id": "flow-frequency-change",
      "name": "Frequency Change",
      "equation": "(Total_Generation - Total_Demand) / (2 * System_Inertia * Stored_Kinetic_Energy)",
      "from_stock": null,
      "to_stock": "stock-frequency",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "flow-energy-injection",
      "name": "Inertial Response",
      "equation": "IF(Grid_Frequency < Nominal_Frequency, Inertia_Constant * Frequency_Deviation, 0)",
      "from_stock": "stock-kinetic-energy",
      "to_stock": null,
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "flow-reserve-deployment",
      "name": "Reserve Deployment",
      "equation": "IF(ABS(Frequency_Deviation) > Deadband, Spinning_Reserve * Droop_Response * Frequency_Deviation / Nominal_Frequency, 0)",
      "from_stock": "stock-reserve",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 500
      }
    },
    {
      "id": "flow-reserve-restoration",
      "name": "Reserve Restoration",
      "equation": "(Max_Reserve - Spinning_Reserve) / Reserve_Restoration_Time",
      "from_stock": null,
      "to_stock": "stock-reserve",
      "position": {
        "x": 200,
        "y": 400
      }
    }
  ],
  "variables": [
    {
      "id": "var-generation",
      "name": "Total Generation",
      "equation": "Base_Generation + Primary_Response + Secondary_Response",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "var-demand",
      "name": "Total Demand",
      "equation": "Base_Demand + Demand_Fluctuation",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "var-base-gen",
      "name": "Base Generation",
      "equation": "1000",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "var-base-demand",
      "name": "Base Demand",
      "equation": "1000",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "var-demand-fluct",
      "name": "Demand Fluctuation",
      "equation": "50 * SIN(Time * 0.1)",
      "position": {
        "x": 300,
        "y": 50
      }
    },
    {
      "id": "var-inertia",
      "name": "System Inertia",
      "equation": "5",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "var-nominal",
      "name": "Nominal Frequency",
      "equation": "60",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "var-deviation",
      "name": "Frequency Deviation",
      "equation": "Nominal_Frequency - Grid_Frequency",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "var-inertia-const",
      "name": "Inertia Constant",
      "equation": "10",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "var-deadband",
      "name": "Deadband",
      "equation": "0.02",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-droop",
      "name": "Droop Response",
      "equation": "0.05",
      "position": {
        "x": 350,
        "y": 350
      }
    },
    {
      "id": "var-max-reserve",
      "name": "Max Reserve",
      "equation": "1000",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "var-restoration-time",
      "name": "Reserve Restoration Time",
      "equation": "30",
      "position": {
        "x": 150,
        "y": 450
      }
    },
    {
      "id": "var-primary-response",
      "name": "Primary Response",
      "equation": "Droop_Response * Frequency_Deviation * 100",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "var-secondary-response",
      "name": "Secondary Response",
      "equation": "0",
      "position": {
        "x": 200,
        "y": 150
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 60,
    "dt": 0.01
  },
  "created_at": "2026-01-12T08:00:00.000000+00:00",
  "updated_at": "2026-01-12T08:00:00.000000+00:00"
}