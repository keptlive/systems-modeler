{
  "id": "ev-market-transition-ene",
  "name": "Charging_Adequacy",
  "description": "Model of electric vehicle adoption and market transition. Shows charging infrastructure, battery costs, and consumer adoption dynamics. Based on IEA Global EV Outlook. Reference: ASCE (2021). Infrastructure Report Card. American Society of Civil Engineers. Source: https://infrastructurereportcard.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "EV_Stock_Millions",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Charging_Stations_Thousands",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Battery_Cost_per_kWh",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 600,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Consumer_Awareness",
      "initial_value": 0.1,
      "equation": "",
      "position": {
        "x": 400,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "EV_Sales",
      "equation": "Market_Size * EV_Market_Share",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "EV_Retirements",
      "equation": "EV_Stock_Millions * Vehicle_Retirement_Rate",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Station_Installation",
      "equation": "EV_Stock_Millions * Stations_per_EV_Target * Station_Investment_Rate",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Battery_Cost_Reduction",
      "equation": "(Target_Battery_Cost - Battery_Cost_per_kWh) / Cost_Adjustment_Time",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Awareness_Growth",
      "equation": "(1 - Consumer_Awareness) * Word_of_Mouth * EV_Stock_Millions / 100",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 400,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Market_Size",
      "equation": "90",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "EV_Market_Share",
      "equation": "Adoption_Potential * Consumer_Awareness * Charging_Adequacy * Price_Attractiveness",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Adoption_Potential",
      "equation": "0.3",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "v4",
      "name": "Charging_Adequacy",
      "equation": "MIN(1, Charging_Stations_Thousands / (EV_Stock_Millions * 5))",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Price_Attractiveness",
      "equation": "ICE_Price / (EV_Base_Price - Battery_Cost_Reduction_Value)",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "ICE_Price",
      "equation": "35000",
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "EV_Base_Price",
      "equation": "50000",
      "position": {
        "x": 700,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Battery_Cost_Reduction_Value",
      "equation": "(1000 - Battery_Cost_per_kWh) * 60",
      "position": {
        "x": 600,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "Vehicle_Retirement_Rate",
      "equation": "0.07",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v10",
      "name": "Stations_per_EV_Target",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v11",
      "name": "Station_Investment_Rate",
      "equation": "0.2",
      "position": {
        "x": 450,
        "y": 300
      }
    },
    {
      "id": "v12",
      "name": "Target_Battery_Cost",
      "equation": "100",
      "position": {
        "x": 700,
        "y": 200
      }
    },
    {
      "id": "v13",
      "name": "Cost_Adjustment_Time",
      "equation": "5",
      "position": {
        "x": 650,
        "y": 300
      }
    },
    {
      "id": "v14",
      "name": "Word_of_Mouth",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 400
      }
    }
  ],
