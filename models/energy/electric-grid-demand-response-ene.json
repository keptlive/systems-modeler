{
  "id": "electric-grid-demand-response-ene",
  "name": "Electric Grid Demand Response Model",
  "description": "Model of price-responsive electricity demand for grid balancing. Source: Faruqui & Sergici (2010), Energy Journal. Reference: IEA World Energy Outlook. Source: https://www.iea.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Total_Demand",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "DR_Enrolled",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Grid_Reserve",
      "initial_value": 200,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Demand_Change",
      "equation": "(Base_Demand * Load_Shape - Total_Demand) / Response_Time - DR_Curtailment",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "DR_Enrollment",
      "equation": "Enrollment_Rate * (Potential_DR - DR_Enrolled)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Reserve_Change",
      "equation": "Generation_Capacity - Total_Demand - Grid_Reserve",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Base_Demand",
      "equation": "1000",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Load_Shape",
      "equation": "1 + 0.3 * SIN((TIME - 14) * 3.14159 / 12)",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Generation_Capacity",
      "equation": "1300",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Response_Time",
      "equation": "0.5",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Potential_DR",
      "equation": "200",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Enrollment_Rate",
      "equation": "0.01",
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Price",
      "equation": "50 + 100 * MAX(0, 1 - Grid_Reserve / 100)",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v8",
      "name": "DR_Response_Rate",
      "equation": "MAX(0, (Price - 100) / 100)",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "DR_Curtailment",
      "equation": "DR_Enrolled * DR_Response_Rate * 0.3",
      "position": {
        "x": 300,
        "y": 480
      }
    },
    {
      "id": "v10",
      "name": "Reserve_Margin",
      "equation": "Grid_Reserve / Total_Demand * 100",
      "position": {
        "x": 500,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Grid_Reserve",
      "to_element": "Price"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 24,
    "dt": 0.25
  },
  "created_at": "2026-01-15T14:49:43.657891+00:00",
  "updated_at": "2026-01-15T14:49:43.657894+00:00",
  "source": "https://doi.org/10.5547/ISSN0195-6574-EJ-Vol31-No1-4",
  "reference": "Faruqui, A. & Sergici, S. (2010). Household response to dynamic pricing of electricity: A survey of 15 experiments. Energy Journal 31:187-212."
}