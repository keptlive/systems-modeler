{
  "id": "hubbert-peak-oil-ene",
  "name": "Hubbert Peak Oil Model",
  "description": "M. King Hubbert's (1956) logistic curve model of oil production. Predicts production peak when half of recoverable resources are extracted, followed by decline. Foundational model for resource depletion analysis. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Cumulative_Production",
      "initial_value": 100,
      "position": {
        "x": 200,
        "y": 200
      },
      "equation": ""
    },
    {
      "id": "s2",
      "name": "Remaining_Reserves",
      "initial_value": 2000,
      "position": {
        "x": 400,
        "y": 200
      },
      "equation": ""
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "production_rate",
      "from_stock": "s2",
      "to_stock": "s1",
      "equation": "max_production_rate * (Remaining_Reserves/total_resource) * (Cumulative_Production/total_resource)",
      "position": {
        "x": 0,
        "y": 0
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "max_production_rate",
      "equation": "200",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v2",
      "name": "total_resource",
      "equation": "2100",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "v3",
      "name": "fraction_remaining",
      "equation": "Remaining_Reserves / total_resource",
      "position": {
        "x": 0,
        "y": 0
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Cumulative_Production",
      "to_element": "production_rate"
    },
    {
      "id": "c2",
      "from_element": "Remaining_Reserves",
      "to_element": "production_rate"
    },
    {
      "id": "c3",
      "from_element": "max_production_rate",
      "to_element": "production_rate"
    }
  ],
  "time_settings": {
    "start": 1900,
    "dt": 1,
    "end": 2100
  },
  "created_at": "2026-01-12T02:25:30.586542+00:00",
  "updated_at": "2026-01-12T02:25:30.586651+00:00",
  "source": "https://doi.org/10.1126/science.103.2684.673-a",
  "reference": "Hubbert, M. K. (1956). Nuclear energy and the fossil fuel. Drilling and production practice."
}