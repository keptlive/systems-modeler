{
  "id": "hydrogen-economy-transition-ene",
  "name": "Hydrogen Economy Transition Model",
  "description": "Model of hydrogen economy development including green hydrogen production, distribution infrastructure, and end-use adoption. Shows transition dynamics from grey to green hydrogen. Based on IEA Hydrogen Projects Database and industry roadmaps.",
  "stocks": [
    {"id": "stock-green-h2-capacity", "name": "Green H2 Capacity", "initial_value": 1, "equation": "", "position": {"x": 150, "y": 150}},
    {"id": "stock-grey-h2-capacity", "name": "Grey H2 Capacity", "initial_value": 100, "equation": "", "position": {"x": 150, "y": 300}},
    {"id": "stock-h2-infrastructure", "name": "H2 Infrastructure", "initial_value": 10, "equation": "", "position": {"x": 400, "y": 225}},
    {"id": "stock-h2-demand", "name": "H2 Demand", "initial_value": 90, "equation": "", "position": {"x": 650, "y": 225}}
  ],
  "flows": [
    {"id": "flow-green-capacity-addition", "name": "Green Capacity Addition", "equation": "Green_Investment / Green_Capex", "from_stock": null, "to_stock": "stock-green-h2-capacity", "position": {"x": 50, "y": 150}},
    {"id": "flow-grey-retirement", "name": "Grey Retirement", "equation": "Grey_H2_Capacity / Grey_Lifetime + Grey_Early_Retirement", "from_stock": "stock-grey-h2-capacity", "to_stock": null, "position": {"x": 250, "y": 300}},
    {"id": "flow-infra-buildout", "name": "Infra Buildout", "equation": "(Required_Infrastructure - H2_Infrastructure) / Infra_Build_Time", "from_stock": null, "to_stock": "stock-h2-infrastructure", "position": {"x": 300, "y": 225}},
    {"id": "flow-demand-growth", "name": "Demand Growth", "equation": "H2_Demand * Demand_Growth_Rate", "from_stock": null, "to_stock": "stock-h2-demand", "position": {"x": 550, "y": 225}}
  ],
  "variables": [
    {"id": "var-renewable-electricity-price", "name": "Renewable Electricity Price", "equation": "MAX(10, 40 - Time)", "position": {"x": 200, "y": 80}},
    {"id": "var-electrolyzer-efficiency", "name": "Electrolyzer Efficiency", "equation": "0.7 + 0.005 * Time", "position": {"x": 400, "y": 80}},
    {"id": "var-green-h2-cost", "name": "Green H2 Cost", "equation": "Renewable_Electricity_Price * 50 / Electrolyzer_Efficiency + Green_Capex_Cost", "position": {"x": 600, "y": 80}},
    {"id": "var-green-capex-cost", "name": "Green Capex Cost", "equation": "MAX(0.5, 3 - 0.1 * Time)", "position": {"x": 150, "y": 380}},
    {"id": "var-grey-h2-cost", "name": "Grey H2 Cost", "equation": "1.5 + Carbon_Price * 0.01", "position": {"x": 350, "y": 380}},
    {"id": "var-carbon-price", "name": "Carbon Price", "equation": "20 + 5 * Time", "position": {"x": 550, "y": 380}},
    {"id": "var-green-investment", "name": "Green Investment", "equation": "IF Green_H2_Cost < Grey_H2_Cost THEN Max_Investment ELSE Investment_Subsidy", "position": {"x": 150, "y": 450}},
    {"id": "var-max-investment", "name": "Max Investment", "equation": "50", "position": {"x": 350, "y": 450}},
    {"id": "var-investment-subsidy", "name": "Investment Subsidy", "equation": "10", "position": {"x": 550, "y": 450}},
    {"id": "var-green-capex", "name": "Green Capex", "equation": "MAX(500, 2000 - 50 * Time)", "position": {"x": 100, "y": 520}},
    {"id": "var-grey-lifetime", "name": "Grey Lifetime", "equation": "30", "position": {"x": 250, "y": 520}},
    {"id": "var-grey-early-retirement", "name": "Grey Early Retirement", "equation": "IF Green_H2_Cost < Grey_H2_Cost * 0.8 THEN Grey_H2_Capacity * 0.05 ELSE 0", "position": {"x": 450, "y": 520}},
    {"id": "var-required-infrastructure", "name": "Required Infrastructure", "equation": "H2_Demand * Infrastructure_Ratio", "position": {"x": 650, "y": 520}},
    {"id": "var-infrastructure-ratio", "name": "Infrastructure Ratio", "equation": "0.2", "position": {"x": 250, "y": 590}},
    {"id": "var-infra-build-time", "name": "Infra Build Time", "equation": "3", "position": {"x": 450, "y": 590}},
    {"id": "var-demand-growth-rate", "name": "Demand Growth Rate", "equation": "0.05", "position": {"x": 650, "y": 590}},
    {"id": "var-green-share", "name": "Green Share", "equation": "Green_H2_Capacity / (Green_H2_Capacity + Grey_H2_Capacity)", "position": {"x": 350, "y": 660}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 30, "dt": 0.25},
  "source": "https://doi.org/10.1038/s41560-021-00775-9",
  "reference": "IEA. Global Hydrogen Review 2023. International Energy Agency. 2023."
}
