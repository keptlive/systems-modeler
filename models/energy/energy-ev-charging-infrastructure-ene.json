{
  "id": "energy-ev-charging-infrastructure-ene",
  "name": "EV Charging Infrastructure Deployment",
  "description": "Models the chicken-and-egg dynamics between EV adoption and charging infrastructure deployment. Based on IEA Global EV Outlook and Sperling (2018). Reference: ASCE (2021). Infrastructure Report Card. American Society of Civil Engineers. Source: https://infrastructurereportcard.org/",
  "category": "energy",
  "stocks": [
    {
      "id": "stock-evs",
      "name": "Electric_Vehicles_Million",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "stock-chargers",
      "name": "Public_Chargers_Thousand",
      "initial_value": 500,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-fast-chargers",
      "name": "Fast_Chargers_Thousand",
      "initial_value": 50,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-ice",
      "name": "ICE_Vehicles_Million",
      "initial_value": 1400,
      "equation": "",
      "position": {
        "x": 100,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-ev-sales",
      "name": "EV_Sales",
      "equation": "Annual_Vehicle_Sales * EV_Market_Share",
      "from_stock": null,
      "to_stock": "stock-evs",
      "position": {
        "x": 25,
        "y": 200
      }
    },
    {
      "id": "flow-ev-retire",
      "name": "EV_Retirement",
      "equation": "Electric_Vehicles_Million / Vehicle_Lifetime",
      "from_stock": "stock-evs",
      "to_stock": null,
      "position": {
        "x": 175,
        "y": 200
      }
    },
    {
      "id": "flow-charger-install",
      "name": "Charger_Installation",
      "equation": "Charger_Investment / Charger_Cost * Infrastructure_Incentive",
      "from_stock": null,
      "to_stock": "stock-chargers",
      "position": {
        "x": 225,
        "y": 200
      }
    },
    {
      "id": "flow-fast-install",
      "name": "Fast_Charger_Installation",
      "equation": "Fast_Charger_Investment / Fast_Charger_Cost",
      "from_stock": null,
      "to_stock": "stock-fast-chargers",
      "position": {
        "x": 425,
        "y": 200
      }
    },
    {
      "id": "flow-ice-sales",
      "name": "ICE_Sales",
      "equation": "Annual_Vehicle_Sales * (1 - EV_Market_Share)",
      "from_stock": null,
      "to_stock": "stock-ice",
      "position": {
        "x": 25,
        "y": 350
      }
    },
    {
      "id": "flow-ice-retire",
      "name": "ICE_Retirement",
      "equation": "ICE_Vehicles_Million / Vehicle_Lifetime",
      "from_stock": "stock-ice",
      "to_stock": null,
      "position": {
        "x": 175,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-annual-sales",
      "name": "Annual_Vehicle_Sales",
      "equation": "90",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "var-ev-share",
      "name": "EV_Market_Share",
      "equation": "Base_EV_Share * (1 + Charging_Attractiveness)",
      "position": {
        "x": 200,
        "y": 80
      }
    },
    {
      "id": "var-base-share",
      "name": "Base_EV_Share",
      "equation": "0.1",
      "position": {
        "x": 300,
        "y": 80
      }
    },
    {
      "id": "var-vehicle-life",
      "name": "Vehicle_Lifetime",
      "equation": "15",
      "position": {
        "x": 400,
        "y": 80
      }
    },
    {
      "id": "var-charger-inv",
      "name": "Charger_Investment",
      "equation": "5e9",
      "position": {
        "x": 500,
        "y": 80
      }
    },
    {
      "id": "var-charger-cost",
      "name": "Charger_Cost",
      "equation": "10000",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-fast-inv",
      "name": "Fast_Charger_Investment",
      "equation": "2e9",
      "position": {
        "x": 150,
        "y": 450
      }
    },
    {
      "id": "var-fast-cost",
      "name": "Fast_Charger_Cost",
      "equation": "100000",
      "position": {
        "x": 300,
        "y": 450
      }
    },
    {
      "id": "var-incentive",
      "name": "Infrastructure_Incentive",
      "equation": "1.5",
      "position": {
        "x": 450,
        "y": 450
      }
    },
    {
      "id": "var-attract",
      "name": "Charging_Attractiveness",
      "equation": "(Public_Chargers_Thousand + 5 * Fast_Chargers_Thousand) / (Electric_Vehicles_Million * 50)",
      "position": {
        "x": 600,
        "y": 450
      }
    }
  ],
  "time_settings": {
    "start": 2020,
    "end": 2050,
    "dt": 1
  },
  "source": "https://www.iea.org/reports/global-ev-outlook-2023",
