{
  "id": "wind-grid-storage-integration-ene",
  "name": "Discharge_Rate",
  "description": "Model of wind power integration challenges and battery storage solutions. Shows how storage smooths intermittent wind output for grid stability. Based on Denholm et al. (2010) NREL analysis. Reference: IEA Wind Energy. Source: https://www.iea.org/fuels-and-technologies/wind",
  "stocks": [
    {
      "id": "s1",
      "name": "Wind_Capacity_GW",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Battery_Storage_GWh",
      "initial_value": 1,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Battery_Charge_GWh",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    },
    {
      "id": "s4",
      "name": "Curtailment_Cumulative",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Wind_Capacity_Growth",
      "equation": "Wind_Investment / Cost_per_GW_Wind",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Storage_Investment",
      "equation": "Storage_Need / Cost_per_GWh_Storage",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Charge_Rate",
      "equation": "MIN(Excess_Generation, Battery_Storage_GWh - Battery_Charge_GWh) / 4",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "f4",
      "name": "Discharge_Rate",
      "equation": "MIN(Generation_Deficit, Battery_Charge_GWh) / 4",
      "from_stock": "s3",
      "to_stock": null,
      "position": {
        "x": 650,
        "y": 200
      }
    },
    {
      "id": "f5",
      "name": "Curtailment_Rate",
      "equation": "MAX(0, Excess_Generation - Charge_Rate)",
      "from_stock": null,
      "to_stock": "s4",
      "position": {
        "x": 350,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Wind_Output",
      "equation": "Wind_Capacity_GW * Capacity_Factor",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Capacity_Factor",
      "equation": "0.25 + 0.1 * SIN(TIME * 24)",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Grid_Demand",
      "equation": "20 + 5 * SIN(TIME * 24 + 3.14)",
      "position": {
        "x": 550,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Excess_Generation",
      "equation": "MAX(0, Wind_Output - Grid_Demand)",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Generation_Deficit",
      "equation": "MAX(0, Grid_Demand - Wind_Output)",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Wind_Investment",
      "equation": "1",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "v7",
      "name": "Cost_per_GW_Wind",
      "equation": "1.2",
      "position": {
        "x": 150,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Storage_Need",
      "equation": "MAX(0, Wind_Capacity_GW * 0.2 - Battery_Storage_GWh)",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "v9",
      "name": "Cost_per_GWh_Storage",
      "equation": "0.3",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Grid_Stability_Index",
      "equation": "1 - Curtailment_Rate / MAX(1, Wind_Output)",
      "position": {
        "x": 450,
        "y": 350
      }
    }
  ],
  "connectors": [
    {
      "id": "conn-1",
      "from_element": "Wind_Investment",
      "to_element": "Wind_Capacity_Growth"
    },
    {
      "id": "conn-2",
      "from_element": "Cost_per_GW_Wind",
      "to_element": "Wind_Capacity_Growth"
    },
    {
      "id": "conn-3",
      "from_element": "Storage_Need",
      "to_element": "Storage_Investment"
    },
    {
      "id": "conn-4",
      "from_element": "Cost_per_GWh_Storage",
      "to_element": "Storage_Investment"
    },
    {
      "id": "conn-5",
      "from_element": "Excess_Generation",
      "to_element": "Charge_Rate"
    },
    {
      "id": "conn-6",
      "from_element": "Battery_Storage_GWh",
      "to_element": "Charge_Rate"
    },
    {
      "id": "conn-7",
      "from_element": "Battery_Charge_GWh",
      "to_element": "Charge_Rate"
    },
    {
      "id": "conn-8",
      "from_element": "Generation_Deficit",
      "to_element": "Discharge_Rate"
    },
    {
      "id": "conn-9",
      "from_element": "Battery_Charge_GWh",
      "to_element": "Discharge_Rate"
    },
    {
      "id": "conn-10",
      "from_element": "Charge_Rate",
      "to_element": "Curtailment_Rate"
    },
    {
      "id": "conn-11",
      "from_element": "Excess_Generation",
      "to_element": "Curtailment_Rate"
    },
    {
      "id": "conn-12",
      "from_element": "Wind_Capacity_GW",
      "to_element": "Wind_Output"
    },
    {
      "id": "conn-13",
      "from_element": "Capacity_Factor",
      "to_element": "Wind_Output"
    },
    {
      "id": "conn-14",
      "from_element": "Wind_Output",
      "to_element": "Excess_Generation"
    },
    {
      "id": "conn-15",
      "from_element": "Grid_Demand",
      "to_element": "Excess_Generation"
    },
    {
      "id": "conn-16",
      "from_element": "Wind_Output",
      "to_element": "Generation_Deficit"
    },
    {
      "id": "conn-17",
      "from_element": "Grid_Demand",
      "to_element": "Generation_Deficit"
    },
    {
      "id": "conn-18",
      "from_element": "Wind_Capacity_GW",
      "to_element": "Storage_Need"
    },
    {
      "id": "conn-19",
      "from_element": "Battery_Storage_GWh",
      "to_element": "Storage_Need"
    },
    {
      "id": "conn-20",
      "from_element": "Curtailment_Rate",
      "to_element": "Grid_Stability_Index"
    },
    {
      "id": "conn-21",
      "from_element": "Wind_Output",
      "to_element": "Grid_Stability_Index"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 365,
    "dt": 0.25
  },
