{
  "id": "electric-grid-stability-ene",
  "name": "Electric Grid Stability Model",
  "description": "Model of power grid stability with renewable integration showing frequency regulation and storage needs. Reference: IRENA Renewable Energy Statistics. Source: https://www.irena.org/",
  "stocks": [
    {
      "id": "stock-gen",
      "name": "Generation_Capacity",
      "initial_value": 1000,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "stock-storage",
      "name": "Energy_Storage",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "stock-freq",
      "name": "Grid_Frequency",
      "initial_value": 60,
      "equation": "",
      "position": {
        "x": 550,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-renew-add",
      "name": "Renewable_Addition",
      "equation": "Renewable_Investment",
      "from_stock": null,
      "to_stock": "stock-gen",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "flow-retire",
      "name": "Retirements",
      "equation": "Generation_Capacity * Retirement_Rate",
      "from_stock": "stock-gen",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 300
      }
    },
    {
      "id": "flow-charge",
      "name": "Storage_Charging",
      "equation": "Excess_Generation * Charging_Efficiency",
      "from_stock": null,
      "to_stock": "stock-storage",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "flow-discharge",
      "name": "Storage_Discharge",
      "equation": "Storage_Demand",
      "from_stock": "stock-storage",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 300
      }
    },
    {
      "id": "flow-freq-adj",
      "name": "Frequency_Adjustment",
      "equation": "(Target_Frequency - Grid_Frequency) * Regulation_Speed",
      "from_stock": null,
      "to_stock": "stock-freq",
      "position": {
        "x": 550,
        "y": 100
      }
    }
  ],
  "variables": [
    {
      "id": "var-invest",
      "name": "Renewable_Investment",
      "equation": "20",
      "position": {
        "x": 50,
        "y": 50
      }
    },
    {
      "id": "var-retire",
      "name": "Retirement_Rate",
      "equation": "0.02",
      "position": {
        "x": 50,
        "y": 350
      }
    },
    {
      "id": "var-excess",
      "name": "Excess_Generation",
      "equation": "Generation_Capacity * 0.1 * Variability",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "var-var",
      "name": "Variability",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "var-eff",
      "name": "Charging_Efficiency",
      "equation": "0.9",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-demand",
      "name": "Storage_Demand",
      "equation": "Generation_Capacity * 0.05",
      "position": {
        "x": 250,
        "y": 350
      }
    },
    {
      "id": "var-target",
      "name": "Target_Frequency",
      "equation": "60",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "var-speed",
      "name": "Regulation_Speed",
      "equation": "0.5",
      "position": {
        "x": 600,
        "y": 100
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Renewable_Investment",
      "to_element": "Renewable_Addition"
    },
    {
      "id": "c2",
      "from_element": "Generation_Capacity",
      "to_element": "Retirements"
    },
    {
      "id": "c3",
      "from_element": "Retirement_Rate",
      "to_element": "Retirements"
    },
    {
      "id": "c4",
      "from_element": "Excess_Generation",
      "to_element": "Storage_Charging"
    },
    {
      "id": "c5",
      "from_element": "Charging_Efficiency",
      "to_element": "Storage_Charging"
    },
    {
      "id": "c6",
      "from_element": "Storage_Demand",
      "to_element": "Storage_Discharge"
    },
    {
      "id": "c7",
      "from_element": "Target_Frequency",
      "to_element": "Frequency_Adjustment"
    },
    {
      "id": "c8",
      "from_element": "Grid_Frequency",
      "to_element": "Frequency_Adjustment"
    },
    {
      "id": "c9",
      "from_element": "Regulation_Speed",
      "to_element": "Frequency_Adjustment"
    }
  ],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.5
  },
  "created_at": "2026-01-12T11:49:16.387811+00:00",
  "updated_at": "2026-01-12T11:49:16.387815+00:00",
  "source": "https://doi.org/10.1038/s41560-019-0326-7",
  "reference": "Denholm P, et al. Inertia and the Power Grid: A Guide Without the Spin. NREL. 2020."
}