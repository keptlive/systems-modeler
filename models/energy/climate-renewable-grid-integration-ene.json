{
  "id": "climate-renewable-grid-integration-ene",
  "name": "Renewable Energy Grid Integration",
  "description": "Models the integration of variable renewable energy (solar/wind) into electricity grids, including storage requirements and curtailment. Based on NREL and IEA analyses. Reference: IEA World Energy Outlook. Source: https://www.iea.org/",
  "category": "energy",
  "stocks": [
    {
      "id": "stock-solar-cap",
      "name": "Solar_Capacity_GW",
