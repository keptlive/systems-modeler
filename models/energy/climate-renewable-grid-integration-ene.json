      }
    },
    {
      "id": "var-storage-cost",
      "name": "Storage_Cost",
      "equation": "200e6",
      "position": {
        "x": 600,
        "y": 80
      }
    },
    {
      "id": "var-demand",
      "name": "Grid_Demand_GW",
      "equation": "150",
      "position": {
