        "y": 350
      }
    },
    {
      "id": "var-solar-cf",
      "name": "Solar_Capacity_Factor",
      "equation": "0.25",
      "position": {
        "x": 200,
        "y": 350
      }
    },
    {
      "id": "var-wind-cf",
      "name": "Wind_Capacity_Factor",
      "equation": "0.35",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "var-re-gen",
      "name": "RE_Generation",
      "equation": "Solar_Capacity_GW * Solar_Capacity_Factor + Wind_Capacity_GW * Wind_Capacity_Factor",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "var-excess",
      "name": "Excess_Generation",
      "equation": "MAX(0, RE_Generation - Grid_Demand_GW)",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-shortfall",
      "name": "Generation_Shortfall",
      "equation": "MAX(0, Grid_Demand_GW - RE_Generation)",
      "position": {
        "x": 600,
        "y": 350
      }
    },
    {
