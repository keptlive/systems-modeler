      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "stock-wind-cap",
      "name": "Wind_Capacity_GW",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 100,
        "y": 250
      }
    },
    {
      "id": "stock-storage-cap",
      "name": "Storage_Capacity_GWh",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "stock-storage-level",
      "name": "Storage_Level_GWh",
      "initial_value": 5,
      "equation": "",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "stock-curtailed",
      "name": "Cumulative_Curtailed_TWh",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 700,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "flow-solar-add",
      "name": "Solar_Additions",
      "equation": "Solar_Investment / Solar_Cost",
      "from_stock": null,
      "to_stock": "stock-solar-cap",
      "position": {
        "x": 25,
        "y": 150
      }
    },
    {
      "id": "flow-wind-add",
      "name": "Wind_Additions",
      "equation": "Wind_Investment / Wind_Cost",
      "from_stock": null,
      "to_stock": "stock-wind-cap",
      "position": {
        "x": 25,
        "y": 250
      }
    },
    {
      "id": "flow-storage-add",
      "name": "Storage_Additions",
      "equation": "Storage_Investment / Storage_Cost",
      "from_stock": null,
      "to_stock": "stock-storage-cap",
      "position": {
        "x": 225,
        "y": 200
      }
    },
    {
      "id": "flow-charging",
      "name": "Charging",
      "equation": "MIN(Excess_Generation, (Storage_Capacity_GWh - Storage_Level_GWh) / Charge_Time)",
      "from_stock": null,
      "to_stock": "stock-storage-level",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "flow-discharging",
      "name": "Discharging",
      "equation": "MIN(Generation_Shortfall, Storage_Level_GWh / Discharge_Time)",
      "from_stock": "stock-storage-level",
      "to_stock": null,
      "position": {
        "x": 600,
        "y": 150
      }
    },
    {
      "id": "flow-curtailment",
      "name": "Curtailment",
      "equation": "MAX(0, Excess_Generation - Charging)",
      "from_stock": null,
      "to_stock": "stock-curtailed",
      "position": {
        "x": 700,
        "y": 150
      }
    }
  ],
  "variables": [
    {
      "id": "var-solar-inv",
      "name": "Solar_Investment",
