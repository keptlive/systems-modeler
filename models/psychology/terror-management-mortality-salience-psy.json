      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Self_Esteem",
      "initial_value": 0.6,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Anxiety_Change",
      "equation": "Mortality_Salience - Anxiety_Reduction * Death_Anxiety",
