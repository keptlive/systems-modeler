{
  "id": "terror-management-mortality-salience-psy",
  "name": "Terror Management Theory Model",
  "description": "Model of how mortality salience affects worldview defense. Source: Greenberg et al. (1986), J Personality Social Psychology.",
  "stocks": [
    {
      "id": "s1",
      "name": "Death_Anxiety",
      "initial_value": 0.3,
