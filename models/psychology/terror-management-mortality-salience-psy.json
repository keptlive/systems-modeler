      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Defense_Response",
      "equation": "Defense_Gain * Death_Anxiety * (1 - Worldview_Defense)",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Esteem_Change",
      "equation": "Esteem_Boost * Worldview_Defense - Esteem_Decay * (1 - Self_Esteem)",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
