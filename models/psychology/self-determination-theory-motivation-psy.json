{
  "id": "self-determination-theory-motivation-psy",
  "name": "Self-Determination Theory Model",
  "description": "Model of intrinsic vs extrinsic motivation and psychological needs. Source: Deci & Ryan (1985), Self-Determination Theory.",
  "stocks": [
    {
      "id": "s1",
      "name": "Intrinsic_Motivation",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Extrinsic_Motivation",
      "initial_value": 0.3,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Psychological_Need_Satisfaction",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Intrinsic_Change",
      "equation": "Autonomy_Support * (Psychological_Need_Satisfaction - Intrinsic_Motivation) - Undermining * Extrinsic_Motivation",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Extrinsic_Change",
      "equation": "External_Rewards - Internalization_Rate * Extrinsic_Motivation * Psychological_Need_Satisfaction",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Need_Change",
      "equation": "Need_Fulfillment_Rate * (Autonomy + Competence + Relatedness) / 3 - Need_Thwarting",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Autonomy",
      "equation": "0.6",
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Competence",
      "equation": "0.5",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Relatedness",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Autonomy_Support",
      "equation": "0.3",
      "position": {
        "x": 450,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "External_Rewards",
      "equation": "0.1",
      "position": {
        "x": 150,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Undermining",
      "equation": "0.2",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Internalization_Rate",
      "equation": "0.1",
      "position": {
        "x": 450,
        "y": 100
      }
    },
    {
      "id": "v8",
      "name": "Need_Fulfillment_Rate",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v9",
      "name": "Need_Thwarting",
      "equation": "0.1",
      "position": {
        "x": 400,
        "y": 420
      }
    },
    {
      "id": "v10",
      "name": "Total_Motivation",
      "equation": "Intrinsic_Motivation + 0.5 * Extrinsic_Motivation",
      "position": {
        "x": 300,
        "y": 480
      }
    }
  ],
  "connectors": [
    {
