{
  "id": "rescorla-wagner-associative-learning-psy",
  "name": "Rescorla-Wagner Learning Model",
  "description": "Classical conditioning and associative learning. Source: Rescorla & Wagner (1972), Classical Conditioning II.",
  "stocks": [
    {
      "id": "s1",
      "name": "Association_Strength",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Response_Probability",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "s3",
      "name": "Trials_Completed",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Learning",
      "equation": "alpha * beta * (Lambda - Association_Strength) * CS_Present",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "f2",
      "name": "Response_Update",
      "equation": "(Association_Strength - Response_Probability) / Response_Lag",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 500,
        "y": 200
      }
    },
    {
      "id": "f3",
      "name": "Trial_Count",
      "equation": "1",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "alpha",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "beta",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Lambda",
      "equation": "1",
      "position": {
        "x": 500,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "CS_Present",
      "equation": "1",
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Response_Lag",
      "equation": "1",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Prediction_Error",
      "equation": "Lambda - Association_Strength",
      "position": {
        "x": 200,
        "y": 420
      }
    },
    {
      "id": "v7",
      "name": "Learning_Rate",
      "equation": "alpha * beta",
      "position": {
        "x": 400,
        "y": 420
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Association_Strength",
      "to_element": "Prediction_Error"
    }
  ],
  "time_settings": {
