{
  "id": "yerkes-dodson-arousal-psy",
  "name": "Yerkes-Dodson Arousal Performance",
  "description": "Inverted-U relationship between arousal and task performance",
  "stocks": [
    {
      "id": "s1",
      "name": "Arousal_Level",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Performance",
      "initial_value": 0.5,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [],
  "variables": [
    {
      "id": "v1",
      "name": "Optimal_Arousal",
      "equation": "0.5",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Task_Difficulty",
      "equation": "0.5",
      "position": {
        "x": 230,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Performance_Curve",
      "equation": "1-(Arousal_Level-Optimal_Arousal)*(Arousal_Level-Optimal_Arousal)*4",
      "position": {
        "x": 360,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Arousal_Change",
      "equation": "0.1*(0.5-Arousal_Level)",
      "position": {
        "x": 490,
        "y": 50
      }
    }
  ],
  "connectors": [
    {
      "id": "c1",
      "from_element": "Arousal_Level",
      "to_element": "Performance_Curve"
    },
    {
      "id": "c2",
      "from_element": "Optimal_Arousal",
      "to_element": "Performance_Curve"
    },
    {
      "id": "c3",
      "from_element": "Arousal_Level",
      "to_element": "Arousal_Change"
    }
  ],
  "time_settings": {
    "start": 0.0,
    "end": 10.0,
    "dt": 0.1
  },
