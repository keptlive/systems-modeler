{
  "id": "representational-heuristics-bias-psy",
  "name": "Representativeness Heuristic and Base Rate Neglect Model",
  "description": "Model of how representativeness heuristic leads to base rate neglect in probability judgments. Demonstrates systematic departures from Bayesian reasoning. Source: Kahneman & Tversky (1973). Cognitive Psychology. DOI: 10.1016/0010-0285(72)90016-3",
  "stocks": [
    {"id": "stock-belief", "name": "Subjective_Probability", "initial_value": 0.5, "equation": "", "position": {"x": 300, "y": 200}},
    {"id": "stock-confidence", "name": "Judgment_Confidence", "initial_value": 0.7, "equation": "", "position": {"x": 300, "y": 350}}
  ],
  "flows": [
    {"id": "flow-update", "name": "Belief_Update", "equation": "(Heuristic_Judgment - Subjective_Probability) * Update_Speed", "from_stock": null, "to_stock": "stock-belief", "position": {"x": 150, "y": 200}},
    {"id": "flow-confidence", "name": "Confidence_Change", "equation": "(Representativeness_Strength - Judgment_Confidence) * Confidence_Speed", "from_stock": null, "to_stock": "stock-confidence", "position": {"x": 150, "y": 350}}
  ],
  "variables": [
    {"id": "var-base-rate", "name": "True_Base_Rate", "equation": "0.05", "position": {"x": 150, "y": 100}},
    {"id": "var-representative", "name": "Representativeness_Strength", "equation": "0.9", "position": {"x": 350, "y": 100}},
    {"id": "var-base-weight", "name": "Base_Rate_Weight", "equation": "0.2", "position": {"x": 250, "y": 100}},
    {"id": "var-heuristic", "name": "Heuristic_Judgment", "equation": "Base_Rate_Weight * True_Base_Rate + (1 - Base_Rate_Weight) * Representativeness_Strength", "position": {"x": 200, "y": 300}},
    {"id": "var-bayesian", "name": "Bayesian_Probability", "equation": "True_Base_Rate * Likelihood_Ratio / (True_Base_Rate * Likelihood_Ratio + (1 - True_Base_Rate))", "position": {"x": 450, "y": 200}},
    {"id": "var-likelihood", "name": "Likelihood_Ratio", "equation": "10", "position": {"x": 500, "y": 100}},
    {"id": "var-update-speed", "name": "Update_Speed", "equation": "0.3", "position": {"x": 100, "y": 250}},
    {"id": "var-conf-speed", "name": "Confidence_Speed", "equation": "0.2", "position": {"x": 100, "y": 400}},
    {"id": "var-bias", "name": "Base_Rate_Neglect_Bias", "equation": "Subjective_Probability - Bayesian_Probability", "position": {"x": 400, "y": 350}},
    {"id": "var-accuracy", "name": "Judgment_Accuracy", "equation": "1 - ABS(Subjective_Probability - Bayesian_Probability)", "position": {"x": 450, "y": 400}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 20, "dt": 0.5},
  "created_at": "2026-01-15T00:00:00Z",
  "updated_at": "2026-01-15T00:00:00Z",
  "source": "https://doi.org/10.1016/0010-0285(72)90016-3",
  "reference": "Kahneman, D. & Tversky, A. (1973). On the psychology of prediction. Psychological Review, 80(4), 237-251."
}
