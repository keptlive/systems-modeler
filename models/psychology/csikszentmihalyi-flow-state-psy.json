{
  "id": "csikszentmihalyi-flow-state-psy",
  "name": "Csikszentmihalyi Flow State Model",
  "description": "Mihaly Csikszentmihalyi's model of flow - the optimal experience state where challenge matches skill level. Too much challenge causes anxiety; too little causes boredom. Flow maximizes engagement and performance.",
  "stocks": [
    {"id": "stock-skill-level", "name": "Skill Level", "initial_value": 50, "equation": "", "position": {"x": 200, "y": 200}},
    {"id": "stock-challenge-level", "name": "Challenge Level", "initial_value": 50, "equation": "", "position": {"x": 450, "y": 200}},
    {"id": "stock-engagement", "name": "Engagement", "initial_value": 70, "equation": "", "position": {"x": 325, "y": 350}}
  ],
  "flows": [
    {"id": "flow-skill-growth", "name": "Skill Growth", "equation": "Learning_Rate * Engagement / 100", "from_stock": null, "to_stock": "stock-skill-level", "position": {"x": 100, "y": 200}},
    {"id": "flow-challenge-adjustment", "name": "Challenge Adjustment", "equation": "(Optimal_Challenge - Challenge_Level) / Challenge_Adjustment_Time", "from_stock": null, "to_stock": "stock-challenge-level", "position": {"x": 350, "y": 200}},
    {"id": "flow-engagement-change", "name": "Engagement Change", "equation": "(Flow_Potential - Engagement) / Engagement_Adjustment_Time", "from_stock": null, "to_stock": "stock-engagement", "position": {"x": 225, "y": 350}}
  ],
  "variables": [
    {"id": "var-skill-challenge-ratio", "name": "Skill Challenge Ratio", "equation": "Skill_Level / MAX(1, Challenge_Level)", "position": {"x": 325, "y": 100}},
    {"id": "var-optimal-ratio", "name": "Optimal Ratio", "equation": "1", "position": {"x": 500, "y": 100}},
    {"id": "var-flow-zone-width", "name": "Flow Zone Width", "equation": "0.3", "position": {"x": 650, "y": 100}},
    {"id": "var-deviation-from-optimal", "name": "Deviation from Optimal", "equation": "ABS(Skill_Challenge_Ratio - Optimal_Ratio)", "position": {"x": 150, "y": 280}},
    {"id": "var-in-flow-zone", "name": "In Flow Zone", "equation": "IF Deviation_from_Optimal < Flow_Zone_Width THEN 1 ELSE 0", "position": {"x": 400, "y": 280}},
    {"id": "var-anxiety-level", "name": "Anxiety Level", "equation": "IF Skill_Challenge_Ratio < 0.7 THEN 100 * (0.7 - Skill_Challenge_Ratio) / 0.7 ELSE 0", "position": {"x": 550, "y": 280}},
    {"id": "var-boredom-level", "name": "Boredom Level", "equation": "IF Skill_Challenge_Ratio > 1.3 THEN 100 * (Skill_Challenge_Ratio - 1.3) / 1.3 ELSE 0", "position": {"x": 550, "y": 350}},
    {"id": "var-flow-potential", "name": "Flow Potential", "equation": "100 * EXP(-5 * Deviation_from_Optimal ^ 2)", "position": {"x": 150, "y": 420}},
    {"id": "var-optimal-challenge", "name": "Optimal Challenge", "equation": "Skill_Level * Optimal_Ratio", "position": {"x": 350, "y": 420}},
    {"id": "var-learning-rate", "name": "Learning Rate", "equation": "0.5", "position": {"x": 550, "y": 420}},
    {"id": "var-challenge-adjustment-time", "name": "Challenge Adjustment Time", "equation": "5", "position": {"x": 200, "y": 490}},
    {"id": "var-engagement-adjustment-time", "name": "Engagement Adjustment Time", "equation": "2", "position": {"x": 450, "y": 490}},
    {"id": "var-performance", "name": "Performance", "equation": "Skill_Level * Engagement / 100", "position": {"x": 325, "y": 550}}
  ],
  "connectors": [],
  "time_settings": {"start": 0, "end": 100, "dt": 0.5},
  "source": "https://doi.org/10.1007/978-94-017-9088-8",
  "reference": "Csikszentmihalyi M. Flow: The Psychology of Optimal Experience. Harper & Row. 1990."
}
