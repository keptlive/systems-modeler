{
  "id": "hick-reaction-time-psy",
  "name": "Hick-Hyman Reaction Time Model",
  "description": "Model showing logarithmic relationship between choice options and reaction time. Reference: Hick, W.E. (1952). On the rate of gain of information.",
  "stocks": [
    {
      "id": "s1",
      "name": "Information_Processed",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 150,
        "y": 200
      }
    },
    {
      "id": "s2",
      "name": "Response_Count",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 350,
        "y": 200
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Processing",
      "equation": "Processing_Rate",
      "from_stock": null,
      "to_stock": "Information_Processed",
      "position": {
        "x": 100,
        "y": 300
      }
    },
    {
      "id": "f2",
      "name": "Response",
      "equation": "IF Information_Processed >= Information_Needed THEN 1 ELSE 0",
      "from_stock": null,
      "to_stock": "Response_Count",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Num_Alternatives",
      "equation": "4",
      "position": {
        "x": 100,
        "y": 50
      }
    },
    {
      "id": "v2",
      "name": "Information_Needed",
      "equation": "LOG(Num_Alternatives) / LOG(2)",
      "position": {
        "x": 250,
        "y": 50
      }
    },
    {
      "id": "v3",
      "name": "Processing_Rate",
      "equation": "1",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v4",
      "name": "Base_RT",
      "equation": "0.2",
      "position": {
        "x": 550,
        "y": 50
      }
    },
    {
      "id": "v5",
      "name": "Hick_Constant",
      "equation": "0.15",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Predicted_RT",
      "equation": "Base_RT + Hick_Constant * Information_Needed",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v7",
      "name": "Actual_RT",
      "equation": "Information_Needed / Processing_Rate + Base_RT",
      "position": {
        "x": 400,
        "y": 100
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 5,
    "dt": 0.01
  },
  "source": "https://doi.org/10.1080/17470215208416600",
  "reference": "Hick, W.E. (1952). On the rate of gain of information. Quarterly Journal of Experimental Psychology, 4(1), 11-26.",
