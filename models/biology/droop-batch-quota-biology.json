{
  "id": "droop-batch-quota-biology",
  "name": "Droop internal nutrient quota in a closed batch culture",
  "description": "Closed-batch specialization of uptake/quota balance: external nutrient plus Quota*Biomass is conserved. No dilution or nutrient inflow. Quota>=quota_min is an invariant domain for the stated nonnegative initial data. Reconstructs a retired flowless concept. Illustrative parameter values, initial conditions and horizon selected for this teaching example; not fitted observations. Signed net-rate flows encode equations, not material transfer claims. No clamps or hidden state resets.",
  "source": "https://doi.org/10.1017/S0025315400019238",
  "reference": "Droop (1968), Vitamin B12 and marine ecology IV. The kinetics of uptake, growth and inhibition in Monochrysis lutheri; Droop(1974), The nutrient status of algal cells in continuous culture, doi:10.1017/S002531540005760X.",
  "category": "biology",
  "stocks": [
    {
      "id": "droop-batch-quota-biology:External_Nutrient",
      "name": "External_Nutrient",
      "initial_value": 10,
      "units": "nutrient/volume",
      "equation": "",
      "position": {
        "x": 140,
        "y": 250
      }
    },
    {
      "id": "droop-batch-quota-biology:Quota",
      "name": "Quota",
      "initial_value": 0.2,
      "units": "nutrient/biomass",
      "equation": "",
      "position": {
        "x": 320,
        "y": 250
      }
    },
    {
      "id": "droop-batch-quota-biology:Biomass",
      "name": "Biomass",
      "initial_value": 1,
      "units": "biomass/volume",
      "equation": "",
      "position": {
        "x": 500,
        "y": 250
      }
    }
  ],
  "flows": [
    {
      "id": "droop-batch-quota-biology:rate:External_Nutrient",
      "name": "External_Nutrient_net_rate",
      "equation": "-uptake_max*External_Nutrient/(half_saturation+External_Nutrient)*Biomass",
      "to_stock": "droop-batch-quota-biology:External_Nutrient",
      "units": "(nutrient/volume)/day",
      "position": {
        "x": 140,
        "y": 350
      }
    },
    {
      "id": "droop-batch-quota-biology:rate:Quota",
      "name": "Quota_net_rate",
      "equation": "uptake_max*External_Nutrient/(half_saturation+External_Nutrient)-growth_max*(1-quota_min/Quota)*Quota",
      "to_stock": "droop-batch-quota-biology:Quota",
      "units": "(nutrient/biomass)/day",
      "position": {
        "x": 320,
        "y": 350
      }
    },
    {
      "id": "droop-batch-quota-biology:rate:Biomass",
      "name": "Biomass_net_rate",
      "equation": "growth_max*(1-quota_min/Quota)*Biomass",
      "to_stock": "droop-batch-quota-biology:Biomass",
      "units": "(biomass/volume)/day",
      "position": {
        "x": 500,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "droop-batch-quota-biology:parameter:uptake_max",
      "name": "uptake_max",
      "equation": "0.5",
      "units": "nutrient/biomass/day",
      "position": {
        "x": 100,
        "y": 80
      }
    },
    {
      "id": "droop-batch-quota-biology:parameter:half_saturation",
      "name": "half_saturation",
      "equation": "0.5",
      "units": "nutrient/volume",
      "position": {
        "x": 190,
        "y": 80
      }
    },
    {
      "id": "droop-batch-quota-biology:parameter:growth_max",
      "name": "growth_max",
      "equation": "1",
      "units": "1/day",
      "position": {
        "x": 280,
        "y": 80
      }
    },
    {
      "id": "droop-batch-quota-biology:parameter:quota_min",
      "name": "quota_min",
      "equation": "0.1",
      "units": "nutrient/biomass",
      "position": {
        "x": 370,
        "y": 80
      }
    }
  ],
  "tables": [],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 30,
    "dt": 0.01,
    "integration_method": "rk4",
    "units": "day",
    "rtol": 1e-08,
    "atol": 1e-10
  }
}
