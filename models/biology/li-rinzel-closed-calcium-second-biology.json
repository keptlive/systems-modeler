      "id": "li-rinzel-closed-calcium-second-biology:rate:Cytosolic_Calcium",
      "name": "Cytosolic_Calcium_net_rate",
      "equation": "(release_rate*Channel_Open+leak_rate)*ER_Gradient-pump_capacity*Cytosolic_Calcium^2/(pump_half^2+Cytosolic_Calcium^2)",
      "to_stock": "li-rinzel-closed-calcium-second-biology:Cytosolic_Calcium",
      "units": "(concentration)/time",
      "position": {
        "x": 120,
        "y": 300
      }
    },
    {
      "id": "li-rinzel-closed-calcium-second-biology:rate:Available_Receptors",
      "name": "Available_Receptors_net_rate",
