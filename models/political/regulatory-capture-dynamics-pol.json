{
  "id": "regulatory-capture-dynamics-pol",
  "name": "Regulatory Capture Dynamics",
  "description": "Model of regulatory capture showing how industry influence over regulators can weaken regulatory effectiveness over time. Based on Stigler's theory of economic regulation. Reference: NBER Economic Research. Source: https://www.nber.org/",
  "source": "https://doi.org/10.2307/3003160",
  "reference": "Stigler GJ. The Theory of Economic Regulation. Bell Journal of Economics and Management Science. 1971;2(1):3-21.",
  "stocks": [
    {
      "id": "stock-independence",
      "name": "Regulatory_Independence",
      "initial_value": 80,
      "equation": "",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "stock-industry",
      "name": "Industry_Influence",
      "initial_value": 20,
      "equation": "",
      "position": {
        "x": 400,
        "y": 200
      }
    },
    {
      "id": "stock-effectiveness",
      "name": "Regulatory_Effectiveness",
      "initial_value": 70,
      "equation": "",
      "position": {
        "x": 300,
        "y": 350
      }
    }
  ],
  "flows": [
    {
      "id": "flow-capture",
      "name": "Capture_Process",
      "equation": "Regulatory_Independence * capture_rate * (Industry_Influence / 100)",
      "from_stock": "stock-independence",
      "to_stock": "stock-industry",
      "position": {
        "x": 300,
        "y": 200
      }
    },
    {
      "id": "flow-reform",
      "name": "Reform_Efforts",
      "equation": "Industry_Influence * reform_rate * public_pressure",
      "from_stock": "stock-industry",
      "to_stock": "stock-independence",
      "position": {
        "x": 300,
        "y": 250
      }
    },
    {
      "id": "flow-eff-decay",
      "name": "Effectiveness_Erosion",
      "equation": "Regulatory_Effectiveness * erosion_rate * Industry_Influence / 100",
      "from_stock": "stock-effectiveness",
      "to_stock": null,
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "flow-eff-build",
      "name": "Effectiveness_Building",
      "equation": "effectiveness_investment * Regulatory_Independence / 100",
      "from_stock": null,
      "to_stock": "stock-effectiveness",
      "position": {
        "x": 200,
        "y": 350
      }
    }
  ],
  "variables": [
    {
      "id": "var-capture",
      "name": "capture_rate",
      "equation": "0.03",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "var-reform",
      "name": "reform_rate",
      "equation": "0.01",
      "position": {
        "x": 300,
        "y": 300
      }
    },
    {
      "id": "var-public",
      "name": "public_pressure",
      "equation": "0.3",
      "position": {
        "x": 400,
        "y": 300
      }
    },
    {
      "id": "var-erosion",
      "name": "erosion_rate",
      "equation": "0.02",
      "position": {
        "x": 500,
        "y": 350
      }
    },
    {
      "id": "var-invest",
      "name": "effectiveness_investment",
      "equation": "2",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "var-capture-idx",
      "name": "Capture_Index",
      "equation": "Industry_Influence / (Industry_Influence + Regulatory_Independence)",
      "position": {
        "x": 300,
        "y": 450
      }
    }
  ],
  "connectors": [],
  "tables": [],
  "time_settings": {
    "start": 0,
    "end": 100,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T12:00:00.000000+00:00",
  "updated_at": "2026-01-12T12:00:00.000000+00:00"
}