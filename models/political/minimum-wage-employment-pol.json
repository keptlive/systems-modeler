{
  "id": "minimum-wage-employment-pol",
  "name": "Minimum Wage Employment Effects Model",
  "description": "Model of minimum wage policy effects on employment, wages, and business adaptation. Reference: Based on system dynamics methodology (Sterman, 2000; Forrester, 1961). Source: https://systemdynamics.org/",
  "stocks": [
    {
      "id": "s1",
      "name": "Low_Wage_Employment",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Average_Wage",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 400,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Business_Adaptation",
      "initial_value": 0,
      "equation": "",
      "position": {
        "x": 300,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "Employment_Change",
      "equation": "Job_Creation - Job_Loss",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 100,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Wage_Adjustment",
      "equation": "Wage_Adjustment_Rate * (Minimum_Wage - Average_Wage) * Compliance_Rate",
      "from_stock": null,
      "to_stock": "s2",
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Adaptation_Progress",
      "equation": "Adaptation_Rate * (1 - Business_Adaptation) * Wage_Pressure",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 200,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Minimum_Wage",
      "equation": "15",
      "position": {
        "x": 300,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Job_Creation",
      "equation": "0.5 * Demand_Effect",
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "v3",
      "name": "Job_Loss",
      "equation": "0.3 * Elasticity * Wage_Pressure * (1 - Business_Adaptation)",
      "position": {
        "x": 100,
        "y": 200
      }
    },
    {
      "id": "v4",
      "name": "Elasticity",
      "equation": "0.2",
      "position": {
        "x": 200,
        "y": 200
      }
    },
    {
      "id": "v5",
      "name": "Wage_Pressure",
      "equation": "MAX(0, (Minimum_Wage - Average_Wage) / Average_Wage)",
      "position": {
        "x": 400,
        "y": 100
      }
    },
    {
      "id": "v6",
      "name": "Demand_Effect",
      "equation": "1 + 0.1 * Average_Wage / 10",
      "position": {
        "x": 500,
        "y": 150
      }
    },
    {
      "id": "v7",
      "name": "Compliance_Rate",
      "equation": "0.9",
      "position": {
        "x": 350,
        "y": 200
      }
    },
    {
      "id": "v8",
      "name": "Wage_Adjustment_Rate",
      "equation": "0.2",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "v9",
      "name": "Adaptation_Rate",
      "equation": "0.1",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Total_Wage_Bill",
      "equation": "Low_Wage_Employment * Average_Wage",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 20,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:32:16.976756+00:00",
  "updated_at": "2026-01-12T11:32:16.976756+00:00",
  "source": "https://doi.org/10.1093/qje/qjz014",
  "reference": "Cengiz D, et al. The effect of minimum wages on low-wage jobs. The Quarterly Journal of Economics. 2019;134(3):1405-1454."
}