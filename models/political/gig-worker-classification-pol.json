{
  "id": "gig-worker-classification-pol",
  "name": "Gig Worker Classification Policy Model",
  "description": "Model of gig economy worker classification showing policy effects on employment and benefits. Reference: Katz, L. F., & Krueger, A. B. (2019). The Rise and Nature of Alternative Work. Journal of Economic Perspectives. Source: https://doi.org/10.1257/jep.33.3.3",
  "stocks": [
    {
      "id": "s1",
      "name": "Independent_Contractors",
      "initial_value": 10,
      "equation": "",
      "position": {
        "x": 150,
        "y": 150
      }
    },
    {
      "id": "s2",
      "name": "Employees",
      "initial_value": 2,
      "equation": "",
      "position": {
        "x": 350,
        "y": 150
      }
    },
    {
      "id": "s3",
      "name": "Platform_Revenue",
      "initial_value": 100,
      "equation": "",
      "position": {
        "x": 250,
        "y": 300
      }
    }
  ],
  "flows": [
    {
      "id": "f1",
      "name": "New_Gig_Workers",
      "equation": "Entry_Rate * Platform_Attractiveness",
      "from_stock": null,
      "to_stock": "s1",
      "position": {
        "x": 50,
        "y": 150
      }
    },
    {
      "id": "f2",
      "name": "Reclassification",
      "equation": "Independent_Contractors * Reclassification_Rate * Policy_Pressure",
      "from_stock": "s1",
      "to_stock": "s2",
      "position": {
        "x": 250,
        "y": 150
      }
    },
    {
      "id": "f3",
      "name": "Exit_Rate_IC",
      "equation": "Independent_Contractors * Churn_Rate_IC",
      "from_stock": "s1",
      "to_stock": null,
      "position": {
        "x": 150,
        "y": 50
      }
    },
    {
      "id": "f4",
      "name": "Exit_Rate_Emp",
      "equation": "Employees * Churn_Rate_Emp",
      "from_stock": "s2",
      "to_stock": null,
      "position": {
        "x": 350,
        "y": 50
      }
    },
    {
      "id": "f5",
      "name": "Revenue_Change",
      "equation": "Revenue_Growth - Cost_Increase",
      "from_stock": null,
      "to_stock": "s3",
      "position": {
        "x": 150,
        "y": 300
      }
    }
  ],
  "variables": [
    {
      "id": "v1",
      "name": "Entry_Rate",
      "equation": "2",
      "position": {
        "x": 50,
        "y": 100
      }
    },
    {
      "id": "v2",
      "name": "Platform_Attractiveness",
      "equation": "1 - 0.3 * Policy_Pressure",
      "position": {
        "x": 50,
        "y": 200
      }
    },
    {
      "id": "v3",
      "name": "Reclassification_Rate",
      "equation": "0.05",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "v4",
      "name": "Policy_Pressure",
      "equation": "0.5",
      "position": {
        "x": 350,
        "y": 100
      }
    },
    {
      "id": "v5",
      "name": "Churn_Rate_IC",
      "equation": "0.3",
      "position": {
        "x": 200,
        "y": 50
      }
    },
    {
      "id": "v6",
      "name": "Churn_Rate_Emp",
      "equation": "0.15",
      "position": {
        "x": 400,
        "y": 50
      }
    },
    {
      "id": "v7",
      "name": "Revenue_Growth",
      "equation": "0.1 * Platform_Revenue",
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "v8",
      "name": "Cost_Increase",
      "equation": "Employees * Benefit_Cost",
      "position": {
        "x": 300,
        "y": 350
      }
    },
    {
      "id": "v9",
      "name": "Benefit_Cost",
      "equation": "5",
      "position": {
        "x": 400,
        "y": 350
      }
    },
    {
      "id": "v10",
      "name": "Total_Workers",
      "equation": "Independent_Contractors + Employees",
      "position": {
        "x": 450,
        "y": 200
      }
    },
    {
      "id": "v11",
      "name": "Employee_Fraction",
      "equation": "Employees / (Total_Workers + 0.01)",
      "position": {
        "x": 500,
        "y": 300
      }
    }
  ],
  "connectors": [],
  "time_settings": {
    "start": 0,
    "end": 20,
    "dt": 0.25,
    "integration_method": "euler"
  },
  "created_at": "2026-01-12T11:32:16.976868+00:00",
  "updated_at": "2026-01-12T11:32:16.976868+00:00",
  "source": "https://doi.org/10.1257/jep.34.3.167",
  "reference": "Abraham KG, et al. Measuring the gig economy: Current knowledge and open issues. In: Measuring and Accounting for Innovation in the Twenty-First Century. NBER; 2019."
}